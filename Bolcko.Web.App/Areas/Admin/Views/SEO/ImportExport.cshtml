@section Scripts {
    <script>
        function setMode(mode) {
            const exportPanel = document.getElementById('export-panel');
            const importPanel = document.getElementById('import-panel');
            const container = document.getElementById('action-panels-container');

            document.querySelectorAll('.mode-btn').forEach(btn => {
                btn.className = 'mode-btn px-4 py-2 rounded-lg text-slate-300 hover:text-white font-bold text-xs transition-all flex items-center gap-1.5';
            });

            const activeBtn = document.getElementById('mode-btn-' + mode);
            if (activeBtn) {
                activeBtn.className = 'mode-btn px-4 py-2 rounded-lg bg-indigo-600 text-white font-bold text-xs transition-all flex items-center gap-1.5 shadow-md';
            }

            if (mode === 'export') {
                exportPanel.classList.remove('hidden');
                importPanel.classList.add('hidden');
                container.className = 'grid grid-cols-1 gap-6';
            } else if (mode === 'import') {
                exportPanel.classList.add('hidden');
                importPanel.classList.remove('hidden');
                container.className = 'grid grid-cols-1 gap-6';
            } else {
                exportPanel.classList.remove('hidden');
                importPanel.classList.remove('hidden');
                container.className = 'grid grid-cols-1 xl:grid-cols-2 gap-6';
            }
        }

        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.className = 'tab-btn flex items-center gap-2 px-5 py-2.5 rounded-xl bg-white border border-slate-200 text-slate-600 hover:bg-slate-50 font-bold text-sm transition-all';
            });

            const targetContent = document.getElementById('tab-content-' + tabId);
            if (targetContent) targetContent.classList.remove('hidden');

            const targetBtn = document.getElementById('tab-btn-' + tabId);
            if (targetBtn) {
                targetBtn.className = 'tab-btn flex items-center gap-2 px-5 py-2.5 rounded-xl bg-indigo-600 text-white font-bold text-sm shadow-md shadow-indigo-500/20 transition-all';
            }
        }

        function setQuickFilter(type) {
            document.getElementById('export-search').value = '';
            document.getElementById('export-category').value = '';
            document.getElementById('export-brand').value = '';

            if (type === 'missing') {
                document.getElementById('export-status').value = '';
                document.getElementById('export-missing-desc').checked = true;
            } else if (type === 'pending') {
                document.getElementById('export-status').value = 'PendingSeo';
                document.getElementById('export-missing-desc').checked = false;
            } else {
                document.getElementById('export-status').value = '';
                document.getElementById('export-missing-desc').checked = false;
            }
        }

        function handleFileSelect(input) {
            if (input.files && input.files[0]) {
                const file = input.files[0];
                document.getElementById('file-label-title').innerText = file.name;
                document.getElementById('file-label-sub').innerText = `الحجم: ${(file.size / (1024 * 1024)).toFixed(2)} ميجابايت`;
            }
        }

        async function submitImportForm() {
            const fileInput = document.getElementById('file-input');
            if (!fileInput.files || !fileInput.files[0]) {
                alert('الرجاء اختيار ملف Excel أولاً.');
                return;
            }

            const form = document.getElementById('import-form');
            const formData = new FormData(form);
            const isAsync = document.querySelector('input[name="backgroundJob"]:checked').value === 'true';

            const btn = document.getElementById('btn-submit-import');
            const btnIcon = document.getElementById('import-btn-icon');
            const btnText = document.getElementById('import-btn-text');

            btn.disabled = true;
            btnIcon.innerText = 'sync';
            btnIcon.classList.add('animate-spin');
            btnText.innerText = 'جاري رفع ومعالجة الملف...';

            const token = document.querySelector('#antiforgery-form input[name="__RequestVerificationToken"]')?.value;

            try {
                const response = await fetch('@Url.Action("UploadSeoImport")', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token
                    },
                    body: formData
                });

                const data = await response.json();

                if (!data.success) {
                    alert('خطأ: ' + (data.message || 'حدث خطأ غير متوقع أثناء الرفع.'));
                    resetBtn();
                    return;
                }

                if (data.isAsync) {
                    // Start Background Job Polling
                    document.getElementById('job-monitor-card').classList.remove('hidden');
                    pollJobStatus(data.jobId);
                    resetBtn();
                } else {
                    // Direct Import Results
                    alert(`✅ اكتملت المعالجة بنجاح!\n• إجمالي الصفوف: ${data.totalRows}\n• المنتجات المحدثة: ${data.updatedCount}\n• الأخطاء: ${data.failureCount}`);
                    location.reload();
                }
            } catch (err) {
                console.error(err);
                alert('حدث خطأ في الاتصال أثناء الاستيراد.');
                resetBtn();
            }

            function resetBtn() {
                btn.disabled = false;
                btnIcon.innerText = 'upload';
                btnIcon.classList.remove('animate-spin');
                btnText.innerText = 'بدء عملية الاستيراد والتحديث (Start Import)';
            }
        }

        function pollJobStatus(jobId) {
            const interval = setInterval(async () => {
                try {
                    const res = await fetch(`@Url.Action("GetJobStatus")?jobId=${jobId}`);
                    const data = await res.json();

                    if (data.success) {
                        const percent = data.progressPercent || 0;
                        document.getElementById('job-progress-bar').style.width = percent + '%';
                        document.getElementById('job-percent-badge').innerText = percent + '%';

                        document.getElementById('job-total-rows').innerText = data.totalRows || 0;
                        document.getElementById('job-updated-rows').innerText = data.updatedCount || 0;
                        document.getElementById('job-success-rows').innerText = data.successCount || 0;
                        document.getElementById('job-failed-rows').innerText = data.failureCount || 0;

                        if (data.status === 'Completed') {
                            clearInterval(interval);
                            document.getElementById('job-status-title').innerText = '🎉 اكتملت معالجة الاستيراد بنجاح!';
                            document.getElementById('job-status-title').classList.add('text-emerald-600');
                            setTimeout(() => location.reload(), 2500);
                        } else if (data.status === 'Failed') {
                            clearInterval(interval);
                            document.getElementById('job-status-title').innerText = '❌ فشلت الوظيفة أو توقفت.';
                            document.getElementById('job-status-title').classList.add('text-rose-600');
                        }
                    }
                } catch (e) {
                    console.error('Error polling job status:', e);
                }
            }, 3000);
        }
    </script>
}
