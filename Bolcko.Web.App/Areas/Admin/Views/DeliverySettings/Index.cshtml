@using Bolcko.Domain.Entities.Delivery
@model DeliveryProviderConfig
@{
    ViewData["Title"] = "تكامل شركات التوصيل والـ APIs";
    ViewData["ParentTitle"] = "مركز اللوجستيات والتوزيع";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var webhookUrl = ViewBag.WebhookUrl as string;
}

<div class="p-4 md:p-8 space-y-6 text-right font-sans min-h-screen max-w-7xl mx-auto" dir="rtl">
    
    <!-- Universal Breadcrumb Partial -->
    <partial name="~/Areas/Admin/Views/Shared/Partials/_Breadcrumb.cshtml" />

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-900 text-xs font-black flex items-center gap-3 shadow-xs">
            <span class="material-symbols-outlined text-emerald-600 text-xl">check_circle</span>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-2xl bg-rose-500/10 border border-rose-500/20 text-rose-900 text-xs font-black flex items-center gap-3 shadow-xs">
            <span class="material-symbols-outlined text-rose-600 text-xl">error</span>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- Dynamic Delivery Provider Config Card -->
    <div class="bg-white border border-slate-200 rounded-3xl p-6 md:p-8 shadow-xl shadow-slate-100/60 space-y-8">
        
        <!-- Header Zone -->
        <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-4 border-b border-slate-100 pb-6">
            
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-2xl bg-amber-500/10 text-[#E8A020] border border-amber-500/30 flex items-center justify-center font-bold shadow-sm shrink-0">
                    <span class="material-symbols-outlined text-2xl">local_shipping</span>
                </div>
                <div class="space-y-1">
                    <div class="flex items-center gap-2 flex-wrap">
                        <h2 class="text-lg md:text-xl font-black text-slate-900">
                            تكامل شركات التوصيل والـ APIs (مثل Green Line / LogesTechs)
                        </h2>
                        <span class="bg-emerald-50 text-emerald-700 border border-emerald-200 text-[10px] px-2.5 py-0.5 rounded-full font-black">
                            Active REST & Webhook Client
                        </span>
                    </div>
                    <p class="text-slate-400 text-xs font-medium">
                        رفع أوتوماتيكي للطلبات بـ POST Request وتحديث تلقائي فور حدوث أي حدث لدى السائق
                    </p>
                </div>
            </div>

            <button type="button" onclick="testLogesTechsConnection()" class="bg-slate-900 hover:bg-slate-800 text-white px-5 py-2.5 rounded-2xl text-xs font-black transition-all shadow-sm active:scale-95 flex items-center gap-2 shrink-0 border border-slate-800">
                <span class="material-symbols-outlined text-base text-[#E8A020]">sensors</span>
                <span>اختبار صحة الاتصال بالـ API 🧪</span>
            </button>
        </div>

        <form asp-action="SaveConfig" method="post" class="space-y-6">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ProviderName" value="LogesTechs" />
            <input type="hidden" asp-for="ProviderKey" value="LogesTechs" />

            <!-- 1. REST API Credentials Grid -->
            <div class="space-y-4">
                <h3 class="text-xs font-black text-slate-900 uppercase tracking-wider flex items-center gap-2">
                    <span class="material-symbols-outlined text-[#E8A020] text-lg">api</span>
                    <span>بيانات الاعتماد للـ API (لرفع الطلبات تلقائياً باسم متجر بلوكو)</span>
                </h3>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Base URL -->
                    <div class="space-y-1.5">
                        <label class="block text-xs font-black text-slate-800">عنوان الـ REST API (Base URL) *</label>
                        <input type="url" asp-for="BaseUrl" required class="w-full bg-slate-50 border border-slate-200 rounded-2xl h-11 px-4 text-xs font-mono font-bold text-slate-900 focus:border-[#E8A020] focus:bg-white outline-none transition-all dir-ltr text-left" placeholder="https://apisv2.logestechs.com/api" />
                    </div>

                    <!-- Company ID Header -->
                    <div class="space-y-1.5">
                        <label class="block text-xs font-black text-slate-800">معرّف الشركة لدى السستم (Company-ID Header) *</label>
                        <input type="text" asp-for="CompanyId" required class="w-full bg-slate-50 border border-slate-200 rounded-2xl h-11 px-4 text-xs font-black text-slate-900 focus:border-[#E8A020] focus:bg-white outline-none transition-all dir-ltr text-left" placeholder="مثال: GLC أو 410" />
                    </div>

                    <!-- Api Email -->
                    <div class="space-y-1.5">
                        <label class="block text-xs font-black text-slate-800">البريد الإلكتروني للـ API (API Email) *</label>
                        <input type="email" asp-for="ApiEmail" required class="w-full bg-slate-50 border border-slate-200 rounded-2xl h-11 px-4 text-xs font-black text-slate-900 focus:border-[#E8A020] focus:bg-white outline-none transition-all dir-ltr text-left" placeholder="info@bolcko.com" />
                    </div>

                    <!-- Api Password -->
                    <div class="space-y-1.5">
                        <label class="block text-xs font-black text-slate-800">كلمة المرور للـ API (API Password) *</label>
                        <input type="password" asp-for="ApiPassword" required class="w-full bg-slate-50 border border-slate-200 rounded-2xl h-11 px-4 text-xs font-black text-slate-900 focus:border-[#E8A020] focus:bg-white outline-none transition-all dir-ltr text-left" placeholder="••••••••••••" />
                    </div>
                </div>
            </div>

            <!-- 2. Generic Dynamic API Request Builder Section -->
            <div class="space-y-4 pt-4 border-t border-slate-100">
                <h3 class="text-xs font-black text-slate-900 uppercase tracking-wider flex items-center gap-2">
                    <span class="material-symbols-outlined text-[#E8A020] text-lg">code</span>
                    <span>محرك باني الطلبات الديناميكي (Generic Request & Custom Headers Builder)</span>
                </h3>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Custom Headers JSON -->
                    <div class="space-y-1.5">
                        <label class="block text-xs font-black text-slate-800">تخصيص الهيدرز لـ HTTP Requests (Custom Headers JSON):</label>
                        <textarea asp-for="CustomHeadersJson" rows="3" class="w-full bg-slate-900 border border-slate-800 rounded-2xl p-3 text-xs font-mono font-bold text-amber-400 focus:border-[#E8A020] outline-none transition-all dir-ltr text-left" placeholder='{ "company-id": "GLC", "X-Custom-Header": "BolckoApp" }'></textarea>
                        <p class="text-[11px] text-slate-400 font-bold">يمكنك إضافة أي Headers مخصصة يتطلبها الـ API بـ صيغة JSON.</p>
                    </div>

                    <!-- Custom Payload Mapping JSON -->
                    <div class="space-y-1.5">
                        <label class="block text-xs font-black text-slate-800">تخصيص الخرائط والحقول لـ Payload (Custom Payload Schema JSON):</label>
                        <textarea asp-for="CustomPayloadMappingJson" rows="3" class="w-full bg-slate-900 border border-slate-800 rounded-2xl p-3 text-xs font-mono font-bold text-emerald-400 focus:border-[#E8A020] outline-none transition-all dir-ltr text-left" placeholder='{ "senderName": "بلوكو لتوريدات البناء", "serviceType": "STANDARD", "shipmentType": "COD" }'></textarea>
                        <p class="text-[11px] text-slate-400 font-bold">تحديد القيم الثابتة والتوجيهات المخصصة الصادرة لـ POST Request.</p>
                    </div>
                </div>
            </div>

            <!-- 3. Webhook Listener Section -->
            <div class="space-y-3 pt-4 border-t border-slate-100">
                <div class="flex items-center justify-between">
                    <h3 class="text-xs font-black text-slate-900 uppercase tracking-wider flex items-center gap-2">
                        <span class="material-symbols-outlined text-emerald-600 text-lg">input</span>
                        <span>رابط الاستماع الخاص بموقعك (استقبال الإشعارات والتحصيل الحي):</span>
                    </h3>
                    <button type="button" onclick="copyWebhookUrl()" class="text-xs font-black text-slate-900 bg-amber-100 hover:bg-amber-200 px-3 py-1 rounded-xl transition-all flex items-center gap-1 shrink-0">
                        <span class="material-symbols-outlined text-xs">content_copy</span>
                        <span>نسخ الرابط 📋</span>
                    </button>
                </div>

                <div class="bg-slate-900 border border-slate-800 rounded-2xl p-3.5 text-xs font-mono font-bold text-amber-400 dir-ltr text-left select-all overflow-x-auto shadow-inner" id="webhookUrlText">
                    @webhookUrl
                </div>
                <p class="text-[11px] text-slate-400 font-bold">
                    💡 تقوم شركة التوصيل بـ Push إشعارات الـ Webhook لهذا الرابط فور تغير حالة الطلب (تسليم، إلغاء، مرتجع) لتحديث سستم موقعك والمالية حياً.
                </p>
            </div>

            <!-- Active Status Toggle & Submit Zone -->
            <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-4 border-t border-slate-100">
                
                <label class="relative inline-flex items-center cursor-pointer gap-3">
                    <input type="checkbox" asp-for="IsActive" class="sr-only peer" />
                    <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-slate-900"></div>
                    <span class="text-xs font-black text-slate-800">
                        تفعيل التوصيل المباشر والربط البرمجي
                    </span>
                </label>

                <button type="submit" class="w-full sm:w-auto bg-[#E8A020] hover:bg-[#d49018] text-slate-950 font-black px-8 py-3 rounded-2xl text-xs transition-all shadow-md active:scale-95 flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-lg">save</span>
                    <span>حفظ وتطبيق الإعدادات 💾</span>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function copyWebhookUrl() {
        const urlText = document.getElementById('webhookUrlText').innerText;
        navigator.clipboard.writeText(urlText);
        showTailwindToast('تم نسخ رابط الـ Webhook الخاص بموقعك بنجاح 📋', 'success');
    }

    function testLogesTechsConnection() {
        showTailwindToast('جاري فحص الاتصال بالـ API...', 'success');
        fetch('@Url.Action("TestConnection", "DeliverySettings", new { area = "Admin" })', {
            method: 'POST'
        })
        .then(r => r.json())
        .then(res => {
            showTailwindToast(res.message, res.success ? 'success' : 'error');
        })
        .catch(() => showTailwindToast('تعذّر اختبار الاتصال بالـ API.', 'error'));
    }
</script>
