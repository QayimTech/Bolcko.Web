@using Bolcko.Domain.Entities.Delivery
@model IEnumerable<DeliveryProviderConfig>
@{
    ViewData["Title"] = "تكامل ومزودي شركات التوصيل (Multi-Provider API Hub)";
    ViewData["ParentTitle"] = "مركز اللوجستيات والتوزيع";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var baseWebhookUrl = ViewBag.BaseWebhookUrl as string;
}

<div class="p-4 md:p-8 space-y-6 text-right font-sans min-h-screen max-w-7xl mx-auto" dir="rtl">
    
    <!-- Universal Breadcrumb Partial -->
    <partial name="~/Areas/Admin/Views/Shared/Partials/_Breadcrumb.cshtml" />

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-900 text-xs font-black flex items-center gap-3 shadow-xs">
            <span class="material-symbols-outlined text-emerald-600 text-xl">check_circle</span>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-2xl bg-rose-500/10 border border-rose-500/20 text-rose-900 text-xs font-black flex items-center gap-3 shadow-xs">
            <span class="material-symbols-outlined text-rose-600 text-xl">error</span>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- Header Actions Zone -->
    <div class="bg-white border border-slate-200 rounded-3xl p-6 md:p-8 shadow-xl shadow-slate-100/60 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-2xl bg-amber-500/10 text-[#E8A020] border border-amber-500/30 flex items-center justify-center font-bold shadow-sm shrink-0">
                <span class="material-symbols-outlined text-2xl">hub</span>
            </div>
            <div class="space-y-1">
                <div class="flex items-center gap-2 flex-wrap">
                    <h2 class="text-lg md:text-xl font-black text-slate-900">
                        مركز تكامل شركات التوصيل المزدوجة (Multi-Provider Delivery Hub)
                    </h2>
                    <span class="bg-emerald-50 text-emerald-700 border border-emerald-200 text-[10px] px-2.5 py-0.5 rounded-full font-black">
                        Dynamic Multi-API Engine
                    </span>
                </div>
                <p class="text-slate-400 text-xs font-medium">
                    إضافة وتفعيل أي عدد من شركات التوصيل الخارجية (GLC LogesTechs, Aramex, DHL) بروابط API و Webhooks مستقلة
                </p>
            </div>
        </div>

        <div class="flex items-center gap-2 flex-wrap w-full md:w-auto">
            <a href="@Url.Action("CarrierApprovals", "DeliverySettings")" class="w-full md:w-auto bg-amber-500 hover:bg-amber-600 text-slate-950 font-black px-5 py-3 rounded-2xl text-xs transition-all shadow-md active:scale-95 flex items-center justify-center gap-2 border border-amber-600 shrink-0">
                <span class="material-symbols-outlined text-lg">verified_user</span>
                <span>تدقيق ومصادقة وثائق النقل (KYC)</span>
            </a>
            <button type="button" onclick="openAddProviderModal()" class="w-full md:w-auto bg-slate-900 hover:bg-slate-800 text-white font-black px-6 py-3 rounded-2xl text-xs transition-all shadow-md active:scale-95 flex items-center justify-center gap-2 border border-slate-800 shrink-0">
                <span class="material-symbols-outlined text-lg text-[#E8A020]">add_circle</span>
                <span>إضافة شركة توصيل جديدة ➕</span>
            </button>
        </div>
    </div>

    <!-- Active Providers Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        @if (Model != null && Model.Any())
        {
            foreach (var provider in Model)
            {
                var providerWebhookUrl = $"{baseWebhookUrl}/{provider.ProviderKey}/{provider.CompanyId ?? "0"}";
                <div class="bg-white border border-slate-200 rounded-3xl p-6 shadow-sm hover:shadow-md transition-all space-y-4">
                    
                    <!-- Top Bar -->
                    <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-2xl bg-amber-50 text-[#E8A020] border border-amber-200 flex items-center justify-center font-black">
                                <span class="material-symbols-outlined text-xl">local_shipping</span>
                            </div>
                            <div>
                                <h3 class="text-sm font-black text-slate-900">@provider.ProviderName</h3>
                                <span class="inline-block px-2 py-0.5 rounded-md bg-slate-100 font-mono text-[10px] text-slate-600 font-bold">@provider.ProviderKey</span>
                            </div>
                        </div>

                        <div class="flex items-center gap-2">
                            <span class="px-3 py-1 rounded-full text-[10px] font-black @(provider.IsActive ? "bg-emerald-50 text-emerald-700 border border-emerald-200" : "bg-rose-50 text-rose-700 border border-rose-200")">
                                @(provider.IsActive ? "مفعل شغال ⚡" : "معطل ⏸️")
                            </span>
                            <button type="button" onclick='editProviderModal(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(provider)))' class="w-8 h-8 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 flex items-center justify-center transition-all">
                                <span class="material-symbols-outlined text-base">edit</span>
                            </button>
                        </div>
                    </div>

                    <!-- Config Attributes Grid -->
                    <div class="bg-slate-50 border border-slate-100 rounded-2xl p-3.5 space-y-2.5 text-xs">
                        <div class="flex items-center justify-between gap-2">
                            <span class="text-slate-500 font-bold shrink-0">عنوان الـ API:</span>
                            <span class="font-mono font-bold text-slate-900 truncate text-left dir-ltr" title="@provider.BaseUrl">@provider.BaseUrl</span>
                        </div>
                        <div class="flex items-center justify-between gap-2">
                            <span class="text-slate-500 font-bold shrink-0">معرّف الشركة (Company-ID):</span>
                            <span class="font-bold text-emerald-800 bg-emerald-100 px-2 py-0.5 rounded-md font-mono">@(string.IsNullOrEmpty(provider.CompanyId) ? "غير محدد" : provider.CompanyId)</span>
                        </div>
                        <div class="flex items-center justify-between gap-2">
                            <span class="text-slate-500 font-bold shrink-0">البريد الإلكتروني للـ API:</span>
                            <span class="font-bold text-slate-800 font-mono truncate text-left dir-ltr">@provider.ApiEmail</span>
                        </div>
                    </div>

                    <!-- Webhook Box -->
                    <div class="p-3 rounded-2xl bg-slate-900 text-amber-300 text-xs font-mono space-y-1 shadow-inner">
                        <div class="flex items-center justify-between text-[11px] text-slate-400 font-sans font-bold">
                            <span>رابط الاستماع الخاص بها (Inbound Webhook):</span>
                            <button type="button" onclick="copyText('@providerWebhookUrl')" class="text-amber-400 hover:text-amber-300 font-black flex items-center gap-1">
                                <span class="material-symbols-outlined text-xs">content_copy</span>
                                <span>نسخ</span>
                            </button>
                        </div>
                        <div class="dir-ltr text-left select-all truncate text-slate-200 text-[11px]" title="@providerWebhookUrl">@providerWebhookUrl</div>
                    </div>

                    <!-- Bottom Actions -->
                    <div class="pt-1 flex items-center justify-between gap-2">
                        <div class="flex items-center gap-3">
                            <button type="button" onclick="toggleProviderStatus(@provider.Id)" class="text-xs font-bold text-slate-600 hover:text-slate-900 underline">
                                @(provider.IsActive ? "تعطيل الشركة" : "تفعيل الشركة")
                            </button>
                            <button type="button" onclick="deleteProviderConfig(@provider.Id, '@provider.ProviderName')" class="text-xs font-bold text-rose-600 hover:text-rose-800 underline flex items-center gap-1">
                                <span class="material-symbols-outlined text-xs">delete</span>
                                <span>حذف</span>
                            </button>
                        </div>
                        <div class="flex items-center gap-2">
                            <button type="button" onclick="syncProviderLocations('@provider.ProviderKey')" class="bg-indigo-50 hover:bg-indigo-100 text-indigo-700 border border-indigo-200 px-3.5 py-2 rounded-xl text-xs font-black transition-all flex items-center gap-1.5 shadow-sm">
                                <span class="material-symbols-outlined text-sm">sync</span>
                                <span>مزامنة مناطق وقرى الشركة 🗺️</span>
                            </button>
                            <button type="button" onclick="testLogesTechsConnection()" class="bg-slate-900 hover:bg-slate-800 text-[#E8A020] px-4 py-2 rounded-xl text-xs font-black transition-all flex items-center gap-1.5 shadow-sm border border-slate-800">
                                <span class="material-symbols-outlined text-sm">sensors</span>
                                <span>فحص الاتصال بالـ API 📡</span>
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <!-- Default GLC LogesTechs Seed Provider Card -->
            <div class="bg-white border border-slate-200 rounded-3xl p-6 shadow-sm space-y-5">
                <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-amber-100 text-[#E8A020] flex items-center justify-center font-black">
                            <span class="material-symbols-outlined text-xl">local_shipping</span>
                        </div>
                        <div>
                            <h3 class="text-sm font-black text-slate-900">Green Line Company (GLC / LogesTechs)</h3>
                            <p class="text-[11px] font-mono text-slate-400">LogesTechs White Label API</p>
                        </div>
                    </div>
                    <span class="px-2.5 py-1 rounded-full text-[10px] font-black bg-emerald-100 text-emerald-800">مفعل شغال ⚡</span>
                </div>

                <p class="text-xs text-slate-500 font-bold">اضغط على زر [ إضافة شركة توصيل جديدة ] لربط أي شركة توصيل إضافية بروابط API و Webhook مستقلة!</p>
                <button type="button" onclick="openAddProviderModal()" class="w-full bg-[#E8A020] text-slate-950 font-black py-2.5 rounded-2xl text-xs">إضافة وإعداد شركة للتوصيل المباشر ➕</button>
            </div>
        }
    </div>

    <!-- Economics & Base Cost Summary Bar -->
    @{
        decimal baseCourierCost = ViewBag.BaseCourierCost is decimal bc ? bc : 1.75m;
        var shippingRatesList = ViewBag.ShippingRates as List<Bolcko.Domain.Entities.Setting.ShippingRate> ?? new();
    }
    <div class="bg-gradient-to-r from-slate-900 via-slate-850 to-slate-900 text-white rounded-3xl p-6 md:p-8 shadow-xl border border-slate-800 space-y-6">
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 border-b border-slate-800 pb-5">
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-2xl bg-amber-500/20 text-[#E8A020] border border-amber-500/40 flex items-center justify-center font-black">
                    <span class="material-symbols-outlined text-2xl">account_balance_wallet</span>
                </div>
                <div>
                    <h3 class="text-base md:text-lg font-black text-white flex items-center gap-2">
                        <span>هندسة أرباح وتكاليف التوصيل الموحدة (Logistics Unit Economics)</span>
                        <span class="bg-amber-400/20 text-[#E8A020] text-[10px] px-2.5 py-0.5 rounded-full font-bold border border-amber-400/30">Jordan Standard</span>
                    </h3>
                    <p class="text-slate-400 text-xs mt-0.5">
                        مستودع الاستلام الافتراضي: <span class="text-emerald-400 font-bold">عمان - رأس العين - مستودع بلوكو (مجمع القناص)</span>
                    </p>
                </div>
            </div>

            <!-- Seed Governorates Form -->
            <form asp-action="SeedDefaultGovernorates" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" onclick="return confirm('هل تريد إعادة تعيين كافة محافظات المملكة الـ 12 بالأسعار المدروسة وهوامش الربح؟')" class="bg-emerald-600 hover:bg-emerald-500 text-white font-black text-xs px-5 py-2.5 rounded-2xl transition-all shadow-md flex items-center gap-2 active:scale-95 border border-emerald-500">
                    <span class="material-symbols-outlined text-base">restart_alt</span>
                    <span>إعادة ضبط المحافظات الـ 12 تلقائياً 🇯🇴</span>
                </button>
            </form>
        </div>

        <!-- 3 KPIs & Base Cost Setting Form -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
            
            <!-- KPI 1: Base Courier Cost Editor -->
            <div class="bg-slate-800/80 border border-slate-700/80 rounded-2xl p-4 flex flex-col justify-between">
                <div class="flex items-center justify-between text-xs text-slate-400 font-bold mb-2">
                    <span>تكلفة شركة الشحن الموحدة (GLC Cost):</span>
                    <span class="material-symbols-outlined text-sm text-indigo-400">local_shipping</span>
                </div>
                <form asp-action="SaveBaseCourierCost" method="post" class="flex items-center gap-2">
                    @Html.AntiForgeryToken()
                    <div class="relative flex-1">
                        <input name="baseCourierCost" type="number" step="0.05" dir="ltr" value="@baseCourierCost.ToString("F2")" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-sm font-black text-[#E8A020] text-center outline-none focus:border-[#E8A020]" required />
                        <span class="absolute end-3 top-2.5 text-[10px] text-slate-500 font-bold pointer-events-none">د.أ</span>
                    </div>
                    <button type="submit" class="bg-slate-700 hover:bg-slate-600 text-white text-xs font-bold px-3 py-2 rounded-xl transition-all">حفظ</button>
                </form>
                <span class="text-[10px] text-slate-400 mt-2 block">سعر الشحن الثابت من GLC لكافة المحافظات</span>
            </div>

            <!-- KPI 2: Average Retail Shipping Price -->
            <div class="bg-slate-800/80 border border-slate-700/80 rounded-2xl p-4 flex flex-col justify-between">
                <div class="flex items-center justify-between text-xs text-slate-400 font-bold mb-1">
                    <span>متوسط سعر التوصيل للزبون:</span>
                    <span class="material-symbols-outlined text-sm text-amber-400">payments</span>
                </div>
                @{
                    decimal avgRetail = shippingRatesList.Any() ? shippingRatesList.Average(r => r.Rate) : 3.30m;
                }
                <div class="text-2xl font-black text-white font-mono">
                    @avgRetail.ToString("N2") <span class="text-xs text-slate-400 font-sans">د.أ / طلب</span>
                </div>
                <span class="text-[10px] text-slate-400 mt-2 block">متوسط ما يدفعه الزبائن في المتجر</span>
            </div>

            <!-- KPI 3: Average Profit Margin per Order -->
            <div class="bg-emerald-950/40 border border-emerald-500/30 rounded-2xl p-4 flex flex-col justify-between">
                <div class="flex items-center justify-between text-xs text-emerald-400 font-bold mb-1">
                    <span>متوسط صافي ربح التوصيل لبلوكو:</span>
                    <span class="material-symbols-outlined text-sm text-emerald-400">trending_up</span>
                </div>
                @{
                    decimal avgMargin = avgRetail - baseCourierCost;
                }
                <div class="text-2xl font-black text-emerald-400 font-mono">
                    +@avgMargin.ToString("N2") <span class="text-xs text-emerald-200 font-sans">د.أ صافي ربح / طلب 💰</span>
                </div>
                <span class="text-[10px] text-emerald-300/70 mt-2 block">الفرق الصافي بين سعر الزبون وتكلفة شركة الشحن</span>
            </div>

        </div>
    </div>

    <!-- Governorates and Shipping Rates Table -->
    <div class="bg-white border border-slate-200 rounded-3xl p-6 md:p-8 shadow-xl flex flex-col gap-6">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-slate-100 pb-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-indigo-50 text-indigo-600 border border-indigo-200 flex items-center justify-center font-black">
                    <span class="material-symbols-outlined text-xl">map</span>
                </div>
                <div>
                    <h3 class="text-lg font-black text-slate-900">تسعيرة المحافظات وهوامش الربح الفردية</h3>
                    <p class="text-slate-400 text-xs font-medium">إدارة تكلفة التوصيل لكل محافظة وحساب هامش الربح المحقق تلقائياً</p>
                </div>
            </div>

            <button type="button" id="btn-add-city" class="bg-slate-900 hover:bg-slate-800 text-white text-xs font-black px-4 py-2.5 rounded-2xl flex items-center gap-1.5 transition-all shadow-sm">
                <span class="material-symbols-outlined text-sm text-[#E8A020]">add_circle</span>
                <span>إضافة محافظة / منطقة جديدة ➕</span>
            </button>
        </div>
        
        <!-- Interactive Table -->
        <div class="overflow-x-auto rounded-2xl border border-slate-200">
            <table class="w-full text-right text-xs">
                <thead class="bg-slate-50 text-slate-700 font-black border-b border-slate-200 uppercase tracking-wider">
                    <tr>
                        <th class="p-4 text-center w-12">#</th>
                        <th class="p-4">المحافظة (عربي)</th>
                        <th class="p-4">Governorate (En)</th>
                        <th class="p-4 text-center">سعر الزبون (د.أ)</th>
                        <th class="p-4 text-center">تكلفة GLC</th>
                        <th class="p-4 text-center">صافي ربح بلوكو 💰</th>
                        <th class="p-4 text-center w-40">الإجراءات</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 font-bold text-slate-800">
                    @if (shippingRatesList.Any())
                    {
                        int index = 1;
                        foreach (var rate in shippingRatesList)
                        {
                            decimal margin = rate.Rate - baseCourierCost;
                            <tr class="hover:bg-slate-50/80 transition-colors">
                                <td class="p-4 text-center text-slate-400 font-mono">@(index++)</td>
                                <td class="p-4">
                                    <span class="font-black text-slate-900 text-sm">@rate.CityName</span>
                                </td>
                                <td class="p-4 font-mono text-slate-500">@(string.IsNullOrWhiteSpace(rate.CityNameEn) ? "-" : rate.CityNameEn)</td>
                                <td class="p-4 text-center">
                                    <form id="form-rate-@rate.Id" asp-action="UpdateShippingRate" method="post" class="inline-flex items-center gap-1">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@rate.Id" />
                                        <input type="hidden" name="cityName" value="@rate.CityName" />
                                        <input type="hidden" name="cityNameEn" value="@rate.CityNameEn" />
                                        <input name="rate" type="number" step="0.25" dir="ltr" value="@rate.Rate.ToString("F2")" class="w-20 bg-slate-50 border border-slate-200 rounded-xl px-2 py-1.5 text-center text-xs font-black text-slate-900 focus:bg-white focus:border-[#E8A020] outline-none" required />
                                        <button type="submit" class="bg-slate-900 hover:bg-slate-800 text-white text-[10px] px-2.5 py-1.5 rounded-xl font-bold transition-all shadow-xs">حفظ</button>
                                    </form>
                                </td>
                                <td class="p-4 text-center font-mono text-slate-500">
                                    @baseCourierCost.ToString("N2") د.أ
                                </td>
                                <td class="p-4 text-center">
                                    <span class="inline-flex items-center gap-1 px-3 py-1 rounded-xl text-xs font-black @(margin >= 1.0m ? "bg-emerald-100 text-emerald-800 border border-emerald-200" : "bg-amber-100 text-amber-800 border border-amber-200")">
                                        <span>+@margin.ToString("N2") د.أ</span>
                                    </span>
                                </td>
                                <td class="p-4 text-center">
                                    <form asp-action="DeleteShippingRate" method="post" class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@rate.Id" />
                                        <button type="submit" onclick="return confirm('هل أنت متأكد من حذف محافظة (@rate.CityName)؟')" class="text-rose-500 hover:text-rose-700 font-bold text-xs p-1.5 rounded-lg hover:bg-rose-50 transition-all flex items-center gap-1 mx-auto">
                                            <span class="material-symbols-outlined text-sm">delete</span>
                                            <span>حذف</span>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="p-8 text-center text-slate-400">
                                لا توجد محافظات مضافة حالياً. اضغط على زر [ إعادة ضبط المحافظات الـ 12 تلقائياً ] لملء الجدول فوراً!
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Express Delivery Settings -->
    <div class="bg-white border border-slate-200 rounded-3xl p-6 md:p-8 shadow-xl flex flex-col gap-6">
        <div class="flex items-center gap-4 border-b border-slate-100 pb-4">
            <div class="w-10 h-10 rounded-2xl bg-amber-50 text-[#E8A020] border border-amber-200 flex items-center justify-center font-black">
                <span class="material-symbols-outlined text-xl">bolt</span>
            </div>
            <div>
                <h3 class="text-lg font-black text-slate-900">إعدادات التوصيل الفوري (Express Delivery)</h3>
                <p class="text-slate-400 text-xs font-medium">تفعيل وإدارة خيار التوصيل السريع للمناطق القريبة وتكلفته</p>
            </div>
        </div>
        
        <form asp-action="SaveExpressDeliverySettings" method="post" class="bg-slate-50 p-6 border border-slate-100 rounded-2xl grid grid-cols-1 md:grid-cols-2 gap-6 items-end">
            @Html.AntiForgeryToken()
            <div>
                <label class="block text-xs font-bold text-slate-500 uppercase tracking-widest mb-2 text-start">حالة التفعيل</label>
                <div class="flex items-center gap-3 bg-white border border-slate-200 px-4 py-3 rounded-2xl">
                    <input type="checkbox" name="enableExpressDelivery" value="true" class="w-5 h-5 text-amber-500 border-gray-300 rounded focus:ring-[#E8A020]" @(ViewBag.EnableExpressDelivery == "true" ? "checked" : "") />
                    <span class="text-sm text-slate-700 font-bold">تفعيل خيار التوصيل الفوري السريع للعملاء</span>
                </div>
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-500 uppercase tracking-widest mb-2 text-start">رسوم التوصيل الفوري (دينار)</label>
