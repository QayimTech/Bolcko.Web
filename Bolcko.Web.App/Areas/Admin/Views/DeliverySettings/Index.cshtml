@using Bolcko.Domain.Entities.Delivery
@model IEnumerable<DeliveryProviderConfig>
@{
    ViewData["Title"] = "تكامل ومزودي شركات التوصيل (Multi-Provider API Hub)";
    ViewData["ParentTitle"] = "مركز اللوجستيات والتوزيع";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var baseWebhookUrl = ViewBag.BaseWebhookUrl as string;
}

<div class="p-4 md:p-8 space-y-6 text-right font-sans min-h-screen max-w-7xl mx-auto" dir="rtl">
    
    <!-- Universal Breadcrumb Partial -->
    <partial name="~/Areas/Admin/Views/Shared/Partials/_Breadcrumb.cshtml" />

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-900 text-xs font-black flex items-center gap-3 shadow-xs">
            <span class="material-symbols-outlined text-emerald-600 text-xl">check_circle</span>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-2xl bg-rose-500/10 border border-rose-500/20 text-rose-900 text-xs font-black flex items-center gap-3 shadow-xs">
            <span class="material-symbols-outlined text-rose-600 text-xl">error</span>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- Header Actions Zone -->
    <div class="bg-white border border-slate-200 rounded-3xl p-6 md:p-8 shadow-xl shadow-slate-100/60 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-2xl bg-amber-500/10 text-[#E8A020] border border-amber-500/30 flex items-center justify-center font-bold shadow-sm shrink-0">
                <span class="material-symbols-outlined text-2xl">hub</span>
            </div>
            <div class="space-y-1">
                <div class="flex items-center gap-2 flex-wrap">
                    <h2 class="text-lg md:text-xl font-black text-slate-900">
                        مركز تكامل شركات التوصيل المزدوجة (Multi-Provider Delivery Hub)
                    </h2>
                    <span class="bg-emerald-50 text-emerald-700 border border-emerald-200 text-[10px] px-2.5 py-0.5 rounded-full font-black">
                        Dynamic Multi-API Engine
                    </span>
                </div>
                <p class="text-slate-400 text-xs font-medium">
                    إضافة وتفعيل أي عدد من شركات التوصيل الخارجية (GLC LogesTechs, Aramex, DHL) بروابط API و Webhooks مستقلة
                </p>
            </div>
        </div>

        <button type="button" onclick="openAddProviderModal()" class="w-full md:w-auto bg-slate-900 hover:bg-slate-800 text-white font-black px-6 py-3 rounded-2xl text-xs transition-all shadow-md active:scale-95 flex items-center justify-center gap-2 border border-slate-800 shrink-0">
            <span class="material-symbols-outlined text-lg text-[#E8A020]">add_circle</span>
            <span>إضافة شركة توصيل جديدة ➕</span>
        </button>
    </div>

    <!-- Active Providers Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        @if (Model != null && Model.Any())
        {
            foreach (var provider in Model)
            {
                var providerWebhookUrl = $"{baseWebhookUrl}/{provider.ProviderKey}/{provider.CompanyId ?? "0"}";
                <div class="bg-white border border-slate-200 rounded-3xl p-6 shadow-sm hover:shadow-md transition-all space-y-4">
                    
                    <!-- Top Bar -->
                    <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-2xl bg-amber-50 text-[#E8A020] border border-amber-200 flex items-center justify-center font-black">
                                <span class="material-symbols-outlined text-xl">local_shipping</span>
                            </div>
                            <div>
                                <h3 class="text-sm font-black text-slate-900">@provider.ProviderName</h3>
                                <span class="inline-block px-2 py-0.5 rounded-md bg-slate-100 font-mono text-[10px] text-slate-600 font-bold">@provider.ProviderKey</span>
                            </div>
                        </div>

                        <div class="flex items-center gap-2">
                            <span class="px-3 py-1 rounded-full text-[10px] font-black @(provider.IsActive ? "bg-emerald-50 text-emerald-700 border border-emerald-200" : "bg-rose-50 text-rose-700 border border-rose-200")">
                                @(provider.IsActive ? "مفعل شغال ⚡" : "معطل ⏸️")
                            </span>
                            <button type="button" onclick='editProviderModal(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(provider)))' class="w-8 h-8 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 flex items-center justify-center transition-all">
                                <span class="material-symbols-outlined text-base">edit</span>
                            </button>
                        </div>
                    </div>

                    <!-- Config Attributes Grid -->
                    <div class="bg-slate-50 border border-slate-100 rounded-2xl p-3.5 space-y-2.5 text-xs">
                        <div class="flex items-center justify-between gap-2">
                            <span class="text-slate-500 font-bold shrink-0">عنوان الـ API:</span>
                            <span class="font-mono font-bold text-slate-900 truncate text-left dir-ltr" title="@provider.BaseUrl">@provider.BaseUrl</span>
                        </div>
                        <div class="flex items-center justify-between gap-2">
                            <span class="text-slate-500 font-bold shrink-0">معرّف الشركة (Company-ID):</span>
                            <span class="font-bold text-emerald-800 bg-emerald-100 px-2 py-0.5 rounded-md font-mono">@(string.IsNullOrEmpty(provider.CompanyId) ? "غير محدد" : provider.CompanyId)</span>
                        </div>
                        <div class="flex items-center justify-between gap-2">
                            <span class="text-slate-500 font-bold shrink-0">البريد الإلكتروني للـ API:</span>
                            <span class="font-bold text-slate-800 font-mono truncate text-left dir-ltr">@provider.ApiEmail</span>
                        </div>
                    </div>

                    <!-- Webhook Box -->
                    <div class="p-3 rounded-2xl bg-slate-900 text-amber-300 text-xs font-mono space-y-1 shadow-inner">
                        <div class="flex items-center justify-between text-[11px] text-slate-400 font-sans font-bold">
                            <span>رابط الاستماع الخاص بها (Inbound Webhook):</span>
                            <button type="button" onclick="copyText('@providerWebhookUrl')" class="text-amber-400 hover:text-amber-300 font-black flex items-center gap-1">
                                <span class="material-symbols-outlined text-xs">content_copy</span>
                                <span>نسخ</span>
                            </button>
                        </div>
                        <div class="dir-ltr text-left select-all truncate text-slate-200 text-[11px]" title="@providerWebhookUrl">@providerWebhookUrl</div>
                    </div>

                    <!-- Bottom Actions -->
                    <div class="pt-1 flex items-center justify-between gap-2">
                        <button type="button" onclick="toggleProviderStatus(@provider.Id)" class="text-xs font-bold text-slate-600 hover:text-slate-900 underline">
                            @(provider.IsActive ? "تعطيل الشركة" : "تفعيل الشركة")
                        </button>
                        <button type="button" onclick="testLogesTechsConnection()" class="bg-slate-900 hover:bg-slate-800 text-[#E8A020] px-4 py-2 rounded-xl text-xs font-black transition-all flex items-center gap-1.5 shadow-sm border border-slate-800">
                            <span class="material-symbols-outlined text-sm">sensors</span>
                            <span>فحص الاتصال بالـ API 📡</span>
                        </button>
                    </div>
                </div>
            }
        }
        else
        {
            <!-- Default GLC LogesTechs Seed Provider Card -->
            <div class="bg-white border border-slate-200 rounded-3xl p-6 shadow-sm space-y-5">
                <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-amber-100 text-[#E8A020] flex items-center justify-center font-black">
                            <span class="material-symbols-outlined text-xl">local_shipping</span>
                        </div>
                        <div>
                            <h3 class="text-sm font-black text-slate-900">Green Line Company (GLC / LogesTechs)</h3>
                            <p class="text-[11px] font-mono text-slate-400">LogesTechs White Label API</p>
                        </div>
                    </div>
                    <span class="px-2.5 py-1 rounded-full text-[10px] font-black bg-emerald-100 text-emerald-800">مفعل شغال ⚡</span>
                </div>

                <p class="text-xs text-slate-500 font-bold">اضغط على زر [ إضافة شركة توصيل جديدة ] لربط أي شركة توصيل إضافية بروابط API و Webhook مستقلة!</p>
                <button type="button" onclick="openAddProviderModal()" class="w-full bg-[#E8A020] text-slate-950 font-black py-2.5 rounded-2xl text-xs">إضافة وإعداد شركة للتوصيل المباشر ➕</button>
            </div>
        }
    </div>
</div>

<!-- Add / Edit Provider Tailwind Modal -->
<div id="providerModal" class="fixed inset-0 bg-slate-950/60 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
    <div class="bg-white border border-slate-200 rounded-3xl p-6 md:p-8 max-w-2xl w-full shadow-2xl space-y-6 max-h-[90vh] overflow-y-auto text-right" dir="rtl">
        
        <div class="flex items-center justify-between border-b border-slate-100 pb-4">
            <h3 class="text-base font-black text-slate-900 flex items-center gap-2" id="modalTitle">
                <span class="material-symbols-outlined text-[#E8A020]">add_box</span>
                <span>إعداد شركة توصيل وربط الـ API ديناميكياً</span>
            </h3>
            <button type="button" onclick="closeProviderModal()" class="text-slate-400 hover:text-slate-700">
                <span class="material-symbols-outlined text-xl">close</span>
            </button>
        </div>

        <form asp-action="SaveConfig" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" id="p_Id" name="Id" value="0" />

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="space-y-1">
                    <label class="block text-xs font-bold text-slate-700">اسم شركة التوصيل *</label>
                    <input type="text" id="p_ProviderName" name="ProviderName" required class="w-full bg-slate-50 border border-slate-200 rounded-xl h-10 px-3 text-xs font-bold text-slate-900 focus:bg-white outline-none" placeholder="مثال: Green Line / Aramex" />
                </div>
                <div class="space-y-1">
                    <label class="block text-xs font-bold text-slate-700">رمز الشركة (ProviderKey) *</label>
                    <input type="text" id="p_ProviderKey" name="ProviderKey" required class="w-full bg-slate-50 border border-slate-200 rounded-xl h-10 px-3 text-xs font-mono font-bold text-slate-900 focus:bg-white outline-none dir-ltr text-left" placeholder="glc / aramex" />
                </div>

                <div class="md:col-span-2 space-y-1">
                    <label class="block text-xs font-bold text-slate-700">رابط الـ API المباشر لإنشاء الشحنة (Create Shipment Endpoint URL) *</label>
                    <input type="url" id="p_BaseUrl" name="BaseUrl" required class="w-full bg-slate-50 border border-slate-200 rounded-xl h-10 px-3 text-xs font-mono font-bold text-slate-900 focus:bg-white outline-none dir-ltr text-left" placeholder="https://apisv2.logestechs.com/api/ship/request/by-email" />
                </div>

                <div class="space-y-1">
                    <label class="block text-xs font-bold text-slate-700">معرّف الشركة لدى السستم (Company-ID) *</label>
                    <input type="text" id="p_CompanyId" name="CompanyId" required class="w-full bg-slate-50 border border-slate-200 rounded-xl h-10 px-3 text-xs font-black text-slate-900 focus:bg-white outline-none dir-ltr text-left" placeholder="410 أو GLC" />
                </div>

                <div class="space-y-1">
                    <label class="block text-xs font-bold text-slate-700">البريد الإلكتروني للـ API *</label>
                    <input type="email" id="p_ApiEmail" name="ApiEmail" required class="w-full bg-slate-50 border border-slate-200 rounded-xl h-10 px-3 text-xs font-black text-slate-900 focus:bg-white outline-none dir-ltr text-left" placeholder="info@bolcko.com" />
                </div>

                <div class="md:col-span-2 space-y-1">
                    <label class="block text-xs font-bold text-slate-700">كلمة المرور للـ API *</label>
                    <input type="password" id="p_ApiPassword" name="ApiPassword" required class="w-full bg-slate-50 border border-slate-200 rounded-xl h-10 px-3 text-xs font-black text-slate-900 focus:bg-white outline-none dir-ltr text-left" placeholder="••••••••••••" />
                </div>

                <div class="md:col-span-2 space-y-1">
                    <label class="block text-xs font-bold text-slate-700">تخصيص الهيدرز لـ HTTP Requests (Custom Headers JSON):</label>
                    <textarea id="p_CustomHeadersJson" name="CustomHeadersJson" rows="2" class="w-full bg-slate-900 border border-slate-800 rounded-xl p-2.5 text-xs font-mono font-bold text-amber-400 focus:bg-slate-900 outline-none dir-ltr text-left" placeholder='{ "company-id": "186" }'></textarea>
                </div>

                <div class="md:col-span-2 space-y-1">
                    <label class="block text-xs font-bold text-slate-700">قالب الـ Payload المتوقع المخصص (Expected Dynamic JSON Payload Template):</label>
                    <textarea id="p_CustomPayloadMappingJson" name="CustomPayloadMappingJson" rows="6" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-xs font-mono font-bold text-emerald-400 focus:bg-slate-950 focus:border-emerald-500 outline-none dir-ltr text-left resize-y" placeholder='{ "email": "{ApiEmail}", "password": "{ApiPassword}", "pkg": { "cod": {OrderTotal}, "invoiceNumber": "{OrderNumber}", "receiverName": "{CustomerName}", "receiverPhone": "{CustomerPhone}" } }'></textarea>
                    <p class="text-[10px] text-slate-500 font-bold">يمكنك كتابة وتعديل أي قالب JSON مع استخدام المتغيرات التلقائية: {OrderTotal}, {OrderNumber}, {CustomerName}, {CustomerPhone}, {GoogleMapsUrl}, {OrderContents}</p>
                </div>
            </div>

            <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-4 border-t border-slate-100">
                <label class="relative inline-flex items-center cursor-pointer gap-2">
                    <input type="checkbox" id="p_IsActive" name="IsActive" value="true" checked class="sr-only peer" />
                    <div class="w-9 h-5 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-slate-900"></div>
                    <span class="text-xs font-bold text-slate-800">تفعيل الشركة لرفع الطلبيات أوتوماتيكياً</span>
                </label>

                <div class="flex items-center gap-2 w-full sm:w-auto justify-end">
                    <button type="button" onclick="testModalFormConnection()" class="bg-slate-900 hover:bg-slate-800 text-[#E8A020] px-4 py-2 rounded-xl text-xs font-black transition-all flex items-center gap-1.5 border border-slate-800 shadow-sm">
                        <span class="material-symbols-outlined text-sm">sensors</span>
                        <span>اختبار الـ API فورياً 📡</span>
                    </button>
                    <button type="button" onclick="closeProviderModal()" class="px-3 py-2 rounded-xl text-xs font-bold text-slate-600 bg-slate-100 hover:bg-slate-200">إلغاء</button>
                    <button type="submit" class="px-5 py-2 rounded-xl text-xs font-black text-slate-950 bg-[#E8A020] hover:bg-[#d49018] shadow-md">حفظ وإدراج 💾</button>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    function openAddProviderModal() {
        document.getElementById('modalTitle').innerText = 'إعداد شركة توصيل وربط الـ API ديناميكياً';
        document.getElementById('p_Id').value = '0';
        document.getElementById('p_ProviderName').value = '';
        document.getElementById('p_ProviderKey').value = '';
        document.getElementById('p_BaseUrl').value = 'https://apisv2.logestechs.com/api/ship/request/by-email';
        document.getElementById('p_CompanyId').value = '186';
        document.getElementById('p_ApiEmail').value = '';
        document.getElementById('p_ApiPassword').value = '';
        document.getElementById('p_CustomHeadersJson').value = '';
        document.getElementById('p_CustomPayloadMappingJson').value = JSON.stringify({
            email: "{ApiEmail}",
            password: "{ApiPassword}",
            pkgUnitType: "METRIC",
            pkg: {
                cod: "{OrderTotal}",
                invoiceNumber: "{OrderNumber}",
                senderName: "متجر بلوكو لتوريدات البناء",
                receiverName: "{CustomerName}",
                receiverPhone: "{CustomerPhone}",
                serviceType: "STANDARD",
                shipmentType: "COD",
                paymentType: "CASH",
                quantity: 1,
                contents: "{OrderContents}",
                locationUrl: "{GoogleMapsUrl}"
            },
            destinationAddress: { addressLine1: "{CustomerAddress}", cityId: 1, regionId: 1, villageId: 1 },
            originAddress: { addressLine1: "عمان", cityId: 1, regionId: 1, villageId: 1 }
        }, null, 2);
        document.getElementById('p_IsActive').checked = true;
        document.getElementById('providerModal').classList.remove('hidden');
    }

    function editProviderModal(provider) {
        document.getElementById('modalTitle').innerText = 'تعديل شركة التوصيل والـ API';
        document.getElementById('p_Id').value = provider.Id;
        document.getElementById('p_ProviderName').value = provider.ProviderName || '';
        document.getElementById('p_ProviderKey').value = provider.ProviderKey || '';
        document.getElementById('p_BaseUrl').value = provider.BaseUrl || '';
        document.getElementById('p_CompanyId').value = provider.CompanyId || '';
        document.getElementById('p_ApiEmail').value = provider.ApiEmail || '';
        document.getElementById('p_ApiPassword').value = provider.ApiPassword || '';
        document.getElementById('p_CustomHeadersJson').value = (provider.CustomHeadersJson && provider.CustomHeadersJson.includes('GLC')) ? '' : (provider.CustomHeadersJson || '');
        document.getElementById('p_CustomPayloadMappingJson').value = provider.CustomPayloadMappingJson || '';
        document.getElementById('p_IsActive').checked = provider.IsActive;
        document.getElementById('providerModal').classList.remove('hidden');
    }

    function closeProviderModal() {
        document.getElementById('providerModal').classList.add('hidden');
    }

    function copyText(txt) {
        navigator.clipboard.writeText(txt);
        showTailwindToast('تم نسخ الرابط بنجاح 📋', 'success');
    }

    function testModalFormConnection() {
        const payload = {
            ProviderName: document.getElementById('p_ProviderName').value,
            ProviderKey: document.getElementById('p_ProviderKey').value,
            BaseUrl: document.getElementById('p_BaseUrl').value,
            CompanyId: document.getElementById('p_CompanyId').value,
            ApiEmail: document.getElementById('p_ApiEmail').value,
            ApiPassword: document.getElementById('p_ApiPassword').value,
            CustomHeadersJson: document.getElementById('p_CustomHeadersJson').value
        };

        if (!payload.BaseUrl || !payload.ApiEmail) {
            showTailwindToast('يرجى ملء رابط الـ API والبريد الإلكتروني لاختبار الاتصال ⚠️', 'error');
            return;
        }

        showTailwindToast('جاري تجربة وفحص الاتصال بالـ API فورياً... 📡', 'success');

        fetch('@Url.Action("TestProviderConnection", "DeliverySettings", new { area = "Admin" })', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        })
        .then(r => r.json())
        .then(res => {
            showTailwindToast(res.message, res.success ? 'success' : 'error');
        })
        .catch(err => {
            showTailwindToast('حدث خطأ أثناء تجربة الاتصال بالـ API.', 'error');
        });
    }

    function toggleProviderStatus(id) {
        fetch('@Url.Action("ToggleStatus", "DeliverySettings", new { area = "Admin" })', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `id=${id}`
        })
        .then(r => r.json())
        .then(res => {
            if (res.success) {
                showTailwindToast(res.message, 'success');
                setTimeout(() => location.reload(), 800);
            }
        });
    }

    function testLogesTechsConnection() {
        showTailwindToast('جاري فحص الاتصال بالـ API...', 'success');
        fetch('@Url.Action("TestConnection", "DeliverySettings", new { area = "Admin" })', { method: 'POST' })
        .then(r => r.json())
        .then(res => showTailwindToast(res.message, res.success ? 'success' : 'error'));
    }
</script>
