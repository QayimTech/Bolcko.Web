@section Scripts {
    <script>
        $(function () {
            // Open Add City modal
            $('#btn-add-city').on('click', function () {
                $('#modalCityName').val('');
                $('#cityModal').removeClass('hidden').addClass('flex');
                setTimeout(() => $('#modalCityName').focus(), 150);
            });

            // Close Add City modal
            $('#modalCloseBtn').on('click', function () {
                $('#cityModal').addClass('hidden').removeClass('flex');
            });
        });
    </script>
    <script>
        function toggleAdvancedSettings() {
            const box = document.getElementById('advancedJsonBox');
            const icon = document.getElementById('advIcon');
            if (box.classList.contains('hidden')) {
                box.classList.remove('hidden');
                icon.innerText = 'expand_less';
            } else {
                box.classList.add('hidden');
                icon.innerText = 'expand_more';
            }
        }

        function openAddProviderModal() {
            document.getElementById('modalTitle').innerText = 'إعداد شركة توصيل وربط الـ API ديناميكياً';
            document.getElementById('p_Id').value = '0';
            document.getElementById('p_ProviderName').value = 'Green Line Company (GLC / LogesTechs)';
            document.getElementById('p_ProviderKey').value = 'glc';
            document.getElementById('p_BaseUrl').value = 'https://apisv2.logestechs.com/api/ship/request/by-email';
            document.getElementById('p_OutboundWebhookUrl').value = 'https://bolcko.com/api/v1/webhooks/delivery/glc/186';
            document.getElementById('p_CompanyId').value = '186';
            document.getElementById('p_ApiEmail').value = 'hamza.a.alhmad@gmail.com';
            document.getElementById('p_ApiPassword').value = 'Ham@123ham';
            document.getElementById('p_PickupAddressLine').value = 'عمان - رأس العين - مستودع القناص';
            document.getElementById('p_PickupVillageId').value = '6176';
            document.getElementById('p_PickupCityId').value = '1130';
            document.getElementById('p_PickupRegionId').value = '33';
            document.getElementById('p_DefaultDeliveryFee').value = '3.00';
            document.getElementById('p_SenderStoreName').value = 'متجر بلوكو لتوريدات البناء';
            document.getElementById('p_SenderPhone').value = '0782023800';
            document.getElementById('p_CustomHeadersJson').value = JSON.stringify({ "company-id": "186" }, null, 2);
            document.getElementById('p_CustomPayloadMappingJson').value = '';
            document.getElementById('p_IsActive').checked = true;
            document.getElementById('providerModal').classList.remove('hidden');
        }

        function editProviderModal(provider) {
            document.getElementById('modalTitle').innerText = 'تعديل شركة التوصيل والـ API';
            document.getElementById('p_Id').value = provider.Id;
            document.getElementById('p_ProviderName').value = provider.ProviderName || '';
            document.getElementById('p_ProviderKey').value = provider.ProviderKey || '';
            document.getElementById('p_BaseUrl').value = provider.BaseUrl || '';
            document.getElementById('p_OutboundWebhookUrl').value = provider.OutboundWebhookUrl || '';
            document.getElementById('p_CompanyId').value = provider.CompanyId || '';
            document.getElementById('p_ApiEmail').value = provider.ApiEmail || '';
            document.getElementById('p_ApiPassword').value = provider.ApiPassword || '';
            document.getElementById('p_PickupAddressLine').value = provider.PickupAddressLine || 'عمان - رأس العين - مستودع القناص';
            document.getElementById('p_PickupVillageId').value = provider.PickupVillageId || 6176;
            document.getElementById('p_PickupCityId').value = provider.PickupCityId || 1130;
            document.getElementById('p_PickupRegionId').value = provider.PickupRegionId || 33;
            document.getElementById('p_DefaultDeliveryFee').value = provider.DefaultDeliveryFee !== undefined && provider.DefaultDeliveryFee !== null ? provider.DefaultDeliveryFee : 3.00;
            document.getElementById('p_SenderStoreName').value = provider.SenderStoreName || 'متجر بلوكو لتوريدات البناء';
            document.getElementById('p_SenderPhone').value = provider.SenderPhone || '0782023800';
            document.getElementById('p_CustomHeadersJson').value = (provider.CustomHeadersJson && provider.CustomHeadersJson.includes('GLC')) ? '' : (provider.CustomHeadersJson || '');
            document.getElementById('p_CustomPayloadMappingJson').value = provider.CustomPayloadMappingJson || '';
            document.getElementById('p_IsActive').checked = provider.IsActive;
            document.getElementById('providerModal').classList.remove('hidden');
        }

        function closeProviderModal() {
            document.getElementById('providerModal').classList.add('hidden');
        }

    function copyText(txt) {
        navigator.clipboard.writeText(txt);
        window.showToast('تم نسخ الرابط بنجاح 📋', 'success');
    }

    function testModalFormConnection() {
        const payload = {
            ProviderName: document.getElementById('p_ProviderName').value,
            ProviderKey: document.getElementById('p_ProviderKey').value,
            BaseUrl: document.getElementById('p_BaseUrl').value,
            CompanyId: document.getElementById('p_CompanyId').value,
            ApiEmail: document.getElementById('p_ApiEmail').value,
            ApiPassword: document.getElementById('p_ApiPassword').value,
            CustomHeadersJson: document.getElementById('p_CustomHeadersJson').value
        };

        if (!payload.BaseUrl || !payload.ApiEmail) {
            window.showToast('يرجى ملء رابط الـ API والبريد الإلكتروني لاختبار الاتصال ⚠️', 'error');
            return;
        }

        window.showToast('جاري تجربة وفحص الاتصال بالـ API فورياً... 📡', 'success');

        fetch('@Url.Action("TestProviderConnection", "DeliverySettings", new { area = "Admin" })', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        })
        .then(r => r.json())
        .then(res => {
            window.showToast(res.message, res.success ? 'success' : 'error');
        })
        .catch(err => {
            window.showToast('حدث خطأ أثناء تجربة الاتصال بالـ API.', 'error');
        });
    }

    function deleteProviderConfig(id, name) {
        window.openTailwindConfirmModal(
            'تأكيد إزالة شركة التوصيل',
            `هل أنت تأكد من إزالة وحذف شركة التوصيل (${name}) نهائياً من السيستم؟`,
            'delete',
            'rose',
            function() {
                fetch('@Url.Action("DeleteProvider", "DeliverySettings", new { area = "Admin" })/' + id, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' }
                })
                .then(r => r.json())
                .then(res => {
                    window.showToast(res.message, res.success ? 'success' : 'error');
                    if (res.success) {
                        setTimeout(() => location.reload(), 1000);
                    }
                })
                .catch(err => {
                    window.showToast('حدث خطأ أثناء حذف الشركة.', 'error');
                });
            }
        );
    }

    function toggleProviderStatus(id) {
        fetch('@Url.Action("ToggleStatus", "DeliverySettings", new { area = "Admin" })', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `id=${id}`
        })
        .then(r => r.json())
        .then(res => {
            if (res.success) {
                if (window.showToast) window.showToast(res.message, 'success'); else alert(res.message);
                setTimeout(() => location.reload(), 800);
            }
        });
    }

    function syncProviderLocations(key) {
        if (window.showToast) window.showToast('جاري مزامنة وحفظ جميع قرى ومناطق الشركة في قاعدة البيانات...', 'success');
        fetch('@Url.Action("SyncLocations", "DeliverySettings", new { area = "Admin" })', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `providerKey=${encodeURIComponent(key)}`
        })
        .then(r => r.json())
        .then(res => {
            if (window.showToast) window.showToast(res.message, res.success ? 'success' : 'error');
            else alert(res.message);
        })
        .catch(err => {
            if (window.showToast) window.showToast('حدث خطأ أثناء مزامنة مناطق الشركة.', 'error');
        });
    }

    function testLogesTechsConnection() {
        if (window.showToast) window.showToast('جاري فحص الاتصال بالـ API...', 'success');
        fetch('@Url.Action("TestConnection", "DeliverySettings", new { area = "Admin" })', { method: 'POST' })
        .then(r => r.json())
        .then(res => {
            if (window.showToast) window.showToast(res.message, res.success ? 'success' : 'error');
            else alert(res.message);
        });
    }
</script>
}
