@model Bolcko.Domain.Entities.Payment.PaymentGatewaySettingsDto
@{
    ViewData["Title"] = "إعدادات وبوابات الدفع";
    ViewData["ParentTitle"] = "إعدادات النظام";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="p-4 md:p-8 space-y-6 text-right font-sans min-h-screen max-w-7xl mx-auto" dir="rtl">
    
    <!-- Breadcrumb Partial -->
    <partial name="~/Areas/Admin/Views/Shared/Partials/_Breadcrumb.cshtml" />

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-900 text-xs font-black flex items-center gap-3 shadow-xs">
            <span class="material-symbols-outlined text-emerald-600 text-xl">check_circle</span>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-2xl bg-rose-500/10 border border-rose-500/20 text-rose-900 text-xs font-black flex items-center gap-3 shadow-xs">
            <span class="material-symbols-outlined text-rose-600 text-xl">error</span>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- Header Actions Zone -->
    <div class="bg-white border border-slate-200 rounded-3xl p-6 md:p-8 shadow-xl shadow-slate-100/60 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-2xl bg-amber-500/10 text-[#E8A020] border border-amber-500/30 flex items-center justify-center font-bold shadow-sm shrink-0">
                <span class="material-symbols-outlined text-2xl">account_balance_wallet</span>
            </div>
            <div class="space-y-1">
                <div class="flex items-center gap-2 flex-wrap">
                    <h2 class="text-lg md:text-xl font-black text-slate-900">
                        مركز وبوابات الدفع الإلكتروني (Payment Gateways Hub)
                    </h2>
                    <span class="bg-emerald-50 text-emerald-700 border border-emerald-200 text-[10px] px-2.5 py-0.5 rounded-full font-black">
                        Dynamic Gateway Engine ⚡
                    </span>
                </div>
                <p class="text-slate-400 text-xs font-medium">
                    التحكم في تفعيل وسائل الدفع (الدفع عند الاستلام، كليك، إي فواتيركم، وبوابات البطاقات) والربط المباشر بمفاتيح الـ API دون كود
                </p>
            </div>
        </div>

        <div class="flex items-center gap-3 w-full md:w-auto justify-end">
            <a href="/" target="_blank" class="bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold px-4 py-2.5 rounded-2xl text-xs transition-all flex items-center gap-1.5 shadow-xs">
                <span class="material-symbols-outlined text-base">storefront</span>
                <span>معاينة المتجر</span>
            </a>
            <button type="submit" form="paymentSettingsForm" class="bg-slate-900 hover:bg-slate-800 text-white font-black px-6 py-2.5 rounded-2xl text-xs transition-all shadow-md active:scale-95 flex items-center gap-2 border border-slate-800">
                <span class="material-symbols-outlined text-lg text-[#E8A020]">save</span>
                <span>حفظ كافة الإعدادات 💾</span>
            </button>
        </div>
    </div>

    <!-- Alert Infobox -->
    <div class="bg-gradient-to-r from-indigo-50/80 via-blue-50/80 to-slate-50 border border-indigo-200/80 rounded-3xl p-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 shadow-sm">
        <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-2xl bg-indigo-600 text-white flex items-center justify-center shrink-0 shadow-md">
                <span class="material-symbols-outlined text-xl">hub</span>
            </div>
            <div class="space-y-1">
                <h3 class="font-black text-slate-900 text-sm">بنية تحتية برمجية ديناميكية جاهزة للتفعيل اللحظي (Zero-Code Ready)</h3>
                <p class="text-xs text-slate-600 font-medium leading-relaxed">
                    حالياً <strong>الدفع عند الاستلام (COD)</strong> هو الخيار النشط لعملائك. عندما تفتح حسابك البنكي أو تستلم اعتماد بوابة الدفع (كليك، إي فواتيركم، Tap, HyperPay, ZainCash)، كل ما عليك هو إدخال المفاتيح وتفعيل الزر ليظهر الخيار مباشرة في صفحة الدفع دون أي حاجة لمطور أو تعديل برمجي.
                </p>
            </div>
        </div>
        <div class="flex items-center gap-2 shrink-0">
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-black bg-emerald-100 text-emerald-800 border border-emerald-300">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                <span>COD مفعّل حالياً</span>
            </span>
        </div>
    </div>

    <!-- 4 Status KPI Summary Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <!-- Card 1: COD -->
        <div class="bg-white border @(Model.CodEnabled ? "border-amber-400 ring-2 ring-amber-400/20 shadow-md" : "border-slate-200") rounded-3xl p-5 space-y-3 transition-all">
            <div class="flex items-center justify-between">
                <div class="w-10 h-10 rounded-2xl bg-amber-50 text-[#E8A020] border border-amber-200 flex items-center justify-center font-black">
                    <span class="material-symbols-outlined text-xl">local_atm</span>
                </div>
                <span class="text-[10px] font-black px-2.5 py-1 rounded-full @(Model.CodEnabled ? "bg-emerald-50 text-emerald-700 border border-emerald-200" : "bg-slate-100 text-slate-500")">
                    @(Model.CodEnabled ? "مفعل في المتجر ⚡" : "معطل ⏸️")
                </span>
            </div>
            <div>
                <h4 class="font-black text-slate-900 text-sm">الدفع عند الاستلام (COD)</h4>
                <p class="text-xs text-slate-400 font-bold mt-0.5">الوسيلة الأساسية المعتمدة حالياً</p>
            </div>
        </div>

        <!-- Card 2: CliQ -->
        <div class="bg-white border @(Model.CliqEnabled ? "border-emerald-400 ring-2 ring-emerald-400/20 shadow-md" : "border-slate-200") rounded-3xl p-5 space-y-3 transition-all">
            <div class="flex items-center justify-between">
                <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-emerald-600 border border-emerald-200 flex items-center justify-center font-black">
                    <span class="material-symbols-outlined text-xl">security</span>
                </div>
                <span class="text-[10px] font-black px-2.5 py-1 rounded-full @(Model.CliqEnabled ? "bg-emerald-50 text-emerald-700 border border-emerald-200" : "bg-slate-100 text-slate-500")">
                    @(Model.CliqEnabled ? "مفعل في المتجر ⚡" : "معطل (بانتظار الآيبان)")
                </span>
            </div>
            <div>
                <h4 class="font-black text-slate-900 text-sm">كليك (CliQ) والضمان</h4>
                <p class="text-xs text-slate-400 font-bold mt-0.5">تحويل بنكي فوري محمي</p>
            </div>
        </div>

        <!-- Card 3: eFAWATEERcom -->
        <div class="bg-white border @(Model.EfawateercomEnabled ? "border-blue-400 ring-2 ring-blue-400/20 shadow-md" : "border-slate-200") rounded-3xl p-5 space-y-3 transition-all">
            <div class="flex items-center justify-between">
                <div class="w-10 h-10 rounded-2xl bg-blue-50 text-blue-600 border border-blue-200 flex items-center justify-center font-black">
                    <span class="material-symbols-outlined text-xl">receipt_long</span>
                </div>
                <span class="text-[10px] font-black px-2.5 py-1 rounded-full @(Model.EfawateercomEnabled ? "bg-emerald-50 text-emerald-700 border border-emerald-200" : "bg-slate-100 text-slate-500")">
                    @(Model.EfawateercomEnabled ? "مفعل في المتجر ⚡" : "معطل (بانتظار المفوتر)")
                </span>
            </div>
            <div>
                <h4 class="font-black text-slate-900 text-sm">إي فواتيركم</h4>
                <p class="text-xs text-slate-400 font-bold mt-0.5">تسديد عبر التطبيقات البنكية</p>
            </div>
        </div>

        <!-- Card 4: Online Cards -->
        <div class="bg-white border @(Model.CardGatewayEnabled ? "border-indigo-400 ring-2 ring-indigo-400/20 shadow-md" : "border-slate-200") rounded-3xl p-5 space-y-3 transition-all">
            <div class="flex items-center justify-between">
                <div class="w-10 h-10 rounded-2xl bg-indigo-50 text-indigo-600 border border-indigo-200 flex items-center justify-center font-black">
                    <span class="material-symbols-outlined text-xl">credit_card</span>
                </div>
                <span class="text-[10px] font-black px-2.5 py-1 rounded-full @(Model.CardGatewayEnabled ? "bg-emerald-50 text-emerald-700 border border-emerald-200" : "bg-slate-100 text-slate-500")">
                    @(Model.CardGatewayEnabled ? $"مفعل ({Model.CardGatewayEnvironment})" : "معطل (بانتظار المفاتيح)")
                </span>
            </div>
            <div>
                <h4 class="font-black text-slate-900 text-sm">بوابات البطاقات والمحافظ</h4>
                <p class="text-xs text-slate-400 font-bold mt-0.5">Visa / Master / Apple Pay</p>
            </div>
        </div>
    </div>

    <!-- Main Settings Form -->
    <form asp-action="Save" method="post" id="paymentSettingsForm" class="space-y-6">
        @Html.AntiForgeryToken()

        <!-- 1. Cash On Delivery (COD) Settings -->
        <div class="bg-white border border-slate-200 rounded-3xl p-6 md:p-8 shadow-sm space-y-6">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-slate-100">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-2xl bg-amber-50 text-[#E8A020] border border-amber-200 flex items-center justify-center font-black">
                        <span class="material-symbols-outlined text-xl">local_atm</span>
                    </div>
                    <div>
                        <h3 class="text-base md:text-lg font-black text-slate-900">1. الدفع عند الاستلام (Cash On Delivery - COD)</h3>
                        <p class="text-xs text-slate-400 font-medium">استلام المبلغ نقداً أو عبر جهاز الدفع POS عند توصيل المواد وفحصها بالموقع</p>
                    </div>
                </div>

                <div class="flex items-center gap-3 bg-slate-50 border border-slate-200 px-4 py-2.5 rounded-2xl">
                    <input asp-for="CodEnabled" type="checkbox" class="w-5 h-5 text-amber-500 border-gray-300 rounded focus:ring-[#E8A020] cursor-pointer" id="chkCod" />
                    <label for="chkCod" class="text-xs font-black text-slate-800 cursor-pointer">تفعيل خيار الدفع عند الاستلام في المتجر</label>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div class="space-y-1.5">
                    <label class="block text-xs font-bold text-slate-700">عنوان الخيار للعميل (عربي) *</label>
                    <input asp-for="CodTitleAr" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs font-bold text-slate-900 focus:bg-white focus:border-[#E8A020] outline-none transition-all" required />
                </div>
                <div class="space-y-1.5">
                    <label class="block text-xs font-bold text-slate-700">Option Title (English) *</label>
                    <input asp-for="CodTitleEn" dir="ltr" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs font-bold text-slate-900 focus:bg-white focus:border-[#E8A020] outline-none transition-all text-start" required />
                </div>
                <div class="space-y-1.5">
                    <label class="block text-xs font-bold text-slate-700">الوصف التوضيحي للعميل (عربي) *</label>
                    <textarea asp-for="CodDescAr" rows="2" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-xs font-bold text-slate-900 focus:bg-white focus:border-[#E8A020] outline-none transition-all leading-relaxed" required></textarea>
                </div>
                <div class="space-y-1.5">
                    <label class="block text-xs font-bold text-slate-700">Description (English) *</label>
                    <textarea asp-for="CodDescEn" rows="2" dir="ltr" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-xs font-bold text-slate-900 focus:bg-white focus:border-[#E8A020] outline-none transition-all leading-relaxed text-start" required></textarea>
                </div>
                <div class="space-y-1.5 md:col-span-2">
                    <label class="block text-xs font-bold text-slate-700">رسوم إضافية لخدمة الدفع عند الاستلام (د.أ - اختياري)</label>
                    <input asp-for="CodExtraFee" type="number" step="0.01" min="0" dir="ltr" class="w-full max-w-xs bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs font-black text-slate-900 focus:bg-white focus:border-[#E8A020] outline-none transition-all text-start" />
                    <p class="text-[10px] text-slate-400 font-medium">اتركه 0.00 إذا كانت الخدمة مجانية دون أي رسوم إضافية.</p>
                </div>
            </div>
        </div>

        <!-- 2. CliQ & Escrow Settings -->
        <div class="bg-white border border-slate-200 rounded-3xl p-6 md:p-8 shadow-sm space-y-6">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-slate-100">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-emerald-600 border border-emerald-200 flex items-center justify-center font-black">
                        <span class="material-symbols-outlined text-xl">security</span>
                    </div>
                    <div>
                        <h3 class="text-base md:text-lg font-black text-slate-900">2. خدمة كليك الفورية وحساب الضمان (CliQ & Escrow Protection)</h3>
                        <p class="text-xs text-slate-400 font-medium">تحويل فوري عبر كليك من التطبيقات المصرفية الأردنية مع حماية استلام البضائع</p>
                    </div>
                </div>

                <div class="flex items-center gap-3 bg-slate-50 border border-slate-200 px-4 py-2.5 rounded-2xl">
                    <input asp-for="CliqEnabled" type="checkbox" class="w-5 h-5 text-emerald-600 border-gray-300 rounded focus:ring-emerald-500 cursor-pointer" id="chkCliq" />
                    <label for="chkCliq" class="text-xs font-black text-slate-800 cursor-pointer">تفعيل كليك في المتجر</label>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div class="space-y-1.5">
                    <label class="block text-xs font-bold text-slate-700">الاسم المستعار في كليك (CliQ Alias)</label>
                    <input asp-for="CliqAlias" placeholder="مثال: BOLCKO أو رقم هاتف المنشأة" dir="ltr" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs font-bold text-slate-900 focus:bg-white focus:border-emerald-500 outline-none transition-all text-start" />
                    <p class="text-[10px] text-slate-400 font-medium">الاسم المستعار المعتمد في تطبيق البنك للتحويل الفوري.</p>
                </div>
                <div class="space-y-1.5">
                    <label class="block text-xs font-bold text-slate-700">اسم البنك المعتمد لحساب كليك</label>
                    <input asp-for="CliqBankName" placeholder="مثال: البنك العربي، بنك الاتحاد، بنك الإسكان..." class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs font-bold text-slate-900 focus:bg-white focus:border-emerald-500 outline-none transition-all" />
                </div>
                <div class="space-y-1.5 md:col-span-2">
                    <label class="block text-xs font-bold text-slate-700">رقم الآيبان البنكي الكامل (IBAN)</label>
                    <input asp-for="CliqIban" placeholder="JO00AAAA0000000000000000000000" dir="ltr" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs font-mono font-bold text-slate-900 focus:bg-white focus:border-emerald-500 outline-none transition-all text-start" />
                </div>

                <div class="space-y-1.5">
                    <label class="block text-xs font-bold text-slate-700">عنوان خيار كليك (عربي)</label>
                    <input asp-for="CliqTitleAr" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs font-bold text-slate-900 focus:bg-white focus:border-emerald-500 outline-none transition-all" />
                </div>
                <div class="space-y-1.5">
                    <label class="block text-xs font-bold text-slate-700">CliQ Title (English)</label>
                    <input asp-for="CliqTitleEn" dir="ltr" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs font-bold text-slate-900 focus:bg-white focus:border-emerald-500 outline-none transition-all text-start" />
                </div>
                <div class="space-y-1.5">
                    <label class="block text-xs font-bold text-slate-700">الوصف التوضيحي لكليك (عربي)</label>
                    <textarea asp-for="CliqDescAr" rows="2" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-xs font-bold text-slate-900 focus:bg-white focus:border-emerald-500 outline-none transition-all leading-relaxed"></textarea>
                </div>
                <div class="space-y-1.5">
                    <label class="block text-xs font-bold text-slate-700">CliQ Description (English)</label>
                    <textarea asp-for="CliqDescEn" rows="2" dir="ltr" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-xs font-bold text-slate-900 focus:bg-white focus:border-emerald-500 outline-none transition-all leading-relaxed text-start"></textarea>
                </div>
            </div>
        </div>

        <!-- 3. eFAWATEERcom Settings -->
        <div class="bg-white border border-slate-200 rounded-3xl p-6 md:p-8 shadow-sm space-y-6">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-slate-100">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-2xl bg-blue-50 text-blue-600 border border-blue-200 flex items-center justify-center font-black">
                        <span class="material-symbols-outlined text-xl">receipt_long</span>
                    </div>
                    <div>
                        <h3 class="text-base md:text-lg font-black text-slate-900">3. خدمة إي فواتيركم (eFAWATEERcom Biller Integration)</h3>
                        <p class="text-xs text-slate-400 font-medium">تسديد مباشر للمشتريات والمشاريع عبر نظام الدفع الوطني الأردني الموحد</p>
                    </div>
                </div>

                <div class="flex items-center gap-3 bg-slate-50 border border-slate-200 px-4 py-2.5 rounded-2xl">
                    <input asp-for="EfawateercomEnabled" type="checkbox" class="w-5 h-5 text-blue-600 border-gray-300 rounded focus:ring-blue-500 cursor-pointer" id="chkEf" />
                    <label for="chkEf" class="text-xs font-black text-slate-800 cursor-pointer">تفعيل إي فواتيركم في المتجر</label>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div class="space-y-1.5">
                    <label class="block text-xs font-bold text-slate-700">رمز المفوتر لدى إي فواتيركم (Biller Code)</label>
                    <input asp-for="EfawateercomBillerCode" placeholder="مثال: 948 أو كود المفوتر الممنوح من البنك المركزي" dir="ltr" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs font-bold text-slate-900 focus:bg-white focus:border-blue-500 outline-none transition-all text-start" />
                </div>
                <div class="space-y-1.5">
                    <label class="block text-xs font-bold text-slate-700">اسم الخدمة المعتمدة في النظام</label>
                    <input asp-for="EfawateercomServiceName" placeholder="توريدات بلوكو الإنشائية" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs font-bold text-slate-900 focus:bg-white focus:border-blue-500 outline-none transition-all" />
                </div>
                <div class="space-y-1.5">
                    <label class="block text-xs font-bold text-slate-700">عنوان خيار إي فواتيركم (عربي)</label>
                    <input asp-for="EfawateercomTitleAr" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs font-bold text-slate-900 focus:bg-white focus:border-blue-500 outline-none transition-all" />
                </div>
                <div class="space-y-1.5">
                    <label class="block text-xs font-bold text-slate-700">eFAWATEERcom Title (English)</label>
                    <input asp-for="EfawateercomTitleEn" dir="ltr" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs font-bold text-slate-900 focus:bg-white focus:border-blue-500 outline-none transition-all text-start" />
                </div>
                <div class="space-y-1.5 md:col-span-2">
                    <label class="block text-xs font-bold text-slate-700">الوصف التوضيحي للعميل</label>
                    <textarea asp-for="EfawateercomDescAr" rows="2" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-xs font-bold text-slate-900 focus:bg-white focus:border-blue-500 outline-none transition-all leading-relaxed"></textarea>
                </div>
            </div>
        </div>

        <!-- 4. Online Card Gateway Settings -->
        <div class="bg-white border border-slate-200 rounded-3xl p-6 md:p-8 shadow-sm space-y-6">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-slate-100">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-2xl bg-indigo-50 text-indigo-600 border border-indigo-200 flex items-center justify-center font-black">
                        <span class="material-symbols-outlined text-xl">credit_card</span>
                    </div>
                    <div>
                        <h3 class="text-base md:text-lg font-black text-slate-900">4. بوابات البطاقات والمحافظ الإلكترونية (Online Payment Gateways)</h3>
                        <p class="text-xs text-slate-400 font-medium">الربط مع بوابات الدفع البنكية (Visa, MasterCard, Apple Pay, ZainCash, MPGS, Tap, HyperPay)</p>
                    </div>
                </div>

                <div class="flex items-center gap-3 bg-slate-50 border border-slate-200 px-4 py-2.5 rounded-2xl">
                    <input asp-for="CardGatewayEnabled" type="checkbox" class="w-5 h-5 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500 cursor-pointer" id="chkCard" />
                    <label for="chkCard" class="text-xs font-black text-slate-800 cursor-pointer">تفعيل بوابة البطاقات في المتجر</label>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
                <div class="space-y-1.5">
                    <label class="block text-xs font-bold text-slate-700">مزود بوابة الدفع (Gateway Provider)</label>
                    <select asp-for="CardGatewayProvider" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs font-bold text-slate-900 focus:bg-white focus:border-indigo-500 outline-none transition-all">
                        <option value="Generic">بوابة عامة (Generic Webhook Gateway)</option>
                        <option value="Tap">Tap Payments (تاب بيمنتس)</option>
                        <option value="HyperPay">HyperPay (هايبر باي)</option>
                        <option value="MPGS">Arab Bank MPGS (ماستركارد جيت واي - البنك العربي)</option>
                        <option value="ZainCash">Zain Cash Jordan (زين كاش الأردن)</option>
                        <option value="PayTabs">PayTabs (بي تابس)</option>
                        <option value="Stripe">Stripe Payments (سترايب)</option>
                    </select>
                </div>

                <div class="space-y-1.5">
                    <label class="block text-xs font-bold text-slate-700">بيئة التشغيل (Environment Mode)</label>
                    <select asp-for="CardGatewayEnvironment" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs font-bold text-slate-900 focus:bg-white focus:border-indigo-500 outline-none transition-all">
                        <option value="Sandbox">تجريبي (Sandbox / Test Mode) 🧪</option>
                        <option value="Live">إنتاج مباشر (Live / Production Mode) 🚀</option>
                    </select>
                </div>

                <div class="space-y-1.5">
                    <label class="block text-xs font-bold text-slate-700">العملة الأساسية للمطالبة</label>
                    <input asp-for="CardGatewayCurrency" value="JOD" dir="ltr" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs font-bold text-slate-900 focus:bg-white focus:border-indigo-500 outline-none transition-all text-start" />
                </div>

                <div class="space-y-1.5">
                    <label class="block text-xs font-bold text-slate-700">معرف التاجر / الحساب (Merchant ID / Entity ID)</label>
                    <input asp-for="CardGatewayMerchantId" placeholder="e.g. merch_12345678" dir="ltr" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs font-mono font-bold text-slate-900 focus:bg-white focus:border-indigo-500 outline-none transition-all text-start" />
                </div>

                <div class="space-y-1.5">
                    <label class="block text-xs font-bold text-slate-700">المفتاح العام (API Key / Public Key)</label>
                    <input asp-for="CardGatewayApiKey" placeholder="pk_test_... or api_key" dir="ltr" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs font-mono font-bold text-slate-900 focus:bg-white focus:border-indigo-500 outline-none transition-all text-start" />
                </div>

                <div class="space-y-1.5">
                    <label class="block text-xs font-bold text-slate-700">المفتاح السري (Secret Key / Private Key)</label>
                    <input asp-for="CardGatewaySecretKey" type="password" placeholder="sk_test_... or secret" dir="ltr" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs font-mono font-bold text-slate-900 focus:bg-white focus:border-indigo-500 outline-none transition-all text-start" />
                </div>

                <div class="space-y-1.5 md:col-span-2">
                    <label class="block text-xs font-bold text-slate-700">مفتاح تأكيد الويب هوك (Webhook Secret / Signature Key)</label>
                    <input asp-for="CardGatewayWebhookSecret" placeholder="whsec_... (اختياري للتحقق من إشعار الدفع الفوري)" dir="ltr" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs font-mono font-bold text-slate-900 focus:bg-white focus:border-indigo-500 outline-none transition-all text-start" />
                </div>

                <div class="space-y-1.5">
                    <label class="block text-xs font-bold text-slate-700">رابط الـ API الأساسي (Base URL - اختياري)</label>
                    <input asp-for="CardGatewayBaseUrl" placeholder="https://api.tap.company/v2/" dir="ltr" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs font-mono font-bold text-slate-900 focus:bg-white focus:border-indigo-500 outline-none transition-all text-start" />
                </div>

                <div class="space-y-1.5 md:col-span-2">
                    <label class="block text-xs font-bold text-slate-700">عنوان وسيلة البطاقات للعميل (عربي)</label>
                    <input asp-for="CardGatewayTitleAr" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs font-bold text-slate-900 focus:bg-white focus:border-indigo-500 outline-none transition-all" />
                </div>

                <div class="space-y-1.5">
                    <label class="block text-xs font-bold text-slate-700">Title (English)</label>
                    <input asp-for="CardGatewayTitleEn" dir="ltr" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs font-bold text-slate-900 focus:bg-white focus:border-indigo-500 outline-none transition-all text-start" />
                </div>
            </div>
        </div>

        <!-- Sticky Bottom Submit Bar -->
        <div class="sticky bottom-6 z-20 bg-slate-900 text-white rounded-3xl p-4 sm:p-5 shadow-2xl flex items-center justify-between gap-4 border border-slate-800">
            <div class="flex items-center gap-3">
                <span class="material-symbols-outlined text-[#E8A020] text-2xl">verified_user</span>
                <div>
                    <h4 class="font-black text-xs text-white">حفظ وتطبيق التغييرات فورياً</h4>
                    <p class="text-[11px] text-slate-400 font-medium">يتم تحديث وسائل الدفع المتاحة في سلة التسوق وصفحة إتمام الطلب مباشرة.</p>
                </div>
            </div>

            <button type="submit" class="bg-[#E8A020] hover:bg-amber-500 text-slate-950 font-black px-8 py-3 rounded-2xl text-xs transition-all shadow-lg active:scale-95 flex items-center gap-2 cursor-pointer">
                <span class="material-symbols-outlined text-base">save</span>
                <span>حفظ كافة التعديلات والتفعيل</span>
            </button>
        </div>
    </form>
</div>
