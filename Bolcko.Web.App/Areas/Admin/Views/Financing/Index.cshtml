@model Bolcko.Domain.Entities.Financing.DTOs.AdminFinancingOverviewDto
@{
    ViewData["Title"] = "إدارة التمويل بالمرابحة والحوكمة المالية";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<section class="p-6 sm:p-8 space-y-8 text-right animate-in fade-in duration-500">
    
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-black text-slate-900 flex items-center gap-2">
                <span class="material-symbols-outlined text-primary text-3xl">account_balance</span>
                <span>إدارة التمويل بالمرابحة وحساب الضمان Escrow</span>
            </h1>
            <p class="text-slate-500 text-sm mt-1">متابعة عطاءات التمويل، الرقابة على القبض الحكمي، والتحقق الجغرافي GPS والتسويات المالية.</p>
        </div>

        <div class="flex items-center gap-3">
            <a href="/Shop/Financing" target="_blank" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl transition-colors flex items-center gap-1.5 shadow-sm">
                <span class="material-symbols-outlined text-sm">open_in_new</span>
                <span>سوق التمويل المفتوح</span>
            </a>
            <a asp-action="Investors" class="px-4 py-2 bg-primary hover:bg-primary/90 text-white text-xs font-bold rounded-xl transition-colors flex items-center gap-1.5 shadow-sm">
                <span class="material-symbols-outlined text-sm">wallet</span>
                <span>محافظ المستثمرين</span>
            </a>
        </div>
    </div>

    <!-- 1. Real-time Escrow & Financial KPI Grid -->
    <partial name="Partials/_FinancingKpiGrid" model="Model" />

    <!-- 2. Comprehensive Tenders Audit & Compliance Table -->
    <partial name="Partials/_TendersAuditTable" model="Model.AllTenders" />

</section>
