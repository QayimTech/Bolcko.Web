@model Bolcko.Domain.Entities.Financing.DTOs.AdminFinancingOverviewDto
@{
    ViewData["Title"] = "إدارة التمويل بالمرابحة الإسلامية";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<section class="p-6 sm:p-8 space-y-8 text-right animate-in fade-in duration-500">
    
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-black text-slate-900 flex items-center gap-2">
                <span class="material-symbols-outlined text-primary text-3xl">account_balance</span>
                <span>إدارة التمويل بالمرابحة والرقابة الشرعية</span>
            </h1>
            <p class="text-slate-500 text-sm mt-1">متابعة عطاءات التمويل، إثباتات التسليم بالـ GPS، واقتطاع أجر الوكالة للمنصة.</p>
        </div>

        <div class="flex items-center gap-3">
            <a href="/Shop/Financing" target="_blank" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-lg transition-colors flex items-center gap-1.5">
                <span class="material-symbols-outlined text-sm">open_in_new</span>
                <span>بوابة المستثمرين</span>
            </a>
        </div>
    </div>

    <!-- Metrics Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        
        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
            <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-bold text-slate-500">إجمالي التمويل الميسر</span>
                <span class="material-symbols-outlined text-emerald-600">payments</span>
            </div>
            <p class="text-2xl font-black text-slate-900 font-mono">@Model.TotalFacilitatedFinancingJod.ToString("N0") <span class="text-xs font-normal text-slate-500">د.أ</span></p>
            <p class="text-[11px] text-slate-400 mt-1">بضائع وأصول عينية مشتراة</p>
        </div>

        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
            <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-bold text-slate-500">أجر وكالة المنصة المحصل</span>
                <span class="material-symbols-outlined text-amber-600">receipt_long</span>
            </div>
            <p class="text-2xl font-black text-amber-600 font-mono">@Model.TotalPlatformFeesCollectedJod.ToString("N0") <span class="text-xs font-normal text-slate-500">د.أ</span></p>
            <p class="text-[11px] text-slate-400 mt-1">1.5% أجر وكالة شرعي للمنصة</p>
        </div>

        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
            <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-bold text-slate-500">أرباح المستثمرين الموزعة</span>
                <span class="material-symbols-outlined text-sky-600">trending_up</span>
            </div>
            <p class="text-2xl font-black text-sky-600 font-mono">@Model.TotalInvestorProfitsDistributedJod.ToString("N0") <span class="text-xs font-normal text-slate-500">د.أ</span></p>
            <p class="text-[11px] text-slate-400 mt-1">عوائد صافية محولة للممولين</p>
        </div>

        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
            <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-bold text-slate-500">العطاءات النشطة</span>
                <span class="material-symbols-outlined text-purple-600">local_shipping</span>
            </div>
            <p class="text-2xl font-black text-purple-600 font-mono">@(Model.InTransitCount + Model.DeliveredPendingSettlementCount) <span class="text-xs font-normal text-slate-500">عطاء</span></p>
            <p class="text-[11px] text-slate-400 mt-1">@Model.DeliveredPendingSettlementCount بانتظار السداد النهائي</p>
        </div>

    </div>

    <!-- Tenders Table -->
    <div class="bg-white border border-slate-200 shadow-sm overflow-hidden rounded-xl">
        <div class="p-4 border-b border-slate-100 flex items-center justify-between bg-slate-50">
            <h2 class="font-bold text-sm text-slate-800">جميع عطاءات المرابحة والتوثيق</h2>
            <span class="text-xs font-mono text-slate-500 font-bold">@Model.AllTenders.Count عطاء</span>
        </div>

        <div class="overflow-x-auto w-full">
            <table class="w-full text-right border-collapse min-w-[900px] text-xs">
                <thead>
                    <tr class="bg-slate-50/60 border-b border-slate-200 text-slate-500 font-bold">
                        <th class="px-4 py-3">رمز العطاء</th>
                        <th class="px-4 py-3">المشروع والمدينة</th>
                        <th class="px-4 py-3">المقاول</th>
                        <th class="px-4 py-3">المستثمر الممول</th>
                        <th class="px-4 py-3 text-end">رأس المال</th>
                        <th class="px-4 py-3 text-end">أجر الوكالة</th>
                        <th class="px-4 py-3 text-center">المدة</th>
                        <th class="px-4 py-3 text-center">الحالة</th>
                        <th class="px-4 py-3 text-center">الإجراءات</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var t in Model.AllTenders)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-4 py-3 font-mono font-bold text-primary">@t.TrackingCode</td>
                            <td class="px-4 py-3 font-bold text-slate-900">
                                <div>@t.ProjectTitle</div>
                                <div class="text-[10px] text-slate-400 font-normal">@t.ProjectCity</div>
                            </td>
                            <td class="px-4 py-3">
                                <div class="font-semibold text-slate-800">@t.ContractorName</div>
                                <div class="text-[10px] text-slate-400 font-mono">@t.ContractorPhone</div>
                            </td>
                            <td class="px-4 py-3">
                                @if (!string.IsNullOrEmpty(t.FunderName))
                                {
                                    <div class="font-semibold text-emerald-700">@t.FunderName</div>
                                }
                                else
                                {
                                    <span class="text-slate-400 italic">بانتظار التمويل</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-end font-mono font-bold text-slate-900">@t.BaseMaterialCost.ToString("N0") د.أ</td>
                            <td class="px-4 py-3 text-end font-mono font-bold text-amber-600">@t.PlatformAgencyFeeAmount.ToString("N0") د.أ</td>
                            <td class="px-4 py-3 text-center font-mono">@t.TenureDays يوم</td>
                            <td class="px-4 py-3 text-center">
                                <span class="px-2.5 py-1 text-[10px] font-bold rounded-full bg-slate-100 text-slate-700">
                                    @t.StatusNameAr
                                </span>
                            </td>
                            <td class="px-4 py-3 text-center">
                                <a href="@Url.Action("Details", new { id = t.Id })" class="px-3 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold rounded transition-colors text-[11px] inline-flex items-center gap-1">
                                    <span class="material-symbols-outlined text-xs">visibility</span>
                                    <span>تدقيق</span>
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.AllTenders.Any())
                    {
                        <tr>
                            <td colspan="9" class="px-6 py-12 text-center text-slate-400 italic">
                                لا توجد عطاءات مسجلة حتى الآن.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</section>
