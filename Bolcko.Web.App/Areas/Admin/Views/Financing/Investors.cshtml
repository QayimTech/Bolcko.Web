@model IEnumerable<Bolcko.Domain.Entities.User.User>
@{
    ViewData["Title"] = "إدارة وتدقيق المستثمرين الماليين (Fintech & AML Investors)";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var isArabic = System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("ar");
}

<div class="space-y-6">
    <!-- Top Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 bg-[#151C2C] border border-white/10 rounded-2xl p-6">
        <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-sky-500/10 text-sky-400 border border-sky-500/20 text-xs font-bold mb-2">
                <span class="material-symbols-outlined text-[16px]">account_balance</span>
                <span>بوابة الامتثال والرقابة المالية (AML / KYC)</span>
            </div>
            <h1 class="text-xl sm:text-2xl font-black text-white">إدارة وتدقيق حسابات المستثمرين</h1>
            <p class="text-xs sm:text-sm text-slate-400 mt-1">مراجعة بيانات الملاءمة المالية، مصادر الأموال، وتفعيل محافظ المستثمرين في مرابحة بلكو.</p>
        </div>
        <div class="flex items-center gap-3">
            <a asp-action="Index" class="px-4 py-2.5 rounded-xl bg-white/5 hover:bg-white/10 text-slate-300 font-bold text-xs border border-white/10 transition-all flex items-center gap-2">
                <span class="material-symbols-outlined text-[18px]">trending_up</span>
                <span>لوحة التمويل العام</span>
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-bold flex items-center gap-3">
            <span class="material-symbols-outlined text-[20px]">check_circle</span>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    <!-- Investors Table -->
    <div class="bg-[#151C2C] border border-white/10 rounded-2xl overflow-hidden shadow-xl">
        <div class="px-6 py-4 border-b border-white/10 flex items-center justify-between">
            <h2 class="text-sm font-bold text-white flex items-center gap-2">
                <span class="material-symbols-outlined text-[18px] text-amber-400">group</span>
                <span>قائمة المستثمرين المسجلين (@Model?.Count() ?? 0)</span>
            </h2>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full text-start text-xs">
                    <thead>
                        <tr class="bg-white/5 border-b border-white/10 text-slate-400 font-bold">
                            <th class="py-3.5 px-4 text-start">المستثمر / الكيان</th>
                            <th class="py-3.5 px-4 text-start">الهوية / السجل التجاري</th>
                            <th class="py-3.5 px-4 text-start">الاتصال</th>
                            <th class="py-3.5 px-4 text-start">تاريخ التسجيل</th>
                            <th class="py-3.5 px-4 text-start">حالة المحفظة</th>
                            <th class="py-3.5 px-4 text-end">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-white/5 text-slate-200">
                        @foreach (var inv in Model)
                        {
                            <tr class="hover:bg-white/5 transition-colors">
                                <td class="py-4 px-4 font-bold text-white">
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-9 rounded-xl bg-sky-500/20 text-sky-400 flex items-center justify-center font-black text-xs">
                                            @(inv.FirstName.Length > 0 ? inv.FirstName.Substring(0, 1).ToUpper() : "I")
                                        </div>
                                        <div>
                                            <p class="font-bold text-white">@inv.FirstName @inv.LastName</p>
                                            <p class="text-[10px] text-slate-400 font-normal">@inv.CompanyName</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-4 px-4 font-mono text-slate-300">
                                    @(string.IsNullOrEmpty(inv.BusinessRegistrationNumber) ? "غير محدد" : inv.BusinessRegistrationNumber)
                                </td>
                                <td class="py-4 px-4">
                                    <p class="text-slate-300">@inv.Email</p>
                                    <p class="text-[10px] text-slate-400 font-mono">@inv.PhoneNumber</p>
                                </td>
                                <td class="py-4 px-4 text-slate-400">
                                    @inv.RegistrationDate.ToString("yyyy/MM/dd HH:mm")
                                </td>
                                <td class="py-4 px-4">
                                    @if (inv.EmailConfirmed)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 text-[10px] font-bold">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                                            محفظة معتمدة ونشطة
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30 text-[10px] font-bold animate-pulse">
                                            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                                            قيد مراجعة الامتثال (Pending AML)
                                        </span>
                                    }
                                </td>
                                <td class="py-4 px-4 text-end">
                                    @if (!inv.EmailConfirmed)
                                    {
                                        <form asp-action="ApproveInvestor" asp-route-id="@inv.Id" method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="px-3.5 py-1.5 rounded-xl bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-300 border border-emerald-500/40 text-[11px] font-bold transition-all inline-flex items-center gap-1">
                                                <span class="material-symbols-outlined text-[15px]">verified</span>
                                                <span>اعتماد وتفعيل المحفظة</span>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-slate-500 font-medium">مفعل</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="py-16 text-center text-slate-400">
                <span class="material-symbols-outlined text-5xl mb-3 text-slate-600">person_off</span>
                <p class="text-sm font-bold">لا يوجد مستثمرون مسجلون حالياً</p>
                <p class="text-xs text-slate-500 mt-1">طلبات الانضمام الجديدة عبر /Shop/Financing/InvestorJoin ستظهر هنا فورياً.</p>
            </div>
        }
    </div>
</div>
