@model Bolcko.Domain.Entities.Financing.DTOs.FinancingTenderDto
@{
    ViewData["Title"] = $"تدقيق عطاء المرابحة {Model.TrackingCode}";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<section class="p-6 sm:p-8 space-y-8 text-right animate-in fade-in duration-500">
    
    <!-- Top Bar -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <a href="@Url.Action("Index")" class="text-xs text-slate-500 hover:text-primary flex items-center gap-1 font-bold">
                    <span class="material-symbols-outlined text-sm">arrow_forward</span>
                    <span>العودة للرقابة المالية</span>
                </a>
            </div>
            <h1 class="text-2xl font-black text-slate-900 flex items-center gap-2">
                <span>عطاء التمويل: @Model.TrackingCode</span>
                <span class="px-3 py-0.5 rounded-full text-xs font-black bg-amber-100 text-amber-800">@Model.StatusNameAr</span>
            </h1>
            <p class="text-slate-500 text-xs mt-1">@Model.ProjectTitle - @Model.ProjectCity</p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
            <a href="/Shop/Financing/Contract/@Model.Id" target="_blank" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl transition-colors flex items-center gap-1.5 shadow-sm">
                <span class="material-symbols-outlined text-sm">gavel</span>
                <span>العقد الشرعي A4</span>
            </a>
            <a href="/Shop/Financing/PossessionNotice/@Model.Id" target="_blank" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl transition-colors flex items-center gap-1.5 shadow-sm">
                <span class="material-symbols-outlined text-sm">verified</span>
                <span>شهادة القبض الحكمي</span>
            </a>
            @if (Model.Status == Bolcko.Domain.Enums.FinancingTenderStatus.Delivered)
            {
                <form asp-action="Settle" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" onclick="return confirm('تأكيد التسوية المالية وإفراج الأرباح للمستثمر واقتطاع أجر الوكالة؟')" class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold rounded-xl transition-colors flex items-center gap-1.5 shadow-sm">
                        <span class="material-symbols-outlined text-sm">task_alt</span>
                        <span>إتمام التسوية وتوزيع الأرباح</span>
                    </button>
                </form>
            }
            <a href="/Shop/Financing/DriverPOD/@Model.Id" target="_blank" class="px-4 py-2 bg-primary hover:bg-primary/90 text-white text-xs font-bold rounded-xl transition-colors flex items-center gap-1.5 shadow-sm">
                <span class="material-symbols-outlined text-sm">qr_code_scanner</span>
                <span>بوابة السائق الموقعي</span>
            </a>
        </div>
    </div>

    <!-- Financial Breakdown Card -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-1">
            <span class="text-xs text-slate-500 block font-bold">رأس المال المشترى (صافي التكلفة)</span>
            <span class="text-2xl font-black text-slate-900 font-mono">@Model.BaseMaterialCost.ToString("N0") د.أ</span>
            <span class="text-[11px] text-slate-400 block">مدفوع للمورد المعتمد من حساب الضمان</span>
        </div>
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-1">
            <span class="text-xs text-slate-500 block font-bold">أجر وكالة المنصة (1.5%)</span>
            <span class="text-2xl font-black text-amber-600 font-mono">@Model.PlatformAgencyFeeAmount.ToString("N0") د.أ</span>
            <span class="text-[11px] text-slate-400 block">أجر شرعي مقابل التنسيق والرقابة الفنية</span>
        </div>
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-1">
            <span class="text-xs text-slate-500 block font-bold">ربح المستثمر الصافي</span>
            <span class="text-2xl font-black text-emerald-600 font-mono">@Model.InvestorNetYieldAmount.ToString("N0") د.أ</span>
            <span class="text-[11px] text-slate-400 font-mono block">(@Model.AnnualizedYieldPercentage% عائد سنوي مكافئ)</span>
        </div>
    </div>

    <!-- Details Sections Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        
        <!-- Parties Information -->
        <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
            <h2 class="font-bold text-sm text-slate-900 pb-3 border-b border-slate-100 flex items-center gap-2">
                <span class="material-symbols-outlined text-primary text-base">groups</span>
                <span>أطراف عقد المرابحة والوكالة</span>
            </h2>

            <div class="space-y-3 text-xs">
                <div class="p-3 bg-slate-50 rounded-xl">
                    <span class="text-[10px] text-slate-400 block uppercase font-bold">المشتري / المقاول الآمر بالشراء</span>
                    <p class="font-bold text-slate-900 mt-0.5">@Model.ContractorName (@Model.ContractorCompany)</p>
                    <p class="text-slate-500 font-mono mt-0.5">@Model.ContractorPhone</p>
                    <div class="flex items-center gap-2 mt-1">
                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-800">
                            مؤشر الجدارة الائتمانية CRIF: @Model.ContractorTrustScore / 100
                        </span>
                    </div>
                </div>

                <div class="p-3 bg-slate-50 rounded-xl">
                    <span class="text-[10px] text-slate-400 block uppercase font-bold">المستثمر الممول (الموكل)</span>
                    <p class="font-bold text-slate-900 mt-0.5">@(string.IsNullOrEmpty(Model.FunderName) ? "غير مخصص بعد" : Model.FunderName)</p>
                    <p class="text-slate-500 font-mono mt-0.5">@(string.IsNullOrEmpty(Model.FunderPhone) ? "-" : Model.FunderPhone)</p>
                </div>

                <div class="p-3 bg-slate-50 rounded-xl">
                    <span class="text-[10px] text-slate-400 block uppercase font-bold">الموقع الجغرافي للمشروع والتحقق (Geofencing)</span>
                    <p class="text-slate-700 mt-0.5 font-mono">Lat: @Model.TargetLatitude, Lng: @Model.TargetLongitude</p>
                    <p class="text-slate-500 mt-0.5">@Model.ProjectCity - @Model.ProjectAddress</p>
                </div>
            </div>
        </div>

        <!-- Material Items List -->
        <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
            <h2 class="font-bold text-sm text-slate-900 pb-3 border-b border-slate-100 flex items-center gap-2">
                <span class="material-symbols-outlined text-primary text-base">inventory_2</span>
                <span>كشف المواد العينية المشتراة</span>
            </h2>

            <div class="overflow-x-auto">
                <table class="w-full text-right text-xs">
                    <thead>
                        <tr class="border-b border-slate-100 text-slate-400 font-bold">
                            <th class="py-2.5">المادة</th>
                            <th class="py-2.5 text-center">الكمية</th>
                            <th class="py-2.5 text-end">سعر الوحدة</th>
                            <th class="py-2.5 text-end">المجموع</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50 text-slate-700">
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="py-3 font-semibold">@item.MaterialName</td>
                                <td class="py-3 text-center font-mono">@item.Quantity @item.Unit</td>
                                <td class="py-3 text-end font-mono">@item.UnitPriceJod.ToString("N2") د.أ</td>
                                <td class="py-3 text-end font-mono font-bold text-slate-900">@item.SubtotalJod.ToString("N2") د.أ</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>

</section>
