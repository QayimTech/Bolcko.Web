@using Bolcko.Domain.Entities.User
@using Bolcko.Web.App.Areas.Admin.Models.ViewModels
@model UserIndexViewModel
@{
    ViewData["Title"] = "إدارة المستخدمين";
    ViewData["ParentTitle"] = "إدارة النظام";
    
    var addUserUrl = Url.Action("CreateAdminUser", "User", new { area = "Admin" });
    var rolesUrl = Url.Action("Roles", "User", new { area = "Admin" });
    
    ViewData["HeaderActions"] = $@"
        <a href='{rolesUrl}' class='bg-slate-900 hover:bg-slate-800 text-white px-4 py-2.5 rounded-xl text-xs font-black transition-all flex items-center gap-1.5 shadow-sm active:scale-95'>
            <span class='material-symbols-outlined text-sm text-[#E8A020]'>admin_panel_settings</span>
            <span>إدارة الصلاحيات</span>
        </a>
        <a href='{addUserUrl}' class='bg-[#E8A020] hover:bg-[#d49018] text-slate-950 px-4 py-2.5 rounded-xl text-xs font-black transition-all flex items-center gap-1.5 shadow-sm active:scale-95'>
            <span class='material-symbols-outlined text-sm'>person_add</span>
            <span>إضافة مستخدم</span>
        </a>
    ";
}

<div class="p-8 space-y-6 flex-1 text-right" dir="rtl">
    <partial name="~/Areas/Admin/Views/Shared/Partials/_Breadcrumb.cshtml" />

    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
        
        @{
            var roleOptions = new List<SelectListItem>();
            if (ViewBag.Roles != null)
            {
                foreach (string r in ViewBag.Roles)
                {
                    var label = r switch
                    {
                        "Admin" => "سوبر أدمن",
                        "DashboardUser" => "أدمن داشبورد",
                        "Customer" => "مشتري / زبون",
                        "DeliveryDriver" => "مندوب توصيل",
                        "DeliveryCompanyUser" => "شركة توصيل",
                        _ => r
                    };
                    roleOptions.Add(new SelectListItem { Value = r, Text = label, Selected = Model.RoleFilter == r });
                }
            }

            ViewData["SearchPlaceholder"] = "بحث بالاسم، البريد الإلكتروني، أو الهاتف...";
            ViewData["SearchValue"] = Model.Search;
            ViewData["SelectName"] = "roleFilter";
            ViewData["SelectLabel"] = "جميع الأدوار";
            ViewData["SelectValue"] = Model.RoleFilter;
            ViewData["SelectOptions"] = roleOptions;
            ViewData["Action"] = "Index";
            ViewData["Controller"] = "User";
        }
        <partial name="~/Views/Shared/Partials/_GridFilter.cshtml" />

        @* Pagination on top as requested *@
        <partial name="~/Views/Shared/Partials/_Pagination.cshtml" model="Model.Users" />
        
        <div class="overflow-x-auto">
            <table class="w-full text-right">
                <thead class="bg-slate-100 text-[#1B2235] font-bold text-[10px] uppercase tracking-widest">
                    <tr>
                        <th class="px-6 py-3">@L["Name"]</th>
                        <th class="px-6 py-3">@L["Email"]</th>
                        <th class="px-6 py-3">@L["UserType"]</th>
                        <th class="px-6 py-3">@L["RegistrationDate"]</th>
                        <th class="px-6 py-3">@L["Actions"]</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-sm">
                    @foreach (var user in Model.Users.Items)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-6 py-4 font-bold text-[#1B2235]">@user.FirstName @user.LastName</td>
                            <td class="px-6 py-4">@user.Email</td>
                            <td class="px-6 py-4">
                                @{
                                    var role = Model.UserRoles.TryGetValue(user.Id, out var r) ? r : user.UserType.ToString();
                                    var roleBadge = role switch
                                    {
                                        "Admin" => "bg-purple-100 text-purple-800 border border-purple-200",
                                        "DashboardUser" => "bg-blue-100 text-blue-800 border border-blue-200",
                                        "Customer" => "bg-emerald-100 text-emerald-800 border border-emerald-200",
                                        "DeliveryDriver" => "bg-amber-100 text-amber-800 border border-amber-200",
                                        "DeliveryCompanyUser" => "bg-indigo-100 text-indigo-800 border border-indigo-200",
                                        _ => "bg-slate-100 text-slate-800"
                                    };
                                    var roleLabel = role switch
                                    {
                                        "Admin" => "سوبر أدمن",
                                        "DashboardUser" => "أدمن داشبورد",
                                        "Customer" => "مشتري / زبون",
                                        "DeliveryDriver" => "مندوب توصيل",
                                        "DeliveryCompanyUser" => "شركة توصيل",
                                        _ => role
                                    };
                                }
                                <span class="px-2.5 py-1 text-xs font-black rounded-lg @roleBadge">@roleLabel</span>
                            </td>
                            <td class="px-6 py-4 text-xs">@user.RegistrationDate.ToString("yyyy/MM/dd")</td>
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-1.5 justify-end">
                                    @if (role != "Admin")
                                    {
                                        <form asp-action="ImpersonateUser" asp-controller="User" asp-area="Admin" method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <button type="submit" class="bg-indigo-50 hover:bg-indigo-100 text-indigo-700 border border-indigo-200/80 px-2.5 py-1 rounded-lg text-xs font-bold transition-all flex items-center gap-1 active:scale-95" title="تصفح المنصة كـ هذا المستخدم">
                                                <span class="material-symbols-outlined text-xs">visibility</span>
                                                <span>تصفح كـ</span>
                                            </button>
                                        </form>
                                    }
                                    <a href="@Url.Action("Edit", "User", new { area = "Admin", id = user.Id })" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-2.5 py-1 rounded-lg text-xs font-bold transition-all flex items-center gap-1">
                                        <span class="material-symbols-outlined text-xs">edit</span>
                                        <span>تعديل</span>
                                    </a>
                                    <form asp-action="Delete" method="post" class="inline" onsubmit="event.preventDefault(); requireDeleteConfirm(this, 'user');">
                                        <input type="hidden" name="id" value="@user.Id" />
                                        <button type="submit" class="bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200/80 px-2.5 py-1 rounded-lg text-xs font-bold transition-all flex items-center gap-1">
                                            <span class="material-symbols-outlined text-xs">delete</span>
                                            <span>حذف</span>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        @* Pagination also on bottom for better UX *@
        <partial name="~/Views/Shared/Partials/_Pagination.cshtml" model="Model.Users" />
    </div>
</section>
