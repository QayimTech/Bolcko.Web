@using Microsoft.AspNetCore.Diagnostics
@model ErrorViewModel
@{
    ViewData["Title"] = "حدث خطأ غير متوقع - لوحة الإدارة";
    var exceptionFeature = Context.Features.Get<IExceptionHandlerPathFeature>();
}

<div class="max-w-4xl mx-auto p-6 my-8">
    <div class="bg-red-50 border-r-4 border-red-500 p-6 rounded-xl shadow-sm text-right" dir="rtl">
        <h1 class="text-2xl font-black text-red-700 mb-2">عذراً، حدث خطأ أثناء معالجة الطلب</h1>
        <p class="text-sm text-slate-600 mb-4">تم تسجيل تفاصيل هذا الخطأ في نظام السجلات لمراجعته ومعالجته فوراً.</p>

        @if (Model?.ShowRequestId == true)
        {
            <div class="inline-block bg-white px-3 py-1.5 rounded-lg border border-red-200 text-xs font-mono text-red-800 mb-4">
                <strong>معرف الطلب (Request ID):</strong> <code>@Model.RequestId</code>
            </div>
        }

        <div class="mt-4 flex gap-3">
            <a href="/Admin" class="bg-slate-900 text-white px-5 py-2 rounded-lg font-bold text-xs hover:bg-slate-800 transition-all">لوحة الإدارة</a>
            <button onclick="window.history.back()" class="bg-white border border-slate-300 text-slate-700 px-5 py-2 rounded-lg font-bold text-xs hover:bg-slate-50 transition-all">الصفحة السابقة</button>
        </div>
    </div>

    @if (exceptionFeature != null)
    {
        <div class="mt-8 bg-slate-900 text-slate-100 rounded-xl p-6 shadow-lg text-left" dir="ltr">
            <div class="flex items-center justify-between border-b border-slate-800 pb-3 mb-4">
                <span class="text-xs font-mono uppercase text-red-400 font-bold">Diagnostic Trace (Admin View)</span>
                <span class="text-xs font-mono text-slate-400">Path: @exceptionFeature.Path</span>
            </div>

            <div class="mb-4">
                <div class="text-red-400 font-bold font-mono text-sm break-all">
                    @exceptionFeature.Error.GetType().FullName: @exceptionFeature.Error.Message
                </div>
            </div>

            <div class="overflow-x-auto">
                <pre class="text-xs font-mono text-slate-300 leading-relaxed">@exceptionFeature.Error.StackTrace</pre>
            </div>

            @if (exceptionFeature.Error.InnerException != null)
            {
                <div class="mt-4 pt-4 border-t border-slate-800">
                    <div class="text-xs font-mono text-amber-400 font-bold mb-1">
                        Inner Exception: @exceptionFeature.Error.InnerException.GetType().FullName
                    </div>
                    <div class="text-xs font-mono text-amber-200 mb-2 break-all">
                        @exceptionFeature.Error.InnerException.Message
                    </div>
                    <pre class="text-xs font-mono text-slate-400">@exceptionFeature.Error.InnerException.StackTrace</pre>
                </div>
            }
        </div>
    }
</div>
