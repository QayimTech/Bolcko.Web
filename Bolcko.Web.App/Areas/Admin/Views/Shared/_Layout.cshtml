@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer L
<!DOCTYPE html>
<html lang="@(System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName)" dir="@(System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "rtl" : "ltr")" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>بلوكو الأدمن - @(ViewData["Title"] ?? "لوحة التحكم")</title>
    <link rel="apple-touch-icon" sizes="180x180" href="~/favicons/apple-touch-icon.png?v=5" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicons/favicon-32x32.png?v=5" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/favicons/favicon-16x16.png?v=5" />
    <link rel="shortcut icon" href="~/favicons/favicon.ico?v=5" />

    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/material-symbols-outlined.woff2">
    <link rel="stylesheet" href="~/css/material-symbols.css" asp-append-version="true">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@600;700;800&family=Work+Sans:wght@600;700&family=Noto+Kufi+Arabic:wght@400;500;600;700&display=swap">
    <partial name="~/Areas/Admin/Views/Shared/Partials/_Styles.cshtml" />
</head>
<body class="bg-[#F8FAFC] text-slate-900 font-body-md min-h-screen w-full overflow-x-hidden">

    @if (Context.Session.GetString("IsImpersonating") == "true")
    {
        <div class="bg-slate-900 text-white px-6 py-2 shadow-sm flex items-center justify-between font-bold text-xs sticky top-0 z-30 border-b border-amber-500/40" dir="rtl">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-base text-[#E8A020]">visibility</span>
                <span>تصفح المنصة كـ: <strong class="text-[#E8A020] font-black">@Context.Session.GetString("ImpersonatedUserFullName")</strong></span>
            </div>
            <form asp-action="StopImpersonation" asp-controller="Impersonation" asp-area="" method="post" class="inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="bg-[#E8A020] hover:bg-[#d49018] text-slate-950 px-3.5 py-1 rounded-lg text-xs font-black transition-all shadow-2xs flex items-center gap-1 active:scale-95">
                    <span>إنهاء المحاكاة ↩️</span>
                </button>
            </form>
        </div>
    }

    <div class="min-h-screen flex w-full relative">
        <!-- Sidebar -->
        <partial name="~/Areas/Admin/Views/Shared/Partials/Aside.cshtml" />

        <!-- Main Content Area Wrapper -->
        <div id="main-content" class="flex-1 flex flex-col min-h-screen sidebar-transition w-full overflow-hidden">
            <partial name="~/Areas/Admin/Views/Shared/Partials/Header.cshtml" />

            <main role="main" class="flex-1 p-4 md:p-6 lg:p-10 w-full overflow-x-hidden">
                <div class="max-w-[1600px] mx-auto w-full">
                    @RenderBody()
                </div>
            </main>

            <partial name="~/Areas/Admin/Views/Shared/Partials/Footer.cshtml" />
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div id="deleteConfirmModal" class="fixed inset-0 z-[100] flex items-center justify-center hidden">
        <div class="absolute inset-0 bg-slate-900/50 backdrop-blur-sm" onclick="closeDeleteModal()"></div>
        <div class="bg-white rounded-3xl p-8 max-w-md w-full relative z-10 shadow-2xl transform scale-95 opacity-0 transition-all duration-300 mx-4 border border-red-100">
            <div class="w-16 h-16 bg-red-50 text-red-600 rounded-full flex items-center justify-center mx-auto mb-6">
                <span class="material-symbols-outlined text-3xl">warning</span>
            </div>
            <h3 class="text-xl font-bold text-slate-800 text-center mb-2">تأكيد الحذف</h3>
            <p id="deleteModalMessage" class="text-slate-500 text-sm text-center mb-6 leading-relaxed">
                هل أنت متأكد من الحذف؟ لا يمكن التراجع عن هذا الإجراء.
            </p>
            <div class="mb-6">
                <label class="block text-xs font-bold text-slate-700 mb-2 text-start">للتأكيد، اكتب "<span class="text-red-600">حذف</span>" أو "<span class="text-red-600">delete</span>" في الصندوق أدناه:</label>
                <input type="text" id="deleteConfirmInput" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-slate-900 focus:border-red-500 focus:ring-1 focus:ring-red-500 outline-none text-center" autocomplete="off" />
            </div>
            <div class="flex flex-row-reverse gap-3">
                <button type="button" onclick="closeDeleteModal()" class="w-1/2 px-6 py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold rounded-xl transition-colors">
                    إلغاء
                </button>
                <button type="button" id="deleteConfirmBtn" class="w-1/2 px-6 py-3 bg-slate-200 text-slate-400 font-bold rounded-xl transition-colors cursor-not-allowed" data-enabled="false">
                    تأكيد الحذف
                </button>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        let currentDeleteForm = null;

        function requireDeleteConfirm(form, itemType = 'item') {
            currentDeleteForm = form;
            const modal = document.getElementById('deleteConfirmModal');
            const input = document.getElementById('deleteConfirmInput');
            const btn = document.getElementById('deleteConfirmBtn');
            const msg = document.getElementById('deleteModalMessage');

            if(itemType === 'user') msg.textContent = 'هل أنت متأكد من حذف هذا المستخدم؟ سيتم إلغاء وصوله نهائياً.';
            else if(itemType === 'category') msg.textContent = 'هل أنت متأكد من حذف هذه الفئة؟ قد تؤثر على المنتجات المرتبطة بها.';
            else if(itemType === 'product') msg.textContent = 'هل أنت متأكد من حذف هذا المنتج؟ سيتم رفعه من المتجر.';
            else msg.textContent = 'هل أنت متأكد من الحذف؟ لا يمكن التراجع عن هذا الإجراء.';

            input.value = '';
            btn.dataset.enabled = 'false';
            btn.className = 'w-1/2 px-6 py-3 bg-slate-200 text-slate-400 font-bold rounded-xl transition-colors cursor-not-allowed';
            
            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.firstElementChild.nextElementSibling.classList.remove('scale-95', 'opacity-0');
                modal.firstElementChild.nextElementSibling.classList.add('scale-100', 'opacity-100');
                input.focus();
            }, 10);
        }

        function closeDeleteModal() {
            const modal = document.getElementById('deleteConfirmModal');
            if(!modal) return;
            const content = modal.firstElementChild.nextElementSibling;
            content.classList.remove('scale-100', 'opacity-100');
            content.classList.add('scale-95', 'opacity-0');
            setTimeout(() => {
                modal.classList.add('hidden');
                currentDeleteForm = null;
            }, 200);
        }

        document.getElementById('deleteConfirmInput').addEventListener('input', function(e) {
            const val = e.target.value.trim().toLowerCase();
            const btn = document.getElementById('deleteConfirmBtn');
            if(val === 'حذف' || val === 'delete') {
                btn.dataset.enabled = 'true';
                btn.className = 'w-1/2 px-6 py-3 bg-red-600 hover:bg-red-700 text-white font-bold rounded-xl transition-colors shadow-md cursor-pointer';
            } else {
                btn.dataset.enabled = 'false';
                btn.className = 'w-1/2 px-6 py-3 bg-slate-200 text-slate-400 font-bold rounded-xl transition-colors cursor-not-allowed';
            }
        });

        document.getElementById('deleteConfirmBtn').addEventListener('click', function() {
            if(currentDeleteForm && this.dataset.enabled === 'true') {
                currentDeleteForm.submit();
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
