
<!-- Overlay -->
<div id="sidebar-overlay"
     class="fixed inset-0 bg-slate-900/40 z-[90] hidden opacity-0 transition-opacity duration-300 lg:hidden">
</div>

<!-- Sidebar -->
<aside id="admin-sidebar"
       class="fixed start-0 top-0 h-full bg-white z-[100]
               -translate-x-full rtl:translate-x-full lg:translate-x-0 lg:rtl:translate-x-0
               transition-all duration-300
               overflow-hidden border-e border-slate-200
               text-start flex flex-col shadow-sm"
       style="width: var(--sidebar-width);">

    <!-- Sidebar Header / Logo -->
    <div class="sidebar-header h-20 flex items-center justify-between px-6 border-b border-slate-100 flex-shrink-0 transition-all duration-300">
        <div class="flex items-center gap-3 overflow-hidden">
            <div class="sidebar-logo-icon hidden">
                <partial name="~/Views/Shared/Partials/_BrandLogo.cshtml" model='(true, false, "light", "h-10")' />
            </div>
            <div class="sidebar-logo-full whitespace-nowrap transition-all duration-300">
                <partial name="~/Views/Shared/Partials/_BrandLogo.cshtml" model='(false, true, "light", "h-6 lg:h-9")' />
            </div>
        </div>

        <button id="close-sidebar"
                class="lg:hidden text-slate-400 hover:text-slate-600 transition-colors">
            <span class="material-symbols-outlined">close</span>
        </button>
    </div>

    <!-- Navigation -->
    <div class="flex-1 overflow-y-auto py-4 px-3 space-y-5 custom-scrollbar text-start" dir="rtl">
        @{
            var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
            var currentAction     = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
            bool isAdmin = User.IsInRole("Admin") || User.IsInRole("SuperAdmin");

            var fintechGroup = new List<(string Title, string Icon, string Controller, string Action)>
            {
                ("لوحة التحكم العامة", "dashboard", "Home", "Index"),
                ("تمويل المرابحة والرقابة الشرعية", "account_balance", "Financing", "Index"),
                ("مركز البيانات Data Hub", "database", "SEO", "ImportExport"),
                ("إدارة المستخدمين والـ KYC", "manage_accounts", "User", "Index"),
                ("إعدادات وبوابات الدفع", "account_balance_wallet", "PaymentSettings", "Index")
            };

            var supplyChainGroup = new List<(string Title, string Icon, string Controller, string Action)>
            {
                ("تصنيفات ومواد البناء الإنشائية", "construction", "MaterialTypes", "Index"),
                ("مؤشرات أسعار السوق", "payments", "MarketPrice", "Index"),
                ("إعدادات حاسبة البناء", "calculate", "CalculatorSettings", "Index"),
                ("مركز التوزيع والنقل اللوجستي", "local_shipping", "DeliveryDispatch", "Index"),
                ("تكامل الموردين والمخازن", "warehouse", "SupplierSettings", "Index")
            };

            var governanceGroup = new List<(string Title, string Icon, string Controller, string Action)>
            {
                ("مركز الأمان والزيارات والـ Audit", "shield_person", "SecurityCenter", "Index"),
                ("إدارة الاشتراكات والباقات", "card_membership", "Subscription", "Index"),
                ("الأسئلة الشائعة FAQ", "quiz", "FAQ", "Index"),
                ("إعدادات النظام", "settings", "Settings", "Index"),
                ("سجلات النظام والتشخيص", "bug_report", "Log", "Index")
            };
        }

        <!-- Group 1: FinTech & Escrow Governance -->
        <div class="space-y-1">
            <p class="sidebar-text px-3 text-[10px] font-black text-amber-500/90 uppercase tracking-wider flex items-center gap-1.5 mb-2">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                <span>الحوكمة والعمليات المالية</span>
            </p>
            @foreach (var item in fintechGroup)
            {
                bool isActive = string.Equals(currentController, item.Controller, StringComparison.OrdinalIgnoreCase) 
                             && string.Equals(currentAction, item.Action, StringComparison.OrdinalIgnoreCase);
                <a href="@Url.Action(item.Action, item.Controller, new { area = "Admin" })"
                   class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl transition-all duration-200 group text-xs font-bold @(isActive ? "bg-slate-900 text-white shadow-md shadow-slate-900/20" : "text-slate-600 hover:bg-slate-100 hover:text-slate-900")">
                    <span class="material-symbols-outlined text-lg transition-colors @(isActive ? "text-[#E8A020]" : "text-slate-400 group-hover:text-[#E8A020]")">
                        @item.Icon
                    </span>
                    <span class="sidebar-text truncate">@item.Title</span>
                    @if (isActive)
                    {
                        <div class="sidebar-text ms-auto w-1.5 h-1.5 rounded-full bg-[#E8A020]"></div>
                    }
                </a>
            }
        </div>

        <!-- Group 2: Supply Chain & Engineering Standards -->
        <div class="space-y-1 pt-2 border-t border-slate-100">
            <p class="sidebar-text px-3 text-[10px] font-black text-slate-400 uppercase tracking-wider flex items-center gap-1.5 mb-2">
                <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                <span>سلاسل الإمداد ومواصفات البناء</span>
            </p>
            @foreach (var item in supplyChainGroup)
            {
                bool isActive = string.Equals(currentController, item.Controller, StringComparison.OrdinalIgnoreCase) 
                             && string.Equals(currentAction, item.Action, StringComparison.OrdinalIgnoreCase);
                <a href="@Url.Action(item.Action, item.Controller, new { area = "Admin" })"
                   class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl transition-all duration-200 group text-xs font-bold @(isActive ? "bg-slate-900 text-white shadow-md shadow-slate-900/20" : "text-slate-600 hover:bg-slate-100 hover:text-slate-900")">
                    <span class="material-symbols-outlined text-lg transition-colors @(isActive ? "text-[#E8A020]" : "text-slate-400 group-hover:text-[#E8A020]")">
                        @item.Icon
                    </span>
                    <span class="sidebar-text truncate">@item.Title</span>
                    @if (isActive)
                    {
                        <div class="sidebar-text ms-auto w-1.5 h-1.5 rounded-full bg-[#E8A020]"></div>
                    }
                </a>
            }
        </div>

        <!-- Group 3: Security & Platform Operations -->
        <div class="space-y-1 pt-2 border-t border-slate-100">
            <p class="sidebar-text px-3 text-[10px] font-black text-slate-400 uppercase tracking-wider flex items-center gap-1.5 mb-2">
                <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                <span>الأمان والرقابة الإدارية</span>
            </p>
            @foreach (var item in governanceGroup)
            {
                bool isActive = string.Equals(currentController, item.Controller, StringComparison.OrdinalIgnoreCase) 
                             && string.Equals(currentAction, item.Action, StringComparison.OrdinalIgnoreCase);
                <a href="@Url.Action(item.Action, item.Controller, new { area = "Admin" })"
                   class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl transition-all duration-200 group text-xs font-bold @(isActive ? "bg-slate-900 text-white shadow-md shadow-slate-900/20" : "text-slate-600 hover:bg-slate-100 hover:text-slate-900")">
                    <span class="material-symbols-outlined text-lg transition-colors @(isActive ? "text-[#E8A020]" : "text-slate-400 group-hover:text-[#E8A020]")">
                        @item.Icon
                    </span>
                    <span class="sidebar-text truncate">@item.Title</span>
                    @if (isActive)
                    {
                        <div class="sidebar-text ms-auto w-1.5 h-1.5 rounded-full bg-[#E8A020]"></div>
                    }
                </a>
            }
        </div>
    </div>



    <!-- Footer -->
    <div class="p-4 border-t border-slate-100 space-y-1 flex-shrink-0">
        <a href="/"
           class="flex items-center gap-4 px-4 py-3 text-slate-500 hover:bg-slate-50 hover:text-slate-900 rounded-xl transition-all group">
            <span class="material-symbols-outlined group-hover:scale-110 transition-transform">home</span>
            <span class="sidebar-text text-sm font-bold truncate">@L["BackToStore"]</span>
        </a>

        <form asp-area="" asp-controller="Culture" asp-action="SetLanguage" method="post" class="hidden">
        </form>

        <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit"
                    class="w-full flex items-center gap-4 px-4 py-3 text-red-500 hover:bg-red-50 rounded-xl transition-all group text-start">
                <span class="material-symbols-outlined group-hover:rotate-12 transition-transform">logout</span>
                <span class="sidebar-text text-sm font-bold truncate">@L["Logout"]</span>
            </button>
        </form>
    </div>
</aside>