@model Bolcko.Domain.Entities.Order.DTOs.OrderDto
@using Bolcko.Domain.Entities.Delivery
@using Bolcko.Domain.Enums
@{
    ViewData["Title"] = L["OrderDetails"];
    Layout = "_Layout";
    var deliveryJob = ViewBag.DeliveryJob as DeliveryJob;
    var companies = ViewBag.DeliveryCompanies as IEnumerable<DeliveryCompany> ?? Enumerable.Empty<DeliveryCompany>();

    decimal commissionRate = 0.025m; // 2.5% Platform Take Rate
    decimal platformCommission = Model.TotalAmount * commissionRate;
    decimal vendorEscrowNet = Model.TotalAmount - platformCommission;
}

<div class="p-6 text-start space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b pb-4">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl font-black text-slate-900">@L["OrderDetails"]: @Model.OrderNumber</h1>
                <span class="inline-block px-3 py-1 text-xs font-black rounded-full
                    @(Model.Status == OrderStatus.Pending ? "bg-amber-100 text-amber-800 border border-amber-200" :
                      Model.Status == OrderStatus.Processing ? "bg-blue-100 text-blue-800 border border-blue-200" :
                      Model.Status == OrderStatus.Shipped ? "bg-purple-100 text-purple-800 border border-purple-200" :
                      Model.Status == OrderStatus.Delivered ? "bg-emerald-100 text-emerald-800 border border-emerald-200" : "bg-red-100 text-red-800 border border-red-200")">
                    @(Model.Status == OrderStatus.Pending ? L["StatusPending"] :
                      Model.Status == OrderStatus.Processing ? L["StatusProcessing"] :
                      Model.Status == OrderStatus.Shipped ? L["StatusShipped"] :
                      Model.Status == OrderStatus.Delivered ? L["StatusDelivered"] : L["StatusCancelled"])
                </span>
                @if (Model.HasOversizedItems)
                {
                    <span class="px-2.5 py-1 bg-red-50 text-red-700 border border-red-200 text-xs rounded-full font-bold flex items-center gap-1">
                        <span class="material-symbols-outlined text-sm">local_shipping</span>
                        <span>مواد إنشائية ثقيلة (شاحنات نقل)</span>
                    </span>
                }
            </div>
            <p class="text-xs text-slate-400 mt-1">تاريخ الطلب: @Model.OrderDate.ToString("yyyy/MM/dd HH:mm") | معرف النظام: #@Model.Id</p>
        </div>
        <div class="flex items-center gap-2">
            <a asp-action="Index" class="px-4 py-2 bg-slate-100 text-slate-700 rounded-xl hover:bg-slate-200 transition-colors text-xs font-bold flex items-center gap-1">
                <span class="material-symbols-outlined text-sm rtl:-scale-x-100">arrow_back</span>
                <span>@L["BackToList"]</span>
            </a>
            <button onclick="window.print()" class="px-4 py-2 bg-slate-900 text-white rounded-xl hover:bg-slate-800 transition-colors text-xs font-bold flex items-center gap-1">
                <span class="material-symbols-outlined text-sm text-[#E8A020]">print</span>
                <span>طباعة السجل</span>
            </button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 px-5 py-3 rounded-2xl flex items-center gap-2 text-xs font-bold">
            <span class="material-symbols-outlined text-emerald-600 text-base">check_circle</span>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="bg-rose-50 border border-rose-200 text-rose-800 px-5 py-3 rounded-2xl flex items-center gap-2 text-xs font-bold">
            <span class="material-symbols-outlined text-rose-600 text-base">error</span>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- Executive Financial & Escrow Overview Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- GMV Card -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs flex items-center justify-between">
            <div>
                <span class="text-xs text-slate-400 font-bold block mb-1">إجمالي قيمة الطلب (GMV)</span>
                <span class="text-xl font-black text-slate-900">@Model.TotalAmount.ToString("N2") @L["Currency"]</span>
                <span class="text-[11px] text-slate-500 block mt-1">طريقة الدفع: @(Model.PaymentMethod ?? "دفع عند الاستلام")</span>
            </div>
            <div class="w-12 h-12 rounded-2xl bg-amber-50 text-[#E8A020] border border-amber-200 flex items-center justify-center font-bold">
                <span class="material-symbols-outlined text-2xl">account_balance_wallet</span>
            </div>
        </div>

        <!-- Vendor Escrow Card -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs flex items-center justify-between">
            <div>
                <span class="text-xs text-slate-400 font-bold block mb-1">صافي مستحقات المورد (Escrow)</span>
                <span class="text-xl font-black text-emerald-600">@vendorEscrowNet.ToString("N2") @L["Currency"]</span>
                <span class="text-[11px] text-emerald-700 block mt-1">محتجزة لحين تأكيد التسليم (e-POD)</span>
            </div>
            <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 border border-emerald-200 flex items-center justify-center font-bold">
                <span class="material-symbols-outlined text-2xl">lock_clock</span>
            </div>
        </div>

        <!-- Platform Commission Card -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs flex items-center justify-between">
            <div>
                <span class="text-xs text-slate-400 font-bold block mb-1">عمولة المنصة (Take Rate 2.5%)</span>
                <span class="text-xl font-black text-slate-900">@platformCommission.ToString("N2") @L["Currency"]</span>
                <span class="text-[11px] text-slate-400 block mt-1">إيراد بلوكو المعتمد</span>
            </div>
            <div class="w-12 h-12 rounded-2xl bg-slate-100 text-slate-700 border border-slate-200 flex items-center justify-center font-bold">
                <span class="material-symbols-outlined text-2xl">toll</span>
            </div>
        </div>

        <!-- Logistics Freight Card -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs flex items-center justify-between">
            <div>
                <span class="text-xs text-slate-400 font-bold block mb-1">أجور النقل والشحن</span>
                <span class="text-xl font-black text-indigo-600">
                    @(deliveryJob != null ? deliveryJob.DeliveryFee.ToString("N2") + " " + L["Currency"].Value : "محتسبة ضمن العقد")
                </span>
                <span class="text-[11px] text-indigo-700 block mt-1">
                    @(deliveryJob?.FulfillmentType == "OwnFleet" ? "أسطول المورد الخاص" :
                      deliveryJob?.FulfillmentType == "Custom3PL" ? "شريك نقل معتمد 3PL" : "شبكة بلوكو للناقلين")
                </span>
            </div>
            <div class="w-12 h-12 rounded-2xl bg-indigo-50 text-indigo-600 border border-indigo-200 flex items-center justify-center font-bold">
                <span class="material-symbols-outlined text-2xl">local_shipping</span>
            </div>
        </div>
    </div>

    <!-- Core Information Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Customer & Project Delivery Site Card -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-xs space-y-4">
            <h2 class="text-base font-black text-slate-900 border-b pb-3 flex items-center gap-2">
                <span class="material-symbols-outlined text-primary text-xl">person_pin_circle</span>
                <span>بيانات العميل وموقع الورشة الإنشائية</span>
            </h2>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
                <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-100">
                    <span class="text-slate-400 font-bold block mb-1">اسم العميل / المقاول:</span>
                    <strong class="text-slate-900 text-sm">@(Model.UserName ?? L["NotSpecified"].Value)</strong>
                </div>

                <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-100">
                    <span class="text-slate-400 font-bold block mb-1">حالة السداد المالي:</span>
                    <span class="inline-block px-2.5 py-0.5 rounded-md font-bold text-xs @(Model.PaymentStatus == "Paid" ? "bg-emerald-100 text-emerald-800" : "bg-amber-100 text-amber-800")">
                        @(Model.PaymentStatus ?? "بانتظار التحصيل")
                    </span>
                </div>
            </div>

            <div class="bg-slate-50 p-4 rounded-xl border border-slate-100 text-xs space-y-2">
                <span class="text-slate-400 font-bold block">عنوان موقع المشروع الإنشائي:</span>
                @if (Model.ShippingAddress != null)
                {
                    <p class="text-slate-800 font-medium leading-relaxed">
                        <strong class="text-slate-900">@Model.ShippingAddress.City</strong> - @Model.ShippingAddress.StateProvince<br />
                        @Model.ShippingAddress.AddressLine1
                        @if (!string.IsNullOrEmpty(Model.ShippingAddress.AddressLine2))
                        {
                            <span>, @Model.ShippingAddress.AddressLine2</span>
                        }
                        @if (!string.IsNullOrEmpty(Model.ShippingAddress.PostalCode))
                        {
                            <span class="block text-slate-400 text-[11px] mt-1">الرمز البريدي: @Model.ShippingAddress.PostalCode</span>
                        }
                    </p>
                }
                else
                {
                    <p class="text-slate-400 italic">@L["NoDeliveryAddressRegistered"]</p>
                }
            </div>
        </div>

        <!-- Dynamic Multi-Vendor Fulfillment & Logistics Oversight Card -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-xs space-y-4">
            <div class="flex items-center justify-between border-b pb-3">
                <h2 class="text-base font-black text-slate-900 flex items-center gap-2">
                    <span class="material-symbols-outlined text-[#E8A020] text-xl">hub</span>
                    <span>مسار التوريد والشحن اللوجستي (Fulfillment Pipeline)</span>
                </h2>
                @if (deliveryJob != null)
                {
                    <span class="text-xs bg-emerald-50 text-emerald-700 border border-emerald-200 px-2.5 py-1 rounded-full font-bold">
                        مجدول في مسار الشحن
                    </span>
                }
                else
                {
                    <span class="text-xs bg-amber-50 text-amber-700 border border-amber-200 px-2.5 py-1 rounded-full font-bold">
                        قيد الفرز لدى المورد
                    </span>
                }
            </div>

            @if (deliveryJob != null)
            {
                <div class="space-y-3 text-xs">
                    <div class="grid grid-cols-2 gap-3">
                        <div class="bg-slate-50 p-3 rounded-xl border border-slate-100">
                            <span class="text-slate-400 font-bold block mb-0.5">رقم بوليصة الشحن (Waybill):</span>
                            <span class="font-mono font-bold text-slate-900 text-sm">@(deliveryJob.WaybillNumber ?? $"WB-BLK-{deliveryJob.Id}")</span>
                        </div>
                        <div class="bg-slate-50 p-3 rounded-xl border border-slate-100">
                            <span class="text-slate-400 font-bold block mb-0.5">حالة الشحنة المباشرة:</span>
                            <span class="font-bold text-indigo-700">@deliveryJob.Status.ToString()</span>
                        </div>
                    </div>

                    <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-100 space-y-1.5">
                        <div class="flex items-center justify-between">
                            <span class="text-slate-500 font-bold">الناقل / أسطول التوصيل المعين:</span>
                            <strong class="text-slate-900">
                                @(deliveryJob.Company?.Name ?? (deliveryJob.Driver?.User != null ? $"{deliveryJob.Driver.User.FirstName} {deliveryJob.Driver.User.LastName}" : "أسطول المورد الداخلي"))
                            </strong>
                        </div>
                        @if (deliveryJob.Driver != null)
                        {
                            <div class="flex items-center justify-between text-[11px] text-slate-500">
                                <span>لوحة المركبة ونوعها:</span>
                                <span class="font-mono font-bold text-slate-700">@(deliveryJob.Driver.VehiclePlateNumber ?? "-") | @(deliveryJob.Driver.VehicleType ?? "شاحنة نقل")</span>
                            </div>
                        }
                    </div>

                    <!-- Delivery Verification OTP Badge -->
                    <div class="bg-emerald-50 border border-emerald-200 p-3.5 rounded-xl flex items-center justify-between">
                        <div>
                            <span class="text-emerald-800 font-black block">كود الاستلام والتوثيق الرقمي (e-POD OTP)</span>
                            <span class="text-[11px] text-emerald-600">يقدمه المهندس المستلم لسائق الشاحنة في موقع المشروع</span>
                        </div>
                        <div class="font-mono font-black text-lg bg-white px-3 py-1 rounded-lg border border-emerald-300 text-emerald-800 tracking-wider">
                            @(deliveryJob.DeliveryOtpCode ?? "842190")
                        </div>
                    </div>

                    @if (deliveryJob.WeightTons.HasValue && deliveryJob.WeightTons.Value > 0)
                    {
                        <div class="bg-amber-50/60 border border-amber-200 p-3 rounded-xl flex items-center justify-between text-[11px]">
                            <span class="text-amber-900 font-bold">حمولة القبان الموزونة: @deliveryJob.WeightTons.Value.ToString("N2") طن</span>
                            <span class="text-slate-500 font-mono">قائم: @(deliveryJob.GrossWeightTons?.ToString("N2") ?? "-") طن | فارغ: @(deliveryJob.TareWeightTons?.ToString("N2") ?? "-") طن</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="bg-slate-50 border border-slate-200 rounded-2xl p-5 text-center space-y-3">
                    <div class="w-12 h-12 bg-amber-100 text-amber-700 rounded-full flex items-center justify-center mx-auto">
                        <span class="material-symbols-outlined text-2xl">pending_actions</span>
                    </div>
                    <div>
                        <h4 class="font-bold text-slate-800 text-sm">بانتظار إجراءات التجهيز والشحن من المورد</h4>
                        <p class="text-xs text-slate-500 max-w-md mx-auto mt-1">
                            يقوم المورد بفحص المخزون وتحديد أسلوب الشحن (أسطوله الخاص أو تعيين ناقل معتمد) عبر لوحة تحكم المورد اللوجستية.
                        </p>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Administrative Governance & Emergency Override Section -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-xs space-y-6">
        <div class="border-b pb-3">
            <h2 class="text-base font-black text-slate-900 flex items-center gap-2">
                <span class="material-symbols-outlined text-slate-700 text-xl">admin_panel_settings</span>
                <span>الحوكمة الإدارية والتدخل الاستثنائي (Administrative Governance & SLA Override)</span>
            </h2>
            <p class="text-xs text-slate-400 mt-0.5">تحديث حالة الطلب أو إسناد الشحن لناقل معتمد كإجراء رقابي عند تعثر التوريد أو انتهاك الـ SLA</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Update Order Status Form -->
            <form asp-action="UpdateStatus" method="post" class="space-y-4 bg-slate-50/70 p-4 rounded-xl border border-slate-200">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-2">@L["SelectNewOrderStatus"]</label>
                    <select name="status" class="w-full bg-white border border-slate-200 px-4 py-3 text-slate-900 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all rounded-xl text-xs font-bold">
                        @foreach (OrderStatus status in Enum.GetValues(typeof(OrderStatus)))
                        {
                            var localizedStatus = status == OrderStatus.Pending ? L["StatusPending"] :
                                                 status == OrderStatus.Processing ? L["StatusProcessing"] :
                                                 status == OrderStatus.Shipped ? L["StatusShipped"] :
                                                 status == OrderStatus.Delivered ? L["StatusDelivered"] : L["StatusCancelled"];

                            if (Model.Status == status)
                            {
                                <option value="@status" selected>@localizedStatus</option>
                            }
                            else
                            {
                                <option value="@status">@localizedStatus</option>
                            }
                        }
                    </select>
                </div>
                <button type="submit" class="bg-slate-900 hover:bg-slate-800 text-white font-bold py-2.5 px-6 rounded-xl transition-all text-xs w-full sm:w-auto">
                    @L["SaveOrderStatus"]
                </button>
            </form>

            <!-- Emergency Carrier Assignment Form -->
            <form asp-controller="DeliveryDispatch" asp-action="AssignToCompany" method="post" class="space-y-4 bg-slate-50/70 p-4 rounded-xl border border-slate-200">
                @Html.AntiForgeryToken()
                <input type="hidden" name="orderId" value="@Model.Id" />
                
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-2">إسناد / إعادة توجيه لشركة نقل معتمدة (تدخل استثنائي)</label>
                    <select name="companyId" id="companySelect" class="w-full bg-white border border-slate-200 px-4 py-3 text-slate-900 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all rounded-xl text-xs font-bold">
                        @foreach (var company in companies)
                        {
                            if (Model.HasOversizedItems && !company.SupportsOversized)
                            {
                                continue;
                            }
                            <option value="@company.Id" data-rate="@company.BaseDeliveryRate">@company.Name (التعرفة: @company.BaseDeliveryRate.ToString("N2") @L["Currency"])</option>
                        }
                    </select>
                </div>

                <div class="flex gap-3 items-end">
                    <div class="flex-1">
                        <label class="block text-xs font-bold text-slate-600 mb-2">@L["SuggestedDeliveryFee"]</label>
                        <input name="deliveryFee" id="companyDeliveryFee" type="number" step="0.01" min="0" value="15.00" required
                               class="w-full bg-white border border-slate-200 px-4 py-2.5 text-slate-900 focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all rounded-xl text-xs font-bold" />
                    </div>
                    <button type="submit" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2.5 px-6 rounded-xl transition-all text-xs shrink-0">
                        @L["AssignToShippingCompany"]
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Items Section -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-xs">
        <h2 class="text-base font-black text-slate-900 mb-4 border-b pb-3 flex items-center justify-between">
            <span>@L["Items"] (@(Model.Items?.Count ?? 0) بنود)</span>
            <span class="text-xs text-slate-400 font-normal">يتم توريد وتجهيز الأصناف مباشرة من مستودعات الموردين المعتمدين</span>
        </h2>

        @if (Model.Items != null && Model.Items.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full text-start border-collapse">
                    <thead>
                        <tr class="bg-slate-50 border-b border-slate-200 text-xs font-black text-slate-600">
                            <th class="p-3 text-start">المنتج / الصنف</th>
                            <th class="p-3 text-start">رمز الـ SKU</th>
                            <th class="p-3 text-start">المواصفة / المتغير</th>
                            <th class="p-3 text-start">المورد / المصدر</th>
                            <th class="p-3 text-center">الكمية</th>
                            <th class="p-3 text-end">سعر الوحدة</th>
                            <th class="p-3 text-end">الإجمالي</th>
                        </tr>
                    </thead>
                    <tbody class="text-xs">
                        @foreach (var item in Model.Items)
                        {
                            var imgUrl = !string.IsNullOrEmpty(item.ImageUrl) ? item.ImageUrl : "/images/product-placeholder.png";
                            <tr class="border-b border-slate-100 hover:bg-slate-50/70 transition-colors">
                                <td class="p-3 flex items-center gap-3">
                                    <img src="@imgUrl" alt="@item.ProductName" class="w-12 h-12 object-cover rounded-xl border border-slate-200 shrink-0" />
                                    <div>
                                        <a href="@Url.Action("Edit", "Product", new { area = "Admin", id = item.ProductId })" target="_blank" class="font-bold text-slate-900 hover:text-primary transition-colors flex items-center gap-1">
                                            <span>@item.ProductName</span>
                                            <span class="material-symbols-outlined text-xs text-slate-400">open_in_new</span>
                                        </a>
                                        <span class="text-[10px] text-slate-400 block font-mono">ID: #@item.ProductId</span>
                                    </div>
                                </td>
                                <td class="p-3 font-mono text-slate-600 font-bold">
                                    @(!string.IsNullOrEmpty(item.Sku) ? item.Sku : "-")
                                </td>
                                <td class="p-3">
                                    @if (!string.IsNullOrEmpty(item.VariantInfo))
                                    {
                                        <span class="px-2 py-0.5 bg-amber-50 border border-amber-200 text-amber-800 rounded-md font-bold text-[11px]">@item.VariantInfo</span>
                                    }
                                    else
                                    {
                                        <span class="text-slate-400">-</span>
                                    }
                                </td>
                                <td class="p-3">
                                    <span class="px-2.5 py-1 bg-slate-100 text-slate-700 rounded-lg font-bold text-[11px] inline-flex items-center gap-1">
                                        <span class="material-symbols-outlined text-xs text-[#E8A020]">store</span>
                                        <span>@(!string.IsNullOrEmpty(item.SupplierKey) ? item.SupplierKey : "مورد معتمد")</span>
                                    </span>
                                </td>
                                <td class="p-3 font-black text-slate-800 text-center text-sm">@item.Quantity</td>
                                <td class="p-3 text-end font-medium">@item.UnitPrice.ToString("N2") @L["Currency"]</td>
                                <td class="p-3 text-end font-black text-emerald-600 text-sm">@item.TotalPrice.ToString("N2") @L["Currency"]</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-slate-400 italic text-sm text-center py-6">@L["NoItemsForThisOrder"]</p>
        }
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        var select = document.getElementById("companySelect");
        var feeInput = document.getElementById("companyDeliveryFee");
        
        function updateFee() {
            if (select && select.selectedOptions.length > 0) {
                var rate = select.selectedOptions[0].getAttribute("data-rate");
                if (rate && feeInput) {
                    feeInput.value = parseFloat(rate).toFixed(2);
                }
            }
        }
        
        if (select) {
            select.addEventListener("change", updateFee);
            updateFee();
        }
    });
</script>
