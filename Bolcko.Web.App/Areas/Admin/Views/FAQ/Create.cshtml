@model Bolcko.Domain.Entities.Content.FAQItem
@{
    ViewData["Title"] = "إضافة سؤال شائع جديد";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="p-6 max-w-4xl mx-auto space-y-6">
    
    <div class="flex items-center justify-between bg-white p-6 rounded-3xl border border-slate-200 shadow-sm">
        <div>
            <h1 class="text-2xl font-black text-slate-900">إضافة سؤال شائع جديد ✍️</h1>
            <p class="text-xs text-slate-500 mt-1">سيتم عرض هذا السؤال مباشرة في الصفحة المستهدفة والـ Schema.org لمساعدتك في تصدر نتائج جوجل.</p>
        </div>
        <a href="@Url.Action("Index", "FAQ", new { area = "Admin" })" 
           class="px-4 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition-all">
            عودة للقائمة
        </a>
    </div>

    <form method="post" action="@Url.Action("Create", "FAQ", new { area = "Admin" })" class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm space-y-6">
        @Html.AntiForgeryToken()
        @await Html.PartialAsync("_FAQForm", Model)

        <div class="flex justify-end gap-3 pt-6 border-t border-slate-100">
            <a href="@Url.Action("Index", "FAQ", new { area = "Admin" })" class="px-6 py-3 rounded-2xl bg-slate-100 text-slate-700 text-xs font-bold hover:bg-slate-200 transition-all">إلغاء</a>
            <button type="submit" class="px-6 py-3 rounded-2xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-black shadow-lg shadow-indigo-500/20 transition-all">
                حفظ ونشر السؤال
            </button>
        </div>
    </form>
</div>
