@model IEnumerable<Bolcko.Domain.Entities.Catalog.MaterialType>
@{
    ViewData["Title"] = "هيكلية وتصنيفات مواد البناء الديناميكية";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="space-y-6" dir="rtl">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white dark:bg-slate-900 p-6 rounded-3xl border border-slate-100 dark:border-slate-800 shadow-sm">
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-2xl bg-amber-500/10 text-amber-500 flex items-center justify-center font-black text-2xl ring-8 ring-amber-500/5">
                🏗️
            </div>
            <div>
                <h1 class="text-xl font-black text-slate-900 dark:text-white">تصنيفات ومواصفات مواد البناء الديناميكية</h1>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                    إدارة أنواع المواد (حديد، حجر، خرسانة، إسمنت، طوب) والخصائص الحصرية لكل صنف لتزويد الموردين والمقاولين بنماذج إدخال مخصصة
                </p>
            </div>
        </div>
        <button type="button" onclick="openAddModal()"
                class="px-5 py-3 rounded-2xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-slate-900 font-black text-xs shadow-lg shadow-amber-500/20 transition-all flex items-center justify-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"></path></svg>
            <span>إضافة مادة بناء جديدة</span>
        </button>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 font-bold text-sm flex items-center gap-2">
            <span>✅</span> <span>@TempData["Success"]</span>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="p-4 rounded-2xl bg-rose-500/10 border border-rose-500/20 text-rose-600 dark:text-rose-400 font-bold text-sm flex items-center gap-2">
            <span>⚠️</span> <span>@TempData["Error"]</span>
        </div>
    }

    <!-- Materials Grid / Table -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        @foreach (var item in Model)
        {
            <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 border border-slate-100 dark:border-slate-800 shadow-sm flex flex-col justify-between hover:border-amber-500/40 transition-all">
                <div>
                    <div class="flex items-start justify-between gap-3 mb-4">
                        <div>
                            <span class="inline-block px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-slate-100 dark:bg-slate-800 text-amber-600 dark:text-amber-400 mb-2">
                                @item.CategoryType
                            </span>
                            <h3 class="text-base font-black text-slate-900 dark:text-white">@item.NameAr</h3>
                            <p class="text-xs text-slate-400 font-mono">@item.NameEn</p>
                        </div>
                        <span class="px-2.5 py-1 rounded-xl text-xs font-bold @(item.IsActive ? "bg-emerald-500/10 text-emerald-500" : "bg-slate-200 text-slate-500")">
                            @(item.IsActive ? "نشط" : "معطل")
                        </span>
                    </div>

                    <div class="space-y-2 py-3 border-y border-slate-100 dark:border-slate-800/80 text-xs">
                        <div class="flex justify-between">
                            <span class="text-slate-400">وحدة القياس:</span>
                            <strong class="text-slate-800 dark:text-slate-200 font-mono">@item.UnitOfMeasure</strong>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-slate-400">السعر التقديري المرجعي:</span>
                            <strong class="text-amber-600 dark:text-amber-400 font-mono">@item.DefaultPriceEstimated.ToString("N2") د.أ</strong>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-slate-400">ترتيب العرض:</span>
                            <strong class="text-slate-800 dark:text-slate-200 font-mono">#@item.SortOrder</strong>
                        </div>
                    </div>

                    <div class="mt-3">
                        <span class="text-[11px] font-bold text-slate-400 block mb-1">مخطط الخصائص (Spec Schema):</span>
                        <div class="p-2.5 bg-slate-50 dark:bg-slate-800/60 rounded-xl text-[10px] font-mono text-slate-600 dark:text-slate-300 max-h-24 overflow-y-auto break-all">
                            @item.SpecSchemaJson
                        </div>
                    </div>
                </div>

                <div class="mt-5 pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-end gap-2">
                    <button type="button"
                            data-id="@item.Id"
                            data-name-ar="@item.NameAr"
                            data-name-en="@item.NameEn"
                            data-category-type="@item.CategoryType"
                            data-unit="@item.UnitOfMeasure"
                            data-price="@item.DefaultPriceEstimated"
                            data-sort="@item.SortOrder"
                            data-active="@item.IsActive.ToString().ToLower()"
                            data-schema="@item.SpecSchemaJson"
                            onclick="openEditFromButton(this)"
                            class="px-3.5 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 font-bold text-xs transition-colors">
                        تعديل
                    </button>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('هل أنت متأكد من رغبتك في حذف هذا التصنيف؟');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="px-3.5 py-1.5 rounded-xl bg-rose-500/10 hover:bg-rose-500 text-rose-500 hover:text-white font-bold text-xs transition-colors">
                            حذف
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal Dialog -->
<div id="materialModal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-slate-900/70 backdrop-blur-sm">
    <div class="w-full max-w-xl bg-white dark:bg-slate-900 rounded-3xl p-6 border border-slate-100 dark:border-slate-800 shadow-2xl space-y-4 max-h-[90vh] overflow-y-auto" dir="rtl">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800">
            <h3 id="modalTitle" class="text-lg font-black text-slate-900 dark:text-white">إضافة مادة بناء جديدة</h3>
            <button type="button" onclick="closeModal()" class="text-slate-400 hover:text-slate-600 dark:hover:text-white text-xl font-bold">&times;</button>
        </div>

        <form id="materialForm" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" id="formId" name="Id" value="0" />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">الاسم بالعربية *</label>
                    <input type="text" id="formNameAr" name="NameAr" required placeholder="مثال: حديد تسليح" class="w-full px-3.5 py-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold text-slate-800 dark:text-white" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">الاسم بالإنجليزية</label>
                    <input type="text" id="formNameEn" name="NameEn" placeholder="e.g. Steel Rebar" class="w-full px-3.5 py-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold text-slate-800 dark:text-white" />
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div>
                    <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">نوع التصنيف الإنشائي *</label>
                    <select id="formCategoryType" name="CategoryType" required class="w-full px-3.5 py-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold text-slate-800 dark:text-white">
                        <option value="Steel">Steel (حديد)</option>
                        <option value="Stone">Stone (حجر بناء)</option>
                        <option value="ReadyMix">ReadyMix (خرسانة جاهزة)</option>
                        <option value="Cement">Cement (إسمنت)</option>
                        <option value="Blocks">Blocks (طوب)</option>
                        <option value="Sand">Sand (رمل وحصمة)</option>
                        <option value="Insulation">Insulation (عوازل)</option>
                        <option value="Finishing">Finishing (تشطيبات)</option>
                        <option value="Custom">Custom (صنف مخصص)</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">وحدة القياس *</label>
                    <input type="text" id="formUnitOfMeasure" name="UnitOfMeasure" required placeholder="Ton, m², m³, Bag, 1000s" class="w-full px-3.5 py-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold text-slate-800 dark:text-white font-mono" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">السعر المرجعي (د.أ)</label>
                    <input type="number" step="0.01" id="formDefaultPrice" name="DefaultPriceEstimated" value="0" class="w-full px-3.5 py-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold text-slate-800 dark:text-white font-mono" />
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">مخطط المواصفات (JSON Schema)</label>
                <textarea id="formSpecSchema" name="SpecSchemaJson" rows="4" placeholder='{"fields":[{"name":"diameter","label":"القطر","type":"select","options":["8mm","10mm"]}]}'
                          class="w-full px-3.5 py-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-mono text-slate-800 dark:text-white text-left" dir="ltr"></textarea>
                <p class="text-[10px] text-slate-400 mt-1">يحدد الخصائص التي سيملأها المورد عند إضافة هذا الصنف (مثل: الأقطار، التشطيبات، المقاسات، مصانع التوريد).</p>
            </div>

            <div class="flex items-center justify-between pt-2">
                <div class="flex items-center gap-2">
                    <input type="checkbox" id="formIsActive" name="IsActive" value="true" checked class="w-4 h-4 text-amber-500 rounded" />
                    <label for="formIsActive" class="text-xs font-bold text-slate-700 dark:text-slate-300">مادة نشطة ومتاحة في الكتالوج</label>
                </div>
                <div class="flex items-center gap-2">
                    <label class="text-xs font-bold text-slate-700 dark:text-slate-300">ترتيب:</label>
                    <input type="number" id="formSortOrder" name="SortOrder" value="0" class="w-16 px-2 py-1 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg text-xs font-mono text-center" />
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100 dark:border-slate-800">
                <button type="button" onclick="closeModal()" class="px-5 py-2.5 text-xs font-bold text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-xl transition-colors">إلغاء</button>
                <button type="submit" class="px-6 py-2.5 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 text-slate-900 font-black text-xs shadow-md transition-all">حفظ البيانات</button>
            </div>
        </form>
    </div>
</div>

<script>
    const modal = document.getElementById('materialModal');
    const form = document.getElementById('materialForm');

    function openAddModal() {
        document.getElementById('modalTitle').innerText = 'إضافة مادة بناء جديدة';
        form.action = '/Admin/MaterialTypes/Create';
        document.getElementById('formId').value = '0';
        document.getElementById('formNameAr').value = '';
        document.getElementById('formNameEn').value = '';
        document.getElementById('formCategoryType').value = 'Steel';
        document.getElementById('formUnitOfMeasure').value = 'Ton';
        document.getElementById('formDefaultPrice').value = '0';
        document.getElementById('formSortOrder').value = '0';
        document.getElementById('formIsActive').checked = true;
        document.getElementById('formSpecSchema').value = '{"fields":[]}';
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    }

    function openEditFromButton(btn) {
        const id = btn.getAttribute('data-id');
        const nameAr = btn.getAttribute('data-name-ar');
        const nameEn = btn.getAttribute('data-name-en');
        const catType = btn.getAttribute('data-category-type');
        const unit = btn.getAttribute('data-unit');
        const price = btn.getAttribute('data-price');
        const sort = btn.getAttribute('data-sort');
        const active = btn.getAttribute('data-active') === 'true';
        const schema = btn.getAttribute('data-schema');
        openEditModal(id, nameAr, nameEn, catType, unit, price, sort, active, schema);
    }

    function openEditModal(id, nameAr, nameEn, catType, unit, price, sort, active, schema) {
        document.getElementById('modalTitle').innerText = 'تعديل مادة البناء';
        form.action = '/Admin/MaterialTypes/Edit';
        document.getElementById('formId').value = id;
        document.getElementById('formNameAr').value = nameAr;
        document.getElementById('formNameEn').value = nameEn || '';
        document.getElementById('formCategoryType').value = catType;
        document.getElementById('formUnitOfMeasure').value = unit;
        document.getElementById('formDefaultPrice').value = price;
        document.getElementById('formSortOrder').value = sort;
        document.getElementById('formIsActive').checked = active;
        document.getElementById('formSpecSchema').value = schema || '{}';
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    }

    function closeModal() {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
    }
</script>
