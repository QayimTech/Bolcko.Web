@model Bolcko.Domain.Entities.Financing.DTOs.InvestorDashboardDto
@{
    ViewData["Title"] = "محفظة المستثمر التمويلية وعوائد المرابحة";
    Layout = "~/Areas/Shop/Views/Shared/_Layout.cshtml";
    var isRtl = System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
}

<div class="min-h-screen bg-[#0D111A] text-slate-100 py-10 px-4 sm:px-6 lg:px-8" dir="rtl">
    <div class="max-w-7xl mx-auto space-y-8">

        <!-- Top Header & Actions -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-white/10 pb-6">
            <div>
                <div class="flex items-center gap-2 text-xs text-emerald-400 font-mono uppercase tracking-wider mb-1">
                    <span class="material-symbols-outlined text-sm">account_balance</span>
                    <span>محفظة التمويل بالمرابحة الإسلامية والوكالة الشرعية</span>
                </div>
                <h1 class="text-2xl sm:text-3xl font-extrabold text-white">لوحة تحكم المستثمر الممول (Islamic Trade Syndication)</h1>
                <p class="text-slate-400 text-xs sm:text-sm mt-1">تتبع استثماراتك في شراء وتمليك مواد البناء، العوائد الصافية المحققة، وعقود الوكالة الموثقة.</p>
            </div>

            <div class="flex items-center gap-3 flex-wrap">
                <a href="/Shop/Subscription/Plans?role=Investor" class="px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-black transition-all flex items-center gap-1.5 shadow-md shadow-amber-500/10">
                    <span class="material-symbols-outlined text-sm">stars</span>
                    <span>ترقية باقة VIP (وصول مبكر واستثمار آلي)</span>
                </a>
                <a href="/Shop/Financing" class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white text-xs font-bold transition-all flex items-center gap-1.5 shadow-lg shadow-emerald-950/40">
                    <span class="material-symbols-outlined text-sm">add_circle</span>
                    <span>تمويل عطاء جديد</span>
                </a>
            </div>
        </div>

        <!-- Digital Wallet & Instant Payout Hub (QT1-81) -->
        <div class="bg-gradient-to-r from-emerald-950/80 via-slate-900 to-[#151B26] border border-emerald-500/30 rounded-3xl p-6 sm:p-8 shadow-2xl relative overflow-hidden flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
            <div class="space-y-2">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-xs font-bold font-mono">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span>محفظة المستثمر المباشرة • الرصيد المتاح للسحب الفوري</span>
                </div>
                <div class="flex items-baseline gap-2">
                    <span class="text-4xl sm:text-5xl font-black text-white font-mono" id="walletBalanceVal">@Model.AvailableWalletBalanceJod.ToString("N2")</span>
                    <span class="text-sm font-bold text-emerald-400">دينار أردني</span>
                </div>
                <p class="text-xs text-slate-400">يشمل رأس المال المسترد من العطاءات المسددة والأرباح الصافية المحررة من الضمان.</p>
            </div>

            <div class="flex items-center gap-3 w-full md:w-auto flex-wrap">
                <button type="button" onclick="openDepositModal()" class="w-full sm:w-auto px-5 py-3.5 rounded-2xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-black text-sm shadow-xl shadow-amber-950/40 transition-all flex items-center justify-center gap-2 cursor-pointer active:scale-95">
                    <span class="material-symbols-outlined">add_card</span>
                    <span>إيداع وتغذية المحفظة</span>
                </button>
                <button type="button" onclick="openPayoutModal()" class="w-full sm:w-auto px-5 py-3.5 rounded-2xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm shadow-xl shadow-emerald-900/40 transition-all flex items-center justify-center gap-2 cursor-pointer active:scale-95">
                    <span class="material-symbols-outlined">payments</span>
                    <span>طلب سحب الأرباح (CliQ / IBAN)</span>
                </button>
            </div>
        </div>

        <!-- Portfolio Statistics Overview -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            
            <!-- 1. Total Capital Invested -->
            <div class="bg-[#151B26] border border-white/10 rounded-2xl p-5 shadow-xl relative overflow-hidden group hover:border-emerald-500/40 transition-all">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-xs font-bold text-slate-400">إجمالي رأس المال المستثمر</span>
                    <span class="material-symbols-outlined text-emerald-400 text-lg">account_balance_wallet</span>
                </div>
                <div class="flex items-baseline gap-1">
                    <span class="text-3xl font-black text-white font-mono">@Model.TotalInvestedJod.ToString("N0")</span>
                    <span class="text-xs text-slate-400">د.أ</span>
                </div>
                <p class="text-[11px] text-slate-400 mt-2">موزع على <strong class="text-emerald-400 font-mono">@(Model.ActiveDealsCount + Model.CompletedDealsCount)</strong> عطاءات شراء وتوريد</p>
            </div>

            <!-- 2. Realized Net Profits -->
            <div class="bg-[#151B26] border border-white/10 rounded-2xl p-5 shadow-xl relative overflow-hidden group hover:border-amber-500/40 transition-all">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-xs font-bold text-slate-400">الأرباح الصافية المحصلة</span>
                    <span class="material-symbols-outlined text-amber-400 text-lg">trending_up</span>
                </div>
                <div class="flex items-baseline gap-1">
                    <span class="text-3xl font-black text-amber-400 font-mono">@Model.RealizedProfitJod.ToString("N0")</span>
                    <span class="text-xs text-slate-400">د.أ</span>
                </div>
                <p class="text-[11px] text-slate-400 mt-2">أرباح قادمة قيد التحصيل: <strong class="text-slate-200 font-mono">@Model.ExpectedUpcomingProfitJod.ToString("N0") د.أ</strong></p>
            </div>

            <!-- 3. Average Annualized Yield -->
            <div class="bg-[#151B26] border border-white/10 rounded-2xl p-5 shadow-xl relative overflow-hidden group hover:border-sky-500/40 transition-all">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-xs font-bold text-slate-400">متوسط العائد السنوي (APR)</span>
                    <span class="material-symbols-outlined text-sky-400 text-lg">percent</span>
                </div>
                <div class="flex items-baseline gap-1">
                    <span class="text-3xl font-black text-sky-400 font-mono">@Model.AverageAnnualizedYieldPercentage.ToString("N1")%</span>
                    <span class="text-xs text-slate-400">سنوياً</span>
                </div>
                <p class="text-[11px] text-slate-400 mt-2">معدل العائد الصافي بعد اقتطاع أجر الوكالة</p>
            </div>

            <!-- 4. Completed & Settled Deals -->
            <div class="bg-[#151B26] border border-white/10 rounded-2xl p-5 shadow-xl relative overflow-hidden group hover:border-purple-500/40 transition-all">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-xs font-bold text-slate-400">العطاءات المنجزة والمسددة</span>
                    <span class="material-symbols-outlined text-purple-400 text-lg">verified</span>
                </div>
                <div class="flex items-baseline gap-1">
                    <span class="text-3xl font-black text-purple-300 font-mono">@Model.CompletedDealsCount</span>
                    <span class="text-xs text-slate-400">عملية سداد 100%</span>
                </div>
                <p class="text-[11px] text-slate-400 mt-2">عطاءات نشطة حالياً: <strong class="text-slate-200 font-mono">@Model.ActiveDealsCount</strong></p>
            </div>

        </div>

        <!-- Active Investments Section -->
        <div class="bg-[#151B26] border border-white/10 rounded-2xl p-6 shadow-xl space-y-6">
            <div class="flex items-center justify-between pb-4 border-b border-white/5">
                <div class="flex items-center gap-2.5">
                    <span class="w-8 h-8 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold">
                        <span class="material-symbols-outlined text-lg">pending_actions</span>
                    </span>
                    <div>
                        <h2 class="text-base font-bold text-white">العطاءات النشطة قيد التوريد والسداد</h2>
                        <p class="text-slate-400 text-xs mt-0.5">متابعة مسار شراء المواد وتمليكها والتسليم الموقعي بالـ GPS</p>
                    </div>
                </div>
                <span class="px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-400 text-xs font-bold font-mono">@Model.ActiveInvestments.Count صفقة نشطة</span>
            </div>

            @if (Model.ActiveInvestments.Any())
            {
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    @foreach (var inv in Model.ActiveInvestments)
                    {
                        <div class="bg-[#1B2234] border border-white/5 hover:border-emerald-500/30 rounded-2xl p-5 transition-all flex flex-col justify-between">
                            <div>
                                <div class="flex items-center justify-between gap-2 pb-3 border-b border-white/5">
                                    <div class="flex items-center gap-2">
                                        <span class="font-mono text-xs font-bold text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded">@inv.TrackingCode</span>
                                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30">@inv.StatusNameAr</span>
                                    </div>
                                    <span class="text-xs font-bold font-mono text-emerald-300">+@inv.InvestorNetYieldAmount.ToString("N0") د.أ ربح</span>
                                </div>

                                <h3 class="text-white font-bold text-sm mt-3">@inv.ProjectTitle</h3>
                                <div class="mt-2 space-y-1 text-xs text-slate-400">
                                    <p class="flex items-center gap-1.5">
                                        <span class="material-symbols-outlined text-xs text-slate-500">person</span>
                                        <span>المقاول: <strong class="text-slate-200">@inv.ContractorName</strong> (@inv.ContractorCompany)</span>
                                    </p>
                                    <p class="flex items-center gap-1.5">
                                        <span class="material-symbols-outlined text-xs text-slate-500">verified</span>
                                        <span>درجة موثوقية المقاول: <strong class="text-amber-400 font-mono">@inv.ContractorTrustScore.ToString("N0")/100</strong></span>
                                    </p>
                                    <p class="flex items-center gap-1.5">
                                        <span class="material-symbols-outlined text-xs text-slate-500">event</span>
                                        <span>تاريخ الاستحقاق: <strong class="text-slate-200 font-mono">@(inv.DueDate.HasValue ? inv.DueDate.Value.ToString("yyyy-MM-dd") : "خلال " + inv.TenureDays + " يوم")</strong></span>
                                    </p>
                                </div>
                            </div>

                            <!-- Bottom Metrics & Contract Button -->
                            <div class="mt-5 pt-3 border-t border-white/5 flex items-center justify-between">
                                <div>
                                    <span class="text-[10px] text-slate-500 block">رأس المال الممول</span>
                                    <span class="text-sm font-bold text-white font-mono">@inv.BaseMaterialCost.ToString("N0") د.أ</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <a href="/Shop/Financing/Contract/@inv.TrackingCode" target="_blank" class="px-3 py-1.5 rounded-xl bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400 text-xs font-bold transition-all flex items-center gap-1 border border-emerald-500/20">
                                        <span class="material-symbols-outlined text-xs">description</span>
                                        <span>عقد الوكالة</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="py-12 text-center text-slate-400">
                    <span class="material-symbols-outlined text-4xl text-slate-600 mb-2 block">account_balance</span>
                    <p class="text-sm font-medium">لا توجد عطاءات نشطة في محفظتك حالياً.</p>
                    <a href="/Shop/Financing" class="mt-4 inline-flex items-center gap-1.5 px-5 py-2.5 rounded-xl bg-emerald-600 text-white text-xs font-bold hover:bg-emerald-500 transition-all">
                        <span>استعرض العطاءات المتاحة للتمويل</span>
                        <span class="material-symbols-outlined text-sm">arrow_forward</span>
                    </a>
                </div>
            }
        </div>

        <!-- Wallet Ledger & Transaction History (QT1-81) -->
        <div class="bg-[#151B26] border border-white/10 rounded-2xl p-6 shadow-xl space-y-4">
            <div class="flex items-center justify-between pb-3 border-b border-white/5">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-emerald-400">receipt_long</span>
                    <h2 class="text-sm font-bold text-white">سجل الحركات المالية والمحفظة الرقمية (Wallet Ledger)</h2>
                </div>
                <span class="text-xs text-slate-400 font-mono">@Model.WalletLedger.Count حركة مسجلة</span>
            </div>

            @if (Model.WalletLedger.Any())
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-start text-xs">
                        <thead class="bg-white/5 text-slate-400 font-bold">
                            <tr>
                                <th class="p-3 text-start">رقم الحركة</th>
                                <th class="p-3 text-start">تفاصيل العملية</th>
                                <th class="p-3 text-start">قناة الدفع / التحويل</th>
                                <th class="p-3 text-start">المبلغ</th>
                                <th class="p-3 text-start">الحالة</th>
                                <th class="p-3 text-start">التاريخ</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-white/5">
                            @foreach (var l in Model.WalletLedger)
                            {
                                <tr class="text-slate-300 hover:bg-white/5 transition-colors">
                                    <td class="p-3 font-mono font-bold text-emerald-400">@l.TransactionCode</td>
                                    <td class="p-3 font-semibold text-white">@l.Title</td>
                                    <td class="p-3 font-mono text-slate-400">@l.PaymentChannel</td>
                                    <td class="p-3 font-mono font-bold @(l.Type == "ProfitCredit" ? "text-emerald-400" : "text-amber-400")">
                                        @(l.Type == "ProfitCredit" ? "+" : "")@l.AmountJod.ToString("N2") د.أ
                                    </td>
                                    <td class="p-3">
                                        <span class="px-2 py-0.5 rounded text-[10px] font-bold @(l.Status == "Completed" ? "bg-emerald-500/10 text-emerald-400 border border-emerald-500/20" : "bg-amber-500/10 text-amber-400 border border-amber-500/20")">
                                            @(l.Status == "Completed" ? "مكتملة ومحررة" : "قيد المعالجة")
                                        </span>
                                    </td>
                                    <td class="p-3 font-mono text-slate-500">@l.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="py-8 text-center text-xs text-slate-500">لا توجد حركات مالية مسجلة بعد. عند سداد المقاولين ستظهر الأرباح هنا مباشرة.</div>
            }
        </div>

    </div>
</div>

<!-- Payout Modal Dialog (QT1-81) -->
<div id="payoutModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm" dir="rtl">
    <div class="bg-slate-900 border border-white/15 rounded-3xl p-6 sm:p-8 max-w-md w-full shadow-2xl space-y-5 text-start">
        <div class="flex items-center justify-between border-b border-white/10 pb-4">
            <div class="flex items-center gap-2 text-white font-bold text-base">
                <span class="material-symbols-outlined text-emerald-400">account_balance</span>
                <span>طلب تحويل وسحب الأرباح</span>
            </div>
            <button type="button" onclick="closePayoutModal()" class="text-slate-400 hover:text-white cursor-pointer">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <!-- Payout Method Tabs -->
        <div class="grid grid-cols-2 gap-2 bg-slate-950 p-1 rounded-xl border border-white/5 text-xs font-bold text-center">
            <button type="button" onclick="setPayoutTab('CliQ')" id="tabCliQ" class="p-2.5 rounded-lg bg-emerald-600 text-white transition-all cursor-pointer">
                نظام كليك الفوري (CliQ)
            </button>
            <button type="button" onclick="setPayoutTab('BankTransfer')" id="tabBank" class="p-2.5 rounded-lg text-slate-400 hover:text-white transition-all cursor-pointer">
                تحويل آيبان بنكي (IBAN)
            </button>
        </div>

        <div class="space-y-4 text-xs">
            <div class="space-y-1">
                <div class="flex justify-between text-slate-400">
                    <span>مبلغ السحب (د.أ):</span>
                    <span>الرصيد المتاح: <strong class="text-emerald-400 font-mono">@Model.AvailableWalletBalanceJod.ToString("N2") د.أ</strong></span>
                </div>
                <input type="number" id="payoutAmount" value="@Model.AvailableWalletBalanceJod" max="@Model.AvailableWalletBalanceJod" min="10" step="10" class="w-full p-3 rounded-xl border border-white/10 bg-slate-950 text-white font-mono text-sm focus:outline-none focus:border-emerald-500" />
            </div>

            <div id="cliqFieldContainer" class="space-y-1">
                <label class="font-bold text-slate-300 block">الاسم المستعار في CliQ أو رقم الهاتف:</label>
                <input type="text" id="cliqAlias" placeholder="مثال: ALI.CLI@JO أو 079XXXXXXX" class="w-full p-3 rounded-xl border border-white/10 bg-slate-950 text-white font-mono focus:outline-none focus:border-emerald-500" />
            </div>

            <div id="ibanFieldContainer" class="hidden space-y-3">
                <div class="space-y-1">
                    <label class="font-bold text-slate-300 block">اسم البنك الأردني:</label>
                    <input type="text" id="bankName" placeholder="مثال: البنك العربي / بنك الإسكان / بنك الاتحاد" class="w-full p-3 rounded-xl border border-white/10 bg-slate-950 text-white focus:outline-none focus:border-emerald-500" />
                </div>
                <div class="space-y-1">
                    <label class="font-bold text-slate-300 block">رقم الآيبان (IBAN):</label>
                    <input type="text" id="ibanNumber" placeholder="JO00XXXX0000000000000000000000" class="w-full p-3 rounded-xl border border-white/10 bg-slate-950 text-white font-mono uppercase focus:outline-none focus:border-emerald-500" />
                </div>
            </div>
        </div>

        <div class="pt-2 flex items-center justify-between gap-3">
            <button type="button" onclick="closePayoutModal()" class="w-1/3 py-3 rounded-xl bg-white/5 hover:bg-white/10 text-slate-300 font-bold text-xs transition-all cursor-pointer">
                إلغاء
            </button>
            <button type="button" id="confirmPayoutBtn" onclick="submitPayoutRequest()" class="w-2/3 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs shadow-lg shadow-emerald-900/40 transition-all flex items-center justify-center gap-2 cursor-pointer">
                <span class="material-symbols-outlined text-sm">send</span>
                <span>تأكيد طلب التحويل</span>
            </button>
    </div>
</div>

<!-- Deposit / Top-up Modal Dialog (QT1-108) -->
<div id="depositModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm" dir="rtl">
    <div class="bg-slate-900 border border-white/15 rounded-3xl p-6 sm:p-8 max-w-md w-full shadow-2xl space-y-5 text-start">
        <div class="flex items-center justify-between border-b border-white/10 pb-4">
            <div class="flex items-center gap-2 text-white font-bold text-base">
                <span class="material-symbols-outlined text-amber-400">add_card</span>
                <span>إيداع وتغذية رأس مال المحفظة</span>
            </div>
            <button type="button" onclick="closeDepositModal()" class="text-slate-400 hover:text-white cursor-pointer">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <div class="p-4 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-xs space-y-2">
            <p class="font-bold text-amber-400 flex items-center gap-1.5">
                <span class="material-symbols-outlined text-sm">account_balance</span>
                <span>الحساب البنكي المعتمد لحساب الضمان (Escrow Trust):</span>
            </p>
            <p class="text-slate-300 font-mono">البنك العربي • فرع الشميساني</p>
            <p class="text-slate-300 font-mono text-[11px]">IBAN: JO29ARAB0120000001234567890100</p>
            <p class="text-slate-300 font-mono text-[11px]">CliQ Alias: <strong class="text-white">BOLCKO.PAY@ARAB</strong></p>
        </div>

        <div class="space-y-3 text-xs">
            <div>
                <label class="font-bold text-slate-300 block mb-1">المبلغ المودع (د.أ):</label>
                <input type="number" id="depositAmount" min="50" step="50" placeholder="مثال: 5000" class="w-full p-3 rounded-xl border border-white/10 bg-slate-950 text-white font-mono text-sm focus:outline-none focus:border-amber-500" />
            </div>
            <div>
                <label class="font-bold text-slate-300 block mb-1">رقم الحوالة البنكية / مرجع كليك (Transaction Ref):</label>
                <input type="text" id="depositRef" placeholder="مثال: TXN-892109283" class="w-full p-3 rounded-xl border border-white/10 bg-slate-950 text-white font-mono focus:outline-none focus:border-amber-500" />
            </div>
        </div>

        <div class="pt-2 flex items-center justify-between gap-3">
            <button type="button" onclick="closeDepositModal()" class="w-1/3 py-3 rounded-xl bg-white/5 hover:bg-white/10 text-slate-300 font-bold text-xs transition-all cursor-pointer">
                إلغاء
            </button>
            <button type="button" id="confirmDepositBtn" onclick="submitDepositRequest()" class="w-2/3 py-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-xs shadow-lg shadow-amber-900/40 transition-all flex items-center justify-center gap-2 cursor-pointer">
                <span class="material-symbols-outlined text-sm">verified</span>
                <span>تأكيد الإيداع في المحفظة</span>
            </button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let activePayoutMethod = 'CliQ';

    function openPayoutModal() {
        document.getElementById('payoutModal').classList.remove('hidden');
    }

    function closePayoutModal() {
        document.getElementById('payoutModal').classList.add('hidden');
    }

    function setPayoutTab(method) {
        activePayoutMethod = method;
        if (method === 'CliQ') {
            document.getElementById('tabCliQ').className = 'p-2.5 rounded-lg bg-emerald-600 text-white transition-all cursor-pointer';
            document.getElementById('tabBank').className = 'p-2.5 rounded-lg text-slate-400 hover:text-white transition-all cursor-pointer';
            document.getElementById('cliqFieldContainer').classList.remove('hidden');
            document.getElementById('ibanFieldContainer').classList.add('hidden');
        } else {
            document.getElementById('tabBank').className = 'p-2.5 rounded-lg bg-emerald-600 text-white transition-all cursor-pointer';
            document.getElementById('tabCliQ').className = 'p-2.5 rounded-lg text-slate-400 hover:text-white transition-all cursor-pointer';
            document.getElementById('ibanFieldContainer').classList.remove('hidden');
            document.getElementById('cliqFieldContainer').classList.add('hidden');
        }
    }

    async function submitPayoutRequest() {
        const amount = parseFloat(document.getElementById('payoutAmount')?.value) || 0;
        const cliq = document.getElementById('cliqAlias')?.value?.trim();
        const iban = document.getElementById('ibanNumber')?.value?.trim();
        const bank = document.getElementById('bankName')?.value?.trim();

        if (amount <= 0) {
            if (window.BlockoModal) BlockoModal.alert('يرجى إدخال مبلغ سحب صالح.');
            else alert('يرجى إدخال مبلغ سحب صالح.');
            return;
        }

        if (activePayoutMethod === 'CliQ' && !cliq) {
            if (window.BlockoModal) BlockoModal.alert('يرجى إدخال الاسم المستعار في CliQ.');
            else alert('يرجى إدخال الاسم المستعار في CliQ.');
            return;
        }

        if (activePayoutMethod === 'BankTransfer' && !iban) {
            if (window.BlockoModal) BlockoModal.alert('يرجى إدخال رقم الآيبان البنكي (IBAN).');
            else alert('يرجى إدخال رقم الآيبان البنكي (IBAN).');
            return;
        }

        const btn = document.getElementById('confirmPayoutBtn');
        btn.disabled = true;
        btn.innerHTML = '<span class="material-symbols-outlined animate-spin text-sm">progress_activity</span> <span>جاري المعالجة...</span>';

        try {
            const res = await fetch('/Shop/Financing/RequestPayout', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    amountJod: amount,
                    payoutMethod: activePayoutMethod,
                    cliqAlias: cliq,
                    ibanNumber: iban,
                    bankName: bank
                })
            });

            const data = await res.json();
            if (window.BlockoModal) {
                BlockoModal.alert(data.message || 'تم تقديم طلب السحب بنجاح.', () => {
                    closePayoutModal();
                    window.location.reload();
                });
            } else {
                alert(data.message || 'تم تقديم طلب السحب بنجاح.');
                closePayoutModal();
                window.location.reload();
            }
        } catch (e) {
            if (window.BlockoModal) BlockoModal.alert('حدث خطأ أثناء معالجة طلب السحب.');
            else alert('حدث خطأ أثناء معالجة طلب السحب.');
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<span class="material-symbols-outlined text-sm">send</span> <span>تأكيد طلب التحويل</span>';
        }
    }

    function openDepositModal() {
        document.getElementById('depositModal').classList.remove('hidden');
    }

    function closeDepositModal() {
        document.getElementById('depositModal').classList.add('hidden');
    }

    async function submitDepositRequest() {
        const amount = parseFloat(document.getElementById('depositAmount')?.value) || 0;
        const ref = document.getElementById('depositRef')?.value?.trim();

        if (amount < 50) {
            if (window.BlockoModal) BlockoModal.alert('الحد الأدنى للإيداع هو 50 د.أ.');
            else alert('الحد الأدنى للإيداع هو 50 د.أ.');
            return;
        }

        if (!ref) {
            if (window.BlockoModal) BlockoModal.alert('يرجى إدخال رقم مرجع الحوالة البنكية أو كليك.');
            else alert('يرجى إدخال رقم مرجع الحوالة البنكية أو كليك.');
            return;
        }

        const btn = document.getElementById('confirmDepositBtn');
        btn.disabled = true;
        btn.innerHTML = '<span class="material-symbols-outlined animate-spin text-sm">progress_activity</span> <span>جاري التوثيق...</span>';

        setTimeout(() => {
            if (window.BlockoModal) {
                BlockoModal.alert('تم استلام إشعار الإيداع بنجاح. سيتم قيد المبلغ في محفظتك فور مطابقة إشعار البنك.', () => {
                    closeDepositModal();
                    window.location.reload();
                });
            } else {
                alert('تم استلام إشعار الإيداع بنجاح. سيتم قيد المبلغ في محفظتك فور مطابقة إشعار البنك.');
                closeDepositModal();
                window.location.reload();
            }
        }, 1000);
    }
</script>
}
