<!-- Reactive ROI Calculator Script -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    const isAr = @(isArabic ? "true" : "false");
    const currencySuffix = isAr ? ' د.أ' : ' JOD';
    const perMonthSuffix = isAr ? ' د.أ / شهر' : ' JOD / mo';

    const amountSlider = document.getElementById('calc-amount');
    const amountDisplay = document.getElementById('calc-amount-display');
    const rateSlider = document.getElementById('calc-rate');
    const rateDisplay = document.getElementById('calc-rate-display');
    const compoundCheckbox = document.getElementById('calc-compound');
    const tenureBtns = document.querySelectorAll('.tenure-btn');

    const resProfit = document.getElementById('res-profit');
    const resTotal = document.getElementById('res-total');
    const resMonthly = document.getElementById('res-monthly');
    const resIrr = document.getElementById('res-irr');

    let currentMonths = 3;

    tenureBtns.forEach(btn => {
        btn.addEventListener('click', function() {
            tenureBtns.forEach(b => {
                b.classList.remove('bg-amber-500/20', 'text-amber-400', 'border-amber-500/30', 'active');
                b.classList.add('bg-white/5', 'text-slate-300', 'border-white/5');
            });
            this.classList.remove('bg-white/5', 'text-slate-300', 'border-white/5');
            this.classList.add('bg-amber-500/20', 'text-amber-400', 'border-amber-500/30', 'active');
            currentMonths = parseInt(this.getAttribute('data-months'));
            updateCalculator();
        });
    });

    function updateCalculator() {
        const capital = parseFloat(amountSlider.value);
        const annualRate = parseFloat(rateSlider.value) / 100.0;
        const isCompound = compoundCheckbox.checked;

        amountDisplay.textContent = Number(capital).toLocaleString('en-US') + currencySuffix;
        rateDisplay.textContent = (annualRate * 100).toFixed(1) + '%';

        const tenureYears = currentMonths / 12.0;
        let profit = 0;

        if (isCompound && currentMonths >= 6) {
            const timesPerYear = 4;
            const compoundPeriods = tenureYears * timesPerYear;
            const totalWithCompound = capital * Math.pow((1 + (annualRate / timesPerYear)), compoundPeriods);
            profit = totalWithCompound - capital;
        } else {
            profit = capital * annualRate * tenureYears;
        }

        const totalReturn = capital + profit;
        const monthlyPayout = profit / currentMonths;
        const effectiveIrr = (profit / capital / tenureYears) * 100;

        resProfit.textContent = Number(profit.toFixed(0)).toLocaleString('en-US') + currencySuffix;
        resTotal.textContent = Number(totalReturn.toFixed(0)).toLocaleString('en-US') + currencySuffix;
        resMonthly.textContent = Number(monthlyPayout.toFixed(0)).toLocaleString('en-US') + perMonthSuffix;
        resIrr.textContent = effectiveIrr.toFixed(2) + '%';
    }

    amountSlider.addEventListener('input', updateCalculator);
    rateSlider.addEventListener('input', updateCalculator);
    compoundCheckbox.addEventListener('change', updateCalculator);

    updateCalculator();
});
</script>

