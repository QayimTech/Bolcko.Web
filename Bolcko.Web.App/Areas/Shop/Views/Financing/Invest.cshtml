@model IEnumerable<Bolcko.Domain.Entities.Financing.DTOs.FinancingTenderDto>
@{
    var isArabic = System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("ar");
    var isRtl = System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
    ViewData["Title"] = isArabic 
        ? "بوابة المستثمرين | تمويل مواد البناء بالمرابحة الإسلامية"
        : "Investor Portal | Sharia-Compliant Construction Material Financing";
    Layout = "~/Areas/Shop/Views/Shared/_Layout.cshtml";

    Func<string, string> getCityName = city => {
        if (isArabic || string.IsNullOrWhiteSpace(city)) return city ?? "";
        return city.Trim() switch {
            "عمان" => "Amman",
            "الزرقاء" => "Zarqa",
            "إربد" => "Irbid",
            "العقبة" => "Aqaba",
            "المفرق" => "Mafraq",
            "معان" => "Maan",
            "البلقاء" or "السلط" => "Salt / Balqa",
            "مادبا" => "Madaba",
            "الكرك" => "Karak",
            "الطفيلة" => "Tafila",
            "عجلون" => "Ajloun",
            "جرش" => "Jerash",
            _ => city
        };
    };
}

<div class="min-h-screen bg-[#0B0F19] text-slate-100 selection:bg-amber-500 selection:text-black font-sans text-start" dir="@(isRtl ? "rtl" : "ltr")">
    <!-- Hero Section -->
    <section class="relative overflow-hidden pt-12 pb-20 lg:pt-20 lg:pb-32 border-b border-white/5 bg-gradient-to-b from-[#111726] via-[#0D111A] to-[#0B0F19]">
        <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#E8A020_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none"></div>
        <div class="absolute top-1/4 start-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
        
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="text-center max-w-4xl mx-auto">
                <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-400 text-xs sm:text-sm font-black mb-6 animate-pulse">
                    <span class="material-symbols-outlined text-[18px]">verified</span>
                    <span>@(isArabic ? "عوائد استثمارية حقيقية 10% - 14% متوافقة 100% مع الشريعة الإسلامية" : "Verified Real Returns 10% - 14% • 100% Sharia Compliant")</span>
                </div>
                
                <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white leading-tight tracking-tight mb-6">
                    @(isArabic ? "استثمر في" : "Invest in") <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-200 to-amber-500">@(isArabic ? "أصول حقيقية ومواد بناء" : "Real Assets & Construction Materials")</span> @(isArabic ? "بضمانات تنفيذية مشددة" : "with Enforceable Legal Guarantees")
                </h1>
                
                <p class="text-base sm:text-xl text-slate-300 font-medium leading-relaxed max-w-3xl mx-auto mb-10">
                    @(isArabic 
                        ? "منظومة فنتك متطورة لتمويل صفقات توريد وتجارة مواد الإنشاءات (حديد، أسمنت، خرسانة) بنظام المرابحة الإسلامية والقبض الحكمي المعتمد، مضمونة بسندات لأمر وتدقيق ائتماني موثق." 
                        : "Advanced FinTech ecosystem for financing construction material transactions (Steel, Cement, Ready-mix Concrete) via Islamic Murabaha & verified constructive possession, secured by promissory notes and certified credit audits.")
                </p>
                
                <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                    @if (User.Identity?.IsAuthenticated == true && (User.IsInRole("Investor") || User.IsInRole("SuperAdmin") || User.IsInRole("Admin")))
                    {
                        <a href="/Shop/Financing/InvestorDashboard" class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-gradient-to-r from-emerald-500 to-teal-500 text-slate-950 font-black text-base shadow-[0_10px_30px_rgba(16,185,129,0.3)] hover:shadow-[0_15px_40px_rgba(16,185,129,0.4)] hover:scale-[1.02] transition-all flex items-center justify-center gap-3">
                            <span class="material-symbols-outlined text-[22px]">account_balance_wallet</span>
                            <span>@(isArabic ? "لوحة تحكم محفظتي الاستثمارية" : "My Investment Portfolio")</span>
                        </a>
                    }
                    else if (User.Identity?.IsAuthenticated == true)
                    {
                        <a href="/Shop/Financing/InvestorJoin" class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-gradient-to-r from-[#E8A020] to-amber-500 text-slate-950 font-black text-base shadow-[0_10px_30px_rgba(232,160,32,0.3)] hover:shadow-[0_15px_40px_rgba(232,160,32,0.4)] hover:scale-[1.02] transition-all flex items-center justify-center gap-3">
                            <span class="material-symbols-outlined text-[22px]">verified</span>
                            <span>@(isArabic ? "ترقية حسابك إلى مستثمر معتمد" : "Upgrade to Verified Investor")</span>
                        </a>
                    }
                    else
                    {
                        <a href="/Shop/Financing/InvestorJoin" class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-gradient-to-r from-[#E8A020] to-amber-500 text-slate-950 font-black text-base shadow-[0_10px_30px_rgba(232,160,32,0.3)] hover:shadow-[0_15px_40px_rgba(232,160,32,0.4)] hover:scale-[1.02] transition-all flex items-center justify-center gap-3">
                            <span class="material-symbols-outlined text-[22px]">how_to_reg</span>
                            <span>@(isArabic ? "سجل كمستثمر معتمد الآن" : "Register as Verified Investor")</span>
                        </a>
                    }
                    
                    <a href="#roi-calculator" class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-white/5 hover:bg-white/10 text-white font-bold text-base border border-white/10 transition-all flex items-center justify-center gap-2">
                        <span class="material-symbols-outlined text-[20px]">calculate</span>
                        <span>@(isArabic ? "احسب عوائدك التقديرية" : "Calculate Estimated Yield")</span>
                    </a>
                </div>

                <!-- Prominent Sign In for Existing Investors -->
                @if (User.Identity?.IsAuthenticated != true)
                {
                    <div class="mt-5 flex items-center justify-center gap-2 text-xs sm:text-sm text-slate-400">
                        <span>@(isArabic ? "لديك حساب مستثمر معتمد بالفعل؟" : "Already an approved investor?")</span>
                        <a href="/Shop/Account/Login?returnUrl=/Shop/Financing/InvestorDashboard" class="text-amber-400 hover:text-amber-300 font-bold underline inline-flex items-center gap-1 transition-colors">
                            <span>@(isArabic ? "تسجيل الدخول لمحفظتك الاستثمارية" : "Sign In to Your Portfolio")</span>
                            <span class="material-symbols-outlined text-[16px] rtl:-scale-x-100">login</span>
                        </a>
                    </div>
                }
            </div>

            <!-- Fast Metrics Bar -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-16 lg:mt-24">
                <div class="bg-white/5 border border-white/10 rounded-2xl p-5 text-center backdrop-blur-sm">
                    <p class="text-2xl sm:text-3xl font-black text-amber-400 mb-1">10% - 14%</p>
                    <p class="text-xs sm:text-sm text-slate-400 font-medium">@(isArabic ? "معدل العائد السنوي المتوقع (IRR)" : "Expected Annual Return (IRR)")</p>
                </div>
                <div class="bg-white/5 border border-white/10 rounded-2xl p-5 text-center backdrop-blur-sm">
                    <p class="text-2xl sm:text-3xl font-black text-emerald-400 mb-1">@(isArabic ? "30 - 120 يوم" : "30 - 120 Days")</p>
                    <p class="text-xs sm:text-sm text-slate-400 font-medium">@(isArabic ? "فترات استرداد سريعة للسيولة" : "Rapid Liquidity Turnaround")</p>
                </div>
                <div class="bg-white/5 border border-white/10 rounded-2xl p-5 text-center backdrop-blur-sm">
                    <p class="text-2xl sm:text-3xl font-black text-sky-400 mb-1">100%</p>
                    <p class="text-xs sm:text-sm text-slate-400 font-medium">@(isArabic ? "مطابقة الشريعة والقبض الشرعي" : "Sharia Compliant & Constructive Possession")</p>
                </div>
                <div class="bg-white/5 border border-white/10 rounded-2xl p-5 text-center backdrop-blur-sm">
                    <p class="text-2xl sm:text-3xl font-black text-purple-400 mb-1">@(isArabic ? "0% تسييل وهمي" : "0% Synthetic Liquidation")</p>
                    <p class="text-xs sm:text-sm text-slate-400 font-medium">@(isArabic ? "أصول وبضائع حقيقية وموثقة موقعياً" : "Physical Site-Verified Goods & Assets")</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Interactive ROI Calculator -->
    <section id="roi-calculator" class="py-16 lg:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-12">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-xs font-bold mb-3">
                <span class="material-symbols-outlined text-[16px]">finance_mode</span>
                <span>@(isArabic ? "محاكي العوائد الاستثمارية التفاعلي" : "Interactive Yield Simulator")</span>
            </div>
            <h2 class="text-2xl sm:text-4xl font-black text-white mb-4">@(isArabic ? "احسب أرباحك وتدفقاتك النقدية بدقة" : "Simulate Yields & Cash Flows Accurately")</h2>
            <p class="text-slate-400 text-sm sm:text-base">
                @(isArabic 
                    ? "تحكم في حجم رأس المال المستثمر ومدة الصفقات لمعرفة العائد الربحي التقديري ومواعيد التوزيعات." 
                    : "Adjust invested capital and turnover duration to project your estimated yield and payout schedule.")
            </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            <!-- Controls Card -->
            <div class="lg:col-span-7 bg-[#131A29] border border-white/10 rounded-3xl p-6 sm:p-8 shadow-2xl">
                <!-- Capital Slider -->
                <div class="mb-8">
                    <div class="flex items-center justify-between mb-3">
                        <label class="text-sm font-bold text-slate-200">@(isArabic ? "حجم رأس المال المخصص للاستثمار:" : "Allocated Capital Amount:")</label>
                        <span class="text-xl sm:text-2xl font-black text-amber-400 bg-amber-500/10 px-4 py-1 rounded-xl border border-amber-500/20" id="calc-amount-display">25,000 @(isArabic ? "د.أ" : "JOD")</span>
                    </div>
                    <input type="range" id="calc-amount" min="5000" max="250000" step="5000" value="25000"
                           class="w-full h-3 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-[#E8A020]" />
                    <div class="flex justify-between text-[11px] text-slate-500 mt-2 font-bold">
                        <span>@(isArabic ? "5,000 د.أ (الحد الأدنى)" : "5,000 JOD (Minimum)")</span>
                        <span>@(isArabic ? "100,000 د.أ" : "100,000 JOD")</span>
                        <span>@(isArabic ? "250,000+ د.أ" : "250,000+ JOD")</span>
                    </div>
                </div>

                <!-- Duration / Tenure Selector -->
                <div class="mb-8">
                    <label class="text-sm font-bold text-slate-200 block mb-3">@(isArabic ? "متوسط مدة الصفقات والدوران:" : "Average Deal Tenure & Turnover:")</label>
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
                        <button type="button" class="tenure-btn active py-3 px-3 rounded-2xl bg-amber-500/20 text-amber-400 border border-amber-500/30 font-black text-xs sm:text-sm text-center transition-all" data-months="3">
                            @(isArabic ? "3 أشهر (90 يوم)" : "3 Months (90 Days)")
                        </button>
                        <button type="button" class="tenure-btn py-3 px-3 rounded-2xl bg-white/5 text-slate-300 border border-white/5 hover:bg-white/10 font-bold text-xs sm:text-sm text-center transition-all" data-months="6">
                            @(isArabic ? "6 أشهر (180 يوم)" : "6 Months (180 Days)")
                        </button>
                        <button type="button" class="tenure-btn py-3 px-3 rounded-2xl bg-white/5 text-slate-300 border border-white/5 hover:bg-white/10 font-bold text-xs sm:text-sm text-center transition-all" data-months="9">
                            @(isArabic ? "9 أشهر (270 يوم)" : "9 Months (270 Days)")
                        </button>
                        <button type="button" class="tenure-btn py-3 px-3 rounded-2xl bg-white/5 text-slate-300 border border-white/5 hover:bg-white/10 font-bold text-xs sm:text-sm text-center transition-all" data-months="12">
                            @(isArabic ? "12 شهر (سنة كاملة)" : "12 Months (Full Year)")
                        </button>
                    </div>
                </div>

                <!-- Annual Yield APR Slider -->
                <div class="mb-6">
                    <div class="flex items-center justify-between mb-3">
                        <label class="text-sm font-bold text-slate-200">@(isArabic ? "معدل الربح السنوي المستهدف (APR):" : "Target Annual Profit Rate (APR):")</label>
                        <span class="text-lg font-black text-emerald-400 bg-emerald-500/10 px-3 py-1 rounded-xl border border-emerald-500/20" id="calc-rate-display">12.0%</span>
                    </div>
                    <input type="range" id="calc-rate" min="10" max="15" step="0.5" value="12"
                           class="w-full h-3 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-emerald-500" />
                    <div class="flex justify-between text-[11px] text-slate-500 mt-2 font-bold">
                        <span>@(isArabic ? "10.0% (صفقات ممتازة A+)" : "10.0% (Prime A+ Tenders)")</span>
                        <span>@(isArabic ? "12.5% (متوسط السوق)" : "12.5% (Market Average)")</span>
                        <span>@(isArabic ? "15.0% (عطاءات خاصة)" : "15.0% (Specialized Tenders)")</span>
                    </div>
                </div>

                <!-- Auto-Reinvestment Toggle -->
                <div class="p-4 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-xl bg-purple-500/20 text-purple-400 flex items-center justify-center">
                            <span class="material-symbols-outlined text-[20px]">autorenew</span>
                        </div>
                        <div>
                            <p class="text-xs font-bold text-white">@(isArabic ? "تفعيل إعادة الاستثمار التلقائي (Auto-Reinvest)" : "Enable Auto-Reinvestment")</p>
                            <p class="text-[10px] text-slate-400">@(isArabic ? "توظيف الأرباح المستلمة فورياً لتحقيق العائد المركب الأقصى" : "Instantly deploy earned returns to achieve maximum compound growth")</p>
                        </div>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" id="calc-compound" class="sr-only peer" checked>
                        <div class="w-11 h-6 bg-slate-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#E8A020]"></div>
                    </label>
                </div>
            </div>

            <!-- Results Summary Card -->
            <div class="lg:col-span-5 bg-gradient-to-b from-[#192236] to-[#121826] border border-amber-500/30 rounded-3xl p-6 sm:p-8 shadow-[0_20px_50px_rgba(0,0,0,0.5)] relative overflow-hidden">
                <div class="absolute -top-12 -end-12 w-40 h-40 bg-amber-500/10 rounded-full blur-2xl pointer-events-none"></div>

                <h3 class="text-lg font-black text-white border-b border-white/10 pb-4 mb-6 flex items-center justify-between">
                    <span>@(isArabic ? "ملخص العوائد المتوقعة" : "Projected Returns Summary")</span>
                    <span class="text-xs font-bold text-amber-400 bg-amber-500/10 px-2.5 py-1 rounded-lg">@(isArabic ? "تقديري استرشادي" : "Indicative Projection")</span>
                </h3>

                <div class="space-y-4 mb-8">
                    <div class="flex justify-between items-center p-3.5 rounded-2xl bg-white/5 border border-white/5">
                        <span class="text-xs sm:text-sm text-slate-300 font-medium">@(isArabic ? "صافي الأرباح المتوقعة:" : "Estimated Net Profit:")</span>
                        <span class="text-lg sm:text-xl font-black text-emerald-400" id="res-profit">750 @(isArabic ? "د.أ" : "JOD")</span>
                    </div>

                    <div class="flex justify-between items-center p-3.5 rounded-2xl bg-white/5 border border-white/5">
                        <span class="text-xs sm:text-sm text-slate-300 font-medium">@(isArabic ? "إجمالي المبلغ المسترد:" : "Total Payout Amount:")</span>
                        <span class="text-lg sm:text-xl font-black text-white" id="res-total">25,750 @(isArabic ? "د.أ" : "JOD")</span>
                    </div>

                    <div class="flex justify-between items-center p-3.5 rounded-2xl bg-white/5 border border-white/5">
                        <span class="text-xs sm:text-sm text-slate-300 font-medium">@(isArabic ? "التدفق الربحي الشهري:" : "Monthly Profit Flow:")</span>
                        <span class="text-base sm:text-lg font-bold text-sky-400" id="res-monthly">250 @(isArabic ? "د.أ / شهر" : "JOD / mo")</span>
                    </div>

                    <div class="flex justify-between items-center p-3.5 rounded-2xl bg-amber-500/10 border border-amber-500/20">
                        <span class="text-xs sm:text-sm text-amber-300 font-bold">@(isArabic ? "معدل العائد الداخلي الفعلي (IRR):" : "Effective IRR:")</span>
                        <span class="text-lg font-black text-amber-400" id="res-irr">12.55%</span>
                    </div>
                </div>

                <a href="/Shop/Financing/InvestorJoin" class="w-full py-4 rounded-2xl bg-[#E8A020] hover:bg-amber-400 text-slate-950 font-black text-center text-sm sm:text-base transition-all shadow-lg block">
                    @(isArabic ? "ابدأ الاستثمار وتفعيل المحفظة" : "Start Investing & Activate Portfolio")
                </a>

                <p class="text-[10px] text-slate-400 text-center mt-3 leading-tight">
                    @(isArabic 
                        ? "* الحسابات مبنية على متوسط أرباح المرابحة ونظام التوزيع الدوري وتخضع لشروط عقود الوكالة المعتمدة." 
                        : "* Projections are based on average Murabaha returns and periodic distribution schedules subject to agency contracts.")
                </p>
            </div>
        </div>
    </section>

    <!-- Guarantees & Risk Management -->
    <section class="py-16 bg-[#0E131F] border-t border-b border-white/5">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-16">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-sky-500/10 text-sky-400 border border-sky-500/20 text-xs font-bold mb-3">
                    <span class="material-symbols-outlined text-[16px]">security</span>
                    <span>@(isArabic ? "شبكة الحماية والضمانات الثلاثية" : "Triple-Tier Protection Network")</span>
                </div>
                <h2 class="text-2xl sm:text-4xl font-black text-white mb-4">@(isArabic ? "أموالك محمية بأصول مادية وسندات قانونية" : "Capital Protected by Tangible Assets & Legal Instruments")</h2>
                <p class="text-slate-400 text-sm sm:text-base">
                    @(isArabic 
                        ? "نحن لا نقرض أموالاً نقدية، بل نشتري مواد بناء حقيقية ونسلمها بموقع العمل وفق تدقيق ائتماني صارم." 
                        : "We do not lend cash; we purchase verified building materials and deliver them on-site under strict credit governance.")
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Guarantee 1 -->
                <div class="p-8 rounded-3xl bg-white/5 border border-white/10 hover:border-amber-500/40 transition-all relative group">
                    <div class="w-14 h-14 rounded-2xl bg-amber-500/20 text-amber-400 flex items-center justify-center mb-6 text-3xl font-black">
                        <span class="material-symbols-outlined text-[32px]">gavel</span>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3">@(isArabic ? "1. سندات لأمر قضائية وتنفيذية" : "1. Enforceable Legal Promissory Notes")</h3>
                    <p class="text-slate-400 text-sm leading-relaxed">
                        @(isArabic 
                            ? "توقيع سندات لأمر إلكترونية معتمدة قابلة للتنفيذ المباشر لدى دوائر التنفيذ القضائي تغطي أصل التمويل وهامش المرابحة بالكامل." 
                            : "Execution of certified digital promissory notes directly enforceable by judicial execution courts covering the full principal and Murabaha margin.")
                    </p>
                </div>

                <!-- Guarantee 2 -->
                <div class="p-8 rounded-3xl bg-white/5 border border-white/10 hover:border-sky-500/40 transition-all relative group">
                    <div class="w-14 h-14 rounded-2xl bg-sky-500/20 text-sky-400 flex items-center justify-center mb-6 text-3xl font-black">
                        <span class="material-symbols-outlined text-[32px]">pin_drop</span>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3">@(isArabic ? "2. إثبات التسليم الرقمي (GPS POD)" : "2. Digital Proof of Delivery (GPS e-POD)")</h3>
                    <p class="text-slate-400 text-sm leading-relaxed">
                        @(isArabic 
                            ? "لا يتم صرف مستحقات التوريد إلا بعد توثيق وصول الشاحنات لموقع المقاول عبر البصمة الجغرافية وصور المواد المفرغة وتوقيع المهندس." 
                            : "Disbursement occurs only after geotagged truck delivery confirmation, site offloading photos, and supervising engineer digital sign-off.")
                    </p>
                </div>

                <!-- Guarantee 3 -->
                <div class="p-8 rounded-3xl bg-white/5 border border-white/10 hover:border-emerald-500/40 transition-all relative group">
                    <div class="w-14 h-14 rounded-2xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center mb-6 text-3xl font-black">
                        <span class="material-symbols-outlined text-[32px]">query_stats</span>
                    </div>
