@model IEnumerable<Bolcko.Domain.Entities.Financing.DTOs.FinancingTenderDto>
@{
    ViewData["Title"] = "بوابة المستثمرين | تمويل مواد البناء بالمرابحة الإسلامية";
    Layout = "~/Areas/Shop/Views/Shared/_Layout.cshtml";
    var isArabic = System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("ar");
}

<div class="min-h-screen bg-[#0B0F19] text-slate-100 selection:bg-amber-500 selection:text-black">
    <!-- Hero Section -->
    <section class="relative overflow-hidden pt-12 pb-20 lg:pt-20 lg:pb-32 border-b border-white/5 bg-gradient-to-b from-[#111726] via-[#0D111A] to-[#0B0F19]">
        <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#E8A020_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none"></div>
        <div class="absolute top-1/4 start-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
        
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="text-center max-w-4xl mx-auto">
                <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-400 text-xs sm:text-sm font-black mb-6 animate-pulse">
                    <span class="material-symbols-outlined text-[18px]">verified</span>
                    <span>عوائد استثمارية حقيقية 10% - 14% متوافقة 100% مع الشريعة الإسلامية</span>
                </div>
                
                <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white leading-tight tracking-tight mb-6">
                    استثمر في <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-200 to-amber-500">أصول حقيقية ومواد بناء</span> بضمانات تنفيذية مشددة
                </h1>
                
                <p class="text-base sm:text-xl text-slate-300 font-medium leading-relaxed max-w-3xl mx-auto mb-10">
                    منظومة فنتك متطورة لتمويل صفقات توريد وتجارة مواد الإنشاءات (حديد، أسمنت، خرسانة) بنظام المرابحة الإسلامية والقبض الحكمي المعتمد، مضمونة بسندات لأمر وتدقيق ائتماني موثق.
                </p>
                
                <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                    <a href="/Shop/Financing/InvestorJoin" class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-gradient-to-r from-[#E8A020] to-amber-500 text-slate-950 font-black text-base shadow-[0_10px_30px_rgba(232,160,32,0.3)] hover:shadow-[0_15px_40px_rgba(232,160,32,0.4)] hover:scale-[1.02] transition-all flex items-center justify-center gap-3">
                        <span class="material-symbols-outlined text-[22px]">how_to_reg</span>
                        <span>سجل كمستثمر معتمد الآن</span>
                    </a>
                    
                    <a href="#roi-calculator" class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-white/5 hover:bg-white/10 text-white font-bold text-base border border-white/10 transition-all flex items-center justify-center gap-2">
                        <span class="material-symbols-outlined text-[20px]">calculate</span>
                        <span>احسب عوائدك التقديرية</span>
                    </a>
                </div>
            </div>

            <!-- Fast Metrics Bar -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-16 lg:mt-24">
                <div class="bg-white/5 border border-white/10 rounded-2xl p-5 text-center backdrop-blur-sm">
                    <p class="text-2xl sm:text-3xl font-black text-amber-400 mb-1">10% - 14%</p>
                    <p class="text-xs sm:text-sm text-slate-400 font-medium">معدل العائد السنوي المتوقع (IRR)</p>
                </div>
                <div class="bg-white/5 border border-white/10 rounded-2xl p-5 text-center backdrop-blur-sm">
                    <p class="text-2xl sm:text-3xl font-black text-emerald-400 mb-1">30 - 120 يوم</p>
                    <p class="text-xs sm:text-sm text-slate-400 font-medium">فترات استرداد سريعة للسيولة</p>
                </div>
                <div class="bg-white/5 border border-white/10 rounded-2xl p-5 text-center backdrop-blur-sm">
                    <p class="text-2xl sm:text-3xl font-black text-sky-400 mb-1">100%</p>
                    <p class="text-xs sm:text-sm text-slate-400 font-medium">مطابقة الشريعة والقبض الشرعي</p>
                </div>
                <div class="bg-white/5 border border-white/10 rounded-2xl p-5 text-center backdrop-blur-sm">
                    <p class="text-2xl sm:text-3xl font-black text-purple-400 mb-1">0% تسييل وهمي</p>
                    <p class="text-xs sm:text-sm text-slate-400 font-medium">أصول وبضائع حقيقية وموثقة موقعياً</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Interactive ROI Calculator -->
    <section id="roi-calculator" class="py-16 lg:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-12">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-xs font-bold mb-3">
                <span class="material-symbols-outlined text-[16px]">finance_mode</span>
                <span>محاكي العوائد الاستثمارية التفاعلي</span>
            </div>
            <h2 class="text-2xl sm:text-4xl font-black text-white mb-4">احسب أرباحك وتدفقاتك النقدية بدقة</h2>
            <p class="text-slate-400 text-sm sm:text-base">تحكم في حجم رأس المال المستثمر ومدة الصفقات لمعرفة العائد الربحي التقديري ومواعيد التوزيعات.</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            <!-- Controls Card -->
            <div class="lg:col-span-7 bg-[#131A29] border border-white/10 rounded-3xl p-6 sm:p-8 shadow-2xl">
                <!-- Capital Slider -->
                <div class="mb-8">
                    <div class="flex items-center justify-between mb-3">
                        <label class="text-sm font-bold text-slate-200">حجم رأس المال المخصص للاستثمار:</label>
                        <span class="text-xl sm:text-2xl font-black text-amber-400 bg-amber-500/10 px-4 py-1 rounded-xl border border-amber-500/20" id="calc-amount-display">25,000 د.أ</span>
                    </div>
                    <input type="range" id="calc-amount" min="5000" max="250000" step="5000" value="25000"
                           class="w-full h-3 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-[#E8A020]" />
                    <div class="flex justify-between text-[11px] text-slate-500 mt-2 font-bold">
                        <span>5,000 د.أ (الحد الأدنى)</span>
                        <span>100,000 د.أ</span>
                        <span>250,000+ د.أ</span>
                    </div>
                </div>

                <!-- Duration / Tenure Selector -->
                <div class="mb-8">
                    <label class="text-sm font-bold text-slate-200 block mb-3">متوسط مدة الصفقات والدوران:</label>
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
                        <button type="button" class="tenure-btn active py-3 px-3 rounded-2xl bg-amber-500/20 text-amber-400 border border-amber-500/30 font-black text-xs sm:text-sm text-center transition-all" data-months="3">
                            3 أشهر (90 يوم)
                        </button>
                        <button type="button" class="tenure-btn py-3 px-3 rounded-2xl bg-white/5 text-slate-300 border border-white/5 hover:bg-white/10 font-bold text-xs sm:text-sm text-center transition-all" data-months="6">
                            6 أشهر (180 يوم)
                        </button>
                        <button type="button" class="tenure-btn py-3 px-3 rounded-2xl bg-white/5 text-slate-300 border border-white/5 hover:bg-white/10 font-bold text-xs sm:text-sm text-center transition-all" data-months="9">
                            9 أشهر (270 يوم)
                        </button>
                        <button type="button" class="tenure-btn py-3 px-3 rounded-2xl bg-white/5 text-slate-300 border border-white/5 hover:bg-white/10 font-bold text-xs sm:text-sm text-center transition-all" data-months="12">
                            12 شهر (سنة كاملة)
                        </button>
                    </div>
                </div>

                <!-- Annual Yield APR Slider -->
                <div class="mb-6">
                    <div class="flex items-center justify-between mb-3">
                        <label class="text-sm font-bold text-slate-200">معدل الربح السنوي المستهدف (APR):</label>
                        <span class="text-lg font-black text-emerald-400 bg-emerald-500/10 px-3 py-1 rounded-xl border border-emerald-500/20" id="calc-rate-display">12.0%</span>
                    </div>
                    <input type="range" id="calc-rate" min="10" max="15" step="0.5" value="12"
                           class="w-full h-3 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-emerald-500" />
                    <div class="flex justify-between text-[11px] text-slate-500 mt-2 font-bold">
                        <span>10.0% (صفقات ممتازة A+)</span>
                        <span>12.5% (متوسط السوق)</span>
                        <span>15.0% (عطاءات خاصة)</span>
                    </div>
                </div>

                <!-- Auto-Reinvestment Toggle -->
                <div class="p-4 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-xl bg-purple-500/20 text-purple-400 flex items-center justify-center">
                            <span class="material-symbols-outlined text-[20px]">autorenew</span>
                        </div>
                        <div>
                            <p class="text-xs font-bold text-white">تفعيل إعادة الاستثمار التلقائي (Auto-Reinvest)</p>
                            <p class="text-[10px] text-slate-400">توظيف الأرباح المستلمة فورياً لتحقيق العائد المركب الأقصى</p>
                        </div>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" id="calc-compound" class="sr-only peer" checked>
                        <div class="w-11 h-6 bg-slate-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#E8A020]"></div>
                    </label>
                </div>
            </div>

            <!-- Results Summary Card -->
            <div class="lg:col-span-5 bg-gradient-to-b from-[#192236] to-[#121826] border border-amber-500/30 rounded-3xl p-6 sm:p-8 shadow-[0_20px_50px_rgba(0,0,0,0.5)] relative overflow-hidden">
                <div class="absolute -top-12 -end-12 w-40 h-40 bg-amber-500/10 rounded-full blur-2xl pointer-events-none"></div>

                <h3 class="text-lg font-black text-white border-b border-white/10 pb-4 mb-6 flex items-center justify-between">
                    <span>ملخص العوائد المتوقعة</span>
                    <span class="text-xs font-bold text-amber-400 bg-amber-500/10 px-2.5 py-1 rounded-lg">تقديري استرشادي</span>
                </h3>

                <div class="space-y-4 mb-8">
                    <div class="flex justify-between items-center p-3.5 rounded-2xl bg-white/5 border border-white/5">
                        <span class="text-xs sm:text-sm text-slate-300 font-medium">صافي الأرباح المتوقعة:</span>
                        <span class="text-lg sm:text-xl font-black text-emerald-400" id="res-profit">750 د.أ</span>
                    </div>

                    <div class="flex justify-between items-center p-3.5 rounded-2xl bg-white/5 border border-white/5">
                        <span class="text-xs sm:text-sm text-slate-300 font-medium">إجمالي المبلغ المسترد:</span>
                        <span class="text-lg sm:text-xl font-black text-white" id="res-total">25,750 د.أ</span>
                    </div>

                    <div class="flex justify-between items-center p-3.5 rounded-2xl bg-white/5 border border-white/5">
                        <span class="text-xs sm:text-sm text-slate-300 font-medium">التدفق الربحي الشهري:</span>
                        <span class="text-base sm:text-lg font-bold text-sky-400" id="res-monthly">250 د.أ / شهر</span>
                    </div>

                    <div class="flex justify-between items-center p-3.5 rounded-2xl bg-amber-500/10 border border-amber-500/20">
                        <span class="text-xs sm:text-sm text-amber-300 font-bold">معدل العائد الداخلي الفعلي (IRR):</span>
                        <span class="text-lg font-black text-amber-400" id="res-irr">12.55%</span>
                    </div>
                </div>

                <a href="/Shop/Financing/InvestorJoin" class="w-full py-4 rounded-2xl bg-[#E8A020] hover:bg-amber-400 text-slate-950 font-black text-center text-sm sm:text-base transition-all shadow-lg block">
                    ابدأ الاستثمار وتفعيل المحفظة
                </a>

                <p class="text-[10px] text-slate-400 text-center mt-3 leading-tight">
                    * الحسابات مبنية على متوسط أرباح المرابحة ونظام التوزيع الدوري وتخضع لشروط عقود الوكالة المعتمدة.
                </p>
            </div>
        </div>
    </section>

    <!-- Guarantees & Risk Management -->
    <section class="py-16 bg-[#0E131F] border-t border-b border-white/5">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-16">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-sky-500/10 text-sky-400 border border-sky-500/20 text-xs font-bold mb-3">
                    <span class="material-symbols-outlined text-[16px]">security</span>
                    <span>شبكة الحماية والضمانات الثلاثية</span>
                </div>
                <h2 class="text-2xl sm:text-4xl font-black text-white mb-4">أموالك محمية بأصول مادية وسندات قانونية</h2>
                <p class="text-slate-400 text-sm sm:text-base">نحن لا نقرض أموالاً نقدية، بل نشتري مواد بناء حقيقية ونسلمها بموقع العمل وفق تدقيق ائتماني صارم.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Guarantee 1 -->
                <div class="p-8 rounded-3xl bg-white/5 border border-white/10 hover:border-amber-500/40 transition-all relative group">
                    <div class="w-14 h-14 rounded-2xl bg-amber-500/20 text-amber-400 flex items-center justify-center mb-6 text-3xl font-black">
                        <span class="material-symbols-outlined text-[32px]">gavel</span>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3">1. سندات لأمر قضائية وتنفيذية</h3>
                    <p class="text-slate-400 text-sm leading-relaxed">
                        توقيع سندات لأمر إلكترونية معتمدة قابلة للتنفيذ المباشر لدى دوائر التنفيذ القضائي تغطي أصل التمويل وهامش المرابحة بالكامل.
                    </p>
                </div>

                <!-- Guarantee 2 -->
                <div class="p-8 rounded-3xl bg-white/5 border border-white/10 hover:border-sky-500/40 transition-all relative group">
                    <div class="w-14 h-14 rounded-2xl bg-sky-500/20 text-sky-400 flex items-center justify-center mb-6 text-3xl font-black">
                        <span class="material-symbols-outlined text-[32px]">pin_drop</span>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3">2. إثبات التسليم الرقمي (GPS POD)</h3>
                    <p class="text-slate-400 text-sm leading-relaxed">
                        لا يتم صرف مستحقات التوريد إلا بعد توثيق وصول الشاحنات لموقع المقاول عبر البصمة الجغرافية وصور المواد المفرغة وتوقيع المهندس.
                    </p>
                </div>

                <!-- Guarantee 3 -->
                <div class="p-8 rounded-3xl bg-white/5 border border-white/10 hover:border-emerald-500/40 transition-all relative group">
                    <div class="w-14 h-14 rounded-2xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center mb-6 text-3xl font-black">
                        <span class="material-symbols-outlined text-[32px]">query_stats</span>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3">3. الاستعلام الائتماني (CRIF Jordan)</h3>
                    <p class="text-slate-400 text-sm leading-relaxed">
                        فحص السجل الائتماني للمقاول وملاءته المالية عبر شركة كريف الأردن وتحديد سقف ائتماني دقيق قبل قبول أي عطاء.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Sharia Compliance & Possession Flow -->
    <section class="py-16 lg:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-gradient-to-br from-[#151D2E] to-[#101624] border border-white/10 rounded-3xl p-8 sm:p-12 shadow-2xl">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
                <div class="lg:col-span-7">
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-xs font-bold mb-4">
                        <span class="material-symbols-outlined text-[16px]">verified_user</span>
                        <span>معايير الأيوفي (AAOIFI) والرقابة الشرعية</span>
                    </div>
                    <h2 class="text-2xl sm:text-4xl font-black text-white mb-6">القبض والتملك الحقيقي للمواد قبل بيعها</h2>
                    <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-6">
                        تعتمد منصة بلكو هيكل المرابحة الشرعية الحقيقية؛ حيث يقوم المستثمر (أو المنصة كوكيل بالاستثمار) بشراء مواد البناء من المورد المعتمد وتملكها وقبضها حكماً أو فعلياً، ثم إعادة بيعها للمقاول بربح معلوم وأقساط ميسرة.
                    </p>
                    <div class="space-y-3 text-sm text-slate-300 font-medium">
                        <div class="flex items-center gap-3">
                            <span class="material-symbols-outlined text-emerald-400 text-[20px]">check_circle</span>
                            <span>عقد وكالة شرعية إلكتروني موثق لكل عملية تمويل.</span>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="material-symbols-outlined text-emerald-400 text-[20px]">check_circle</span>
                            <span>إصدار إشعار تملك وقبض حكمي وتعيين البضاعة في المستودع.</span>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="material-symbols-outlined text-emerald-400 text-[20px]">check_circle</span>
                            <span>تحريم بيع العينة أو الفائدة الربوية؛ الربح ناتج عن التجارة الحقيقية.</span>
                        </div>
                    </div>
                </div>

                <div class="lg:col-span-5 bg-white/5 border border-white/10 rounded-2xl p-6 text-center">
                    <div class="w-16 h-16 rounded-2xl bg-amber-500/20 text-amber-400 flex items-center justify-center mx-auto mb-4">
                        <span class="material-symbols-outlined text-[36px]">menu_book</span>
                    </div>
                    <h4 class="text-lg font-bold text-white mb-2">اعتماد الهيئة الشرعية</h4>
                    <p class="text-xs text-slate-400 leading-relaxed mb-6">
                        تمت مراجعة واعتماد عقود الوكالة ونماذج المرابحة والقبض الحكمي من قبل هيئة رقابة شرعية متخصصة في المعاملات المالية الإسلامية.
                    </p>
                    <a href="/Shop/Financing/InvestorJoin" class="w-full py-3 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-xs sm:text-sm transition-all border border-white/10 block">
                        انضم لمنظومة التمويل الإسلامي
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Active Deals Teaser -->
    @if (Model != null && Model.Any())
    {
        <section class="py-16 bg-[#0D111A] border-t border-white/5">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex flex-col sm:flex-row items-center justify-between mb-10 gap-4">
                    <div>
                        <h2 class="text-2xl sm:text-3xl font-black text-white">فرص تمويلية نشطة ومتاحة الآن</h2>
                        <p class="text-slate-400 text-sm mt-1">عطاءات مواد بناء قيد الانتظار لمقاولين معتمدين جاهزة للتمويل الفوري.</p>
                    </div>
                    <a href="/Shop/Financing" class="px-5 py-2.5 rounded-xl bg-white/5 hover:bg-white/10 text-amber-400 font-bold text-sm border border-amber-500/30 transition-all flex items-center gap-2">
                        <span>تصفح كافة العطاءات</span>
                        <span class="material-symbols-outlined text-[16px] rtl:-scale-x-100">arrow_forward</span>
                    </a>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    @foreach (var tender in Model.Take(3))
                    {
                        <div class="bg-[#151B28] border border-white/10 rounded-2xl p-6 hover:border-amber-500/40 transition-all flex flex-col justify-between">
                            <div>
                                <div class="flex items-center justify-between mb-4">
                                    <span class="text-xs font-bold px-2.5 py-1 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                                        تصنيف المقاول: A+
                                    </span>
                                    <span class="text-xs text-slate-400 font-mono">@tender.TrackingCode</span>
                                </div>
                                <h3 class="text-lg font-bold text-white mb-2 line-clamp-1">@tender.ProjectTitle</h3>
                                <p class="text-xs text-slate-400 mb-4 flex items-center gap-1.5">
                                    <span class="material-symbols-outlined text-[16px] text-amber-400">location_on</span>
                                    <span>@tender.ProjectCity</span>
                                </p>
                                <div class="grid grid-cols-2 gap-3 p-3 rounded-xl bg-white/5 text-xs mb-6">
                                    <div>
