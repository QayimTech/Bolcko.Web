@model Bolcko.Domain.Entities.Financing.DTOs.FinancingTenderDto
@{
    ViewData["Title"] = $"إثبات تسليم المواد للموقع | {Model.TrackingCode}";
    Layout = "~/Areas/Shop/Views/Shared/_Layout.cshtml";
    var isArabic = true;
}

<div class="max-w-xl mx-auto px-4 py-8" dir="rtl">
    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-xl space-y-6 text-start">
        
        <div class="flex items-center justify-between border-b border-slate-100 pb-4">
            <div>
                <div class="text-[10px] text-slate-400 font-bold uppercase">إثبات التسليم الموقعي (GPS POD)</div>
                <h1 class="text-lg font-black text-slate-900">@Model.ProjectTitle</h1>
            </div>
            <span class="text-xs font-mono font-bold text-amber-600 bg-amber-50 px-2.5 py-1 rounded-lg border border-amber-200">@Model.TrackingCode</span>
        </div>

        <!-- Project Location Info -->
        <div class="bg-slate-50 p-4 rounded-2xl border border-slate-100 space-y-2 text-xs">
            <div class="flex items-center justify-between">
                <span class="text-slate-500">الموقع المسجل للرخصة:</span>
                <span class="font-bold text-slate-800">@Model.ProjectCity</span>
            </div>
            <div class="flex items-center justify-between">
                <span class="text-slate-500">المقاول المستلم:</span>
                <span class="font-bold text-slate-800">@Model.ContractorName (@Model.ContractorPhone)</span>
            </div>
            <div class="flex items-center justify-between">
                <span class="text-slate-500">رقم رخصة البناء:</span>
                <span class="font-mono font-bold text-slate-800">@Model.BuildingPermitNumber</span>
            </div>
        </div>

        <!-- Live GPS Status -->
        <div class="p-4 rounded-2xl border border-slate-200 bg-amber-50/40 space-y-2">
            <div class="flex items-center justify-between text-xs font-bold text-slate-800">
                <span class="flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-base text-amber-600">my_location</span>
                    <span>تحديد موقع السائق المباشر (GPS):</span>
                </span>
                <span id="gpsStatusBadge" class="text-[10px] bg-slate-200 text-slate-700 px-2 py-0.5 rounded">جاري القراءة...</span>
            </div>
            <div id="gpsCoordinatesText" class="text-[11px] font-mono text-slate-500">يرجى السماح بالوصول للموقع في المتصفح</div>
        </div>

        <!-- Driver Input Fields -->
        <div class="space-y-4 text-xs">
            <div class="space-y-1">
                <label class="font-bold text-slate-700 block">اسم سائق الشاحنة المعتمد:</label>
                <input type="text" id="driverName" value="@(User.Identity?.IsAuthenticated == true ? User.Identity.Name : "")" placeholder="مثال: أحمد محمود" class="w-full p-3 rounded-xl border border-slate-200 bg-white text-slate-900 focus:outline-none focus:border-amber-500" />
            </div>

            <div class="space-y-1">
                <label class="font-bold text-slate-700 block">رقم هاتف السائق:</label>
                <input type="tel" id="driverPhone" placeholder="07XXXXXXXX" class="w-full p-3 rounded-xl border border-slate-200 bg-white text-slate-900 font-mono focus:outline-none focus:border-amber-500" />
            </div>

            <div class="space-y-1">
                <label class="font-bold text-slate-700 block">رقم لوحة الشاحنة / ونش التوريد:</label>
                <input type="text" id="vehiclePlate" placeholder="مثال: 12-34567" class="w-full p-3 rounded-xl border border-slate-200 bg-white text-slate-900 font-mono focus:outline-none focus:border-amber-500" />
            </div>

            <div class="space-y-1">
                <label class="font-bold text-slate-700 flex items-center justify-between">
                    <span>رمز الاستلام السري الموقعي (Contractor 6-Digit OTP):</span>
                    <span class="text-[10px] text-amber-600 font-normal">اطلبه من مهندس / مقاول الورشة</span>
                </label>
                <div class="relative">
                    <input type="text" id="deliveryOtpCode" maxlength="6" placeholder="مثال: 582910" class="w-full p-3.5 rounded-xl border-2 border-amber-300 bg-amber-50/50 text-slate-900 font-mono text-center tracking-[0.4em] font-black text-lg focus:outline-none focus:border-amber-600 focus:bg-white transition-all shadow-inner" />
                </div>
                <p class="text-[10px] text-slate-500">لا يتم تحرير أموال الضمان للمورد أو تفعيل العقد إلا بعد التحقق من الرمز الصحيح.</p>
            </div>

            <div class="space-y-1">
                <label class="font-bold text-slate-700 block">صورة حية لتفريغ المواد في الورشة (Photo Proof):</label>
                <input type="file" id="podPhotoInput" accept="image/*" capture="camera" onchange="previewPodPhoto(this)" class="w-full text-xs text-slate-500 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-slate-900 file:text-white hover:file:bg-amber-600 cursor-pointer" />
                <div id="photoPreviewContainer" class="hidden mt-2">
                    <img id="photoPreviewImg" src="" alt="Live Preview" class="w-full h-40 object-cover rounded-xl border border-slate-200" />
                </div>
            </div>
        </div>

        <!-- Submit Button -->
        <button type="button" id="submitPodBtn" onclick="submitPodVerification(@Model.Id)" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3.5 px-4 rounded-xl text-sm transition-all shadow-md flex items-center justify-center gap-2 cursor-pointer active:scale-95">
            <span class="material-symbols-outlined">verified</span>
            <span>تأكيد التسليم الموقعي بالـ OTP ونقل الضمان</span>
        </button>

    </div>
</div>

@section Scripts {
<script>
    let driverLat = 0;
    let driverLon = 0;
    let podPhotoBase64 = "";

    function previewPodPhoto(input) {
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                podPhotoBase64 = e.target.result;
                document.getElementById('photoPreviewImg').src = podPhotoBase64;
                document.getElementById('photoPreviewContainer').classList.remove('hidden');
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        if ("geolocation" in navigator) {
            navigator.geolocation.getCurrentPosition((pos) => {
                driverLat = pos.coords.latitude;
                driverLon = pos.coords.longitude;
                document.getElementById('gpsStatusBadge').className = "text-[10px] bg-emerald-100 text-emerald-800 font-bold px-2 py-0.5 rounded";
                document.getElementById('gpsStatusBadge').innerText = "تم التقاط الإحداثيات ✓";
                document.getElementById('gpsCoordinatesText').innerText = `Lat: ${driverLat.toFixed(5)}, Lon: ${driverLon.toFixed(5)}`;
            }, (err) => {
                document.getElementById('gpsStatusBadge').className = "text-[10px] bg-red-100 text-red-800 font-bold px-2 py-0.5 rounded";
                document.getElementById('gpsStatusBadge').innerText = "تعذر قراءة الموقع";
                document.getElementById('gpsCoordinatesText').innerText = "يرجى تفعيل الـ GPS في هاتفك والموافقة على الصلاحية.";
            }, { enableHighAccuracy: true });
        }
    });

    async function submitPodVerification(tenderId) {
        const driver = document.getElementById('driverName')?.value?.trim();
        const phone = document.getElementById('driverPhone')?.value?.trim() || '0790000000';
        const plate = document.getElementById('vehiclePlate')?.value?.trim();
        const otp = document.getElementById('deliveryOtpCode')?.value?.trim();

        if (!driver || !plate) {
            alert('يرجى إدخال اسم السائق ورقم لوحة الشاحنة.');
            return;
        }

        const btn = document.getElementById('submitPodBtn');
        btn.disabled = true;
        btn.innerHTML = '<span class="material-symbols-outlined animate-spin text-sm">progress_activity</span> <span>جاري التحقق من رمز OTP وإحداثيات الموقع...</span>';

        try {
            const res = await fetch('/Shop/Financing/SubmitPOD', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    tenderId: tenderId,
                    driverName: driver,
                    driverPhone: phone,
                    vehiclePlateNumber: plate,
                    driverLatitude: driverLat,
                    driverLongitude: driverLon,
                    deliveryOtpCode: otp,
                    photoUrl: podPhotoBase64 || '/images/pod-verified.jpg'
                })
            });

            const data = await res.json();
            alert(data.message || (data.success ? 'تم تسجيل التسليم وتحرير الضمان بنجاح.' : 'تعذر التحقق.'));
            if (data.success) {
                window.location.href = `/Shop/Financing/Details/${tenderId}`;
            }
        } catch (e) {
            console.error(e);
            alert('حدث خطأ أثناء معالجة إثبات التوصيل.');
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<span class="material-symbols-outlined">verified</span> <span>تأكيد التسليم الموقعي بالـ OTP ونقل الضمان</span>';
        }
    }
</script>
}
