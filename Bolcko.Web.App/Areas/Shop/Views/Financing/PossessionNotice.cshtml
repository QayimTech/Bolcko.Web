@model Bolcko.Domain.Entities.Financing.DTOs.FinancingTenderDto
@{
    Layout = null; // Standalone printable Sharia constructive possession certificate
    var hash = Model != null 
        ? Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes((Model.TrackingCode ?? "") + Model.BaseMaterialCost + (Model.FundedAt?.ToString("o") ?? Model.CreatedAt.ToString("o")) + "POSSESSION"))).Substring(0, 16)
        : "UNVERIFIED-BLOCKO";
    var appHost = Context.Request.Scheme + "://" + Context.Request.Host.Value;
    var verifyUrl = Model != null ? $"{appHost}/Shop/Financing/Verify?code={Model.TrackingCode}" : $"{appHost}/Shop/Financing/Verify";
    var qrCodeUrl = $"https://api.qrserver.com/v1/create-qr-code/?size=180x180&data={Uri.EscapeDataString(verifyUrl)}";

    string funderDisplayName = "المستثمر الممول المعتمد";
    if (!string.IsNullOrWhiteSpace(Model?.FunderName))
    {
        if (Model.FunderName.Contains("@"))
        {
            funderDisplayName = "المستثمر الممول (" + Model.FunderName.Split('@')[0] + ")";
        }
        else
        {
            funderDisplayName = Model.FunderName;
        }
    }
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>شهادة القبض والتملك الحكمي الشرعي - @(Model?.TrackingCode ?? "BLOCKO") - Block-O FinTech</title>
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/material-symbols.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700;800&display=swap" />
    <style>
        body { font-family: 'Tajawal', sans-serif; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
        .font-mono { font-family: 'JetBrains Mono', monospace; }
        
        @@page {
            size: A4 portrait;
            margin: 10mm 12mm 10mm 12mm;
        }
        
        @@media print {
            .no-print, nav, header.screen-only, footer.screen-only { display: none !important; }
            body { background: #ffffff !important; color: #000000 !important; padding: 0 !important; margin: 0 !important; }
            .certificate-paper {
                box-shadow: none !important;
                border: 1px solid #cbd5e1 !important;
                margin: 0 !important;
                width: 100% !important;
                max-width: 100% !important;
                padding: 18px !important;
                background: #ffffff !important;
                color: #0f172a !important;
                border-radius: 0 !important;
            }
            .page-break-avoid {
                break-inside: avoid;
                page-break-inside: avoid;
            }
        }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen py-8 px-4 sm:px-6 lg:px-8">

    <!-- Action Toolbar (Hidden in Print) -->
    <header class="screen-only max-w-4xl mx-auto mb-6 flex flex-wrap items-center justify-between gap-4 no-print bg-slate-950/80 backdrop-blur-md p-4 rounded-2xl border border-white/10 shadow-xl">
        <a href="/Shop/Financing/Contract/@Model?.TrackingCode" class="inline-flex items-center gap-2 text-xs sm:text-sm font-bold text-slate-300 hover:text-amber-400 transition-colors">
            <span class="material-symbols-outlined text-base">arrow_forward</span>
            <span>العودة إلى عقد المرابحة الكامل</span>
        </a>
        <div class="flex items-center gap-2.5 flex-wrap">
            <a href="/Shop/Financing/Verify?code=@Model?.TrackingCode" target="_blank" class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs border border-white/10 transition-all flex items-center gap-1.5 shadow-sm">
                <span class="material-symbols-outlined text-sm text-sky-400">qr_code_scanner</span>
                <span>فحص الختم والتوثيق</span>
            </a>
            <button onclick="window.print()" class="px-4 py-2 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-white font-black text-xs shadow-lg shadow-emerald-500/20 transition-all flex items-center gap-1.5 cursor-pointer active:scale-95">
                <span class="material-symbols-outlined text-base">print</span>
                <span>طباعة الشهادة الرسمية (A4 / PDF)</span>
            </button>
        </div>
    </header>

    @if (Model == null)
    {
        <div class="max-w-md mx-auto text-center py-16 bg-slate-950 rounded-3xl border border-white/10 p-8 shadow-2xl">
            <span class="material-symbols-outlined text-5xl text-rose-500 mb-4">error</span>
            <h2 class="text-lg font-bold text-white mb-2">شهادة القبض غير متوفرة</h2>
            <p class="text-xs text-slate-400 mb-6">يرجى التأكد من صحة رمز التتبع والمحاولة مجدداً.</p>
            <a href="/Shop/Financing" class="px-5 py-2.5 bg-amber-500 text-slate-950 font-bold rounded-xl text-xs">الانتقال لبوابة المرابحة</a>
        </div>
    }
    else
    {
        <!-- Official Institutional Certificate Container -->
        <main class="certificate-paper max-w-4xl mx-auto bg-white text-slate-900 border border-slate-200 rounded-3xl p-8 sm:p-12 shadow-2xl relative overflow-hidden">
            
            <!-- Background Watermark -->
            <div class="absolute inset-0 flex items-center justify-center opacity-[0.03] pointer-events-none select-none z-0">
                <span class="text-9xl font-black rotate-[-25deg] tracking-widest text-slate-950">AAOIFI POSSESSION</span>
            </div>

            <div class="relative z-10 space-y-6">
                <!-- Header / Institutional Letterhead -->
                <header class="border-b-2 border-slate-900 pb-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
                    <div class="flex items-center gap-4">
                        <div class="w-16 h-16 rounded-2xl bg-emerald-950 text-emerald-400 flex flex-col items-center justify-center font-black p-2 border border-emerald-800 shadow-sm shrink-0">
                            <span class="text-xs tracking-widest leading-none">SHARIA</span>
                            <span class="material-symbols-outlined text-2xl text-emerald-400 mt-0.5">verified_user</span>
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <h2 class="text-lg sm:text-xl font-black tracking-tight text-slate-950">هيئة الرقابة والتوثيق الشرعي - منصة بلوكو</h2>
                                <span class="px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 border border-emerald-300 text-[10px] font-black font-mono">CONSTRUCTIVE POSSESSION</span>
                            </div>
                            <p class="text-xs font-bold text-slate-600 mt-0.5">شهادة وإشعار دخول المبيع في ضمان وتملك المشتري (المستثمر الممول)</p>
                            <p class="text-[11px] text-slate-500 font-medium">محررة طبقاً للمعيار الشرعي للمرابحة رقم (8) الصادر عن هيئة (AAOIFI) الدولية</p>
                        </div>
                    </div>

                    <!-- Ref Badge & Dynamic QR Code -->
                    <div class="flex items-center gap-3 self-end sm:self-auto bg-slate-50 border border-slate-200 rounded-2xl p-2.5 shadow-2xs">
                        <div class="text-start">
                            <span class="text-[10px] font-bold text-slate-500 block">رقم شهادة القبض:</span>
                            <span class="font-mono text-sm font-black text-emerald-700 block">POS-@Model.TrackingCode</span>
                            <span class="text-[10px] text-slate-500 block mt-0.5">التاريخ: @(Model.FundedAt?.ToString("yyyy/MM/dd HH:mm") ?? Model.CreatedAt.ToString("yyyy/MM/dd HH:mm")) UTC</span>
                        </div>
                        <img src="@qrCodeUrl" alt="QR Verification" class="w-14 h-14 border border-slate-300 rounded-lg p-0.5 bg-white shrink-0" />
                    </div>
                </header>

                <!-- Document Title -->
                <section class="text-center py-2 border-b border-slate-100">
                    <span class="inline-block px-3 py-1 rounded-full bg-emerald-100 text-emerald-900 text-xs font-bold mb-2">إثبات شرعي ملزم لضمان وتملك السلعة</span>
                    <h1 class="text-xl sm:text-2xl font-black text-slate-950 tracking-tight">شهادة وإشعار القبض الحكمي ودخول البضاعة في ضمان المستثمر</h1>
                    <p class="text-xs font-semibold text-slate-600 mt-1 max-w-2xl mx-auto leading-relaxed">
                        تشهد منصة بلوكو (بصفتها وكيلاً بالشراء وقابضاً للأعيان) بأن المواد الإنشائية المبينة تفاصيلها أدناه قد تم شراؤها عيناً وتعيينها وفرزها وقبضها حكماً لحساب المستثمر، ودخلت في ضمانه الشرعي التام قبل إبرام عقد بيع المرابحة للآمر بالشراء.
                    </p>
                </section>

                <!-- Verification Data Grid -->
                <section class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs page-break-avoid">
                    <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 space-y-1.5 shadow-2xs">
                        <span class="text-slate-500 block font-bold text-[11px]">المستثمر المالك الأصلي (الموكل):</span>
                        <p class="text-slate-950 font-black text-sm">@funderDisplayName</p>
                        <p class="text-emerald-700 font-mono text-[11px] font-bold">صفقة مرابحة: #@Model.TrackingCode</p>
                    </div>

                    <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 space-y-1.5 shadow-2xs">
                        <span class="text-slate-500 block font-bold text-[11px]">موقع القبض والفرز والتخزين:</span>
                        <p class="text-slate-950 font-bold text-xs">مستودعات ومصانع التوريد المعتمدة</p>
                        <p class="text-slate-600 text-[11px]">الوجهة: @Model.ProjectCity - @Model.ProjectTitle</p>
                    </div>

                    <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 space-y-1.5 shadow-2xs">
                        <span class="text-slate-500 block font-bold text-[11px]">القيمة الإجمالية المقبوضة:</span>
                        <p class="font-mono text-emerald-800 font-black text-base">@Model.BaseMaterialCost.ToString("N2") د.أ</p>
                        <p class="text-[10px] text-slate-500 font-semibold">شامل الفحص والمطابقة الميدانية</p>
                    </div>
                </section>

                <!-- Material Schedule Table -->
                <section class="space-y-3 page-break-avoid">
                    <h3 class="text-xs font-black text-slate-900 uppercase tracking-wider flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
                        <span>تفاصيل المواد الإنشائية المفرزة والمقبوضة شرعاً</span>
                    </h3>
                    
                    <div class="overflow-x-auto border border-slate-300 rounded-2xl">
                        <table class="w-full text-start text-xs border-collapse">
                            <thead class="bg-slate-100 text-slate-700 font-bold border-b border-slate-300">
                                <tr>
                                    <th class="p-2.5 text-center w-10 border-e border-slate-200">#</th>
                                    <th class="p-2.5 text-start border-e border-slate-200">المادة والمواصفات الفنية</th>
                                    <th class="p-2.5 text-center border-e border-slate-200">الكمية المقبوضة</th>
                                    <th class="p-2.5 text-center border-e border-slate-200">حالة الفحص والمطابقة</th>
                                    <th class="p-2.5 text-end">القيمة الإجمالية (د.أ)</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-200 font-medium">
                                @if (Model.Items != null && Model.Items.Any())
                                {
                                    int idx = 1;
                                    foreach (var it in Model.Items)
                                    {
                                        <tr class="hover:bg-slate-50/80">
                                            <td class="p-2.5 text-center font-mono text-slate-500 border-e border-slate-200">@(idx++)</td>
                                            <td class="p-2.5 font-bold text-slate-900 border-e border-slate-200">@it.MaterialName <span class="text-slate-500 text-[11px] font-normal">(@it.MaterialCategory)</span></td>
                                            <td class="p-2.5 text-center font-mono font-bold text-slate-900 border-e border-slate-200">@it.Quantity.ToString("N1") @it.Unit</td>
                                            <td class="p-2.5 text-center border-e border-slate-200">
                                                <span class="inline-flex items-center gap-1 text-emerald-700 font-bold text-[11px]">
                                                    <span class="material-symbols-outlined text-xs">check_circle</span>
                                                    <span>مقبوضة ومفرزة ومطابقة للمواصفة</span>
                                                </span>
                                            </td>
                                            <td class="p-2.5 font-mono font-bold text-end text-slate-950">@it.SubtotalJod.ToString("N2")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                            <tfoot class="bg-slate-50 border-t border-slate-300 font-bold">
                                <tr>
                                    <td colspan="4" class="p-2.5 text-end text-slate-700">إجمالي قيمة الأصول والمواد في ضمان المستثمر:</td>
                                    <td class="p-2.5 text-end font-mono font-black text-emerald-800 text-sm">@Model.BaseMaterialCost.ToString("N2") د.أ</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </section>

                <!-- Sharia Provisions -->
                <section class="space-y-2 page-break-avoid text-[11px] text-slate-600 leading-relaxed">
                    <h3 class="text-xs font-black text-slate-900 uppercase tracking-wider flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
                        <span>الأحكام والضوابط الشرعية والقانونية للقبض الحكمي</span>
                    </h3>
                    <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 space-y-2">
                        <p><strong>1. تحقق القبض والتملك:</strong> يعتبر إصدار هذه الشهادة إشعاراً قطعياً بتحقق القبض الحكمي للسلعة وفقاً لمعايير AAOIFI، حيث تم فرز البضاعة وتخصيصها برقم التتبع الإلكتروني المذكور وسداد ثمنها للمصنع/المورد الأصلي.</p>
                        <p><strong>2. انتقال وتحمل الضمان:</strong> تتحمل محفظة المستثمر الممول تبعة هلاك البضاعة وتلفها طوال فترة بقائها بحوزة الوكيل وحتى تسليمها الفعلي للمقاول بموقع العمل الموثق بنظام الـ GPS POD.</p>
                        <p><strong>3. جواز إبرام عقد المرابحة:</strong> بناءً على هذا القبض الحكمي الناجز والتملك العيني، أصبح بيع المرابحة للآمر بالشراء صحيحاً ونافذاً شرعاً وخالياً من بيع الكالئ بالكالئ أو بيع ما لا يملك.</p>
                    </div>
                </section>

                <!-- Institutional Signatures & Digital Seal -->
                <footer class="border-t-2 border-slate-900 pt-6 grid grid-cols-1 sm:grid-cols-3 gap-6 text-xs page-break-avoid">
                    <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 text-center space-y-1.5 shadow-2xs">
                        <span class="text-slate-500 block font-bold text-[11px]">المطابقة الميدانية والفرز:</span>
                        <p class="text-slate-950 font-black text-sm">إدارة الجودة والتوريدات</p>
                        <div class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800 text-[10px] font-bold font-mono">
                            <span class="material-symbols-outlined text-[14px]">done_all</span>
                            <span>INSPECTED & ALLOCATED</span>
                        </div>
                    </div>

                    <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 text-center space-y-1.5 shadow-2xs">
                        <span class="text-slate-500 block font-bold text-[11px]">أمين الوكالة والتنفيذ:</span>
                        <p class="text-slate-950 font-black text-sm">شركة منصة بلوكو ذ.م.م</p>
                        <div class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-sky-100 text-sky-800 text-[10px] font-bold font-mono">
                            <span class="material-symbols-outlined text-[14px]">shield</span>
                            <span>ESCROW CUSTODIAN</span>
                        </div>
                    </div>

                    <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 text-center space-y-1.5 shadow-2xs">
                        <span class="text-slate-500 block font-bold text-[11px]">الختم الرقمي للشهادة:</span>
                        <p class="font-mono text-[10px] font-bold text-slate-800 break-all leading-none pt-1">@hash</p>
                        <div class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-purple-100 text-purple-800 text-[10px] font-bold font-mono">
                            <span class="material-symbols-outlined text-[14px]">verified</span>
                            <span>AAOIFI POSSESSION SEAL</span>
                        </div>
                    </div>
                </footer>

                <!-- Bottom Document Meta -->
                <div class="border-t border-slate-200 pt-3 flex items-center justify-between text-[10px] text-slate-400 font-mono">
                    <span>Block-O Sharia & Legal Tech Engine v2.6</span>
                    <span>شهادة رسمية موثقة ومعتمدة للجهات الرقابية والمحاكم</span>
                    <span>الصفحة 1 من 1</span>
                </div>
            </div>
        </main>
    }

    <footer class="screen-only max-w-4xl mx-auto mt-6 text-center text-xs text-slate-400 no-print">
        منصة بلوكو للتوريدات الإنشائية وعقود المرابحة © @DateTime.UtcNow.Year - جميع الحقوق محفوظة
    </footer>
</body>
</html>
