@model Bolcko.Domain.Entities.Financing.DTOs.FinancingTenderDto
@{
    Layout = null; // Standalone printable Sharia constructive possession document
    var hash = Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(Model.TrackingCode + Model.BaseMaterialCost + (Model.FundedAt?.ToString("o") ?? Model.CreatedAt.ToString("o"))))).Substring(0, 16);
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>شهادة القبض والتملك الحكمي الشرعي - @Model.TrackingCode - Block-O</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&family=JetBrains+Mono:wght@500;700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
    <style>
        body { font-family: 'Tajawal', sans-serif; }
        .font-mono { font-family: 'JetBrains Mono', monospace; }
        @@media print {
            .no-print { display: none !important; }
            body { background: white !important; color: black !important; }
            .print-border { border-color: #cbd5e1 !important; }
            .page-break { page-break-after: always; }
        }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen py-8 px-4 sm:px-6 lg:px-8">

    <!-- Action Toolbar (Hidden in Print) -->
    <div class="max-w-4xl mx-auto mb-6 flex items-center justify-between no-print">
        <a href="/Shop/Financing/Contract/@Model.TrackingCode" class="inline-flex items-center gap-2 text-sm font-bold text-slate-400 hover:text-white transition-colors">
            <span class="material-symbols-outlined text-sm">arrow_forward</span>
            <span>العودة إلى عقد المرابحة الكامل</span>
        </a>
        <div class="flex items-center gap-3">
            <button onclick="window.print()" class="px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm shadow-lg shadow-emerald-900/30 transition-all flex items-center gap-2 cursor-pointer">
                <span class="material-symbols-outlined text-sm">print</span>
                <span>طباعة الشهادة / حفظ PDF</span>
            </button>
        </div>
    </div>

    <!-- Official Legal Document Container -->
    <main class="max-w-4xl mx-auto bg-slate-950 border border-white/10 rounded-2xl p-8 sm:p-12 shadow-2xl relative overflow-hidden print-border print:bg-white print:text-black">
        
        <!-- Header / Letterhead -->
        <header class="border-b border-white/10 pb-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 print:border-slate-300">
            <div>
                <div class="flex items-center gap-3">
                    <span class="text-2xl font-black tracking-tight text-white print:text-black">BLOCK<span class="text-emerald-500 font-extrabold">-O</span></span>
                    <span class="px-2.5 py-1 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-xs font-bold font-mono">CONSTRUCTIVE POSSESSION CERTIFICATE</span>
                </div>
                <p class="text-xs text-slate-400 mt-1 print:text-slate-600">هيئة الرقابة الشرعية وإدارة المخاطر والتوثيق الميداني</p>
                <p class="text-[11px] text-slate-500 print:text-slate-500">معتمد طبقاً لمعيار المرابحة رقم (8) الصادر عن هيئة المحاسبة والمراجعة للمؤسسات المالية الإسلامية (AAOIFI)</p>
            </div>

            <div class="text-start sm:text-end">
                <div class="inline-block bg-slate-900 border border-white/10 rounded-xl px-4 py-2 print:bg-slate-100 print:border-slate-300">
                    <span class="text-[10px] text-slate-400 block print:text-slate-500">رقم إشعار القبض المرجعي</span>
                    <span class="font-mono text-sm font-bold text-emerald-400 print:text-black">POS-@Model.TrackingCode</span>
                </div>
                <p class="text-[11px] text-slate-400 mt-1.5 font-mono print:text-slate-600">
                    تاريخ التملك والحيازة: @(Model.FundedAt?.ToString("yyyy/MM/dd HH:mm") ?? Model.CreatedAt.ToString("yyyy/MM/dd HH:mm")) UTC
                </p>
            </div>
        </header>

        <!-- Document Title -->
        <section class="text-center my-8">
            <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 mb-3">
                <span class="material-symbols-outlined text-3xl">verified_user</span>
            </div>
            <h1 class="text-xl sm:text-2xl font-black text-white print:text-black">إشعار وشهادة القبض الحكمي ودخول البضاعة في ضمان المستثمر</h1>
            <p class="text-xs text-slate-400 mt-1.5 max-w-xl mx-auto print:text-slate-600">
                تشهد منصة بلوكو (بصفتها وكيلاً بالشراء) بأن المواد الإنشائية المبينة أدناه قد تم شراؤها وتعيينها وفرزها وقبضها حكماً لحساب المستثمر، ودخلت في ضمانه الشرعي قبل إبرام عقد بيع المرابحة للآمر بالشراء.
            </p>
        </section>

        <!-- Verification Data Box -->
        <section class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
            <div class="bg-slate-900/60 border border-white/5 rounded-xl p-4 print:bg-slate-50 print:border-slate-200">
                <span class="text-slate-400 block font-bold text-[11px] mb-1 print:text-slate-700">المستثمر المالك (الموكل):</span>
                <p class="text-white font-bold text-xs print:text-black">@(string.IsNullOrWhiteSpace(Model.FunderName) ? "المستثمر الممول" : Model.FunderName)</p>
                <p class="text-emerald-400 font-mono text-[11px] mt-1">صفقة تمويل: #@Model.TrackingCode</p>
            </div>

            <div class="bg-slate-900/60 border border-white/5 rounded-xl p-4 print:bg-slate-50 print:border-slate-200">
                <span class="text-slate-400 block font-bold text-[11px] mb-1 print:text-slate-700">موقع القبض والفرز والتخزين:</span>
                <p class="text-white font-bold text-xs print:text-black">مستودعات ومصانع التوريد المعتمدة</p>
                <p class="text-slate-400 text-[11px] mt-1 print:text-slate-600">الموقع الجغرافي: @Model.ProjectCity - @Model.ProjectTitle</p>
            </div>

            <div class="bg-slate-900/60 border border-white/5 rounded-xl p-4 print:bg-slate-50 print:border-slate-200">
                <span class="text-slate-400 block font-bold text-[11px] mb-1 print:text-slate-700">القيمة الإجمالية المقبوضة:</span>
                <p class="font-mono text-emerald-400 font-bold text-sm print:text-emerald-800">@Model.BaseMaterialCost.ToString("N2") د.أ</p>
                <p class="text-[10px] text-slate-500 mt-1">شامل الفحص الفني والمطابقة الميدانية</p>
            </div>
        </section>

        <!-- Material Schedule -->
        <section class="space-y-3 mb-8">
            <h2 class="text-sm font-bold text-emerald-400 uppercase tracking-wider print:text-emerald-700">المواد المفرزة والمقبوضة شرعاً</h2>
            <div class="overflow-x-auto border border-white/10 rounded-xl print:border-slate-300">
                <table class="w-full text-start text-xs">
                    <thead class="bg-slate-900/80 text-slate-400 font-bold print:bg-slate-100 print:text-slate-700">
                        <tr>
                            <th class="p-3 text-start">م</th>
                            <th class="p-3 text-start">المادة والمواصفات المعتمدة</th>
                            <th class="p-3 text-start">الكمية المقبوضة</th>
                            <th class="p-3 text-start">حالة الفحص والمطابقة</th>
                            <th class="p-3 text-end">القيمة (د.أ)</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-white/5 print:divide-slate-200">
                        @if (Model.Items != null && Model.Items.Any())
                        {
                            int idx = 1;
                            foreach (var it in Model.Items)
                            {
                                <tr class="text-slate-300 print:text-black">
                                    <td class="p-3 font-mono text-slate-500">@(idx++)</td>
                                    <td class="p-3 font-semibold">@it.MaterialName (@it.MaterialCategory)</td>
                                    <td class="p-3 font-mono font-bold text-emerald-400 print:text-black">@it.Quantity @it.Unit</td>
                                    <td class="p-3">
                                        <span class="inline-flex items-center gap-1 text-emerald-400 font-bold text-[11px]">
                                            <span class="material-symbols-outlined text-xs">check_circle</span>
                                            <span>مقبوضة ومفرزة ومطابقة للمواصفات</span>
                                        </span>
                                    </td>
                                    <td class="p-3 font-mono font-bold text-end">@it.SubtotalJod.ToString("N2")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <!-- Sharia Compliance & Liability Transfer Clauses -->
        <section class="space-y-3 mb-8 text-xs text-slate-400 leading-relaxed bg-slate-900/40 border border-white/5 rounded-xl p-5 print:bg-slate-50 print:border-slate-200 print:text-slate-700">
            <h2 class="text-sm font-bold text-emerald-400 uppercase tracking-wider print:text-emerald-700">الأحكام الشرعية والقانونية للقبض الحكمي</h2>
            <ul class="space-y-2 list-disc list-inside">
                <li><strong>تحقق القبض والتملك:</strong> يعتبر إصدار هذه الشهادة إشعاراً قطعياً بتحقق القبض الحكمي للسلعة وفقاً لمعايير AAOIFI، حيث تم فرز البضاعة وتخصيصها برقم التتبع الإلكتروني المذكور.</li>
                <li><strong>تحمل الضمان (المسؤولية الشرعية):</strong> تتحمل محفظة المستثمر الممول تبعة هلاك البضاعة وتلفها طوال فترة بقائها بحوزة الوكيل وحتى تسليمها النهائي للمقاول بالموقع الجغرافي المحدد عبر نظام الـ Geofence POD.</li>
                <li><strong>جواز إبرام المرابحة:</strong> بناءً على هذا القبض الحكمي الناجز، أصبح بيع المرابحة للآمر بالشراء صحيحاً ونافذاً شرعاً وخالياً من بيع ما لا يملك (النهي النبوي).</li>
            </ul>
        </section>

        <!-- Digital Signatures & Cryptographic Seal -->
        <footer class="border-t border-white/10 pt-8 grid grid-cols-1 sm:grid-cols-3 gap-6 text-xs print:border-slate-300">
            <div class="text-center sm:text-start space-y-1">
                <span class="text-slate-400 block print:text-slate-600">المطابقة الميدانية والفرز:</span>
                <p class="text-white font-bold print:text-black">إدارة فحص الجودة والتوريدات</p>
                <span class="inline-block px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 text-[10px] font-mono border border-emerald-500/20">INSPECTED & ALLOCATED</span>
            </div>

            <div class="text-center space-y-1">
                <span class="text-slate-400 block print:text-slate-600">أمين الوكالة والتنفيذ:</span>
                <p class="text-white font-bold print:text-black">منصة بلوكو لتقنية المعلومات</p>
                <span class="inline-block px-2 py-0.5 rounded bg-blue-500/10 text-blue-400 text-[10px] font-mono border border-blue-500/20">ESCROW CUSTODIAN</span>
            </div>

            <div class="text-center sm:text-end space-y-1">
                <span class="text-slate-400 block print:text-slate-600">الختم المشفر للقبض الحكمي:</span>
                <p class="font-mono text-[10px] text-slate-400 print:text-slate-600 break-all">POS-HASH: @hash</p>
                <span class="inline-block px-2 py-0.5 rounded bg-purple-500/10 text-purple-400 text-[10px] font-mono border border-purple-500/20">SHA-256 VERIFIED</span>
            </div>
        </footer>
    </main>

    <footer class="max-w-4xl mx-auto mt-6 text-center text-xs text-slate-500 no-print">
        منصة بلوكو للتوريدات الإنشائية وعقود التمويل الإسلامي © @DateTime.UtcNow.Year - جميع الحقوق محفوظة
    </footer>
</body>
</html>
