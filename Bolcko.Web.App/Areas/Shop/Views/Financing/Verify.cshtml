@model Bolcko.Domain.Entities.Financing.DTOs.FinancingTenderDto
@{
    ViewData["Title"] = "التحقق من صحة وثيقة وعقد المرابحة الشرعية | Block-O Escrow Verification";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var trackingCode = Model?.TrackingCode ?? Context.Request.Query["code"].ToString();
    var hash = Model != null 
        ? Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes((Model.TrackingCode ?? "") + Model.TotalPayableAmount + (Model.FundedAt?.ToString("o") ?? "UNFUNDED") + (Model.ContractorName ?? "")))).Substring(0, 16)
        : null;
}

<div class="min-h-screen bg-slate-950 text-slate-100 py-12 px-4 sm:px-6 lg:px-8" dir="rtl">
    <div class="max-w-3xl mx-auto space-y-8">

        <!-- Top Header & Search Bar -->
        <div class="text-center space-y-3">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-black font-mono">
                <span class="material-symbols-outlined text-sm">verified_user</span>
                <span>BLOCK-O SHARIA & LEGAL VERIFICATION PORTAL</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight">التحقق من صحة عقود المرابحة والوثائق الرقمية</h1>
            <p class="text-xs sm:text-sm text-slate-400 max-w-xl mx-auto">
                بوابة التحقق الفوري من صحة أختام العقود الإلكترونية وشهادات القبض والتسليم الجغرافي المعيارية (AAOIFI)
            </p>

            <form action="/Shop/Financing/Verify" method="get" class="max-w-md mx-auto pt-2 flex items-center gap-2">
                <div class="relative flex-1">
                    <span class="material-symbols-outlined absolute start-3 top-1/2 -translate-y-1/2 text-slate-400 text-lg">search</span>
                    <input type="text" name="code" value="@trackingCode" placeholder="أدخل رمز التتبع (مثال: MRB-260919-2546)" 
                           class="w-full bg-slate-900 border border-white/10 rounded-xl py-2.5 ps-10 pe-4 text-xs font-mono text-white placeholder:text-slate-500 focus:outline-none focus:border-amber-500 transition-colors" />
                </div>
                <button type="submit" class="px-5 py-2.5 bg-amber-500 hover:bg-amber-400 text-slate-950 font-black rounded-xl text-xs transition-all shadow-md shrink-0">
                    فحص الآن
                </button>
            </form>
        </div>

        @if (Model != null)
        {
            <!-- Verification Card Result -->
            <div class="bg-slate-900/90 border border-emerald-500/30 rounded-3xl p-6 sm:p-10 shadow-2xl space-y-6 relative overflow-hidden backdrop-blur-xl">
                <!-- Status Ribbon -->
                <div class="flex items-center justify-between border-b border-white/10 pb-6">
                    <div class="flex items-center gap-3">
                        <div class="w-12 h-12 rounded-2xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center border border-emerald-500/30 shrink-0">
                            <span class="material-symbols-outlined text-2xl">verified</span>
                        </div>
                        <div>
                            <span class="text-xs font-bold text-emerald-400 block">وثيقة رسمية سارية ومعتمدة بالنظام</span>
                            <h2 class="text-lg font-black text-white">عقد وكالة شراء بالمرابحة للأمر بالشراء</h2>
                        </div>
                    </div>
                    <span class="px-3 py-1 rounded-xl bg-slate-800 border border-white/10 text-xs font-mono font-bold text-amber-400">
                        @Model.TrackingCode
                    </span>
                </div>

                <!-- Parties & Project Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
                    <div class="bg-slate-950/60 border border-white/5 rounded-2xl p-4 space-y-2">
                        <span class="text-slate-400 block text-[11px] font-bold">الطرف الأول (المستثمر الممول):</span>
                        <p class="text-white font-bold text-sm">@(string.IsNullOrWhiteSpace(Model.FunderName) ? "مستثمر تمويلي معتمد" : (Model.FunderName.Contains("@") ? Model.FunderName.Split('@')[0] : Model.FunderName))</p>
                        <p class="text-slate-400 font-mono text-[11px]">حالة التوثيق: <span class="text-emerald-400 font-bold">موثق ومحول للأصل عيناً</span></p>
                    </div>

                    <div class="bg-slate-950/60 border border-white/5 rounded-2xl p-4 space-y-2">
                        <span class="text-slate-400 block text-[11px] font-bold">الطرف الثاني (المقاول الآمر بالشراء):</span>
                        <p class="text-white font-bold text-sm">@(Model.ContractorName?.Contains("@") == true ? Model.ContractorName.Split('@')[0] : (Model.ContractorName ?? "المقاول المنفذ"))</p>
                        <p class="text-slate-400 text-[11px]">المنشأة: <strong class="text-slate-200">@(string.IsNullOrWhiteSpace(Model.ContractorCompany) ? "مؤسسة مقاولات" : Model.ContractorCompany)</strong> (@(Model.ProjectCity ?? "الأردن"))</p>
                    </div>
                </div>

                <!-- Financial & Sharia Audit Metrics -->
                <div class="bg-slate-950 rounded-2xl p-5 border border-white/5 grid grid-cols-2 sm:grid-cols-4 gap-4 text-center">
                    <div>
                        <span class="text-[10px] text-slate-400 block">أصل قيمة المواد:</span>
                        <strong class="font-mono text-sm sm:text-base text-white">@Model.BaseMaterialCost.ToString("N2") د.أ</strong>
                    </div>
                    <div>
                        <span class="text-[10px] text-slate-400 block">هامش ربح المرابحة:</span>
                        <strong class="font-mono text-sm sm:text-base text-emerald-400">+@((Model.TotalPayableAmount - Model.BaseMaterialCost).ToString("N2")) د.أ</strong>
                    </div>
                    <div>
                        <span class="text-[10px] text-slate-400 block">أجل السداد:</span>
                        <strong class="font-mono text-sm sm:text-base text-amber-400">@Model.TenureDays يوماً</strong>
                    </div>
                    <div>
                        <span class="text-[10px] text-slate-400 block">إجمالي ثمن المرابحة:</span>
                        <strong class="font-mono text-sm sm:text-base text-amber-300">@Model.TotalPayableAmount.ToString("N2") د.أ</strong>
                    </div>
                </div>

                <!-- Seal Hash & Blockchain Verification -->
                <div class="bg-slate-950/80 border border-white/5 rounded-2xl p-4 space-y-2 text-xs">
                    <div class="flex items-center justify-between">
                        <span class="text-slate-400 text-[11px]">البصمة الرقمية للوثيقة (SHA-256 Digest):</span>
                        <span class="px-2 py-0.5 rounded bg-purple-500/10 text-purple-400 font-mono text-[10px] border border-purple-500/20">IMMUTABLE ESCROW</span>
                    </div>
                    <p class="font-mono text-xs text-amber-400 break-all bg-slate-900 p-2.5 rounded-xl border border-white/5">
                        @hash
                    </p>
                </div>

                <!-- Action CTA -->
                <div class="pt-2 flex flex-wrap items-center justify-between gap-4 border-t border-white/10">
                    <a href="/Shop/Financing/Contract/@Model.TrackingCode" target="_blank" class="px-6 py-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-xs transition-all shadow-lg flex items-center gap-2">
                        <span class="material-symbols-outlined text-sm">description</span>
                        <span>فتح وثيقة العقد الرسمية للطباعة والتنزيل (A4)</span>
                    </a>

                    <a href="/Shop/Financing/PossessionNotice/@Model.TrackingCode" target="_blank" class="px-5 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs border border-white/10 transition-all flex items-center gap-2">
                        <span class="material-symbols-outlined text-sm text-emerald-400">verified</span>
                        <span>عرض شهادة القبض الحكمي</span>
                    </a>
                </div>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(trackingCode))
        {
            <!-- Not Found State -->
            <div class="bg-slate-900/90 border border-rose-500/30 rounded-3xl p-8 text-center space-y-4">
                <div class="w-16 h-16 rounded-full bg-rose-500/20 text-rose-500 flex items-center justify-center mx-auto">
                    <span class="material-symbols-outlined text-3xl">cancel</span>
                </div>
                <h2 class="text-lg font-black text-white">لم يتم العثور على وثيقة مطابقة</h2>
                <p class="text-xs text-slate-400 max-w-md mx-auto">
                    رمز التتبع (<span class="font-mono text-rose-400 font-bold">@trackingCode</span>) غير مسجل في سجلات العقود المعتمدة. يرجى التحقق من صحة الرمز.
                </p>
            </div>
        }
    </div>
</div>
