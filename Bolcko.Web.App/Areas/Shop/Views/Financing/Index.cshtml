@model IEnumerable<Bolcko.Domain.Entities.Financing.DTOs.FinancingTenderDto>
@{
    ViewData["Title"] = "بوابة المستثمر التمويلي | عطاءات المرابحة الإنشائية الحلال";
    Layout = "~/Areas/Shop/Views/Shared/_Layout.cshtml";
    var isArabic = true;
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12 text-right" dir="rtl">
    
    <!-- 1. Hero Banner Partial -->
    <partial name="~/Areas/Shop/Views/Financing/Partials/_InvestorHeroBanner.cshtml" />

    <!-- 2. Interactive ROI & Yield Simulator Partial -->
    <partial name="~/Areas/Shop/Views/Financing/Partials/_InvestorRoiSimulator.cshtml" />

    <!-- 3. Tenders Grid Header & Filter Controls -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6" id="tendersCatalogSection">
        <div>
            <h2 class="text-xl font-black text-slate-900 flex items-center gap-2">
                <span class="material-symbols-outlined text-amber-600">gavel</span>
                <span>العطاءات المتاحة للتمويل والتملك الفوري (<span id="tendersCount">@Model.Count()</span>)</span>
            </h2>
            <p class="text-xs text-slate-500 mt-1">كشوف كميات معتمدة هندسياً ومربوطة برخص بناء سارية في عمان والمحافظات</p>
        </div>

        <div class="flex items-center gap-3">
            <button type="button" onclick="resetTenderFilters()" class="text-xs font-bold text-slate-500 hover:text-slate-800 underline cursor-pointer">إعادة تعيين الفلترة</button>
            <select id="cityFilter" onchange="filterTendersByCity(this.value)" class="text-xs font-bold bg-white border border-slate-200 rounded-xl px-3 py-2 text-slate-700 focus:outline-none focus:ring-2 focus:ring-amber-500 shadow-2xs">
                <option value="All">كافة المحافظات</option>
                <option value="عمان">عمّان</option>
                <option value="الزرقاء">الزرقاء</option>
                <option value="إربد">إربد</option>
                <option value="العقبة">العقبة</option>
            </select>
        </div>
    </div>

    <!-- 4. Tenders Cards Grid -->
    @if (!Model.Any())
    {
        <div class="bg-white rounded-3xl p-12 text-center border border-slate-200 space-y-4 shadow-sm">
            <div class="w-16 h-16 rounded-full bg-amber-50 flex items-center justify-center mx-auto text-amber-600">
                <span class="material-symbols-outlined text-3xl">hourglass_empty</span>
            </div>
            <h3 class="text-lg font-bold text-slate-800">لا توجد عطاءات مفتوحة حالياً</h3>
            <p class="text-xs text-slate-500 max-w-md mx-auto">سيتم إشعارك فور قيام المقاولين المعتمدين بطرح صفقات مرابحة جديدة للشراء والتمليك.</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="tendersGrid">
            @foreach (var tender in Model)
            {
                <div class="tender-card flex flex-col" data-cost="@tender.BaseMaterialCost" data-city="@tender.ProjectCity" data-tenure="@tender.TenureDays">
                    <partial name="~/Areas/Shop/Views/Financing/Partials/_TenderCard.cshtml" model="tender" />
                </div>
            }
        </div>
    }
</div>

<!-- 5. One-Click Funding & Sharia Agency Modal Partial -->
<partial name="~/Areas/Shop/Views/Financing/Partials/_OneClickFundModal.cshtml" />

@section Scripts {
<script>
    let currentTenderId = 0;
    let selectedTenor = 45;
    let selectedRate = 0.055;

    function openFundModal(id, title, cost, profit, tenure, code) {
        currentTenderId = id;
        document.getElementById('modalTenderId').value = id;
        document.getElementById('modalTenderTitle').textContent = `${title} (${code})`;
        document.getElementById('modalBaseCost').textContent = Number(cost).toLocaleString('en-US', { minimumFractionDigits: 2 }) + ' د.أ';
        document.getElementById('modalNetProfit').textContent = '+' + Number(profit).toLocaleString('en-US', { minimumFractionDigits: 2 }) + ' د.أ';
        document.getElementById('modalTotalPayable').textContent = Number(cost + profit).toLocaleString('en-US', { minimumFractionDigits: 2 }) + ' د.أ';
        document.getElementById('fundTenderModal').classList.remove('hidden');
    }

    function closeFundModal() {
        document.getElementById('fundTenderModal').classList.add('hidden');
    }

    async function submitFunderDecision(event) {
        event.preventDefault();
        const name = document.getElementById('funderNameInput')?.value?.trim();
        const phone = document.getElementById('funderPhoneInput')?.value?.trim();
        const email = document.getElementById('funderEmailInput')?.value?.trim();

        if (!name || !phone) {
            if (window.BlockoModal) BlockoModal.alert('يرجى إدخال الاسم الكامل ورقم الهاتف للمتابعة.');
            else alert('يرجى إدخال الاسم ورقم الهاتف للمتابعة.');
            return;
        }

        const btn = document.getElementById('confirmFundBtn');
        btn.disabled = true;
        btn.innerHTML = '<span class="material-symbols-outlined animate-spin text-sm">progress_activity</span> <span>جاري إصدار أمر الشراء وتوقيع العقد...</span>';

        try {
            const res = await fetch('/Shop/Financing/Fund', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    tenderId: currentTenderId,
                    funderName: name,
                    funderPhone: phone,
                    funderEmail: email,
                    termsAccepted: true
                })
            });

            const data = await res.json();
            if (data.success) {
                if (window.BlockoModal) {
                    BlockoModal.alert(data.message || 'تم تمويل العطاء وشراء البضاعة بنجاح!', () => {
                        window.location.href = data.redirectUrl || '/Shop/Financing/InvestorDashboard';
                    });
                } else {
                    alert(data.message || 'تم تمويل العطاء وشراء البضاعة بنجاح!');
                    window.location.href = data.redirectUrl || '/Shop/Financing/InvestorDashboard';
                }
            } else {
                if (window.BlockoModal) BlockoModal.alert(data.message || 'حدث خطأ أثناء معالجة التمويل.');
                else alert(data.message || 'حدث خطأ أثناء معالجة التمويل.');
            }
        } catch (e) {
            if (window.BlockoModal) BlockoModal.alert('حدث خطأ في الاتصال بالخادم.');
            else alert('حدث خطأ في الاتصال بالخادم.');
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<span class="material-symbols-outlined text-sm">lock</span> <span>تأكيد التمويل وتوقيع عقد الوكالة ⚡</span>';
        }
    }

    function setSliderAmount(amount) {
        document.getElementById('capitalSlider').value = amount;
        updateRoiCalculation();
    }

    function setTenor(days, rate) {
        selectedTenor = days;
        selectedRate = rate;

        document.querySelectorAll('.tenor-btn').forEach(btn => {
            btn.className = 'tenor-btn p-3 rounded-xl bg-white/5 border border-white/10 text-center transition-all hover:bg-white/10';
        });

        const activeBtn = document.getElementById(`tenorBtn-${days}`);
        if (activeBtn) {
            activeBtn.className = 'tenor-btn p-3 rounded-xl bg-emerald-600 border border-emerald-500 text-center transition-all';
        }

        updateRoiCalculation();
    }

    function updateRoiCalculation() {
        const capital = parseFloat(document.getElementById('capitalSlider').value) || 10000;
        document.getElementById('sliderCapitalVal').textContent = capital.toLocaleString();

        const markupRate = 0.06;
        const agencyFeeRate = 0.015;
        const grossMarkup = capital * markupRate;
        const agencyFee = capital * agencyFeeRate;
        const netProfit = grossMarkup - agencyFee;
        const totalReturn = capital + grossMarkup;

        document.getElementById('resMarkupRate').textContent = `${(markupRate * 100).toFixed(1)}%`;
        document.getElementById('resAgencyFee').textContent = `${agencyFee.toFixed(2)} د.أ`;
        document.getElementById('resNetProfit').textContent = `+${netProfit.toFixed(2)} د.أ`;
        document.getElementById('resTotalReturn').textContent = `${totalReturn.toFixed(2)} د.أ`;
    }

    function filterTendersByBudget() {
        const targetBudget = parseFloat(document.getElementById('capitalSlider').value) || 10000;
        const cards = document.querySelectorAll('.tender-card');
        let matched = 0;

        cards.forEach(c => {
            const cost = parseFloat(c.getAttribute('data-cost')) || 0;
            if (cost <= targetBudget * 1.5 && cost >= targetBudget * 0.3) {
                c.style.display = 'flex';
                matched++;
            } else {
                c.style.display = 'none';
            }
        });

        document.getElementById('tendersCount').textContent = matched;
        document.getElementById('tendersCatalogSection')?.scrollIntoView({ behavior: 'smooth' });
    }

    function filterTendersByCity(city) {
        const cards = document.querySelectorAll('.tender-card');
        let matched = 0;

        cards.forEach(c => {
            const cCity = c.getAttribute('data-city') || '';
            if (city === 'All' || cCity.includes(city)) {
                c.style.display = 'flex';
                matched++;
            } else {
                c.style.display = 'none';
            }
        });

        document.getElementById('tendersCount').textContent = matched;
    }

    function resetTenderFilters() {
        document.querySelectorAll('.tender-card').forEach(c => c.style.display = 'flex');
        document.getElementById('tendersCount').textContent = document.querySelectorAll('.tender-card').length;
        document.getElementById('cityFilter').value = 'All';
    }

    document.addEventListener('DOMContentLoaded', () => {
        updateRoiCalculation();
    });
</script>
}
