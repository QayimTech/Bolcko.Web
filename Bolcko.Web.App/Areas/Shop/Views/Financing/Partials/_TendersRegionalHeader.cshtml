@model Bolcko.Web.App.Areas.Shop.Models.ProgrammaticTendersViewModel

<div class="relative overflow-hidden rounded-3xl bg-slate-900 border border-slate-800 shadow-2xl p-6 sm:p-10 mb-8">
    <!-- Ambient glowing backgrounds -->
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-emerald-500/15 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-amber-500/15 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10">
        <!-- Breadcrumb Navigation -->
        <nav class="flex items-center gap-2 text-xs text-slate-400 mb-6 flex-wrap font-medium">
            <a href="/" class="hover:text-amber-400 transition">الرئيسية</a>
            <span>/</span>
            <a href="/Invest" class="hover:text-amber-400 transition">سوق الاستثمار والتمويل</a>
            <span>/</span>
            <a href="/Invest/Tenders/@Model.CitySlug/all" class="hover:text-amber-400 transition">@Model.CityNameAr</a>
            <span>/</span>
            <span class="text-amber-400 font-bold">@Model.MaterialNameAr</span>
        </nav>

        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
            <div class="max-w-3xl">
                <!-- Badges -->
                <div class="flex flex-wrap items-center gap-2 mb-3">
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                        <i class="fas fa-certificate text-[10px]"></i>
                        معتمد شرعياً حسب معايير AAOIFI
                    </span>
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-amber-500/10 text-amber-400 border border-amber-500/20">
                        <i class="fas fa-map-marker-alt text-[10px]"></i>
                        @Model.CityNameAr
                    </span>
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-blue-500/10 text-blue-400 border border-blue-500/20">
                        <i class="fas fa-cubes text-[10px]"></i>
                        @Model.MaterialNameAr
                    </span>
                </div>

                <h1 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight leading-snug mb-3">
                    @Model.PageTitle
                </h1>
                <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
                    @Model.MetaDescription
                </p>
            </div>

            <!-- CTA Actions -->
            <div class="flex flex-col sm:flex-row lg:flex-col gap-3 min-w-[240px]">
                <a href="/Shop/Financing/InvestorJoin" class="flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-slate-950 font-bold text-sm shadow-lg shadow-amber-500/20 transition transform hover:-translate-y-0.5">
                    <i class="fas fa-user-plus"></i>
                    <span>فتح محفظة مستثمر فوراً</span>
                </a>
                <a href="/Invest#roi-simulator" class="flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-slate-800/80 hover:bg-slate-800 text-slate-200 border border-slate-700 text-sm font-semibold transition">
                    <i class="fas fa-calculator text-amber-400"></i>
                    <span>محاكاة العوائد التفاعلية</span>
                </a>
            </div>
        </div>
    </div>
</div>
