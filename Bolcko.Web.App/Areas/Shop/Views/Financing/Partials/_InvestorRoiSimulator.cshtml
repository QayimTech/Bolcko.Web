<section class="bg-gradient-to-br from-slate-900 via-slate-850 to-slate-950 border border-white/10 rounded-3xl p-6 sm:p-8 shadow-2xl mb-10 text-white relative overflow-hidden">
    <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6 pb-6 border-b border-white/10">
        <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-bold font-mono mb-2">
                <span class="material-symbols-outlined text-sm">calculate</span>
                <span>محاكي أرباح المستثمر التفاعلي (ROI & Yield Simulator)</span>
            </div>
            <h2 class="text-xl sm:text-2xl font-black text-white">احسب أرباحك وعوائدك التمويلية المتوقعة لحظياً</h2>
            <p class="text-xs text-slate-400 mt-1">حدد المبلغ الذي ترغب باستثماره واختر مدة العطاء لمعاينة الأرباح الصافية ونسبة الـ APR</p>
        </div>

        <div class="flex items-center gap-2">
            <span class="text-xs font-bold text-slate-400">ضمانات التمويل:</span>
            <span class="px-2.5 py-1 rounded bg-amber-500/10 text-amber-300 border border-amber-500/20 text-xs font-bold font-mono">100% عيني + GPS POD</span>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mt-6">
        <!-- Left Controls: Capital Slider & Tenor -->
        <div class="lg:col-span-7 space-y-6">
            <!-- Investment Capital Slider -->
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <label class="text-xs font-bold text-slate-300">مبلغ الاستثمار التمويلي:</label>
                    <div class="text-xl sm:text-2xl font-black font-mono text-emerald-400">
                        <span id="sliderCapitalVal">10,000</span> <span class="text-xs font-sans text-slate-400">د.أ</span>
                    </div>
                </div>
                <input type="range" id="capitalSlider" min="1000" max="100000" step="500" value="10000" 
                       class="w-full h-2.5 bg-slate-700 rounded-lg appearance-none cursor-pointer accent-emerald-500" oninput="updateRoiCalculation()" />
                
                <!-- Quick Amount Chips -->
                <div class="flex flex-wrap gap-2 pt-1">
                    <button type="button" onclick="setSliderAmount(2500)" class="px-3 py-1 rounded-lg bg-white/5 hover:bg-white/10 text-xs font-bold font-mono text-slate-300 transition-all border border-white/5">2,500 د.أ</button>
                    <button type="button" onclick="setSliderAmount(5000)" class="px-3 py-1 rounded-lg bg-white/5 hover:bg-white/10 text-xs font-bold font-mono text-slate-300 transition-all border border-white/5">5,000 د.أ</button>
                    <button type="button" onclick="setSliderAmount(10000)" class="px-3 py-1 rounded-lg bg-emerald-500/20 text-emerald-300 text-xs font-bold font-mono transition-all border border-emerald-500/30">10,000 د.أ</button>
                    <button type="button" onclick="setSliderAmount(25000)" class="px-3 py-1 rounded-lg bg-white/5 hover:bg-white/10 text-xs font-bold font-mono text-slate-300 transition-all border border-white/5">25,000 د.أ</button>
                    <button type="button" onclick="setSliderAmount(50000)" class="px-3 py-1 rounded-lg bg-white/5 hover:bg-white/10 text-xs font-bold font-mono text-slate-300 transition-all border border-white/5">50,000 د.أ</button>
                </div>
            </div>

            <!-- Tenor Selector (Duration) -->
            <div class="space-y-3">
                <label class="text-xs font-bold text-slate-300 block">مدة أجل السداد والدورة التشغيلية:</label>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                    <button type="button" onclick="setTenor(30, 0.045)" id="tenorBtn-30" class="tenor-btn p-3 rounded-xl bg-white/5 border border-white/10 text-center transition-all hover:bg-white/10">
                        <span class="block text-sm font-black font-mono">30 يوماً</span>
                        <span class="text-[10px] text-slate-400">عائد ~9% سنوي</span>
                    </button>
                    <button type="button" onclick="setTenor(45, 0.055)" id="tenorBtn-45" class="tenor-btn p-3 rounded-xl bg-emerald-600 border border-emerald-500 text-center transition-all">
                        <span class="block text-sm font-black font-mono">45 يوماً</span>
                        <span class="text-[10px] text-emerald-200">عائد ~11% سنوي</span>
                    </button>
                    <button type="button" onclick="setTenor(60, 0.060)" id="tenorBtn-60" class="tenor-btn p-3 rounded-xl bg-white/5 border border-white/10 text-center transition-all hover:bg-white/10">
                        <span class="block text-sm font-black font-mono">60 يوماً</span>
                        <span class="text-[10px] text-slate-400">عائد ~12% سنوي</span>
                    </button>
                    <button type="button" onclick="setTenor(90, 0.070)" id="tenorBtn-90" class="tenor-btn p-3 rounded-xl bg-white/5 border border-white/10 text-center transition-all hover:bg-white/10">
                        <span class="block text-sm font-black font-mono">90 يوماً</span>
                        <span class="text-[10px] text-slate-400">عائد ~14% سنوي</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Right: Real-Time Results Card -->
        <div class="lg:col-span-5 bg-slate-950/80 border border-white/10 rounded-2xl p-5 sm:p-6 flex flex-col justify-between space-y-4">
            <span class="text-xs font-bold text-amber-400 uppercase tracking-wider">ملخص الأرباح المقدرة والتدفق النقدي:</span>
            
            <div class="space-y-3 text-xs">
                <div class="flex justify-between items-center text-slate-300">
                    <span>هامش ربح الصفقة:</span>
                    <span id="resMarkupRate" class="font-mono font-bold text-white">5.5%</span>
                </div>
                <div class="flex justify-between items-center text-slate-300">
                    <span>أتعاب الوكالة وإدارة الضمان (1.5%):</span>
                    <span id="resAgencyFee" class="font-mono font-bold text-slate-400">150.00 د.أ</span>
                </div>
                <div class="flex justify-between items-center text-emerald-400 font-bold border-t border-white/10 pt-2">
                    <span>صافي ربح المستثمر الممول:</span>
                    <span id="resNetProfit" class="font-mono text-base">+400.00 د.أ</span>
                </div>
                <div class="flex justify-between items-center text-amber-300 font-black text-sm border-t border-white/10 pt-2">
                    <span>إجمالي المبلغ المسترد (أصل + ربح):</span>
                    <span id="resTotalReturn" class="font-mono text-lg text-emerald-400">10,400.00 د.أ</span>
                </div>
            </div>

            <div class="pt-2">
                <a href="#tenders-grid" class="w-full py-3 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-black text-xs transition flex items-center justify-center gap-2 shadow-lg active:scale-95">
                    <span>تصفح العطاءات المتاحة للتمويل الآن ⬇️</span>
                </a>
            </div>
        </div>
    </div>
</section>
