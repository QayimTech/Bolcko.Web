@model Bolcko.Domain.Entities.Financing.DTOs.FinancingTenderDto
@{
    Layout = null; // Standalone printable contract document
    var hash = Model != null 
        ? Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes((Model.TrackingCode ?? "") + Model.TotalPayableAmount + (Model.FundedAt?.ToString("o") ?? "UNFUNDED") + (Model.ContractorName ?? "")))).Substring(0, 16)
        : "UNVERIFIED-BLOCKO";
    var appHost = Context.Request.Scheme + "://" + Context.Request.Host.Value;
    var verifyUrl = Model != null ? $"{appHost}/Shop/Financing/Verify?code={Model.TrackingCode}" : $"{appHost}/Shop/Financing/Verify";
    var qrCodeUrl = $"https://api.qrserver.com/v1/create-qr-code/?size=180x180&data={Uri.EscapeDataString(verifyUrl)}";
    
    // Formatting party names cleanly
    string funderDisplayName = "المستثمر الممول المعتمد";
    if (!string.IsNullOrWhiteSpace(Model?.FunderName))
    {
        if (Model.FunderName.Contains("@"))
        {
            funderDisplayName = "المستثمر الممول (" + Model.FunderName.Split('@')[0] + ")";
        }
        else
        {
            funderDisplayName = Model.FunderName;
        }
    }

    string contractorDisplayName = Model?.ContractorName ?? "المقاول المنفذ";
    if (contractorDisplayName.Contains("@"))
    {
        contractorDisplayName = contractorDisplayName.Split('@')[0];
    }
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>عقد وكالة شراء بالمرابحة الشرعية - @(Model?.TrackingCode ?? "BLOCKO") - Block-O FinTech</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700;800&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
    <style>
        body { font-family: 'Tajawal', sans-serif; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
        .font-mono { font-family: 'JetBrains Mono', monospace; }
        
        @@page {
            size: A4 portrait;
            margin: 10mm 12mm 10mm 12mm;
        }
        
        @@media print {
            .no-print, nav, header.screen-only, footer.screen-only { display: none !important; }
            body { background: #ffffff !important; color: #000000 !important; padding: 0 !important; margin: 0 !important; }
            .contract-paper {
                box-shadow: none !important;
                border: 1px solid #cbd5e1 !important;
                margin: 0 !important;
                width: 100% !important;
                max-width: 100% !important;
                padding: 18px !important;
                background: #ffffff !important;
                color: #0f172a !important;
                border-radius: 0 !important;
            }
            .print-exact {
                background-color: inherit !important;
                color: inherit !important;
            }
            .page-break-avoid {
                break-inside: avoid;
                page-break-inside: avoid;
            }
        }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen py-8 px-4 sm:px-6 lg:px-8">

    <!-- Action Toolbar (Hidden in Print) -->
    <header class="screen-only max-w-4xl mx-auto mb-6 flex flex-wrap items-center justify-between gap-4 no-print bg-slate-950/80 backdrop-blur-md p-4 rounded-2xl border border-white/10 shadow-xl">
        <a href="/Shop/Financing/InvestorDashboard" class="inline-flex items-center gap-2 text-xs sm:text-sm font-bold text-slate-300 hover:text-amber-400 transition-colors">
            <span class="material-symbols-outlined text-base">arrow_forward</span>
            <span>العودة للمحفظة الاستثمارية</span>
        </a>
        <div class="flex items-center gap-2.5 flex-wrap">
            <a href="/Shop/Financing/Verify?code=@Model?.TrackingCode" target="_blank" class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs border border-white/10 transition-all flex items-center gap-1.5 shadow-sm">
                <span class="material-symbols-outlined text-sm text-sky-400">qr_code_scanner</span>
                <span>فحص الختم والتوثيق</span>
            </a>
            @if (Model != null)
            {
                <a href="/Shop/Financing/PossessionNotice/@Model.TrackingCode" target="_blank" class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs border border-white/10 transition-all flex items-center gap-1.5 shadow-sm">
                    <span class="material-symbols-outlined text-sm text-emerald-400">verified</span>
                    <span>شهادة القبض الحكمي</span>
                </a>
            }
            <button onclick="window.print()" class="px-4 py-2 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-black text-xs shadow-lg shadow-amber-500/20 transition-all flex items-center gap-1.5 cursor-pointer active:scale-95">
                <span class="material-symbols-outlined text-base">print</span>
                <span>طباعة العقد الرسمي (A4 / PDF)</span>
            </button>
        </div>
    </header>

    @if (Model == null)
    {
        <div class="max-w-md mx-auto text-center py-16 bg-slate-950 rounded-3xl border border-white/10 p-8 shadow-2xl">
            <span class="material-symbols-outlined text-5xl text-rose-500 mb-4">error</span>
            <h2 class="text-lg font-bold text-white mb-2">العقد التمويلي غير موجود</h2>
            <p class="text-xs text-slate-400 mb-6">يرجى التأكد من صحة رمز التتبع المدخل والمحاولة مجدداً.</p>
            <a href="/Shop/Financing" class="px-5 py-2.5 bg-amber-500 text-slate-950 font-bold rounded-xl text-xs">الانتقال لبوابة المرابحة</a>
        </div>
    }
    else
    {
        <!-- Official Institutional Legal Document Container -->
        <main class="contract-paper max-w-4xl mx-auto bg-white text-slate-900 border border-slate-200 rounded-3xl p-8 sm:p-12 shadow-2xl relative overflow-hidden">
            
            <!-- Watermark Background for Legitimacy -->
            <div class="absolute inset-0 flex items-center justify-center opacity-[0.03] pointer-events-none select-none z-0">
                <span class="text-9xl font-black rotate-[-25deg] tracking-widest text-slate-950">BLOCK-O MURABAHA</span>
            </div>

            <div class="relative z-10 space-y-6">
                <!-- Header / Institutional Letterhead -->
                <header class="border-b-2 border-slate-900 pb-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
                    <div class="flex items-center gap-4">
                        <div class="w-16 h-16 rounded-2xl bg-slate-950 text-amber-400 flex flex-col items-center justify-center font-black p-2 border border-slate-800 shadow-sm shrink-0">
                            <span class="text-base tracking-wider leading-none">BLOCK</span>
                            <span class="text-lg text-amber-500 leading-none mt-0.5">O</span>
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <h2 class="text-lg sm:text-xl font-black tracking-tight text-slate-950">منصة بلوكو للتوريدات الإنشائية</h2>
                                <span class="px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 border border-emerald-300 text-[10px] font-black font-mono">AAOIFI COMPLIANT</span>
                            </div>
                            <p class="text-xs font-bold text-slate-600 mt-0.5">شركة منصة بلوكو لتقنية المعلومات والتوريدات ذ.م.م (س.ت: 200189422)</p>
                            <p class="text-[11px] text-slate-500 font-medium">مرخصة ومسجلة لدى وزارة الصناعة والتجارة - المملكة الأردنية الهاشمية | الرقم الضريبي: 018492048</p>
                        </div>
                    </div>

                    <!-- Ref Badge & Dynamic QR Code -->
                    <div class="flex items-center gap-3 self-end sm:self-auto bg-slate-50 border border-slate-200 rounded-2xl p-2.5 shadow-2xs">
                        <div class="text-start">
                            <span class="text-[10px] font-bold text-slate-500 block">رقم العقد المرجعي:</span>
                            <span class="font-mono text-sm font-black text-slate-950 block">@Model.TrackingCode</span>
                            <span class="text-[10px] text-slate-500 block mt-0.5">التاريخ: @(Model.FundedAt?.ToString("yyyy/MM/dd HH:mm") ?? Model.CreatedAt.ToString("yyyy/MM/dd HH:mm")) UTC</span>
                        </div>
                        <img src="@qrCodeUrl" alt="QR Verification" class="w-14 h-14 border border-slate-300 rounded-lg p-0.5 bg-white shrink-0" />
                    </div>
                </header>

                <!-- Contract Title -->
                <section class="text-center py-2 border-b border-slate-100">
                    <span class="inline-block px-3 py-1 rounded-full bg-amber-100 text-amber-900 text-xs font-bold mb-2">عقد توريد وتمويل إسلامي ملزم</span>
                    <h1 class="text-xl sm:text-2xl font-black text-slate-950 tracking-tight">عقد وكالة شراء بالمرابحة للأمر بالشراء</h1>
                    <p class="text-xs font-semibold text-slate-500 mt-1 max-w-2xl mx-auto">
                        محرر وفقاً لمعيار المرابحة للأمر بالشراء رقم (8) الصادر عن هيئة المحاسبة والمراجعة للمؤسسات المالية الإسلامية (AAOIFI) وأحكام قانون المعاملات الإلكترونية الأردني رقم (15) لسنة 2015
                    </p>
                </section>

                <!-- Parties of Contract -->
                <section class="space-y-3 page-break-avoid">
                    <h3 class="text-xs font-black text-slate-900 uppercase tracking-wider flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                        <span>أولاً: أطراف العقد والصفات القانونية</span>
                    </h3>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
                        <!-- First Party: Funder -->
                        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 space-y-1.5 shadow-2xs">
                            <div class="flex items-center justify-between border-b border-slate-200 pb-1.5">
                                <span class="font-black text-slate-950 text-xs">الطرف الأول (المستثمر الممول / المشتري):</span>
                                <span class="px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 text-[10px] font-bold">المالك الأصلي للبضاعة</span>
                            </div>
                            <p class="text-sm font-black text-slate-900 pt-0.5">@funderDisplayName</p>
                            <div class="grid grid-cols-2 gap-2 text-[11px] text-slate-600">
                                <span>الهاتف المعتمد: <strong class="text-slate-900 font-mono">@(Model.FunderPhone ?? "079XXXXXXX")</strong></span>
                                <span>حساب التوثيق: <strong class="text-slate-900 font-mono">موافق وموثق بنكياً</strong></span>
                            </div>
                            <p class="text-[10px] text-slate-500 leading-normal pt-1 border-t border-slate-100">
                                الصفة: المالك العيني للمواد المشتراة، والموكل لمنصة بلوكو لشراء وتوريد المواد عيناً لموقع العمل.
                            </p>
                        </div>

                        <!-- Second Party: Contractor -->
                        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 space-y-1.5 shadow-2xs">
                            <div class="flex items-center justify-between border-b border-slate-200 pb-1.5">
                                <span class="font-black text-slate-950 text-xs">الطرف الثاني (المقاول الآمر بالشراء):</span>
                                <span class="px-2 py-0.5 rounded bg-sky-100 text-sky-800 text-[10px] font-bold">المشتري بالمرابحة</span>
                            </div>
                            <p class="text-sm font-black text-slate-900 pt-0.5">@contractorDisplayName</p>
                            <div class="grid grid-cols-2 gap-2 text-[11px] text-slate-600">
                                <span>اسم المنشأة: <strong class="text-slate-900">@(string.IsNullOrWhiteSpace(Model.ContractorCompany) ? "مؤسسة مقاولات فردية" : Model.ContractorCompany)</strong></span>
                                <span>رقم الهاتف: <strong class="text-slate-900 font-mono">@Model.ContractorPhone</strong></span>
                                <span>رخصة البناء: <strong class="text-slate-900 font-mono">@(string.IsNullOrWhiteSpace(Model.BuildingPermitNumber) ? "تحت التدقيق" : Model.BuildingPermitNumber)</strong></span>
                                <span>المدينة: <strong class="text-slate-900">@Model.ProjectCity</strong></span>
                            </div>
                            <p class="text-[10px] text-slate-500 leading-normal pt-1 border-t border-slate-100">
                                الصفة: الآمر بالشراء، الملتزم بالاستلام الفعلي في الورشة وسداد إجمالي ثمن المرابحة المؤجل.
                            </p>
                        </div>
                    </div>

                    <!-- Third Party: Platform Agent -->
                    <div class="bg-amber-500/5 border border-amber-500/20 rounded-xl p-3 text-xs text-slate-700 flex items-start gap-2.5">
                        <span class="material-symbols-outlined text-amber-600 text-lg shrink-0 mt-0.5">verified_user</span>
                        <div>
                            <strong class="text-slate-950">الطرف الثالث (الوكيل والوسيط التجاري والضامن التنفيذي):</strong> شركة منصة بلوكو لتقنية المعلومات والتوريدات ذ.م.م، بصفتها الوكيل الحصري للطرف الأول في قبض البضاعة حكمياً وفحصها ومطابقتها للمواصفات، وتسليمها للطرف الثاني بموجب محضر التسليم الجغرافي الموثق بالـ GPS.
                        </div>
                    </div>
                </section>

                <!-- BOQ / Materials Schedule -->
                <section class="space-y-3 page-break-avoid">
                    <h3 class="text-xs font-black text-slate-900 uppercase tracking-wider flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                        <span>ثانياً: جدول تفاصيل المواد الإنشائية المشتراة عيناً (BOQ Materials)</span>
                    </h3>
                    
                    <div class="overflow-x-auto border border-slate-300 rounded-2xl">
                        <table class="w-full text-start text-xs border-collapse">
                            <thead class="bg-slate-100 text-slate-700 font-bold border-b border-slate-300">
                                <tr>
                                    <th class="p-2.5 text-center w-10 border-e border-slate-200">#</th>
                                    <th class="p-2.5 text-start border-e border-slate-200">تصنيف المادة</th>
                                    <th class="p-2.5 text-start border-e border-slate-200">اسم المادة والمواصفة الفنية</th>
                                    <th class="p-2.5 text-center border-e border-slate-200">الكمية</th>
                                    <th class="p-2.5 text-center border-e border-slate-200">الوحدة</th>
                                    <th class="p-2.5 text-center border-e border-slate-200">سعر الوحدة (د.أ)</th>
                                    <th class="p-2.5 text-end">الإجمالي (د.أ)</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-200 font-medium">
                                @if (Model.Items != null && Model.Items.Any())
                                {
                                    int idx = 1;
                                    foreach (var it in Model.Items)
                                    {
                                        <tr class="hover:bg-slate-50/80">
                                            <td class="p-2.5 text-center font-mono text-slate-500 border-e border-slate-200">@(idx++)</td>
                                            <td class="p-2.5 font-bold text-slate-800 border-e border-slate-200">@it.MaterialCategory</td>
                                            <td class="p-2.5 text-slate-900 border-e border-slate-200">@it.MaterialName</td>
                                            <td class="p-2.5 text-center font-mono font-bold border-e border-slate-200">@it.Quantity.ToString("N1")</td>
                                            <td class="p-2.5 text-center text-slate-600 border-e border-slate-200">@it.Unit</td>
                                            <td class="p-2.5 text-center font-mono border-e border-slate-200">@it.UnitPriceJod.ToString("N2")</td>
                                            <td class="p-2.5 font-mono font-bold text-end text-slate-950">@it.SubtotalJod.ToString("N2")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                            <tfoot class="bg-slate-50 border-t border-slate-300 font-bold">
                                <tr>
                                    <td colspan="6" class="p-2.5 text-end text-slate-700">إجمالي قيمة شراء المواد الأساسية (سعر التكلفة الأصلية):</td>
                                    <td class="p-2.5 text-end font-mono font-black text-slate-950 text-sm">@Model.BaseMaterialCost.ToString("N2") د.أ</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </section>

                <!-- Financial Schedule & Murabaha Calculations -->
                <section class="space-y-3 page-break-avoid">
                    <h3 class="text-xs font-black text-slate-900 uppercase tracking-wider flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                        <span>ثالثاً: شروط وقيمة عقد المرابحة والتسوية المالية</span>
                    </h3>
                    
                    <div class="bg-slate-950 text-white rounded-2xl p-5 space-y-3 border border-slate-800">
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs border-b border-slate-800 pb-3">
                            <div>
                                <span class="text-slate-400 block text-[11px]">تكلفة شراء المواد من الموردين:</span>
                                <strong class="font-mono text-base text-white">@Model.BaseMaterialCost.ToString("N2") د.أ</strong>
                            </div>
                            <div>
                                <span class="text-slate-400 block text-[11px]">هامش ربح المرابحة الإجمالي (@((Model.ContractorMarkupRate * 100).ToString("N1"))%):</span>
                                <strong class="font-mono text-base text-emerald-400">+@((Model.TotalPayableAmount - Model.BaseMaterialCost).ToString("N2")) د.أ</strong>
                            </div>
                            <div>
                                <span class="text-slate-400 block text-[11px]">أجل السداد المعتمد:</span>
                                <strong class="font-mono text-base text-amber-400">@Model.TenureDays يوماً</strong>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-1 text-xs">
                            <div class="space-y-1.5 text-slate-300">
                                <div class="flex justify-between">
                                    <span>- صافي العائد المحول للمستثمر الممول:</span>
                                    <span class="font-mono font-bold text-emerald-400">@Model.InvestorNetYieldAmount.ToString("N2") د.أ</span>
                                </div>
                                <div class="flex justify-between">
                                    <span>- أجر وكالة منصة بلوكو التنفيذية (1.5%):</span>
                                    <span class="font-mono font-bold text-amber-400">@Model.PlatformAgencyFeeAmount.ToString("N2") د.أ</span>
                                </div>
                                <div class="flex justify-between">
                                    <span>- تاريخ استحقاق السداد النهائي:</span>
                                    <span class="font-mono font-bold text-slate-200">@(Model.DueDate?.ToString("yyyy/MM/dd") ?? DateTime.UtcNow.AddDays(Model.TenureDays).ToString("yyyy/MM/dd"))</span>
                                </div>
                            </div>

                            <div class="bg-slate-900 rounded-xl p-3.5 border border-slate-800 flex flex-col justify-center">
                                <span class="text-xs text-slate-400 block">إجمالي المبلغ المستحق النهائي (ثمن المرابحة المؤجل):</span>
                                <div class="flex items-baseline gap-2 mt-1">
                                    <span class="text-2xl font-black font-mono text-amber-400">@Model.TotalPayableAmount.ToString("N2")</span>
                                    <span class="text-xs font-bold text-amber-300">دينار أردني</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Sharia & Legal Provisions -->
                <section class="space-y-2 page-break-avoid text-[11px] text-slate-600 leading-relaxed">
                    <h3 class="text-xs font-black text-slate-900 uppercase tracking-wider flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                        <span>رابعاً: البنود والأحكام القانونية والشرعية الملزمة</span>
                    </h3>
                    <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 space-y-2">
                        <p><strong>1. التملك والقبض الحكمي:</strong> يقر الطرف الأول (المستثمر) بأنه اشترى البضاعة المذكورة في الجدول ثانياً من الموردين وتملكها تملكاً تاماً، ودخلت في ضمانه قبل بيعها للطرف الثاني، ووكل منصة بلوكو باستلامها والتحقق من مطابقتها وتوصيلها لموقع المقاول.</p>
                        <p><strong>2. توثيق التسليم الموقعي:</strong> يلتزم الطرف الثاني (المقاول) بفحص واستلام المواد فور وصولها لموقع العمل المحدد في رخصة البناء، وتعتبر البضاعة مستلمة رسمياً بمجرد تأكيد سند التسليم الإلكتروني (Digital POD) وإحداثيات الموقع الجغرافي GPS.</p>
                        <p><strong>3. الالتزام بالأجل:</strong> يلتزم الطرف الثاني بسداد إجمالي ثمن المرابحة المقطوع والبالغ (@Model.TotalPayableAmount.ToString("N2") د.أ) في أو قبل تاريخ الاستحقاق المحدد أعلاه دون أي زيادة تأخير ربوية.</p>
                        <p><strong>4. الأثر القانوني والتنفيذي:</strong> تعتبر هذه الوثيقة عقداً إلكترونياً ملزماً وسنداً تنفيذياً معترفاً به لدى كافة المحاكم والجهات القضائية في المملكة الأردنية الهاشمية بموجب قانون المعاملات الإلكترونية وقانون التنفيذ.</p>
                    </div>
                </section>

                <!-- Institutional Signatures & Digital Seal -->
                <footer class="border-t-2 border-slate-900 pt-6 grid grid-cols-1 sm:grid-cols-3 gap-6 text-xs page-break-avoid">
                    <!-- Funder Seal -->
                    <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 text-center space-y-1.5 shadow-2xs">
                        <span class="text-slate-500 block font-bold text-[11px]">توقيع واعتماد المستثمر:</span>
                        <p class="text-slate-950 font-black text-sm">@funderDisplayName</p>
                        <div class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800 text-[10px] font-bold font-mono">
                            <span class="material-symbols-outlined text-[14px]">lock</span>
                            <span>E-SIGNED & FUNDED</span>
                        </div>
                    </div>

                    <!-- Contractor Seal -->
                    <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 text-center space-y-1.5 shadow-2xs">
                        <span class="text-slate-500 block font-bold text-[11px]">توقيع وقبول المقاول:</span>
                        <p class="text-slate-950 font-black text-sm">@contractorDisplayName</p>
                        <div class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-sky-100 text-sky-800 text-[10px] font-bold font-mono">
                            <span class="material-symbols-outlined text-[14px]">verified</span>
                            <span>OTP VERIFIED (2FA)</span>
                        </div>
                    </div>

                    <!-- Platform Cryptographic Seal -->
                    <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 text-center space-y-1.5 shadow-2xs">
                        <span class="text-slate-500 block font-bold text-[11px]">الختم المشفر لمنصة بلوكو:</span>
                        <p class="font-mono text-[10px] font-bold text-slate-800 break-all leading-none pt-1">@hash</p>
                        <div class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-purple-100 text-purple-800 text-[10px] font-bold font-mono">
                            <span class="material-symbols-outlined text-[14px]">token</span>
                            <span>AAOIFI ESCROW SEAL</span>
                        </div>
                    </div>
                </footer>

                <!-- Bottom Document Meta -->
                <div class="border-t border-slate-200 pt-3 flex items-center justify-between text-[10px] text-slate-400 font-mono">
                    <span>Block-O FinTech Engine v2.6 • Smart Escrow & Murabaha</span>
                    <span>وثيقة رسمية صادرة آلياً وموثقة برقم تتبع مشفر</span>
                    <span>الصفحة 1 من 1</span>
                </div>
            </div>
        </main>
    }

    <footer class="screen-only max-w-4xl mx-auto mt-6 text-center text-xs text-slate-400 no-print">
        منصة بلوكو للتوريدات الإنشائية وعقود المرابحة © @DateTime.UtcNow.Year - جميع الحقوق محفوظة
    </footer>
</body>
</html>
