@model Bolcko.Domain.Entities.Product.DTOs.ProductDto

<div class="bg-white border border-slate-100 rounded-3xl p-5 flex flex-col shadow-[0_4px_20px_rgba(0,0,0,0.02)] group text-start h-full transition-all duration-300 hover:border-[#E8A020]/30 hover:shadow-[0_12px_30px_rgba(232,160,32,0.05)] hover:-translate-y-1.5 relative">
    
    <!-- Image Gallery Wrapper -->
    <div onclick="location.href='@Url.Action("Index", "Product", new { area = "Shop", id = Model.Id })'" 
         class="aspect-[4/3] bg-slate-50 relative overflow-hidden rounded-2xl cursor-pointer">
        
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
                 src="@(Model.ImageUrl.StartsWith("http") ? Model.ImageUrl : "/" + Model.ImageUrl.TrimStart('/'))"
                 width="600"
                 height="450"
                 onerror="this.onerror=null; this.src='/images/product-placeholder.svg';"
                 alt="@Model.Name"
                 loading="lazy"
                 decoding="async">
        }
        else
        {
            <img class="w-full h-full object-cover"
                 src="/images/product-placeholder.svg"
                 width="600"
                 height="450"
                 alt="@Model.Name"
                 loading="lazy"
                 decoding="async">
        }
    </div>

    @{
        var isArabic = System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("ar");
        var displayTitle = Model.Name;
        if (displayTitle.Contains("clean_products", StringComparison.OrdinalIgnoreCase)) displayTitle = isArabic ? "مواد بناء وبلوك نخب أول" : "Premium Building Blocks";
        else if (displayTitle.Contains("sehi", StringComparison.OrdinalIgnoreCase)) displayTitle = isArabic ? "أدوات وتجهيزات سباكة صحية" : "Sanitary & Plumbing Supplies";
        else if (displayTitle.Contains("_v") || displayTitle.Contains("_split_"))
        {
            displayTitle = System.Text.RegularExpressions.Regex.Replace(displayTitle, @"(_v\d+|_split_\d+|-\d+)", "").Replace("_", " ").Trim();
        }

        var displayCategory = Model.CategoryName;
        if (!string.IsNullOrEmpty(displayCategory) && (displayCategory.Contains("clean_products", StringComparison.OrdinalIgnoreCase) || displayCategory.Contains("_v")))
        {
            displayCategory = isArabic ? "مواد البناء الأساسية" : "Building Materials";
        }
    }

    <!-- Product Text Content -->
    <div class="pt-4 flex flex-col flex-1">
        <!-- Category Tag & Merchant Badge (VM-01) -->
        <div class="flex items-center justify-between gap-1 mb-1.5 flex-wrap">
            @if (!string.IsNullOrEmpty(displayCategory))
            {
                <span class="text-[10px] font-bold text-[#E8A020] uppercase tracking-widest">@displayCategory</span>
            }
            
            <a href="@Url.Action("Index", "Store", new { area = "Shop", slug = Model.SupplierSlug ?? "al-qannas" })" 
               class="inline-flex items-center gap-1 text-[10px] font-semibold text-slate-500 hover:text-amber-600 transition bg-slate-50 px-2 py-0.5 rounded-md border border-slate-200/60"
               onclick="event.stopPropagation();"
               title="مباع ومشحون بواسطة @Model.SupplierName">
                <span class="material-symbols-outlined text-[11px] text-emerald-600">verified</span>
                <span class="truncate max-w-[110px]">@(Model.SupplierName ?? "مجموعة القناص")</span>
            </a>
        </div>
        
        <!-- Product Title -->
        <h5 class="font-bold text-base text-slate-800 cursor-pointer hover:text-[#E8A020] transition-colors line-clamp-1 mb-2"
            onclick="location.href='@Url.Action("Index", "Product", new { area = "Shop", id = Model.Id })'">
            @displayTitle
        </h5>
        
        <!-- Description -->
        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed mb-4">@Model.Description</p>
        }
        
        <!-- Bottom Pricing and Add to Cart Section -->
        <div class="mt-auto">
            <div class="flex justify-between items-center border-t border-slate-50 pt-4 mb-4">
                <span class="font-bold text-lg text-slate-900">
                    @if (Model.DisplayPrice > 0)
                    {
                        @Model.DisplayPrice.ToString("N2") <span class="text-[10px] font-medium text-slate-600">@SharedLocalizer["JordanDinarShort"]</span>
                    }
                    else
                    {
                        <span class="text-xs font-bold text-[#E8A020]">@(isArabic ? "السعر عند الطلب" : "Price on Quote")</span>
                    }
                </span>
                
                <!-- Glowing Stock Indicator -->
                <div class="flex items-center gap-1.5">
                    @if (Model.StockQuantity > 0)
                    {
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                        <span class="text-[10px] font-bold text-emerald-600">@SharedLocalizer["ItemInStock"]</span>
                    }
                    else
                    {
                        <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
                        <span class="text-[10px] font-bold text-rose-500">@SharedLocalizer["ItemOutOfStock"]</span>
                    }
                </div>
            </div>
            
            <!-- Add to Cart Form -->
            <form asp-action="AddToCart" asp-controller="ShoppingCart" asp-area="Shop" method="post" class="space-y-2">
                <input type="hidden" name="productId" value="@Model.Id" />
                <input type="hidden" name="quantity" value="1" />
                @if (Model.StockQuantity > 0)
                {
                    <button type="submit" 
                            data-loading-btn
                            data-loading-text="@SharedLocalizer["AddToCart"]"
                            aria-label="@Model.Name - @SharedLocalizer["AddToCart"]"
                            class="w-full bg-[#151B26] hover:bg-[#E8A020] text-white hover:text-[#151B26] font-bold py-3 rounded-xl flex items-center justify-center gap-2 transition-all duration-300 shadow-sm active:scale-95 min-h-[44px]">
                        <span class="material-symbols-outlined text-[18px]">shopping_cart</span>
                        <span class="text-xs tracking-wider">@SharedLocalizer["AddToCart"]</span>
                    </button>
                }
                else
                {
                    <button type="button" disabled
                            class="w-full bg-slate-100 text-slate-400 border border-slate-200 cursor-not-allowed font-bold py-3 rounded-xl flex items-center justify-center gap-2 min-h-[44px] shadow-none">
                        <span class="material-symbols-outlined text-[18px]">block</span>
                        <span class="text-xs tracking-wider">@(isArabic ? "نفذ من المخزون" : "Out of Stock")</span>
                    </button>
                }
            </form>
        </div>
    </div>
</div>
