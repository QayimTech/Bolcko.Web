@{
    var isAr = System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("ar");
    ViewData["Title"] = isAr ? "تأكيد طلب عرض السعر" : "Quote Request Confirmation";
    int? tenderId = ViewBag.TenderId as int?;
    var tenderNumber = tenderId.HasValue ? $"#QT-{tenderId.Value.ToString("D5")}" : "#QT-00000";
}
<main class="max-w-3xl mx-auto px-6 py-24 text-center">
    <div class="bg-white border border-outline-variant p-12 shadow-hard">
        <span class="material-symbols-outlined text-primary text-7xl mb-6" style="font-variation-settings: 'wght' 200">request_quote</span>
        <h1 class="font-headline-xl text-on-surface mb-4">@(isAr ? "تم إرسال طلب عرض السعر بنجاح!" : "Quote Request Submitted Successfully!")</h1>
        <p class="text-body-lg text-secondary mb-8">@(isAr ? "رقم الطلب المرجعي هو:" : "Your reference request number is:") <span class="font-bold text-on-surface">@tenderNumber</span></p>
        
        <div class="bg-surface-container-low p-6 border-s-4 border-primary text-start mb-12">
            <h3 class="font-bold text-on-surface mb-2">@(isAr ? "ما هي الخطوة التالية؟" : "What happens next?")</h3>
            <ul class="space-y-3 text-sm text-on-surface-variant">
                <li class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-sm text-primary">circle</span>
                    @(isAr ? "سيقوم فريق التسعير المختص بدراسة طلبك وتجهيز أفضل عرض مخصص لك." : "Our pricing team will review your requirements and prepare a custom quotation.")
                </li>
                <li class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-sm text-primary">circle</span>
                    @(isAr ? "ستصلك نسخة من عرض السعر عبر البريد الإلكتروني وحسابك على المنصة خلال 24-48 ساعة عمل." : "You will receive a quotation copy via email and on your account portal within 24-48 business hours.")
                </li>
                <li class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-sm text-primary">circle</span>
                    @(isAr ? "سيتواصل معك مدير حسابك المخصص لمناقشة التفاصيل اللوجستية والخصومات المتاحة." : "Your dedicated account manager will follow up to discuss logistics and volume discounts.")
                </li>
            </ul>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="@Url.Action("Quotes", "Account", new { area = "Shop" })" class="bg-primary text-slate-950 font-bold px-8 py-4 uppercase shadow-hard hover:opacity-90 transition-all flex items-center justify-center gap-2">
                <span class="material-symbols-outlined text-lg">request_quote</span>
                @(isAr ? "متابعة طلباتي والعطاءات" : "My Quotes & Tenders")
            </a>
            <a href="@Url.Action("Index", "Category", new { area = "Shop" })" class="bg-surface-container-low text-on-surface font-bold px-8 py-4 uppercase shadow-hard hover:bg-slate-200 transition-all">
                @(isAr ? "تصفح المزيد من المنتجات" : "Browse More Products")
            </a>
            <a href="@Url.Action("Index", "Home", new { area = "Shop" })" class="bg-on-surface text-white font-bold px-8 py-4 uppercase shadow-hard hover:bg-slate-800 transition-all">
                @(isAr ? "العودة للرئيسية" : "Back to Home")
            </a>
        </div>
    </div>
</main>
