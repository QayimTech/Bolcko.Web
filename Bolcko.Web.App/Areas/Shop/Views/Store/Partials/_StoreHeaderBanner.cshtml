@model Bolcko.Web.App.Areas.Shop.Models.VendorShowroomViewModel
@{
    var isArabic = System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("ar");
    var storeDisplayName = Model.Name;
    if (!isArabic && (storeDisplayName.Contains("قناص") || storeDisplayName.Contains("القناص")))
    {
        storeDisplayName = "Al-Qannas Building Materials Co.";
    }
}

<div class="relative overflow-hidden rounded-3xl bg-slate-900 border border-slate-800 shadow-2xl p-6 sm:p-10 mb-8">
    <!-- Ambient glow -->
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-amber-500/15 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-emerald-500/15 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="flex items-start gap-5">
            <!-- Vendor Avatar / Icon -->
            <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-3xl bg-gradient-to-br from-amber-400 to-amber-600 p-0.5 shadow-xl shrink-0 flex items-center justify-center">
                <div class="w-full h-full bg-slate-950 rounded-[22px] flex items-center justify-center text-amber-400">
                    <span class="material-symbols-outlined text-4xl">store</span>
                </div>
            </div>

            <div class="space-y-2 text-start">
                <!-- Badges -->
                <div class="flex flex-wrap items-center gap-2">
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                        <span class="material-symbols-outlined text-sm">verified</span>
                        @(isArabic ? "متجر معتمد وموثق" : "Verified Store")
                    </span>
                    @if (Model.IsFactoryDirect)
                    {
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black bg-sky-500/10 text-sky-400 border border-sky-500/20">
                            <span class="material-symbols-outlined text-sm">precision_manufacturing</span>
                            @(isArabic ? "توريد مباشر من المصنع" : "Direct Factory Supply")
                        </span>
                    }
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-slate-800 text-slate-300 border border-slate-700">
                        <span class="material-symbols-outlined text-sm text-rose-400">location_on</span>
                        @(Model.City ?? (isArabic ? "عمّان، الأردن" : "Amman, Jordan"))
                    </span>
                </div>

                <h1 class="text-2xl sm:text-4xl font-black text-white tracking-tight">
                    @storeDisplayName
                </h1>
                <p class="text-xs sm:text-sm text-slate-300 font-medium max-w-2xl leading-relaxed">
                    @(Model.Tagline ?? (isArabic ? "المصدر الأول لمواد البناء المعتمدة وحلول التشطيبات الإنشائية في الأردن." : "Leading verified supplier of certified building materials and construction solutions in Jordan."))
                </p>
            </div>
        </div>

        <!-- Contact & RFQ Actions -->
        <div class="flex flex-col sm:flex-row md:flex-col gap-3 shrink-0 min-w-[200px]">
            <a href="https://wa.me/@Model.ContactWhatsApp?text=@Uri.EscapeDataString(isArabic ? $"مرحباً، أود طلب عرض أسعار كميات جملة من معرضكم في منصة بلكو ({storeDisplayName})" : $"Hello, I would like to request a bulk wholesale quotation for ({storeDisplayName}) on Blocko")" 
               target="_blank" rel="noopener noreferrer"
               class="flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-[#25D366] hover:bg-[#1ebd5a] text-white font-bold text-xs shadow-lg transition">
                <span class="material-symbols-outlined text-base">chat</span>
                <span>@(isArabic ? "طلب تسعير جملة (واتساب)" : "Request Wholesale Quote (WhatsApp)")</span>
            </a>
            
            <a href="#showroom-catalog" class="flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-semibold text-xs transition">
                <span class="material-symbols-outlined text-base text-amber-400">inventory_2</span>
                <span>@(isArabic ? "تصفح كتالوج المنتجات" : "Browse Product Catalog")</span>
            </a>
        </div>
    </div>
</div>
