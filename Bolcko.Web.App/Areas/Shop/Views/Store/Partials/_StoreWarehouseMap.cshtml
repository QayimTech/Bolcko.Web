@model Bolcko.Web.App.Areas.Shop.Models.VendorShowroomViewModel

<div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 mb-8 text-white">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-800 mb-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-amber-500/10 text-amber-400 flex items-center justify-center font-bold">
                <span class="material-symbols-outlined text-xl">warehouse</span>
            </div>
            <div>
                <h3 class="text-base font-bold text-white">المستودع الرئيسي ومحطة التحميل</h3>
                <p class="text-xs text-slate-400">@Model.WarehouseAddress</p>
            </div>
        </div>
        <div class="flex items-center gap-2 text-xs text-slate-400 font-mono">
            <span class="material-symbols-outlined text-emerald-400 text-sm">my_location</span>
            <span>@Model.Latitude.ToString("F4"), @Model.Longitude.ToString("F4")</span>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
        <div class="bg-slate-950/60 p-3 rounded-2xl border border-slate-800">
            <span class="text-slate-400 block mb-1">نمط الشحن والتوريد</span>
            <span class="font-bold text-slate-200">@Model.FulfillmentMode</span>
        </div>
        <div class="bg-slate-950/60 p-3 rounded-2xl border border-slate-800">
            <span class="text-slate-400 block mb-1">الرقم الضريبي الوطني</span>
            <span class="font-bold text-amber-400 font-mono">@Model.NationalTaxNumber</span>
        </div>
        <div class="bg-slate-950/60 p-3 rounded-2xl border border-slate-800">
            <span class="text-slate-400 block mb-1">البريد الإلكتروني التجاري</span>
            <span class="font-bold text-slate-200 font-mono">@Model.ContactEmail</span>
        </div>
    </div>
</div>
