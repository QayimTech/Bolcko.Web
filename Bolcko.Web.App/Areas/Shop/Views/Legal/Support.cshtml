@using Microsoft.Extensions.Localization
@using Bolcko.Web.App
@inject IStringLocalizer<SharedResource> SharedLocalizer
@{
    var isAr = System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("ar");
    ViewData["Title"] = SharedLocalizer["TechnicalSupportTitle"];
    var lastUpdatedText = isAr ? "خدمة استشارية وهندسية متكاملة" : "Comprehensive Technical & Advisory Service";

    // Clean content if full document was pasted in settings
    string rawContent = (ViewBag.Content as string) ?? "";
    string bodyContent = rawContent;
    if (!string.IsNullOrWhiteSpace(rawContent))
    {
        if (rawContent.Contains("<section class=\"content\">"))
        {
            var match = System.Text.RegularExpressions.Regex.Match(rawContent, @"<section class=""content"">(.*?)</section>", System.Text.RegularExpressions.RegexOptions.Singleline);
            if (match.Success) bodyContent = match.Groups[1].Value;
        }
        else if (rawContent.Contains("<article class=\"support-content\"") || rawContent.Contains("<article class=\"document\""))
        {
            var match = System.Text.RegularExpressions.Regex.Match(rawContent, @"<article[^>]*>(.*?)</article>", System.Text.RegularExpressions.RegexOptions.Singleline);
            if (match.Success) bodyContent = match.Groups[1].Value;
        }
        else if (rawContent.Contains("<body"))
        {
            var match = System.Text.RegularExpressions.Regex.Match(rawContent, @"<body[^>]*>(.*?)</body>", System.Text.RegularExpressions.RegexOptions.Singleline);
            if (match.Success) bodyContent = match.Groups[1].Value;
        }
    }
}

<style>
    .legal-doc-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        box-shadow: 0 16px 45px rgba(15, 23, 42, 0.08);
        overflow: hidden;
    }
    .legal-doc-hero {
        background: linear-gradient(135deg, #101827 0%, #1b2638 100%) !important;
        color: #ffffff !important;
        padding: 40px 48px 34px !important;
        border-bottom: 5px solid #d99a18 !important;
    }
    .legal-doc-hero .brand-tag {
        font-size: 13px;
        letter-spacing: 0.14em;
        color: #f0b93b !important;
        font-weight: 800;
        text-transform: uppercase;
        margin-bottom: 8px;
    }
    .legal-doc-hero h1 {
        margin: 12px 0 8px !important;
        font-size: clamp(24px, 3.5vw, 36px) !important;
        font-weight: 800 !important;
        color: #ffffff !important;
        line-height: 1.3 !important;
    }
    .legal-doc-hero .updated-tag {
        margin: 0;
        color: #cbd5e1 !important;
        font-size: 13px !important;
    }
    .legal-doc-body {
        padding: 40px 48px 50px !important;
        font-size: 16px !important;
        line-height: 2 !important;
        color: #243044 !important;
    }
    .legal-doc-body h2 {
        color: #101827 !important;
        font-size: 21px !important;
        font-weight: 700 !important;
        line-height: 1.5 !important;
        margin: 34px 0 14px !important;
        padding: 6px 14px !important;
        border-bottom: 1px solid #e8edf3 !important;
    }
    [dir="rtl"] .legal-doc-body h2 { border-right: 4px solid #d99a18 !important; }
    [dir="ltr"] .legal-doc-body h2 { border-left: 4px solid #d99a18 !important; }
    .legal-doc-body p { margin: 0 0 18px !important; }
    .legal-doc-body strong { color: #101827 !important; font-weight: 700 !important; }
    .legal-doc-body a { color: #d99a18 !important; font-weight: 600 !important; text-decoration: underline !important; text-underline-offset: 3px !important; }
    .legal-doc-body ul { margin: 0 0 20px !important; padding-inline-start: 24px !important; }
    .legal-doc-body li { margin: 6px 0 !important; }
    .legal-doc-footer {
        background: #f8fafc !important;
        border-top: 1px solid #e8edf3 !important;
        padding: 20px 48px !important;
        color: #64748b !important;
        font-size: 13px !important;
        text-align: center !important;
    }
    @@media (max-width: 640px) {
        .legal-doc-hero { padding: 26px 20px !important; }
        .legal-doc-body { padding: 26px 20px !important; font-size: 15px !important; }
        .legal-doc-footer { padding: 16px 20px !important; }
    }
</style>

<main class="py-10 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto text-start">
    <article class="legal-doc-card">
        <!-- Hero Header -->
        <header class="legal-doc-hero">
            <div class="brand-tag">BLOCKO · CONSTRUCTION SUPPLIES</div>
            <h1>@ViewData["Title"]</h1>
            <p class="updated-tag">@lastUpdatedText</p>
        </header>

        <!-- Document Content -->
        <section class="legal-doc-body text-start">
            @if (!string.IsNullOrWhiteSpace(bodyContent) && bodyContent.Trim() != "فريق الدعم الفني لدينا متاح للإجابة على جميع استفساراتك المتعلقة بالموقع..." && bodyContent.Trim() != "Our technical support team is available to answer all your inquiries regarding the site...")
            {
                @Html.Raw(bodyContent)
            }
            else
            {
                @if (isAr)
                {
                    <h2 class="text-xl md:text-2xl font-bold text-[#101827]">خبرة ومساعدة تساعد مشروعك على التقدّم</h2>
                    <p>في <strong>BLOCKO</strong>، لا نكتفي بتوفير مواد البناء. نساعدك على فهم احتياجات مشروعك، اختيار المنتجات المناسبة، تقدير الكميات، وتنظيم طلبات التوريد بطريقة أوضح وأكثر كفاءة.</p>
                    <p>سواء كنت تبدأ مشروعًا جديدًا، أو تعمل على مرحلة قائمة، أو تدير أكثر من موقع، فإن فريقنا جاهز لتقديم دعم عملي يناسب طبيعة عملك ويساعدك على اتخاذ قرارات أفضل في كل مرحلة.</p>
                    
                    <h2>كيف يمكننا مساعدتك؟</h2>
                    <ul>
                        <li>اختيار المواد والمنتجات المناسبة لمتطلبات مشروعك.</li>
                        <li>تقدير الكميات الأولية ومراجعة احتياجات التوريد.</li>
                        <li>إعداد طلبات عروض الأسعار للكميات والمشاريع المختلفة.</li>
                        <li>مقارنة الخيارات والمواصفات للوصول إلى الحل الأنسب.</li>
                        <li>تنسيق التوريد والتوصيل المباشر إلى موقع المشروع.</li>
                        <li>دعم المقاولين والشركات في طلبات الكميات الكبيرة والمشاريع متعددة المواقع.</li>
                    </ul>

                    <div class="mt-8 p-6 bg-[#fff9eb] border-s-4 border-[#E8A020] rounded-r-lg">
                        <p class="font-bold text-[#5b4a27] mb-2">هل لديك سؤال أو تحتاج إلى مساعدة؟</p>
                        <p class="text-sm text-[#786134] mb-4">تواصل مع فريق مهندسي ومستشاري BLOCKO وسنكون سعداء بمساعدتك ومراجعة جدول الكميات لمشروعك.</p>
                        <div class="flex flex-wrap gap-4">
                            <a href="mailto:support@block-o.com" class="bg-[#101827] text-white px-5 py-2.5 rounded-xl font-bold text-sm hover:bg-slate-800 transition-colors flex items-center gap-2">
                                <span class="material-symbols-outlined text-sm">mail</span>
                                <span>تواصل عبر البريد: support@block-o.com</span>
                            </a>
                            <a href="@Url.Action("Contact", "Home", new { area = "Shop" })" class="border border-slate-300 bg-white text-slate-800 px-5 py-2.5 rounded-xl font-bold text-sm hover:bg-slate-50 transition-colors flex items-center gap-2">
                                <span class="material-symbols-outlined text-sm">chat</span>
                                <span>نموذج الاتصال السريع</span>
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <h2 class="text-xl md:text-2xl font-bold text-[#101827]">Practical Guidance to Help Your Project Move Forward</h2>
                    <p>At <strong>BLOCKO</strong>, we do more than provide construction materials. We help you understand your project requirements, select the right products, estimate quantities, and organize supply orders with higher clarity and efficiency.</p>
                    <p>Whether you are starting a new build, active on a construction phase, or managing multiple job sites, our team is ready to deliver practical support tailored to your workflow.</p>

                    <h2>How Can We Help You?</h2>
                    <ul>
                        <li>Selecting materials and specifications suited to your project engineering requirements.</li>
                        <li>Estimating initial quantities and reviewing supply timelines.</li>
                        <li>Preparing and managing quotations for bulk wholesale materials.</li>
                        <li>Comparing brand options and laboratory-tested certified alternatives.</li>
                        <li>Coordinating scheduled deliveries directly to job sites across Jordan.</li>
                        <li>Dedicated account management for contractors and large engineering projects.</li>
                    </ul>

                    <div class="mt-8 p-6 bg-[#fff9eb] border-s-4 border-[#E8A020] rounded-r-lg">
                        <p class="font-bold text-[#5b4a27] mb-2">Have a question or need engineering assistance?</p>
                        <p class="text-sm text-[#786134] mb-4">Contact our technical advisory team to review your material schedule and project requirements.</p>
                        <div class="flex flex-wrap gap-4">
                            <a href="mailto:support@block-o.com" class="bg-[#101827] text-white px-5 py-2.5 rounded-xl font-bold text-sm hover:bg-slate-800 transition-colors flex items-center gap-2">
                                <span class="material-symbols-outlined text-sm">mail</span>
                                <span>Email Support: support@block-o.com</span>
                            </a>
                            <a href="@Url.Action("Contact", "Home", new { area = "Shop" })" class="border border-slate-300 bg-white text-slate-800 px-5 py-2.5 rounded-xl font-bold text-sm hover:bg-slate-50 transition-colors flex items-center gap-2">
                                <span class="material-symbols-outlined text-sm">chat</span>
                                <span>Contact Form</span>
                            </a>
                        </div>
                    </div>
                }
            }
        </section>

        <!-- Document Footer -->
        <footer class="legal-doc-footer">
            © @DateTime.Now.Year BLOCKO. @SharedLocalizer["AllRightsReserved"]
        </footer>
    </article>
</main>


