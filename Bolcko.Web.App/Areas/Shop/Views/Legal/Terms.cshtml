@{
    ViewData["Title"] = SharedLocalizer["TermsOfService"];
    var isAr = System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("ar");
}

<div class="max-w-4xl mx-auto px-6 py-20 text-start">
    <h1 class="font-headline-lg text-primary mb-8 border-b border-outline-variant pb-4">@ViewData["Title"]</h1>
    <div class="prose prose-slate max-w-none prose-h2:text-on-surface prose-h2:font-bold prose-h2:mt-8 prose-p:text-on-surface-variant leading-relaxed">
        @if (ViewBag.Content != null && !string.IsNullOrWhiteSpace((string)ViewBag.Content))
        {
            @Html.Raw(ViewBag.Content)
        }
        else
        {
            @if (isAr)
            {
                <p>باستخدامك لمنصة BLOCKO، فإنك توافق على الشروط والأحكام التالية...</p>
                <h2>الأسعار والدفع</h2>
                <p>جميع الأسعار قابلة للتغيير بناءً على أسعار السوق للمواد الثقيلة. يجب تأكيد طلبيات الجملة من قبل فريق المبيعات.</p>
                <h2>التوصيل</h2>
                <p>يعتمد وقت التوصيل على نوع المواد والكميات. سيتم التنسيق معك قبل شحن الطلبات الثقيلة والمعدات.</p>
            }
            else
            {
                <p>By using the BLOCKO platform, you agree to the following terms and conditions...</p>
                <h2>Pricing and Payment</h2>
                <p>All prices are subject to change based on market rates for heavy materials. Wholesale orders must be confirmed by the sales team.</p>
                <h2>Delivery</h2>
                <p>Delivery time depends on material types and quantities. Coordination will take place prior to shipping heavy orders and equipment.</p>
            }
        }
    </div>
</div>

