@{
    ViewData["Title"] = SharedLocalizer["PrivacyPolicy"];
    var isAr = System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("ar");
}

<div class="max-w-4xl mx-auto px-6 py-20 text-start">
    <h1 class="font-headline-lg text-primary mb-8 border-b border-outline-variant pb-4">@ViewData["Title"]</h1>
    <div class="prose prose-slate max-w-none prose-h2:text-on-surface prose-h2:font-bold prose-h2:mt-8 prose-p:text-on-surface-variant leading-relaxed">
        @if (ViewBag.Content != null && !string.IsNullOrWhiteSpace((string)ViewBag.Content))
        {
            @Html.Raw(ViewBag.Content)
        }
        else
        {
            @if (isAr)
            {
                <p>نحن في BLOCKO نقدر خصوصيتك ونلتزم بحماية بياناتك الشخصية...</p>
                <h2>جمع المعلومات</h2>
                <p>نقوم بجمع المعلومات التي تقدمها لنا مباشرة عند إنشاء حساب أو تقديم طلب تسعير.</p>
                <h2>استخدام المعلومات</h2>
                <p>تستخدم معلوماتك لتوفير خدماتنا، ومعالجة الطلبات، والتواصل معك بشأن مستجدات البناء والمقاولات.</p>
            }
            else
            {
                <p>At BLOCKO, we value your privacy and are committed to protecting your personal data...</p>
                <h2>Information Collection</h2>
                <p>We collect information you provide directly to us when creating an account or requesting a quote.</p>
                <h2>Use of Information</h2>
                <p>Your information is used to provide our services, process orders, and communicate with you regarding construction and supply updates.</p>
            }
        }
    </div>
</div>

