@using Bolcko.Domain.Entities.User
@using Bolcko.Domain.Entities.Project
@model List<Project>
@{
    ViewData["Title"] = SharedLocalizer["MyProjects"];
    var user = ViewBag.User as User;
    var isAr = System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("ar");
}
<main class="max-w-7xl mx-auto px-6 py-12 text-start">
    <div class="flex flex-col lg:flex-row gap-gutter">
        <!-- Sidebar Navigation -->
        <aside class="w-full lg:w-64 flex-shrink-0">
            <div class="bg-white border border-outline-variant shadow-hard overflow-hidden">
                <div class="bg-on-surface p-6 text-white text-center">
                    <div class="w-20 h-20 bg-primary-container rounded-full mx-auto mb-4 flex items-center justify-center">
                        <span class="material-symbols-outlined text-4xl text-on-primary-container">person</span>
                    </div>
                    <h2 class="font-bold">@(user?.FirstName + " " + user?.LastName)</h2>
                    <p class="text-xs text-slate-400">@user?.UserType.ToString()</p>
                </div>
                <nav class="p-4">
                    <ul class="space-y-2">
                        <li>
                            <a href="@Url.Action("Index", "Account", new { area = "Shop" })" class="flex items-center justify-between p-3 hover:bg-surface-container-low transition-colors text-on-surface">
                                <span>@SharedLocalizer["MyDashboard"]</span>
                                <span class="material-symbols-outlined text-sm">dashboard</span>
                            </a>
                        </li>
                        <li>
                            <a href="@Url.Action("Orders", "Account", new { area = "Shop" })" class="flex items-center justify-between p-3 hover:bg-surface-container-low transition-colors text-on-surface">
                                <span>@SharedLocalizer["MyOrders"]</span>
                                <span class="material-symbols-outlined text-sm">shopping_bag</span>
                            </a>
                        </li>
                        <li>
                            <a href="@Url.Action("Quotes", "Account", new { area = "Shop" })" class="flex items-center justify-between p-3 hover:bg-surface-container-low transition-colors text-on-surface">
                                <span>@SharedLocalizer["QuoteRequests"]</span>
                                <span class="material-symbols-outlined text-sm">request_quote</span>
                            </a>
                        </li>
                        <li>
                            <a href="@Url.Action("Projects", "Account", new { area = "Shop" })" class="flex items-center justify-between p-3 bg-surface-container-low border-s-4 border-primary font-bold text-on-surface">
                                <span>@SharedLocalizer["MyProjects"]</span>
                                <span class="material-symbols-outlined text-sm">architecture</span>
                            </a>
                        </li>
                        <li class="pt-4 mt-4 border-t border-outline-variant">
                            <form asp-area="Shop" asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="w-full flex items-center justify-between p-3 text-error hover:bg-error-container transition-colors">
                                    <span>@SharedLocalizer["Logout"]</span>
                                    <span class="material-symbols-outlined text-sm">logout</span>
                                </button>
                            </form>
                        </li>
                    </ul>
                </nav>
            </div>
        </aside>

        <!-- Main Content -->
        <div class="flex-1 space-y-8">
            <header class="border-s-4 border-primary-container ps-6 mb-8">
                <h1 class="font-headline-xl text-on-surface uppercase mb-2">@SharedLocalizer["MyProjects"]</h1>
                <p class="font-body-lg text-secondary">@SharedLocalizer["ProjectsDescription"]</p>
            </header>

            <!-- Projects Table -->
            <div class="bg-white border border-outline-variant shadow-hard overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-start">
                        <thead class="bg-surface-container-low text-xs font-bold text-on-surface-variant uppercase">
                            <tr>
                                <th class="p-4">@SharedLocalizer["ProjectName"]</th>
                                <th class="p-4">@SharedLocalizer["StartDate"]</th>
                                <th class="p-4">@SharedLocalizer["EndDate"]</th>
                                <th class="p-4">@SharedLocalizer["Status"]</th>
                            </tr>
                        </thead>
                        <tbody class="text-sm">
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var project in Model)
                                {
                                    <tr class="border-b border-outline-variant hover:bg-surface-container-lowest transition-colors">
                                        <td class="p-4 font-bold">@project.ProjectName</td>
                                        <td class="p-4">@(project.StartDate.HasValue ? project.StartDate.Value.ToString("yyyy/MM/dd") : "-")</td>
                                        <td class="p-4">@(project.EndDate.HasValue ? project.EndDate.Value.ToString("yyyy/MM/dd") : "-")</td>
                                        <td class="p-4">
                                            @{
                                                string statusClass = project.Status.ToString() switch
                                                {
                                                    "Planning" => "bg-blue-100 text-blue-800 border-blue-200",
                                                    "InProgress" => "bg-amber-100 text-amber-800 border-amber-200",
                                                    "Completed" => "bg-green-100 text-green-800 border-green-200",
                                                    _ => "bg-slate-100 text-slate-800 border-slate-200"
                                                };
                                                string statusLabel = project.Status.ToString() switch
                                                {
                                                    "Planning" => isAr ? "قيد التخطيط" : "Planning",
                                                    "InProgress" => isAr ? "قيد التنفيذ" : "In Progress",
                                                    "Completed" => isAr ? "مكتمل" : "Completed",
                                                    _ => project.Status.ToString()
                                                };
                                            }
                                            <span class="px-2.5 py-1 text-xs font-bold uppercase rounded border @statusClass">@statusLabel</span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="p-12 text-center text-on-surface-variant flex flex-col items-center justify-center">
                                        <span class="material-symbols-outlined text-6xl text-outline-variant mb-4">architecture</span>
                                        <p class="text-lg font-bold text-on-surface">@SharedLocalizer["NoProjectsYet"]</p>
                                        <p class="text-sm mt-2">@SharedLocalizer["NoProjectsDesc"]</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</main>
