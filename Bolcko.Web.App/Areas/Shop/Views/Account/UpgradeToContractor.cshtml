@model Bolcko.Domain.Entities.User.DTOs.ContractorRegistrationDto
@{
    ViewData["Title"] = "ترقية الحساب إلى مقاول معتمد B2B";
    Layout = "~/Areas/Shop/Views/Shared/_Layout.cshtml";
    var isArabic = System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("ar");
}

<div class="min-h-screen bg-slate-50 py-12 px-4 sm:px-6 lg:px-8 text-right" dir="rtl">
    <div class="max-w-2xl mx-auto space-y-8">
        
        <!-- Header -->
        <div class="bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 text-white rounded-3xl p-8 shadow-xl relative overflow-hidden border border-white/10">
            <div class="relative z-10 space-y-3">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-300 text-xs font-bold">
                    <span>🏗️ ترقية فورية لمنشآت المقاولات</span>
                </div>
                <h1 class="text-2xl sm:text-3xl font-black text-white">ترقية الحساب إلى مقاول معتمد</h1>
                <p class="text-xs text-slate-300 leading-relaxed">
                    قم باستكمال بيانات السجل التجاري والضريبي لتفعيل أسعار الجملة، حاسبة الكميات الذكية، وخطوط التمويل الإسلامي على حسابك الحالي دون الحاجة لإعادة التسجيل.
                </p>
            </div>
        </div>

        <!-- Form Card -->
        <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-slate-200">
            <form asp-action="UpgradeToContractor" method="post" class="space-y-4">
                @Html.AntiForgeryToken()

                <div>
                    <label asp-for="CompanyName" class="block text-xs font-bold text-slate-700 mb-1.5"></label>
                    <input asp-for="CompanyName" required placeholder="اسم المؤسسة / الشركة التجارية" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-[#E8A020] outline-none" />
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="CommercialRegistration" class="block text-xs font-bold text-slate-700 mb-1.5"></label>
                        <input asp-for="CommercialRegistration" required maxlength="10" placeholder="السجل التجاري (10 أرقام)" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm font-mono focus:ring-2 focus:ring-[#E8A020] outline-none" />
                    </div>
                    <div>
                        <label asp-for="TaxId" class="block text-xs font-bold text-slate-700 mb-1.5"></label>
                        <input asp-for="TaxId" required placeholder="الرقم الضريبي (VAT)" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm font-mono focus:ring-2 focus:ring-[#E8A020] outline-none" />
                    </div>
                </div>

                <div>
                    <label asp-for="ContractorClass" class="block text-xs font-bold text-slate-700 mb-1.5"></label>
                    <select asp-for="ContractorClass" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-[#E8A020] outline-none bg-white">
                        <option value="الدرجة الأولى">الدرجة الأولى</option>
                        <option value="الدرجة الثانية">الدرجة الثانية</option>
                        <option value="الدرجة الثالثة" selected>الدرجة الثالثة</option>
                        <option value="الدرجة الرابعة">الدرجة الرابعة</option>
                        <option value="مؤسسة فردية">مؤسسة فردية</option>
                    </select>
                </div>

                <div class="pt-4">
                    <button type="submit" class="w-full py-3.5 px-6 rounded-2xl bg-gradient-to-r from-emerald-600 to-teal-600 text-white font-bold text-sm shadow-md hover:from-emerald-700 hover:to-teal-700 transition flex items-center justify-center gap-2">
                        <span class="material-symbols-outlined">upgrade</span>
                        <span>تأكيد الترقية والدخول لمجمع المقاولين 🏗️</span>
                    </button>
                </div>
            </form>
        </div>

    </div>
</div>
