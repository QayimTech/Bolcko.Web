@model Bolcko.Domain.Entities.User.DTOs.ContractorRegistrationDto
@{
    var isArabic = System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("ar");
    ViewData["Title"] = isArabic 
        ? "ترقية الحساب إلى مقاول معتمد B2B | بلوكو" 
        : "Upgrade Account to Approved Contractor | BLOCKO";
    Layout = "~/Areas/Shop/Views/Shared/_Layout.cshtml";
}

<div class="min-h-screen bg-slate-50 py-12 px-4 sm:px-6 lg:px-8 text-start" dir="@(isArabic ? "rtl" : "ltr")">
    <div class="max-w-2xl mx-auto space-y-8">
        
        <!-- Header -->
        <div class="bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 text-white rounded-3xl p-8 shadow-xl relative overflow-hidden border border-white/10">
            <div class="relative z-10 space-y-3">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-300 text-xs font-bold">
                    <span>@(isArabic ? "🏗️ ترقية فورية لمنشآت المقاولات" : "🏗️ Instant Contractor Upgrade")</span>
                </div>
                <h1 class="text-2xl sm:text-3xl font-black text-white">
                    @(isArabic ? "ترقية الحساب إلى مقاول معتمد" : "Upgrade Account to Approved Contractor")
                </h1>
                <p class="text-xs text-slate-300 leading-relaxed">
                    @(isArabic 
                        ? "قم باستكمال بيانات السجل التجاري والضريبي لتفعيل أسعار الجملة، حاسبة الكميات الذكية، وخطوط التمويل الإسلامي على حسابك الحالي دون الحاجة لإعادة التسجيل." 
                        : "Complete your commercial and tax credentials to unlock wholesale pricing, smart BOQ calculations, and Islamic Murabaha credit lines on your existing account.")
                </p>
            </div>
        </div>

        <!-- Form Card -->
        <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-slate-200">
            <div class="border-b border-slate-100 pb-4 mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div>
                    <h2 class="text-base font-bold text-slate-900">
                        @(isArabic ? "البيانات التجارية للمنشأة" : "Commercial Enterprise Credentials")
                    </h2>
                </div>
                <div class="text-xs text-slate-500">
                    <a href="@Url.Action("Workspace", "Contractor", new { area = "Shop" })" class="text-emerald-700 font-bold hover:underline flex items-center gap-1">
                        <span>@(isArabic ? "الانتقال لمساحة عمل المقاول" : "Open Contractor Workspace")</span>
                        <span class="material-symbols-outlined text-[14px] rtl:-scale-x-100">arrow_forward</span>
                    </a>
                </div>
            </div>

            <form asp-action="UpgradeToContractor" method="post" class="space-y-4">
                @Html.AntiForgeryToken()

                <div>
                    <label asp-for="CompanyName" class="block text-xs font-bold text-slate-700 mb-1.5">
                        @(isArabic ? "اسم المؤسسة / الشركة التجارية" : "Company / Enterprise Name")
                    </label>
                    <input asp-for="CompanyName" required placeholder="@(isArabic ? "اسم المؤسسة / الشركة التجارية" : "Enterprise / Commercial Name")" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-[#E8A020] outline-none" />
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="CommercialRegistration" class="block text-xs font-bold text-slate-700 mb-1.5">
                            @(isArabic ? "السجل التجاري (CR)" : "Commercial Registration (CR)")
                        </label>
                        <input asp-for="CommercialRegistration" required maxlength="10" placeholder="@(isArabic ? "السجل التجاري (10 أرقام)" : "CR Number (10 digits)")" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm font-mono focus:ring-2 focus:ring-[#E8A020] outline-none" />
                    </div>
                    <div>
                        <label asp-for="TaxId" class="block text-xs font-bold text-slate-700 mb-1.5">
                            @(isArabic ? "الرقم الضريبي (VAT)" : "Tax Identification (VAT)")
                        </label>
                        <input asp-for="TaxId" required placeholder="@(isArabic ? "الرقم الضريبي (VAT)" : "VAT / Tax ID")" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm font-mono focus:ring-2 focus:ring-[#E8A020] outline-none" />
                    </div>
                </div>

                <div>
                    <label asp-for="ContractorClass" class="block text-xs font-bold text-slate-700 mb-1.5">
                        @(isArabic ? "تصنيف المقاول" : "Contractor Classification")
                    </label>
                    <select asp-for="ContractorClass" class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-[#E8A020] outline-none bg-white">
                        <option value="الدرجة الأولى">@(isArabic ? "الدرجة الأولى" : "First Class")</option>
                        <option value="الدرجة الثانية">@(isArabic ? "الدرجة الثانية" : "Second Class")</option>
                        <option value="الدرجة الثالثة" selected>@(isArabic ? "الدرجة الثالثة" : "Third Class")</option>
                        <option value="الدرجة الرابعة">@(isArabic ? "الدرجة الرابعة" : "Fourth Class")</option>
                        <option value="مؤسسة فردية">@(isArabic ? "مؤسسة فردية" : "Sole Proprietorship")</option>
                    </select>
                </div>

                <div class="pt-4">
                    <button type="submit" class="w-full py-3.5 px-6 rounded-2xl bg-gradient-to-r from-emerald-600 to-teal-600 text-white font-bold text-sm shadow-md hover:from-emerald-700 hover:to-teal-700 transition flex items-center justify-center gap-2">
                        <span class="material-symbols-outlined">upgrade</span>
                        <span>@(isArabic ? "تأكيد الترقية والدخول لمجمع المقاولين 🏗️" : "Confirm Upgrade & Open Contractor Workspace 🏗️")</span>
                    </button>
                </div>
            </form>
        </div>

    </div>
</div>
