@{
    var isEn = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName.Equals("en", StringComparison.OrdinalIgnoreCase);
}

<!-- ══════════════════════ HERO & QUICK PRESETS ══════════════════════ -->
<section class="relative bg-slate-900 text-white pt-8 pb-14 border-b border-slate-800 no-print">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Breadcrumb Navigation -->
        <nav class="flex items-center gap-2 text-xs font-semibold text-slate-400 mb-6">
            <a href="/" class="hover:text-emerald-400 transition-colors flex items-center gap-1">
                <span class="material-symbols-outlined text-[15px]">home</span>
                <span>@(isEn ? "Home" : "الرئيسية")</span>
            </a>
            <span class="text-slate-600">/</span>
            <span class="text-slate-200">@(isEn ? "Construction Cost & Quantity Calculator" : "حاسبة تكاليف وكميات البناء")</span>
        </nav>

        <div class="max-w-3xl">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold mb-3">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>@(isEn ? "Verified prices based on Jordanian Construction Markets & Commodity Exchanges" : "مؤشرات أسعار معتمدة وفق السوق الأردني وبورصات المواد الإنشائية")</span>
            </div>

            <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-white mb-3">
                @(isEn ? "Structural Construction Cost & 3D BIM Calculator" : "حاسبة تكاليف وكميات البناء والمجسم المعماري 3D")
            </h1>
            <p class="text-slate-300 text-xs sm:text-sm leading-relaxed font-normal">
                @(isEn 
                    ? "Smart structural engineering system to estimate quantities of rebar steel, ready-mix concrete, cement, masonry blocks, and stone facades with live Jordanian market pricing."
                    : "نظام هندسي لحساب كميات حديد التسليح، الخرسانة الجاهزة، الإسمنت، الطوب، وحجر الواجهات والديكورات وفق الكودات الأردنية بالأسعار الحية المحدثة.")
            </p>
        </div>

        <!-- Quick Template Presets -->
        <div id="quickPresetsContainer" class="mt-6 pt-5 border-t border-slate-800">
            <div class="flex items-center gap-2 mb-2 sm:mb-3">
                <span class="material-symbols-outlined text-sm text-emerald-400">tune</span>
                <span class="text-slate-300 font-bold text-xs">@(isEn ? "Quick Project Presets:" : "نماذج جاهزة للمشروع (نقرة واحدة):")</span>
            </div>
            <div class="grid grid-cols-2 sm:flex sm:flex-wrap gap-2 text-xs">
                <button type="button" onclick="BlockoCalculator.applyPreset(this, 120, 1, 'Residential', 'IsolatedFootings', 'classic')" id="preset-btn-1"
                        class="preset-btn p-2.5 sm:px-3 sm:py-1.5 rounded-xl bg-slate-800/90 hover:bg-slate-700 text-slate-200 border border-slate-700 font-medium transition-all flex items-center justify-center sm:justify-start gap-1.5 text-center sm:text-start">
                    <span class="material-symbols-outlined text-sm text-slate-400 flex-shrink-0">home</span>
                    <span class="truncate">@(isEn ? "Apartment (120 m²)" : "شقة / ملحق (120 م²)")</span>
                </button>
                <button type="button" onclick="BlockoCalculator.applyPreset(this, 250, 1, 'Residential', 'IsolatedFootings', 'modern')" id="preset-btn-2"
                        class="preset-btn p-2.5 sm:px-3 sm:py-1.5 rounded-xl bg-slate-800/90 hover:bg-slate-700 text-slate-200 border border-slate-700 font-medium transition-all flex items-center justify-center sm:justify-start gap-1.5 text-center sm:text-start">
                    <span class="material-symbols-outlined text-sm text-slate-400 flex-shrink-0">villa</span>
                    <span class="truncate">@(isEn ? "1-Flr Villa (250 m²)" : "فيلا أرضي (250 م²)")</span>
                </button>
                <button type="button" onclick="BlockoCalculator.applyPreset(this, 250, 2, 'Residential', 'IsolatedFootings', 'classic')" id="preset-btn-3"
                        class="preset-btn p-2.5 sm:px-3 sm:py-1.5 rounded-xl bg-slate-800/90 hover:bg-slate-700 text-emerald-400 border border-emerald-500/50 font-bold transition-all flex items-center justify-center sm:justify-start gap-1.5 text-center sm:text-start">
                    <span class="material-symbols-outlined text-sm text-emerald-400 flex-shrink-0">apartment</span>
                    <span class="truncate">@(isEn ? "2-Flr Villa (500 m²)" : "فيلا طابقين (500 م²)")</span>
                </button>
                <button type="button" onclick="BlockoCalculator.applyPreset(this, 350, 2, 'Residential', 'IsolatedFootings', 'l_shape')" id="preset-btn-4"
                        class="preset-btn p-2.5 sm:px-3 sm:py-1.5 rounded-xl bg-slate-800/90 hover:bg-slate-700 text-slate-200 border border-slate-700 font-medium transition-all flex items-center justify-center sm:justify-start gap-1.5 text-center sm:text-start">
                    <span class="material-symbols-outlined text-sm text-slate-400 flex-shrink-0">holiday_village</span>
                    <span class="truncate">@(isEn ? "L-Shape Villa (700 m²)" : "فيلا حرف L مع فناء (700 م²)")</span>
                </button>
                <button type="button" onclick="BlockoCalculator.applyPreset(this, 250, 4, 'Residential', 'Raft', 'apartment')" id="preset-btn-5"
                        class="preset-btn p-2.5 sm:px-3 sm:py-1.5 rounded-xl bg-slate-800/90 hover:bg-slate-700 text-slate-200 border border-slate-700 font-medium transition-all flex items-center justify-center sm:justify-start gap-1.5 text-center sm:text-start">
                    <span class="material-symbols-outlined text-sm text-slate-400 flex-shrink-0">domain</span>
                    <span class="truncate">@(isEn ? "4-Flrs Building (1000 m²)" : "عمارة 4 طوابق (1000 م²)")</span>
                </button>
            </div>
        </div>

    </div>
</section>
