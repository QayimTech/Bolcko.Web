                                                <span class="material-symbols-outlined text-sm">local_shipping</span>
                                                <span>@(isEn ? "Request Sample Box to Site" : "اطلب صندوق عينة للموقع الآن")</span>
                                            </button>
                                            <span class="text-[10px] text-slate-500 flex items-center gap-1">
                                                <span class="material-symbols-outlined text-xs text-emerald-600">verified</span>
                                                <span>@(isEn ? "Delivered in 24-48 hrs" : "تصلك خلال 24-48 ساعة")</span>
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <!-- 2. Encrypted Showroom Pass (تذكرة معاينة المعرض المشفرة) -->
                                <div class="p-3.5 rounded-xl bg-slate-900 text-white border border-slate-800 shadow-sm relative">
                                    <div class="flex items-center justify-between gap-2 mb-2">
                                        <div class="flex items-center gap-2">
                                            <span class="w-6 h-6 rounded-lg bg-indigo-500 text-white flex items-center justify-center flex-shrink-0">
                                                <span class="material-symbols-outlined text-sm">qr_code_2</span>
                                            </span>
                                            <h5 class="text-xs font-bold text-white">@(isEn ? "Encrypted Showroom Pass" : "تذكرة معاينة معرض مشفرة (Showroom QR Pass)")</h5>
                                        </div>
                                        <span class="text-[10px] font-mono text-indigo-300 bg-indigo-950/80 px-2 py-0.5 rounded border border-indigo-800">
                                            @(isEn ? "Free & Guaranteed" : "مجانية ومحمية")
                                        </span>
                                    </div>
                                    <p class="text-[11px] text-slate-300 leading-relaxed mb-3">
                                        @(isEn ? "Prefer visiting the quarry or supplier showroom? Book a verified digital QR pass to lock in BLOCKO bulk pricing, guarantee milestone escrow protection, and prevent unverified cash deposits." : "ترغب بزيارة ساحة أو معرض الحجر بنفسك؟ احجز تذكرة معاينة رقمية بـ QR Code تضمن لك أسعار بلكو التفضيلية وحماية أموالك بحساب الضمان (Escrow) دون أي تعامل كاش غير مكفول.")
                                    </p>
                                    <button type="button" onclick="openShowroomPassModal()" 
                                            class="px-3 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold transition-colors flex items-center gap-1.5 cursor-pointer">
                                        <span class="material-symbols-outlined text-sm">confirmation_number</span>
                                        <span>@(isEn ? "Generate Free Showroom Pass" : "إصدار تذكرة معاينة مجانية")</span>
                                    </button>
                                </div>

                                <!-- 3. Escrow Quality Guarantee Badge (حساب الضمان وحماية المشتري) -->
