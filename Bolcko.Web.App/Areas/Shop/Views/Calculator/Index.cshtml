    function sendToQuote() {
        const quoteItems = [];

        if (latestCalculationData && latestCalculationData.materialItems && latestCalculationData.materialItems.length > 0) {
            latestCalculationData.materialItems.forEach(item => {
                const dict = itemDictionary[item.category] || {};
                const name = isEnMode ? (dict.nameEn || item.category) : (dict.nameAr || item.category);
                const unit = isEnMode ? (dict.unitEn || 'Unit') : (dict.unitAr || 'وحدة');
                quoteItems.push({
                    productName: name,
                    quantity: Math.max(1, Math.round(item.quantity * 10) / 10),
                    unit: unit,
                    productId: null,
                    imageUrl: '',
                    sku: ''
                });
            });
        } else {
            // Fallback from DOM if calculation hasn't run yet
            const steelQty = parseFloat(document.getElementById('metricSteelQty')?.innerText) || 0;
            const concreteQty = parseFloat(document.getElementById('metricConcreteQty')?.innerText) || 0;
            if (steelQty > 0) quoteItems.push({ productName: isEnMode ? 'Steel Rebar Grade 60' : 'حديد تسليح أردني مشوه Grade 60', quantity: steelQty, unit: isEnMode ? 'Ton' : 'طن', productId: null });
            if (concreteQty > 0) quoteItems.push({ productName: isEnMode ? 'Ready-Mix Concrete B250' : 'خرسانة جاهزة مع مضخة B250', quantity: concreteQty, unit: isEnMode ? 'Cubic Meter' : 'متر مكعب', productId: null });
        }

        try {
            sessionStorage.setItem('TenderSessionCart', JSON.stringify(quoteItems));
        } catch (e) {
            console.error('Failed to store TenderSessionCart', e);
        }

        window.location.href = '@Url.Action("Request", "Quote", new { area = "Shop" })';
    }

