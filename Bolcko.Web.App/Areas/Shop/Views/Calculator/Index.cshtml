                                <label class="p-2 rounded-xl border border-slate-200 hover:border-slate-400 cursor-pointer text-center text-xs font-semibold has-[:checked]:border-amber-600 has-[:checked]:bg-amber-50">
                                    <input type="radio" name="stoneFinish" value="Musamsam" class="sr-only" onchange="onInputChange()" />
                                    <span>@(isEn ? "Musamsam (مسمسم)" : "مسمسم ناعم (+2)")</span>
                                </label>
                            </div>
                        </div>

