                    <canvas id="threeCanvas" class="w-full h-full cursor-grab active:cursor-grabbing block"></canvas>
                </div>

                <!-- 5. DIRECT QUICK FINISH & STONE CONTROLLER -->
                <div class="p-3 rounded-xl bg-slate-950/70 border border-slate-800 space-y-2.5">
                    
                    <!-- Quick Finish Selector Chips -->
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                        <div class="flex items-center gap-1.5 text-xs font-bold text-amber-400">
                            <span class="material-symbols-outlined text-sm">palette</span>
                            <span>@(isEn ? "Instant Stone Finish (نقشة الحجر):" : "نقشة الحجر الفورية على المجسم:")</span>
                        </div>
                        <div class="flex items-center gap-1.5 flex-wrap">
                            <button type="button" id="quick-finish-Mufajjar" onclick="quickSetFinish('Mufajjar')"
                                    class="quick-finish-chip px-2.5 py-1 rounded-lg text-[11px] font-bold bg-amber-500 text-slate-950 border border-amber-400 shadow-sm flex items-center gap-1 transition-all cursor-pointer">
                                <span class="material-symbols-outlined text-xs">scatter_plot</span>
                                <span>@(isEn ? "Mufajjar" : "مفجر صخري")</span>
                            </button>
                            <button type="button" id="quick-finish-Tabzeh" onclick="quickSetFinish('Tabzeh')"
                                    class="quick-finish-chip px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 hover:border-slate-600 flex items-center gap-1 transition-all cursor-pointer">
