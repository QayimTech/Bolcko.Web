                                <option value="Amman">@(isEn ? "Amman Governorate (Capital)" : "محافظة العاصمة عمان")</option>
                                <option value="Zarqa">@(isEn ? "Zarqa & Ruseifa" : "محافظة الزرقاء والرصيفة")</option>
                                <option value="Irbid">@(isEn ? "Irbid & North" : "محافظة إربد والشمال")</option>
                                <option value="Aqaba">@(isEn ? "Aqaba Special Economic Zone" : "محافظة العقبة والمنطقة الخاصة")</option>
                                <option value="Balqa">@(isEn ? "Balqa (Salt / Fuheis / Mahis)" : "محافظة البلقاء (السلط / الفحيص / ماحص)")</option>
