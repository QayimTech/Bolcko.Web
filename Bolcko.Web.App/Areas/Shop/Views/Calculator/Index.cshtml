                                <input type="checkbox" id="includeCorniceBelt" checked class="mt-0.5 rounded text-amber-600 focus:ring-amber-500" onchange="onInputChange()" />
                                <div>
                                    <p class="text-xs font-bold text-slate-900">@(isEn ? "Decorative Floor Belts & Cornices" : "أحزمة وكرانيش بارزة بين الطوابق")</p>
                                    <p class="text-[11px] text-slate-500">@(isEn ? "Runs along perimeter separating floor levels" : "تمتد على محيط الواجهات لفصل الطوابق معمارياً")</p>
                                </div>
                            </label>

                            <!-- Window Architraves / Frames -->
                            <div class="flex items-center justify-between pt-2 border-t border-slate-200/70">
                                <div>
                                    <label class="text-xs font-bold text-slate-900 block">@(isEn ? "Window Architrave Frames" : "براويز وأقواس النوافذ")</label>
                                    <span class="text-[11px] text-slate-500">@(isEn ? "Decorative stone surrounding window openings" : "إطارات حجرية مزخرفة حول الشبابيك")</span>
                                </div>
                                <div class="flex items-center gap-1.5" dir="ltr">
                                    <button type="button" onclick="adjustWindowFrames(-1)" class="w-7 h-7 rounded-lg bg-white border border-slate-300 font-bold text-xs">-</button>
                                    <span class="text-xs font-bold text-slate-900 font-mono w-8 text-center" id="windowFramesCountDisplay">8</span>
                                    <button type="button" onclick="adjustWindowFrames(1)" class="w-7 h-7 rounded-lg bg-white border border-slate-300 font-bold text-xs">+</button>
                                </div>
                                <input type="hidden" id="windowFramesCount" value="8" />
                            </div>

                            <!-- Entrance Columns -->
                            <div class="flex items-center justify-between pt-2 border-t border-slate-200/70">
                                <div>
                                    <label class="text-xs font-bold text-slate-900 block">@(isEn ? "Entrance Portico Columns" : "أعمدة وتيجان حجرية للمدخل")</label>
                                    <span class="text-[11px] text-slate-500">@(isEn ? "Classical decorative stone columns with capitals" : "أعمدة دائرية مع تيجان وقواعد معمارية")</span>
                                </div>
                                <div class="flex items-center gap-1.5" dir="ltr">
                                    <button type="button" onclick="adjustEntranceColumns(-1)" class="w-7 h-7 rounded-lg bg-white border border-slate-300 font-bold text-xs">-</button>
                                    <span class="text-xs font-bold text-slate-900 font-mono w-8 text-center" id="entranceColumnsCountDisplay">2</span>
                                    <button type="button" onclick="adjustEntranceColumns(1)" class="w-7 h-7 rounded-lg bg-white border border-slate-300 font-bold text-xs">+</button>
