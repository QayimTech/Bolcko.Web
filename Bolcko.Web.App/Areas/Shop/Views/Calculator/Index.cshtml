@model Bolcko.Domain.Entities.Catalog.DTOs.ConstructionEstimateResultDto
@{
    var isRtl = System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
    var isEn = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName.Equals("en", StringComparison.OrdinalIgnoreCase);

    ViewData["Title"] = isEn 
        ? "Construction Cost, Material Quantity & 3D BIM Calculator Jordan 2026 | BLOCKO" 
        : "حاسبة تكلفة وكميات البناء والمجسم المعماري 3D الأردن 2026 | بلوكو لتوريد مواد البناء";
    Layout = "~/Areas/Shop/Views/Shared/_Layout.cshtml";

    var prices = ViewBag.Prices as IEnumerable<Bolcko.Domain.Entities.Catalog.DTOs.MarketPriceDto> ?? Enumerable.Empty<Bolcko.Domain.Entities.Catalog.DTOs.MarketPriceDto>();
    var calcConfig = ViewBag.CalculatorConfig as Bolcko.Domain.Entities.Catalog.DTOs.CalculatorConfigurationDto
                     ?? new Bolcko.Domain.Entities.Catalog.DTOs.CalculatorConfigurationDto();
}

<style>
    /* ══════════════════════ PRINT STYLESHEET ══════════════════════ */
    @@media print {
        header, footer, nav, #quickPresetsContainer, #calcFormContainer, #liveTickerSection, #faqSection, .no-print, .action-buttons-group {
            display: none !important;
        }

        body, main, .calculator-main-wrapper {
            background: #ffffff !important;
            color: #000000 !important;
            padding: 0 !important;
            margin: 0 !important;
            font-size: 11pt !important;
        }

        .print-only-report {
            display: block !important;
        }

        .page-break-avoid {
            page-break-inside: avoid !important;
            break-inside: avoid !important;
        }

        table {
            width: 100% !important;
            border-collapse: collapse !important;
            page-break-inside: auto !important;
        }

        tr {
            page-break-inside: avoid !important;
            page-break-after: auto !important;
        }

        th, td {
            border: 1px solid #cbd5e1 !important;
            padding: 6px 10px !important;
        }

        th {
            background-color: #f1f5f9 !important;
            color: #0f172a !important;
        }
    }

    @@media screen {
        .print-only-report {
            display: none !important;
        }
    }
</style>

<!-- 1. Hero & Quick Project Presets -->
<partial name="Partials/_CalculatorHero" />

<!-- 2. Main Interactive Workspace -->
<div class="calculator-main-wrapper max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 no-print">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

        <!-- Left Column: Tabs & Inputs (Skeleton + Stone + Finishes) -->
        <div id="calcFormContainer" class="lg:col-span-5 space-y-6">
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                
                <!-- Tab Navigation Header -->
                <div class="flex border-b border-slate-200 bg-slate-50/80 p-1.5 gap-1">
                    <button type="button" onclick="BlockoCalculator.switchCalcTab('skeleton')" id="tab-btn-skeleton"
                            class="calc-tab-btn flex-1 py-2.5 px-3 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-1.5 bg-white text-slate-900 shadow-sm border border-slate-200/80 cursor-pointer">
                        <span class="material-symbols-outlined text-base text-indigo-600">foundation</span>
                        <span>@(isEn ? "Skeleton & Steel" : "الهيكل والحديد")</span>
                    </button>
                    <button type="button" onclick="BlockoCalculator.switchCalcTab('stone')" id="tab-btn-stone"
                            class="calc-tab-btn flex-1 py-2.5 px-3 rounded-xl text-xs font-semibold transition-all flex items-center justify-center gap-1.5 text-slate-600 hover:text-slate-900 hover:bg-white/60 cursor-pointer">
                        <span class="material-symbols-outlined text-base text-amber-600">domain</span>
                        <span>@(isEn ? "Stone & Facades" : "الحجر والواجهات")</span>
                    </button>
                    <button type="button" onclick="BlockoCalculator.switchCalcTab('finishes')" id="tab-btn-finishes"
                            class="calc-tab-btn flex-1 py-2.5 px-3 rounded-xl text-xs font-semibold transition-all flex items-center justify-center gap-1.5 text-slate-600 hover:text-slate-900 hover:bg-white/60 cursor-pointer">
                        <span class="material-symbols-outlined text-base text-teal-600">format_paint</span>
                        <span>@(isEn ? "Finishes & MEP" : "تشطيبات وعوازل")</span>
                    </button>
                </div>

                <form id="calcForm" class="p-6 space-y-6" onsubmit="event.preventDefault();">
                    <!-- Tab 1: Structural Specs Partial -->
                    <partial name="Partials/_CalculatorSpecs" />

                    <!-- Tabs 2 & 3: Stone & Finishes Partials -->
                    <partial name="Partials/_CalculatorStoneModule" model="Model" />
                </form>

            </div>
        </div>

        <!-- Right Column: 3D Architectural Digital Twin & BOQ Results -->
        <div class="lg:col-span-7 space-y-6">
            <!-- 3D BIM Viewport Partial -->
            <partial name="Partials/_Calculator3DVisualizer" />

            <!-- BOQ & Estimate Results Partial -->
            <partial name="Partials/_CalculatorResults" model="Model" />
        </div>

    </div>

    <!-- 3. Commodity Prices Ticker Partial -->
    <partial name="Partials/_CalculatorCommodityTicker" />

    <!-- 4. Frequently Asked Questions & Schema.org Partial -->
    <partial name="Partials/_CalculatorFAQs" />
</div>

<!-- 5. Interactive Modals Partial (Sample Box & Encrypted QR Pass) -->
<partial name="Partials/_CalculatorModals" />

@section Scripts {
    <!-- Three.js and OrbitControls via high-speed CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>

    <!-- Blocko Modular 3D & Calculator Engine Scripts -->
    <script src="~/js/calculator/3d-engine.js" asp-append-version="true"></script>
    <script src="~/js/calculator/calculator-core.js" asp-append-version="true"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            BlockoCalculator.init({
                isEnMode: @(isEn ? "true" : "false"),
                config: {
                    enableInsulation: @(calcConfig.EnableInsulationAddon ? "true" : "false"),
                    insulationRate: @(calcConfig.InsulationRatePerM2.ToString(System.Globalization.CultureInfo.InvariantCulture)),
                    enablePainting: @(calcConfig.EnablePaintingAddon ? "true" : "false"),
                    paintRate: @(calcConfig.InteriorPaintRatePerM2.ToString(System.Globalization.CultureInfo.InvariantCulture)),
                    enablePlastering: @(calcConfig.EnablePlasteringAddon ? "true" : "false"),
                    plasterRate: @(calcConfig.PlasteringRatePerM2.ToString(System.Globalization.CultureInfo.InvariantCulture)),
                    enableMEP: @(calcConfig.EnableElectroMechanicalAddon ? "true" : "false"),
                    mepRate: @(calcConfig.ElectroMechanicalRatePerM2.ToString(System.Globalization.CultureInfo.InvariantCulture)),
                    whatsAppNumber: '@(string.IsNullOrWhiteSpace(calcConfig.SalesWhatsAppNumber) ? "962790000000" : calcConfig.SalesWhatsAppNumber)'
                },
                prices: {
                    steel: @((ViewBag.BaselineRates as Bolcko.Domain.Entities.Catalog.DTOs.MaterialBaselineRatesDto)?.SteelRatePerTon.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0"),
                    cement: @((ViewBag.BaselineRates as Bolcko.Domain.Entities.Catalog.DTOs.MaterialBaselineRatesDto)?.CementRatePerTon.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0"),
                    concrete: @((ViewBag.BaselineRates as Bolcko.Domain.Entities.Catalog.DTOs.MaterialBaselineRatesDto)?.ConcreteRatePerM3.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0"),
                    blocks: @((ViewBag.BaselineRates as Bolcko.Domain.Entities.Catalog.DTOs.MaterialBaselineRatesDto)?.BlocksRatePerThousand.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0"),
                    sand: @((ViewBag.BaselineRates as Bolcko.Domain.Entities.Catalog.DTOs.MaterialBaselineRatesDto)?.SandRatePerM3.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0")
                }
            });
        });
    </script>
}
