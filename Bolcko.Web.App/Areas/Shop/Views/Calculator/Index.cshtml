@model Bolcko.Domain.Entities.Catalog.DTOs.ConstructionEstimateResultDto
@{
    var isRtl = System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
    var isEn = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName.Equals("en", StringComparison.OrdinalIgnoreCase);

    ViewData["Title"] = isEn 
        ? "Construction Cost & Material Quantity Calculator Jordan 2026 | BLOCKO" 
        : "حاسبة تكلفة البناء وكميات المواد في الأردن 2026 | بلوكو لتوريد مواد البناء";
    Layout = "~/Areas/Shop/Views/Shared/_Layout.cshtml";
    var prices = ViewBag.Prices as IEnumerable<Bolcko.Domain.Entities.Catalog.DTOs.MarketPriceDto> ?? Enumerable.Empty<Bolcko.Domain.Entities.Catalog.DTOs.MarketPriceDto>();
    var faqs = ViewBag.FAQs as IEnumerable<Bolcko.Domain.Entities.Content.FAQItem> ?? Enumerable.Empty<Bolcko.Domain.Entities.Content.FAQItem>();
    var calcConfig = ViewBag.CalculatorConfig as Bolcko.Domain.Entities.Catalog.DTOs.CalculatorConfigurationDto
                     ?? new Bolcko.Domain.Entities.Catalog.DTOs.CalculatorConfigurationDto();

    var faqEntities = faqs.Select(f => new Dictionary<string, object> {
        ["\u0040type"] = "Question",
        ["name"] = isEn && !string.IsNullOrEmpty(f.QuestionEn) ? f.QuestionEn : f.QuestionAr,
        ["acceptedAnswer"] = new Dictionary<string, object> {
            ["\u0040type"] = "Answer",
            ["text"] = isEn && !string.IsNullOrEmpty(f.AnswerEn) ? f.AnswerEn : f.AnswerAr
        }
    }).ToList();

    var schemaData = new Dictionary<string, object> {
        ["\u0040context"] = "https://schema.org",
        ["\u0040graph"] = new object[] {
            new Dictionary<string, object> {
                ["\u0040type"] = "WebApplication",
                ["name"] = isEn ? "Structural Construction Cost & Quantity Calculator Jordan" : "حاسبة تكلفة وكميات البناء الهندسية الأردن",
                ["url"] = "https://bolcko.com/calculator",
                ["applicationCategory"] = "BusinessApplication",
                ["operatingSystem"] = "All",
                ["description"] = isEn 
                    ? "Smart structural engineering system to estimate rebar steel, ready-mix concrete, cement, masonry blocks, and workmanship costs in Jordan."
                    : "حاسبة هندسية متقدمة لتقدير كميات وتكاليف مواد البناء الإنشائية في الأردن وفق كودات البناء وأسعار السوق اللحظية."
            },
            new Dictionary<string, object> {
                ["\u0040type"] = "BreadcrumbList",
                ["itemListElement"] = new object[] {
                    new Dictionary<string, object> { ["\u0040type"] = "ListItem", ["position"] = 1, ["name"] = isEn ? "Home" : "الرئيسية", ["item"] = "https://bolcko.com" },
                    new Dictionary<string, object> { ["\u0040type"] = "ListItem", ["position"] = 2, ["name"] = isEn ? "Cost Estimator" : "حاسبة تكاليف البناء", ["item"] = "https://bolcko.com/calculator" }
                }
            },
            new Dictionary<string, object> {
                ["\u0040type"] = "FAQPage",
                ["mainEntity"] = faqEntities
            }
        }
    };

    var jsonOptions = new System.Text.Json.JsonSerializerOptions {
        Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
    };
    var schemaJson = System.Text.Json.JsonSerializer.Serialize(schemaData, jsonOptions);

    // Item notes & units localization helper
    string GetItemName(string category, string defaultAr, string defaultEn) {
        return isEn ? (!string.IsNullOrEmpty(defaultEn) ? defaultEn : defaultAr) : defaultAr;
    }

    string GetItemUnit(string category) {
        if (!isEn) {
            return category switch {
                "Steel" => "طن",
                "Concrete" => "م³",
                "Cement" => "كيس",
                "Blocks" => "حبة",
                "Sand" => "م³",
                "Labor" => "م² مسطح",
                "Stone" => "م² واجهات",
                "StoneDecor" => "متر طولي / حبة",
                "StoneLabor" => "م² تركيب",
                _ => "وحدة"
            };
        } else {
            return category switch {
                "Steel" => "Tons",
                "Concrete" => "m³",
                "Cement" => "Bags",
                "Blocks" => "Pcs",
                "Sand" => "m³",
                "Labor" => "m² Built-up",
                "Stone" => "m² Facades",
                "StoneDecor" => "Linear m / Pcs",
                "StoneLabor" => "m² Fixation",
                _ => "Unit"
            };
        }
    }

    string GetItemNote(string category, string noteAr) {
        if (!isEn) return noteAr;
        return category switch {
            "Steel" => "Includes footings, columns, beams & slabs (8-25mm)",
            "Concrete" => "Cast for foundations, beams, columns & slabs with pump",
            "Cement" => "For masonry walls, ground sub-base, and plastering",
            "Blocks" => "For exterior walls, interior partitions, and rib slabs",
            "Sand" => "For mortar mixes, masonry, and ground slabs",
            "Labor" => "Carpentry, steel fixing, concrete casting, and mason workforce",
            "Stone" => "Calibrated building stone with 7% cutting wastage",
            "StoneDecor" => "Decorative floor cornices, window architraves, entrance portico pillars",
            "StoneLabor" => "Mechanical / wet anchors installation, backing concrete cast & mortar joints",
            _ => noteAr
        };
    }
}

<!-- Structured Data for Google Rich Snippets (Schema.org) -->
<script type="application/ld+json">
@Html.Raw(schemaJson)
</script>

<style>
