</div>

@section Scripts {
<!-- Load Three.js and OrbitControls cleanly via reliable high-speed CDN -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>

<script>
    const isEnMode = @(isEn ? "true" : "false");
    let debounceTimer = null;

    const calcAddonConfig = {
        enableInsulation: @(calcConfig.EnableInsulationAddon ? "true" : "false"),
        insulationRate: @calcConfig.InsulationRatePerM2,
        enablePainting: @(calcConfig.EnablePaintingAddon ? "true" : "false"),
        paintRate: @calcConfig.InteriorPaintRatePerM2,
        enablePlastering: @(calcConfig.EnablePlasteringAddon ? "true" : "false"),
        plasterRate: @calcConfig.PlasteringRatePerM2,
        enableMEP: @(calcConfig.EnableElectroMechanicalAddon ? "true" : "false"),
        mepRate: @calcConfig.ElectroMechanicalRatePerM2,
        whatsAppNumber: '@(string.IsNullOrWhiteSpace(calcConfig.SalesWhatsAppNumber) ? "962790000000" : calcConfig.SalesWhatsAppNumber)'
    };

    let latestCalculationData = null;

    // ────────────────────────────────────────────────────────────────
    // 1. DICTIONARY & LOCALIZATION HELPER
    // ────────────────────────────────────────────────────────────────
    const itemDictionary = {
        'Steel': {
            nameEn: 'High-Strength Steel Rebar (Grade 60)',
            nameAr: 'حديد تسليح عالي المقاومة (Grade 60)',
            unitEn: 'Tons',
            unitAr: 'طن',
            noteEn: 'Includes footings, columns, beams & slabs (8-25mm)',
