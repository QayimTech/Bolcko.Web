                            <span class="material-symbols-outlined text-sm text-indigo-400">diamond</span>
                            <span>@(isEn ? "Quarry Type (نوع الحجر):" : "نوع الحجر والمحجر:")</span>
                        </div>
                        <div class="flex items-center gap-1.5 flex-wrap">
                            <button type="button" id="quick-stone-Natural_Ruwaished" onclick="quickSetStone('Natural_Ruwaished')"
                                    class="quick-stone-chip px-3 py-1 rounded-lg text-xs font-bold bg-indigo-600 text-white border border-indigo-400 shadow-sm flex items-center gap-1 transition-all cursor-pointer">
