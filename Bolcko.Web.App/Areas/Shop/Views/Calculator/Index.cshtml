    // ────────────────────────────────────────────────────────────────
    // HIGH-DEFINITION PROCEDURAL JORDANIAN STONE TEXTURE ENGINE
    // Dual Maps: High-res Diffuse + Micro-relief Bump Map (ملمس ونحت بالملي)
    // ────────────────────────────────────────────────────────────────
    function getProceduralStoneMaps(stoneType, stoneFinish) {
        const key = `${stoneType}_${stoneFinish}`;
        if (stoneTextureCache[key]) return stoneTextureCache[key];

        const diffCanvas = document.createElement('canvas');
        diffCanvas.width = 1024;
        diffCanvas.height = 1024;
        const diffCtx = diffCanvas.getContext('2d');

        const bumpCanvas = document.createElement('canvas');
        bumpCanvas.width = 1024;
        bumpCanvas.height = 1024;
        const bumpCtx = bumpCanvas.getContext('2d');

        // Color palettes (Read dynamic color from DOM or fallback)
        let baseR = 224, baseG = 208, baseB = 180; // Default warm desert beige
        let jointColor = '#3f3629'; // Deep recessed mortar joint (كحلة عميقة)
        let highlightColor = 'rgba(255,255,255,0.4)';
        let shadowColor = 'rgba(30,22,12,0.5)';

        const radioEl = document.querySelector(`input[name="stoneType"][value="${stoneType}"]`);
        const hexColor = radioEl ? radioEl.dataset.color : null;

        if (hexColor && hexColor.startsWith('#') && hexColor.length === 7) {
            baseR = parseInt(hexColor.slice(1, 3), 16);
            baseG = parseInt(hexColor.slice(3, 5), 16);
            baseB = parseInt(hexColor.slice(5, 7), 16);
        } else if (stoneType === 'Natural_Maan') {
            baseR = 248; baseG = 246; baseB = 240; // Ma'an pure crystalline white
            jointColor = '#5c5446';
            highlightColor = 'rgba(255,255,255,0.6)';
            shadowColor = 'rgba(40,36,30,0.4)';
        } else if (stoneType === 'Artificial_HighDensity') {
            baseR = 212; baseG = 208; baseB = 200; // Engineered architectural cast
            jointColor = '#38342c';
            highlightColor = 'rgba(255,255,255,0.45)';
            shadowColor = 'rgba(20,20,20,0.45)';
        }

        // Fill Diffuse Base
        diffCtx.fillStyle = `rgb(${baseR}, ${baseG}, ${baseB})`;
        diffCtx.fillRect(0, 0, 1024, 1024);

        // Fill Bump Base (128 is neutral mid-gray)
        bumpCtx.fillStyle = '#808080';
        bumpCtx.fillRect(0, 0, 1024, 1024);

        // 16 Jordanian Courses (25cm height per course)
        const numCourses = 16;
        const courseHeight = 1024 / numCourses; // 64px

        for (let r = 0; r < numCourses; r++) {
            const y = r * courseHeight;
            const courseOffset = (r % 2) * 115;
            let x = -courseOffset;

            while (x < 1024 + 300) {
                const seed = Math.abs(Math.floor((r * 47.3 + x * 19.7) % 100));
                const blockWidth = 110 + (seed % 140);

                // Natural quarry color variation (+/- 14)
                const tint = (seed % 28) - 14;
                const rCol = Math.min(255, Math.max(0, baseR + tint));
                const gCol = Math.min(255, Math.max(0, baseG + tint));
                const bCol = Math.min(255, Math.max(0, baseB + tint));

                // Diffuse Block Face
                diffCtx.fillStyle = `rgb(${rCol}, ${gCol}, ${bCol})`;
                diffCtx.fillRect(x + 2, y + 2, blockWidth - 4, courseHeight - 4);

                // Bump Block Face base elevation (slightly raised above mortar)
                bumpCtx.fillStyle = '#a0a0a0';
                bumpCtx.fillRect(x + 2, y + 2, blockWidth - 4, courseHeight - 4);

                // Finish micro-sculpting (طبزة / مسمسم / مفجر)
                if (stoneFinish === 'Tabzeh') {
                    // Pronounced 3D pillow face (طبزة جبلية بارزة مقوسة)
                    const grad = diffCtx.createRadialGradient(
                        x + blockWidth / 2, y + courseHeight / 2, 8,
                        x + blockWidth / 2, y + courseHeight / 2, courseHeight * 0.9
                    );
                    grad.addColorStop(0, highlightColor);
                    grad.addColorStop(0.7, 'transparent');
                    grad.addColorStop(1, shadowColor);
                    diffCtx.fillStyle = grad;
                    diffCtx.fillRect(x + 2, y + 2, blockWidth - 4, courseHeight - 4);

                    // Bump pillow gradient (white in center, darker at edges)
                    const bGrad = bumpCtx.createRadialGradient(
                        x + blockWidth / 2, y + courseHeight / 2, 4,
                        x + blockWidth / 2, y + courseHeight / 2, courseHeight * 0.85
                    );
                    bGrad.addColorStop(0, '#ffffff');
                    bGrad.addColorStop(0.6, '#bfbfbf');
                    bGrad.addColorStop(1, '#666666');
                    bumpCtx.fillStyle = bGrad;
                    bumpCtx.fillRect(x + 2, y + 2, blockWidth - 4, courseHeight - 4);
                } else if (stoneFinish === 'Musamsam') {
                    // Crisp parallel chisel lines (مسمسم بالشوكة ونقش حاد)
                    diffCtx.strokeStyle = shadowColor;
                    diffCtx.lineWidth = 1.2;
                    bumpCtx.lineWidth = 1.5;
                    for (let line = 6; line < blockWidth - 6; line += 5.5) {
                        diffCtx.beginPath();
                        diffCtx.moveTo(x + line, y + 3);
                        diffCtx.lineTo(x + line, y + courseHeight - 3);
                        diffCtx.stroke();

                        // Bump groove (dark incised channel)
                        bumpCtx.strokeStyle = '#404040';
                        bumpCtx.beginPath();
                        bumpCtx.moveTo(x + line, y + 3);
                        bumpCtx.lineTo(x + line, y + courseHeight - 3);
                        bumpCtx.stroke();

                        // Bump ridge highlight (bright tooth edge next to groove)
                        bumpCtx.strokeStyle = '#d4d4d4';
                        bumpCtx.beginPath();
                        bumpCtx.moveTo(x + line + 1.5, y + 3);
                        bumpCtx.lineTo(x + line + 1.5, y + courseHeight - 3);
                        bumpCtx.stroke();
                    }
                } else {
                    // Mufajjar split-face pitting & bush-hammered texture (مفجر طبيعي)
                    diffCtx.fillStyle = shadowColor;
                    for (let p = 0; p < 35; p++) {
                        const px = x + 4 + ((p * 37 + seed) % (blockWidth - 8));
                        const py = y + 3 + ((p * 59 + seed) % (courseHeight - 6));
                        diffCtx.fillRect(px, py, 2.5, 2.5);

                        // Micro bump divots
                        bumpCtx.fillStyle = (p % 2 === 0) ? '#383838' : '#e6e6e6';
                        bumpCtx.fillRect(px, py, 2.5, 2.5);
                    }
                }

                // 3D Bevel Edge Highlights
                diffCtx.fillStyle = highlightColor;
                diffCtx.fillRect(x + 2, y + 2, blockWidth - 4, 2);
                diffCtx.fillRect(x + 2, y + 2, 2, courseHeight - 4);

                diffCtx.fillStyle = shadowColor;
                diffCtx.fillRect(x + 2, y + courseHeight - 4, blockWidth - 4, 2);
                diffCtx.fillRect(x + blockWidth - 4, y + 2, 2, courseHeight - 4);

                // Vertical dark mortar joint (حل عمودي غائر)
                diffCtx.fillStyle = jointColor;
                diffCtx.fillRect(x + blockWidth - 2.5, y, 5, courseHeight);

                bumpCtx.fillStyle = '#101010'; // Deep recessed joint in bump map
                bumpCtx.fillRect(x + blockWidth - 2.5, y, 5, courseHeight);

                x += blockWidth;
            }

            // Horizontal dark bed joint (كحلة أفقية عميقة بين المداميك)
            diffCtx.fillStyle = jointColor;
            diffCtx.fillRect(0, y + courseHeight - 3, 1024, 5);

            bumpCtx.fillStyle = '#0a0a0a';
            bumpCtx.fillRect(0, y + courseHeight - 3, 1024, 5);
        }

        const diffTexture = new THREE.CanvasTexture(diffCanvas);
        diffTexture.wrapS = THREE.RepeatWrapping;
        diffTexture.wrapT = THREE.RepeatWrapping;
        diffTexture.repeat.set(3, 3);
        if (threeRenderer) {
            diffTexture.anisotropy = threeRenderer.capabilities.getMaxAnisotropy();
        }

        const bumpTexture = new THREE.CanvasTexture(bumpCanvas);
        bumpTexture.wrapS = THREE.RepeatWrapping;
        bumpTexture.wrapT = THREE.RepeatWrapping;
        bumpTexture.repeat.set(3, 3);
        if (threeRenderer) {
            bumpTexture.anisotropy = threeRenderer.capabilities.getMaxAnisotropy();
        }

        const result = { diffuse: diffTexture, bump: bumpTexture };
        stoneTextureCache[key] = result;
        return result;
    }

    function initOrResize3D() {
        const canvas = document.getElementById('threeCanvas');
        if (!canvas) return;

        const container = canvas.parentElement;
        const width = container.clientWidth || 400;
        const height = container.clientHeight || 460;

        if (!isThreeInitialized && typeof THREE !== 'undefined') {
            threeScene = new THREE.Scene();
            threeScene.background = new THREE.Color(0x1e293b); // Elegant dark architectural studio
            threeScene.fog = new THREE.FogExp2(0x1e293b, 0.015);

            threeCamera = new THREE.PerspectiveCamera(38, width / height, 0.1, 100);
            threeCamera.position.set(0.5, 3.8, 13.5); // Direct front hero view!

            threeRenderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, alpha: true });
            threeRenderer.setSize(width, height);
            threeRenderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            threeRenderer.shadowMap.enabled = true;
            threeRenderer.shadowMap.type = THREE.PCFSoftShadowMap;
            threeRenderer.toneMapping = THREE.ACESFilmicToneMapping;
            threeRenderer.toneMappingExposure = 1.08;

            if (typeof THREE.OrbitControls !== 'undefined') {
                threeControls = new THREE.OrbitControls(threeCamera, threeRenderer.domElement);
                threeControls.enableDamping = true;
                threeControls.dampingFactor = 0.05;
                threeControls.maxPolarAngle = Math.PI / 2 - 0.02;
                threeControls.minDistance = 1.5; // Micro-zoom capability down to the millimeter!
                threeControls.maxDistance = 35;
                threeControls.target.set(0, 2.5, 0);
            }

            // Studio Architectural Lighting
            const hemiLight = new THREE.HemisphereLight(0xffffff, 0x334155, 0.75);
            threeScene.add(hemiLight);

            // Sun Key Light with sharp shadows
            const sunLight = new THREE.DirectionalLight(0xfffbeb, 1.45);
            sunLight.position.set(14, 22, 16);
            sunLight.castShadow = true;
            sunLight.shadow.mapSize.width = 2048;
            sunLight.shadow.mapSize.height = 2048;
            sunLight.shadow.bias = -0.0003;
            threeScene.add(sunLight);

            // Soft Fill Light
            const fillLight = new THREE.DirectionalLight(0x93c5fd, 0.4);
            fillLight.position.set(-14, 12, -10);
            threeScene.add(fillLight);

            // Architectural Plinth Podium (Luxury Presentation Base)
            const plinthGeo = new THREE.CylinderGeometry(15, 16, 0.4, 48);
            const plinthMat = new THREE.MeshStandardMaterial({ color: 0x0f172a, roughness: 0.85 });
            const plinthMesh = new THREE.Mesh(plinthGeo, plinthMat);
            plinthMesh.position.y = -0.2;
            plinthMesh.receiveShadow = true;
            threeScene.add(plinthMesh);

            // Paved Entrance Plaza
            const plazaGeo = new THREE.BoxGeometry(16, 0.1, 14);
            const plazaMat = new THREE.MeshStandardMaterial({ color: 0x475569, roughness: 0.65 });
            const plazaMesh = new THREE.Mesh(plazaGeo, plazaMat);
            plazaMesh.position.set(0, 0.02, 1.0);
            plazaMesh.receiveShadow = true;
            threeScene.add(plazaMesh);

            isThreeInitialized = true;
            animate3D();
        } else if (threeRenderer && threeCamera) {
            threeRenderer.setSize(width, height);
            threeCamera.aspect = width / height;
            threeCamera.updateProjectionMatrix();
        }

        update3DScene();
    }

    function animate3D() {
        if (!isThreeInitialized) return;
        requestAnimationFrame(animate3D);
        if (threeControls) threeControls.update();
        if (threeRenderer && threeScene && threeCamera) {
            threeRenderer.render(threeScene, threeCamera);
        }
    }

    // ────────────────────────────────────────────────────────────────
    // DETAILED ARCHITECTURAL SCENE BUILDER (WITH MILLIMETER DETAIL)
    // ────────────────────────────────────────────────────────────────
    function update3DScene() {
        if (!isThreeInitialized || !threeScene) return;

        const floors = parseInt(document.getElementById('floorsInput')?.value || 2);
        const area = parseFloat(document.getElementById('areaInput')?.value || 250);
        const stoneType = document.querySelector('input[name="stoneType"]:checked')?.value || "Natural_Ruwaished";
        const stoneFinish = document.querySelector('input[name="stoneFinish"]:checked')?.value || "Mufajjar";
        const columnBars = document.querySelector('input[name="columnBarsCount"]:checked')?.value || "6Bars";
        const stoneEnabled = document.getElementById('enableStoneModule')?.checked ?? true;
        const includeCornice = document.getElementById('includeCorniceBelt')?.checked ?? true;
        const windowCount = parseInt(document.getElementById('windowFramesCount')?.value || 8);
        const entranceCols = parseInt(document.getElementById('entranceColumnsCount')?.value || 2);

        // Update Info Bar text (Outside Canvas)
        const overlay = document.getElementById('canvasOverlayInfo');
        if (overlay) {
            const stoneName = stoneType === "Natural_Ruwaished" ? (isEnMode ? "Ruwaished Stone" : "حجر رويشد") :
                             (stoneType === "Natural_Maan" ? (isEnMode ? "Ma'an White Stone" : "حجر معان أبيض") :
                             (isEnMode ? "Engineered Stone" : "حجر صناعي"));
            const styleName = currentArchStyle === 'apartment' ? (isEnMode ? "Apartments" : "عمارة سكنية") :
                              (currentArchStyle === 'modern' ? (isEnMode ? "Modern Villa" : "فيلا مودرن") :
                              (isEnMode ? "Classic Villa" : "فيلا كلاسيك"));
            overlay.innerText = `${styleName} • ${floors} ${isEnMode ? 'Floors' : 'طوابق'} • ${stoneEnabled ? stoneName : (isEnMode ? 'Skeleton' : 'عظم')} • ${columnBars}`;
        }

        if (houseGroup) threeScene.remove(houseGroup);
        if (skeletonGroup) threeScene.remove(skeletonGroup);

        houseGroup = new THREE.Group();
        skeletonGroup = new THREE.Group();

        const baseWidth = Math.min(10.5, Math.max(7.0, Math.sqrt(area) * 0.46));
        const baseDepth = baseWidth * 0.82;
        const floorHeight = 2.8;

        // Realistic Materials with Contrast
        // Realistic Materials with Contrast & PBR Micro Relief
        const stoneMaps = getProceduralStoneMaps(stoneType, stoneFinish);
        const stoneTrimColor = stoneType === "Natural_Maan" ? 0xffffff : (stoneType === "Natural_Ruwaished" ? 0xd6c29e : 0xb5afa3);
        const stonePlinthColor = stoneType === "Natural_Maan" ? 0xd4cebe : 0x8a7b66;

        const wallMaterial = new THREE.MeshStandardMaterial({
            map: stoneMaps.diffuse,
            bumpMap: stoneMaps.bump,
            bumpScale: stoneFinish === 'Tabzeh' ? 0.08 : (stoneFinish === 'Musamsam' ? 0.045 : 0.035),
            roughness: stoneFinish === 'Tabzeh' ? 0.65 : (stoneFinish === 'Musamsam' ? 0.7 : 0.75),
            metalness: 0.02,
            transparent: true,
            opacity: isXRayMode ? 0.18 : 1.0
        });

        const stonePlinthMaterial = new THREE.MeshStandardMaterial({
            color: stonePlinthColor,
            roughness: 0.8,
            transparent: true,
            opacity: isXRayMode ? 0.25 : 1.0
        });

        const stoneTrimMaterial = new THREE.MeshStandardMaterial({
            color: stoneTrimColor,
            roughness: 0.55,
            transparent: true,
            opacity: isXRayMode ? 0.25 : 1.0
        });

        const floorSlabMaterial = new THREE.MeshStandardMaterial({
            color: 0xd8d4cb,
            roughness: 0.7,
            transparent: true,
            opacity: isXRayMode ? 0.35 : 1.0
        });

        const glassMaterial = new THREE.MeshStandardMaterial({
            color: 0x071526,
            roughness: 0.04,
            metalness: 0.9,
            transparent: true,
            opacity: 0.85
        });

        const darkMetalMaterial = new THREE.MeshStandardMaterial({
            color: 0x0f172a, // Charcoal black aluminum
            roughness: 0.25,
            metalness: 0.7
        });

        const woodDoorMaterial = new THREE.MeshStandardMaterial({
            color: 0x3d1c06, // Dark mahogany wood
            roughness: 0.45
        });

        const handleMaterial = new THREE.MeshStandardMaterial({
            color: 0xf1f5f9, // Brushed stainless steel
            metalness: 0.95,
            roughness: 0.1
        });

        // ─────────────────────────────────────────────────────────────
        // 1. BASE PLINTH COURSE (مدماك السلسال الحجري السفلي)
        // ─────────────────────────────────────────────────────────────
        const plinthHeight = 0.45;
        const plinthGeo = new THREE.BoxGeometry(baseWidth + 0.16, plinthHeight, baseDepth + 0.16);
        const plinthMesh = new THREE.Mesh(plinthGeo, stonePlinthMaterial);
        plinthMesh.position.set(0, plinthHeight / 2, 0);
        plinthMesh.receiveShadow = true;
        houseGroup.add(plinthMesh);

        // ─────────────────────────────────────────────────────────────
        // 2. DETAILED FLOORS & ARCHITECTURAL ELEMENTS
        // ─────────────────────────────────────────────────────────────
        const isClassic = currentArchStyle === 'classic';
        const isApartment = currentArchStyle === 'apartment';
        const isModern = currentArchStyle === 'modern';

        for (let i = 0; i < floors; i++) {
            const floorY = i * floorHeight;

            // Main Floor Walls
            let fW = baseWidth;
            let fD = baseDepth;
            let fX = 0;
            let fZ = 0;

            if (isModern && i === 1) {
                // Cantilevered upper volume
                fW = baseWidth * 0.96;
                fD = baseDepth * 1.08;
                fX = 0.35;
                fZ = 0.35;
            }

            const floorGeo = new THREE.BoxGeometry(fW, floorHeight, fD);
            const floorMesh = new THREE.Mesh(floorGeo, wallMaterial);
            floorMesh.position.set(fX, floorY + floorHeight / 2, fZ);
            floorMesh.castShadow = !isXRayMode;
            floorMesh.receiveShadow = true;
            houseGroup.add(floorMesh);

            // Architectural Corner Quoins (أحجار زوايا كلاسيكية بارزة بتناوب)
            if (isClassic || isApartment) {
                const quoinCourseH = 0.25;
                const numQuoins = Math.floor(floorHeight / quoinCourseH);
                for (let q = 0; q < numQuoins; q++) {
                    const qY = floorY + (q * quoinCourseH) + quoinCourseH / 2;
                    const isLong = (q % 2 === 0);
                    const qLength = isLong ? 0.65 : 0.42;
                    const qDepth = isLong ? 0.42 : 0.65;
                    const qGeo = new THREE.BoxGeometry(qLength, quoinCourseH - 0.02, qDepth);

                    // 4 Corner Placements
                    [
                        [fX - fW / 2 + qLength / 2 - 0.02, fZ - fD / 2 + qDepth / 2 - 0.02],
                        [fX + fW / 2 - qLength / 2 + 0.02, fZ - fD / 2 + qDepth / 2 - 0.02],
                        [fX - fW / 2 + qLength / 2 - 0.02, fZ + fD / 2 - qDepth / 2 + 0.02],
                        [fX + fW / 2 - qLength / 2 + 0.02, fZ + fD / 2 - qDepth / 2 + 0.02]
                    ].forEach(pos => {
                        const qMesh = new THREE.Mesh(qGeo, stoneTrimMaterial);
                        qMesh.position.set(pos[0], qY, pos[1]);
                        qMesh.castShadow = true;
                        houseGroup.add(qMesh);
                    });
                }
            }

            // Floor Division Slab
            const slabGeo = new THREE.BoxGeometry(fW + 0.32, 0.22, fD + 0.32);
            const slabMesh = new THREE.Mesh(slabGeo, floorSlabMaterial);
            slabMesh.position.set(fX, floorY + floorHeight, fZ);
            slabMesh.receiveShadow = true;
            slabMesh.castShadow = true;
            houseGroup.add(slabMesh);

            // Multi-Tiered Stone Cornice Belt
            if (includeCornice && i < floors - 1) {
                const beltGeo = new THREE.BoxGeometry(fW + 0.54, 0.26, fD + 0.54);
                const beltMesh = new THREE.Mesh(beltGeo, stoneTrimMaterial);
                beltMesh.position.set(fX, floorY + floorHeight + 0.13, fZ);
                beltMesh.castShadow = true;
                houseGroup.add(beltMesh);
            }

            // ─────────────────────────────────────────────────────────
            // FRONT FACADE: GRAND ENTRANCE (Floor 0) OR BALCONY (Floor > 0)
            // ─────────────────────────────────────────────────────────
            const frontZ = fZ + fD / 2;

            if (i === 0) {
                // GROUND FLOOR GRAND ENTRANCE DOOR (المدخل الرئيسي)
                const doorW = 1.8;
                const doorH = 2.4;
                const doorY = floorY + doorH / 2 + 0.05;

                // Recessed Door Frame
                const doorFrameGeo = new THREE.BoxGeometry(doorW + 0.3, doorH + 0.25, 0.12);
                const doorFrame = new THREE.Mesh(doorFrameGeo, stoneTrimMaterial);
                doorFrame.position.set(fX, doorY, frontZ + 0.02);
                houseGroup.add(doorFrame);

                // Wood Door Leaf
                const doorGeo = new THREE.BoxGeometry(doorW, doorH, 0.06);
                const doorMesh = new THREE.Mesh(doorGeo, woodDoorMaterial);
                doorMesh.position.set(fX, doorY, frontZ + 0.03);
                houseGroup.add(doorMesh);

                // Door Glass Panels
                [-0.4, 0.4].forEach(gx => {
                    const dGlassGeo = new THREE.BoxGeometry(0.35, 1.4, 0.08);
                    const dGlass = new THREE.Mesh(dGlassGeo, glassMaterial);
                    dGlass.position.set(fX + gx, doorY + 0.2, frontZ + 0.03);
                    houseGroup.add(dGlass);

                    // Stainless Steel Vertical Door Pulls (مقابض ستانلس فخمة)
                    const handleGeo = new THREE.CylinderGeometry(0.018, 0.018, 0.8, 12);
                    const handleMesh = new THREE.Mesh(handleGeo, handleMaterial);
                    handleMesh.position.set(fX + gx * 0.4, doorY, frontZ + 0.1);
                    houseGroup.add(handleMesh);
                });

                // Transom Arched Window over Door (قوس زجاجي أعلى المدخل)
                if (isClassic) {
                    const transGeo = new THREE.CylinderGeometry(doorW * 0.5, doorW * 0.5, 0.08, 16, 1, false, 0, Math.PI);
                    const transMesh = new THREE.Mesh(transGeo, stoneTrimMaterial);
                    transMesh.rotation.z = Math.PI / 2;
                    transMesh.rotation.x = Math.PI / 2;
                    transMesh.position.set(fX, doorY + doorH / 2 + 0.02, frontZ + 0.03);
                    houseGroup.add(transMesh);
                }

                // Ground Entrance Steps (درجات المدخل الحجرية)
                for (let st = 0; st < 3; st++) {
                    const stepW = doorW + 1.6 - st * 0.3;
                    const stepD = 1.0 + (3 - st) * 0.35;
                    const stepH = 0.14;
                    const stepGeo = new THREE.BoxGeometry(stepW, stepH, stepD);
                    const stepMesh = new THREE.Mesh(stepGeo, stoneTrimMaterial);
                    stepMesh.position.set(fX, (st + 1) * (stepH / 2), frontZ + stepD / 2);
                    stepMesh.receiveShadow = true;
                    houseGroup.add(stepMesh);
                }

                // Flanking Windows on Ground Floor
                [-baseWidth * 0.32, baseWidth * 0.32].forEach(wx => {
                    buildDetailedWindow(houseGroup, fX + wx, floorY + floorHeight * 0.55, frontZ, 1.3, 1.4, 'front', stoneTrimMaterial, glassMaterial, darkMetalMaterial, isClassic, windowCount);
                });

            } else {
                // UPPER FLOORS: BALCONY + FRENCH DOORS (شرفة وبرندة ودرابزين)
                const balcW = baseWidth * 0.48;
                const balcD = 1.35;
                const balcY = floorY + 0.12;

                // Balcony Cantilevered Stone Slab
                const bSlabGeo = new THREE.BoxGeometry(balcW, 0.22, balcD);
                const bSlabMesh = new THREE.Mesh(bSlabGeo, stoneTrimMaterial);
                bSlabMesh.position.set(fX, balcY, frontZ + balcD / 2);
                bSlabMesh.castShadow = true;
                houseGroup.add(bSlabMesh);

                // French Balcony Double Doors (باب الشرفة الزجاجي)
                const fDoorGeo = new THREE.BoxGeometry(balcW * 0.75, 2.1, 0.06);
                const fDoor = new THREE.Mesh(fDoorGeo, glassMaterial);
                fDoor.position.set(fX, floorY + 1.15, frontZ + 0.02);
                houseGroup.add(fDoor);

                // French Door Frame
                const fFrameGeo = new THREE.BoxGeometry(balcW * 0.75 + 0.2, 2.2, 0.08);
                const fFrame = new THREE.Mesh(fFrameGeo, stoneTrimMaterial);
                fFrame.position.set(fX, floorY + 1.15, frontZ - 0.02);
                houseGroup.add(fFrame);

                // REAL 3D ARCHITECTURAL BALUSTRADE / RAILING (درابزين مفرغ واضح بالملي)
                const railH = 0.9;
                const topRailGeo = new THREE.BoxGeometry(balcW, 0.06, 0.06);
                const topRail = new THREE.Mesh(topRailGeo, darkMetalMaterial);
                topRail.position.set(fX, balcY + railH, frontZ + balcD - 0.03);
                topRail.castShadow = true;
                houseGroup.add(topRail);

                // Side handrails
                [-balcW / 2 + 0.03, balcW / 2 - 0.03].forEach(sideX => {
                    const sideRailGeo = new THREE.BoxGeometry(0.06, 0.06, balcD);
                    const sideRail = new THREE.Mesh(sideRailGeo, darkMetalMaterial);
                    sideRail.position.set(fX + sideX, balcY + railH, frontZ + balcD / 2);
                    houseGroup.add(sideRail);
                });

                // Vertical Spindles / Balusters (قضبان الدرابزين الرأسية المفرغة)
                const numSpindles = Math.floor(balcW / 0.16);
                for (let s = 0; s <= numSpindles; s++) {
                    const spX = -balcW / 2 + (s * (balcW / numSpindles));
                    const spGeo = new THREE.CylinderGeometry(0.012, 0.012, railH - 0.06, 8);
                    const spMesh = new THREE.Mesh(spGeo, darkMetalMaterial);
                    spMesh.position.set(fX + spX, balcY + railH / 2, frontZ + balcD - 0.03);
                    spMesh.castShadow = true;
                    houseGroup.add(spMesh);
                }

                // Flanking Windows on Upper Floors
                [-baseWidth * 0.32, baseWidth * 0.32].forEach(wx => {
                    buildDetailedWindow(houseGroup, fX + wx, floorY + floorHeight * 0.55, frontZ, 1.3, 1.4, 'front', stoneTrimMaterial, glassMaterial, darkMetalMaterial, isClassic, windowCount);
                });
            }

            // ─────────────────────────────────────────────────────────
            // SIDE FACADES: REAL WINDOWS (شبابيك على الواجهات الجانبية)
            // ─────────────────────────────────────────────────────────
            [-fD * 0.22, fD * 0.22].forEach(sideZ => {
                // Right Wall Window
                buildDetailedWindow(houseGroup, fX + fW / 2, floorY + floorHeight * 0.55, fZ + sideZ, 1.15, 1.35, 'side-right', stoneTrimMaterial, glassMaterial, darkMetalMaterial, isClassic, windowCount);
                // Left Wall Window
                buildDetailedWindow(houseGroup, fX - fW / 2, floorY + floorHeight * 0.55, fZ + sideZ, 1.15, 1.35, 'side-left', stoneTrimMaterial, glassMaterial, darkMetalMaterial, isClassic, windowCount);
            });
        }

        // ─────────────────────────────────────────────────────────────
        // 3. ROOF PARAPET & COPING STONES (تصوينة السطح المكسوة)
        // ─────────────────────────────────────────────────────────────
        const topY = floors * floorHeight;
        const parapetH = 0.75;
        const parapetGeo = new THREE.BoxGeometry(baseWidth + 0.12, parapetH, baseDepth + 0.12);
        const parapetMesh = new THREE.Mesh(parapetGeo, wallMaterial);
        parapetMesh.position.set(0, topY + parapetH / 2, 0);
        parapetMesh.castShadow = true;
        houseGroup.add(parapetMesh);

        // Coping Stone Cap (كشطة حجر علوية مائلة)
        const copingGeo = new THREE.BoxGeometry(baseWidth + 0.36, 0.12, baseDepth + 0.36);
        const copingMesh = new THREE.Mesh(copingGeo, stoneTrimMaterial);
        copingMesh.position.set(0, topY + parapetH + 0.06, 0);
        copingMesh.castShadow = true;
        houseGroup.add(copingMesh);

        // Rooftop Penthouse / Stairwell (بيت الدرج)
        const stairW = 3.2;
        const stairH = 2.4;
        const stairD = 3.4;
        const stairGeo = new THREE.BoxGeometry(stairW, stairH, stairD);
        const stairMesh = new THREE.Mesh(stairGeo, wallMaterial);
        stairMesh.position.set(-baseWidth * 0.18, topY + stairH / 2, -baseDepth * 0.1);
        stairMesh.castShadow = true;
        houseGroup.add(stairMesh);

        // Penthouse Door & Coping
        const stCopingGeo = new THREE.BoxGeometry(stairW + 0.25, 0.1, stairD + 0.25);
        const stCoping = new THREE.Mesh(stCopingGeo, stoneTrimMaterial);
        stCoping.position.set(-baseWidth * 0.18, topY + stairH + 0.05, -baseDepth * 0.1);
        houseGroup.add(stCoping);

        // ─────────────────────────────────────────────────────────────
        // 4. CLASSICAL ENTRANCE COLUMNS & PORTICO (أعمدة وتيجان حجرية)
        // ─────────────────────────────────────────────────────────────
        if (entranceCols > 0 && isClassic) {
            const colH = floorHeight * 0.95;
            const colZ = baseDepth / 2 + 1.25;

            [-1.35, 1.35].forEach(cx => {
                // Base (قاعدة العامود الحجرية)
                const bGeo = new THREE.BoxGeometry(0.55, 0.22, 0.55);
                const bMesh = new THREE.Mesh(bGeo, stoneTrimMaterial);
                bMesh.position.set(cx, 0.22, colZ);
                houseGroup.add(bMesh);

                // Shaft (عامود دائري رشيق)
                const sGeo = new THREE.CylinderGeometry(0.16, 0.19, colH - 0.45, 24);
                const sMesh = new THREE.Mesh(sGeo, stoneTrimMaterial);
                sMesh.position.set(cx, 0.22 + (colH - 0.45) / 2 + 0.1, colZ);
                sMesh.castShadow = true;
                houseGroup.add(sMesh);

                // Capital (تاج العامود الروماني المنحوت)
                const cGeo = new THREE.BoxGeometry(0.52, 0.2, 0.52);
                const cMesh = new THREE.Mesh(cGeo, stoneTrimMaterial);
                cMesh.position.set(cx, 0.22 + colH - 0.2, colZ);
                cMesh.castShadow = true;
                houseGroup.add(cMesh);
            });

            // Portico Canopy Slab (مظلة المدخل الحجرية)
            const canGeo = new THREE.BoxGeometry(3.8, 0.28, 1.8);
            const canMesh = new THREE.Mesh(canGeo, stoneTrimMaterial);
            canMesh.position.set(0, 0.22 + colH, colZ);
            canMesh.castShadow = true;
            houseGroup.add(canMesh);

            // Classical Triangular Pediment (جملون حجر مدخل فخم)
            const pedGeo = new THREE.CylinderGeometry(1.9, 1.9, 0.24, 3);
            const pedMesh = new THREE.Mesh(pedGeo, stoneTrimMaterial);
            pedMesh.rotation.z = Math.PI;
            pedMesh.position.set(0, 0.22 + colH + 0.46, colZ);
            pedMesh.castShadow = true;
            houseGroup.add(pedMesh);
        }

        // ─────────────────────────────────────────────────────────────
        // 5. SKELETON REBAR & COLUMNS (X-Ray Engineering)
        // ─────────────────────────────────────────────────────────────
        const colTotalH = floors * floorHeight;
        const rebarCageMat = new THREE.MeshStandardMaterial({ color: 0x4338ca, roughness: 0.4, wireframe: true });
        const rebarBarMat = new THREE.MeshStandardMaterial({ color: 0xef4444 });

        const colPositions = [
            [-baseWidth * 0.42, -baseDepth * 0.42],
            [baseWidth * 0.42, -baseDepth * 0.42],
            [-baseWidth * 0.42, baseDepth * 0.42],
            [baseWidth * 0.42, baseDepth * 0.42],
            [0, -baseDepth * 0.42],
            [0, baseDepth * 0.42]
        ];

        colPositions.forEach(pos => {
            const cGeo = new THREE.BoxGeometry(0.4, colTotalH, 0.4);
            const cMesh = new THREE.Mesh(cGeo, rebarCageMat);
            cMesh.position.set(pos[0], colTotalH / 2, pos[1]);
            skeletonGroup.add(cMesh);

            const barCount = columnBars === "8Bars" ? 8 : (columnBars === "10Bars" ? 10 : 6);
            for (let b = 0; b < barCount; b++) {
                const barGeo = new THREE.CylinderGeometry(0.016, 0.016, colTotalH, 8);
                const barMesh = new THREE.Mesh(barGeo, rebarBarMat);
                const angle = (b / barCount) * Math.PI * 2;
                const r = 0.14;
                barMesh.position.set(pos[0] + Math.cos(angle) * r, colTotalH / 2, pos[1] + Math.sin(angle) * r);
                skeletonGroup.add(barMesh);
            }

            const footingGeo = new THREE.BoxGeometry(1.1, 0.38, 1.1);
            const footingMat = new THREE.MeshStandardMaterial({ color: 0x334155 });
            const footingMesh = new THREE.Mesh(footingGeo, footingMat);
            footingMesh.position.set(pos[0], 0.19, pos[1]);
            skeletonGroup.add(footingMesh);
        });

        skeletonGroup.visible = isXRayMode;

        threeScene.add(houseGroup);
        threeScene.add(skeletonGroup);
    }

    // Helper: Detailed Recessed Window with Stone Surround, Sill & Arch
    function buildDetailedWindow(group, posX, posY, posZ, width, height, orientation, trimMat, glassMat, metalMat, isClassic, windowCount) {
        const isSide = orientation.startsWith('side');
        const isRight = orientation === 'side-right';

        // 1. Recessed Glass
        const winGlassGeo = isSide ? new THREE.BoxGeometry(0.05, height, width) : new THREE.BoxGeometry(width, height, 0.05);
        const winGlass = new THREE.Mesh(winGlassGeo, glassMat);
        const gX = isSide ? posX + (isRight ? 0.02 : -0.02) : posX;
        const gZ = isSide ? posZ : posZ + 0.02;
        winGlass.position.set(gX, posY, gZ);
        group.add(winGlass);

        // 2. Stone Architrave Frame (برواز الحجر المحيط)
        const fW = width + 0.24;
        const fH = height + 0.22;
        const fGeo = isSide ? new THREE.BoxGeometry(0.08, fH, fW) : new THREE.BoxGeometry(fW, fH, 0.08);
        const frameMesh = new THREE.Mesh(fGeo, trimMat);
        const fMeshX = isSide ? posX + (isRight ? 0.04 : -0.04) : posX;
        const fMeshZ = isSide ? posZ : posZ + 0.04;
        frameMesh.position.set(fMeshX, posY, fMeshZ);
        group.add(frameMesh);

        // 3. Projecting Stone Sill (جلسة شباك حجرية بارزة)
        const sW = width + 0.36;
        const sGeo = isSide ? new THREE.BoxGeometry(0.22, 0.12, sW) : new THREE.BoxGeometry(sW, 0.12, 0.22);
        const sillMesh = new THREE.Mesh(sGeo, trimMat);
        const sillX = isSide ? posX + (isRight ? 0.09 : -0.09) : posX;
        const sillZ = isSide ? posZ : posZ + 0.09;
        sillMesh.position.set(sillX, posY - height / 2 - 0.06, sillZ);
        sillMesh.castShadow = true;
        group.add(sillMesh);

        // 4. Aluminum Mullion Cross (قواطع ألمنيوم سوداء)
        const mGeo = isSide ? new THREE.BoxGeometry(0.06, height, 0.035) : new THREE.BoxGeometry(0.035, height, 0.06);
        const mullion = new THREE.Mesh(mGeo, metalMat);
        mullion.position.set(gX, posY, gZ);
        group.add(mullion);

        // 5. Classic Stone Arch (قوس حجري مع قفل القوس)
        if (isClassic || windowCount >= 8) {
            const archR = width * 0.52;
            const archGeo = new THREE.CylinderGeometry(archR, archR, 0.12, 16, 1, false, 0, Math.PI);
            const archMesh = new THREE.Mesh(archGeo, trimMat);
            if (isSide) {
                archMesh.rotation.y = Math.PI / 2;
                archMesh.rotation.z = isRight ? Math.PI / 2 : -Math.PI / 2;
                archMesh.position.set(fMeshX, posY + height / 2 + 0.06, posZ);
            } else {
                archMesh.rotation.z = Math.PI / 2;
                archMesh.rotation.x = Math.PI / 2;
                archMesh.position.set(posX, posY + height / 2 + 0.06, fMeshZ);
            }
            archMesh.castShadow = true;
            group.add(archMesh);

            // Keystone (قفل القوس)
            const keyGeo = isSide ? new THREE.BoxGeometry(0.18, 0.22, 0.15) : new THREE.BoxGeometry(0.15, 0.22, 0.18);
            const keyMesh = new THREE.Mesh(keyGeo, trimMat);
            const keyX = isSide ? fMeshX + (isRight ? 0.03 : -0.03) : posX;
            const keyZ = isSide ? posZ : fMeshZ + 0.03;
            keyMesh.position.set(keyX, posY + height / 2 + width * 0.32, keyZ);
            keyMesh.castShadow = true;
            group.add(keyMesh);
        }
    }

    function toggleXRayMode() {
        isXRayMode = !isXRayMode;
        const btn = document.getElementById('xrayBtn');
        const text = document.getElementById('xrayBtnText');
        if (isXRayMode) {
            btn.className = 'px-2.5 py-1.5 rounded-xl border border-indigo-500 text-[11px] font-bold text-white bg-indigo-600 shadow-sm flex items-center gap-1.5 transition-all';
            text.innerText = isEnMode ? "Solid Facade" : "عرض الحجر المصمت";
        } else {
            btn.className = 'px-2.5 py-1.5 rounded-xl border border-slate-300 text-[11px] font-bold text-slate-700 bg-white hover:bg-slate-50 shadow-sm flex items-center gap-1.5 transition-all';
            text.innerText = isEnMode ? "X-Ray Skeleton" : "رؤية الهيكل العظم";
        }
        update3DScene();
    }

    function reset3DCamera() {
        if (!threeCamera || !threeControls) return;
        threeCamera.position.set(0.5, 3.8, 13.5); // Direct front hero view!
        threeControls.target.set(0, 2.5, 0);
        threeControls.update();
    }

    // Window resize listener
    window.addEventListener('resize', () => {
        if (isThreeInitialized) initOrResize3D();
    });

    // Run initial instant math on page load
    document.addEventListener('DOMContentLoaded', () => {
        calculateInstantLocalMath();
    });

    // ════════════════ SAMPLE BOX & SHOWROOM PASS HANDLERS ════════════════
    function getSelectedStoneTitle() {
        const checkedRadio = document.querySelector('input[name="stoneType"]:checked');
        if (!checkedRadio) return isEnMode ? "Natural Stone" : "حجر بناء طبيعي";
        const label = checkedRadio.closest('label');
        if (label) {
            const p = label.querySelector('p');
            if (p) return p.innerText.trim();
        }
        return checkedRadio.value;
    }

    function getSelectedStoneFinish() {
        const checkedFinish = document.querySelector('input[name="stoneFinish"]:checked');
        if (!checkedFinish) return "Mufajjar";
        const span = checkedFinish.closest('label')?.querySelector('span');
        return span ? span.innerText.trim() : checkedFinish.value;
    }

    function openSampleBoxModal() {
        const modal = document.getElementById('sampleBoxModal');
        const formContent = document.getElementById('sampleBoxFormContent');
        const successContent = document.getElementById('sampleBoxSuccessContent');
        const stoneTitle = document.getElementById('modalSampleStoneTitle');
        
        if (stoneTitle) {
            stoneTitle.innerText = `${getSelectedStoneTitle()} - ${getSelectedStoneFinish()}`;
        }
        if (formContent) formContent.classList.remove('hidden');
        if (successContent) successContent.classList.add('hidden');
        if (modal) modal.classList.remove('hidden');
    }

    function closeSampleBoxModal() {
        const modal = document.getElementById('sampleBoxModal');
        if (modal) modal.classList.add('hidden');
    }

    async function submitSampleBoxOrder() {
        const fullName = document.getElementById('sampleFullName')?.value.trim();
        const phone = document.getElementById('samplePhone')?.value.trim();
        const city = document.getElementById('sampleCity')?.value;
        const address = document.getElementById('sampleAddress')?.value.trim();
        const btn = document.getElementById('submitSampleBtn');

        if (!fullName || !phone || !address) {
            alert(isEnMode ? "Please enter your name, phone number, and delivery address." : "يرجى إدخال الاسم الكريم ورقم الهاتف وعنوان الموقع.");
            return;
        }

        const payload = {
            stoneType: getSelectedStoneTitle(),
            stoneFinish: getSelectedStoneFinish(),
            fullName: fullName,
            phone: phone,
            city: city,
            deliveryAddress: address,
            samplePriceJod: 5.00
        };

        if (btn) {
            btn.disabled = true;
            btn.innerHTML = `<span class="material-symbols-outlined text-sm animate-spin">progress_activity</span> ${isEnMode ? "Processing..." : "جاري التسجيل..."}`;
        }

        try {
            const resp = await fetch('/Shop/Calculator/OrderSampleBox', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await resp.json();

            if (data.success) {
                document.getElementById('sampleBoxFormContent')?.classList.add('hidden');
                document.getElementById('sampleBoxSuccessContent')?.classList.remove('hidden');
                const trackingEl = document.getElementById('sampleTrackingCodeDisplay');
                if (trackingEl) trackingEl.innerText = data.trackingCode || 'SMP-SUCCESS';
            } else {
                alert(data.message || (isEnMode ? "Failed to record request." : "حدث خطأ أثناء تسجيل الطلب."));
            }
        } catch (e) {
            console.error(e);
            alert(isEnMode ? "Communication error, please try again." : "تعذر الاتصال بالخادم، يرجى المحاولة لاحقاً.");
        } finally {
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = `<span class="material-symbols-outlined text-sm">local_shipping</span> ${isEnMode ? "Confirm Sample Request (5 JOD)" : "تأكيد طلب العينة (5 د.أ)"}`;
            }
        }
    }

    function openShowroomPassModal() {
        const modal = document.getElementById('showroomPassModal');
        const formContent = document.getElementById('showroomPassFormContent');
        const resultContent = document.getElementById('showroomPassResultContent');
        const dateInput = document.getElementById('passVisitDate');
        
        if (dateInput && !dateInput.value) {
            const tomorrow = new Date();
            tomorrow.setDate(tomorrow.getDate() + 1);
            dateInput.value = tomorrow.toISOString().split('T')[0];
        }

        if (formContent) formContent.classList.remove('hidden');
        if (resultContent) resultContent.classList.add('hidden');
        if (modal) modal.classList.remove('hidden');
    }

    function closeShowroomPassModal() {
        const modal = document.getElementById('showroomPassModal');
        if (modal) modal.classList.add('hidden');
    }

    async function submitShowroomPass() {
        const fullName = document.getElementById('passFullName')?.value.trim();
        const phone = document.getElementById('passPhone')?.value.trim();
        const city = document.getElementById('passCity')?.value;
        const visitDate = document.getElementById('passVisitDate')?.value;
        const areaM2 = document.getElementById('passAreaM2')?.value;
        const btn = document.getElementById('submitPassBtn');

        if (!fullName || !phone) {
            alert(isEnMode ? "Please enter your name and phone number." : "يرجى إدخال الاسم الكريم ورقم الهاتف.");
            return;
        }

        const payload = {
            stoneType: `${getSelectedStoneTitle()} (${getSelectedStoneFinish()})`,
            fullName: fullName,
            phone: phone,
            city: city,
            preferredDate: visitDate ? new Date(visitDate).toISOString() : new Date().toISOString(),
            estimatedAreaM2: areaM2 || "غير محدد"
        };

        if (btn) {
            btn.disabled = true;
            btn.innerHTML = `<span class="material-symbols-outlined text-sm animate-spin">progress_activity</span> ${isEnMode ? "Generating..." : "جاري الإصدار..."}`;
        }

        try {
            const resp = await fetch('/Shop/Calculator/RequestShowroomPass', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await resp.json();

            if (data.success) {
                document.getElementById('showroomPassFormContent')?.classList.add('hidden');
                document.getElementById('showroomPassResultContent')?.classList.remove('hidden');
                
                document.getElementById('passResultNumberDisplay').innerText = data.passNumber;
                document.getElementById('passResultNameDisplay').innerText = fullName;
                document.getElementById('passResultStoneDisplay').innerText = payload.stoneType;
                document.getElementById('passResultDateDisplay').innerText = data.preferredDate || visitDate;
            } else {
                alert(data.message || (isEnMode ? "Failed to generate pass." : "حدث خطأ أثناء إصدار التذكرة."));
            }
        } catch (e) {
            console.error(e);
            alert(isEnMode ? "Communication error, please try again." : "تعذر الاتصال بالخادم، يرجى المحاولة لاحقاً.");
        } finally {
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = `<span class="material-symbols-outlined text-sm">confirmation_number</span> ${isEnMode ? "Generate Escrow Pass" : "إصدار التذكرة المشفرة"}`;
            }
        }
    }

    function printShowroomPass() {
        const card = document.getElementById('printablePassCard');
        if (!card) return;
        const printWin = window.open('', '', 'width=700,height=600');
        printWin.document.write('<html><head><title>BLOCKO Escrow Showroom Pass</title><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css"></head><body class="p-8 bg-slate-100 flex items-center justify-center">');
        printWin.document.write(card.outerHTML);
        printWin.document.write('</body></html>');
        printWin.document.close();
        printWin.focus();
        setTimeout(() => { printWin.print(); printWin.close(); }, 500);
    }
</script>
}
