                                <span class="flex items-center gap-1.5">
                                    <span class="material-symbols-outlined text-amber-600 text-base">palette</span>
                                    <span>@(isEn ? "Architectural Trim & Details" : "الديكورات الحجرية والكرانيش")</span>
                                </span>
                                <span class="text-[10px] text-slate-500 font-normal">@(isEn ? "Add-on ornaments" : "إضافات جمالية")</span>
