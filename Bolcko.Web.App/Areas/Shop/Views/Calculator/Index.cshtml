        <!-- Header -->
        <div class="px-6 py-4 bg-slate-900 text-white flex items-center justify-between">
            <div class="flex items-center gap-2.5">
                <span class="w-8 h-8 rounded-xl bg-amber-500 text-slate-950 flex items-center justify-center font-bold">
                    <span class="material-symbols-outlined text-lg">inventory_2</span>
                </span>
                <div>
                    <h3 class="text-sm font-bold text-white">@(isEn ? "Request Certified Stone Sample Box" : "طلب صندوق عينات حجر معتمد لموقعك")</h3>
                    <p class="text-[11px] text-slate-300 font-normal">@(isEn ? "15×15 cm sample delivered to your construction site" : "عينة 15×15 سم مع ملصق جودة رسمي تصل لموقع البناء")</p>
