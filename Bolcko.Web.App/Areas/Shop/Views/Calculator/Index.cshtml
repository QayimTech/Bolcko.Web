                                    <div class="flex items-center gap-1.5 font-bold text-emerald-900">
                                        <span class="material-symbols-outlined text-emerald-600 text-base">security</span>
                                        <span>@(isEn ? "BLOCKO Escrow & Quality Assurance Guarantee:" : "حماية المشتري وحساب الضمان البنكي (BLOCKO Escrow):")</span>
                                    </div>
                                    <ul class="space-y-1 text-emerald-900/90 pr-4 list-disc">
                                        <li>@(isEn ? "Funds are securely held in escrow; zero payment released to the quarry until on-site delivery and physical inspection." : "أموالك بأمان 100%: لا يتم تسليم أي دفعة للمورد إلا بعد وصول الحجر لموقعك ومطابقته للعينة المعتمدة.")</li>
                                        <li>@(isEn ? "Complimentary milestone inspection by BLOCKO structural engineers for residential villas." : "فحص هندسي مجاني للدفعة الأولى بواسطة مهندسي بلكو المعتمدين.")</li>
                                        <li>@(isEn ? "Official digital contract & full replacement warranty against chipping, cracking, or color deviation." : "عقد توريد رسمي وفاتورة ضريبية مع كفالة استبدال فورية لأي حجر مخالف للمواصفات.")</li>
                                    </ul>
                                </div>

                            </div>

                        </div>
                    </div>

                    <!-- ════════════ TAB 3: FINISHING & INSULATION ADDONS ════════════ -->
                    <div id="tabContentFinishes" class="space-y-5 hidden">
                        <div class="p-4 rounded-xl bg-teal-50/80 border border-teal-200/80 text-xs text-teal-900 flex items-start gap-2.5">
                            <span class="material-symbols-outlined text-teal-600 text-lg flex-shrink-0">tune</span>
                            <div>
                                <strong class="block font-bold">@(isEn ? "Optional Finishing & MEP Packages" : "إضافات وحزم التشطيبات والعوازل (اختياري)")</strong>
                                <p class="text-[11px] text-teal-700/90 mt-0.5">@(isEn ? "Tailor your project by adding real-world contractor rates per m² for insulation, internal plastering, deluxe painting, and electro-mechanical MEP." : "قم بتخصيص مشروعك بإضافة أسعار المقاولة للمتر المربع تشمل العزل المائي والحراري، القصارة، الدهان، والتأسيسات الكهروميكانيكية.")</p>
                            </div>
                        </div>

                        <!-- 1. Waterproofing & Thermal Insulation -->
                        @if (calcConfig.EnableInsulationAddon)
                        {
                            <div class="p-4 rounded-xl border border-slate-200 bg-white hover:border-teal-300 transition-all">
                                <label class="flex items-start justify-between cursor-pointer gap-3">
                                    <div class="space-y-1">
                                        <div class="flex items-center gap-2">
                                            <input type="checkbox" id="addonInsulation" onchange="onInputChange()"
                                                   class="w-4 h-4 rounded text-teal-600 focus:ring-teal-500 border-slate-300">
                                            <span class="text-xs font-bold text-slate-900">@(isEn ? "Waterproofing & Thermal Insulation" : "عزل مائي وحراري (أسطح وقواعد)")</span>
                                        </div>
                                        <p class="text-[11px] text-slate-500 pe-2">
                                            @(isEn ? $"Bituminous membrane waterproofing for foundations and roof insulation with extruded polystyrene ({calcConfig.InsulationRatePerM2} JOD/m²)" : $"عزل رولات زفتية للقواعد والأسطح + فوم عازل حراري بسعر {calcConfig.InsulationRatePerM2} د.أ/م²")
                                        </p>
                                    </div>
                                    <span class="text-xs font-bold font-mono text-teal-700 bg-teal-50 px-2 py-1 rounded-md border border-teal-200 flex-shrink-0">
                                        @calcConfig.InsulationRatePerM2 @(isEn ? "JOD/m²" : "د.أ/م²")
                                    </span>
                                </label>
                            </div>
                        }

                        <!-- 2. Internal Plastering (Qasara) -->
                        @if (calcConfig.EnablePlasteringAddon)
                        {
                            <div class="p-4 rounded-xl border border-slate-200 bg-white hover:border-teal-300 transition-all">
                                <label class="flex items-start justify-between cursor-pointer gap-3">
                                    <div class="space-y-1">
                                        <div class="flex items-center gap-2">
                                            <input type="checkbox" id="addonPlastering" onchange="onInputChange()"
                                                   class="w-4 h-4 rounded text-teal-600 focus:ring-teal-500 border-slate-300">
                                            <span class="text-xs font-bold text-slate-900">@(isEn ? "Internal Plastering & Rendering" : "أعمال القصارة الداخلية (بؤج وأوتار)")</span>
                                        </div>
                                        <p class="text-[11px] text-slate-500 pe-2">
                                            @(isEn ? $"Internal wall & ceiling 3-coat plastering according to building specs ({calcConfig.PlasteringRatePerM2} JOD/m²)" : $"قصارة داخلية 3 أوجه عالية الاستواء وفق كودات البناء بسعر {calcConfig.PlasteringRatePerM2} د.أ/م²")
                                        </p>
                                    </div>
                                    <span class="text-xs font-bold font-mono text-teal-700 bg-teal-50 px-2 py-1 rounded-md border border-teal-200 flex-shrink-0">
                                        @calcConfig.PlasteringRatePerM2 @(isEn ? "JOD/m²" : "د.أ/م²")
                                    </span>
                                </label>
                            </div>
                        }

                        <!-- 3. Deluxe Interior Painting -->
                        @if (calcConfig.EnablePaintingAddon)
                        {
                            <div class="p-4 rounded-xl border border-slate-200 bg-white hover:border-teal-300 transition-all">
                                <label class="flex items-start justify-between cursor-pointer gap-3">
                                    <div class="space-y-1">
                                        <div class="flex items-center gap-2">
                                            <input type="checkbox" id="addonPainting" onchange="onInputChange()"
                                                   class="w-4 h-4 rounded text-teal-600 focus:ring-teal-500 border-slate-300">
                                            <span class="text-xs font-bold text-slate-900">@(isEn ? "Deluxe Interior Paint" : "دهانات داخلية ديلوكس (معجونة + وجهين)")</span>
                                        </div>
                                        <p class="text-[11px] text-slate-500 pe-2">
                                            @(isEn ? $"Two coats putty + primer + latex super washable finish ({calcConfig.InteriorPaintRatePerM2} JOD/m²)" : $"معجونة وجهين + سيلر مائي + دهان سوبر ديلوكس قابل للغسيل بسعر {calcConfig.InteriorPaintRatePerM2} د.أ/م²")
                                        </p>
                                    </div>
                                    <span class="text-xs font-bold font-mono text-teal-700 bg-teal-50 px-2 py-1 rounded-md border border-teal-200 flex-shrink-0">
                                        @calcConfig.InteriorPaintRatePerM2 @(isEn ? "JOD/m²" : "د.أ/م²")
                                    </span>
                                </label>
                            </div>
                        }

                        <!-- 4. Electro-Mechanical (MEP) -->
                        @if (calcConfig.EnableElectroMechanicalAddon)
                        {
                            <div class="p-4 rounded-xl border border-slate-200 bg-white hover:border-teal-300 transition-all">
                                <label class="flex items-start justify-between cursor-pointer gap-3">
                                    <div class="space-y-1">
                                        <div class="flex items-center gap-2">
                                            <input type="checkbox" id="addonMEP" onchange="onInputChange()"
                                                   class="w-4 h-4 rounded text-teal-600 focus:ring-teal-500 border-slate-300">
                                            <span class="text-xs font-bold text-slate-900">@(isEn ? "Electro-Mechanical Infrastructure (MEP)" : "تأسيسات كهروميكانيكية (كهرباء وسباكة)")</span>
                                        </div>
                                        <p class="text-[11px] text-slate-500 pe-2">
                                            @(isEn ? $"Electrical piping, conduits, sanitary drain pipes, and water supply rough-ins ({calcConfig.ElectroMechanicalRatePerM2} JOD/m²)" : $"تمديدات صحية وتغذية مياه + بايبات وخراطيم ولوحات كهربائية بسعر {calcConfig.ElectroMechanicalRatePerM2} د.أ/م²")
                                        </p>
                                    </div>
                                    <span class="text-xs font-bold font-mono text-teal-700 bg-teal-50 px-2 py-1 rounded-md border border-teal-200 flex-shrink-0">
                                        @calcConfig.ElectroMechanicalRatePerM2 @(isEn ? "JOD/m²" : "د.أ/م²")
                                    </span>
                                </label>
                            </div>
                        }
                    </div>

                </form>
            </div>

            <!-- Engineering Standards Reference Box -->
            <div class="bg-slate-50 rounded-2xl p-5 border border-slate-200 text-xs text-slate-700 space-y-2.5">
                <div class="flex items-center gap-2 font-bold text-slate-900 border-b border-slate-200 pb-2">
                    <span class="material-symbols-outlined text-slate-700 text-base">verified</span>
                    <span>@(isEn ? "Approved Jordanian Engineering Standards:" : "المعايير الهندسية الأردنية المعتمدة:")</span>
                </div>
                <div class="space-y-1.5 text-[11px] text-slate-600 leading-relaxed">
                    <p>• <strong>@(isEn ? "Steel Rebar:" : "حديد التسليح:")</strong> @(isEn ? "High-strength Grade 60 (JS 29) with flexible column detailing (6, 8, or 10 bars)." : "حديد Grade 60 عالي المقاومة بتفاصيل الأعمدة المرنة (6، 8، أو 10 قضبان).")</p>
                    <p>• <strong>@(isEn ? "Stone Cladding:" : "حجر البناء:")</strong> @(isEn ? "Jordanian natural stone (Ruwaished / Ma'an) or engineered stone, with 7% cutting waste." : "حجر طبيعي نخب أول أو صناعي معتمد، مع حساب نسبة هالك القص 7% وباطون الحشوة.")</p>
                    <p>• <strong>@(isEn ? "Concrete & Cement:" : "الخرسانة والإسمنت:")</strong> @(isEn ? "B250/B300 ready-mix concrete with pump & Portland CEM I 42.5N." : "خرسانة جاهزة B250/B300 مع مضخة، وإسمنت بورتلاندي 42.5N معتمد.")</p>
                    <p>• <strong>@(isEn ? "Pricing:" : "الأسعار:")</strong> @(isEn ? "Delivered to site in designated governorate, including 16% sales tax." : "واصلة الموقع في المحافظة المحددة وشاملة ضريبة المبيعات 16%.")</p>
                </div>
            </div>
        </div>

        <!-- ────────────── RIGHT COLUMN: ESTIMATE RESULTS & BOQ ────────────── -->
        <div class="lg:col-span-7 space-y-6">

            <!-- 1. EXECUTIVE SUMMARY TOTAL COST CARD -->
            <div class="bg-slate-900 rounded-2xl p-6 sm:p-7 text-white shadow-lg border border-slate-800">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-5">
                    <div>
                        <div class="flex items-center gap-2 mb-1">
                            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block">
                                @(isEn ? "Estimated Combined Construction & Facades Cost" : "التكلفة الإجمالية التقديرية (عظم + واجهات وديكورات)")
                            </span>
                            <span id="savingsBadge" class="@(Model.PotentialSavingsJod > 0 ? "inline-flex" : "hidden") items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                                <span class="material-symbols-outlined text-xs">savings</span>
                                <span id="savingsBadgeText">@(isEn ? $"Saved {Model.PotentialSavingsJod:N0} JOD" : $"وفرت {Model.PotentialSavingsJod:N0} د.أ")</span>
                            </span>
                        </div>
                        
                        <div class="flex items-baseline gap-2">
                            <span class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white font-mono" id="grandTotalCost">
                                @Model.GrandTotalCostJod.ToString("N0")
                            </span>
                            <span class="text-base sm:text-lg font-bold text-emerald-400">
                                @(isEn ? "JOD" : "دينار أردني")
                            </span>
                        </div>

                        <!-- Sub-totals: Skeleton vs Stone -->
                        <div class="flex flex-wrap items-center gap-2 sm:gap-4 mt-3 pt-3 border-t border-slate-800 text-xs">
                            <div class="flex items-center gap-1.5">
                                <span class="w-2 h-2 rounded-full bg-indigo-400"></span>
                                <span class="text-slate-400">@(isEn ? "Skeleton Cost:" : "تكلفة العظم:")</span>
                                <strong class="text-white font-mono" id="totalSkeletonCost">@Model.TotalSkeletonCostJod.ToString("N0") @(isEn ? "JOD" : "د.أ")</strong>
                            </div>
                            <span class="text-slate-700">•</span>
                            <div class="flex items-center gap-1.5" id="stoneSummaryCostGroup">
                                <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                                <span class="text-slate-400">@(isEn ? "Stone & Decor:" : "الحجر والديكورات:")</span>
                                <strong class="text-amber-300 font-mono" id="totalStoneCost">@Model.TotalStoneCostJod.ToString("N0") @(isEn ? "JOD" : "د.أ")</strong>
                            </div>
                            <span class="text-slate-700">•</span>
                            <div class="flex items-center gap-1.5">
                                <span class="text-slate-400">@(isEn ? "Avg m²:" : "متوسط المتر:")</span>
                                <strong class="text-emerald-400 font-mono" id="summaryCostPerM2">@Model.CostPerSquareMeterJod @(isEn ? "JOD/m²" : "د.أ/م²")</strong>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="action-buttons-group flex flex-col sm:flex-row lg:flex-col gap-2 flex-shrink-0">
                        <button type="button" onclick="sendToQuote()" 
                                class="px-5 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs transition-colors flex items-center justify-center gap-1.5 shadow-sm cursor-pointer">
                            <span class="material-symbols-outlined text-base">request_quote</span>
                            <span>@(isEn ? "Request Official Quote & Supply" : "طلب تسعيرة وتوريد رسمي")</span>
                        </button>

                        <div class="flex items-center gap-2">
                            <button type="button" onclick="shareWhatsApp()" 
                                    class="flex-1 py-2 px-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold border border-slate-700 transition-colors flex items-center justify-center gap-1">
                                <span class="material-symbols-outlined text-sm text-emerald-400">share</span>
                                <span>@(isEn ? "Share" : "مشاركة")</span>
                            </button>
                            <button type="button" onclick="triggerPrintReport()" 
                                    class="flex-1 py-2 px-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold border border-slate-700 transition-colors flex items-center justify-center gap-1">
                                <span class="material-symbols-outlined text-sm text-slate-300">print</span>
                                <span>@(isEn ? "Print PDF" : "طباعة تقرير PDF")</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Visual Budget Distribution Progress Bar -->
                <div class="mt-6 pt-4 border-t border-slate-800">
                    <div class="flex justify-between text-[11px] text-slate-400 mb-1.5">
                        <span class="font-medium">@(isEn ? "Relative Budget Breakdown (Materials, Labor & Stone):" : "التوزيع النسبي لتكاليف المواد، المصنعية، والواجهات:")</span>
                        <span id="budgetSummaryText" class="font-mono text-slate-300">
                            @(isEn ? "Steel 22% • Concrete 17% • Stone 25% • Labor & Blocks 36%" : "حديد 22% • خرسانة 17% • حجر 25% • عمالة وطوب 36%")
                        </span>
                    </div>
                    <div class="w-full h-2.5 bg-slate-800 rounded-full overflow-hidden flex gap-0.5 p-0.5 border border-slate-700/60">
                        <div id="barSteel" class="bg-indigo-500 rounded-full transition-all duration-300" style="width: 20%" title="@(isEn ? "Steel Rebar" : "حديد التسليح")"></div>
                        <div id="barConcrete" class="bg-blue-500 rounded-full transition-all duration-300" style="width: 16%" title="@(isEn ? "Ready-Mix Concrete" : "خرسانة جاهزة")"></div>
                        <div id="barStone" class="bg-amber-500 rounded-full transition-all duration-300" style="width: 25%" title="@(isEn ? "Stone Facades & Decor" : "الحجر والواجهات")"></div>
                        <div id="barLabor" class="bg-purple-500 rounded-full transition-all duration-300" style="width: 25%" title="@(isEn ? "Labor & Workmanship" : "أجور المقاولة والعمالة")"></div>
                        <div id="barBlocks" class="bg-rose-500 rounded-full transition-all duration-300" style="width: 7%" title="@(isEn ? "Masonry Blocks" : "طوب")"></div>
                        <div id="barCement" class="bg-amber-600 rounded-full transition-all duration-300" style="width: 4%" title="@(isEn ? "Cement" : "إسمنت")"></div>
                        <div id="barSand" class="bg-teal-500 rounded-full transition-all duration-300" style="width: 3%" title="@(isEn ? "Sand & Aggregate" : "رمل وحصمة")"></div>
                    </div>
                </div>

                <!-- Escrow Trust Ribbon -->
                <div class="mt-4 pt-3 border-t border-slate-800/80 flex flex-wrap items-center justify-between gap-3 text-xs">
                    <div class="flex items-center gap-2 text-emerald-400 font-semibold">
                        <span class="material-symbols-outlined text-base">verified_user</span>
                        <span>@(isEn ? "BLOCKO Escrow Protection: Payments locked securely until stone inspection on site." : "حماية بلكو وحساب الضمان: لا تُسلّم الدفعات للمورد إلا بعد استلام الحجر ومطابقته للعينة المعتمدة.")</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <button type="button" onclick="openSampleBoxModal()" class="px-2.5 py-1 rounded-lg bg-amber-500/20 text-amber-300 border border-amber-500/40 hover:bg-amber-500/30 text-[11px] font-bold transition-all flex items-center gap-1 cursor-pointer">
                            <span class="material-symbols-outlined text-sm">inventory_2</span>
                            <span>@(isEn ? "Order Sample Box (5 JOD)" : "طلب عينة حجر للموقع (5 د.أ)")</span>
                        </button>
                    </div>
                </div>

            </div>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- STICKY / PROMINENT 3D ARCHITECTURAL DIGITAL TWIN VIEWPORT CARD  -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <div class="bg-slate-900 rounded-2xl shadow-xl border border-slate-800 overflow-hidden text-white space-y-3 p-4 sm:p-5">
                
                <!-- 1. Header: Typology Switcher + Title + X-Ray Button -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-800">
