                                <button type="button" onclick="setStoneFacades(2)" id="facade-btn-2" class="facade-btn py-2 rounded-lg border text-xs font-semibold bg-white text-slate-700 border-slate-200 hover:bg-slate-50 transition-all">@(isEn ? "2 Facades" : "واجهتان")</button>
                                <button type="button" onclick="setStoneFacades(3)" id="facade-btn-3" class="facade-btn py-2 rounded-lg border text-xs font-semibold bg-white text-slate-700 border-slate-200 hover:bg-slate-50 transition-all">@(isEn ? "3 Facades" : "3 واجهات")</button>
                                <button type="button" onclick="setStoneFacades(4)" id="facade-btn-4" class="facade-btn py-2 rounded-lg border text-xs font-bold bg-slate-900 text-white border-slate-900 transition-all">@(isEn ? "4 Facades" : "4 واجهات")</button>
                            </div>
                            <input type="hidden" id="stoneFacadesCount" value="4" />
                        </div>

                        <!-- Stone Type Selection (Dynamic from Admin Dashboard) -->
                        <div>
                            <label class="block text-xs font-bold text-slate-800 mb-2">@(isEn ? "Stone Classification & Source" : "نوع ومصدر حجر البناء")</label>
                            <div class="space-y-2">
                                @if (calcConfig.DynamicStoneTypes != null && calcConfig.DynamicStoneTypes.Any(s => s.IsActive))
                                {
                                    var activeStones = calcConfig.DynamicStoneTypes.Where(s => s.IsActive).ToList();
                                    for (int i = 0; i < activeStones.Count; i++)
                                    {
                                        var stone = activeStones[i];
                                        var isChecked = i == 0;
                                        <label class="flex items-center justify-between p-3 rounded-xl border border-slate-200 hover:border-slate-400 cursor-pointer transition-all has-[:checked]:border-amber-600 has-[:checked]:bg-amber-50/40">
                                            <div class="flex items-center gap-2.5">
                                                <input type="radio" name="stoneType" value="@stone.Id" data-price="@stone.PricePerM2" data-color="@stone.ColorHex" @(isChecked ? "checked" : "") class="w-4 h-4 text-amber-600 focus:ring-amber-600" onchange="onInputChange()" />
                                                <div class="flex items-center gap-2">
                                                    <span class="w-3.5 h-3.5 rounded-full border border-slate-300 inline-block flex-shrink-0" style="background-color: @stone.ColorHex;"></span>
                                                    <div>
                                                        <p class="text-xs font-bold text-slate-900">@(isEn && !string.IsNullOrEmpty(stone.NameEn) ? stone.NameEn : stone.NameAr)</p>
                                                        <p class="text-[11px] text-slate-500 font-mono">@stone.PricePerM2 @(isEn ? "JOD/m²" : "د.أ/م²")</p>
                                                    </div>
                                                </div>
                                            </div>
                                            <span class="text-xs font-mono font-bold text-slate-700">@stone.PricePerM2 @(isEn ? "JOD" : "د.أ")</span>
                                        </label>
                                    }
                                }
                                else
                                {
                                    <label class="flex items-center justify-between p-3 rounded-xl border border-slate-200 hover:border-slate-400 cursor-pointer transition-all has-[:checked]:border-amber-600 has-[:checked]:bg-amber-50/40">
                                        <div class="flex items-center gap-2.5">
                                            <input type="radio" name="stoneType" value="Natural_Ruwaished" data-price="18.50" checked class="w-4 h-4 text-amber-600 focus:ring-amber-600" onchange="onInputChange()" />
                                            <div>
                                                <p class="text-xs font-bold text-slate-900">@(isEn ? "Natural Stone - Ruwaished Class A" : "حجر طبيعي - رويشد نخب أول")</p>
                                                <p class="text-[11px] text-slate-500">18.50 @(isEn ? "JOD/m²" : "د.أ/م²")</p>
                                            </div>
                                        </div>
                                        <span class="text-xs font-mono font-bold text-slate-700">18.5 د.أ</span>
                                    </label>
                                }
                            </div>
                        </div>

                        <!-- Stone Surface Finish -->
                        <div>
                            <label class="block text-xs font-bold text-slate-800 mb-2">@(isEn ? "Stone Dressing / Surface Finish" : "نقشة الحجر (التنعيم والتشطيب)")</label>
                            <div class="grid grid-cols-3 gap-2">
                                <label class="p-2 rounded-xl border border-slate-200 hover:border-slate-400 cursor-pointer text-center text-xs font-semibold has-[:checked]:border-amber-600 has-[:checked]:bg-amber-50">
