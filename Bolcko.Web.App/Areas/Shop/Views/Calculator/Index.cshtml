    // ────────────────────────────────────────────────────────────────
    // HIGH-DEFINITION PROCEDURAL JORDANIAN STONE TEXTURE ENGINE
    // Dual Maps: High-res Diffuse + Micro-relief Bump Map (ملمس ونحت بالملي)
    // Supports 5 authentic finishes: Mufajjar, Tabzeh, Musamsam, Monaqqar, Honed
    // ────────────────────────────────────────────────────────────────
    function getProceduralStoneMaps(stoneType, stoneFinish) {
        const key = `${stoneType}_${stoneFinish}`;
        if (stoneTextureCache[key]) return stoneTextureCache[key];

        const TEX_RES = 2048;
        const diffCanvas = document.createElement('canvas');
        diffCanvas.width = TEX_RES;
        diffCanvas.height = TEX_RES;
        const diffCtx = diffCanvas.getContext('2d');

        const bumpCanvas = document.createElement('canvas');
        bumpCanvas.width = TEX_RES;
        bumpCanvas.height = TEX_RES;
        const bumpCtx = bumpCanvas.getContext('2d');

        // Authentic Jordanian stone base palettes
        let baseR = 226, baseG = 210, baseB = 182; // Warm Jordanian desert limestone (حجر صحراوي دافئ)
        let jointColor = '#16110b'; // Rich dark mortar joint (كحلة داكنة غائرة بالغة الوضوح)
        let highlightColor = 'rgba(255,255,255,0.68)'; // Crisp specular stone chamfer highlight
        let shadowColor = 'rgba(18,12,8,0.62)'; // Deep ambient stone undercut shadow

        const radioEl = document.querySelector(`input[name="stoneType"][value="${stoneType}"]`);
        const hexColor = radioEl ? radioEl.dataset.color : null;

        if (hexColor && hexColor.startsWith('#') && hexColor.length === 7) {
            baseR = parseInt(hexColor.slice(1, 3), 16);
            baseG = parseInt(hexColor.slice(3, 5), 16);
            baseB = parseInt(hexColor.slice(5, 7), 16);
        } else if (stoneType === 'Natural_Maan') {
            baseR = 248; baseG = 246; baseB = 242; // Ma'an pure crystalline white
            jointColor = '#2d2720';
            highlightColor = 'rgba(255,255,255,0.75)';
            shadowColor = 'rgba(35,30,24,0.52)';
        } else if (stoneType === 'Artificial_HighDensity') {
            baseR = 212; baseG = 208; baseB = 202; // Architectural cast stone
            jointColor = '#1e1c18';
            highlightColor = 'rgba(255,255,255,0.60)';
            shadowColor = 'rgba(20,18,16,0.55)';
        }

        // Base fill
        diffCtx.fillStyle = `rgb(${baseR}, ${baseG}, ${baseB})`;
        diffCtx.fillRect(0, 0, TEX_RES, TEX_RES);

        bumpCtx.fillStyle = '#808080'; // Neutral 128 mid-gray datum
        bumpCtx.fillRect(0, 0, TEX_RES, TEX_RES);

        // 16 Jordanian standard Madameek courses (25cm per course on 4.0m wall height)
        const numCourses = 16;
        const courseHeight = TEX_RES / numCourses; // 128px per 25cm course

        for (let r = 0; r < numCourses; r++) {
            const y = r * courseHeight;
            // Running bond stagger (ربط معمارية البناء الأردني)
            const courseOffset = (r % 2) * 280;
            let x = -courseOffset;

            while (x < TEX_RES + 600) {
                const seed = Math.abs(Math.floor((r * 47.3 + x * 19.7) % 100));
                // Authentic Jordanian block lengths: 50cm to 90cm (260px - 460px)
                const blockWidth = 260 + (seed % 200);

                // Natural quarry color variation per block
                const tint = (seed % 24) - 12;
                const rCol = Math.min(255, Math.max(0, baseR + tint));
                const gCol = Math.min(255, Math.max(0, baseG + tint));
                const bCol = Math.min(255, Math.max(0, baseB + tint));

                // Block base face in diffuse
                diffCtx.fillStyle = `rgb(${rCol}, ${gCol}, ${bCol})`;
                diffCtx.fillRect(x + 4, y + 4, blockWidth - 8, courseHeight - 8);

                // Block base elevation in bump map
                bumpCtx.fillStyle = '#969696';
                bumpCtx.fillRect(x + 4, y + 4, blockWidth - 8, courseHeight - 8);

                // ─────────────────────────────────────────────────────────────
                // STONE FINISH MICRO-SCULPTING (طبزة / مسمسم / منقر / مجلي / مفجر)
                // ─────────────────────────────────────────────────────────────
                if (stoneFinish === 'Tabzeh') {
                    // AUTHENTIC JORDANIAN TABZEH: Flat chiseled draught margin (صفيحة/مشطاف) + dramatic rock-face boss (كوشة بارزة)
                    const margin = 16; // ~3cm architectural draught margin
                    const innerX = x + margin;
                    const innerY = y + margin;
                    const innerW = blockWidth - margin * 2;
                    const innerH = courseHeight - margin * 2;

                    // Draught margin outline groove (خط الصفيحة المعماري المحفور بدقة)
                    diffCtx.strokeStyle = 'rgba(0,0,0,0.45)';
                    diffCtx.lineWidth = 2.0;
                    diffCtx.strokeRect(innerX, innerY, innerW, innerH);

                    bumpCtx.strokeStyle = '#252525';
                    bumpCtx.lineWidth = 2.5;
                    bumpCtx.strokeRect(innerX, innerY, innerW, innerH);

                    // Fine margin comb strokes (تسمسيم خفيف ناعم على الصفيحة)
                    diffCtx.strokeStyle = 'rgba(0,0,0,0.12)';
                    diffCtx.lineWidth = 1.0;
                    for (let mi = 4; mi < margin - 2; mi += 4) {
                        diffCtx.strokeRect(x + mi, y + mi, blockWidth - mi * 2, courseHeight - mi * 2);
                    }

                    // Multi-faceted rock-face boss interior (تضاريس صخرية جبلية ثلاثية الأبعاد)
                    const numFacetsX = 4;
                    const numFacetsY = 2;
                    const facetW = innerW / numFacetsX;
                    const facetH = innerH / numFacetsY;

                    for (let fy = 0; fy < numFacetsY; fy++) {
                        for (let fx = 0; fx < numFacetsX; fx++) {
                            const fcx = innerX + fx * facetW;
                            const fcy = innerY + fy * facetH;
                            const fSeed = (seed * 13 + fx * 17 + fy * 29) % 50;

                            const distFromCenterX = Math.abs((fx + 0.5) - numFacetsX / 2) / (numFacetsX / 2);
                            const distFromCenterY = Math.abs((fy + 0.5) - numFacetsY / 2) / (numFacetsY / 2);
                            const dist = Math.sqrt(distFromCenterX * distFromCenterX + distFromCenterY * distFromCenterY);
                            const peakHeight = Math.max(0, 1.0 - dist * 0.65);

                            // High-contrast bump elevation climbing up to 255
                            const bumpVal = Math.min(255, Math.floor(165 + peakHeight * 85 + (fSeed % 25)));
                            const bHex = bumpVal.toString(16).padStart(2, '0');
                            bumpCtx.fillStyle = `#${bHex}${bHex}${bHex}`;
                            bumpCtx.fillRect(fcx + 1, fcy + 1, facetW - 1, facetH - 1);

                            // Shading in diffuse: top facet illuminated, bottom facet shadowed
                            if ((fx + fy) % 2 === 0) {
                                diffCtx.fillStyle = `rgba(255,255,255,${0.18 + (fSeed % 10) * 0.02})`;
                            } else {
                                diffCtx.fillStyle = `rgba(0,0,0,${0.16 + (fSeed % 10) * 0.02})`;
                            }
                            diffCtx.fillRect(fcx + 1, fcy + 1, facetW - 1, facetH - 1);

                            // Deep chiseled fracture crease (شرخ صخري غائر)
                            diffCtx.strokeStyle = 'rgba(0,0,0,0.35)';
                            diffCtx.lineWidth = 1.6;
                            diffCtx.beginPath();
                            diffCtx.moveTo(fcx, fcy);
                            diffCtx.lineTo(fcx + facetW, fcy + facetH * 0.7);
                            diffCtx.stroke();

                            bumpCtx.strokeStyle = '#181818';
                            bumpCtx.lineWidth = 2.0;
                            bumpCtx.beginPath();
                            bumpCtx.moveTo(fcx, fcy);
                            bumpCtx.lineTo(fcx + facetW, fcy + facetH * 0.7);
                            bumpCtx.stroke();
                        }
                    }

                    // Porous limestone micro-pits
                    diffCtx.fillStyle = 'rgba(0,0,0,0.28)';
                    for (let p = 0; p < 36; p++) {
                        const px = innerX + ((p * 41 + seed) % innerW);
                        const py = innerY + ((p * 67 + seed) % innerH);
                        diffCtx.fillRect(px, py, 2.5, 2.5);
                        bumpCtx.fillStyle = '#101010';
                        bumpCtx.fillRect(px, py, 2, 2);
                    }

                } else if (stoneFinish === 'Musamsam') {
                    // AUTHENTIC JORDANIAN MUSAMSAM: High-contrast razor-sharp vertical comb chisel teeth (شاحوطة الحجر)
                    diffCtx.strokeStyle = shadowColor;
                    diffCtx.lineWidth = 1.8;
                    bumpCtx.lineWidth = 2.2;

                    for (let line = 8; line < blockWidth - 8; line += 7.0) {
                        const lx = x + line;
                        // Deep chisel trough (حفرة الشاحوطة الغائرة)
                        diffCtx.beginPath();
                        diffCtx.moveTo(lx, y + 4);
                        diffCtx.lineTo(lx, y + courseHeight - 4);
                        diffCtx.stroke();

                        bumpCtx.strokeStyle = '#0e0e0e';
                        bumpCtx.beginPath();
                        bumpCtx.moveTo(lx, y + 4);
                        bumpCtx.lineTo(lx, y + courseHeight - 4);
                        bumpCtx.stroke();

                        // Raised tooth ridge crest (حد الشاحوطة البارز العاكس للضوء)
                        diffCtx.strokeStyle = highlightColor;
                        diffCtx.beginPath();
                        diffCtx.moveTo(lx + 2.0, y + 4);
                        diffCtx.lineTo(lx + 2.0, y + courseHeight - 4);
                        diffCtx.stroke();

                        bumpCtx.strokeStyle = '#ffffff';
                        bumpCtx.beginPath();
                        bumpCtx.moveTo(lx + 2.0, y + 4);
                        bumpCtx.lineTo(lx + 2.0, y + courseHeight - 4);
                        bumpCtx.stroke();

                        // Reset shadow color for next loop
                        diffCtx.strokeStyle = shadowColor;
                    }

                } else if (stoneFinish === 'Monaqqar') {
                    // AUTHENTIC JORDANIAN MONAQQAR: Dense bush-hammered pyramidal stipples (تنقير بوشاردا هندسي كثيف)
                    for (let p = 0; p < 220; p++) {
                        const px = x + 5 + ((p * 47 + seed * 9) % (blockWidth - 10));
                        const py = y + 5 + ((p * 73 + seed * 13) % (courseHeight - 10));

                        // Deep pick indentation
                        diffCtx.fillStyle = shadowColor;
                        diffCtx.fillRect(px, py, 2.4, 2.4);

                        bumpCtx.fillStyle = '#0c0c0c';
                        bumpCtx.fillRect(px, py, 2.2, 2.2);

                        // Illuminated chipped rim
                        diffCtx.fillStyle = highlightColor;
                        diffCtx.fillRect(px + 1.4, py + 1.4, 1.4, 1.4);

                        bumpCtx.fillStyle = '#ffffff';
                        bumpCtx.fillRect(px + 1.4, py + 1.4, 1.6, 1.6);
                    }

                } else if (stoneFinish === 'Honed') {
                    // AUTHENTIC JORDANIAN HONED: Silky smooth sawn modern face with natural limestone sediment veins
                    diffCtx.strokeStyle = 'rgba(150, 130, 100, 0.32)';
                    diffCtx.lineWidth = 1.8;
                    diffCtx.beginPath();
                    const veinStart = y + ((seed * 19) % courseHeight);
                    diffCtx.moveTo(x + 5, veinStart);
                    diffCtx.bezierCurveTo(x + blockWidth * 0.35, veinStart + 10, x + blockWidth * 0.7, veinStart - 8, x + blockWidth - 5, veinStart + 5);
                    diffCtx.stroke();

                    diffCtx.fillStyle = 'rgba(255, 255, 255, 0.25)';
                    for (let s = 0; s < 24; s++) {
                        const sx = x + 6 + ((s * 41 + seed) % (blockWidth - 12));
                        const sy = y + 6 + ((s * 67 + seed) % (courseHeight - 12));
                        diffCtx.fillRect(sx, sy, 1.5, 1.5);
                    }

                    bumpCtx.fillStyle = '#9e9e9e';
                    bumpCtx.fillRect(x + 4, y + 4, blockWidth - 8, courseHeight - 8);

                } else {
                    // AUTHENTIC JORDANIAN MUFAJJAR (DEFAULT): Heavy quarry fractured face with high-contrast cleavages (كسر محجر طبيعي)
                    const numFacets = 3;
                    const fW = (blockWidth - 8) / numFacets;
                    for (let fi = 0; fi < numFacets; fi++) {
                        const fx = x + 4 + fi * fW;
                        const fSeed = (seed * 17 + fi * 31) % 40;
                        const fH = (fSeed % 2 === 0) ? '#d0d0d0' : '#707070';
                        bumpCtx.fillStyle = fH;
                        bumpCtx.fillRect(fx, y + 4, fW, courseHeight - 8);

                        // Deep angular cleavage line
                        bumpCtx.strokeStyle = '#181818';
                        bumpCtx.lineWidth = 2.4;
                        bumpCtx.beginPath();
                        bumpCtx.moveTo(fx, y + 4);
                        bumpCtx.lineTo(fx + fW * 0.45, y + courseHeight - 4);
                        bumpCtx.stroke();

                        diffCtx.strokeStyle = 'rgba(0,0,0,0.38)';
                        diffCtx.lineWidth = 2.0;
                        diffCtx.beginPath();
                        diffCtx.moveTo(fx, y + 4);
                        diffCtx.lineTo(fx + fW * 0.45, y + courseHeight - 4);
                        diffCtx.stroke();
                    }

                    // Quarry spall texture & crystalline pits
                    for (let p = 0; p < 110; p++) {
                        const px = x + 5 + ((p * 53 + seed * 7) % (blockWidth - 10));
                        const py = y + 5 + ((p * 89 + seed * 11) % (courseHeight - 10));

                        diffCtx.fillStyle = shadowColor;
                        diffCtx.fillRect(px, py, 3.2, 3.2);

                        bumpCtx.fillStyle = '#101010';
                        bumpCtx.fillRect(px, py, 2.6, 2.6);

                        diffCtx.fillStyle = highlightColor;
                        diffCtx.fillRect(px + 1.8, py + 1.8, 1.8, 1.8);

                        bumpCtx.fillStyle = '#ffffff';
                        bumpCtx.fillRect(px + 1.8, py + 1.8, 1.8, 1.8);
                    }
                }

                // ─────────────────────────────────────────────────────────────
                // 3D BEVEL EDGE CHAMFERS (شطفة معمارية ثلاثية الأبعاد لكل حجر)
                // ─────────────────────────────────────────────────────────────
                // Top and Left chamfer catch overhead sunlight (High relief + bright specular)
                diffCtx.fillStyle = highlightColor;
                diffCtx.fillRect(x + 4, y + 4, blockWidth - 8, 3.5); // Top bevel
                diffCtx.fillRect(x + 4, y + 4, 3.5, courseHeight - 8); // Left bevel

                bumpCtx.fillStyle = '#f6f6f6';
                bumpCtx.fillRect(x + 4, y + 4, blockWidth - 8, 3.5);
                bumpCtx.fillRect(x + 4, y + 4, 3.5, courseHeight - 8);

                // Bottom and Right chamfer fall into shadow (Deep relief undercut + dark shadow)
                diffCtx.fillStyle = shadowColor;
                diffCtx.fillRect(x + 4, y + courseHeight - 7.5, blockWidth - 8, 3.5); // Bottom bevel
                diffCtx.fillRect(x + blockWidth - 7.5, y + 4, 3.5, courseHeight - 8); // Right bevel

                bumpCtx.fillStyle = '#181818';
                bumpCtx.fillRect(x + 4, y + courseHeight - 7.5, blockWidth - 8, 3.5);
                bumpCtx.fillRect(x + blockWidth - 7.5, y + 4, 3.5, courseHeight - 8);

                // Deep vertical head mortar joint (حل عمودي غائر بالملي بين الحجرين)
                diffCtx.fillStyle = jointColor;
                diffCtx.fillRect(x + blockWidth - 4.5, y, 7.5, courseHeight);

                bumpCtx.fillStyle = '#000000'; // Deepest possible mortar recess
                bumpCtx.fillRect(x + blockWidth - 4.5, y, 7.5, courseHeight);

                x += blockWidth;
            }

            // Deep horizontal bed mortar joint (كحلة أفقية عميقة ومستقيمة بين المداميك)
            diffCtx.fillStyle = jointColor;
            diffCtx.fillRect(0, y + courseHeight - 4.5, TEX_RES, 7.5);

            bumpCtx.fillStyle = '#000000'; // Deepest possible mortar bed recess
            bumpCtx.fillRect(0, y + courseHeight - 4.5, TEX_RES, 7.5);
        }

        const diffTexture = new THREE.CanvasTexture(diffCanvas);
        diffTexture.wrapS = THREE.RepeatWrapping;
        diffTexture.wrapT = THREE.RepeatWrapping;
        diffTexture.generateMipmaps = true;
        diffTexture.minFilter = THREE.LinearMipmapLinearFilter;
        if (threeRenderer) {
            diffTexture.anisotropy = Math.min(16, threeRenderer.capabilities.getMaxAnisotropy());
        }

        const bumpTexture = new THREE.CanvasTexture(bumpCanvas);
        bumpTexture.wrapS = THREE.RepeatWrapping;
        bumpTexture.wrapT = THREE.RepeatWrapping;
        bumpTexture.generateMipmaps = true;
        bumpTexture.minFilter = THREE.LinearMipmapLinearFilter;
        if (threeRenderer) {
            bumpTexture.anisotropy = Math.min(16, threeRenderer.capabilities.getMaxAnisotropy());
        }

        const result = { diffuse: diffTexture, bump: bumpTexture };
        stoneTextureCache[key] = result;
        return result;
    }

    function initOrResize3D() {
        const canvas = document.getElementById('threeCanvas');
        if (!canvas) return;

        const container = canvas.parentElement;
        const width = container.clientWidth || 400;
        const height = container.clientHeight || 460;

        if (!isThreeInitialized && typeof THREE !== 'undefined') {
            threeScene = new THREE.Scene();
            threeScene.background = new THREE.Color(0x0f172a); // Deep slate architectural studio
            threeScene.fog = new THREE.FogExp2(0x0f172a, 0.018);

            threeCamera = new THREE.PerspectiveCamera(36, width / height, 0.2, 120);
            threeCamera.position.set(0.2, 3.6, 13.2); // Direct front hero view

            threeRenderer = new THREE.WebGLRenderer({ 
                canvas: canvas, 
                antialias: true, 
                alpha: true,
                logarithmicDepthBuffer: true, // Prevents Z-fighting and geometry flickering
                powerPreference: 'high-performance'
            });
            threeRenderer.setSize(width, height);
            threeRenderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            threeRenderer.shadowMap.enabled = true;
            threeRenderer.shadowMap.type = THREE.PCFSoftShadowMap;
            threeRenderer.toneMapping = THREE.ACESFilmicToneMapping;
            threeRenderer.toneMappingExposure = 1.12;

            if (typeof THREE.OrbitControls !== 'undefined') {
                threeControls = new THREE.OrbitControls(threeCamera, threeRenderer.domElement);
                threeControls.enableDamping = true;
                threeControls.dampingFactor = 0.05;
                threeControls.maxPolarAngle = Math.PI / 2 - 0.02;
                threeControls.minDistance = 2.0;
                threeControls.maxDistance = 80; // Allows comfortable zoom out for 4+ story buildings
                threeControls.target.set(0, 2.4, 0);
            }

            // Studio Architectural Lighting (Natural Sunlight & Ambient Fill)
            const hemiLight = new THREE.HemisphereLight(0xffffff, 0x334155, 0.85);
            threeScene.add(hemiLight);

            // Sun Key Light with clean soft shadows & raking angle that catches stone relief
            const sunLight = new THREE.DirectionalLight(0xfffbeb, 1.65);
            sunLight.position.set(16, 22, 12);
            sunLight.castShadow = true;
            sunLight.shadow.mapSize.width = 2048;
            sunLight.shadow.mapSize.height = 2048;
            sunLight.shadow.bias = -0.0002;
            threeScene.add(sunLight);

            // Raking Architectural Accent Light (Grazes facades to pop stone chisel tooling & joints)
            const rakingLight = new THREE.DirectionalLight(0xffedd5, 0.70);
            rakingLight.position.set(-14, 12, 16);
            threeScene.add(rakingLight);

            // Soft Fill Light (Sky reflection)
            const fillLight = new THREE.DirectionalLight(0x93c5fd, 0.45);
            fillLight.position.set(-12, 10, -8);
            threeScene.add(fillLight);

            // Architectural Plinth Podium (Presentation Base)
            const plinthGeo = new THREE.CylinderGeometry(15, 16, 0.4, 48);
            const plinthMat = new THREE.MeshStandardMaterial({ color: 0x090d16, roughness: 0.9 });
            const plinthMesh = new THREE.Mesh(plinthGeo, plinthMat);
            plinthMesh.position.y = -0.22;
            plinthMesh.receiveShadow = true;
            threeScene.add(plinthMesh);

            // Paved Entrance Plaza (Offset below 0 to prevent plinth coplanar fight)
            const plazaGeo = new THREE.BoxGeometry(15, 0.08, 13);
            const plazaMat = new THREE.MeshStandardMaterial({ color: 0x334155, roughness: 0.7 });
            const plazaMesh = new THREE.Mesh(plazaGeo, plazaMat);
            plazaMesh.position.set(0, -0.04, 1.2);
            plazaMesh.receiveShadow = true;
            threeScene.add(plazaMesh);

            isThreeInitialized = true;
            animate3D();
        } else if (threeRenderer && threeCamera) {
            threeRenderer.setSize(width, height);
            threeCamera.aspect = width / height;
            threeCamera.updateProjectionMatrix();
        }

        // Attach user interaction listener to cancel automated drone flight
        const cv = document.getElementById('threeCanvas');
        if (cv && !cv.dataset.hasPointerListener) {
            cv.dataset.hasPointerListener = 'true';
            cv.addEventListener('pointerdown', () => {
                if (isDroneOrbiting) {
                    toggleDroneOrbit(false);
                }
                isCameraAnimating = false;
            });
        }

        update3DScene();
    }

    function animate3D() {
        if (!isThreeInitialized) return;
        requestAnimationFrame(animate3D);

        // Architectural Camera Lerp Interpolation
        if (isCameraAnimating && cameraTargetPos && controlsTargetPos && threeCamera && threeControls) {
            threeCamera.position.lerp(cameraTargetPos, 0.07);
            threeControls.target.lerp(controlsTargetPos, 0.07);
            if (threeCamera.position.distanceTo(cameraTargetPos) < 0.04 && 
                threeControls.target.distanceTo(controlsTargetPos) < 0.04) {
                threeCamera.position.copy(cameraTargetPos);
                threeControls.target.copy(controlsTargetPos);
                isCameraAnimating = false;
            }
        }

        // Cinematic 360 Drone Orbit Tour (Dynamic height & radius adapting to any floor count!)
        if (isDroneOrbiting && threeCamera && threeControls) {
            droneAngle += 0.0055;
            const floors = parseInt(document.getElementById('floorsInput')?.value || 2);
            const totalHeight = floors * 2.8 + 1.2;
            const targetY = totalHeight * 0.48;
            const vFovRad = (threeCamera.fov || 36) * Math.PI / 180;
            const optDist = Math.max(14.0, (totalHeight * 1.45 / 2) / Math.tan(vFovRad / 2));

            const orbitRadius = optDist * 0.95;
            const orbitH = targetY + 1.8 + Math.sin(droneAngle * 0.4) * (optDist * 0.12);
            threeCamera.position.x = Math.sin(droneAngle) * orbitRadius;
            threeCamera.position.z = Math.cos(droneAngle) * orbitRadius;
            threeCamera.position.y = orbitH;
            threeControls.target.set(0, targetY, 0);
        }

        if (threeControls) threeControls.update();
        if (threeRenderer && threeScene && threeCamera) {
            threeRenderer.render(threeScene, threeCamera);
        }
    }

    // ────────────────────────────────────────────────────────────────
    // DETAILED ARCHITECTURAL & STRUCTURAL SCENE BUILDER
    // ────────────────────────────────────────────────────────────────
    function update3DScene() {
        if (!isThreeInitialized || !threeScene) return;

        const floors = parseInt(document.getElementById('floorsInput')?.value || 2);
        const area = parseFloat(document.getElementById('areaInput')?.value || 250);
        const stoneType = document.querySelector('input[name="stoneType"]:checked')?.value || "Natural_Ruwaished";
        const stoneFinish = document.querySelector('input[name="stoneFinish"]:checked')?.value || "Mufajjar";
        const columnBars = document.querySelector('input[name="columnBarsCount"]:checked')?.value || "6Bars";
        const stoneEnabled = document.getElementById('enableStoneModule')?.checked ?? true;
        const includeCornice = document.getElementById('includeCorniceBelt')?.checked ?? true;
        const windowCount = parseInt(document.getElementById('windowFramesCount')?.value || 8);
        const entranceCols = parseInt(document.getElementById('entranceColumnsCount')?.value || 2);

        // Update Info Bar text (Outside Canvas)
        const overlay = document.getElementById('canvasOverlayInfo');
        if (overlay) {
            const stoneName = stoneType === "Natural_Ruwaished" ? (isEnMode ? "Ruwaished Stone" : "حجر رويشد") :
                              (stoneType === "Natural_Maan" ? (isEnMode ? "Ma'an White Stone" : "حجر معان أبيض") :
                              (isEnMode ? "Engineered Stone" : "حجر صناعي"));
            const finishName = stoneFinish === "Tabzeh" ? (isEnMode ? "Tabzeh Finish" : "نقشة طبزة") :
                              (stoneFinish === "Musamsam" ? (isEnMode ? "Musamsam Finish" : "نقشة مسمسم") :
                              (stoneFinish === "Monaqqar" ? (isEnMode ? "Monaqqar Finish" : "نقشة منقر") :
                              (stoneFinish === "Honed" ? (isEnMode ? "Honed Smooth" : "حجر مطفي ناعم") :
                              (isEnMode ? "Mufajjar Finish" : "نقشة مفجر"))));
            const styleName = currentArchStyle === 'apartment' ? (isEnMode ? "Apartments" : "عمارة سكنية") :
                              (currentArchStyle === 'modern' ? (
                                  currentModernConcept === 'cubic' ? (isEnMode ? "Modern Villa (Cubic Dabouq)" : "فيلا مودرن (مكعبات دابوق)") :
                                  currentModernConcept === 'horizon' ? (isEnMode ? "Modern Villa (Horizon Ribbon)" : "فيلا مودرن (أفقية وشريطية)") :
                                  (isEnMode ? "Modern Villa (Cantilever Portal)" : "فيلا مودرن (بوابة كابولي)")
                              ) :
                              (isEnMode ? "Classic Villa" : "فيلا كلاسيكية"));
            overlay.innerText = `${styleName} • ${floors} ${isEnMode ? 'Floors' : 'طوابق'} • ${stoneEnabled ? `${stoneName} (${finishName})` : (isEnMode ? 'Skeleton' : 'عظم')} • ${columnBars}`;
        }

        if (houseGroup) threeScene.remove(houseGroup);
        if (skeletonGroup) threeScene.remove(skeletonGroup);

        houseGroup = new THREE.Group();
        skeletonGroup = new THREE.Group();

        const baseWidth = Math.min(10.2, Math.max(7.2, Math.sqrt(area) * 0.45));
        const baseDepth = baseWidth * 0.82;
        const floorHeight = 2.8;

        // Authentic Jordanian Stone Specifications & Materials
        const stoneMaps = getProceduralStoneMaps(stoneType, stoneFinish);
        // Repeat maps so 1 repeat unit = 4.0m, yielding authentic 25cm courses!
        stoneMaps.diffuse.repeat.set(baseWidth / 4.0, floorHeight / 4.0);
        stoneMaps.bump.repeat.set(baseWidth / 4.0, floorHeight / 4.0);

        const stoneTrimColor = stoneType === "Natural_Maan" ? 0xffffff : (stoneType === "Natural_Ruwaished" ? 0xd8c59f : 0xb5afa3);
        const stonePlinthColor = stoneType === "Natural_Maan" ? 0xd0cbbd : 0x8a7b66;

        const wallMaterial = new THREE.MeshStandardMaterial({
            map: stoneMaps.diffuse,
            bumpMap: stoneMaps.bump,
            bumpScale: stoneFinish === 'Tabzeh' ? 0.042 : (stoneFinish === 'Musamsam' ? 0.032 : (stoneFinish === 'Monaqqar' ? 0.028 : (stoneFinish === 'Honed' ? 0.007 : 0.048))),
            roughness: stoneFinish === 'Tabzeh' ? 0.76 : (stoneFinish === 'Musamsam' ? 0.80 : (stoneFinish === 'Monaqqar' ? 0.78 : (stoneFinish === 'Honed' ? 0.40 : 0.82))),
            metalness: 0.02,
            transparent: isXRayMode,
            opacity: isXRayMode ? 0.06 : 1.0
        });

        // Helper to get correctly mapped stone material for custom elements (parapets, stairwells)
        // Strictly guarantees authentic 25cm course height everywhere without stretching or squishing!
        function getStoneWallMaterial(w, h) {
            const mat = wallMaterial.clone();
            mat.map = stoneMaps.diffuse.clone();
            mat.bumpMap = stoneMaps.bump.clone();
            mat.map.repeat.set(w / 4.0, h / 4.0);
            mat.bumpMap.repeat.set(w / 4.0, h / 4.0);
            mat.map.needsUpdate = true;
            mat.bumpMap.needsUpdate = true;
            return mat;
        }

        const stonePlinthMaterial = new THREE.MeshStandardMaterial({
            color: stonePlinthColor,
            roughness: 0.8,
            transparent: isXRayMode,
            opacity: isXRayMode ? 0.08 : 1.0
        });

        const stoneTrimMaterial = new THREE.MeshStandardMaterial({
            color: stoneTrimColor,
            roughness: 0.55,
            transparent: isXRayMode,
            opacity: isXRayMode ? 0.08 : 1.0
        });

        const floorSlabMaterial = new THREE.MeshStandardMaterial({
            color: 0xded9cf,
            roughness: 0.65,
            transparent: isXRayMode,
            opacity: isXRayMode ? 0.12 : 1.0
        });

        // Hyper-realistic Physical PBR Architectural Glass with optical transmission, IOR 1.52 & clearcoat
        const glassMaterial = new THREE.MeshPhysicalMaterial({
            color: 0xffffff,
            transmission: 0.90,
            opacity: 1.0,
            transparent: true,
            roughness: 0.02,
            ior: 1.52,
            metalness: 0.04,
            clearcoat: 1.0,
            clearcoatRoughness: 0.03,
            depthWrite: false
        });

        // Modern Balustrade Glass (Crystal Clear Laminated Safety Glass with subtle optical reflection)
        const modernBalustradeGlass = new THREE.MeshPhysicalMaterial({
            color: 0xdcf0fa,
            transmission: 0.88,
            opacity: 1.0,
            transparent: true,
            roughness: 0.02,
            ior: 1.52,
            metalness: 0.06,
            clearcoat: 1.0,
            clearcoatRoughness: 0.02,
            depthWrite: false
        });

        // Luxury Modern Entrance Door Materials (Warm Natural Walnut / Oak & Brushed Brass)
        const modernWoodDoorMat = new THREE.MeshStandardMaterial({
            color: 0x9a5b28, // Warm rich architectural walnut / oak
            roughness: 0.35,
            metalness: 0.05
        });

        const modernDoorGrooveMat = new THREE.MeshStandardMaterial({
            color: 0x3d1a08, // Dark shadow walnut reveal grooves
            roughness: 0.6
        });

        const brassHandleMat = new THREE.MeshStandardMaterial({
            color: 0xf59e0b, // Warm polished brushed brass / gold
            metalness: 0.92,
            roughness: 0.18
        });

        const doorGlassMat = new THREE.MeshPhysicalMaterial({
            color: 0xffffff,
            transmission: 0.85,
            opacity: 1.0,
            transparent: true,
            roughness: 0.1,
            ior: 1.52,
            depthWrite: false
        });

        const darkMetalMaterial = new THREE.MeshStandardMaterial({
            color: 0x0f172a, // Charcoal black aluminum
            roughness: 0.25,
            metalness: 0.75,
            transparent: isXRayMode,
            opacity: isXRayMode ? 0.1 : 1.0
        });

        const woodDoorMaterial = new THREE.MeshStandardMaterial({
            color: 0x27170e, // Dark mahogany / teak
            roughness: 0.4
        });

        const teakLouverMaterial = new THREE.MeshStandardMaterial({
            color: 0x854d0e, // Teak wood louvers for modern villa
            roughness: 0.5
        });

        const handleMaterial = new THREE.MeshStandardMaterial({
            color: 0xf1f5f9, // Brushed stainless steel
            metalness: 0.95,
            roughness: 0.1
        });

        // Interior Materials
        const interiorFloorMat = new THREE.MeshStandardMaterial({ color: 0xecdcc9, roughness: 0.35 }); // Warm crema marble / parquet
        const interiorWallMat = new THREE.MeshStandardMaterial({ color: 0xfbf9f5, roughness: 0.8 }); // Off-white interior wall
        const ceilingGlowMat = new THREE.MeshBasicMaterial({ color: 0xfffaed }); // Recessed downlight panel

        // ─────────────────────────────────────────────────────────────
        // 1. BASE PLINTH COURSE (مدماك السلسال الحجري السفلي)
        // ─────────────────────────────────────────────────────────────
        const plinthHeight = 0.42;
        const plinthGeo = new THREE.BoxGeometry(baseWidth + 0.16, plinthHeight, baseDepth + 0.16);
        const plinthMesh = new THREE.Mesh(plinthGeo, stonePlinthMaterial);
        plinthMesh.position.set(0, plinthHeight / 2, 0);
        plinthMesh.receiveShadow = true;
        houseGroup.add(plinthMesh);

        // ─────────────────────────────────────────────────────────────
        // 2. DETAILED FLOORS & ARCHITECTURAL ELEMENTS
        // ─────────────────────────────────────────────────────────────
        const isClassic = currentArchStyle === 'classic';
        const isApartment = currentArchStyle === 'apartment';
        const isModern = currentArchStyle === 'modern';

        for (let i = 0; i < floors; i++) {
            const floorY = i * floorHeight;

            // Geometry massing offsets
            let fW = baseWidth;
            let fD = baseDepth;
            let fX = 0;
            let fZ = 0;

            if (isModern) {
                if (currentModernConcept === 'cubic') {
                    // Staggered cubic Dabouq villa
                    fW = baseWidth * 0.96;
                    fD = baseDepth * 1.04;
                    if (i === 1) {
                        fX = -0.25;
                        fZ = 0.35;
                    } else if (i >= 2) {
                        fX = 0.25;
                        fZ = -0.15;
                    }
                } else if (currentModernConcept === 'horizon') {
                    // Continuous horizontal wide proportions
                    fW = baseWidth * 1.06;
                    fD = baseDepth * 0.94;
                    if (i === 1) {
                        fZ = 0.18;
                    }
                } else {
                    // 'cantilever'
                    if (i === 1) {
                        fW = baseWidth * 0.96;
                        fD = baseDepth * 1.08;
                        fX = 0;
                        fZ = 0.35;
                    }
                }
            }

            const wallThick = 0.26;
            const frontZ = fZ + fD / 2;

            // ── MAIN OUTER WALLS ──
            if (isModern && i === 0 && !isXRayMode) {
                // GROUND FLOOR MODERN FACADE
                if (currentModernConcept === 'cubic') {
                    // Staggered Cubic Ground Floor:
                    // Left recessed salon block + Right forward entrance block
                    const halfW = fW * 0.50;
                    const cCurtainH = floorHeight * 0.85;

                    // Back Wall
                    const bWall = new THREE.Mesh(new THREE.BoxGeometry(fW, floorHeight, wallThick), wallMaterial);
                    bWall.position.set(fX, floorY + floorHeight / 2, fZ - fD / 2 + wallThick / 2);
                    bWall.castShadow = true; bWall.receiveShadow = true;
                    houseGroup.add(bWall);

                    // Left & Right Outer Walls
                    const lWall = new THREE.Mesh(new THREE.BoxGeometry(wallThick, floorHeight, fD), wallMaterial);
                    lWall.position.set(fX - fW / 2 + wallThick / 2, floorY + floorHeight / 2, fZ);
                    lWall.castShadow = true; houseGroup.add(lWall);

                    const rWall = new THREE.Mesh(new THREE.BoxGeometry(wallThick, floorHeight, fD), wallMaterial);
                    rWall.position.set(fX + fW / 2 - wallThick / 2, floorY + floorHeight / 2, fZ);
                    rWall.castShadow = true; houseGroup.add(rWall);

                    // Right Solid Cubic Block (Entrance side)
                    const rFrontWall = new THREE.Mesh(new THREE.BoxGeometry(halfW, floorHeight, wallThick), wallMaterial);
                    rFrontWall.position.set(fX + halfW / 2, floorY + floorHeight / 2, frontZ - wallThick / 2);
                    rFrontWall.castShadow = true; rFrontWall.receiveShadow = true;
                    houseGroup.add(rFrontWall);

                    // Left Block Header above glass
                    const lHeaderH = floorHeight - cCurtainH;
                    const lHeader = new THREE.Mesh(new THREE.BoxGeometry(halfW, lHeaderH, wallThick), wallMaterial);
                    lHeader.position.set(fX - halfW / 2, floorY + cCurtainH + lHeaderH / 2, frontZ - wallThick / 2);
                    lHeader.castShadow = true; houseGroup.add(lHeader);

                    // Left Block Floor-to-Ceiling Glazing
                    const lGlass = new THREE.Mesh(new THREE.BoxGeometry(halfW - 0.08, cCurtainH, 0.05), glassMaterial);
                    lGlass.position.set(fX - halfW / 2, floorY + cCurtainH / 2 + 0.04, frontZ + 0.01);
                    houseGroup.add(lGlass);

                    // Vertical Mullions
                    [-halfW / 4, 0, halfW / 4].forEach(mx => {
                        const mul = new THREE.Mesh(new THREE.BoxGeometry(0.04, cCurtainH, 0.07), darkMetalMaterial);
                        mul.position.set(fX - halfW / 2 + mx, floorY + cCurtainH / 2 + 0.04, frontZ + 0.02);
                        houseGroup.add(mul);
                    });

                    // Grand Modern Entrance Door on Right Block (Rich Walnut & Brass with Downlight)
                    const doorW = 1.45;
                    const doorH = 2.45;
                    const doorX = fX + halfW * 0.42;
                    const doorY = floorY + doorH / 2 + 0.05;
                    buildModernLuxuryDoor(houseGroup, doorX, doorY, frontZ, doorW, doorH, 'left', darkMetalMaterial, stoneTrimMaterial);

                    // Slit Window on the Right Block
                    buildDetailedWindow(houseGroup, fX + halfW * 0.85, floorY + floorHeight * 0.52, frontZ, 0.55, 2.0, 'front', stoneTrimMaterial, glassMaterial, darkMetalMaterial, false, true);

                    // Double-Height Atrium Chandelier in Center (hanging elegance)
                    const chGeo = new THREE.CylinderGeometry(0.01, 0.01, 1.8, 8);
                    const chRod = new THREE.Mesh(chGeo, handleMaterial);
                    chRod.position.set(fX + 0.1, floorY + floorHeight - 0.5, frontZ - 0.8);
                    houseGroup.add(chRod);

                    [-0.3, 0.3].forEach(off => {
                        const orbGeo = new THREE.SphereGeometry(0.12, 16, 16);
                        const orb = new THREE.Mesh(orbGeo, new THREE.MeshBasicMaterial({ color: 0xfffaed }));
                        orb.position.set(fX + 0.1 + off, floorY + floorHeight - 1.2 + Math.abs(off) * 0.3, frontZ - 0.8);
                        houseGroup.add(orb);
                    });

                } else if (currentModernConcept === 'horizon') {
                    // Horizon Ribbon Ground Floor: Continuous panoramic glass facade
                    const curtainW = fW * 0.82;
                    const curtainH = floorHeight * 0.84;
                    const pierW = (fW - curtainW) / 2;

                    // Back & Side Walls
                    const bWall = new THREE.Mesh(new THREE.BoxGeometry(fW, floorHeight, wallThick), wallMaterial);
                    bWall.position.set(fX, floorY + floorHeight / 2, fZ - fD / 2 + wallThick / 2);
                    bWall.castShadow = true; bWall.receiveShadow = true;
                    houseGroup.add(bWall);

                    const lWall = new THREE.Mesh(new THREE.BoxGeometry(wallThick, floorHeight, fD), wallMaterial);
                    lWall.position.set(fX - fW / 2 + wallThick / 2, floorY + floorHeight / 2, fZ);
                    lWall.castShadow = true; houseGroup.add(lWall);

                    const rWall = new THREE.Mesh(new THREE.BoxGeometry(wallThick, floorHeight, fD), wallMaterial);
                    rWall.position.set(fX + fW / 2 - wallThick / 2, floorY + floorHeight / 2, fZ);
                    rWall.castShadow = true; houseGroup.add(rWall);

                    // Left & Right Stone Return Piers
                    const lPier = new THREE.Mesh(new THREE.BoxGeometry(pierW, floorHeight, wallThick), wallMaterial);
                    lPier.position.set(fX - fW / 2 + pierW / 2, floorY + floorHeight / 2, frontZ - wallThick / 2);
                    lPier.castShadow = true; houseGroup.add(lPier);

                    const rPier = new THREE.Mesh(new THREE.BoxGeometry(pierW, floorHeight, wallThick), wallMaterial);
                    rPier.position.set(fX + fW / 2 - pierW / 2, floorY + floorHeight / 2, frontZ - wallThick / 2);
                    rPier.castShadow = true; houseGroup.add(rPier);

                    // Header above continuous ribbon glass
                    const headerH = floorHeight - curtainH;
                    const cHeader = new THREE.Mesh(new THREE.BoxGeometry(curtainW, headerH, wallThick), wallMaterial);
                    cHeader.position.set(fX, floorY + curtainH + headerH / 2, frontZ - wallThick / 2);
                    cHeader.castShadow = true; houseGroup.add(cHeader);

                    // Wall-to-Wall Glass Curtain Wall
                    const curtainGlass = new THREE.Mesh(new THREE.BoxGeometry(curtainW, curtainH, 0.05), glassMaterial);
                    curtainGlass.position.set(fX, floorY + curtainH / 2 + 0.04, frontZ + 0.01);
                    houseGroup.add(curtainGlass);

                    // Slim Vertical Mullions spaced along ribbon
                    [-curtainW * 0.35, -curtainW * 0.12, curtainW * 0.12, curtainW * 0.35].forEach(mx => {
                        const mul = new THREE.Mesh(new THREE.BoxGeometry(0.04, curtainH, 0.07), darkMetalMaterial);
                        mul.position.set(fX + mx, floorY + curtainH / 2 + 0.04, frontZ + 0.02);
                        houseGroup.add(mul);
                    });

                    // Sliding Entrance Door Handle
                    const hHandle = new THREE.Mesh(new THREE.BoxGeometry(0.4, 0.03, 0.05), handleMaterial);
                    hHandle.position.set(fX + 0.3, floorY + 1.1, frontZ + 0.06);
                    houseGroup.add(hHandle);

                    // Full-Width Sleek Horizontal Entrance Canopy
                    const canW = curtainW + 0.6;
                    const canD = 1.35;
                    const canMesh = new THREE.Mesh(new THREE.BoxGeometry(canW, 0.12, canD), darkMetalMaterial);
                    canMesh.position.set(fX, floorY + curtainH + 0.06, frontZ + canD / 2);
                    canMesh.castShadow = true;
                    houseGroup.add(canMesh);

                } else {
                    // Cantilever Portal Ground Floor
                    const curtainH = floorHeight * 0.84;
                    const curtainW = fW * 0.44;

                    const bWall = new THREE.Mesh(new THREE.BoxGeometry(fW, floorHeight, wallThick), wallMaterial);
                    bWall.position.set(fX, floorY + floorHeight / 2, fZ - fD / 2 + wallThick / 2);
                    bWall.castShadow = true; bWall.receiveShadow = true;
                    houseGroup.add(bWall);

                    const lWall = new THREE.Mesh(new THREE.BoxGeometry(wallThick, floorHeight, fD), wallMaterial);
                    lWall.position.set(fX - fW / 2 + wallThick / 2, floorY + floorHeight / 2, fZ);
                    lWall.castShadow = true; houseGroup.add(lWall);

                    const rWall = new THREE.Mesh(new THREE.BoxGeometry(wallThick, floorHeight, fD), wallMaterial);
                    rWall.position.set(fX + fW / 2 - wallThick / 2, floorY + floorHeight / 2, fZ);
                    rWall.castShadow = true; houseGroup.add(rWall);

                    // Front Right Solid Wall (Pivot entrance + teak louvers)
                    const frontRightW = fW * 0.54;
                    const frWall = new THREE.Mesh(new THREE.BoxGeometry(frontRightW, floorHeight, wallThick), wallMaterial);
                    frWall.position.set(fX + fW / 2 - frontRightW / 2, floorY + floorHeight / 2, frontZ - wallThick / 2);
                    frWall.castShadow = true; frWall.receiveShadow = true;
                    houseGroup.add(frWall);

                    // Header above living glass
                    const headerH = floorHeight - curtainH;
                    const frontLeftW = fW - frontRightW;
                    const flHeader = new THREE.Mesh(new THREE.BoxGeometry(frontLeftW, headerH, wallThick), wallMaterial);
                    flHeader.position.set(fX - fW / 2 + frontLeftW / 2, floorY + curtainH + headerH / 2, frontZ - wallThick / 2);
                    flHeader.castShadow = true; houseGroup.add(flHeader);

                    // Living Glass Curtain Wall
                    const curtainGlass = new THREE.Mesh(new THREE.BoxGeometry(curtainW, curtainH, 0.05), glassMaterial);
                    curtainGlass.position.set(fX - fW * 0.22, floorY + curtainH / 2 + 0.06, frontZ + 0.01);
                    houseGroup.add(curtainGlass);

                    // Mullions
                    [-curtainW / 4, 0, curtainW / 4].forEach(mx => {
                        const mul = new THREE.Mesh(new THREE.BoxGeometry(0.04, curtainH, 0.07), darkMetalMaterial);
                        mul.position.set(fX - fW * 0.22 + mx, floorY + curtainH / 2 + 0.06, frontZ + 0.02);
                        houseGroup.add(mul);
                    });

                    // Grand Pivot Door (Rich Walnut & Brass with Slatted Flutes & Downlight)
                    const doorW = 1.55;
                    const doorH = 2.45;
                    const doorX = fX + fW * 0.16;
                    const doorY = floorY + doorH / 2 + 0.05;
                    buildModernLuxuryDoor(houseGroup, doorX, doorY, frontZ, doorW, doorH, 'left', darkMetalMaterial, stoneTrimMaterial);

                    // Acoustic Teak Battens
                    const louverAreaW = 1.2;
                    const numBattens = 7;
                    for (let b = 0; b < numBattens; b++) {
                        const bx = doorX + doorW / 2 + 0.1 + (b * (louverAreaW / numBattens));
                        const battenMesh = new THREE.Mesh(new THREE.BoxGeometry(0.06, doorH, 0.08), teakLouverMaterial);
                        battenMesh.position.set(bx, doorY, frontZ + 0.04);
                        battenMesh.castShadow = true;
                        houseGroup.add(battenMesh);
                    }

                    // Floating Entrance Canopy
                    const canW = doorW + louverAreaW + 0.6;
                    const canD = 1.4;
                    const canMesh = new THREE.Mesh(new THREE.BoxGeometry(canW, 0.12, canD), darkMetalMaterial);
                    canMesh.position.set(doorX + (louverAreaW / 2) - 0.1, doorY + doorH / 2 + 0.1, frontZ + canD / 2);
                    canMesh.castShadow = true;
                    houseGroup.add(canMesh);
                }
            } else {
                // Standard solid floor walls for Classic / Apartment / Upper floors
                const floorGeo = new THREE.BoxGeometry(fW, floorHeight, fD);
                const floorMesh = new THREE.Mesh(floorGeo, wallMaterial);
                floorMesh.position.set(fX, floorY + floorHeight / 2, fZ);
                floorMesh.castShadow = !isXRayMode;
                floorMesh.receiveShadow = true;
                houseGroup.add(floorMesh);
            }

            // ── INTERIOR ROOMS & WARM LIGHTING (داخل البيت مضاء ومفروش بفخامة) ──
            if (!isXRayMode) {
                // Interior Floor Slab (Warm marble/parquet)
                const intFloorGeo = new THREE.BoxGeometry(fW - 0.25, 0.04, fD - 0.25);
                const intFloorMesh = new THREE.Mesh(intFloorGeo, interiorFloorMat);
                intFloorMesh.position.set(fX, floorY + 0.03, fZ);
                houseGroup.add(intFloorMesh);

                // Interior Central Partition Wall
                const intPartGeo = new THREE.BoxGeometry(0.12, floorHeight - 0.2, fD * 0.65);
                const intPartMesh = new THREE.Mesh(intPartGeo, interiorWallMat);
                intPartMesh.position.set(fX + fW * 0.08, floorY + floorHeight / 2, fZ);
                houseGroup.add(intPartMesh);

                // Warm Interior Architectural Light
                const intLight = new THREE.PointLight(0xffecd2, 1.15, 11);
                intLight.position.set(fX, floorY + floorHeight * 0.72, fZ);
                houseGroup.add(intLight);

                // Recessed Ceiling Downlight Glow Panel
                const downlightGeo = new THREE.BoxGeometry(fW * 0.5, 0.02, fD * 0.5);
                const downlightMesh = new THREE.Mesh(downlightGeo, ceilingGlowMat);
                downlightMesh.position.set(fX, floorY + floorHeight - 0.04, fZ);
                houseGroup.add(downlightMesh);

                // GROUND FLOOR LUXURY FURNISHED SALON
                if (i === 0) {
                    const roomFrontZ = fZ + fD / 2;
                    const sofaMat = new THREE.MeshStandardMaterial({ color: 0x1e293b, roughness: 0.85 });
                    const cushionMat = new THREE.MeshStandardMaterial({ color: 0xd6cbb8, roughness: 0.75 });
                    const marbleTableMat = new THREE.MeshStandardMaterial({ color: 0xf8fafc, roughness: 0.25, metalness: 0.1 });
                    const brassGoldMat = new THREE.MeshStandardMaterial({ color: 0xd4af37, metalness: 0.88, roughness: 0.22 });
                    const fireplaceMat = new THREE.MeshStandardMaterial({ color: 0x0f172a, roughness: 0.3 });
                    const flameMat = new THREE.MeshBasicMaterial({ color: 0xff7700 });
                    const plantPotMat = new THREE.MeshStandardMaterial({ color: 0xf1f5f9, roughness: 0.5 });
                    const leafMat = new THREE.MeshStandardMaterial({ color: 0x14532d, roughness: 0.6 });

                    // Italian Sectional L-Sofa
                    const sofaSeat = new THREE.Mesh(new THREE.BoxGeometry(2.3, 0.36, 0.9), sofaMat);
                    sofaSeat.position.set(fX - fW * 0.14, floorY + 0.22, fZ - 0.3);
                    sofaSeat.castShadow = true; houseGroup.add(sofaSeat);

                    const sofaBack = new THREE.Mesh(new THREE.BoxGeometry(2.3, 0.44, 0.22), sofaMat);
                    sofaBack.position.set(fX - fW * 0.14, floorY + 0.48, fZ - 0.3 - 0.35);
                    sofaBack.castShadow = true; houseGroup.add(sofaBack);

                    const chaise = new THREE.Mesh(new THREE.BoxGeometry(0.9, 0.36, 1.25), sofaMat);
                    chaise.position.set(fX - fW * 0.14 - 1.15 + 0.45, floorY + 0.22, fZ - 0.3 + 0.85);
                    chaise.castShadow = true; houseGroup.add(chaise);

                    [-0.55, 0.35].forEach(px => {
                        const pillow = new THREE.Mesh(new THREE.BoxGeometry(0.38, 0.28, 0.12), cushionMat);
                        pillow.rotation.y = 0.08;
                        pillow.position.set(fX - fW * 0.14 + px, floorY + 0.46, fZ - 0.3 - 0.2);
                        houseGroup.add(pillow);
                    });

                    // Calacatta Marble & Brass Table
                    const tableTop = new THREE.Mesh(new THREE.BoxGeometry(1.35, 0.05, 0.7), marbleTableMat);
                    tableTop.position.set(fX - fW * 0.14, floorY + 0.32, fZ + 0.55);
                    tableTop.castShadow = true; houseGroup.add(tableTop);

                    [-0.55, 0.55].forEach(tx => {
                        [-0.26, 0.26].forEach(tz => {
                            const leg = new THREE.Mesh(new THREE.CylinderGeometry(0.016, 0.016, 0.29, 8), brassGoldMat);
                            leg.position.set(fX - fW * 0.14 + tx, floorY + 0.16, fZ + 0.55 + tz);
                            houseGroup.add(leg);
                        });
                    });

                    // Fireplace
                    const fpBase = new THREE.Mesh(new THREE.BoxGeometry(2.0, 0.70, 0.32), fireplaceMat);
                    fpBase.position.set(fX - fW * 0.14, floorY + 0.38, roomFrontZ - 0.45);
                    fpBase.castShadow = true; houseGroup.add(fpBase);

                    const firebox = new THREE.Mesh(new THREE.BoxGeometry(1.3, 0.24, 0.20), flameMat);
                    firebox.position.set(fX - fW * 0.14, floorY + 0.35, roomFrontZ - 0.42);
                    houseGroup.add(firebox);

                    const fpLight = new THREE.PointLight(0xff6a00, 1.7, 5.0);
                    fpLight.position.set(fX - fW * 0.14, floorY + 0.44, roomFrontZ - 0.25);
                    houseGroup.add(fpLight);

                    // Chandelier Ring
                    const ringChandelier = new THREE.Mesh(new THREE.TorusGeometry(0.52, 0.022, 10, 28), brassGoldMat);
                    ringChandelier.rotation.x = Math.PI / 2;
                    ringChandelier.position.set(fX - fW * 0.14, floorY + floorHeight - 0.40, fZ + 0.15);
                    houseGroup.add(ringChandelier);

                    const glowRing = new THREE.Mesh(new THREE.TorusGeometry(0.50, 0.010, 8, 28), new THREE.MeshBasicMaterial({ color: 0xfffae6 }));
                    glowRing.rotation.x = Math.PI / 2;
                    glowRing.position.set(fX - fW * 0.14, floorY + floorHeight - 0.41, fZ + 0.15);
                    houseGroup.add(glowRing);

                    // Planter
                    const pot = new THREE.Mesh(new THREE.CylinderGeometry(0.22, 0.16, 0.48, 14), plantPotMat);
                    pot.position.set(fX + fW * 0.30, floorY + 0.24, roomFrontZ - 0.65);
                    pot.castShadow = true; houseGroup.add(pot);

                    const foliage = new THREE.Mesh(new THREE.DodecahedronGeometry(0.35, 1), leafMat);
                    foliage.position.set(fX + fW * 0.30, floorY + 0.78, roomFrontZ - 0.65);
                    foliage.castShadow = true; houseGroup.add(foliage);
                }
            }

            // Classical Quoins
            if (isClassic || isApartment) {
                const quoinCourseH = 0.25;
                const numQuoins = Math.floor(floorHeight / quoinCourseH);
                for (let q = 0; q < numQuoins; q++) {
                    const qY = floorY + (q * quoinCourseH) + quoinCourseH / 2;
                    const isLong = (q % 2 === 0);
                    const qLength = isLong ? 0.62 : 0.40;
                    const qDepth = isLong ? 0.40 : 0.62;
                    const qGeo = new THREE.BoxGeometry(qLength, quoinCourseH - 0.02, qDepth);

                    [
                        [fX - fW / 2 + qLength / 2 - 0.02, fZ - fD / 2 + qDepth / 2 - 0.02],
                        [fX + fW / 2 - qLength / 2 + 0.02, fZ - fD / 2 + qDepth / 2 - 0.02],
                        [fX - fW / 2 + qLength / 2 - 0.02, fZ + fD / 2 - qDepth / 2 + 0.02],
                        [fX + fW / 2 - qLength / 2 + 0.02, fZ + fD / 2 - qDepth / 2 + 0.02]
                    ].forEach(pos => {
                        const qMesh = new THREE.Mesh(qGeo, stoneTrimMaterial);
                        qMesh.position.set(pos[0], qY, pos[1]);
                        qMesh.castShadow = true;
                        houseGroup.add(qMesh);
                    });
                }
            }

            // Floor Division Slab
            const slabGeo = new THREE.BoxGeometry(fW + 0.32, 0.22, fD + 0.32);
            const slabMesh = new THREE.Mesh(slabGeo, floorSlabMaterial);
            slabMesh.position.set(fX, floorY + floorHeight, fZ);
            slabMesh.receiveShadow = true;
            slabMesh.castShadow = true;
            houseGroup.add(slabMesh);

            // Multi-Tiered Stone Cornice Belt
            if (includeCornice && i < floors - 1 && !isModern) {
                const beltGeo = new THREE.BoxGeometry(fW + 0.52, 0.24, fD + 0.52);
                const beltMesh = new THREE.Mesh(beltGeo, stoneTrimMaterial);
                beltMesh.position.set(fX, floorY + floorHeight + 0.12, fZ);
                beltMesh.castShadow = true;
                houseGroup.add(beltMesh);
            }

            // ─────────────────────────────────────────────────────────
            // FACADE OPENINGS & BALCONIES
            // ─────────────────────────────────────────────────────────
            if (i === 0) {
                // GROUND FLOOR CLASSIC / APARTMENT ENTRANCE
                if (!isModern) {
                    const doorW = 1.8;
                    const doorH = 2.4;
                    const doorY = floorY + doorH / 2 + 0.05;
                    const frameCasing = 0.16;

                    // Architrave
                    const dJambL = new THREE.Mesh(new THREE.BoxGeometry(frameCasing, doorH + frameCasing, 0.10), stoneTrimMaterial);
                    dJambL.position.set(fX - doorW / 2 - frameCasing / 2, doorY + frameCasing / 2, frontZ + 0.05);
                    dJambL.castShadow = true; houseGroup.add(dJambL);

                    const dJambR = new THREE.Mesh(new THREE.BoxGeometry(frameCasing, doorH + frameCasing, 0.10), stoneTrimMaterial);
                    dJambR.position.set(fX + doorW / 2 + frameCasing / 2, doorY + frameCasing / 2, frontZ + 0.05);
                    dJambR.castShadow = true; houseGroup.add(dJambR);

                    const dHead = new THREE.Mesh(new THREE.BoxGeometry(doorW + frameCasing * 2 + 0.1, frameCasing, 0.12), stoneTrimMaterial);
                    dHead.position.set(fX, doorY + doorH / 2 + frameCasing / 2, frontZ + 0.06);
                    dHead.castShadow = true; houseGroup.add(dHead);

                    const dKey = new THREE.Mesh(new THREE.BoxGeometry(0.20, 0.24, 0.16), stoneTrimMaterial);
                    dKey.position.set(fX, doorY + doorH / 2 + frameCasing / 2 + 0.04, frontZ + 0.08);
                    dKey.castShadow = true; houseGroup.add(dKey);

                    // Wood Door
                    const doorMesh = new THREE.Mesh(new THREE.BoxGeometry(doorW, doorH, 0.06), woodDoorMaterial);
                    doorMesh.position.set(fX, doorY, frontZ + 0.03);
                    doorMesh.castShadow = true; houseGroup.add(doorMesh);

                    // Glass Sidelights & Handles
                    [-0.45, 0.45].forEach(gx => {
                        const dGlass = new THREE.Mesh(new THREE.BoxGeometry(0.32, doorH * 0.72, 0.06), glassMaterial);
                        dGlass.position.set(fX + gx, doorY + 0.1, frontZ + 0.04);
                        houseGroup.add(dGlass);

                        const handleMesh = new THREE.Mesh(new THREE.CylinderGeometry(0.016, 0.016, 1.1, 12), handleMaterial);
                        handleMesh.position.set(fX + gx * 0.4, doorY, frontZ + 0.09);
                        houseGroup.add(handleMesh);
                    });

                    // Stone Steps
                    for (let st = 0; st < 3; st++) {
                        const stepW = doorW + 1.6 - st * 0.28;
                        const stepD = 1.0 + (3 - st) * 0.32;
                        const stepH = 0.14;
                        const stepMesh = new THREE.Mesh(new THREE.BoxGeometry(stepW, stepH, stepD), stoneTrimMaterial);
                        stepMesh.position.set(fX, (st + 1) * (stepH / 2), frontZ + stepD / 2);
                        stepMesh.receiveShadow = true; houseGroup.add(stepMesh);
                    }

                    // Flanking Windows
                    [-baseWidth * 0.32, baseWidth * 0.32].forEach(wx => {
                        buildDetailedWindow(houseGroup, fX + wx, floorY + floorHeight * 0.55, frontZ, 1.3, 1.4, 'front', stoneTrimMaterial, glassMaterial, darkMetalMaterial, isClassic, false);
                    });
                }
            } else {
                // UPPER FLOORS (i > 0)
                if (isModern) {
                    if (currentModernConcept === 'cantilever') {
                        // 1. Wrap-Around Panoramic Corner Window on Front-Left Corner
                        const cornerWinW = 2.0;
                        const cornerWinH = 1.7;
                        const cornerWinY = floorY + floorHeight * 0.55;
                        const cornerX = fX - fW / 2 + cornerWinW / 2;

                        // Front Face Glass of Corner Window
                        const cWinFront = new THREE.Mesh(new THREE.BoxGeometry(cornerWinW, cornerWinH, 0.04), glassMaterial);
                        cWinFront.position.set(cornerX, cornerWinY, frontZ + 0.02);
                        houseGroup.add(cWinFront);

                        // Side Face Glass of Corner Window (Left return)
                        const cornerSideD = 1.4;
                        const cWinSide = new THREE.Mesh(new THREE.BoxGeometry(0.04, cornerWinH, cornerSideD), glassMaterial);
                        cWinSide.position.set(fX - fW / 2 + 0.02, cornerWinY, frontZ - cornerSideD / 2);
                        houseGroup.add(cWinSide);

                        // Razor-sharp Charcoal Corner Mullion Post
                        const cCornerPost = new THREE.Mesh(new THREE.BoxGeometry(0.06, cornerWinH + 0.04, 0.06), darkMetalMaterial);
                        cCornerPost.position.set(fX - fW / 2 + 0.02, cornerWinY, frontZ + 0.02);
                        houseGroup.add(cCornerPost);

                        // Sleek Upper Balcony on the Right Side
                        const balcW = fW * 0.46;
                        const balcD = 1.35;
                        const balcX = fX + fW * 0.20;
                        const balcY = floorY + 0.12; // Strictly above lower slab (Zero Z-fighting!)

                        // Balcony Cantilever Slab
                        const bSlabMesh = new THREE.Mesh(new THREE.BoxGeometry(balcW, 0.18, balcD), stoneTrimMaterial);
                        bSlabMesh.position.set(balcX, balcY, frontZ + 0.02 + balcD / 2);
                        bSlabMesh.castShadow = true; houseGroup.add(bSlabMesh);

                        // French Sliding Patio Door
                        const fDoorW = balcW * 0.72;
                        const fDoorH = 2.15;
                        const fDoorY = floorY + fDoorH / 2 + 0.08;

                        const fBacking = new THREE.Mesh(new THREE.PlaneGeometry(fDoorW, fDoorH), new THREE.MeshBasicMaterial({ color: 0x1a1612 }));
                        fBacking.position.set(balcX, fDoorY, frontZ + 0.015);
                        houseGroup.add(fBacking);

                        const fDoor = new THREE.Mesh(new THREE.PlaneGeometry(fDoorW - 0.06, fDoorH - 0.06), glassMaterial);
                        fDoor.position.set(balcX, fDoorY, frontZ + 0.035);
                        houseGroup.add(fDoor);

                        // Aluminum Frame & Center Stile
                        const fFrameGeo = new THREE.BoxGeometry(fDoorW, fDoorH, 0.04);
                        [-fDoorW / 2 + 0.03, 0, fDoorW / 2 - 0.03].forEach(fx => {
                            const fStile = new THREE.Mesh(new THREE.BoxGeometry(0.05, fDoorH, 0.05), darkMetalMaterial);
                            fStile.position.set(balcX + fx, fDoorY, frontZ + 0.038);
                            houseGroup.add(fStile);
                        });

                        // Frameless Tempered Glass Balustrade (Zero intersection with slab)
                        const railH = 0.94;
                        const glassH = railH - 0.08;

                        // Bottom Aluminum Shoe Channel
                        const bShoe = new THREE.Mesh(new THREE.BoxGeometry(balcW, 0.05, 0.05), darkMetalMaterial);
                        bShoe.position.set(balcX, balcY + 0.09 + 0.025, frontZ + balcD - 0.03);
                        houseGroup.add(bShoe);

                        // Glass Panel
                        const gBalc = new THREE.Mesh(new THREE.BoxGeometry(balcW - 0.06, glassH, 0.02), modernBalustradeGlass);
                        gBalc.position.set(balcX, balcY + 0.09 + 0.05 + glassH / 2, frontZ + balcD - 0.03);
                        houseGroup.add(gBalc);

                        // Top Handrail Cap
                        const tCap = new THREE.Mesh(new THREE.BoxGeometry(balcW, 0.035, 0.04), darkMetalMaterial);
                        tCap.position.set(balcX, balcY + 0.09 + railH, frontZ + balcD - 0.03);
                        houseGroup.add(tCap);

                    } else if (currentModernConcept === 'cubic') {
                        // Staggered Cubic Upper Floor:
                        // Left block: Forward cantilever mass with vertical slit windows
                        // Right block: Recessed stone terrace with solid stone parapet
                        const halfW = fW * 0.50;

                        // Left Cantilevered Block Slit Windows
                        [-halfW * 0.28, halfW * 0.28].forEach(sx => {
                            buildDetailedWindow(houseGroup, fX - halfW / 2 + sx, floorY + floorHeight * 0.52, frontZ, 0.50, 1.9, 'front', stoneTrimMaterial, glassMaterial, darkMetalMaterial, false, true);
                        });

                        // Right Recessed Terrace
                        const balcW = halfW - 0.2;
                        const balcD = 1.35;
                        const balcX = fX + halfW / 2;
                        const balcY = floorY + 0.12;

                        // Recessed Terrace Floor
                        const tFloor = new THREE.Mesh(new THREE.BoxGeometry(balcW, 0.16, balcD), stoneTrimMaterial);
                        tFloor.position.set(balcX, balcY, frontZ + balcD / 2);
                        tFloor.castShadow = true; houseGroup.add(tFloor);

                        // Solid Stone Balustrade (Distinctive modern Dabouq stone parapet)
                        const stoneBalcH = 0.88;
                        const sBalc = new THREE.Mesh(new THREE.BoxGeometry(balcW, stoneBalcH, 0.16), getStoneWallMaterial(balcW, stoneBalcH));
                        sBalc.position.set(balcX, balcY + stoneBalcH / 2 + 0.08, frontZ + balcD - 0.08);
                        sBalc.castShadow = true; houseGroup.add(sBalc);

                        // Charcoal Coping on Stone Balustrade
                        const sCoping = new THREE.Mesh(new THREE.BoxGeometry(balcW + 0.04, 0.05, 0.20), darkMetalMaterial);
                        sCoping.position.set(balcX, balcY + stoneBalcH + 0.09, frontZ + balcD - 0.08);
                        houseGroup.add(sCoping);

                        // Terrace Access Glass Door
                        buildDetailedWindow(houseGroup, balcX, floorY + floorHeight * 0.52, frontZ, 1.2, 2.1, 'front', stoneTrimMaterial, glassMaterial, darkMetalMaterial, false, true);

                    } else if (currentModernConcept === 'horizon') {
                        // Horizon Ribbon Upper Floor: Full-width continuous ribbon window & deep balcony
                        const ribbonW = fW * 0.86;
                        const ribbonH = 1.35;
                        const ribbonY = floorY + floorHeight * 0.54;

                        // Continuous Panoramic Ribbon Window
                        const rGlass = new THREE.Mesh(new THREE.BoxGeometry(ribbonW, ribbonH, 0.05), glassMaterial);
                        rGlass.position.set(fX, ribbonY, frontZ + 0.02);
                        houseGroup.add(rGlass);

                        // Upper & Lower Horizontal Architectural Concrete Eyebrows / Sunshade Ledges
                        [-ribbonH / 2 - 0.06, ribbonH / 2 + 0.06].forEach(ly => {
                            const ledge = new THREE.Mesh(new THREE.BoxGeometry(ribbonW + 0.4, 0.12, 0.24), stoneTrimMaterial);
                            ledge.position.set(fX, ribbonY + ly, frontZ + 0.12);
                            ledge.castShadow = true; houseGroup.add(ledge);
                        });

                        // Slim Vertical Mullions along ribbon
                        [-ribbonW * 0.35, -ribbonW * 0.12, ribbonW * 0.12, ribbonW * 0.35].forEach(mx => {
                            const mul = new THREE.Mesh(new THREE.BoxGeometry(0.04, ribbonH, 0.07), darkMetalMaterial);
                            mul.position.set(fX + mx, ribbonY, frontZ + 0.03);
                            houseGroup.add(mul);
                        });

                        // Full-Width Cantilevered Balcony Slab
                        const balcW = ribbonW + 0.2;
                        const balcD = 1.4;
                        const balcY = floorY + 0.12;

                        const bSlabMesh = new THREE.Mesh(new THREE.BoxGeometry(balcW, 0.18, balcD), stoneTrimMaterial);
                        bSlabMesh.position.set(fX, balcY, frontZ + balcD / 2);
                        bSlabMesh.castShadow = true; houseGroup.add(bSlabMesh);

                        // Full-Width Crystal Glass Balustrade
                        const railH = 0.94;
                        const gBalc = new THREE.Mesh(new THREE.BoxGeometry(balcW - 0.06, railH - 0.08, 0.02), modernBalustradeGlass);
                        gBalc.position.set(fX, balcY + 0.09 + (railH - 0.08) / 2 + 0.04, frontZ + balcD - 0.03);
                        houseGroup.add(gBalc);

                        const tCap = new THREE.Mesh(new THREE.BoxGeometry(balcW, 0.035, 0.04), darkMetalMaterial);
                        tCap.position.set(fX, balcY + 0.09 + railH, frontZ + balcD - 0.03);
                        houseGroup.add(tCap);
                    }

                } else {
                    // CLASSIC / APARTMENT UPPER BALCONY
                    const balcW = baseWidth * 0.48;
                    const balcD = 1.3;
                    const balcY = floorY + 0.12;

                    const bSlabMesh = new THREE.Mesh(new THREE.BoxGeometry(balcW, 0.20, balcD), stoneTrimMaterial);
                    bSlabMesh.position.set(fX, balcY, frontZ + balcD / 2);
                    bSlabMesh.castShadow = true; houseGroup.add(bSlabMesh);

                    const fDoorW = balcW * 0.70;
                    const fDoorH = 2.15;
                    const fDoorY = floorY + fDoorH / 2 + 0.05;

                    const fBacking = new THREE.Mesh(new THREE.PlaneGeometry(fDoorW, fDoorH), new THREE.MeshBasicMaterial({ color: 0x1a1612 }));
                    fBacking.position.set(fX, fDoorY, frontZ + 0.015);
                    houseGroup.add(fBacking);

                    const fDoor = new THREE.Mesh(new THREE.PlaneGeometry(fDoorW - 0.06, fDoorH - 0.06), glassMaterial);
                    fDoor.position.set(fX, fDoorY, frontZ + 0.035);
                    houseGroup.add(fDoor);

                    [-fDoorW / 2 + 0.03, 0, fDoorW / 2 - 0.03].forEach(fx => {
                        const fStile = new THREE.Mesh(new THREE.BoxGeometry(0.05, fDoorH, 0.05), darkMetalMaterial);
                        fStile.position.set(fX + fx, fDoorY, frontZ + 0.038);
                        houseGroup.add(fStile);
                    });

                    // Wrought Iron Spindles & Handrail
                    const railH = 0.92;
                    const topRail = new THREE.Mesh(new THREE.BoxGeometry(balcW, 0.06, 0.06), darkMetalMaterial);
                    topRail.position.set(fX, balcY + railH, frontZ + balcD - 0.03);
                    topRail.castShadow = true; houseGroup.add(topRail);

                    [-balcW / 2 + 0.03, balcW / 2 - 0.03].forEach(sideX => {
                        const sideRail = new THREE.Mesh(new THREE.BoxGeometry(0.06, 0.06, balcD), darkMetalMaterial);
                        sideRail.position.set(fX + sideX, balcY + railH, frontZ + balcD / 2);
                        houseGroup.add(sideRail);
                    });

                    const numSpindles = Math.floor(balcW / 0.16);
                    for (let s = 0; s <= numSpindles; s++) {
                        const spX = -balcW / 2 + (s * (balcW / numSpindles));
                        const spMesh = new THREE.Mesh(new THREE.CylinderGeometry(0.012, 0.012, railH - 0.06, 8), darkMetalMaterial);
                        spMesh.position.set(fX + spX, balcY + railH / 2, frontZ + balcD - 0.03);
                        spMesh.castShadow = true; houseGroup.add(spMesh);
                    }

                    // Flanking Windows
                    [-baseWidth * 0.32, baseWidth * 0.32].forEach(wx => {
                        buildDetailedWindow(houseGroup, fX + wx, floorY + floorHeight * 0.55, frontZ, 1.3, 1.4, 'front', stoneTrimMaterial, glassMaterial, darkMetalMaterial, isClassic, false);
                    });
                }
            }

            // ─────────────────────────────────────────────────────────
            // SIDE FACADES: RECESSED WINDOWS
            // ─────────────────────────────────────────────────────────
            [-fD * 0.22, fD * 0.22].forEach(sideZ => {
                buildDetailedWindow(houseGroup, fX + fW / 2, floorY + floorHeight * 0.55, fZ + sideZ, 1.15, 1.35, 'side-right', stoneTrimMaterial, glassMaterial, darkMetalMaterial, isClassic, isModern);
                buildDetailedWindow(houseGroup, fX - fW / 2, floorY + floorHeight * 0.55, fZ + sideZ, 1.15, 1.35, 'side-left', stoneTrimMaterial, glassMaterial, darkMetalMaterial, isClassic, isModern);
            });
        }

        // ─────────────────────────────────────────────────────────────
        // 3. ROOF PARAPET & ARCHITECTURAL FEATURES
        // ─────────────────────────────────────────────────────────────
        const topY = floors * floorHeight;

        if (isModern) {
            if (currentModernConcept === 'cubic') {
                // Staggered Asymmetrical Cubic Parapets (Dabouq aesthetic)
                const halfW = baseWidth * 0.50;
                const leftParapetH = 0.75;  // High tower parapet
                const rightParapetH = 0.40; // Low terrace parapet

                // Left Tower Parapet
                const lPara = new THREE.Mesh(new THREE.BoxGeometry(halfW + 0.06, leftParapetH, baseDepth + 0.08), getStoneWallMaterial(halfW, leftParapetH));
                lPara.position.set(-halfW / 2, topY + leftParapetH / 2, 0);
                lPara.castShadow = true; houseGroup.add(lPara);

                // Right Low Parapet
                const rPara = new THREE.Mesh(new THREE.BoxGeometry(halfW + 0.06, rightParapetH, baseDepth + 0.08), getStoneWallMaterial(halfW, rightParapetH));
                rPara.position.set(halfW / 2, topY + rightParapetH / 2, 0);
                rPara.castShadow = true; houseGroup.add(rPara);

                // Dark Coping Plates
                const lCop = new THREE.Mesh(new THREE.BoxGeometry(halfW + 0.12, 0.06, baseDepth + 0.14), darkMetalMaterial);
                lCop.position.set(-halfW / 2, topY + leftParapetH + 0.03, 0);
                houseGroup.add(lCop);

                const rCop = new THREE.Mesh(new THREE.BoxGeometry(halfW + 0.12, 0.06, baseDepth + 0.14), darkMetalMaterial);
                rCop.position.set(halfW / 2, topY + rightParapetH + 0.03, 0);
                houseGroup.add(rCop);

                // Stepped Cubic Stair Penthouse
                if (floors > 1) {
                    const stairW = 2.6; const stairH = 2.0; const stairD = 2.8;
                    const stMesh = new THREE.Mesh(new THREE.BoxGeometry(stairW, stairH, stairD), getStoneWallMaterial(stairW, stairH));
                    stMesh.position.set(-baseWidth * 0.22, topY + stairH / 2, -baseDepth * 0.16);
                    stMesh.castShadow = true; houseGroup.add(stMesh);

                    const stRoof = new THREE.Mesh(new THREE.BoxGeometry(stairW + 0.3, 0.10, stairD + 0.3), darkMetalMaterial);
                    stRoof.position.set(-baseWidth * 0.22, topY + stairH + 0.05, -baseDepth * 0.16);
                    houseGroup.add(stRoof);
                }

            } else if (currentModernConcept === 'horizon') {
                // Horizon Ribbon Roof: Deep cantilever overhang slab + Full-width Pergola
                const overhang = 0.60;
                const roofSlab = new THREE.Mesh(new THREE.BoxGeometry(baseWidth + overhang * 2, 0.22, baseDepth + overhang * 2), darkMetalMaterial);
                roofSlab.position.set(0, topY + 0.11, 0);
                roofSlab.castShadow = true; houseGroup.add(roofSlab);

                // Full-Width Architectural Pergola across rooftop living deck
                const pergW = baseWidth * 0.65;
                const pergD = baseDepth * 0.55;
                const pergH = 2.1;
                const pergZ = -baseDepth * 0.05;

                // Steel Posts
                [-pergW / 2, pergW / 2].forEach(px => {
                    [-pergD / 2, pergD / 2].forEach(pz => {
                        const post = new THREE.Mesh(new THREE.BoxGeometry(0.09, pergH, 0.09), darkMetalMaterial);
                        post.position.set(px, topY + 0.22 + pergH / 2, pergZ + pz);
                        post.castShadow = true; houseGroup.add(post);
                    });
                });

                // Longitudinal Support Beams
                [-pergW / 2, pergW / 2].forEach(px => {
                    const beam = new THREE.Mesh(new THREE.BoxGeometry(0.09, 0.14, pergD + 0.4), darkMetalMaterial);
                    beam.position.set(px, topY + 0.22 + pergH, pergZ);
                    houseGroup.add(beam);
                });

                // Angled Teak Sun-Shade Louvers
                const numSlats = 10;
                for (let sl = 0; sl < numSlats; sl++) {
                    const slatZ = pergZ - pergD / 2 + (sl * (pergD / (numSlats - 1)));
                    const slat = new THREE.Mesh(new THREE.BoxGeometry(pergW + 0.3, 0.05, 0.10), teakLouverMaterial);
                    slat.rotation.x = 0.35; // 20 degree tilt for realistic sun shading!
                    slat.position.set(0, topY + 0.22 + pergH + 0.06, slatZ);
                    slat.castShadow = true; houseGroup.add(slat);
                }

            } else {
                // Cantilever Portal Roof: Floating Fascia Slab + Concealed LED Strip
                const overhang = 0.45;
                const roofSlabMesh = new THREE.Mesh(new THREE.BoxGeometry(baseWidth + overhang * 2, 0.22, baseDepth + overhang * 2), darkMetalMaterial);
                roofSlabMesh.position.set(0, topY + 0.11, 0);
                roofSlabMesh.castShadow = true; houseGroup.add(roofSlabMesh);

                // Underside perimeter LED light strip
                const ledStrip = new THREE.Mesh(new THREE.BoxGeometry(baseWidth + overhang * 1.8, 0.03, baseDepth + overhang * 1.8), new THREE.MeshBasicMaterial({ color: 0xfff3db }));
                ledStrip.position.set(0, topY - 0.02, 0);
                houseGroup.add(ledStrip);

                // Low-profile modern parapet
                const parapetH = 0.42;
                const parapetMesh = new THREE.Mesh(new THREE.BoxGeometry(baseWidth + 0.08, parapetH, baseDepth + 0.08), getStoneWallMaterial(baseWidth, parapetH));
                parapetMesh.position.set(0, topY + 0.22 + parapetH / 2, 0);
                parapetMesh.castShadow = true; houseGroup.add(parapetMesh);

                if (floors > 1) {
                    const stairW = 2.8; const stairH = 2.1; const stairD = 2.8;
                    const stairMesh = new THREE.Mesh(new THREE.BoxGeometry(stairW, stairH, stairD), getStoneWallMaterial(stairW, stairH));
                    stairMesh.position.set(-baseWidth * 0.2, topY + 0.22 + stairH / 2, -baseDepth * 0.15);
                    stairMesh.castShadow = true; houseGroup.add(stairMesh);

                    const stRoof = new THREE.Mesh(new THREE.BoxGeometry(stairW + 0.4, 0.12, stairD + 0.4), darkMetalMaterial);
                    stRoof.position.set(-baseWidth * 0.2, topY + 0.22 + stairH + 0.06, -baseDepth * 0.15);
                    houseGroup.add(stRoof);
                } else {
                    // Rooftop pergola for 1-floor modern villa
                    const pergW = baseWidth * 0.38; const pergD = baseDepth * 0.35; const pergH = 1.8;
                    const pergX = -baseWidth * 0.18; const pergZ = -baseDepth * 0.12;

                    [-pergW / 2, pergW / 2].forEach(px => {
                        [-pergD / 2, pergD / 2].forEach(pz => {
                            const post = new THREE.Mesh(new THREE.BoxGeometry(0.08, pergH, 0.08), darkMetalMaterial);
                            post.position.set(pergX + px, topY + 0.22 + pergH / 2, pergZ + pz);
                            houseGroup.add(post);
                        });
                    });

                    for (let sl = 0; sl < 6; sl++) {
                        const slatZ = pergZ - pergD / 2 + (sl * (pergD / 5));
                        const slat = new THREE.Mesh(new THREE.BoxGeometry(pergW + 0.2, 0.06, 0.08), teakLouverMaterial);
                        slat.position.set(pergX, topY + 0.22 + pergH, slatZ);
                        slat.castShadow = true; houseGroup.add(slat);
                    }
                }
            }

        } else {
            // CLASSIC / APARTMENT ROOF
            const parapetH = 0.75;
            const parapetMesh = new THREE.Mesh(new THREE.BoxGeometry(baseWidth + 0.12, parapetH, baseDepth + 0.12), getStoneWallMaterial(baseWidth, parapetH));
            parapetMesh.position.set(0, topY + parapetH / 2, 0);
            parapetMesh.castShadow = true; houseGroup.add(parapetMesh);

            const copingMesh = new THREE.Mesh(new THREE.BoxGeometry(baseWidth + 0.36, 0.12, baseDepth + 0.36), stoneTrimMaterial);
            copingMesh.position.set(0, topY + parapetH + 0.06, 0);
            copingMesh.castShadow = true; houseGroup.add(copingMesh);

            if (floors > 1 || isApartment) {
                const stairW = 3.2; const stairH = 2.3; const stairD = 3.4;
                const stairMesh = new THREE.Mesh(new THREE.BoxGeometry(stairW, stairH, stairD), getStoneWallMaterial(stairW, stairH));
                stairMesh.position.set(-baseWidth * 0.18, topY + stairH / 2, -baseDepth * 0.1);
                stairMesh.castShadow = true; houseGroup.add(stairMesh);

                const stCoping = new THREE.Mesh(new THREE.BoxGeometry(stairW + 0.25, 0.1, stairD + 0.25), stoneTrimMaterial);
                stCoping.position.set(-baseWidth * 0.18, topY + stairH + 0.05, -baseDepth * 0.1);
                houseGroup.add(stCoping);
            }
        }

        // ─────────────────────────────────────────────────────────────
        // 4. CLASSICAL ENTRANCE COLUMNS & PORTICO (أعمدة وتيجان حجرية)
        // ─────────────────────────────────────────────────────────────
        if (entranceCols > 0 && isClassic) {
            const colH = floorHeight * 0.95;
            const colZ = baseDepth / 2 + 1.15;

            [-1.35, 1.35].forEach(cx => {
                const bMesh = new THREE.Mesh(new THREE.BoxGeometry(0.52, 0.20, 0.52), stoneTrimMaterial);
                bMesh.position.set(cx, 0.20, colZ);
                houseGroup.add(bMesh);

                const sMesh = new THREE.Mesh(new THREE.CylinderGeometry(0.16, 0.19, colH - 0.40, 24), stoneTrimMaterial);
                sMesh.position.set(cx, 0.20 + (colH - 0.40) / 2 + 0.1, colZ);
                sMesh.castShadow = true; houseGroup.add(sMesh);

                const cMesh = new THREE.Mesh(new THREE.BoxGeometry(0.48, 0.18, 0.48), stoneTrimMaterial);
                cMesh.position.set(cx, 0.20 + colH - 0.18, colZ);
                cMesh.castShadow = true; houseGroup.add(cMesh);
            });

            const canMesh = new THREE.Mesh(new THREE.BoxGeometry(3.6, 0.22, 1.5), stoneTrimMaterial);
            canMesh.position.set(0, floorHeight - 0.11, colZ);
            canMesh.castShadow = true; houseGroup.add(canMesh);
        }

        // 5. CIVIL ENGINEERING STRUCTURAL SKELETON (الهيكل العظم الإنشائي)
        // ─────────────────────────────────────────────────────────────
        buildStructuralSkeleton(skeletonGroup, floors, floorHeight, baseWidth, baseDepth, columnBars);

        skeletonGroup.visible = isXRayMode;

        threeScene.add(houseGroup);
        threeScene.add(skeletonGroup);

        // Dynamic camera auto-framing on floor height change
        if (typeof window.previousFloorsCount !== 'undefined' && window.previousFloorsCount !== floors) {
            window.previousFloorsCount = floors;
            if (typeof currentCameraPreset !== 'undefined' && currentCameraPreset !== 'interior' && !isDroneOrbiting) {
                setCameraPreset(currentCameraPreset, false);
            }
        } else if (typeof window.previousFloorsCount === 'undefined') {
            window.previousFloorsCount = floors;
        }
    }

    // ────────────────────────────────────────────────────────────────
    // CIVIL ENGINEERING STRUCTURAL SKELETON (عظم إنشائي مدني حقيقي)
    // ────────────────────────────────────────────────────────────────
    function buildStructuralSkeleton(group, floors, floorHeight, baseWidth, baseDepth, columnBars) {
        const colTotalH = floors * floorHeight;
        const rebarBarMat = new THREE.MeshStandardMaterial({ color: 0xdc2626, metalness: 0.85, roughness: 0.25 }); // High-tensile steel
        const stirrupMat = new THREE.MeshStandardMaterial({ color: 0xf59e0b, metalness: 0.7, roughness: 0.3 }); // Amber stirrup wire
        const concreteTransMat = new THREE.MeshStandardMaterial({ color: 0x475569, roughness: 0.8, transparent: true, opacity: 0.26 }); // Cast concrete
        const tieBeamMat = new THREE.MeshStandardMaterial({ color: 0x334155, roughness: 0.85 }); // Ground concrete beam
        const joistMat = new THREE.MeshStandardMaterial({ color: 0x64748b, roughness: 0.7 }); // Ribbed slab joist

        const colPositions = [
            [-baseWidth * 0.42, -baseDepth * 0.42],
            [baseWidth * 0.42, -baseDepth * 0.42],
            [-baseWidth * 0.42, baseDepth * 0.42],
            [baseWidth * 0.42, baseDepth * 0.42],
            [0, -baseDepth * 0.42],
            [0, baseDepth * 0.42]
        ];

        // 1. ISOLATED FOOTINGS WITH LOWER REBAR MESH (قواعد مسلحة مع فرش وغطاء)
        colPositions.forEach(pos => {
            const footW = 1.35;
            const footH = 0.42;
            const footGeo = new THREE.BoxGeometry(footW, footH, footW);
            const footMesh = new THREE.Mesh(footGeo, concreteTransMat);
            footMesh.position.set(pos[0], footH / 2, pos[1]);
            group.add(footMesh);

            // Footing Lower Rebar Mesh (فرش وغطاء من قضبان الحديد)
            for (let m = -0.5; m <= 0.5; m += 0.25) {
                // X direction bars
                const barX = new THREE.Mesh(new THREE.CylinderGeometry(0.008, 0.008, 1.1, 6), rebarBarMat);
                barX.rotation.z = Math.PI / 2;
                barX.position.set(pos[0], 0.08, pos[1] + m);
                group.add(barX);

                // Z direction bars
                const barZ = new THREE.Mesh(new THREE.CylinderGeometry(0.008, 0.008, 1.1, 6), rebarBarMat);
                barZ.rotation.x = Math.PI / 2;
                barZ.position.set(pos[0] + m, 0.11, pos[1]);
                group.add(barZ);
            }

            // Column Neck (رقبة العامود)
            const neckGeo = new THREE.BoxGeometry(0.36, 0.45, 0.36);
            const neckMesh = new THREE.Mesh(neckGeo, concreteTransMat);
            neckMesh.position.set(pos[0], footH + 0.22, pos[1]);
            group.add(neckMesh);
        });

        // 2. GROUND TIE BEAMS / SHANNAJAT (الميد والشناجات الأرضية)
        const tieH = 0.38;
        const tieW = 0.30;
        const tieY = 0.42 + tieH / 2;

        // X-direction tie beams (front, center, back)
        [-baseDepth * 0.42, 0, baseDepth * 0.42].forEach(tz => {
            const beamGeo = new THREE.BoxGeometry(baseWidth * 0.84, tieH, tieW);
            const beamMesh = new THREE.Mesh(beamGeo, tieBeamMat);
            beamMesh.position.set(0, tieY, tz);
            group.add(beamMesh);
        });

        // Z-direction tie beams (left, center, right)
        [-baseWidth * 0.42, 0, baseWidth * 0.42].forEach(tx => {
            const beamGeo = new THREE.BoxGeometry(tieW, tieH, baseDepth * 0.84);
            const beamMesh = new THREE.Mesh(beamGeo, tieBeamMat);
            beamMesh.position.set(tx, tieY, 0);
            group.add(beamMesh);
        });

        // 3. REINFORCED COLUMNS WITH LONGITUDINAL BARS & STIRRUPS (أعمدة، كانات، وأشاير)
        colPositions.forEach(pos => {
            // Concrete column core (semi-transparent)
            const cGeo = new THREE.BoxGeometry(0.38, colTotalH, 0.38);
            const cMesh = new THREE.Mesh(cGeo, concreteTransMat);
            cMesh.position.set(pos[0], colTotalH / 2, pos[1]);
            group.add(cMesh);

            // Longitudinal Rebar (6, 8, or 10 bars)
            const barCount = columnBars === "8Bars" ? 8 : (columnBars === "10Bars" ? 10 : 6);
            for (let b = 0; b < barCount; b++) {
                const angle = (b / barCount) * Math.PI * 2;
                const r = 0.13;
                const bx = pos[0] + Math.cos(angle) * r;
                const bz = pos[1] + Math.sin(angle) * r;

                // Main bar extending through floors
                const barGeo = new THREE.CylinderGeometry(0.014, 0.014, colTotalH + 0.45, 8);
                const barMesh = new THREE.Mesh(barGeo, rebarBarMat);
                barMesh.position.set(bx, (colTotalH + 0.45) / 2, bz);
                group.add(barMesh);

                // Upper Dowel / Starter Bar Hook (أشاير السطح المعقوفة)
                const hookGeo = new THREE.CylinderGeometry(0.012, 0.012, 0.22, 8);
                const hookMesh = new THREE.Mesh(hookGeo, rebarBarMat);
                hookMesh.rotation.z = Math.PI / 3;
                hookMesh.position.set(bx + 0.08, colTotalH + 0.45, bz);
                group.add(hookMesh);
            }

            // Column Stirrups (كانات مربعة متكررة ومكثفة زلزالياً)
            const numStirrups = Math.floor(colTotalH / 0.18);
            for (let s = 1; s <= numStirrups; s++) {
                const sy = s * 0.18;
                // Stirrup square outline
                const stirrupGeo = new THREE.BoxGeometry(0.32, 0.012, 0.32);
                const stirrupMesh = new THREE.Mesh(stirrupGeo, stirrupMat);
                stirrupMesh.position.set(pos[0], sy, pos[1]);
                group.add(stirrupMesh);
            }
        });

        // 4. DROP BEAMS & RIBBED SLAB JOISTS (جسور ساقطة وسقف هوردي وأعصاب)
        for (let f = 1; f <= floors; f++) {
            const slabY = f * floorHeight;

            // Perimeter Drop Beams (الجسور الساقطة الحاملة)
            const beamD = 0.42;
            const beamW = 0.32;
            [-baseDepth * 0.42, baseDepth * 0.42].forEach(bz => {
                const bGeo = new THREE.BoxGeometry(baseWidth * 0.88, beamD, beamW);
                const bMesh = new THREE.Mesh(bGeo, tieBeamMat);
                bMesh.position.set(0, slabY - beamD / 2, bz);
                group.add(bMesh);
            });

            [-baseWidth * 0.42, baseWidth * 0.42].forEach(bx => {
                const bGeo = new THREE.BoxGeometry(beamW, beamD, baseDepth * 0.88);
                const bMesh = new THREE.Mesh(bGeo, tieBeamMat);
                bMesh.position.set(bx, slabY - beamD / 2, 0);
                group.add(bMesh);
            });

            // Ribbed Joists Grid (أعصاب العقدة الهوردي متكررة كل 50 سم)
            const bayW = baseWidth * 0.82;
            const numJoists = Math.floor(bayW / 0.52);
            for (let j = 0; j <= numJoists; j++) {
                const jx = -bayW / 2 + (j * 0.52);
                const jGeo = new THREE.BoxGeometry(0.14, 0.24, baseDepth * 0.82);
                const jMesh = new THREE.Mesh(jGeo, joistMat);
                jMesh.position.set(jx, slabY - 0.12, 0);
                group.add(jMesh);
            }
        }
    }

    // ────────────────────────────────────────────────────────────────
    // DETAILED WINDOW HELPER (CLEAN ARCHITECTURE - ZERO HORNS/PROTRUSIONS)
    // ────────────────────────────────────────────────────────────────
    // ────────────────────────────────────────────────────────────────
    // DETAILED ARCHITECTURAL WINDOW HELPER
    // True hollow casing, projecting molded sill, slim aluminum sash & mullions,
    // crystal clear reflective glass, and recessed illuminated interior depth!
    // ────────────────────────────────────────────────────────────────
    // ────────────────────────────────────────────────────────────────
    // LUXURY MODERN ARCHITECTURAL ENTRANCE DOOR BUILDER
    // Warm natural walnut/oak wood, 3D vertical slatted flutes, frosted vision strip,
    // brushed brass long bar handle, smart digital lock, and dedicated warm spotlight!
    // ────────────────────────────────────────────────────────────────
    function buildModernLuxuryDoor(group, doorX, doorY, frontZ, doorW, doorH, handleSide, darkMetalMat, stoneTrimMat) {
        const dGroup = new THREE.Group();
        dGroup.position.set(doorX, doorY, frontZ);

        // 1. Charcoal Architectural Outer Frame Casing (حلق الباب الألمنيوم الغامق المحيط)
        const frameW = 0.06;
        const frameD = 0.10;
        const fTop = new THREE.Mesh(new THREE.BoxGeometry(doorW + frameW * 2, frameW, frameD), darkMetalMat);
        fTop.position.set(0, doorH / 2 + frameW / 2, 0.03);
        dGroup.add(fTop);

        [-doorW / 2 - frameW / 2, doorW / 2 + frameW / 2].forEach(jx => {
            const fJamb = new THREE.Mesh(new THREE.BoxGeometry(frameW, doorH, frameD), darkMetalMat);
            fJamb.position.set(jx, 0, 0.03);
            dGroup.add(fJamb);
        });

        // 2. Door Leaf Base in Rich Warm Honey Walnut / Natural Oak
        const leafThick = 0.07;
        const modernWoodDoorMat = new THREE.MeshStandardMaterial({ color: 0x9a5b28, roughness: 0.35, metalness: 0.05 });
        const modernDoorGrooveMat = new THREE.MeshStandardMaterial({ color: 0x3d1a08, roughness: 0.6 });
        const brassHandleMat = new THREE.MeshStandardMaterial({ color: 0xf59e0b, metalness: 0.92, roughness: 0.18 });

        const leafMesh = new THREE.Mesh(new THREE.BoxGeometry(doorW, doorH, leafThick), modernWoodDoorMat);
        leafMesh.position.set(0, 0, 0.035);
        leafMesh.castShadow = true;
        dGroup.add(leafMesh);

        // 3. Architectural 3D Vertical Slatted Fluting / Grooves (تفريزات خشبية طولية بارزة وغائرة)
        const numFlutes = 7;
        const fluteAreaW = doorW * 0.68;
        const fluteW = fluteAreaW / numFlutes;
        const fluteStartX = -doorW / 2 + fluteW / 2 + 0.06;
        for (let fl = 0; fl < numFlutes; fl++) {
            const fx = fluteStartX + fl * fluteW;
            const flute = new THREE.Mesh(new THREE.BoxGeometry(fluteW * 0.76, doorH - 0.08, 0.015), modernWoodDoorMat);
            flute.position.set(fx, 0, 0.035 + leafThick / 2 + 0.008);
            flute.castShadow = true;
            dGroup.add(flute);

            const groove = new THREE.Mesh(new THREE.BoxGeometry(fluteW * 0.24, doorH - 0.08, 0.01), modernDoorGrooveMat);
            groove.position.set(fx + fluteW / 2, 0, 0.035 + leafThick / 2 + 0.005);
            dGroup.add(groove);
        }

        // 4. Vertical Architectural Frosted Glass Vision Strip (شريحة زجاجية طولية مع إضاءة دافئة)
        const stripW = 0.16;
        const stripX = (handleSide === 'left') ? doorW / 2 - stripW / 2 - 0.08 : -doorW / 2 + stripW / 2 + 0.08;
        const vStrip = new THREE.Mesh(new THREE.BoxGeometry(stripW, doorH * 0.88, 0.03), new THREE.MeshPhysicalMaterial({ color: 0xffffff, transmission: 0.85, opacity: 1.0, transparent: true, roughness: 0.1, ior: 1.52, depthWrite: false }));
        vStrip.position.set(stripX, 0, 0.035 + leafThick / 2 + 0.01);
        dGroup.add(vStrip);

        const glowStrip = new THREE.Mesh(new THREE.PlaneGeometry(stripW - 0.02, doorH * 0.86), new THREE.MeshBasicMaterial({ color: 0xffedd5 }));
        glowStrip.position.set(stripX, 0, 0.035 + leafThick / 2 + 0.002);
        dGroup.add(glowStrip);

        // 5. Long Architectural Brushed Brass / Gold Pull Bar Handle (مقبض نحاسي ذهبي فاخر طول 1.6م)
        const handleX = (handleSide === 'left') ? -doorW * 0.36 : doorW * 0.36;
        const handleH = 1.6;
        const hBar = new THREE.Mesh(new THREE.CylinderGeometry(0.018, 0.018, handleH, 16), brassHandleMat);
        hBar.position.set(handleX, 0, 0.035 + leafThick / 2 + 0.06);
        hBar.castShadow = true;
        dGroup.add(hBar);

        [-handleH * 0.38, handleH * 0.38].forEach(by => {
            const bracket = new THREE.Mesh(new THREE.CylinderGeometry(0.014, 0.014, 0.05, 12), darkMetalMat);
            bracket.rotation.x = Math.PI / 2;
            bracket.position.set(handleX, by, 0.035 + leafThick / 2 + 0.03);
            dGroup.add(bracket);
        });

        // 6. Modern Digital Keyless Lock Escutcheon Plate (قفل ذكي إلكتروني مع مؤشر ليد)
        const escW = 0.06;
        const escH = 0.28;
        const escMesh = new THREE.Mesh(new THREE.BoxGeometry(escW, escH, 0.02), darkMetalMat);
        escMesh.position.set(handleX + (handleSide === 'left' ? 0.07 : -0.07), -0.05, 0.035 + leafThick / 2 + 0.015);
        dGroup.add(escMesh);

        const dotGeo = new THREE.CylinderGeometry(0.005, 0.005, 0.005, 8);
        const dotMesh = new THREE.Mesh(dotGeo, new THREE.MeshBasicMaterial({ color: 0x22c55e }));
        dotMesh.rotation.x = Math.PI / 2;
        dotMesh.position.set(handleX + (handleSide === 'left' ? 0.07 : -0.07), 0.05, 0.035 + leafThick / 2 + 0.026);
        dGroup.add(dotMesh);

        // 7. Stone / Marble Entrance Threshold Step (عتبة رخامية سفلية)
        const thresh = new THREE.Mesh(new THREE.BoxGeometry(doorW + 0.15, 0.08, 0.25), stoneTrimMat);
        thresh.position.set(0, -doorH / 2 - 0.04, 0.08);
        thresh.receiveShadow = true;
        dGroup.add(thresh);

        // 8. Warm Architectural Entrance Downlight Spot (إضاءة مخصصة للمدخل تظهر تفاصيل الخشب والمقبض بوضوح فائق)
        const spotLight = new THREE.PointLight(0xfff1d6, 2.0, 4.8);
        spotLight.position.set(0, doorH / 2 + 0.22, 0.45);
        dGroup.add(spotLight);

        // Downlight recessed lens fixture
        const lensMesh = new THREE.Mesh(new THREE.CylinderGeometry(0.04, 0.04, 0.02, 12), new THREE.MeshBasicMaterial({ color: 0xfffaed }));
        lensMesh.position.set(0, doorH / 2 + 0.15, 0.45);
        dGroup.add(lensMesh);

        group.add(dGroup);
    }

    function buildDetailedWindow(group, posX, posY, posZ, width, height, orientation, trimMat, glassMat, metalMat, isClassic, isModern) {
        const winGroup = new THREE.Group();
        winGroup.position.set(posX, posY, posZ);

        if (orientation === 'side-right') {
            winGroup.rotation.y = -Math.PI / 2;
        } else if (orientation === 'side-left') {
            winGroup.rotation.y = Math.PI / 2;
        } else if (orientation === 'back') {
            winGroup.rotation.y = Math.PI;
        }

        // 1. Recessed Interior Opening Reveal & Warm Ambient Illumination
        // Placed at Z = 0.005 (just in front of wall) so it creates genuine room depth
        const revealCavityMat = new THREE.MeshBasicMaterial({ color: 0x1a1612 });
        const cavityMesh = new THREE.Mesh(new THREE.PlaneGeometry(width - 0.04, height - 0.04), revealCavityMat);
        cavityMesh.position.set(0, 0, 0.005);
        winGroup.add(cavityMesh);

        // Soft warm interior glow panel inside the window reveal
        const glowCanvas = document.createElement('canvas');
        glowCanvas.width = 128; glowCanvas.height = 128;
        const gctx = glowCanvas.getContext('2d');
        const gRad = gctx.createRadialGradient(64, 75, 6, 64, 75, 60);
        gRad.addColorStop(0, 'rgba(255, 230, 185, 0.85)');
        gRad.addColorStop(0.5, 'rgba(220, 180, 120, 0.45)');
        gRad.addColorStop(1, 'rgba(26, 22, 18, 0.0)');
        gctx.fillStyle = gRad;
        gctx.fillRect(0, 0, 128, 128);
        const glowTex = new THREE.CanvasTexture(glowCanvas);
        const glowMat = new THREE.MeshBasicMaterial({ map: glowTex, transparent: true, opacity: 0.85, depthWrite: false });
        const glowPlane = new THREE.Mesh(new THREE.PlaneGeometry(width - 0.06, height - 0.06), glowMat);
        glowPlane.position.set(0, 0, 0.012);
        winGroup.add(glowPlane);

        // 2. Crystal Clear Architectural Glass Pane (Reflective, semi-transparent, depthWrite: false)
        const winGlass = new THREE.Mesh(new THREE.PlaneGeometry(width - 0.06, height - 0.06), glassMat);
        winGlass.position.set(0, 0, 0.024);
        winGroup.add(winGlass);

        // 3. Charcoal Architectural Aluminum Sash & Mullions (إطار الألمنيوم المعماري الفاخر والقواطع)
        const sashThick = 0.038;
        const sashDepth = 0.025;
        const sashZ = 0.026;

        // Outer Sash Perimeter (Top, Bottom, Left, Right)
        const sLeft = new THREE.Mesh(new THREE.BoxGeometry(sashThick, height, sashDepth), metalMat);
        sLeft.position.set(-width / 2 + sashThick / 2, 0, sashZ);
        winGroup.add(sLeft);

        const sRight = new THREE.Mesh(new THREE.BoxGeometry(sashThick, height, sashDepth), metalMat);
        sRight.position.set(width / 2 - sashThick / 2, 0, sashZ);
        winGroup.add(sRight);

        const sTop = new THREE.Mesh(new THREE.BoxGeometry(width - sashThick * 2, sashThick, sashDepth), metalMat);
        sTop.position.set(0, height / 2 - sashThick / 2, sashZ);
        winGroup.add(sTop);

        const sBottom = new THREE.Mesh(new THREE.BoxGeometry(width - sashThick * 2, sashThick, sashDepth), metalMat);
        sBottom.position.set(0, -height / 2 + sashThick / 2, sashZ);
        winGroup.add(sBottom);

        // Vertical Center Mullion Bar
        const mullion = new THREE.Mesh(new THREE.BoxGeometry(0.032, height - sashThick * 2, sashDepth), metalMat);
        mullion.position.set(0, 0, sashZ);
        winGroup.add(mullion);

        // Horizontal Transom Bar (at upper 60% height)
        const transom = new THREE.Mesh(new THREE.BoxGeometry(width - sashThick * 2, 0.028, sashDepth), metalMat);
        transom.position.set(0, height * 0.12, sashZ);
        winGroup.add(transom);

        // 4. Hollow Architectural Stone Architrave Frame (برواز الحجر المفرغ المحيط بالشباك - مفتوح كلياً في الوسط)
        const frameCasingW = isModern ? 0.08 : 0.13;
        const frameProj = isModern ? 0.04 : 0.07;
        const frameZ = frameProj / 2 + 0.005;

        // Left Jamb
        const jambL = new THREE.Mesh(new THREE.BoxGeometry(frameCasingW, height + frameCasingW, frameProj), isModern ? metalMat : trimMat);
        jambL.position.set(-width / 2 - frameCasingW / 2, frameCasingW / 2, frameZ);
        jambL.castShadow = true;
        winGroup.add(jambL);

        // Right Jamb
        const jambR = new THREE.Mesh(new THREE.BoxGeometry(frameCasingW, height + frameCasingW, frameProj), isModern ? metalMat : trimMat);
        jambR.position.set(width / 2 + frameCasingW / 2, frameCasingW / 2, frameZ);
        jambR.castShadow = true;
        winGroup.add(jambR);

        // Top Head / Architrave Lintel
        const headW = width + frameCasingW * 2;
        const headMesh = new THREE.Mesh(new THREE.BoxGeometry(headW, frameCasingW, frameProj), isModern ? metalMat : trimMat);
        headMesh.position.set(0, height / 2 + frameCasingW / 2, frameZ);
        headMesh.castShadow = true;
        winGroup.add(headMesh);

        // 5. Projecting Molded Stone Sill (جلسة شباك حجرية بارزة مع شطفة كلاسيكية)
        const sillW = width + frameCasingW * 2 + 0.12;
        const sillH = 0.10;
        const sillD = 0.18;
        const sillMesh = new THREE.Mesh(new THREE.BoxGeometry(sillW, sillH, sillD), trimMat);
        sillMesh.position.set(0, -height / 2 - sillH / 2, sillD / 2);
        sillMesh.castShadow = true;
        winGroup.add(sillMesh);

        // 6. Classic Stone Lintel with Keystone (طبانة حجر وقفل كلاسيكي مسطح)
        if (isClassic) {
            const lintelW = width + frameCasingW * 2 + 0.16;
            const lintelH = 0.15;
            const lintelD = 0.12;
            const lintelMesh = new THREE.Mesh(new THREE.BoxGeometry(lintelW, lintelH, lintelD), trimMat);
            lintelMesh.position.set(0, height / 2 + frameCasingW + lintelH / 2, lintelD / 2);
            lintelMesh.castShadow = true;
            winGroup.add(lintelMesh);

            // Carved Keystone (قفل الحجر البارز)
            const keyMesh = new THREE.Mesh(new THREE.BoxGeometry(0.18, 0.22, 0.15), trimMat);
            keyMesh.position.set(0, height / 2 + frameCasingW + lintelH / 2 + 0.02, 0.08);
            keyMesh.castShadow = true;
            winGroup.add(keyMesh);
        }

        group.add(winGroup);
    }

    function toggleXRayMode() {
        isXRayMode = !isXRayMode;
        const btn = document.getElementById('xrayBtn');
        const text = document.getElementById('xrayBtnText');
        if (isXRayMode) {
            btn.className = 'px-3 py-1.5 rounded-xl border border-indigo-500 text-xs font-bold text-white bg-indigo-600 shadow-sm flex items-center gap-1.5 transition-all cursor-pointer';
            text.innerText = isEnMode ? "Solid Facade" : "عرض الحجر المصمت";
        } else {
            btn.className = 'px-3 py-1.5 rounded-xl border border-slate-700 text-xs font-bold text-slate-200 bg-slate-800 hover:bg-slate-750 hover:border-slate-600 shadow-sm flex items-center gap-1.5 transition-all cursor-pointer';
            text.innerText = isEnMode ? "X-Ray Skeleton" : "رؤية الهيكل العظم";
        }
        update3DScene();
    }

    let currentCameraPreset = 'front';

    function getOptimalCameraParams(preset) {
        const floors = parseInt(document.getElementById('floorsInput')?.value || 2);
        const floorHeight = 2.8;
        const totalHeight = floors * floorHeight + 1.2;
        const targetY = Math.max(2.0, totalHeight * 0.48);

        // Calculate distance required to frame the entire height with generous architectural margin
        const vFovRad = ((threeCamera && threeCamera.fov) ? threeCamera.fov : 36) * Math.PI / 180;
        const requiredSpan = totalHeight * 1.45; // generous margin so ground plaza, entrance, and roof parapet fit completely!
        const optDist = Math.max(13.5, (requiredSpan / 2) / Math.tan(vFovRad / 2));

        if (preset === 'front') {
            return {
                eye: new THREE.Vector3(0.2, targetY * 1.05 + 0.6, optDist),
                target: new THREE.Vector3(0, targetY, 0)
            };
        } else if (preset === 'iso') {
            return {
                eye: new THREE.Vector3(optDist * 0.72, targetY + optDist * 0.38, optDist * 0.76),
                target: new THREE.Vector3(0, targetY, 0)
            };
        } else if (preset === 'interior') {
            // Camera smoothly glides directly into furnished ground floor living room!
            return {
                eye: new THREE.Vector3(-1.0, 1.45, 1.6),
                target: new THREE.Vector3(-0.2, 1.25, -0.6)
            };
        }
        return {
            eye: new THREE.Vector3(0.2, targetY * 1.05 + 0.6, optDist),
            target: new THREE.Vector3(0, targetY, 0)
        };
    }

    function reset3DCamera() {
        if (!threeCamera || !threeControls) return;
        setCameraPreset('front');
    }

    function animateCameraTo(targetEye, targetLook) {
        if (!threeCamera || !threeControls) return;
        cameraTargetPos = targetEye.clone();
        controlsTargetPos = targetLook.clone();
        isCameraAnimating = true;
        if (isDroneOrbiting) {
            toggleDroneOrbit(false);
        }
    }

    function setCameraPreset(preset, isInstant = false) {
        currentCameraPreset = preset;
        // Visual indicator on camera preset buttons
        ['cam-btn-front', 'cam-btn-iso', 'cam-btn-interior'].forEach(id => {
            const btn = document.getElementById(id);
            if (!btn) return;
            if (id === `cam-btn-${preset}`) {
                btn.className = 'px-2.5 py-1.5 rounded-lg bg-indigo-600 text-white font-bold text-[11px] shadow-sm flex items-center gap-1 transition-all cursor-pointer';
            } else {
                btn.className = 'px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 font-medium text-[11px] flex items-center gap-1 transition-all cursor-pointer';
            }
        });

        updateDroneBtnUI(false);

        const params = getOptimalCameraParams(preset);
        if (isInstant && threeCamera && threeControls) {
            threeCamera.position.copy(params.eye);
            threeControls.target.copy(params.target);
            threeControls.update();
        } else {
            animateCameraTo(params.eye, params.target);
        }
    }

    function toggleDroneOrbit(forceState) {
        isDroneOrbiting = (forceState !== undefined) ? forceState : !isDroneOrbiting;
        if (isDroneOrbiting) {
            isCameraAnimating = false;
            if (threeCamera) {
                droneAngle = Math.atan2(threeCamera.position.x, threeCamera.position.z);
            }
            ['cam-btn-front', 'cam-btn-iso', 'cam-btn-interior'].forEach(id => {
                const btn = document.getElementById(id);
                if (btn) btn.className = 'px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 font-medium text-[11px] flex items-center gap-1 transition-all cursor-pointer';
            });
        }
        updateDroneBtnUI(isDroneOrbiting);
    }

    function updateDroneBtnUI(active) {
        const dBtn = document.getElementById('droneOrbitBtn');
        if (!dBtn) return;
        if (active) {
            dBtn.className = 'px-2.5 py-1.5 rounded-lg bg-indigo-600 text-white font-bold text-[11px] shadow-sm flex items-center gap-1 transition-all cursor-pointer animate-pulse';
        } else {
            dBtn.className = 'px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 font-medium text-[11px] flex items-center gap-1 transition-all cursor-pointer';
        }
    }

    // Window resize listener
    window.addEventListener('resize', () => {
        if (isThreeInitialized) initOrResize3D();
    });

    // Run initial instant math & initialize 3D model immediately
    document.addEventListener('DOMContentLoaded', () => {
        calculateInstantLocalMath();
        const initialFinish = document.querySelector('input[name="stoneFinish"]:checked')?.value || "Mufajjar";
        const initialStone = document.querySelector('input[name="stoneType"]:checked')?.value || "Natural_Ruwaished";
        updateFinishQuickButtons(initialFinish);
        updateTypeQuickButtons(initialStone);
        setTimeout(() => {
            initOrResize3D();
            update3DScene();
        }, 80);
    });

    window.addEventListener('load', () => {
        initOrResize3D();
        update3DScene();
    });

    // ════════════════ SAMPLE BOX & SHOWROOM PASS HANDLERS ════════════════
    function getSelectedStoneTitle() {
        const checkedRadio = document.querySelector('input[name="stoneType"]:checked');
        if (!checkedRadio) return isEnMode ? "Natural Stone" : "حجر بناء طبيعي";
        const label = checkedRadio.closest('label');
        if (label) {
            const p = label.querySelector('p');
            if (p) return p.innerText.trim();
        }
        return checkedRadio.value;
    }

    function getSelectedStoneFinish() {
        const checkedFinish = document.querySelector('input[name="stoneFinish"]:checked');
        if (!checkedFinish) return "Mufajjar";
        const span = checkedFinish.closest('label')?.querySelector('span');
        return span ? span.innerText.trim() : checkedFinish.value;
    }

    function openSampleBoxModal() {
        const modal = document.getElementById('sampleBoxModal');
        const formContent = document.getElementById('sampleBoxFormContent');
        const successContent = document.getElementById('sampleBoxSuccessContent');
        const stoneTitle = document.getElementById('modalSampleStoneTitle');
        
        if (stoneTitle) {
            stoneTitle.innerText = `${getSelectedStoneTitle()} - ${getSelectedStoneFinish()}`;
        }
        if (formContent) formContent.classList.remove('hidden');
        if (successContent) successContent.classList.add('hidden');
        if (modal) modal.classList.remove('hidden');
    }

    function closeSampleBoxModal() {
        const modal = document.getElementById('sampleBoxModal');
        if (modal) modal.classList.add('hidden');
    }

    async function submitSampleBoxOrder() {
        const fullName = document.getElementById('sampleFullName')?.value.trim();
        const phone = document.getElementById('samplePhone')?.value.trim();
        const city = document.getElementById('sampleCity')?.value;
        const address = document.getElementById('sampleAddress')?.value.trim();
        const btn = document.getElementById('submitSampleBtn');

        if (!fullName || !phone || !address) {
            alert(isEnMode ? "Please enter your name, phone number, and delivery address." : "يرجى إدخال الاسم الكريم ورقم الهاتف وعنوان الموقع.");
            return;
        }

        const payload = {
            stoneType: getSelectedStoneTitle(),
            stoneFinish: getSelectedStoneFinish(),
            fullName: fullName,
            phone: phone,
            city: city,
            deliveryAddress: address,
            samplePriceJod: 5.00
        };

        if (btn) {
            btn.disabled = true;
            btn.innerHTML = `<span class="material-symbols-outlined text-sm animate-spin">progress_activity</span> ${isEnMode ? "Processing..." : "جاري التسجيل..."}`;
        }

        try {
            const resp = await fetch('/Shop/Calculator/OrderSampleBox', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await resp.json();

            if (data.success) {
                document.getElementById('sampleBoxFormContent')?.classList.add('hidden');
                document.getElementById('sampleBoxSuccessContent')?.classList.remove('hidden');
                const trackingEl = document.getElementById('sampleTrackingCodeDisplay');
                if (trackingEl) trackingEl.innerText = data.trackingCode || 'SMP-SUCCESS';
            } else {
                alert(data.message || (isEnMode ? "Failed to record request." : "حدث خطأ أثناء تسجيل الطلب."));
            }
        } catch (e) {
            console.error(e);
            alert(isEnMode ? "Communication error, please try again." : "تعذر الاتصال بالخادم، يرجى المحاولة لاحقاً.");
        } finally {
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = `<span class="material-symbols-outlined text-sm">local_shipping</span> ${isEnMode ? "Confirm Sample Request (5 JOD)" : "تأكيد طلب العينة (5 د.أ)"}`;
            }
        }
    }

    function openShowroomPassModal() {
        const modal = document.getElementById('showroomPassModal');
        const formContent = document.getElementById('showroomPassFormContent');
        const resultContent = document.getElementById('showroomPassResultContent');
        const dateInput = document.getElementById('passVisitDate');
        
        if (dateInput && !dateInput.value) {
            const tomorrow = new Date();
            tomorrow.setDate(tomorrow.getDate() + 1);
            dateInput.value = tomorrow.toISOString().split('T')[0];
        }

        if (formContent) formContent.classList.remove('hidden');
        if (resultContent) resultContent.classList.add('hidden');
        if (modal) modal.classList.remove('hidden');
    }

    function closeShowroomPassModal() {
        const modal = document.getElementById('showroomPassModal');
        if (modal) modal.classList.add('hidden');
    }

    async function submitShowroomPass() {
        const fullName = document.getElementById('passFullName')?.value.trim();
        const phone = document.getElementById('passPhone')?.value.trim();
        const city = document.getElementById('passCity')?.value;
        const visitDate = document.getElementById('passVisitDate')?.value;
        const areaM2 = document.getElementById('passAreaM2')?.value;
        const btn = document.getElementById('submitPassBtn');

        if (!fullName || !phone) {
            alert(isEnMode ? "Please enter your name and phone number." : "يرجى إدخال الاسم الكريم ورقم الهاتف.");
            return;
        }

        const payload = {
            stoneType: `${getSelectedStoneTitle()} (${getSelectedStoneFinish()})`,
            fullName: fullName,
            phone: phone,
            city: city,
            preferredDate: visitDate ? new Date(visitDate).toISOString() : new Date().toISOString(),
            estimatedAreaM2: areaM2 || "غير محدد"
        };

        if (btn) {
            btn.disabled = true;
            btn.innerHTML = `<span class="material-symbols-outlined text-sm animate-spin">progress_activity</span> ${isEnMode ? "Generating..." : "جاري الإصدار..."}`;
        }

        try {
            const resp = await fetch('/Shop/Calculator/RequestShowroomPass', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await resp.json();

            if (data.success) {
                document.getElementById('showroomPassFormContent')?.classList.add('hidden');
                document.getElementById('showroomPassResultContent')?.classList.remove('hidden');
                
                document.getElementById('passResultNumberDisplay').innerText = data.passNumber;
                document.getElementById('passResultNameDisplay').innerText = fullName;
                document.getElementById('passResultStoneDisplay').innerText = payload.stoneType;
                document.getElementById('passResultDateDisplay').innerText = data.preferredDate || visitDate;
            } else {
                alert(data.message || (isEnMode ? "Failed to generate pass." : "حدث خطأ أثناء إصدار التذكرة."));
            }
        } catch (e) {
            console.error(e);
            alert(isEnMode ? "Communication error, please try again." : "تعذر الاتصال بالخادم، يرجى المحاولة لاحقاً.");
        } finally {
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = `<span class="material-symbols-outlined text-sm">confirmation_number</span> ${isEnMode ? "Generate Escrow Pass" : "إصدار التذكرة المشفرة"}`;
            }
        }
    }

    function printShowroomPass() {
        const card = document.getElementById('printablePassCard');
        if (!card) return;
        const printWin = window.open('', '', 'width=700,height=600');
        printWin.document.write('<html><head><title>BLOCKO Escrow Showroom Pass</title><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css"></head><body class="p-8 bg-slate-100 flex items-center justify-center">');
        printWin.document.write(card.outerHTML);
        printWin.document.write('</body></html>');
        printWin.document.close();
        printWin.focus();
        setTimeout(() => { printWin.print(); printWin.close(); }, 500);
    }
</script>
}
