@{
    var isArabic = System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("ar");
    ViewData["Title"] = isArabic 
        ? "علاقات المستثمرين والشراكات الاستراتيجية | بلوكو ConTech" 
        : "Investor Relations & Strategic Partnerships | BLOCK-O ConTech";
    Layout = "~/Areas/Shop/Views/Shared/_Layout.cshtml";
}

<div class="bg-slate-950 text-white min-h-screen text-start font-['Tajawal']" dir="@(isArabic ? "rtl" : "ltr")">

    <!-- 1. Hero Showcase Section -->
    <div class="relative overflow-hidden pt-16 pb-20 px-4 sm:px-6 lg:px-8 border-b border-slate-800">
        <div class="absolute -top-32 -end-32 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-32 -start-32 w-96 h-96 bg-sky-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="max-w-6xl mx-auto space-y-8 relative z-10">
            <!-- Breadcrumb / Badge -->
            <div class="flex flex-wrap items-center gap-3">
                <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-amber-500/20 text-amber-300 text-xs font-black border border-amber-500/30">
                    <span class="material-symbols-outlined text-sm">trending_up</span>
                    <span>@(isArabic ? "بوابة المستثمرين وصناديق رأس المال الجريء" : "Investor Relations & Venture Capital")</span>
                </span>
                <span class="px-3 py-1 rounded-full bg-slate-800/80 text-slate-300 text-xs font-mono border border-slate-700">
                    ConTech • FinTech • B2B Marketplace
                </span>
            </div>

            <!-- Title & Pitch -->
            <div class="max-w-3xl space-y-4">
                <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white leading-tight tracking-tight">
                    @(isArabic 
                        ? "رقمنة قطاع الإنشاءات وتمويل التوريد في الشرق الأوسط" 
                        : "Digitizing Construction & Supply Chain Financing in MENA")
                </h1>
                <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
                    @(isArabic 
                        ? "منصة بلوكو (BLOCK-O) هي البنية التحتية الرقمية الأولى لسوق مقاولات البناء؛ ندمج حاسبة الكميات الذكية (AI BOQ Engine) مع شبكة كبار الموردين والمقالع ومنظومة تمويل المرابحة الشرعية المضمونة." 
                        : "BLOCK-O is the leading digital infrastructure for the construction supply chain, combining AI BOQ estimation, verified supplier networks, and Sharia-compliant murabaha tender financing.")
                </p>
            </div>

            <!-- Key Action CTAs -->
            <div class="flex flex-wrap items-center gap-4 pt-4">
                <a href="/Downloads/PitchDeck" 
                   class="px-6 py-3.5 rounded-2xl bg-[#E8A020] hover:bg-amber-400 text-slate-950 font-black text-xs sm:text-sm transition-all shadow-lg shadow-amber-500/20 active:scale-95 flex items-center gap-2">
                    <span class="material-symbols-outlined text-lg">download</span>
                    <span>@(isArabic ? "تحميل العرض التقديمي (Pitch Deck v2.4)" : "Download Pitch Deck (PPTX)")</span>
                </a>

                <a href="#investmentInquiry" 
                   class="px-6 py-3.5 rounded-2xl bg-slate-800 hover:bg-slate-700 text-white font-bold text-xs sm:text-sm transition-all border border-slate-700 flex items-center gap-2">
                    <span class="material-symbols-outlined text-lg text-amber-400">mail</span>
                    <span>@(isArabic ? "طلب اجتماع شراكة أو استثمار" : "Request Investor Meeting")</span>
                </a>

                <a asp-area="Shop" asp-controller="Financing" asp-action="Index" 
                   class="px-6 py-3.5 rounded-2xl bg-slate-900/80 hover:bg-slate-800 text-sky-400 font-bold text-xs sm:text-sm transition-all border border-sky-500/30 flex items-center gap-2">
                    <span class="material-symbols-outlined text-lg">account_balance</span>
                    <span>@(isArabic ? "استعراض عطاءات المرابحة النشطة" : "Explore Murabaha Tenders")</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Feedback Notice -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-8">
            <div class="p-4 rounded-2xl bg-emerald-950/80 border border-emerald-500/40 text-emerald-300 text-xs font-bold flex items-center gap-3">
                <span class="material-symbols-outlined text-emerald-400 text-xl">check_circle</span>
                <span>@TempData["SuccessMessage"]</span>
            </div>
        </div>
    }

    <!-- 2. Platform Traction Metrics Grid -->
    <div class="max-w-6xl mx-auto py-16 px-4 sm:px-6 lg:px-8">
        <div class="text-center sm:text-start mb-10">
            <h2 class="text-2xl sm:text-3xl font-black text-white">@(isArabic ? "مؤشرات النمو والأداء التشغيلي (Key Traction Metrics)" : "Key Traction & Performance Metrics")</h2>
            <p class="text-xs sm:text-sm text-slate-400 mt-2">@(isArabic ? "بيانات حقيقية مبنية على حجم الصفقات وطلبات التوريد المدارة عبر المنصة" : "Real operational metrics powered by BLOCK-O marketplace activity")</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <!-- Metric 1: GMV -->
            <div class="p-6 rounded-3xl bg-slate-900/90 border border-slate-800 hover:border-amber-500/50 transition-all space-y-3 shadow-xl">
                <div class="flex items-center justify-between">
                    <span class="p-2.5 rounded-xl bg-amber-500/10 text-amber-400">
                        <span class="material-symbols-outlined text-2xl">payments</span>
                    </span>
                    <span class="text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400">+145% YoY</span>
                </div>
                <div>
                    <span class="text-3xl sm:text-4xl font-black text-white font-mono">4.2M+</span>
                    <span class="text-xs font-bold text-amber-400 ms-1">د.أ JOD</span>
                </div>
                <p class="text-xs font-bold text-slate-400">@(isArabic ? "إجمالي قيمة البضائع المتداولة (GMV)" : "Gross Merchandise Value")</p>
            </div>

            <!-- Metric 2: Suppliers -->
            <div class="p-6 rounded-3xl bg-slate-900/90 border border-slate-800 hover:border-sky-500/50 transition-all space-y-3 shadow-xl">
                <div class="flex items-center justify-between">
                    <span class="p-2.5 rounded-xl bg-sky-500/10 text-sky-400">
                        <span class="material-symbols-outlined text-2xl">warehouse</span>
                    </span>
                    <span class="text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded-full bg-sky-500/20 text-sky-400">Verified B2B</span>
                </div>
                <div>
                    <span class="text-3xl sm:text-4xl font-black text-white font-mono">480+</span>
                </div>
                <p class="text-xs font-bold text-slate-400">@(isArabic ? "شبكة الموردين والمقالع والمصانع المعتمدة" : "Active Suppliers & Quarries")</p>
            </div>

            <!-- Metric 3: Logistics Savings -->
            <div class="p-6 rounded-3xl bg-slate-900/90 border border-slate-800 hover:border-emerald-500/50 transition-all space-y-3 shadow-xl">
                <div class="flex items-center justify-between">
                    <span class="p-2.5 rounded-xl bg-emerald-500/10 text-emerald-400">
                        <span class="material-symbols-outlined text-2xl">local_shipping</span>
                    </span>
                    <span class="text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400">Efficiency</span>
                </div>
                <div>
                    <span class="text-3xl sm:text-4xl font-black text-emerald-400 font-mono">18.5%</span>
                </div>
                <p class="text-xs font-bold text-slate-400">@(isArabic ? "وفورات تكاليف النقل عبر التوجيه الذكي" : "Logistics & Transport Savings")</p>
            </div>

            <!-- Metric 4: Default Rate -->
            <div class="p-6 rounded-3xl bg-slate-900/90 border border-slate-800 hover:border-purple-500/50 transition-all space-y-3 shadow-xl">
                <div class="flex items-center justify-between">
                    <span class="p-2.5 rounded-xl bg-purple-500/10 text-purple-400">
                        <span class="material-symbols-outlined text-2xl">shield</span>
                    </span>
                    <span class="text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded-full bg-purple-500/20 text-purple-400">0% Default</span>
                </div>
                <div>
                    <span class="text-3xl sm:text-4xl font-black text-white font-mono">0.0%</span>
                </div>
                <p class="text-xs font-bold text-slate-400">@(isArabic ? "نسبة التعثر في تمويل المرابحة الإنشائية" : "Murabaha Financing Default Rate")</p>
            </div>
        </div>
    </div>

    <!-- 3. Business Pillars & Moats -->
    <div class="bg-slate-900/50 py-16 border-y border-slate-800">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
            <div class="text-center max-w-2xl mx-auto space-y-3">
                <span class="text-xs font-black uppercase tracking-wider text-amber-400">@(isArabic ? "محركات القيمة والنمو" : "Business Model & Moats")</span>
                <h2 class="text-2xl sm:text-4xl font-black text-white">@(isArabic ? "نموذج أعمال متكامل يدر عوائد متعددة" : "Multi-Stream Revenue Ecosystem")</h2>
                <p class="text-xs sm:text-sm text-slate-400">@(isArabic ? "تجمع بلوكو بين عمولات السوق المباشرة، وهوامش تمويل المرابحة، والخدمات اللوجستية الذكية." : "Combining marketplace take-rates, financing margins, and smart logistics.")</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Pillar 1 -->
                <div class="p-8 rounded-3xl bg-slate-900 border border-slate-800 space-y-4">
                    <div class="w-12 h-12 rounded-2xl bg-amber-500/10 text-amber-400 flex items-center justify-center font-black text-xl">
                        🛒
                    </div>
                    <h3 class="text-lg font-black text-white">@(isArabic ? "1. عمولات السوق (Marketplace Take-Rate)" : "1. Marketplace Commissions")</h3>
                    <p class="text-xs text-slate-400 leading-relaxed">
                        @(isArabic 
                            ? "تحصيل عمولة منصة بنسبة تتراوح بين 2.0% إلى 3.5% على كافة صفقات التوريد المباشرة بين المقاولين والموردين، مع تسوية آلية وسريعة." 
                            : "Standard 2.0% - 3.5% take rate on all B2B building materials transactions with automated clearing and settlements.")
                    </p>
                </div>

                <!-- Pillar 2 -->
                <div class="p-8 rounded-3xl bg-slate-900 border border-slate-800 space-y-4">
                    <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center font-black text-xl">
                        📈
                    </div>
                    <h3 class="text-lg font-black text-white">@(isArabic ? "2. تمويل المرابحة (Murabaha Yields)" : "2. Murabaha Financing Spread")</h3>
                    <p class="text-xs text-slate-400 leading-relaxed">
                        @(isArabic 
                            ? "تمويل توريد المواد الإنشائية وفق صيغة المرابحة الإسلامية بعوائد سنوية 8.5% - 14% للمستثمرين والصناديق، مدعومة بضمانات وسندات تنفيذية." 
                            : "Sharia-compliant short-to-medium term supply financing yielding 8.5% - 14% p.a. backed by legal collaterals and GPS delivery geofencing.")
                    </p>
                </div>

                <!-- Pillar 3 -->
                <div class="p-8 rounded-3xl bg-slate-900 border border-slate-800 space-y-4">
                    <div class="w-12 h-12 rounded-2xl bg-sky-500/10 text-sky-400 flex items-center justify-center font-black text-xl">
                        🤖
                    </div>
                    <h3 class="text-lg font-black text-white">@(isArabic ? "3. محرك الحاسبة الذكية (AI BOQ Funnel)" : "3. AI BOQ Lead Engine")</h3>
                    <p class="text-xs text-slate-400 leading-relaxed">
                        @(isArabic 
                            ? "حاسبة البناء الذكية تحول آلاف الملاك والمطورين من مجرد حاسبين للمسطحات إلى طلبات توريد حقيقية (Ready BOQs) بدون أي تكلفة استقطاب (Zero CAC)." 
                            : "Our proprietary calculator converts engineering parameters into actionable BOQs with zero CAC, fueling continuous RFQ velocity.")
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. Pitch Deck & Documentation Section -->
    <div class="max-w-6xl mx-auto py-16 px-4 sm:px-6 lg:px-8">
        <div class="bg-gradient-to-r from-amber-500/10 via-slate-900 to-sky-500/10 rounded-3xl p-8 sm:p-12 border border-slate-800 flex flex-col md:flex-row items-center justify-between gap-8">
            <div class="space-y-4 max-w-xl text-center md:text-start">
                <span class="px-3 py-1 rounded-full bg-amber-500/20 text-amber-300 text-xs font-bold border border-amber-500/30">
                    @(isArabic ? "ملف العرض الاستثماري الرسمي" : "Official Pitch Deck")
                </span>
                <h3 class="text-2xl sm:text-3xl font-black text-white">
                    @(isArabic ? "حمّل العرض التقديمي لمنصة بلوكو لعام 2026" : "Download the BLOCK-O 2026 Investor Pitch Deck")
                </h3>
                <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
                    @(isArabic 
                        ? "يحتوي الملف على دراسة حجم السوق في الأردن والخليج (TAM/SAM/SOM)، والتوقعات المالية لخمس سنوات، وتفاصيل دورة التمويل الحالية (Round Structure)." 
                        : "Includes market size breakdown (TAM/SAM/SOM), 5-year financial projections, unit economics, and financing round mechanics.")
                </p>
            </div>
            <div class="flex-shrink-0">
                <a href="/Downloads/PitchDeck" 
                   class="px-8 py-4 rounded-2xl bg-[#E8A020] hover:bg-amber-400 text-slate-950 font-black text-sm transition-all shadow-xl shadow-amber-500/25 active:scale-95 flex items-center gap-2">
                    <span class="material-symbols-outlined text-xl">download_for_offline</span>
                    <span>@(isArabic ? "تحميل الملف (PowerPoint Presentation)" : "Download PPTX Deck")</span>
                </a>
            </div>
        </div>
    </div>

    <!-- 5. Investment & Partnership Inquiry Form -->
    <div id="investmentInquiry" class="max-w-4xl mx-auto py-16 px-4 sm:px-6 lg:px-8">
        <div class="bg-slate-900 rounded-3xl p-8 sm:p-12 border border-slate-800 shadow-2xl space-y-8">
            <div class="border-b border-slate-800 pb-6 space-y-2">
                <h3 class="text-xl sm:text-2xl font-black text-white">
                    @(isArabic ? "نموذج طلب اجتماع المستثمرين والشراكات الاستراتيجية" : "Strategic Partnership & Investor Inquiry Form")
                </h3>
                <p class="text-xs sm:text-sm text-slate-400">
                    @(isArabic ? "يرجى تعبئة بيانات المنشأة الاستثمارية ليقوم فريق علاقات المستثمرين بجدولة اجتماع تفصيلي وتزويدكم بالملفات السرية." : "Please provide your details to schedule an executive briefing with our investment relations team.")
                </p>
            </div>

            <form asp-area="Shop" asp-controller="Home" asp-action="SubmitInvestorInquiry" method="post" class="space-y-6">
                @Html.AntiForgeryToken()

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div>
                        <label class="block text-xs font-bold text-slate-300 mb-2">@(isArabic ? "الاسم الكامل *" : "Full Name *")</label>
                        <input type="text" name="fullName" required placeholder="@(isArabic ? "الاسم الكريم" : "Your Name")"
                               class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-xs font-bold text-white focus:border-amber-500 outline-none transition-colors" />
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-300 mb-2">@(isArabic ? "البريد الإلكتروني المؤسسي *" : "Corporate Email *")</label>
                        <input type="email" name="email" required placeholder="name@firm.com" dir="ltr"
                               class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-xs font-bold text-white focus:border-amber-500 outline-none transition-colors" />
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-300 mb-2">@(isArabic ? "رقم الهاتف / الواتساب *" : "Phone / WhatsApp *")</label>
                        <input type="tel" name="phone" required placeholder="+962 7X XXX XXXX" dir="ltr"
                               class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-xs font-mono font-bold text-white focus:border-amber-500 outline-none transition-colors" />
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-300 mb-2">@(isArabic ? "نوع الجهة المستثمرة / الشريك *" : "Investor / Partner Type *")</label>
                        <select name="organizationType" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-xs font-bold text-white focus:border-amber-500 outline-none transition-colors">
                            <option value="VC">@(isArabic ? "صندوق رأس مال جريء (Venture Capital)" : "Venture Capital Fund")</option>
                            <option value="Angel">@(isArabic ? "مستثمر ملائكي فردي (Angel Investor)" : "Angel Investor")</option>
                            <option value="FamilyOffice">@(isArabic ? "مكتب عائلي / شركة قابضة (Family Office)" : "Family Office / Holding Co.")</option>
                            <option value="Bank">@(isArabic ? "بنك أو مؤسسة تمويل إسلامي (Islamic Bank / NBFI)" : "Islamic Bank / NBFI")</option>
                            <option value="StrategicCorporate">@(isArabic ? "شريك استراتيجي في المقاولات أو المواد (Strategic Partner)" : "Strategic Construction Partner")</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-300 mb-2">@(isArabic ? "ملاحظات أو حجم التذكرة الاستثمارية المتوقعة (اختياري)" : "Investment Ticket Size & Notes (Optional)")</label>
                    <textarea name="message" rows="3" placeholder="@(isArabic ? "يرجى ذكر أي تفاصيل ترغب بمناقشتها في الاجتماع..." : "Additional details...")"
                              class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-xs text-white focus:border-amber-500 outline-none transition-colors"></textarea>
                </div>

                <div class="flex items-center justify-end pt-4 border-t border-slate-800">
                    <button type="submit" class="px-8 py-3.5 rounded-xl bg-[#E8A020] hover:bg-amber-400 text-slate-950 font-black text-xs sm:text-sm transition-all shadow-md active:scale-95 flex items-center gap-2 cursor-pointer">
                        <span class="material-symbols-outlined text-base">send</span>
                        <span>@(isArabic ? "إرسال طلب التواصل الرسمي" : "Submit Official Inquiry")</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>
