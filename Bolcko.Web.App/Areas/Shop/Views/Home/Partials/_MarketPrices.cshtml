@model IEnumerable<Bolcko.Domain.Entities.Catalog.MarketPrice>

<div class="space-y-4">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-gradient-to-r from-slate-900 to-indigo-950 p-4 sm:p-5 rounded-2xl text-white shadow-md">
        <div class="flex items-center gap-3">
            <span class="w-3 h-3 rounded-full bg-emerald-400 animate-ping"></span>
            <div>
                <h3 class="font-black text-sm sm:text-base">مؤشرات أسعار مواد البناء الحية في الأردن</h3>
                <p class="text-[11px] text-slate-300">مربوطة ببورصة الصلب العالمية ومصانع الإسمنت والخرسانة المحلية</p>
            </div>
        </div>
        <a href="/calculator" class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white font-black text-xs transition-all shadow-md shadow-emerald-500/20">
            <span class="material-symbols-outlined text-base">calculate</span>
            <span>حاسبة تكلفة وكميات البناء الذكية</span>
        </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        @foreach (var price in Model)
        {
            var isUp = price.Trend == "up" || price.ChangePercent > 0;
            var isDown = price.Trend == "down" || price.ChangePercent < 0;

            <div class="bg-white border border-slate-200/80 p-5 rounded-2xl shadow-sm hover:shadow-md hover:border-indigo-400 transition-all flex flex-col justify-between group">
                <div class="flex items-start justify-between gap-3">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-slate-100 group-hover:bg-indigo-50 text-slate-700 group-hover:text-indigo-600 flex items-center justify-center transition-colors">
                            @if (price.MaterialCategory == "Steel" || price.MaterialName.Contains("حديد"))
                            {
                                <span class="material-symbols-outlined text-xl">reorder</span>
                            }
                            else if (price.MaterialCategory == "Cement" || price.MaterialName.Contains("أسمنت") || price.MaterialName.Contains("إسمنت"))
                            {
                                <span class="material-symbols-outlined text-xl">foundation</span>
                            }
                            else if (price.MaterialCategory == "Concrete" || price.MaterialName.Contains("خرسانة"))
                            {
                                <span class="material-symbols-outlined text-xl">local_shipping</span>
                            }
                            else
                            {
                                <span class="material-symbols-outlined text-xl">grid_view</span>
                            }
                        </div>
                        <div>
                            <h4 class="font-bold text-slate-800 text-sm line-clamp-1" title="@price.MaterialName">@price.MaterialName</h4>
                            <p class="text-[11px] text-slate-400">@price.UnitOfMeasure</p>
                        </div>
                    </div>

                    <span class="inline-flex items-center gap-0.5 px-2 py-0.5 rounded-md text-[11px] font-black @(isUp ? "bg-emerald-50 text-emerald-600" : (isDown ? "bg-rose-50 text-rose-600" : "bg-slate-100 text-slate-500"))">
                        @if (isUp) { <span class="material-symbols-outlined text-xs">trending_up</span> }
                        else if (isDown) { <span class="material-symbols-outlined text-xs">trending_down</span> }
                        else { <span class="material-symbols-outlined text-xs">trending_flat</span> }
                        <span>@(price.ChangePercent >= 0 ? "+" : "")@price.ChangePercent.ToString("N1")%</span>
                    </span>
                </div>

                <div class="mt-4 pt-3 border-t border-slate-100 flex items-end justify-between">
                    <div>
                        <span class="text-xl font-black text-slate-900">@price.Price.ToString("N2")</span>
                        <span class="text-xs font-bold text-slate-500 ms-1">@price.Currency</span>
                    </div>
                    <span class="text-[10px] text-slate-400 font-medium">@price.LastUpdated.ToString("yyyy-MM-dd HH:mm")</span>
                </div>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="col-span-1 md:col-span-3 bg-white border border-dashed border-slate-300 p-12 flex flex-col items-center justify-center text-center rounded-2xl">
                <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mb-4 text-slate-400">
                    <span class="material-symbols-outlined text-3xl">query_stats</span>
                </div>
                <h3 class="font-bold text-slate-800 mb-2">جاري تحديث الأسعار اللحظية</h3>
                <p class="text-sm text-slate-500 max-w-md mb-6">يقوم النظام بمزامنة أسعار السوق والبورصة تلقائياً.</p>
                <a href="/calculator" class="flex items-center gap-2 text-indigo-600 font-bold bg-indigo-50 px-5 py-2.5 rounded-xl transition-all">
                    <span class="material-symbols-outlined text-sm">calculate</span>
                    <span>فتح حاسبة البناء</span>
                </a>
            </div>
        }
    </div>
</div>
