@{
    ViewData["Title"] = SharedLocalizer["PageNotFoundTitle"];
}

<main class="min-h-[60vh] flex items-center justify-center py-12 px-6 text-right">
    <div class="max-w-md w-full text-center space-y-6 bg-white p-10 border border-slate-200 shadow-hard">
        <span class="material-symbols-outlined text-primary text-6xl">search_off</span>
        <div class="font-headline-xl text-slate-900">404</div>
        <h1 class="text-2xl font-bold text-slate-900">@SharedLocalizer["PageNotFoundHeading"]</h1>
        <p class="text-slate-600">@SharedLocalizer["PageNotFoundDesc"]</p>
        <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href="@Url.Action("Index", "Home", new { area = "Shop" })" class="inline-block bg-primary text-white font-bold px-8 py-3 rounded-md hover:bg-primary/90 transition-all">
                @SharedLocalizer["BackToHomepage"]
            </a>
            <a href="@Url.Action("Support", "Legal", new { area = "Shop" })" class="inline-block text-on-surface-variant font-bold hover:text-primary transition-colors">
                @SharedLocalizer["NeedHelpContactSupport"]
            </a>
        </div>
    </div>
</main>
