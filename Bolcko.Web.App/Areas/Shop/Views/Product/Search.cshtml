@model IEnumerable<Bolcko.Domain.Entities.Product.DTOs.ProductDto>
@{
    ViewData["Title"] = SharedLocalizer["SearchResults"];
}

<main class="max-w-7xl mx-auto px-6 py-12 text-start">
    <header class="mb-12 border-s-4 border-primary-container ps-6">
        <h1 class="font-headline-xl text-on-surface uppercase mb-2">@SharedLocalizer["SearchResults"]</h1>
        <p class="font-body-lg text-secondary">
            @(string.IsNullOrEmpty(ViewBag.Query) ? SharedLocalizer["AllProducts"].Value : string.Format(SharedLocalizer["SearchResultsFor"].Value, ViewBag.Query))
        </p>
    </header>

    @if (Model == null || !Model.Any())
    {
        <div class="bg-surface-container-low p-12 text-center shadow-hard border border-outline-variant">
            <span class="material-symbols-outlined text-outline text-6xl mb-4">search_off</span>
            <h2 class="font-headline-md text-on-surface mb-2">@SharedLocalizer["NoSearchResultsFound"]</h2>
            <p class="text-secondary mb-8">@SharedLocalizer["NoSearchResultsDesc"]</p>
            <a href="@Url.Action("Index", "Home", new { area = "Shop" })" class="bg-primary text-white font-bold px-8 py-3 uppercase shadow-hard hover:opacity-90 transition-all inline-block">
                @SharedLocalizer["BackToHome"]
            </a>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-gutter">
            @foreach (var product in Model)
            {
                <partial name="Partials/_ProductCard" model="product" />
            }
        </div>

        @if (ViewBag.TotalPages > 1)
        {
            var currentPage = (int)ViewBag.CurrentPage;
            var totalPages = (int)ViewBag.TotalPages;
            var q = (string?)ViewBag.Query ?? "";

            <nav class="mt-12 flex items-center justify-center gap-2" aria-label="Pagination">
                @if (currentPage > 1)
                {
                    <a href="@Url.Action("Search", "Product", new { area = "Shop", query = q, page = currentPage - 1 })" 
                       class="px-4 py-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-bold transition-all flex items-center gap-1 shadow-sm">
                        <span class="material-symbols-outlined text-sm">arrow_forward</span>
                        <span>السابق</span>
                    </a>
                }

                @for (int i = 1; i <= totalPages; i++)
                {
                    if (i == 1 || i == totalPages || (i >= currentPage - 2 && i <= currentPage + 2))
                    {
                        if (i == currentPage)
                        {
                            <span class="px-4 py-2.5 rounded-xl bg-amber-500 text-slate-950 font-black text-xs shadow-md font-mono">@i</span>
                        }
                        else
                        {
                            <a href="@Url.Action("Search", "Product", new { area = "Shop", query = q, page = i })" 
                               class="px-4 py-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-bold text-xs font-mono transition-all shadow-sm">@i</a>
                        }
                    }
                    else if (i == currentPage - 3 || i == currentPage + 3)
                    {
                        <span class="px-2 text-slate-400 font-mono">...</span>
                    }
                }

                @if (currentPage < totalPages)
                {
                    <a href="@Url.Action("Search", "Product", new { area = "Shop", query = q, page = currentPage + 1 })" 
                       class="px-4 py-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-bold transition-all flex items-center gap-1 shadow-sm">
                        <span>التالي</span>
                        <span class="material-symbols-outlined text-sm">arrow_back</span>
                    </a>
                }
            </nav>
        }
    }
</main>
