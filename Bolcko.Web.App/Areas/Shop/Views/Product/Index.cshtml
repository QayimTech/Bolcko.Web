@model Bolcko.Domain.Entities.Product.DTOs.ProductDto
@{
    ViewData["Title"] = SharedLocalizer["ProductDetails"];
}

@section Head {
    @if (Model != null)
    {
        <partial name="Partials/_ProductJsonLd" model="Model" />
    }
}

<main class="w-full max-w-7xl mx-auto px-4 sm:px-6 py-8 md:py-12 text-start overflow-hidden">
    @if (Model != null)
    {
        <!-- Breadcrumbs -->
        <nav class="flex items-center gap-2 mb-8 md:mb-12 text-[11px] font-bold text-slate-400 uppercase tracking-widest flex-wrap">
            <a class="hover:text-[#E8A020] transition-colors" href="/">@SharedLocalizer["Home"]</a>
            <span class="material-symbols-outlined text-xs rtl:-scale-x-100">chevron_right</span>
            <a class="hover:text-[#E8A020] transition-colors" href="@Url.Action("Index", "Category", new { area = "Shop" })">@SharedLocalizer["AllCategories"]</a>
            <span class="material-symbols-outlined text-xs rtl:-scale-x-100">chevron_right</span>
            @if (!string.IsNullOrEmpty(Model.CategoryName))
            {
                <a class="hover:text-[#E8A020] transition-colors" href="@Url.Action("Index", "Category", new { area = "Shop", id = Model.CategoryId })">@Model.CategoryName</a>
                <span class="material-symbols-outlined text-xs rtl:-scale-x-100">chevron_right</span>
            }
            <span class="text-slate-800 dark:text-slate-200 font-bold truncate max-w-[200px] sm:max-w-xs">@Model.Name</span>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
            <!-- 1. Product Gallery Section (7 columns) -->
            <div class="lg:col-span-7 space-y-6">
                <partial name="Partials/_ProductGallery" model="Model" />
            </div>

            <!-- 2. Product Info & Purchase Form Section (5 columns) -->
            <div class="lg:col-span-5 flex flex-col gap-6">
                <partial name="Partials/_ProductPurchaseCard" model="Model" />

                <!-- 3. Technical Description & Specifications -->
                <partial name="Partials/_ProductDescriptionSpecs" model="Model" />
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-24 bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 rounded-3xl max-w-lg mx-auto shadow-sm">
            <span class="material-symbols-outlined text-7xl text-slate-200 dark:text-slate-700 mb-4 animate-bounce">inventory</span>
            <h2 class="font-headline-lg text-slate-800 dark:text-white mb-2">@SharedLocalizer["ProductNotAvailable"]</h2>
            <p class="text-slate-400 mb-8 text-sm">@SharedLocalizer["ProductNotAvailableDesc"]</p>
            <a href="@Url.Action("Index", "Category", new { area = "Shop" })" 
               class="bg-[#E8A020] hover:bg-[#ffb94c] text-[#151B26] font-bold px-8 py-4 rounded-xl transition-all shadow-md inline-block">
                @SharedLocalizer["BrowseAlternatives"]
            </a>
        </div>
    }
</main>

@section Scripts {
    <script>
        (function() {
            function initProductPage() {
                const quantityInput = document.getElementById('quantity-input');

                // Universal Click Delegate
                document.addEventListener('click', function(e) {
                    // 1. Quantity Add Button
                    const addBtn = e.target.closest('[data-quantity-btn="add"]');
                    if (addBtn && quantityInput) {
                        let current = parseInt(quantityInput.value) || 1;
                        quantityInput.value = current + 1;
                        return;
                    }

                    // 2. Quantity Remove Button
                    const removeBtn = e.target.closest('[data-quantity-btn="remove"]');
                    if (removeBtn && quantityInput) {
                        let current = parseInt(quantityInput.value) || 1;
                        if (current > 1) {
                            quantityInput.value = current - 1;
                        }
                        return;
                    }

                    // 3. Thumbnail Image Switch
                    const thumbBox = e.target.closest('.thumbnail-image-box');
                    if (thumbBox) {
                        document.querySelectorAll('.thumbnail-image-box').forEach(box => {
                            box.classList.remove('border-[#E8A020]', 'ring-1', 'ring-[#E8A020]');
                            box.classList.add('border-slate-100');
                        });
                        thumbBox.classList.add('border-[#E8A020]', 'ring-1', 'ring-[#E8A020]');
                        thumbBox.classList.remove('border-slate-100');

                        const newUrl = thumbBox.getAttribute('data-image-url');
                        const mainImg = document.getElementById('main-product-image');
                        if (mainImg && newUrl) {
                            if (typeof $ !== 'undefined') {
                                $(mainImg).fadeOut(150, function() {
                                    $(mainImg).attr('src', newUrl).fadeIn(150);
                                });
                            } else {
                                mainImg.src = newUrl;
                            }
                        }
                        return;
                    }

                    // 4. Variant Selection Button Click Handler
                    const variantBtn = e.target.closest('.variant-select-btn');
                    if (variantBtn) {
                        const isAlreadyActive = variantBtn.classList.contains('border-[#E8A020]');
                        
                        if (isAlreadyActive) {
                            // Toggle OFF: Unselect clicked variant & revert back to main product
                            variantBtn.classList.remove('border-[#E8A020]', 'bg-amber-50/20', 'text-[#E8A020]', 'ring-2', 'ring-[#E8A020]/20');
                            variantBtn.classList.add('border-slate-200', 'text-slate-600');

                            const variantIdInput = document.getElementById('selected-variant-id-input');
                            if (variantIdInput) variantIdInput.value = '';

                            const defaultPrice = variantBtn.getAttribute('data-default-price');
                            const priceDisplay = document.getElementById('product-display-price');
                            if (priceDisplay && defaultPrice) priceDisplay.textContent = defaultPrice;

                            const defaultImg = variantBtn.getAttribute('data-default-image');
                            if (defaultImg && defaultImg.trim() !== '') {
                                const mainImg = document.getElementById('main-product-image');
                                if (mainImg) {
                                    if (typeof $ !== 'undefined') {
                                        $(mainImg).fadeOut(150, function() {
                                            $(mainImg).attr('src', defaultImg).fadeIn(150);
                                        });
                                    } else {
                                        mainImg.src = defaultImg;
                                    }
                                }
                            }
                        } else {
                            // Select Clicked Variant & Highlight
                            document.querySelectorAll('.variant-select-btn').forEach(btn => {
                                btn.classList.remove('border-[#E8A020]', 'bg-amber-50/20', 'text-[#E8A020]', 'ring-2', 'ring-[#E8A020]/20');
                                btn.classList.add('border-slate-200', 'text-slate-600');
                            });
                            variantBtn.classList.add('border-[#E8A020]', 'bg-amber-50/20', 'text-[#E8A020]', 'ring-2', 'ring-[#E8A020]/20');
                            variantBtn.classList.remove('border-slate-200', 'text-slate-600');

                            // Read variant datasets
                            const variantId = variantBtn.getAttribute('data-variant-id');
                            const price = variantBtn.getAttribute('data-price');
                            const sku = variantBtn.getAttribute('data-sku');
                            const imageUrl = variantBtn.getAttribute('data-image');

                            // Update hidden variant ID input for AddToCart form
                            const variantIdInput = document.getElementById('selected-variant-id-input');
                            if (variantIdInput && variantId) {
                                variantIdInput.value = variantId;
                            }

                            // Update displayed price
                            const priceDisplay = document.getElementById('product-display-price');
                            if (priceDisplay && price) {
                                priceDisplay.textContent = price;
                            }

                            // Swap main product image with graceful fallback
                            if (imageUrl && imageUrl.trim() !== '') {
                                const finalUrl = (imageUrl.startsWith('http') || imageUrl.startsWith('/')) ? imageUrl : '/' + imageUrl;
                                const defaultImg = variantBtn.getAttribute('data-default-image');
                                const fallbackUrl = (defaultImg && defaultImg.trim() !== '') 
                                    ? ((defaultImg.startsWith('http') || defaultImg.startsWith('/')) ? defaultImg : '/' + defaultImg)
                                    : '/images/product-placeholder.svg';

                                const mainImg = document.getElementById('main-product-image');
                                if (mainImg) {
                                    const testImg = new Image();
                                    testImg.onload = function() {
                                        if (typeof $ !== 'undefined') {
                                            $(mainImg).fadeOut(150, function() {
                                                $(mainImg).attr('src', finalUrl).fadeIn(150);
                                            });
                                        } else {
                                            mainImg.src = finalUrl;
                                        }
                                    };
                                    testImg.onerror = function() {
                                        if (typeof $ !== 'undefined') {
                                            $(mainImg).fadeOut(150, function() {
                                                $(mainImg).attr('src', fallbackUrl).fadeIn(150);
                                            });
                                        } else {
                                            mainImg.src = fallbackUrl;
                                        }
                                    };
                                    testImg.src = finalUrl;
                                }
                            }
                        }
                    }
                });
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initProductPage);
            } else {
                initProductPage();
            }
        })();
    </script>
}