@model IEnumerable<Bolcko.Domain.Entities.Subscription.DTOs.SubscriptionPlanDto>
@{
    ViewData["Title"] = "باقات واشتراكات منظومة بلوكو";
    Layout = "~/Areas/Shop/Views/Shared/_Layout.cshtml";
    var activeRole = ViewBag.ActiveRole as string ?? "Investor";
    var currentSub = ViewBag.CurrentSub as Bolcko.Domain.Entities.Subscription.DTOs.UserSubscriptionDto;
}

<div class="min-h-screen bg-[#0A0E17] text-slate-100 py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto space-y-12">

        <!-- Title & Subtitle -->
        <div class="text-center space-y-4 max-w-3xl mx-auto">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-mono uppercase tracking-widest">
                <span class="material-symbols-outlined text-sm">workspace_premium</span>
                <span>خطط الدخل والتمكين المالي المتقدم</span>
            </div>
            <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white">
                اختر الباقة المناسبة <span class="bg-gradient-to-r from-amber-400 via-amber-200 to-yellow-500 bg-clip-text text-transparent">لتنمية أعمالك</span>
            </h1>
            <p class="text-slate-400 text-sm sm:text-base leading-relaxed">
                سواء كنت مستثمراً يبحث عن وصول مبكر واستثمار آلي، أو مقاولاً يريد رفع سقفه الائتماني لتمويل مواده، أو مورداً يسعى لتقليل عمولات البيع وزيادة طلبياته.
            </p>
        </div>

        @if (currentSub != null)
        {
            <!-- Active Subscription Banner -->
            <div class="bg-gradient-to-r from-emerald-950/60 via-slate-900 to-slate-900 border border-emerald-500/30 rounded-2xl p-6 flex flex-col sm:flex-row items-center justify-between gap-4 shadow-xl">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 rounded-xl bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center text-emerald-400">
                        <span class="material-symbols-outlined text-2xl">verified</span>
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="text-xs font-mono uppercase text-emerald-400">باقتك الحالية المفعلة:</span>
                            <span class="font-bold text-white text-lg">@currentSub.PlanNameAr</span>
                        </div>
                        <p class="text-xs text-slate-400">تنتهي صلاحية التجديد في: <span class="font-mono text-slate-200">@currentSub.EndDate.ToString("yyyy-MM-dd")</span> (متبقي @currentSub.RemainingDays يوم)</p>
                    </div>
                </div>
                <a href="/Shop/Subscription/MySubscription" class="px-5 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs transition-all shadow-md">
                    إدارة اشتراكي والفواتير
                </a>
            </div>
        }

        <!-- Role Selector Tabs & Billing Toggle -->
        <div class="flex flex-col md:flex-row items-center justify-between gap-6 bg-slate-900/60 p-3 rounded-2xl border border-white/10">
            <!-- Roles Tabs -->
            <div class="flex flex-wrap items-center gap-2 w-full md:w-auto">
                <button type="button" onclick="switchRole('Investor')" id="tab-Investor" class="role-tab flex-1 md:flex-none px-5 py-2.5 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-2 @(activeRole == "Investor" ? "bg-amber-500 text-slate-950 shadow-lg" : "bg-white/5 text-slate-300 hover:bg-white/10")">
                    <span class="material-symbols-outlined text-sm">account_balance</span>
                    <span>باقات المستثمرين (Investors)</span>
                </button>
                <button type="button" onclick="switchRole('Contractor')" id="tab-Contractor" class="role-tab flex-1 md:flex-none px-5 py-2.5 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-2 @(activeRole == "Contractor" ? "bg-amber-500 text-slate-950 shadow-lg" : "bg-white/5 text-slate-300 hover:bg-white/10")">
                    <span class="material-symbols-outlined text-sm">engineering</span>
                    <span>باقات المقاولين (Contractors)</span>
                </button>
                <button type="button" onclick="switchRole('Vendor')" id="tab-Vendor" class="role-tab flex-1 md:flex-none px-5 py-2.5 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-2 @(activeRole == "Vendor" ? "bg-amber-500 text-slate-950 shadow-lg" : "bg-white/5 text-slate-300 hover:bg-white/10")">
                    <span class="material-symbols-outlined text-sm">storefront</span>
                    <span>باقات الموردين (Vendors)</span>
                </button>
            </div>

            <!-- Billing Toggle (Monthly / Yearly) -->
            <div class="flex items-center gap-3 bg-black/40 px-4 py-2 rounded-xl border border-white/10 self-center">
                <span class="text-xs font-bold text-slate-300" id="label-monthly">شهري</span>
                <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" id="billingToggle" class="sr-only peer" onchange="toggleBillingCycle()">
                    <div class="w-11 h-6 bg-slate-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-amber-500"></div>
                </label>
                <div class="flex items-center gap-1.5">
                    <span class="text-xs font-bold text-slate-300" id="label-yearly">سنوي</span>
                    <span class="px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 text-[10px] font-bold border border-emerald-500/30">وفر 17%</span>
                </div>
            </div>
        </div>

        <!-- Plans Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8" id="plansContainer">
            @foreach (var plan in Model)
            {
                var isCurrent = currentSub != null && currentSub.PlanId == plan.Id;
                <div class="plan-card relative flex flex-col justify-between bg-slate-900/80 border @(plan.IsPopular ? "border-amber-500 shadow-2xl shadow-amber-500/10 ring-1 ring-amber-500/50" : "border-white/10") rounded-3xl p-8 hover:border-white/30 transition-all duration-300" data-role="@plan.TargetRole">
                    
                    @if (!string.IsNullOrWhiteSpace(plan.BadgeText))
                    {
                        <div class="absolute -top-3.5 start-8 px-3.5 py-1 rounded-full text-[11px] font-bold tracking-wider uppercase @(plan.IsPopular ? "bg-gradient-to-r from-amber-500 to-yellow-500 text-slate-950 shadow-md" : "bg-white/10 text-slate-200 border border-white/20")">
                            @plan.BadgeText
                        </div>
                    }

                    <div class="space-y-6">
                        <div>
                            <h3 class="text-xl font-black text-white">@plan.NameAr</h3>
                            <p class="text-xs text-slate-400 mt-1">@plan.DescriptionAr</p>
                        </div>

                        <!-- Price Tag -->
                        <div class="py-4 border-y border-white/10">
                            <div class="flex items-baseline gap-1">
                                <span class="text-4xl font-black text-white font-mono plan-price-display" data-monthly="@plan.PriceMonthly" data-yearly="@plan.PriceYearly">
                                    @(plan.PriceMonthly == 0 ? "0" : plan.PriceMonthly.ToString("N0"))
                                </span>
                                <span class="text-sm font-bold text-amber-400">د.أ</span>
                                <span class="text-xs text-slate-400 billing-period-text">/ شهرياً</span>
                            </div>
                            @if (plan.PriceYearly > 0)
                            {
                                <p class="text-[11px] text-slate-500 mt-1 font-mono yearly-breakdown-text hidden">
                                    تُدفع @plan.PriceYearly.ToString("N0") د.أ سنوياً
                                </p>
                            }
                        </div>

                        <!-- Highlight Metrics for Roles -->
                        @if (plan.TargetRole == "Contractor" && plan.MaxTenderLimit > 0)
                        {
                            <div class="bg-sky-500/10 border border-sky-500/20 rounded-xl p-3 flex items-center justify-between text-xs">
                                <span class="text-sky-400 font-bold">السقف التمويلي المتاح:</span>
                                <span class="font-mono font-black text-white">@plan.MaxTenderLimit.ToString("N0") د.أ</span>
                            </div>
                        }
                        else if (plan.TargetRole == "Investor" && plan.EarlyAccessHours > 0)
                        {
                            <div class="bg-amber-500/10 border border-amber-500/20 rounded-xl p-3 flex items-center justify-between text-xs">
                                <span class="text-amber-400 font-bold">الوصول المبكر للصفقات:</span>
                                <span class="font-mono font-black text-white">أسبقية @plan.EarlyAccessHours ساعات</span>
                            </div>
                        }
                        else if (plan.TargetRole == "Vendor" && plan.CommissionDiscountPercent > 0)
                        {
                            <div class="bg-emerald-500/10 border border-emerald-500/20 rounded-xl p-3 flex items-center justify-between text-xs">
                                <span class="text-emerald-400 font-bold">خصم العمولة:</span>
                                <span class="font-mono font-black text-white">خصم @plan.CommissionDiscountPercent%</span>
                            </div>
                        }

                        <!-- Features List -->
                        <ul class="space-y-3 text-xs text-slate-300">
                            @foreach (var feature in plan.Features)
                            {
                                <li class="flex items-start gap-2.5">
                                    <span class="material-symbols-outlined text-amber-400 text-base shrink-0 mt-0.5">check_circle</span>
                                    <span class="leading-relaxed">@feature</span>
                                </li>
                            }
                        </ul>
                    </div>

                    <!-- Action Button -->
                    <div class="mt-8 pt-4">
                        @if (isCurrent)
                        {
                            <button disabled class="w-full py-3.5 rounded-xl bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 font-bold text-xs flex items-center justify-center gap-2 cursor-default">
                                <span class="material-symbols-outlined text-sm">check</span>
                                <span>باقتك النشطة حالياً</span>
                            </button>
                        }
                        else if (plan.PriceMonthly == 0)
                        {
                            <button onclick="openSubscribeModal(@plan.Id, '@plan.NameAr', 0, 0)" class="w-full py-3.5 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-xs transition-all flex items-center justify-center gap-2">
                                <span>البدء بالباقة المجانية</span>
                                <span class="material-symbols-outlined text-sm">arrow_left</span>
                            </button>
                        }
                        else
                        {
                            <button onclick="openSubscribeModal(@plan.Id, '@plan.NameAr', @plan.PriceMonthly, @plan.PriceYearly)" class="w-full py-3.5 rounded-xl @(plan.IsPopular ? "bg-amber-500 hover:bg-amber-400 text-slate-950 font-black shadow-lg shadow-amber-500/20" : "bg-white/10 hover:bg-amber-500 hover:text-slate-950 text-white font-bold") text-xs transition-all duration-300 flex items-center justify-center gap-2 active:scale-95">
                                <span>ترقية واشتراك الآن</span>
                                <span class="material-symbols-outlined text-sm">rocket_launch</span>
                            </button>
                        }
                    </div>

                </div>
            }
        </div>

    </div>
</div>

<!-- Subscribe Modal -->
<div id="subscribeModal" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-[#111622] border border-white/20 rounded-3xl max-w-lg w-full p-6 sm:p-8 space-y-6 shadow-2xl relative">
        <button onclick="closeSubscribeModal()" class="absolute top-6 end-6 text-slate-400 hover:text-white">
            <span class="material-symbols-outlined">close</span>
        </button>

        <div class="space-y-1">
            <div class="inline-flex items-center gap-1.5 text-xs font-mono uppercase text-amber-400">
                <span class="material-symbols-outlined text-sm">bolt</span>
                <span>تأكيد الاشتراك وتفعيل الباقة</span>
            </div>
            <h3 class="text-xl font-bold text-white" id="modalPlanTitle">اسم الباقة</h3>
            <p class="text-xs text-slate-400">سيتم تفعيل كامل المزايا والسقف التمويلي في حسابك فوراً.</p>
        </div>

        <form id="subscribeForm" onsubmit="submitSubscription(event)" class="space-y-4">
            <input type="hidden" id="modalPlanId" value="0">

            <div class="bg-slate-900 border border-white/10 rounded-2xl p-4 flex items-center justify-between">
                <div>
                    <span class="text-xs text-slate-400 block">دورة الفوترة والمبلغ:</span>
                    <span class="font-bold text-white text-sm" id="modalBillingSummary">شهري</span>
                </div>
                <div class="text-end">
                    <span class="text-2xl font-black text-amber-400 font-mono" id="modalPriceSummary">0</span>
                    <span class="text-xs text-amber-300 font-bold">د.أ</span>
                </div>
            </div>

            @if (User.Identity?.IsAuthenticated != true)
            {
                <div class="space-y-3 pt-2 border-t border-white/10">
                    <p class="text-xs font-bold text-amber-400">بيانات الحساب الجديد:</p>
                    <div>
                        <label class="block text-[11px] text-slate-300 mb-1">الاسم الكامل</label>
                        <input type="text" id="subFullName" required placeholder="الاسم" class="w-full bg-slate-900 border border-white/10 rounded-xl p-3 text-xs text-white focus:border-amber-400">
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-[11px] text-slate-300 mb-1">البريد الإلكتروني</label>
                            <input type="email" id="subEmail" required placeholder="name@example.com" class="w-full bg-slate-900 border border-white/10 rounded-xl p-3 text-xs text-white focus:border-amber-400">
                        </div>
                        <div>
                            <label class="block text-[11px] text-slate-300 mb-1">كلمة المرور</label>
                            <input type="password" id="subPassword" required placeholder="******" class="w-full bg-slate-900 border border-white/10 rounded-xl p-3 text-xs text-white focus:border-amber-400">
                        </div>
                    </div>
                </div>
            }

            <div>
                <label class="block text-[11px] text-slate-300 mb-1">طريقة الدفع والتسوية</label>
                <select id="subPaymentMethod" class="w-full bg-slate-900 border border-white/10 rounded-xl p-3 text-xs text-white focus:border-amber-400">
                    <option value="Wallet">المحفظة الإلكترونية / رصيد الحساب</option>
                    <option value="CliQ">دفع فوري عبر كليك (CliQ Instant Pay)</option>
                    <option value="CreditCard">بطاقة ائتمان / فيزا / ماستركارد</option>
                </select>
            </div>

            <div class="pt-4 flex items-center justify-end gap-3">
                <button type="button" onclick="closeSubscribeModal()" class="px-5 py-3 rounded-xl bg-white/5 hover:bg-white/10 text-slate-300 text-xs font-bold transition-all">
                    إلغاء
                </button>
                <button type="submit" id="submitSubBtn" class="px-7 py-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-black transition-all shadow-lg shadow-amber-500/20 flex items-center gap-2">
                    <span>تأكيد والاشتراك الآن</span>
                    <span class="material-symbols-outlined text-sm">check</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        let currentBillingCycle = 'Monthly';
        let currentPlanMonthly = 0;
        let currentPlanYearly = 0;

        function switchRole(role) {
            document.querySelectorAll('.role-tab').forEach(tab => {
                tab.className = tab.className.replace('bg-amber-500 text-slate-950 shadow-lg', 'bg-white/5 text-slate-300 hover:bg-white/10');
            });
            const activeTab = document.getElementById('tab-' + role);
            if (activeTab) {
                activeTab.className = activeTab.className.replace('bg-white/5 text-slate-300 hover:bg-white/10', 'bg-amber-500 text-slate-950 shadow-lg');
            }

            document.querySelectorAll('.plan-card').forEach(card => {
                if (card.getAttribute('data-role') === role) {
                    card.classList.remove('hidden');
                } else {
                    card.classList.add('hidden');
                }
            });
        }

        function toggleBillingCycle() {
            const isYearly = document.getElementById('billingToggle').checked;
            currentBillingCycle = isYearly ? 'Yearly' : 'Monthly';

            document.querySelectorAll('.plan-price-display').forEach(el => {
                const monthly = parseFloat(el.getAttribute('data-monthly')) || 0;
                const yearly = parseFloat(el.getAttribute('data-yearly')) || 0;
                
                if (monthly === 0) {
                    el.textContent = "0";
                } else if (isYearly) {
                    const monthlyEquivalent = (yearly / 12).toFixed(0);
                    el.textContent = monthlyEquivalent;
                } else {
                    el.textContent = monthly.toFixed(0);
                }
            });

            document.querySelectorAll('.billing-period-text').forEach(el => {
                el.textContent = isYearly ? '/ شهرياً (تدفع سنوياً)' : '/ شهرياً';
            });

            document.querySelectorAll('.yearly-breakdown-text').forEach(el => {
                el.classList.toggle('hidden', !isYearly);
            });
        }

        function openSubscribeModal(planId, title, pMonth, pYear) {
            document.getElementById('modalPlanId').value = planId;
            document.getElementById('modalPlanTitle').textContent = title;
            currentPlanMonthly = pMonth;
            currentPlanYearly = pYear;

            const isYearly = currentBillingCycle === 'Yearly';
            const price = isYearly ? pYear : pMonth;

            document.getElementById('modalBillingSummary').textContent = isYearly ? 'اشتراك سنوي (مقدم)' : 'اشتراك شهري';
            document.getElementById('modalPriceSummary').textContent = price > 0 ? price.toFixed(0) : '0';

            document.getElementById('subscribeModal').classList.remove('hidden');
        }

        function closeSubscribeModal() {
            document.getElementById('subscribeModal').classList.add('hidden');
        }

        async function submitSubscription(e) {
            e.preventDefault();
            const btn = document.getElementById('submitSubBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="animate-spin material-symbols-outlined text-sm">progress_activity</span> جاري التفعيل...';

            const payload = {
                planId: parseInt(document.getElementById('modalPlanId').value),
                billingCycle: currentBillingCycle,
                paymentMethod: document.getElementById('subPaymentMethod').value,
                fullName: document.getElementById('subFullName')?.value,
                email: document.getElementById('subEmail')?.value,
                password: document.getElementById('subPassword')?.value
            };

            try {
                const res = await fetch('/Shop/Subscription/Subscribe', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (data.success) {
                    alert(data.message || 'تم الاشتراك بنجاح!');
                    window.location.href = data.redirectUrl || '/Shop/Subscription/MySubscription';
                } else {
                    alert(data.message || 'حدث خطأ أثناء الاشتراك.');
                    btn.disabled = false;
                    btn.innerHTML = '<span>تأكيد والاشتراك الآن</span><span class="material-symbols-outlined text-sm">check</span>';
                }
            } catch (err) {
                alert('فشل الاتصال بالخادم.');
                btn.disabled = false;
                btn.innerHTML = '<span>تأكيد والاشتراك الآن</span><span class="material-symbols-outlined text-sm">check</span>';
            }
        }

        // Initialize display for active role
        document.addEventListener('DOMContentLoaded', () => {
            switchRole('@activeRole');
        });
    </script>
}
