@{
    ViewData["Title"] = "حالة اعتماد ملف المقاول (KYC Verification)";
    Layout = "~/Areas/Shop/Views/Shared/_Layout.cshtml";
}

<div class="min-h-screen bg-slate-50/50 py-12 px-4 sm:px-6 lg:px-8 text-right font-sans" dir="rtl">
    <div class="max-w-2xl mx-auto space-y-8">
        
        <div class="bg-white rounded-3xl border border-slate-200 p-8 sm:p-10 shadow-xl text-center space-y-6">
            <div class="relative w-20 h-20 mx-auto">
                <div class="absolute inset-0 rounded-full bg-amber-500/20 animate-ping"></div>
                <div class="relative w-20 h-20 bg-amber-500/10 border border-amber-500/30 text-[#E8A020] rounded-2xl flex items-center justify-center shadow-lg">
                    <span class="material-symbols-outlined text-4xl">verified_user</span>
                </div>
            </div>

            <div class="space-y-2">
                <span class="px-3.5 py-1 rounded-full bg-amber-500/10 text-amber-800 text-xs font-mono font-bold border border-amber-500/20 inline-block">
                    CONTRACTOR KYC REVIEW IN PROGRESS
                </span>
                <h1 class="text-2xl font-black text-slate-900">ملف منشأة المقاولات قيد المراجعة والاعتماد</h1>
                <p class="text-slate-500 text-xs sm:text-sm max-w-md mx-auto leading-relaxed">
                    شكراً لانضمامك إلى شبكة مقاولي بلوكو الإنشائية. يقوم فريق التدقيق الفني حالياً بمطابقة السجل التجاري والتحقق من شهادة نقابة مقاولي الإنشاءات الأردنيين (JCCA).
                </p>
            </div>

            <!-- Verification Progress Tracker -->
            <div class="bg-slate-50 border border-slate-200 rounded-2xl p-5 text-start space-y-4">
                <div class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">مراحل التدقيق والتأهيل الميداني:</div>
                
                <div class="flex items-center gap-3">
                    <div class="w-7 h-7 rounded-full bg-emerald-100 text-emerald-700 border border-emerald-300 flex items-center justify-center text-xs font-bold shrink-0">
                        ✓
                    </div>
                    <div class="flex-1 text-xs">
                        <span class="font-bold text-slate-900">تسجيل بيانات الشركة والمفوّض</span>
                        <p class="text-[11px] text-slate-500">تم تسجيل المنشأة والتحقق من الهاتف والبريد</p>
                    </div>
                </div>

                <div class="flex items-center gap-3">
                    <div class="w-7 h-7 rounded-full bg-amber-100 text-amber-700 border border-amber-300 flex items-center justify-center text-xs font-bold animate-pulse shrink-0">
                        ●
                    </div>
                    <div class="flex-1 text-xs">
                        <span class="font-bold text-amber-800">مطابقة السجل التجاري ورخصة JCCA</span>
                        <p class="text-[11px] text-slate-500">جاري التدقيق من قبل فريق الإشراف الهندسي</p>
                    </div>
                </div>

                <div class="flex items-center gap-3 opacity-60">
                    <div class="w-7 h-7 rounded-full bg-slate-200 text-slate-500 border border-slate-300 flex items-center justify-center text-xs font-mono shrink-0">
                        3
                    </div>
                    <div class="flex-1 text-xs">
                        <span class="font-bold text-slate-600">فتح سقف التسهيلات والتمويل بالمرابحة</span>
                        <p class="text-[11px] text-slate-400">تفعيل سقف التسهيلات وتوريد المواد بأسعار الجملة</p>
                    </div>
                </div>
            </div>

            <!-- CTAs -->
            <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
                <a asp-action="Workspace" class="w-full sm:w-auto px-6 py-3 bg-[#E8A020] hover:bg-amber-600 text-slate-950 font-black text-xs rounded-xl shadow-md transition-all flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-sm">dashboard</span>
                    <span>الذهاب إلى مجمع أعمال المقاول</span>
                </a>
                <a href="https://wa.me/962790000000" target="_blank" class="w-full sm:w-auto px-6 py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl border border-slate-200 transition-all flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-sm">support_agent</span>
                    <span>تواصل مع الدعم الفني</span>
                </a>
            </div>
        </div>

    </div>
</div>
