@model Bolcko.Domain.Entities.User.User
@{
    ViewData["Title"] = "مجمع أعمال المقاولين المعتمدين (Contractor Workspace)";
    Layout = "~/Areas/Shop/Views/Shared/_Layout.cshtml";
    var isArabic = System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("ar");
    bool isNew = ViewBag.IsNewRegistration == true;
    var user = Model;
    var financingDashboard = ViewBag.FinancingDashboard as Bolcko.Domain.Entities.Financing.DTOs.ContractorDashboardDto;
}

<div class="min-h-screen bg-slate-50/50 py-8 px-4 sm:px-6 lg:px-8 text-right" dir="rtl">
    <div class="max-w-7xl mx-auto space-y-8">

        @if (isNew)
        {
            <div class="p-4 bg-emerald-50 border border-emerald-200 rounded-2xl flex items-center justify-between shadow-2xs animate-fade-in">
                <div class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-emerald-600 text-2xl">check_circle</span>
                    <div>
                        <p class="text-sm font-bold text-emerald-900">تم تسجيل حساب المنشأة بنجاح ومطابقة السجل التجاري الأردني!</p>
                        <p class="text-xs text-emerald-700">مرحباً بك في مجمع أعمال المقاولين المعتمدين في منصة Block-O.</p>
                    </div>
                </div>
                <span class="px-3 py-1 rounded-full bg-emerald-200/60 text-emerald-800 text-xs font-bold font-mono">KYC Verified</span>
            </div>
        }

        <!-- 1. Header Partial -->
        <partial name="~/Areas/Shop/Views/Contractor/Partials/_ContractorHeader.cshtml" model="user" />

        <!-- 2. Stats Grid Partial -->
        <partial name="~/Areas/Shop/Views/Contractor/Partials/_ContractorStatsGrid.cshtml" model="financingDashboard" />

        <!-- 3. Main Workspace Hub Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            
            <!-- Left 2 Cols: Services & Tools -->
            <div class="lg:col-span-2 space-y-6">
                
                <!-- B2B Wholesale Materials Partial -->
                <partial name="~/Areas/Shop/Views/Contractor/Partials/_ContractorWholesaleCatalog.cshtml" />

                <!-- BOQ & RFQ Engine Card -->
                <div class="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm space-y-4">
                    <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-indigo-600">request_quote</span>
                            <h2 class="text-base font-bold text-slate-900">محرك تصدير جدول الكميات (Smart BOQ) وطلب عروض الأسعار (RFQ)</h2>
                        </div>
                        <span class="px-2.5 py-0.5 rounded-full bg-indigo-50 text-indigo-700 text-[10px] font-bold font-mono">Multi-Vendor RFQ</span>
                    </div>

                    <p class="text-xs text-slate-600 leading-relaxed">
                        قم بتصدير جدول الكميات (BOQ) الناتج من الحاسبة الهندسية الذكية وارسله فوراً لشبكة الموردين والمصانع المعتمدة لتلقي عروض أسعار تنافسية ومقارنتها بنقرة واحدة.
                    </p>

                    <div class="flex flex-wrap items-center gap-3 pt-1">
                        <a href="@Url.Action("Index", "Calculator", new { area = "Shop" })" class="px-4 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs transition flex items-center gap-2 shadow-sm">
                            <span class="material-symbols-outlined text-sm">calculate</span>
                            <span>فتح حاسبة البناء الهندسية</span>
                        </a>
                        <a href="@Url.Action("Index", "Quote", new { area = "Shop" })" class="px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs transition flex items-center gap-2 border border-slate-200">
                            <span class="material-symbols-outlined text-sm text-indigo-600">compare_arrows</span>
                            <span>مقارنة عروض أسعار الموردين</span>
                        </a>
                    </div>
                </div>

                <!-- Islamic Murabaha Financing Summary Partial -->
                <partial name="~/Areas/Shop/Views/Contractor/Partials/_ContractorFinancingSummary.cshtml" model="financingDashboard" />

            </div>

            <!-- Right Col: KYC & Logistics Widgets -->
            <div class="space-y-6">
                
                <!-- KYC Status Card Partial -->
                <partial name="~/Areas/Shop/Views/Contractor/Partials/_ContractorKycCard.cshtml" model="user" />

                <!-- Live Logistics Dispatch Widget Partial -->
                <partial name="~/Areas/Shop/Views/Contractor/Partials/_ContractorLiveLogistics.cshtml" />

            </div>

        </div>

    </div>
</div>
