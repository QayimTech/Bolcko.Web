@using Bolcko.Domain.Entities.ShoppingCart.DTOs
@{
    var cart = ViewBag.Cart as ShoppingCartDto;
}

<div class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 shadow-sm space-y-6 sticky top-24">
    <div class="flex items-center gap-3 pb-4 border-b border-slate-100">
        <div class="w-10 h-10 rounded-2xl bg-amber-50 text-[#E8A020] flex items-center justify-center font-bold">
            <span class="material-symbols-outlined text-xl">receipt_long</span>
        </div>
        <div>
            <h2 class="text-lg font-black text-slate-900">ملخص الطلب ومصاريف النقل</h2>
            <p class="text-slate-400 text-xs font-medium">@(cart?.TotalItems ?? 0) أصناف في سلة الشراء</p>
        </div>
    </div>

    <!-- Items Scrollable List -->
    @if (cart != null && cart.Items.Any())
    {
        <div class="max-h-64 overflow-y-auto space-y-3 pe-1 divide-y divide-slate-100">
            @foreach (var item in cart.Items)
            {
                <div class="flex items-center gap-3 pt-3 first:pt-0">
                    <div class="w-12 h-12 rounded-xl bg-slate-100 border border-slate-200 overflow-hidden shrink-0 flex items-center justify-center">
                        @if (!string.IsNullOrEmpty(item.ProductImage))
                        {
                            <img src="@item.ProductImage" alt="@item.ProductName" class="w-full h-full object-cover" />
                        }
                        else
                        {
                            <span class="material-symbols-outlined text-slate-400">inventory_2</span>
                        }
                    </div>
                    <div class="flex-grow min-w-0">
                        <h4 class="text-xs font-bold text-slate-900 truncate">@item.ProductName</h4>
                        <div class="text-[11px] text-slate-500 flex items-center gap-2 mt-0.5">
                            <span>الكمية: <strong>@item.Quantity</strong></span>
                            <span>×</span>
                            <span>@item.UnitPrice.ToString("N2") د.أ</span>
                        </div>
                    </div>
                    <div class="text-xs font-black text-slate-900 shrink-0">
                        @item.TotalPrice.ToString("N2") <span class="text-[10px] text-slate-400 font-normal">د.أ</span>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Financial Breakdown -->
    <div class="space-y-3 pt-4 border-t border-slate-100 text-xs">
        <div class="flex items-center justify-between text-slate-600">
            <span>مجموع المنتجات:</span>
            <span class="font-bold text-slate-900" id="summary-subtotal">@(cart?.Subtotal.ToString("N2") ?? "0.00") د.أ</span>
        </div>

        <div class="flex items-center justify-between text-slate-600">
            <span class="flex items-center gap-1">
                <span>أجور النقل والتفريغ حسب المسافة (شحن ثقيل مباشر):</span>
                <span class="material-symbols-outlined text-xs text-amber-500" title="محسوبة وفق المسافة الجغرافية والمسار اللوجستي">info</span>
            </span>
            <span class="font-bold text-amber-600" id="summary-shipping">@(cart?.Shipping.ToString("N2") ?? "2.50") د.أ</span>
        </div>

        @if (cart != null && cart.Tax > 0)
        {
            <div class="flex items-center justify-between text-slate-600">
                <span>ضريبة المبيعات (16%):</span>
                <span class="font-bold text-slate-900" id="summary-tax">@cart.Tax.ToString("N2") د.أ</span>
            </div>
        }

        <div class="flex items-center justify-between text-sm sm:text-base font-black text-slate-950 pt-3 border-t border-slate-200">
            <span>المجموع الإجمالي:</span>
            <span class="text-[#E8A020] text-lg font-black" id="summary-grandtotal">@(cart?.Total.ToString("N2") ?? "0.00") د.أ</span>
        </div>
    </div>

    <!-- Submit Button -->
    <button type="submit" form="checkoutForm" id="btnPlaceOrder" class="w-full py-4 px-6 rounded-2xl bg-gradient-to-r from-[#E8A020] to-amber-500 hover:from-amber-500 hover:to-amber-600 text-slate-950 font-black text-sm shadow-xl shadow-amber-500/20 hover:shadow-amber-500/30 transition-all transform hover:-translate-y-0.5 active:translate-y-0 flex items-center justify-center gap-2">
        <span class="material-symbols-outlined text-xl">lock</span>
        <span>تأكيد الطلب وإصدار بيان الحمولة</span>
    </button>

    <!-- Trust Badges -->
    <div class="grid grid-cols-2 gap-2 text-center pt-2">
        <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-200/80 text-[10px] font-bold text-slate-600 flex items-center justify-center gap-1">
            <span class="material-symbols-outlined text-xs text-emerald-600">verified</span>
            <span>مطابق للمواصفات الأردنية</span>
        </div>
        <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-200/80 text-[10px] font-bold text-slate-600 flex items-center justify-center gap-1">
            <span class="material-symbols-outlined text-xs text-amber-600">scale</span>
            <span>فحص قبان إلكتروني موثق</span>
        </div>
    </div>
</div>
