@model Bolcko.Domain.Entities.Order.DTOs.CheckoutDto

<div class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 shadow-sm space-y-6">
    <div class="flex items-center gap-3 pb-4 border-b border-slate-100">
        <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold">
            <span class="material-symbols-outlined text-xl">domain</span>
        </div>
        <div>
            <h2 class="text-lg font-black text-slate-900">@SharedLocalizer["ProjectInfo"]</h2>
            <p class="text-slate-400 text-xs font-medium">@SharedLocalizer["ProjectInfoDesc"]</p>
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div class="space-y-1.5">
            <label class="block text-xs font-black text-slate-700">@SharedLocalizer["ProjectName"]</label>
            <input asp-for="ProjectName" class="w-full bg-slate-50 border border-slate-200 rounded-2xl px-4 py-3 text-xs font-bold text-slate-900 focus:border-[#E8A020] focus:bg-white focus:ring-2 focus:ring-[#E8A020]/20 outline-none transition-all" type="text" placeholder="@SharedLocalizer["ProjectNamePlaceholder"]" />
        </div>

        <div class="space-y-1.5">
            <label class="block text-xs font-black text-slate-700">@SharedLocalizer["ProjectType"]</label>
            <select asp-for="ProjectType" class="w-full bg-slate-50 border border-slate-200 rounded-2xl px-4 py-3 text-xs font-bold text-slate-900 focus:border-[#E8A020] focus:bg-white focus:ring-2 focus:ring-[#E8A020]/20 outline-none transition-all">
                <option value="سكني">@SharedLocalizer["ProjectTypeResidential"]</option>
                <option value="تجاري">@SharedLocalizer["ProjectTypeCommercial"]</option>
                <option value="صناعي">@SharedLocalizer["ProjectTypeIndustrial"]</option>
                <option value="بنية تحتية">مشاريع بنية تحتية وطرق</option>
            </select>
        </div>

        <div class="sm:col-span-2 space-y-1.5">
            <label class="block text-xs font-black text-slate-700">@SharedLocalizer["DeliveryNotes"]</label>
            <textarea asp-for="Notes" rows="2" class="w-full bg-slate-50 border border-slate-200 rounded-2xl p-4 text-xs font-bold text-slate-900 focus:border-[#E8A020] focus:bg-white focus:ring-2 focus:ring-[#E8A020]/20 outline-none transition-all" placeholder="@SharedLocalizer["DeliveryNotesPlaceholder"]"></textarea>
        </div>
    </div>
</div>
