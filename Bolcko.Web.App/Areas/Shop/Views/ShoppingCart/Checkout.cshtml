@model Bolcko.Domain.Entities.Order.DTOs.CheckoutDto
@using Bolcko.Web.App.Extensions
<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 text-start font-sans">
    
    <!-- Step Progress Header -->
    <div class="mb-8 bg-white border border-slate-200 rounded-3xl p-6 shadow-sm">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
                <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-amber-50 border border-amber-200 text-amber-900 rounded-full text-xs font-black mb-2">
                    <span class="material-symbols-outlined text-sm text-[#E8A020]">verified_user</span>
                    <span>@SharedLocalizer["SecureCheckout"]</span>
                </span>
                <h1 class="text-2xl sm:text-3xl font-black text-slate-900">@SharedLocalizer["CheckoutTitle"]</h1>
                <p class="text-slate-500 text-xs sm:text-sm mt-1">@SharedLocalizer["CheckoutSubtitle"]</p>
            </div>
            
            <!-- Step Indicators -->
            <div class="flex items-center gap-2 text-xs font-bold text-slate-400 border-t md:border-t-0 pt-3 md:pt-0">
                <span class="flex items-center gap-1 text-slate-900 font-black">
                    <span class="w-6 h-6 rounded-full bg-slate-900 text-white flex items-center justify-center text-xs">1</span>
                    @SharedLocalizer["StepCart"]
                </span>
                <span class="material-symbols-outlined text-sm text-slate-300 rtl:rotate-180">chevron_right</span>
                <span class="flex items-center gap-1 text-[#E8A020] font-black">
                    <span class="w-6 h-6 rounded-full bg-[#E8A020] text-slate-950 flex items-center justify-center text-xs">2</span>
                    @SharedLocalizer["StepShipping"]
                </span>
                <span class="material-symbols-outlined text-sm text-slate-300 rtl:rotate-180">chevron_right</span>
                <span class="flex items-center gap-1">
                    <span class="w-6 h-6 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center text-xs">3</span>
                    @SharedLocalizer["StepConfirm"]
                </span>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <!-- Main Form Column -->
        <div class="lg:col-span-8 space-y-6">
            <form id="checkoutForm" asp-action="PlaceOrder" asp-controller="ShoppingCart" method="post" class="space-y-6">
                
                <!-- 1. Customer Personal Information Card -->
                <div class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 shadow-sm space-y-6">
                    <div class="flex items-center gap-3 pb-4 border-b border-slate-100">
                        <div class="w-10 h-10 rounded-2xl bg-amber-50 text-[#E8A020] flex items-center justify-center font-bold">
                            <span class="material-symbols-outlined text-xl">person</span>
                        </div>
                        <div>
                            <h2 class="text-lg font-black text-slate-900">@SharedLocalizer["BuyerInfo"]</h2>
                            <p class="text-slate-400 text-xs font-medium">@SharedLocalizer["BuyerInfoDesc"]</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                        <div class="space-y-1.5">
                            <label class="block text-xs font-black text-slate-700">@SharedLocalizer["FullName"] <span class="text-rose-500">*</span></label>
                            <div class="relative">
                                <input asp-for="FullName" class="w-full bg-slate-50 border border-slate-200 rounded-2xl pe-10 ps-4 py-3 text-xs font-bold text-slate-900 focus:border-[#E8A020] focus:bg-white focus:ring-2 focus:ring-[#E8A020]/20 outline-none transition-all" placeholder="@SharedLocalizer["EnterFullName"]" />
                                <span class="material-symbols-outlined absolute end-3 top-3 text-slate-400 text-lg pointer-events-none">badge</span>
                            </div>
                            <span asp-validation-for="FullName" class="text-rose-500 text-xs font-bold block"></span>
                        </div>

                        <div class="space-y-1.5">
                            <label class="block text-xs font-black text-slate-700">@SharedLocalizer["Phone"] <span class="text-rose-500">*</span></label>
                            <div class="relative">
                                <input asp-for="Phone" class="w-full bg-slate-50 border border-slate-200 rounded-2xl ps-10 pe-4 py-3 text-xs font-bold text-slate-900 focus:border-[#E8A020] focus:bg-white focus:ring-2 focus:ring-[#E8A020]/20 outline-none transition-all text-start" dir="ltr" type="tel" placeholder="07xxxxxxxx" />
                                <span class="material-symbols-outlined absolute start-3 top-3 text-slate-400 text-lg pointer-events-none">call</span>
                            </div>
                            <span asp-validation-for="Phone" class="text-rose-500 text-xs font-bold block"></span>
                        </div>

                        <div class="sm:col-span-2 space-y-1.5">
                            <label class="block text-xs font-black text-slate-700">@SharedLocalizer["Email"] <span class="text-slate-400 font-normal">@SharedLocalizer["OptionalInvoice"]</span></label>
                            <div class="relative">
                                <input asp-for="Email" class="w-full bg-slate-50 border border-slate-200 rounded-2xl ps-10 pe-4 py-3 text-xs font-bold text-slate-900 focus:border-[#E8A020] focus:bg-white focus:ring-2 focus:ring-[#E8A020]/20 outline-none transition-all text-start" dir="ltr" type="email" placeholder="name@example.com" />
                                <span class="material-symbols-outlined absolute start-3 top-3 text-slate-400 text-lg pointer-events-none">mail</span>
                            </div>
                            <span asp-validation-for="Email" class="text-rose-500 text-xs font-bold block"></span>
                        </div>
                    </div>
                </div>

                <!-- 2. Shipping Address & Interactive Location Card -->
                <div class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 shadow-sm space-y-6">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-slate-100">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center font-bold">
                                <span class="material-symbols-outlined text-xl">location_on</span>
                            </div>
                            <div>
                                <h2 class="text-lg font-black text-slate-900">@SharedLocalizer["ShippingAddress"]</h2>
                                <p class="text-slate-400 text-xs font-medium">@SharedLocalizer["ShippingAddressDesc"]</p>
                            </div>
                        </div>

                        <!-- GPS Button -->
                        <button type="button" onclick="getCurrentGpsLocation()" class="bg-slate-900 hover:bg-slate-800 text-white font-black text-xs px-4 py-2.5 rounded-2xl transition-all shadow-sm flex items-center gap-2 active:scale-95 shrink-0 border border-slate-700">
                            <span class="material-symbols-outlined text-base text-[#E8A020]">my_location</span>
                            <span>@SharedLocalizer["GPSButton"]</span>
                        </button>
                    </div>

                    <!-- GPS Live Notification Status -->
                    <div id="gpsStatusMessage" class="hidden p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-bold flex items-center gap-2 transition-all">
                        <span class="material-symbols-outlined text-lg text-emerald-600">near_me</span>
                        <span id="gpsCoordsText">@SharedLocalizer["GPSStatusWait"]</span>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                        <div class="space-y-1.5">
                            <label class="block text-xs font-black text-slate-700">@SharedLocalizer["City"] <span class="text-rose-500">*</span></label>
                            <select asp-for="City" id="checkout-city-select" class="w-full bg-slate-50 border border-slate-200 rounded-2xl px-4 py-3 text-xs font-bold text-slate-900 focus:border-[#E8A020] focus:bg-white focus:ring-2 focus:ring-[#E8A020]/20 outline-none transition-all">
                                @if (ViewBag.ShippingRates != null)
                                {
                                    bool isEnglish = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("en");
                                    foreach (var rate in (IEnumerable<Bolcko.Domain.Entities.Setting.ShippingRate>)ViewBag.ShippingRates)
                                    {
                                        string displayName = isEnglish && !string.IsNullOrWhiteSpace(rate.CityNameEn) ? rate.CityNameEn : rate.CityName;
                                        <option value="@rate.CityName" data-rate="@rate.Rate.ToString("F2")">@displayName (@rate.Rate.ToString("N2") @SharedLocalizer["JordanDinarShort"] @SharedLocalizer["CityDelivery"])</option>
                                    }
                                }
                                else
                                {
                                    <option value="عمان" data-rate="3.00">عمان (3.00 @SharedLocalizer["JordanDinarShort"])</option>
                                    <option value="الزرقاء" data-rate="4.00">الزرقاء (4.00 @SharedLocalizer["JordanDinarShort"])</option>
                                    <option value="إربد" data-rate="5.00">إربد (5.00 @SharedLocalizer["JordanDinarShort"])</option>
                                }
                            </select>
                        </div>

                        <div class="space-y-1.5">
                            <label class="block text-xs font-black text-slate-700">@SharedLocalizer["Area"]  <span class="text-rose-500">*</span></label>
                            <input asp-for="Area" class="w-full bg-slate-50 border border-slate-200 rounded-2xl px-4 py-3 text-xs font-bold text-slate-900 focus:border-[#E8A020] focus:bg-white focus:ring-2 focus:ring-[#E8A020]/20 outline-none transition-all" type="text" placeholder="@SharedLocalizer["AreaPlaceholder"]" />
                            <span asp-validation-for="Area" class="text-rose-500 text-xs font-bold block"></span>
                        </div>

                        <div class="sm:col-span-2 space-y-1.5">
                            <label class="block text-xs font-black text-slate-700">@SharedLocalizer["DetailedAddress"] <span class="text-rose-500">*</span></label>
                            <textarea asp-for="DetailedAddress" id="detailedAddressTextarea" rows="3" class="w-full bg-slate-50 border border-slate-200 rounded-2xl p-4 text-xs font-bold text-slate-900 focus:border-[#E8A020] focus:bg-white focus:ring-2 focus:ring-[#E8A020]/20 outline-none transition-all leading-relaxed" placeholder="@SharedLocalizer["DetailedAddressPlaceholder"]"></textarea>
                            <span asp-validation-for="DetailedAddress" class="text-rose-500 text-xs font-bold block"></span>
                            
                            <!-- Hidden Coordinates -->
                            <input type="hidden" asp-for="Latitude" id="gpsLatitude" />
                            <input type="hidden" asp-for="Longitude" id="gpsLongitude" />
                        </div>

                        <div class="space-y-1.5">
                            <label class="block text-xs font-black text-slate-700">@SharedLocalizer["Country"]</label>
                            <input asp-for="Country" value="@SharedLocalizer["JordanCountry"]" readonly class="w-full bg-slate-100 border border-slate-200 rounded-2xl px-4 py-3 text-xs font-bold text-slate-500 outline-none cursor-not-allowed" />
                        </div>

                        <div class="space-y-1.5">
                            <label class="block text-xs font-black text-slate-700">@SharedLocalizer["PostalCode"] <span class="text-slate-400 font-normal">@SharedLocalizer["OptionalHint"]</span></label>
                            <input asp-for="PostalCode" class="w-full bg-slate-50 border border-slate-200 rounded-2xl px-4 py-3 text-xs font-bold text-slate-900 focus:border-[#E8A020] focus:bg-white focus:ring-2 focus:ring-[#E8A020]/20 outline-none transition-all" type="text" placeholder="11111" />
                        </div>
                    </div>
                </div>

                @if (ViewBag.EnableExpressDelivery == true)
                {
                    <!-- Express Delivery Option -->
                    <div class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 shadow-sm space-y-6">
                        <div class="flex items-center justify-between pb-4 border-b border-slate-100">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-2xl bg-amber-50 text-[#E8A020] flex items-center justify-center font-bold">
                                    <span class="material-symbols-outlined text-xl">bolt</span>
                                </div>
                                <div>
                                    <h2 class="text-lg font-black text-slate-900">توصيل فوري (Express Delivery)</h2>
                                    <p class="text-slate-400 text-xs font-medium">احصل على طلبيتك بشكل أسرع</p>
                                </div>
                            </div>
                        </div>

                        <div class="relative border border-slate-200 rounded-2xl p-4 bg-slate-50 flex items-center gap-4 cursor-pointer hover:border-[#E8A020] hover:bg-amber-50/20 transition-all">
                            <input asp-for="IsExpressDelivery" type="checkbox" class="w-5 h-5 text-[#E8A020] focus:ring-[#E8A020] rounded border-slate-300" id="isExpressDelivery" />
                            <label for="isExpressDelivery" class="font-black text-slate-900 flex-grow cursor-pointer text-sm">
                                أريد توصيل فوري
                                <span class="block text-xs font-bold text-slate-500 mt-0.5">يضاف رسوم توصيل فوري بقيمة @(ViewBag.ExpressDeliveryFee) دينار</span>
                            </label>
                        </div>
                    </div>
                }

                <!-- 3. Optional Project Info -->
                <div class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 shadow-sm space-y-6">
                    <div class="flex items-center gap-3 pb-4 border-b border-slate-100">
                        <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold">
                            <span class="material-symbols-outlined text-xl">domain</span>
                        </div>
                        <div>
                            <h2 class="text-lg font-black text-slate-900">@SharedLocalizer["ProjectInfo"]</h2>
                            <p class="text-slate-400 text-xs font-medium">@SharedLocalizer["ProjectInfoDesc"]</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                        <div class="space-y-1.5">
                            <label class="block text-xs font-black text-slate-700">@SharedLocalizer["ProjectName"]</label>
                            <input asp-for="ProjectName" class="w-full bg-slate-50 border border-slate-200 rounded-2xl px-4 py-3 text-xs font-bold text-slate-900 focus:border-[#E8A020] focus:bg-white focus:ring-2 focus:ring-[#E8A020]/20 outline-none transition-all" type="text" placeholder="@SharedLocalizer["ProjectNamePlaceholder"]" />
                        </div>

                        <div class="space-y-1.5">
                            <label class="block text-xs font-black text-slate-700">@SharedLocalizer["ProjectType"]</label>
                            <select asp-for="ProjectType" class="w-full bg-slate-50 border border-slate-200 rounded-2xl px-4 py-3 text-xs font-bold text-slate-900 focus:border-[#E8A020] focus:bg-white focus:ring-2 focus:ring-[#E8A020]/20 outline-none transition-all">
                                <option value="سكني">@SharedLocalizer["ProjectTypeResidential"]</option>
                                <option value="تجاري">@SharedLocalizer["ProjectTypeCommercial"]</option>
                                <option value="صناعي">@SharedLocalizer["ProjectTypeIndustrial"]</option>
                            </select>
                        </div>

                        <div class="sm:col-span-2 space-y-1.5">
                            <label class="block text-xs font-black text-slate-700">@SharedLocalizer["DeliveryNotes"]</label>
                            <textarea asp-for="Notes" rows="2" class="w-full bg-slate-50 border border-slate-200 rounded-2xl p-4 text-xs font-bold text-slate-900 focus:border-[#E8A020] focus:bg-white focus:ring-2 focus:ring-[#E8A020]/20 outline-none transition-all" placeholder="@SharedLocalizer["DeliveryNotesPlaceholder"]"></textarea>
                        </div>
                    </div>
                </div>

                <!-- 4. Payment Method Options -->
                <div class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 shadow-sm space-y-6">
                    <div class="flex items-center gap-3 pb-4 border-b border-slate-100">
                        <div class="w-10 h-10 rounded-2xl bg-amber-50 text-[#E8A020] flex items-center justify-center font-bold">
                            <span class="material-symbols-outlined text-xl">payments</span>
                        </div>
                        <div>
                            <h2 class="text-lg font-black text-slate-900">@SharedLocalizer["PaymentMethodTitle"]</h2>
                            <p class="text-slate-400 text-xs font-medium">@SharedLocalizer["PaymentMethodDesc"]</p>
                        </div>
                    </div>

                    <div class="relative border-2 border-[#E8A020] rounded-2xl p-5 bg-amber-50/40 flex items-center gap-4 cursor-pointer">
                        <input asp-for="PaymentMethod" type="radio" value="COD" checked class="w-5 h-5 text-[#E8A020] focus:ring-[#E8A020]" id="cod" />
                        <label for="cod" class="font-black text-slate-900 flex-grow cursor-pointer text-sm">
                            @SharedLocalizer["CODTitle"]
                            <span class="block text-xs font-bold text-slate-500 mt-0.5">@SharedLocalizer["CODDesc"]</span>
                        </label>
                        <div class="w-12 h-12 rounded-2xl bg-white border border-amber-200 text-[#E8A020] flex items-center justify-center shrink-0">
                            <span class="material-symbols-outlined text-2xl">local_atm</span>
                        </div>
                    </div>
                </div>
            </form>
        </div>

        <!-- Sidebar Sticky Order Summary -->
        <div class="lg:col-span-4">
            <div class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 shadow-md sticky top-24 space-y-6">
                <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                    <h2 class="text-lg font-black text-slate-900 flex items-center gap-2">
                        <span class="material-symbols-outlined text-[#E8A020]">shopping_bag</span>
                        <span>@SharedLocalizer["OrderSummaryTitle"]</span>
                    </h2>
                </div>

                <!-- Cart Items List with Images & Quantities -->
                @if (ViewBag.Cart != null)
                {
                    var cart = (Bolcko.Domain.Entities.ShoppingCart.DTOs.ShoppingCartDto)ViewBag.Cart;
                    <div class="space-y-4 max-h-80 overflow-y-auto pe-">
                        @foreach (var item in cart.Items)
                        {
                            var itemImgSrc = item.ProductImage.ToImageUrl();
                            <div class="flex items-center gap-3 p-3 rounded-2xl bg-slate-50 border border-slate-100">
                                @if (itemImgSrc != null)
                                {
                                    <img class="w-14 h-14 object-cover rounded-xl border border-slate-200 shrink-0" src="@itemImgSrc" alt="@item.ProductName" />
                                }
                                else
                                {
                                    <div class="w-14 h-14 rounded-xl bg-slate-200 text-slate-400 flex items-center justify-center shrink-0">
                                        <span class="material-symbols-outlined text-xl">inventory_2</span>
                                    </div>
                                }
                                <div class="flex-grow min-w-0">
                                    <h4 class="font-black text-xs text-slate-900 truncate">@item.ProductName</h4>
                                    <p class="text-[11px] font-bold text-slate-500 mt-0.5">@SharedLocalizer["QuantityPrefix"] @item.Quantity @SharedLocalizer["PieceSuffix"]</p>
                                    <p class="font-black text-xs text-[#E8A020] mt-0.5">@item.TotalPrice.ToString("N2") @SharedLocalizer["JordanDinarShort"]</p>
                                </div>
                            </div>
                        }
                    </div>
                    
                    <div class="space-y-3 pt-4 border-t border-slate-100 text-xs font-bold text-slate-600">
                        <div class="flex justify-between items-center">
                            <span>@SharedLocalizer["Subtotal"]:</span>
                            <span class="text-slate-900 font-black"><span id="checkout-subtotal-val">@cart.Subtotal.ToString("F2")</span> @SharedLocalizer["JordanDinarShort"]</span>
                        </div>
                        <div class="flex justify-between items-center">
                            <span>@SharedLocalizer["EstimatedShipping"]:</span>
                            <span class="text-indigo-600 font-black"><span id="checkout-shipping-val">@cart.Shipping.ToString("F2")</span> @SharedLocalizer["JordanDinarShort"]</span>
                        </div>
                        <div class="flex justify-between items-center hidden" id="express-delivery-row">
                            <span>رسوم توصيل فوري:</span>
                            <span class="text-rose-600 font-black">+<span id="checkout-express-fee-val">0.00</span> @SharedLocalizer["JordanDinarShort"]</span>
                        </div>

                        <div class="flex justify-between items-center text-sm pt-3 border-t border-slate-200 font-black text-slate-900">
                            <span class="text-base">@SharedLocalizer["Total"]:</span>
                            <span class="text-xl font-black text-[#E8A020]"><span id="checkout-total-val">@cart.Total.ToString("F2")</span> @SharedLocalizer["JordanDinarShort"]</span>
                        </div>
                    </div>
                }

                <button type="submit" form="checkoutForm" class="w-full bg-gradient-to-r from-[#E8A020] to-amber-500 hover:from-amber-500 hover:to-amber-600 text-slate-950 font-black py-4 px-6 rounded-full flex items-center justify-center gap-3 transition-all shadow-xl shadow-amber-500/20 active:scale-95 text-base cursor-pointer">
                    <span>@SharedLocalizer["SubmitOrderBtn"]</span>
                    <span class="material-symbols-outlined text-xl rtl:rotate-180">arrow_forward</span>
                </button>
                
                <p class="text-[11px] text-slate-400 text-center leading-relaxed font-medium">
                    @SharedLocalizer["SubmitTerms"]
                </p>
            </div>
        </div>
    </div>
</main>

<script>
    function getCurrentGpsLocation() {
        if (navigator.geolocation) {
            const statusMsg = document.getElementById('gpsStatusMessage');
            const coordsText = document.getElementById('gpsCoordsText');
            statusMsg.classList.remove('hidden');
            statusMsg.className = 'p-4 rounded-2xl bg-amber-50 border border-amber-200 text-amber-900 text-xs font-bold flex items-center gap-2 transition-all mb-4';
            coordsText.innerText = 'جاري تحديد موقعك الجغرافي الدقيق عبر الـ GPS... 📡';

            navigator.geolocation.getCurrentPosition(
                (position) => {
                    const lat = position.coords.latitude;
                    const lng = position.coords.longitude;
                    document.getElementById('gpsLatitude').value = lat;
                    document.getElementById('gpsLongitude').value = lng;
                    
                    statusMsg.className = 'p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-bold flex items-center gap-2 transition-all mb-4';
                    coordsText.innerText = `تم التقاط إحداثيات موقعك بنجاح! 📍 (${lat.toFixed(4)}, ${lng.toFixed(4)})`;
                    
                    // Auto populate detailed address input with maps link
                    const addrInput = document.getElementById('detailedAddressTextarea');
                    if (addrInput) {
                        const mapsUrl = `https://maps.google.com/?q=${lat},${lng}`;
                        if (!addrInput.value.includes('maps.google.com')) {
                            addrInput.value = (addrInput.value ? addrInput.value + '\n' : '') + `[رابط خريطة موقعي GPS: ${mapsUrl}]`;
                        }
                    }
                },
                (error) => {
                    statusMsg.className = 'p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-bold flex items-center gap-2 transition-all mb-4';
                    coordsText.innerText = 'تعذر الوصول للـ GPS تلقائياً. يرجى التأكد من السماح للمتصفح أو كتابة العنوان تفصيلياً.';
                },
                { enableHighAccuracy: true, timeout: 10000 }
            );
        } else {
            alert('المتصفح لا يدعم تحديد الموقع الجغرافي.');
        }
    }
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function () {
            var expressDeliveryFee = @(ViewBag.ExpressDeliveryFee ?? "0.00");
            var shippingFeeUrl = '@Url.Action("GetShippingFee", "ShoppingCart", new { area = "Shop" })';

            function calculateTotal() {
                var selectedOption = $('#checkout-city-select').find('option:selected');
                var rate = parseFloat(selectedOption.data('rate')) || 0.0;
                var subtotal = parseFloat($('#checkout-subtotal-val').text()) || 0.0;
                var tax = subtotal * 0.15;

                $('#checkout-shipping-val').text(rate.toFixed(2));

                var total = subtotal + tax + rate;

                // Add Express Delivery fee if checked
                if ($('#isExpressDelivery').is(':checked')) {
                    $('#express-delivery-row').removeClass('hidden').addClass('flex');
                    $('#checkout-express-fee-val').text(expressDeliveryFee.toFixed(2));
                    total += expressDeliveryFee;
                } else {
                    $('#express-delivery-row').addClass('hidden').removeClass('flex');
                }

                $('#checkout-total-val').text(total.toFixed(2));
            }

            // Fetches the real shipping fee for the selected city (same lookup PlaceOrder uses)
            // so the on-screen total matches what will actually be saved on the order.
            function updateShippingFeeFromServer() {
                var selectedOption = $('#checkout-city-select').find('option:selected');
                var city = selectedOption.val();

                if (!city) {
                    calculateTotal();
                    return;
                }

                $.ajax({
                    url: shippingFeeUrl,
                    method: 'GET',
                    data: { city: city },
                    dataType: 'json'
                }).done(function (response) {
                    if (response && response.success && typeof response.rate !== 'undefined') {
                        selectedOption.data('rate', response.rate);
                    } else {
                        console.warn('GetShippingFee: unexpected response, falling back to listed rate.');
                    }
                }).fail(function () {
                    console.warn('GetShippingFee: request failed, falling back to listed rate.');
                }).always(function () {
                    calculateTotal();
                });
            }

            $('#checkout-city-select').on('change', updateShippingFeeFromServer);
            $('#isExpressDelivery').on('change', calculateTotal);
        });
    </script>
}