@model Bolcko.Domain.Entities.Order.DTOs.OrderDto
@{
    ViewData["Title"] = SharedLocalizer["OrderConfirmed"];
}
<main class="max-w-3xl mx-auto px-4 md:px-6 py-16 md:py-24 text-center" dir="auto">
    <div class="bg-white border border-slate-100 rounded-[2rem] p-8 md:p-14 shadow-2xl shadow-slate-200/50 relative overflow-hidden">
        
        <!-- Subtle Background Glow -->
        <div class="absolute top-0 start-/2 -translate-x-1/2 w-64 h-64 bg-emerald-400/10 blur-[60px] rounded-full pointer-events-none"></div>

        <div class="relative z-10">
            <div class="w-24 h-24 bg-gradient-to-br from-emerald-400 to-emerald-600 text-white rounded-full flex items-center justify-center mx-auto mb-8 shadow-lg shadow-emerald-500/30 transform transition-transform hover:scale-105 duration-300">
                <span class="material-symbols-outlined text-5xl font-black">done</span>
            </div>
            
            <h1 class="font-black text-3xl md:text-4xl text-slate-900 mb-4 tracking-tight">@SharedLocalizer["OrderConfirmed"]</h1>
            
            <div class="inline-flex items-center gap-2 text-sm font-bold text-slate-600 mb-10 bg-slate-50 px-5 py-2.5 rounded-full border border-slate-200 shadow-sm">
                <span class="material-symbols-outlined text-slate-400 text-lg">receipt_long</span>
                <span class="font-mono">@string.Format(SharedLocalizer["YourOrderNumberIs"].Value, Model?.OrderNumber)</span>
            </div>
            
            @if(Model?.Items != null && Model.Items.Any())
            {
                <div class="bg-slate-50 border border-slate-100 rounded-3xl p-6 md:p-8 mb-8 text-start">
                    <div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-200">
                        <h4 class="font-black text-slate-800 flex items-center gap-2">
                            <span class="material-symbols-outlined text-[#E8A020]">shopping_bag</span>
                            @SharedLocalizer["OrderDetails"]
                        </h4>
                        <span class="text-sm font-bold text-emerald-600 bg-emerald-50 px-3 py-1 rounded-lg">
                            @string.Format(SharedLocalizer["TotalAmount"].Value, Model?.TotalAmount.ToString("N2") + " " + SharedLocalizer["JordanDinarShort"].Value)
                        </span>
                    </div>
                    
                    <div class="space-y-4">
                        @foreach (var item in Model.Items)
                        {
                            <div class="flex items-center justify-between text-sm group">
                                <div class="flex items-center gap-3">
                                    <span class="w-8 h-8 rounded-lg bg-white border border-slate-200 flex items-center justify-center font-bold text-slate-600 shadow-sm group-hover:border-[#E8A020] group-hover:text-[#E8A020] transition-colors">@item.Quantity</span>
                                    <span class="font-bold text-slate-700">@item.ProductName</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @if(Model?.PaymentMethod == "COD")
            {
                <div class="bg-amber-50 rounded-2xl p-5 border border-amber-200 mb-8 text-start flex gap-4 items-start shadow-sm">
                    <div class="w-10 h-10 rounded-full bg-white flex items-center justify-center text-amber-500 shadow-sm shrink-0">
                        <span class="material-symbols-outlined">payments</span>
                    </div>
                    <div>
                        <p class="font-black text-amber-900 mb-1">@SharedLocalizer["PaymentMethod"]: @SharedLocalizer["CodLabel"]</p>
                        <p class="text-xs text-amber-700/80 font-bold leading-relaxed">@SharedLocalizer["CodDesc"]</p>
                    </div>
                </div>
            }
            
            <div class="bg-indigo-50/50 rounded-2xl p-6 md:p-8 border-s-4 border-indigo-500 text-start mb-12 relative overflow-hidden">
                <span class="material-symbols-outlined text-indigo-500/10 text-9xl absolute -end-4 -bottom-4 pointer-events-none">local_shipping</span>
                <h3 class="font-black text-indigo-950 mb-4 text-lg">@SharedLocalizer["WhatHappensNow"]</h3>
                <ul class="space-y-4 text-sm text-indigo-900/70 font-bold relative z-10">
                    <li class="flex items-center gap-3">
                        <span class="w-6 h-6 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center shrink-0"><span class="material-symbols-outlined text-[14px]">inventory_2</span></span>
                        @SharedLocalizer["Step1Text"]
                    </li>
                    <li class="flex items-center gap-3">
                        <span class="w-6 h-6 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center shrink-0"><span class="material-symbols-outlined text-[14px]">local_shipping</span></span>
                        @SharedLocalizer["Step2Text"]
                    </li>
                    <li class="flex items-center gap-3">
                        <span class="w-6 h-6 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center shrink-0"><span class="material-symbols-outlined text-[14px]">home_work</span></span>
                        @SharedLocalizer["Step3Text"]
                    </li>
                </ul>
            </div>

            <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
                <a href="@Url.Action("Index", "Account", new { area = "Shop" })" class="w-full sm:w-auto bg-slate-900 text-white font-black px-8 py-4 rounded-2xl shadow-xl shadow-slate-900/20 hover:bg-slate-800 transition-all flex items-center justify-center gap-2 active:scale-95">
                    <span class="material-symbols-outlined">my_location</span>
                    @SharedLocalizer["TrackOrder"]
                </a>
                <a href="@Url.Action("Index", "Category", new { area = "Shop" })" class="w-full sm:w-auto bg-white text-slate-700 border border-slate-200 font-black px-8 py-4 rounded-2xl hover:bg-slate-50 transition-all flex items-center justify-center gap-2 active:scale-95 shadow-sm">
                    <span class="material-symbols-outlined text-slate-400">storefront</span>
                    @SharedLocalizer["ContinueShopping"]
                </a>
            </div>
        </div>
    </div>
</main>