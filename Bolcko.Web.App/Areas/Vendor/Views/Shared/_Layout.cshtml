<!DOCTYPE html>
@{
    var isRtl = System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
    var langCode = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
    var isAuth = User.Identity?.IsAuthenticated == true;
    var userName = User.Identity?.Name ?? "";
}
<html lang="@langCode" dir="@(isRtl ? "rtl" : "ltr")" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>@(ViewData["Title"] ?? "بوابة الموردين والشركاء") | BLOCKO B2B</title>
    <link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png?v=5" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32x32.png?v=5" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicons/favicon-16x16.png?v=5" />
    <link rel="shortcut icon" href="/favicons/favicon.ico?v=5" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0f172a" />
    
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/material-symbols-outlined.woff2">
    <link rel="stylesheet" href="~/css/material-symbols.css" asp-append-version="true">
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Kufi+Arabic:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600;700;800&display=swap">
    <partial name="Partials/_Styles" />
</head>
<body class="bg-[#0D111A] text-slate-100 min-h-screen flex font-['Noto_Kufi_Arabic',sans-serif] antialiased overflow-x-hidden">

    @if (isAuth)
    {
        <!-- Enterprise Collapsible Sidebar -->
        <partial name="Partials/_VendorSidebar" />

        <!-- Main Content Area with Sticky Header -->
        <div class="flex-1 flex flex-col min-w-0 h-screen overflow-y-auto">
            
            <!-- Clean Header -->
            <header class="bg-slate-900/95 backdrop-blur-md border-b border-slate-800 text-white sticky top-0 z-30 shadow-sm px-4 sm:px-6 h-16 flex items-center justify-between">
                
                <!-- Left: Mobile Toggle & Breadcrumbs -->
                <div class="flex items-center gap-3">
                    <button type="button" onclick="toggleVendorMobileDrawer()" class="lg:hidden p-2 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800 transition">
                        <span class="material-symbols-outlined text-xl">menu</span>
                    </button>
                    
                    <div class="hidden sm:flex items-center gap-2 text-xs text-slate-400">
                        <span class="text-slate-500 font-mono">B2B /</span>
                        <span class="text-white font-bold">@(ViewData["Title"] ?? "لوحة تحكم المورد")</span>
                    </div>
                </div>

                <!-- Right: Actions & User Info -->
                <div class="flex items-center gap-3">
                    <a href="/Store/al-qannas" target="_blank" class="hidden md:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-amber-500/10 text-amber-300 border border-amber-500/30 text-xs font-bold hover:bg-amber-500/20 transition shadow-sm">
                        <span class="material-symbols-outlined text-sm">storefront</span>
                        <span>معاينة متجر المعرض</span>
                    </a>

                    <!-- Notification Bell -->
                    <a href="/Vendor/Dashboard" class="p-2 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800 transition relative" title="الإشعارات">
                        <span class="material-symbols-outlined text-xl">notifications</span>
                        <span class="absolute top-1.5 end-1.5 w-2 h-2 rounded-full bg-amber-400"></span>
                    </a>

                    <!-- User Avatar & Quick Info -->
                    <div class="flex items-center gap-2 ps-2 border-s border-slate-800">
                        <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-amber-500 to-amber-300 text-slate-950 font-black flex items-center justify-center text-xs shadow-sm">
                            ق
                        </div>
                        <div class="hidden sm:block text-start">
                            <div class="text-xs font-bold text-white leading-tight">@userName</div>
                            <div class="text-[10px] text-amber-400 font-bold">مورد ذهبي معتمد</div>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Body Content -->
            <main class="flex-1 p-4 sm:p-6 lg:p-8">
                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="bg-slate-900/60 border-t border-slate-800/80 text-slate-500 py-4 px-6 text-xs text-center">
                <div class="flex flex-col sm:flex-row items-center justify-between gap-2">
                    <p>© 2026 BLOCKO Enterprise Vendor Network. @(isRtl ? "جميع الحقوق محفوظة لمنظومة بلوكو الإنشائية." : "All rights reserved.")</p>
                    <div class="flex items-center gap-4 text-[11px]">
                        <a href="/Shop/Legal/Terms" class="hover:text-slate-400">@(isRtl ? "الشروط والأحكام" : "Terms")</a>
                        <span>•</span>
                        <a href="/Shop/Legal/Privacy" class="hover:text-slate-400">@(isRtl ? "الخصوصية" : "Privacy")</a>
                    </div>
                </div>
            </footer>
        </div>
    }
    else
    {
        <!-- Unauthenticated Layout (Login / Join) -->
        <div class="flex-1 flex flex-col min-h-screen">
            <header class="bg-slate-900 border-b border-slate-800 text-white h-16 flex items-center justify-between px-6">
                <a href="/" class="flex items-center gap-2">
                    <partial name="~/Views/Shared/Partials/_BrandLogo.cshtml" model='(false, false, "dark", "h-8")' />
                </a>
                <div class="flex items-center gap-3 text-xs">
                    <a href="/Vendor/Account/Login" class="text-slate-300 hover:text-white">تسجيل الدخول</a>
                    <a href="/Vendor/Account/Join" class="px-4 py-2 rounded-xl bg-amber-500 text-slate-950 font-bold">انضم كمورد</a>
                </div>
            </header>
            
            <main class="flex-1">
                @RenderBody()
            </main>
        </div>
    }

    <script src="~/js/blocko-modal.js" asp-append-version="true"></script>
    <script>
        function toggleVendorMobileDrawer() {
            const drawer = document.getElementById('vendorMobileDrawer');
            const backdrop = document.getElementById('vendorMobileDrawerBackdrop');
            if (drawer && backdrop) {
                const isHidden = backdrop.classList.contains('hidden');
                if (isHidden) {
                    backdrop.classList.remove('hidden');
                    drawer.classList.remove('-translate-x-full', 'rtl:translate-x-full');
                } else {
                    backdrop.classList.add('hidden');
                    drawer.classList.add('-translate-x-full', 'rtl:translate-x-full');
                }
            }
        }

        function toggleSidebarCollapse() {
            const sidebar = document.getElementById('vendorSidebar');
            const iconLogo = document.querySelector('.sidebar-logo-icon');
            const isCollapsed = sidebar.classList.contains('w-20');
            if (isCollapsed) {
                sidebar.classList.remove('w-20');
                sidebar.classList.add('w-64');
                document.querySelectorAll('.sidebar-text').forEach(el => el.classList.remove('hidden'));
                if (iconLogo) iconLogo.classList.add('hidden');
                localStorage.setItem('vendor_sidebar_collapsed', 'false');
            } else {
                sidebar.classList.remove('w-64');
                sidebar.classList.add('w-20');
                document.querySelectorAll('.sidebar-text').forEach(el => el.classList.add('hidden'));
                if (iconLogo) iconLogo.classList.remove('hidden');
                localStorage.setItem('vendor_sidebar_collapsed', 'true');
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            if (localStorage.getItem('vendor_sidebar_collapsed') === 'true') {
                const sidebar = document.getElementById('vendorSidebar');
                const iconLogo = document.querySelector('.sidebar-logo-icon');
                if (sidebar) {
                    sidebar.classList.remove('w-64');
                    sidebar.classList.add('w-20');
                    document.querySelectorAll('.sidebar-text').forEach(el => el.classList.add('hidden'));
                    if (iconLogo) iconLogo.classList.remove('hidden');
                }
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
