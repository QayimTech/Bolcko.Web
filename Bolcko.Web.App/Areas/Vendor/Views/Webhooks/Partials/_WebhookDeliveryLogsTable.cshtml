@model Bolcko.Web.App.Areas.Vendor.Models.VendorWebhooksViewModel

<div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 sm:p-8 shadow-sm space-y-4">
    <div class="flex items-center justify-between pb-3 border-b border-slate-800">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center font-bold">
                <span class="material-symbols-outlined text-xl">history</span>
            </div>
            <div>
                <h3 class="text-base font-bold text-white">سجل الإرسال والمحاولات (Delivery Logs & Audit)</h3>
                <p class="text-xs text-slate-400">فحص الأكواد المرتجعة وزمن الاستجابة وحمولات البيانات المتبادلة</p>
            </div>
        </div>

        <div class="flex items-center gap-2">
            <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                @Model.Config.SuccessfulDeliveriesCount ناجحة
            </span>
            @if (Model.Config.FailedDeliveriesCount > 0)
            {
                <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-rose-500/10 text-rose-400 border border-rose-500/20">
                    @Model.Config.FailedDeliveriesCount فشل
                </span>
            }
        </div>
    </div>

    <!-- Logs Table -->
    <div class="overflow-x-auto rounded-2xl border border-slate-800">
        <table class="w-full text-start text-xs">
            <thead class="bg-slate-950 text-slate-400 font-bold uppercase tracking-wider text-[11px] border-b border-slate-800">
                <tr>
                    <th class="p-3.5">الحدث (Topic)</th>
                    <th class="p-3.5">حالة الاستجابة (Status)</th>
                    <th class="p-3.5">زمن الاستجابة</th>
                    <th class="p-3.5">المحاولات</th>
                    <th class="p-3.5">وقت الإرسال</th>
                    <th class="p-3.5 text-end">الحمولة (Payload)</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-800 text-slate-300">
                @if (!Model.DeliveryLogs.Any())
                {
                    <tr>
                        <td colspan="6" class="p-8 text-center text-slate-500">
                            لا توجد سجلات إرسال حديثة. قم بإرسال فحص تجريبي (Ping) لبدء التسجيل.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var log in Model.DeliveryLogs)
                    {
                        <tr class="hover:bg-slate-800/40 transition">
                            <td class="p-3.5 font-mono text-amber-400 font-semibold">
                                @log.EventType
                            </td>
                            <td class="p-3.5">
                                @if (log.IsSuccess)
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-[11px]">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                                        @(log.ResponseStatusCode ?? 200) OK
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full font-bold bg-rose-500/10 text-rose-400 border border-rose-500/20 text-[11px]">
                                        <span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span>
                                        @(log.ResponseStatusCode.HasValue ? log.ResponseStatusCode.ToString() : "Error")
                                    </span>
                                }
                            </td>
                            <td class="p-3.5 font-mono text-slate-400">
                                @(log.DurationMs) ms
                            </td>
                            <td class="p-3.5">
                                <span class="px-2 py-0.5 rounded bg-slate-800 text-slate-300 font-mono text-[10px]">
                                    @log.AttemptCount / 3
                                </span>
                            </td>
                            <td class="p-3.5 text-slate-400 text-[11px]">
                                @log.CreatedAt.ToString("HH:mm:ss - yyyy/MM/dd")
                            </td>
                            <td class="p-3.5 text-end">
                                <button type="button" 
                                        onclick="showPayloadModal('@Html.Raw(Html.Encode(log.PayloadJson))', '@Html.Raw(Html.Encode(log.ResponseBody ?? "{}"))', '@log.SignatureHeader')"
                                        class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-[11px] font-semibold transition border border-slate-700">
                                    عرض JSON
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
