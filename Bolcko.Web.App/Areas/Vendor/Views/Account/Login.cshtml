@{
    var isArabic = System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("ar");
    ViewData["Title"] = isArabic ? "تسجيل دخول بوابة الموردين | بلوكو" : "Vendor Portal Login | BLOCKO";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="bg-slate-50 min-h-[85vh] flex items-center justify-center py-16 px-4 sm:px-6 lg:px-8 text-start" dir="@(isArabic ? "rtl" : "ltr")">
    <div class="max-w-md w-full space-y-8 bg-white p-8 sm:p-10 rounded-3xl shadow-sm border border-slate-200">
        
        <!-- Header -->
        <div class="text-center space-y-2">
            <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-amber-500/10 text-amber-600 mb-2">
                <span class="material-symbols-outlined text-3xl">storefront</span>
            </div>
            <h1 class="text-2xl font-black text-slate-900 tracking-tight">
                @(isArabic ? "بوابة دخول الموردين المعتمدين" : "Vendor Portal Sign In")
            </h1>
            <p class="text-xs text-slate-500">
                @(isArabic ? "أدخل بيانات حساب المنشأة للوصول لطلبات التوريد المباشرة" : "Enter your vendor account credentials to access supply RFQs")
            </p>
        </div>

        @if (!string.IsNullOrEmpty(ViewBag.Error as string))
        {
            <div class="p-4 rounded-2xl bg-rose-50 border border-rose-200 text-xs text-rose-700 flex items-center gap-2">
                <span class="material-symbols-outlined text-base shrink-0">error</span>
                <span>@ViewBag.Error</span>
            </div>
        }

        <form asp-area="Vendor" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl" method="post" class="space-y-6">
            @Html.AntiForgeryToken()

            <div class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1.5">
                        @(isArabic ? "البريد الإلكتروني للشركة" : "Company Email Address")
                    </label>
                    <input type="email" name="email" required autocomplete="email" dir="ltr"
                           placeholder="vendor@company.com"
                           class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-xs font-bold text-slate-900 focus:bg-white focus:border-amber-500 outline-none transition-all" />
                </div>

                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label class="block text-xs font-bold text-slate-700">
                            @(isArabic ? "كلمة المرور" : "Password")
                        </label>
                    </div>
                    <input type="password" name="password" required autocomplete="current-password"
                           placeholder="••••••••"
                           class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-xs font-bold text-slate-900 focus:bg-white focus:border-amber-500 outline-none transition-all" />
                </div>

                <div class="flex items-center justify-between text-xs">
                    <label class="flex items-center gap-2 cursor-pointer text-slate-600">
                        <input type="checkbox" name="rememberMe" value="true" class="w-4 h-4 rounded text-amber-600 focus:ring-amber-500 border-slate-300" />
                        <span>@(isArabic ? "تذكر بيانات الحساب" : "Remember me")</span>
                    </label>
                </div>
            </div>

            <div>
                <button type="submit" class="w-full py-3.5 bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs rounded-xl transition-all shadow-md active:scale-95 flex items-center justify-center gap-2 cursor-pointer">
                    <span class="material-symbols-outlined text-base text-amber-400">login</span>
                    <span>@(isArabic ? "تسجيل الدخول للمنصة" : "Sign In to Portal")</span>
                </button>
            </div>
        </form>

        <div class="pt-6 border-t border-slate-100 text-center text-xs text-slate-500 space-y-2">
            <p>
                @(isArabic ? "لست مسجلاً كمورد معتمد بعد؟" : "Not an approved vendor yet?")
            </p>
            <a asp-area="Vendor" asp-controller="Account" asp-action="Join"
               class="inline-flex items-center gap-1 text-amber-600 hover:text-amber-700 font-bold transition-colors">
                <span>@(isArabic ? "قدم طلب انضمام مورد جديد الآن" : "Register as a New Vendor")</span>
                <span class="material-symbols-outlined text-sm">arrow_forward</span>
            </a>
        </div>

    </div>
</div>
