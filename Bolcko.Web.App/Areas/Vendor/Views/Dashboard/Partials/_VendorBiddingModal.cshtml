@{
    var isArabic = System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("ar");
}

<div id="biddingModal" class="hidden fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl max-w-lg w-full p-6 sm:p-8 space-y-6 shadow-2xl relative text-start" dir="@(isArabic ? "rtl" : "ltr")">
        <button type="button" onclick="closeBiddingModal()" class="absolute top-6 end-6 text-slate-400 hover:text-slate-700 dark:hover:text-white">
            <span class="material-symbols-outlined">close</span>
        </button>

        <div class="space-y-1">
            <div class="inline-flex items-center gap-1.5 text-xs font-mono uppercase text-[#E8A020] font-bold">
                <span class="material-symbols-outlined text-sm">gavel</span>
                <span>@(isArabic ? "تقديم عرض سعر التوريد" : "Submit Supply Quote")</span>
            </div>
            <h3 class="text-xl font-black text-slate-900 dark:text-white" id="bidProjectTitle">مشروع فيلا مسطح 500 م²</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400" id="bidProjectDesc">تفاصيل المواد المطلوبة</p>
        </div>

        <form id="bidForm" onsubmit="submitVendorBid(event)" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">@(isArabic ? "إجمالي سعر المواد (شامل الضريبة)" : "Total Material Price")</label>
                    <div class="relative">
                        <input type="number" step="0.01" id="bidTotalPrice" required placeholder="0.00" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl p-3 text-xs font-bold text-slate-900 dark:text-white focus:bg-white focus:border-[#E8A020] outline-none">
                        <span class="absolute end-3 top-3 text-xs font-bold text-slate-400">د.أ</span>
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">@(isArabic ? "أجور النقل والتوصيل بالونش" : "Delivery / Crane Fee")</label>
                    <div class="relative">
                        <input type="number" step="0.01" id="bidDeliveryFee" required placeholder="0.00" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl p-3 text-xs font-bold text-slate-900 dark:text-white focus:bg-white focus:border-[#E8A020] outline-none">
                        <span class="absolute end-3 top-3 text-xs font-bold text-slate-400">د.أ</span>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">@(isArabic ? "فترة التوريد المتوقعة (أيام)" : "Estimated Delivery (Days)")</label>
                    <input type="number" min="1" id="bidDeliveryDays" value="3" required class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl p-3 text-xs font-bold text-slate-900 dark:text-white focus:bg-white focus:border-[#E8A020] outline-none">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">@(isArabic ? "صلاحية العرض (أيام)" : "Bid Validity (Days)")</label>
                    <input type="number" min="1" id="bidValidityDays" value="7" required class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl p-3 text-xs font-bold text-slate-900 dark:text-white focus:bg-white focus:border-[#E8A020] outline-none">
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">@(isArabic ? "ملاحظات وشروط التوريد الفنية" : "Technical Notes")</label>
                <textarea id="bidNotes" rows="2" placeholder="@(isArabic ? "مثال: الحجر فرز أول نخب ممتاز، يشمل التنزيل بالونش..." : "Notes...")" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl p-3 text-xs text-slate-900 dark:text-white focus:bg-white focus:border-[#E8A020] outline-none"></textarea>
            </div>

            <div class="pt-4 flex items-center justify-end gap-3 border-t border-slate-100 dark:border-slate-800">
                <button type="button" onclick="closeBiddingModal()" class="px-5 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 text-xs font-bold transition-all">
                    @(isArabic ? "إلغاء" : "Cancel")
                </button>
                <button type="submit" id="submitBidBtn" class="px-7 py-2.5 rounded-xl bg-slate-900 hover:bg-[#E8A020] hover:text-slate-900 text-white text-xs font-black transition-all shadow-md flex items-center gap-2 cursor-pointer">
                    <span>@(isArabic ? "إرسال العرض للعميل" : "Submit Quote")</span>
                    <span class="material-symbols-outlined text-sm">send</span>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function openBiddingModal(title, desc, city) {
        document.getElementById('bidProjectTitle').textContent = title;
        document.getElementById('bidProjectDesc').textContent = desc + ' • ' + city;
        document.getElementById('biddingModal').classList.remove('hidden');
    }

    function closeBiddingModal() {
        document.getElementById('biddingModal').classList.add('hidden');
    }

    function submitVendorBid(e) {
        e.preventDefault();
        const btn = document.getElementById('submitBidBtn');
        btn.disabled = true;
        btn.innerHTML = '<span class="material-symbols-outlined text-sm animate-spin">progress_activity</span> @(isArabic ? "جاري الإرسال..." : "Submitting...")';

        setTimeout(() => {
            if (window.BlockoModal) {
                window.BlockoModal.alert({
                    title: '@(isArabic ? "تم تقديم العرض بنجاح" : "Bid Submitted")',
                    message: '@(isArabic ? "تم إرسال عرض سعرك بنجاح! سيتم إشعار العميل وإعلامك فور قبول العرض." : "Your quotation has been submitted successfully!")',
                    type: 'success'
                });
            } else {
                alert('@(isArabic ? "تم إرسال عرض سعرك بنجاح!" : "Your quotation has been submitted successfully!")');
            }
            closeBiddingModal();
            btn.disabled = false;
            btn.innerHTML = '<span>@(isArabic ? "إرسال العرض للعميل" : "Submit Quote")</span><span class="material-symbols-outlined text-sm">send</span>';
        }, 600);
    }
</script>
