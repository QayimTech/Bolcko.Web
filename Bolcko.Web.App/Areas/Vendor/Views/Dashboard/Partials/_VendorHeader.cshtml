@model Bolcko.Domain.Entities.Catalog.VendorProfile
@{
    var isArabic = System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("ar");
}

<div class="bg-white dark:bg-slate-900 rounded-3xl p-6 sm:p-8 shadow-sm border border-slate-100 dark:border-slate-800 flex flex-col sm:flex-row justify-between sm:items-center gap-4">
    <div class="space-y-1">
        <div class="flex items-center gap-3">
            <span class="p-3 bg-amber-500/10 text-amber-600 dark:text-amber-400 rounded-2xl">
                <span class="material-symbols-outlined text-3xl">storefront</span>
            </span>
            <div>
                <h1 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white">@(Model?.CompanyNameAr ?? (isArabic ? "بوابة المورد المعتمد" : "Approved Vendor Portal"))</h1>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                    @(Model?.CountryCode == "JO" ? "🇯🇴 فرع المملكة الأردنية الهاشمية" : (Model != null ? $"🌐 فرع {Model.CountryCode}" : "🌐")) • @(Model?.City ?? "الأردن")
                </p>
            </div>
        </div>
    </div>

    <!-- KYC Status Badge -->
    <div>
        @if (Model?.Status == "Active")
        {
            <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-2xl bg-emerald-100 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 text-xs font-bold border border-emerald-300 dark:border-emerald-800">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                <span>@(isArabic ? "مورد معتمد ونشط (Verified)" : "Active & Verified Supplier")</span>
            </span>
        }
        else
        {
            <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-2xl bg-amber-100 dark:bg-amber-950/60 text-amber-800 dark:text-amber-300 text-xs font-bold border border-amber-300 dark:border-amber-800">
                <span class="w-2.5 h-2.5 rounded-full bg-amber-500 animate-pulse"></span>
                <span>@(isArabic ? "قيد التدقيق ومطابقة السجل التجاري" : "Pending Verification")</span>
            </span>
        }
    </div>
</div>
