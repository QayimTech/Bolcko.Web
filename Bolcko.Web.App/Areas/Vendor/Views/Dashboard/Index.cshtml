@model Bolcko.Domain.Entities.Catalog.VendorProfile
@{
    var isArabic = System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("ar");
    ViewData["Title"] = isArabic ? "لوحة تحكم المورد المعتمد | بلوكو" : "Vendor Portal Dashboard | BLOCKO";
}

<div class="bg-slate-50 min-h-screen py-10 px-4 sm:px-6 lg:px-8 text-start" dir="@(isArabic ? "rtl" : "ltr")">
    <div class="max-w-6xl mx-auto space-y-8">

        <!-- Top Header & Verification Status -->
        <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-slate-200 flex flex-col sm:flex-row justify-between sm:items-center gap-4">
            <div class="space-y-1">
                <div class="flex items-center gap-3">
                    <span class="p-3 bg-amber-500/10 text-amber-600 rounded-2xl">
                        <span class="material-symbols-outlined text-3xl">storefront</span>
                    </span>
                    <div>
                        <h1 class="text-xl sm:text-2xl font-black text-slate-900">@(Model?.CompanyNameAr ?? (isArabic ? "بوابة المورد المعتمد" : "Approved Vendor Portal"))</h1>
                        <p class="text-xs text-slate-500">
                            @(Model?.CountryCode == "JO" ? "🇯🇴 فرع المملكة الأردنية الهاشمية" : (Model != null ? $"🌐 فرع {Model.CountryCode}" : "🌐")) • @(Model?.City ?? "")
                        </p>
                    </div>
                </div>
            </div>

            <!-- KYC Status Badge -->
            <div>
                @if (Model?.Status == "Active")
                {
                    <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-2xl bg-emerald-100 text-emerald-800 text-xs font-bold border border-emerald-300">
                        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                        <span>@(isArabic ? "مورد معتمد ونشط (Verified)" : "Active & Verified Supplier")</span>
                    </span>
                }
                else
                {
                    <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-2xl bg-amber-100 text-amber-800 text-xs font-bold border border-amber-300">
                        <span class="w-2.5 h-2.5 rounded-full bg-amber-500 animate-pulse"></span>
                        <span>@(isArabic ? "قيد التدقيق ومطابقة السجل التجاري" : "Pending Verification")</span>
                    </span>
                }
            </div>
        </div>

        <!-- Metrics Overview -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
            <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-1">
                <span class="text-[11px] font-bold text-slate-400">@(isArabic ? "طلبات التوريد المتاحة بمنطقتك" : "Local Construction RFQs")</span>
                <p class="text-2xl font-black text-slate-900 font-mono">14</p>
                <span class="text-[10px] text-emerald-600 font-bold">↑ @(isArabic ? "4 طلبات جديدة اليوم" : "4 new RFQs today")</span>
            </div>
            <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-1">
                <span class="text-[11px] font-bold text-slate-400">@(isArabic ? "العروض المقدمة" : "Submitted Bids")</span>
                <p class="text-2xl font-black text-slate-900 font-mono">0</p>
                <span class="text-[10px] text-slate-400">@(isArabic ? "ابدأ بتقديم عروض أسعارك" : "Ready to bid")</span>
            </div>
            <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-1">
                <span class="text-[11px] font-bold text-slate-400">@(isArabic ? "تقييم الجودة والالتزام" : "Quality Rating")</span>
                <p class="text-2xl font-black text-amber-500 font-mono">5.0 ★</p>
                <span class="text-[10px] text-slate-400">@(isArabic ? "ممتاز (مورد جديد)" : "Excellent (New)")</span>
            </div>
            <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-1">
                <span class="text-[11px] font-bold text-slate-400">@(isArabic ? "المواد المسجلة للتوريد" : "Supplied Materials")</span>
                <p class="text-xs font-bold text-slate-800 pt-2 truncate">@(Model?.SuppliedCategories ?? (isArabic ? "حجر وواجهات" : "Stone & Facades"))</p>
                <span class="text-[10px] text-amber-600 font-bold">@(isArabic ? "جاهز للتوريد المباشر" : "Ready for Supply")</span>
            </div>
        </div>

        <!-- RFQs Feed Preview -->
        <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="p-6 border-b border-slate-100 flex items-center justify-between">
                <div>
                    <h2 class="text-base font-bold text-slate-900">@(isArabic ? "أحدث طلبات عروض الأسعار والتوريد (Live Calculator RFQs)" : "Incoming Calculator RFQs in Your City")</h2>
                    <p class="text-xs text-slate-500">@(isArabic ? "طلبات حقيقية صادرة من عملاء أنهوا حساب كمياتهم في حاسبة البناء وينتظرون عروض التوريد" : "Real inquiries from clients who calculated quantities via our smart calculator")</p>
                </div>
                <a href="/calculator" target="_blank" class="text-xs font-bold text-amber-600 hover:text-amber-700 flex items-center gap-1">
                    <span>@(isArabic ? "تجربة الحاسبة" : "Try Calculator")</span>
                    <span class="material-symbols-outlined text-sm">open_in_new</span>
                </a>
            </div>

            <div class="divide-y divide-slate-100">
                <div class="p-6 flex flex-col sm:flex-row justify-between sm:items-center gap-4 hover:bg-slate-50/60 transition-colors">
                    <div class="space-y-1">
                        <div class="flex items-center gap-2">
                            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-indigo-50 text-indigo-700 border border-indigo-200">@(isArabic ? "فيلا سكنية • 2 طوابق" : "Residential Villa • 2 Floors")</span>
                            <span class="text-xs font-bold text-slate-900">@(isArabic ? "مشروع فيلا مسطح 500 م²" : "Villa 500 sqm Project")</span>
                            <span class="text-[11px] text-slate-400">• @(Model?.City ?? (isArabic ? "عمان" : "Amman"))</span>
                        </div>
                        <p class="text-xs text-slate-600">
                            <strong>@(isArabic ? "المواد المطلوبة:" : "Required Materials:")</strong> @(isArabic ? "حجر رويشد طبيعي مفجر (580 م²) • كرانيش 64 م طولي • حديد تسليح Grade 60 (20.5 طن) • باطون جاهز B250 (190 م³)" : "Natural Ruwaished Stone (580 m²) • Cornices 64 lm • Rebar Grade 60 (20.5 Ton) • Ready-mix B250 (190 m³)")
                        </p>
                        <span class="text-[10px] text-slate-400 font-mono">@(isArabic ? "منذ 25 دقيقة • عبر حاسبة بلوكو الذكية" : "25 mins ago • via BLOCKO Smart Calculator")</span>
                    </div>
                    <div class="flex items-center gap-2 flex-shrink-0">
                        @if (Model?.Status == "Active")
                        {
                            <button type="button" onclick="openBiddingModal('فيلا مسطح 500 م²', 'حجر رويشد مفجر 580م²، كرانيش، حديد، باطون', 'عمان')"
                                    class="px-5 py-2.5 bg-slate-900 hover:bg-[#E8A020] hover:text-slate-950 text-white font-bold text-xs rounded-xl transition-all shadow-sm cursor-pointer flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-sm">request_quote</span>
                                <span>@(isArabic ? "تقديم عرض سعر رسمي" : "Submit Official Quotation")</span>
                            </button>
                        }
                        else
                        {
                            <button type="button" disabled
                                    title="@(isArabic ? "الحساب بانتظار الاعتماد لتقديم العروض" : "Account pending verification")"
                                    class="px-5 py-2.5 bg-slate-200 text-slate-500 font-bold text-xs rounded-xl cursor-not-allowed flex items-center gap-1.5 border border-slate-300">
                                <span class="material-symbols-outlined text-sm">lock_clock</span>
                                <span>@(isArabic ? "بانتظار اعتماد الحساب للتقديم" : "Pending Verification")</span>
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Bidding Modal -->
<div id="biddingModal" class="hidden fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white border border-slate-200 rounded-3xl max-w-lg w-full p-6 sm:p-8 space-y-6 shadow-2xl relative text-start" dir="@(isArabic ? "rtl" : "ltr")">
        <button type="button" onclick="closeBiddingModal()" class="absolute top-6 end-6 text-slate-400 hover:text-slate-700">
            <span class="material-symbols-outlined">close</span>
        </button>

        <div class="space-y-1">
            <div class="inline-flex items-center gap-1.5 text-xs font-mono uppercase text-[#E8A020] font-bold">
                <span class="material-symbols-outlined text-sm">gavel</span>
                <span>@(isArabic ? "تقديم عرض سعر التوريد" : "Submit Supply Quote")</span>
            </div>
            <h3 class="text-xl font-black text-slate-900" id="bidProjectTitle">مشروع فيلا مسطح 500 م²</h3>
            <p class="text-xs text-slate-500" id="bidProjectDesc">تفاصيل المواد المطلوبة</p>
        </div>

        <form id="bidForm" onsubmit="submitVendorBid(event)" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">@(isArabic ? "إجمالي سعر المواد (شامل الضريبة)" : "Total Material Price")</label>
                    <div class="relative">
                        <input type="number" step="0.01" id="bidTotalPrice" required placeholder="0.00" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-xs font-bold text-slate-900 focus:bg-white focus:border-[#E8A020] outline-none">
                        <span class="absolute end-3 top-3 text-xs font-bold text-slate-400">د.أ</span>
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">@(isArabic ? "أجور النقل والتوصيل بالونش" : "Delivery / Crane Fee")</label>
                    <div class="relative">
                        <input type="number" step="0.01" id="bidDeliveryFee" required placeholder="0.00" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-xs font-bold text-slate-900 focus:bg-white focus:border-[#E8A020] outline-none">
                        <span class="absolute end-3 top-3 text-xs font-bold text-slate-400">د.أ</span>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">@(isArabic ? "فترة التوريد المتوقعة (أيام)" : "Estimated Delivery (Days)")</label>
                    <input type="number" min="1" id="bidDeliveryDays" value="3" required class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-xs font-bold text-slate-900 focus:bg-white focus:border-[#E8A020] outline-none">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">@(isArabic ? "صلاحية العرض (أيام)" : "Bid Validity (Days)")</label>
                    <input type="number" min="1" id="bidValidityDays" value="7" required class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-xs font-bold text-slate-900 focus:bg-white focus:border-[#E8A020] outline-none">
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">@(isArabic ? "ملاحظات وشروط التوريد الفنية" : "Technical Notes")</label>
                <textarea id="bidNotes" rows="2" placeholder="@(isArabic ? "مثال: الحجر فرز أول نخب ممتاز، يشمل التنزيل بالونش..." : "Notes...")" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-xs text-slate-900 focus:bg-white focus:border-[#E8A020] outline-none"></textarea>
            </div>

            <div class="pt-4 flex items-center justify-end gap-3 border-t border-slate-100">
                <button type="button" onclick="closeBiddingModal()" class="px-5 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition-all">
                    @(isArabic ? "إلغاء" : "Cancel")
                </button>
                <button type="submit" id="submitBidBtn" class="px-7 py-2.5 rounded-xl bg-slate-900 hover:bg-[#E8A020] hover:text-slate-900 text-white text-xs font-black transition-all shadow-md flex items-center gap-2">
                    <span>@(isArabic ? "إرسال العرض للعميل" : "Submit Quote")</span>
                    <span class="material-symbols-outlined text-sm">send</span>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function openBiddingModal(title, desc, city) {
        document.getElementById('bidProjectTitle').textContent = title;
        document.getElementById('bidProjectDesc').textContent = desc + ' • ' + city;
        document.getElementById('biddingModal').classList.remove('hidden');
    }

    function closeBiddingModal() {
        document.getElementById('biddingModal').classList.add('hidden');
    }

    function submitVendorBid(e) {
        e.preventDefault();
        const btn = document.getElementById('submitBidBtn');
        btn.disabled = true;
        btn.innerHTML = '<span class="material-symbols-outlined text-sm animate-spin">progress_activity</span> @(isArabic ? "جاري الإرسال..." : "Submitting...")';

        setTimeout(() => {
            alert('@(isArabic ? "تم إرسال عرض سعرك بنجاح! سيتم إشعار العميل وإعلامك فور قبول العرض." : "Your quotation has been submitted successfully!")');
            closeBiddingModal();
            btn.disabled = false;
            btn.innerHTML = '<span>@(isArabic ? "إرسال العرض للعميل" : "Submit Quote")</span><span class="material-symbols-outlined text-sm">send</span>';
        }, 600);
    }
</script>
