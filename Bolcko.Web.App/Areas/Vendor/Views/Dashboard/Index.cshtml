@model Bolcko.Domain.Entities.Catalog.VendorProfile
@{
    var isArabic = System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("ar");
    ViewData["Title"] = isArabic ? "لوحة تحكم المورد المعتمد | بلوكو" : "Vendor Portal Dashboard | BLOCKO";
}

<div class="bg-slate-50 dark:bg-slate-950 min-h-screen py-10 px-4 sm:px-6 lg:px-8 text-start" dir="@(isArabic ? "rtl" : "ltr")">
    <div class="max-w-6xl mx-auto space-y-8">

        <!-- 1. Top Header & KYC Verification Status Badge -->
        <partial name="Partials/_VendorHeader" model="Model" />

        <!-- 2. KYC Verification Stepper & Documents Hub -->
        <partial name="Partials/_VendorKycStepper" model="Model" />

        <!-- 3. Metrics Overview -->
        <partial name="Partials/_VendorKpiMetrics" model="Model" />

        <!-- 4. Quick Action Cards -->
        <partial name="Partials/_VendorActionCards" />

        <!-- 5. Live Calculator RFQs Feed Preview -->
        <partial name="Partials/_VendorRfqFeed" model="Model" />

    </div>
</div>

<!-- 6. KYC Documents Upload Modal -->
<partial name="Partials/_VendorKycUploadModal" />

<!-- 7. Vendor RFQ Bidding Modal -->
<partial name="Partials/_VendorBiddingModal" />
