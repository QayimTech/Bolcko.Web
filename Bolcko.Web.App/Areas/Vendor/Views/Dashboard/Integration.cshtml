@model Bolcko.Domain.Entities.Catalog.VendorProfile
@{
    ViewData["Title"] = "مركز تكامل الـ ERP والربط البرمجي";
    Layout = "~/Areas/Vendor/Views/Shared/_Layout.cshtml";
    var isArabic = System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("ar");
}

<div class="space-y-6 text-right" dir="rtl">
    <!-- Header -->
    <div class="bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 text-white rounded-3xl p-6 sm:p-8 shadow-xl relative overflow-hidden">
        <div class="relative z-10 space-y-2">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/20 text-indigo-300 text-xs font-bold font-mono">
                <span class="material-symbols-outlined text-sm">api</span>
                <span>B2B ERP Integration & Webhook Sync</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-black">مركز تكامل أنظمة الـ ERP والربط البرمجي 🔌</h1>
            <p class="text-xs text-slate-300 max-w-2xl">
                اربط نظام إدارة الموارد الخاص بمصنعك أو مستودعك (SAP, Oracle, Odoo, Microsoft Dynamics) مع منصة BlockO لمزامنة المخزون والأسعار واستقبال أوامر الشراء آلياً.
            </p>
        </div>
    </div>

    <!-- API Credentials & Settings -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm space-y-4">
                <div class="flex items-center gap-2 border-b border-slate-100 pb-3">
                    <span class="material-symbols-outlined text-indigo-600">key</span>
                    <h2 class="text-base font-bold text-slate-900">مفاتيح الربط البرمجي (API Credentials)</h2>
                </div>

                <div class="space-y-3 text-xs">
                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Vendor API Key:</label>
                        <div class="flex items-center gap-2">
                            <input type="text" readonly value="blk_live_vn_9847291a0c849e71b2d" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 border border-slate-200 font-mono text-slate-700 outline-none select-all" />
                            <button onclick="navigator.clipboard.writeText('blk_live_vn_9847291a0c849e71b2d'); alert('تم نسخ الـ API Key بنجاح');" class="px-3.5 py-2.5 rounded-xl bg-slate-900 text-white font-bold hover:bg-slate-800 transition">
                                نسخ
                            </button>
                        </div>
                    </div>

                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Webhook Endpoint URL (لاستقبال إشعارات أوامر الشراء والـ RFQs):</label>
                        <input type="url" placeholder="https://your-erp.com/api/blocko-webhook" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 font-mono text-slate-700 outline-none focus:ring-2 focus:ring-[#E8A020]" />
                    </div>
                </div>

                <div class="pt-2">
                    <button class="px-5 py-2.5 rounded-xl bg-[#E8A020] text-slate-900 font-bold text-xs hover:bg-amber-400 transition">
                        حفظ إعدادات الـ Webhook والربط
                    </button>
                </div>
            </div>
        </div>

        <!-- Documentation & Endpoints -->
        <div class="space-y-6">
            <div class="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm space-y-3 text-xs">
                <h3 class="font-bold text-slate-900 text-sm flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-[#E8A020]">menu_book</span>
                    <span>نقاط الـ API المدعومة</span>
                </h3>
                <ul class="space-y-2 text-slate-600">
                    <li class="p-2 bg-slate-50 rounded-xl font-mono text-[11px]"><span class="text-emerald-600 font-bold">POST</span> /api/v1/vendor/inventory/sync</li>
                    <li class="p-2 bg-slate-50 rounded-xl font-mono text-[11px]"><span class="text-blue-600 font-bold">GET</span> /api/v1/vendor/rfq/pending</li>
                    <li class="p-2 bg-slate-50 rounded-xl font-mono text-[11px]"><span class="text-emerald-600 font-bold">POST</span> /api/v1/vendor/rfq/quote</li>
                    <li class="p-2 bg-slate-50 rounded-xl font-mono text-[11px]"><span class="text-indigo-600 font-bold">POST</span> /api/v1/vendor/dispatch/pod-update</li>
                </ul>
            </div>
        </div>

    </div>
</div>
