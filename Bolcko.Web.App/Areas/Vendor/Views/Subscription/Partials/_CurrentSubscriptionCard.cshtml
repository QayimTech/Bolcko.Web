@model Bolcko.Web.App.Areas.Vendor.Models.VendorSubscriptionViewModel

<div class="bg-gradient-to-br from-[#151B26] via-[#1B2234] to-[#121722] border border-amber-500/30 rounded-3xl p-6 sm:p-8 shadow-2xl relative overflow-hidden">
    <!-- Background Glow & Accent Badge -->
    <div class="absolute -top-12 -end-12 w-48 h-48 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute top-6 end-6">
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-amber-500/20 text-amber-300 border border-amber-500/40 text-xs font-black uppercase tracking-wider shadow-sm">
            <span class="material-symbols-outlined text-sm text-amber-400">workspace_premium</span>
            <span>@Model.ActiveTierNameAr</span>
        </span>
    </div>

    <div class="space-y-6">
        <div>
            <div class="text-[11px] text-slate-400 font-mono uppercase tracking-wider mb-1 flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>الاشتراك التجاري الفعّال للمورد</span>
            </div>
            <h2 class="text-2xl sm:text-3xl font-black text-white">@Model.CompanyName</h2>
            <p class="text-slate-400 text-xs sm:text-sm mt-1">تتمتع حالياً بمزايا الترتيب المتقدم في نتائج البحث ونسبة عمولة مفضلة على المبيعات.</p>
        </div>

        <!-- Metrics Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 border-y border-white/10 py-5">
            <div class="space-y-1">
                <span class="text-[10px] text-slate-400 uppercase font-bold block">نسبة عمولة المنصة</span>
                <div class="flex items-baseline gap-1">
                    <span class="text-2xl sm:text-3xl font-black text-emerald-400 font-mono">@Model.CurrentCommissionRate.ToString("N1")%</span>
                    <span class="text-[10px] text-slate-500">(بدل 3.5%)</span>
                </div>
            </div>

            <div class="space-y-1">
                <span class="text-[10px] text-slate-400 uppercase font-bold block">مضاعف الظهور في البحث</span>
                <div class="flex items-baseline gap-1">
                    <span class="text-2xl sm:text-3xl font-black text-amber-400 font-mono">@Model.CatalogBoostMultiplier.ToString("N1")x</span>
                    <span class="text-[10px] text-slate-500">أولوية أولى</span>
                </div>
            </div>

            <div class="space-y-1">
                <span class="text-[10px] text-slate-400 uppercase font-bold block">مشاهدات الكتالوج الشهرية</span>
                <div class="flex items-baseline gap-1">
                    <span class="text-2xl sm:text-3xl font-black text-sky-400 font-mono">@Model.MonthlySearchImpressions.ToString("N0")</span>
                    <span class="text-[10px] text-slate-500">ظهور</span>
                </div>
            </div>

            <div class="space-y-1">
                <span class="text-[10px] text-slate-400 uppercase font-bold block">أيام الاشتراك المتبقية</span>
                <div class="flex items-baseline gap-1">
                    <span class="text-2xl sm:text-3xl font-black text-purple-300 font-mono">@Model.DaysRemaining</span>
                    <span class="text-[10px] text-slate-500">يوم</span>
                </div>
            </div>
        </div>

        <!-- Footer Info & Action -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-1">
            <div class="text-xs text-slate-400 flex items-center gap-2">
                <span class="material-symbols-outlined text-emerald-400 text-sm">event_available</span>
                <span>تاريخ التجديد التلقائي القادم: <strong class="text-slate-200 font-mono">@(Model.SubscriptionEndDate?.ToString("yyyy-MM-dd") ?? "2027-01-01")</strong></span>
            </div>

            <div class="flex items-center gap-3">
                <button type="button" onclick="openUpgradeModal()" class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-amber-500 to-amber-400 hover:from-amber-400 hover:to-amber-300 text-slate-950 text-xs font-black transition-all flex items-center gap-2 shadow-lg shadow-amber-500/20 active:scale-95 cursor-pointer">
                    <span class="material-symbols-outlined text-sm">rocket_launch</span>
                    <span>ترقية الباقة أو تغيير دورة الفوترة</span>
                </button>
            </div>
        </div>
    </div>
</div>
