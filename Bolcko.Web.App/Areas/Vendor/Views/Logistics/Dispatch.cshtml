@model IEnumerable<Bolcko.Domain.Entities.Delivery.DTOs.VendorDispatchOrderDto>
@{
    ViewData["Title"] = "لوحة أوامر الشحن وتذاكر القبان";
    Layout = "~/Areas/Vendor/Views/Shared/_Layout.cshtml";
}

<div class="space-y-6" dir="rtl">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white dark:bg-slate-900 p-6 sm:p-8 rounded-3xl border border-slate-100 dark:border-slate-800 shadow-sm">
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-2xl bg-sky-500/10 text-sky-500 flex items-center justify-center font-black text-2xl ring-8 ring-sky-500/5">
                📋
            </div>
            <div>
                <h1 class="text-xl font-black text-slate-900 dark:text-white">إدارة عمليات الشحن وتذاكر القبان (Dispatch Operations)</h1>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                    تعيين سائقي الأسطول، توثيق شهادات القبان الإلكترونية، وطباعة بيان الحمولة المعتمد (VL-02)
                </p>
            </div>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <a asp-action="Index"
               class="px-5 py-2.5 rounded-2xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 font-bold text-xs transition-colors flex items-center gap-1.5">
                <span class="material-symbols-outlined text-base">settings</span>
                <span>إعدادات مركز الشحن (VL-01)</span>
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 font-bold text-sm flex items-center gap-2">
            <span>✅</span> <span>@TempData["Success"]</span>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="p-4 rounded-2xl bg-rose-500/10 border border-rose-500/20 text-rose-600 dark:text-rose-400 font-bold text-sm flex items-center gap-2">
            <span>⚠️</span> <span>@TempData["Error"]</span>
        </div>
    }

    <!-- 1. Dispatch Orders Table -->
    <partial name="Partials/_DispatchOrdersTable" model="Model" />

</div>

<!-- 2. Driver Assignment Modal -->
<partial name="Partials/_DriverAssignmentModal" />

<!-- 3. Weighbridge Ticket Modal -->
<partial name="Partials/_WeighbridgeModal" />
