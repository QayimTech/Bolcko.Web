<div id="driverModal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-slate-900/70 backdrop-blur-sm">
    <div class="w-full max-w-md bg-white dark:bg-slate-900 rounded-3xl p-6 border border-slate-100 dark:border-slate-800 shadow-2xl space-y-4" dir="rtl">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800">
            <div>
                <h3 class="text-base font-black text-slate-900 dark:text-white">تعيين سائق وشاحنة للتوريد</h3>
                <p class="text-xs text-slate-400 mt-0.5" id="driverModalSub">الشحنة: BLK-00000</p>
            </div>
            <button type="button" onclick="closeDriverModal()" class="text-slate-400 hover:text-slate-600 dark:hover:text-white text-xl font-bold">&times;</button>
        </div>

        <form asp-action="AssignDriver" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="orderId" id="driverOrderId" value="0" />

            <div>
                <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">اسم السائق المعتمد *</label>
                <input type="text" name="driverName" id="driverNameInput" required placeholder="مثال: أحمد الخالدي"
                       class="w-full px-3.5 py-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold text-slate-800 dark:text-white" />
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">رقم هاتف السائق *</label>
                <input type="tel" name="driverPhone" id="driverPhoneInput" required placeholder="079XXXXXXX"
                       class="w-full px-3.5 py-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold text-slate-800 dark:text-white font-mono" />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">رقم لوحة الشاحنة *</label>
                    <input type="text" name="truckPlateNumber" required placeholder="مثال: 12-38491"
                           class="w-full px-3.5 py-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold text-slate-800 dark:text-white font-mono" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">نوع الشاحنة والمعدة</label>
                    <select name="vehicleType" class="w-full px-3 py-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold text-slate-800 dark:text-white">
                        <option value="تريلا قلاب 30 طن">تريلا قلاب 30 طن</option>
                        <option value="شاحنة ونش هيدروليكي">شاحنة ونش هيدروليكي</option>
                        <option value="لوري مسطح 10 طن">لوري مسطح 10 طن</option>
                        <option value="خلاطة خرسانة جاهزة">خلاطة خرسانة جاهزة</option>
                    </select>
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100 dark:border-slate-800">
                <button type="button" onclick="closeDriverModal()" class="px-5 py-2.5 text-xs font-bold text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-xl">إلغاء</button>
                <button type="submit" class="px-6 py-2.5 rounded-xl bg-slate-900 hover:bg-amber-500 hover:text-slate-950 text-white font-black text-xs shadow-md transition-all">تثبيت وتعيين السائق</button>
            </div>
        </form>
    </div>
</div>

<script>
    function openDriverModal(orderId, trackingCode, projectTitle) {
        document.getElementById('driverOrderId').value = orderId;
        document.getElementById('driverModalSub').textContent = `${trackingCode} • ${projectTitle}`;
        document.getElementById('driverModal').classList.remove('hidden');
        document.getElementById('driverModal').classList.add('flex');
    }
    function closeDriverModal() {
        document.getElementById('driverModal').classList.add('hidden');
        document.getElementById('driverModal').classList.remove('flex');
    }
</script>
