@model Bolcko.Domain.Entities.Delivery.DTOs.VendorFulfillmentConfigDto

<div class="bg-white dark:bg-slate-900 p-6 sm:p-8 rounded-3xl border border-slate-100 dark:border-slate-800 shadow-sm space-y-6">
    <div class="flex items-center justify-between pb-4 border-b border-slate-100 dark:border-slate-800">
        <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-2xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center font-bold text-xl">
                🚚
            </div>
            <div>
                <h3 class="text-base font-black text-slate-900 dark:text-white">نمط التوريد والشحن اللوجستي (Fulfillment Hub Strategy)</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">حدد كيف يتم شحن وتوصيل مواد البناء لمواقع الورش والمشاريع الإنشائية</p>
            </div>
        </div>
        <span class="px-3 py-1 rounded-full bg-amber-500/10 text-amber-700 dark:text-amber-300 text-xs font-bold border border-amber-500/20 font-mono">
            VL-01 Hub
        </span>
    </div>

    <!-- Fulfillment Options Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <!-- Option 1: Own Fleet -->
        <label class="relative p-5 rounded-2xl border-2 transition-all cursor-pointer flex flex-col justify-between hover:border-amber-500 @(Model.Mode == Bolcko.Domain.Entities.Delivery.DTOs.VendorFulfillmentMode.OwnFleet ? "border-amber-500 bg-amber-50/20 dark:bg-amber-950/20" : "border-slate-200 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/40")">
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <span class="w-10 h-10 rounded-xl bg-slate-900 text-white flex items-center justify-center font-black text-lg">🚛</span>
                    <input type="radio" name="Mode" value="OwnFleet" class="w-4 h-4 text-amber-500" @(Model.Mode == Bolcko.Domain.Entities.Delivery.DTOs.VendorFulfillmentMode.OwnFleet ? "checked" : "") />
                </div>
                <div>
                    <h4 class="text-sm font-black text-slate-900 dark:text-white">أسطول المورد الخاص (Own Fleet)</h4>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 leading-relaxed">
                        تعتمد على شاحناتك وسائقيك لتوصيل وتفريغ الشحنات مباشرة في موقع العميل.
                    </p>
                </div>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-200 dark:border-slate-700 flex items-center justify-between text-[11px] font-bold text-slate-600 dark:text-slate-300">
                <span>التحكم: كامل بالأسطول</span>
                <span class="text-emerald-600 dark:text-emerald-400 font-mono">بدون عمولة شحن</span>
            </div>
        </label>

        <!-- Option 2: Custom 3PL Freight -->
        <label class="relative p-5 rounded-2xl border-2 transition-all cursor-pointer flex flex-col justify-between hover:border-sky-500 @(Model.Mode == Bolcko.Domain.Entities.Delivery.DTOs.VendorFulfillmentMode.Custom3PL ? "border-sky-500 bg-sky-50/20 dark:bg-sky-950/20" : "border-slate-200 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/40")">
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <span class="w-10 h-10 rounded-xl bg-sky-500 text-white flex items-center justify-center font-black text-lg">🏢</span>
                    <input type="radio" name="Mode" value="Custom3PL" class="w-4 h-4 text-sky-500" @(Model.Mode == Bolcko.Domain.Entities.Delivery.DTOs.VendorFulfillmentMode.Custom3PL ? "checked" : "") />
                </div>
                <div>
                    <h4 class="text-sm font-black text-slate-900 dark:text-white">شركات شحن خارجية (Custom 3PL)</h4>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 leading-relaxed">
                        ربط مباشر مع شركات الشحن والنقل الثقيل المعتمدة لديك لتولي الشحنات.
                    </p>
                </div>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-200 dark:border-slate-700 flex items-center justify-between text-[11px] font-bold text-slate-600 dark:text-slate-300">
                <span>تكامل API تلقائي</span>
                <span class="text-sky-600 dark:text-sky-400 font-mono">ناقل معتمد</span>
            </div>
        </label>

        <!-- Option 3: Blocko Platform Pool (Recommended) -->
        <label class="relative p-5 rounded-2xl border-2 transition-all cursor-pointer flex flex-col justify-between hover:border-emerald-500 @(Model.Mode == Bolcko.Domain.Entities.Delivery.DTOs.VendorFulfillmentMode.PlatformPool ? "border-emerald-500 bg-emerald-50/20 dark:bg-emerald-950/20" : "border-slate-200 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/40")">
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <span class="w-10 h-10 rounded-xl bg-emerald-600 text-white flex items-center justify-center font-black text-lg">⚡</span>
                    <input type="radio" name="Mode" value="PlatformPool" class="w-4 h-4 text-emerald-500" @(Model.Mode == Bolcko.Domain.Entities.Delivery.DTOs.VendorFulfillmentMode.PlatformPool ? "checked" : "") />
                </div>
                <div>
                    <div class="flex items-center gap-1.5 mb-1">
                        <h4 class="text-sm font-black text-slate-900 dark:text-white">شبكة أسطول بلوكو الموحدة</h4>
                        <span class="px-2 py-0.5 rounded-full bg-emerald-100 dark:bg-emerald-900/60 text-emerald-800 dark:text-emerald-300 text-[10px] font-bold">موصى به</span>
                    </div>
                    <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
                        تخصيص فوري لأقرب شاحنة ثقيلة أو ونش هيدروليكي عبر شبكة بلوكو مع التتبع الموقعي.
                    </p>
                </div>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-200 dark:border-slate-700 flex items-center justify-between text-[11px] font-bold text-slate-600 dark:text-slate-300">
                <span>أمان كامل وتأمين حمولة</span>
                <span class="text-emerald-600 dark:text-emerald-400 font-mono">عند الطلب</span>
            </div>
        </label>
    </div>
</div>
