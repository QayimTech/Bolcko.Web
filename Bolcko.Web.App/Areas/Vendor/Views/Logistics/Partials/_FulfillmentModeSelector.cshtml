@model Bolcko.Domain.Entities.Delivery.DTOs.VendorFulfillmentConfigDto

<div class="bg-white dark:bg-slate-900 p-6 sm:p-8 rounded-3xl border border-slate-100 dark:border-slate-800 shadow-sm space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-100 dark:border-slate-800 gap-3">
        <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-2xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center font-bold text-xl">
                🚚
            </div>
            <div>
                <h3 class="text-base font-black text-slate-900 dark:text-white">سيادة المورد ونمط الشحن اللوجستي (Vendor Fleet Sovereignty)</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">تحكم كامل باستراتيجية الشحن: أسطولك الخاص، شركاء 3PL، أو شبكة أسطول بلوكو</p>
            </div>
        </div>
        <span class="px-3 py-1 rounded-full bg-amber-500/10 text-amber-700 dark:text-amber-300 text-xs font-bold border border-amber-500/20 font-mono self-start sm:self-center">
            LOG-05 Hub
        </span>
    </div>

    <!-- Fulfillment Options Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Option 1: Own Fleet (Scenario 1: 0% Platform Freight Fee) -->
        <label class="relative p-5 rounded-2xl border-2 transition-all cursor-pointer flex flex-col justify-between hover:border-amber-500 @(Model.Mode == Bolcko.Domain.Entities.Delivery.DTOs.VendorFulfillmentMode.OwnFleet ? "border-amber-500 bg-amber-50/30 dark:bg-amber-950/20 ring-2 ring-amber-500/20" : "border-slate-200 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/40")">
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <span class="w-10 h-10 rounded-xl bg-slate-900 text-white flex items-center justify-center font-black text-lg">🚛</span>
                    <input type="radio" name="Mode" value="OwnFleet" class="w-4 h-4 text-amber-500" @(Model.Mode == Bolcko.Domain.Entities.Delivery.DTOs.VendorFulfillmentMode.OwnFleet ? "checked" : "") />
                </div>
                <div>
                    <div class="flex items-center gap-1.5 mb-1">
                        <h4 class="text-sm font-black text-slate-900 dark:text-white">أسطول المتجر الخاص</h4>
                        <span class="px-1.5 py-0.5 rounded bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300 text-[10px] font-bold">0% عمولة</span>
                    </div>
                    <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
                        توصيل بشاحناتك الخاصة. بوليصة شحن رقمية مجانية وتأكيد تسليم بـ OTP لحماية الذمم المالية.
                    </p>
                </div>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-200 dark:border-slate-700 flex items-center justify-between text-[11px] font-bold text-slate-600 dark:text-slate-300">
                <span>رسوم المنصة:</span>
                <span class="text-emerald-600 dark:text-emerald-400 font-mono font-black">0.00 د.أ (مجاناً)</span>
            </div>
        </label>

        <!-- Option 2: Custom 3PL Freight -->
        <label class="relative p-5 rounded-2xl border-2 transition-all cursor-pointer flex flex-col justify-between hover:border-sky-500 @(Model.Mode == Bolcko.Domain.Entities.Delivery.DTOs.VendorFulfillmentMode.Custom3PL ? "border-sky-500 bg-sky-50/30 dark:bg-sky-950/20 ring-2 ring-sky-500/20" : "border-slate-200 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/40")">
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <span class="w-10 h-10 rounded-xl bg-sky-500 text-white flex items-center justify-center font-black text-lg">🏢</span>
                    <input type="radio" name="Mode" value="Custom3PL" class="w-4 h-4 text-sky-500" @(Model.Mode == Bolcko.Domain.Entities.Delivery.DTOs.VendorFulfillmentMode.Custom3PL ? "checked" : "") />
                </div>
                <div>
                    <h4 class="text-sm font-black text-slate-900 dark:text-white">شركات شحن خارجية (3PL)</h4>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 leading-relaxed">
                        ربط وإسناد مباشر لشركات الشحن الثقيل المعتمدة لديك بأسعار تفاوضية مسبقة.
                    </p>
                </div>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-200 dark:border-slate-700 flex items-center justify-between text-[11px] font-bold text-slate-600 dark:text-slate-300">
                <span>ربط شركات النقل:</span>
                <span class="text-sky-600 dark:text-sky-400 font-mono">أسعار تفاوضية</span>
            </div>
        </label>

        <!-- Option 3: Block-O Open Carrier Pool -->
        <label class="relative p-5 rounded-2xl border-2 transition-all cursor-pointer flex flex-col justify-between hover:border-amber-500 @(Model.Mode == Bolcko.Domain.Entities.Delivery.DTOs.VendorFulfillmentMode.BlockoPool ? "border-amber-500 bg-amber-50/30 dark:bg-amber-950/20 ring-2 ring-amber-500/20" : "border-slate-200 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/40")">
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <span class="w-10 h-10 rounded-xl bg-amber-500 text-slate-950 flex items-center justify-center font-black text-lg">⚡</span>
                    <input type="radio" name="Mode" value="BlockoPool" class="w-4 h-4 text-amber-500" @(Model.Mode == Bolcko.Domain.Entities.Delivery.DTOs.VendorFulfillmentMode.BlockoPool ? "checked" : "") />
                </div>
                <div>
                    <div class="flex items-center gap-1.5 mb-1">
                        <h4 class="text-sm font-black text-slate-900 dark:text-white">شبكة كباتن بلوكو المفتوحة</h4>
                        <span class="px-1.5 py-0.5 rounded bg-amber-100 dark:bg-amber-950 text-amber-800 dark:text-amber-300 text-[10px] font-bold">حجز إسكرو</span>
                    </div>
                    <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
                        استدعاء فوري لآلاف الشاحنات والكباتن المعتمدين في أوقات الذروة مع حجز الضمان المالي للشحنة.
                    </p>
                </div>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-200 dark:border-slate-700 flex items-center justify-between text-[11px] font-bold text-slate-600 dark:text-slate-300">
                <span>تغطية فورية:</span>
                <span class="text-amber-600 dark:text-amber-400 font-mono font-bold">تعرفة قياسية</span>
            </div>
        </label>

        <!-- Option 4: Customer Pickup -->
        <label class="relative p-5 rounded-2xl border-2 transition-all cursor-pointer flex flex-col justify-between hover:border-emerald-500 @(Model.Mode == Bolcko.Domain.Entities.Delivery.DTOs.VendorFulfillmentMode.CustomerPickup ? "border-emerald-500 bg-emerald-50/30 dark:bg-emerald-950/20 ring-2 ring-emerald-500/20" : "border-slate-200 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/40")">
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <span class="w-10 h-10 rounded-xl bg-emerald-600 text-white flex items-center justify-center font-black text-lg">🏬</span>
                    <input type="radio" name="Mode" value="CustomerPickup" class="w-4 h-4 text-emerald-500" @(Model.Mode == Bolcko.Domain.Entities.Delivery.DTOs.VendorFulfillmentMode.CustomerPickup ? "checked" : "") />
                </div>
                <div>
                    <h4 class="text-sm font-black text-slate-900 dark:text-white">استلام مباشر من المستودع</h4>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 leading-relaxed">
                        استلام وتفريغ المواد من مصنعك أو مستودعاتك المركزية مباشرة عبر شاحنات المقاول.
                    </p>
                </div>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-200 dark:border-slate-700 flex items-center justify-between text-[11px] font-bold text-slate-600 dark:text-slate-300">
                <span>تفريغ ذاتي:</span>
                <span class="text-emerald-600 dark:text-emerald-400 font-mono">0.00 د.أ</span>
            </div>
        </label>
    </div>

    <!-- Capacity Overflow Callout (منجم الأرباح: Scenario 2) -->
    <div class="p-6 rounded-3xl bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white shadow-xl relative overflow-hidden flex flex-col md:flex-row items-center justify-between gap-6 border border-slate-700/60">
        <div class="space-y-2 max-w-xl">
            <div class="flex items-center gap-2">
                <span class="px-2.5 py-0.5 rounded-full bg-amber-500 text-slate-950 font-black text-[11px] flex items-center gap-1">
                    <span class="material-symbols-outlined text-sm">bolt</span>
                    <span>ميزة الفائض اللوجستي (Capacity Overflow)</span>
                </span>
                <span class="text-xs text-amber-400 font-mono font-bold">1-Click Broadcast</span>
            </div>
            <h4 class="text-base font-black text-white">هل تواجه ضغط طلبات يفوق سعة شاحنات أسطولك الخاص؟</h4>
            <p class="text-xs text-slate-300 leading-relaxed">
                لا ترفض أي طلب توريد إنشائي مربح! بنقرة واحدة، قم بإسناد الشحنات الفائضة لشبكة كباتن بلوكو المعتمدين. نوفر لك تسعيرة النقل القياسية، ونظام الضمان المالي (Escrow) لحماية مستحقاتك بالكامل مع كود OTP الميداني.
            </p>
        </div>
        <div class="shrink-0 flex flex-col sm:flex-row items-center gap-3">
            <button type="button" onclick="openCapacityOverflowModal(10422, 'BLK-10422', 'حجر رويشد مفجر', 20.0, 'البلقاء - الفحيص', 35.0)"
                    class="px-6 py-3.5 rounded-2xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-slate-950 font-black text-xs shadow-xl shadow-amber-500/25 transition-all flex items-center gap-2 cursor-pointer">
                <span class="material-symbols-outlined text-base">sensors</span>
                <span>إسناد الفائض لشبكة كباتن بلوكو</span>
            </button>
            <a asp-action="Dispatch"
               class="px-5 py-3.5 rounded-2xl bg-white/10 hover:bg-white/20 text-white font-bold text-xs transition border border-white/10 flex items-center gap-1.5">
                <span class="material-symbols-outlined text-base">format_list_bulleted</span>
                <span>استعراض شحنات التوريد</span>
            </a>
        </div>
    </div>
</div>
