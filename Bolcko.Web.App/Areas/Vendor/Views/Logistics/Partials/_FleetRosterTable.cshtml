@{
    var vehicles = ViewBag.Vehicles as IEnumerable<Bolcko.Domain.Entities.Delivery.DTOs.VendorFleetVehicleDto> ?? Enumerable.Empty<Bolcko.Domain.Entities.Delivery.DTOs.VendorFleetVehicleDto>();
}

<div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-100 dark:border-slate-800 shadow-sm overflow-hidden">
    <div class="p-6 border-b border-slate-100 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-purple-500/10 text-purple-600 dark:text-purple-400 flex items-center justify-center font-bold text-lg">
                🚛
            </div>
            <div>
                <h3 class="text-sm font-black text-slate-900 dark:text-white">سجل شاحنات الأسطول والسائقين المسجلين</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">متابعة جاهزية الشاحنات، حمولة الأوزان القصوى، والسائقين المخصصين</p>
            </div>
        </div>
        <a asp-action="Dispatch" class="px-5 py-2.5 rounded-xl bg-slate-900 dark:bg-white dark:text-slate-900 text-white font-bold text-xs hover:bg-slate-800 dark:hover:bg-slate-100 transition-colors flex items-center gap-1.5 self-start sm:self-auto">
            <span class="material-symbols-outlined text-sm">schedule_send</span>
            <span>لوحة أوامر الشحن والتحميل</span>
        </a>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-right text-xs">
            <thead class="bg-slate-50 dark:bg-slate-800/50 text-slate-400 font-bold border-b border-slate-100 dark:border-slate-800">
                <tr>
                    <th class="p-4">رقم اللوحة</th>
                    <th class="p-4">نوع الشاحنة والمعدة</th>
                    <th class="p-4">الحمولة القصوى</th>
                    <th class="p-4">السائق المسؤول</th>
                    <th class="p-4">رقم الاتصال</th>
                    <th class="p-4 text-center">ونش تفريغ</th>
                    <th class="p-4 text-center">الحالة التشغيلية</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                @foreach (var v in vehicles)
                {
                    <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/20 transition-colors">
                        <td class="p-4 font-mono font-bold text-slate-900 dark:text-white">@v.PlateNumber</td>
                        <td class="p-4 font-bold text-slate-800 dark:text-slate-200">@v.VehicleType</td>
                        <td class="p-4 font-mono font-bold text-amber-600 dark:text-amber-400">@v.MaxCapacityTons طن</td>
                        <td class="p-4 font-bold text-slate-800 dark:text-slate-200">@v.DriverName</td>
                        <td class="p-4 font-mono text-slate-500 dark:text-slate-400">@v.DriverPhone</td>
                        <td class="p-4 text-center">
                            @if (v.HasCrane)
                            {
                                <span class="px-2 py-0.5 rounded-full bg-sky-100 dark:bg-sky-950 text-sky-700 dark:text-sky-300 text-[10px] font-bold">مجهز بونش</span>
                            }
                            else
                            {
                                <span class="text-slate-400">-</span>
                            }
                        </td>
                        <td class="p-4 text-center">
                            @if (v.IsAvailable)
                            {
                                <span class="px-2.5 py-1 rounded-xl text-[10px] font-bold bg-emerald-500/10 text-emerald-500">جاهز للتحميل</span>
                            }
                            else
                            {
                                <span class="px-2.5 py-1 rounded-xl text-[10px] font-bold bg-amber-500/10 text-amber-500">في مهمة توريد</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
