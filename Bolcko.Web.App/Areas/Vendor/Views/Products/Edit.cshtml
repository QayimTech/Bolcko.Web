@model Bolcko.Domain.Entities.Product.Product
@{
    ViewData["Title"] = "تعديل مادة البناء";
    Layout = "~/Areas/Vendor/Views/Shared/_Layout.cshtml";
    var categories = ViewBag.Categories as IEnumerable<Bolcko.Domain.Entities.Catalog.Category> ?? Enumerable.Empty<Bolcko.Domain.Entities.Catalog.Category>();
}

<div class="max-w-4xl mx-auto space-y-6" dir="rtl">
    <div class="flex items-center justify-between bg-white dark:bg-slate-900 p-6 rounded-3xl border border-slate-100 dark:border-slate-800 shadow-sm">
        <div>
            <h1 class="text-xl font-black text-slate-900 dark:text-white">تعديل: @Model.Name</h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">تحديث الأسعار، المخزون، وحالة التوفر في المتجر</p>
        </div>
        <a asp-action="Index" class="px-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-bold text-xs">
            عودة للكتالوج
        </a>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="bg-white dark:bg-slate-900 p-8 rounded-3xl border border-slate-100 dark:border-slate-800 shadow-sm space-y-6">
        @Html.AntiForgeryToken()

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">اسم المنتج *</label>
                <input type="text" asp-for="Name" required class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold text-slate-800 dark:text-white" />
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">القسم الرئيسي *</label>
                <select asp-for="CategoryId" required class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold text-slate-800 dark:text-white">
                    @foreach (var c in categories)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
                <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">سعر البيع (د.أ) *</label>
                <input type="number" step="0.01" asp-for="RetailPrice" required class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold text-slate-800 dark:text-white font-mono" />
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">وحدة القياس *</label>
                <input type="text" asp-for="UnitOfMeasure" required class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold text-slate-800 dark:text-white" />
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">الكمية المتوفرة *</label>
                <input type="number" asp-for="StockQuantity" required class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold text-slate-800 dark:text-white font-mono" />
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
                <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">العلامة التجارية</label>
                <input type="text" asp-for="Brand" class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold text-slate-800 dark:text-white" />
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">حالة المنتج</label>
                <select asp-for="Status" class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold text-slate-800 dark:text-white">
                    <option value="@Bolcko.Domain.Enums.ProductStatus.InStock">متاح للطلب (متوفر بالمخزون)</option>
                    <option value="@Bolcko.Domain.Enums.ProductStatus.OutOfStock">نفذ من المخزون</option>
                    <option value="@Bolcko.Domain.Enums.ProductStatus.PreOrder">طلب مسبق (تصنيع عند الطلب)</option>
                    <option value="@Bolcko.Domain.Enums.ProductStatus.Discontinued">غير متوفر حالياً</option>
                </select>
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">رابط الصورة</label>
                <input type="text" asp-for="ImageUrl" class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold text-slate-800 dark:text-white" />
            </div>
        </div>

        <div>
            <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">الوصف والمواصفات</label>
            <textarea asp-for="Description" rows="4" class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold text-slate-800 dark:text-white"></textarea>
        </div>

        <div class="flex items-center gap-3">
            <input type="checkbox" asp-for="IsOversized" id="editOversized" class="w-4 h-4 text-amber-500 rounded" />
            <label for="editOversized" class="text-xs font-bold text-slate-700 dark:text-slate-300">بضاعة ثقيلة تتطلب شاحنات نقل مخصصة</label>
        </div>

        <!-- Comprehensive Vendor SEO Engine Suite -->
        @{
            var seo = ViewBag.SeoMetadata as Bolcko.Domain.Entities.SEO.SEOMetadata;
            var currentTitle = seo?.PageTitle ?? $"{Model.Name} | BLOCKO";
            var currentDesc = seo?.MetaDescription ?? Model.Description ?? "";
            var currentKeywords = seo?.MetaKeywords ?? $"{Model.Name}, توريد مواد بناء, أسعار مواد البناء الأردن";
        }
        <div class="p-6 rounded-3xl bg-gradient-to-br from-slate-900 to-[#151B26] text-white border border-sky-500/20 shadow-xl space-y-6">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-white/10">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-sky-500/20 text-sky-400 flex items-center justify-center font-black">
                        <span class="material-symbols-outlined text-[22px]">travel_explore</span>
                    </div>
                    <div>
                        <h3 class="text-sm font-black text-white flex items-center gap-2">
                            <span>محرك تحسين محركات البحث والظهور في Google</span>
                            <span class="px-2 py-0.5 rounded-full bg-sky-500/20 text-sky-300 text-[10px] font-bold border border-sky-500/30">B2B SEO Suite</span>
                        </h3>
                        <p class="text-[11px] text-slate-400 mt-0.5">اجعل مادتك تظهر في أولى نتائج بحث المقاولين والشركات عند البحث عن مواد البناء في الأردن</p>
                    </div>
                </div>
                <button type="button" onclick="autoGenerateSeo()"
                        class="px-4 py-2 rounded-xl bg-sky-500/20 hover:bg-sky-500/30 text-sky-300 border border-sky-500/40 text-xs font-black transition-all flex items-center gap-1.5 self-start sm:self-auto shadow-sm">
                    <span class="material-symbols-outlined text-[16px]">auto_awesome</span>
                    <span>توليد SEO ذكي تلقائياً</span>
                </button>
            </div>

            <!-- Google Search Live Preview Card -->
            <div class="p-4 rounded-2xl bg-white text-slate-900 shadow-md border border-slate-200">
                <div class="text-[11px] font-bold text-slate-400 uppercase mb-2 flex items-center justify-between">
                    <span class="flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                        معاينة حية لشكل ظهور المنتج في نتائج بحث Google:
                    </span>
                    <span id="seoScoreBadge" class="text-[10px] px-2 py-0.5 rounded-md bg-emerald-100 text-emerald-800 font-black">مؤشر الجودة: ممتاز (95/100)</span>
                </div>
                <div class="font-sans text-start space-y-1">
                    <div class="flex items-center gap-2 text-xs text-slate-600">
                        <span class="w-4 h-4 rounded-full bg-[#E8A020] text-[#151B26] font-black text-[9px] flex items-center justify-center">B</span>
                        <span class="text-slate-800 font-medium">https://blocko.jo › shop › product › @Model.Id</span>
                    </div>
                    <h4 id="googlePreviewTitle" class="text-base font-medium text-[#1a0dab] hover:underline cursor-pointer truncate">
                        @currentTitle
                    </h4>
                    <p id="googlePreviewDesc" class="text-xs text-[#4d5156] line-clamp-2 leading-relaxed">
                        @(!string.IsNullOrWhiteSpace(currentDesc) ? currentDesc : "اطلب أفضل مواد البناء والتوريدات الإنشائية مباشرة من المصانع والموردين المعتمدين مع تسهيلات المرابحة والتوصيل لكافة المحافظات.")
                    </p>
                </div>
            </div>

            <!-- SEO Inputs -->
            <div class="space-y-4">
                <div>
                    <div class="flex items-center justify-between mb-1">
                        <label class="block text-xs font-bold text-slate-300">عنوان الصفحة في Google (Meta Title)</label>
                        <span id="titleCounter" class="text-[10px] font-mono text-slate-400">@currentTitle.Length / 60 حرف</span>
                    </div>
                    <input type="text" name="metaTitle" id="metaTitleInput" value="@seo?.PageTitle" oninput="updateSeoPreview()" placeholder="مثال: حديد تسليح 12 ملم أردني Grade 60 - توريد مباشر"
                           class="w-full px-4 py-2.5 bg-slate-800/80 border border-slate-700 rounded-xl text-xs font-bold text-white focus:border-sky-500 focus:outline-none" />
                </div>

                <div>
                    <div class="flex items-center justify-between mb-1">
                        <label class="block text-xs font-bold text-slate-300">وصف المنتج في محركات البحث (Meta Description)</label>
                        <span id="descCounter" class="text-[10px] font-mono text-slate-400">@(seo?.MetaDescription?.Length ?? 0) / 160 حرف</span>
                    </div>
                    <textarea name="metaDescription" id="metaDescriptionInput" rows="2" oninput="updateSeoPreview()" placeholder="اكتب وصفاً جذاباً يشمل الكلمات المفتاحية وسعر التوريد وميزة التوصيل..."
                              class="w-full px-4 py-2.5 bg-slate-800/80 border border-slate-700 rounded-xl text-xs font-medium text-white focus:border-sky-500 focus:outline-none">@seo?.MetaDescription</textarea>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-300 mb-1">الكلمات المفتاحية والوسوم (Meta Keywords - مفصولة بفواصل)</label>
                    <input type="text" name="metaKeywords" id="metaKeywordsInput" value="@seo?.MetaKeywords" placeholder="حديد تسليح, أسعار مواد البناء الأردن, توريد مشاريع, إسمنت, خرسانة"
                           class="w-full px-4 py-2.5 bg-slate-800/80 border border-slate-700 rounded-xl text-xs font-bold text-white focus:border-sky-500 focus:outline-none" />
                </div>
            </div>
        </div>

        <div class="flex items-center justify-end gap-3 pt-6 border-t border-slate-100 dark:border-slate-800">
            <a asp-action="Index" class="px-5 py-2.5 text-xs font-bold text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-xl transition-colors">إلغاء</a>
            <button type="submit" class="px-8 py-3 rounded-2xl bg-gradient-to-r from-amber-500 to-amber-600 text-slate-900 font-black text-xs shadow-lg shadow-amber-500/20 transition-all">حفظ التغييرات وضبط الـ SEO</button>
        </div>
    </form>
</div>

<script>
    function updateSeoPreview() {
        const titleInput = document.getElementById('metaTitleInput');
        const descInput = document.getElementById('metaDescriptionInput');
        const prodName = document.querySelector('input[name="Name"]')?.value || 'اسم مادة البناء';
        
        const title = titleInput.value.trim() || `${prodName} | BLOCKO Jordan`;
        const desc = descInput.value.trim() || 'اطلب أفضل مواد البناء والتوريدات الإنشائية مباشرة من المصانع والموردين المعتمدين مع تسهيلات المرابحة والتوصيل لكافة المحافظات.';

        document.getElementById('googlePreviewTitle').textContent = title;
        document.getElementById('googlePreviewDesc').textContent = desc;

        // Counters
        const titleLen = titleInput.value.length;
        const descLen = descInput.value.length;
        
        const titleCounter = document.getElementById('titleCounter');
        titleCounter.textContent = `${titleLen} / 60 حرف`;
        titleCounter.className = `text-[10px] font-mono ${titleLen >= 35 && titleLen <= 60 ? 'text-emerald-400 font-bold' : (titleLen > 60 ? 'text-rose-400 font-bold' : 'text-slate-400')}`;

        const descCounter = document.getElementById('descCounter');
        descCounter.textContent = `${descLen} / 160 حرف`;
        descCounter.className = `text-[10px] font-mono ${descLen >= 100 && descLen <= 160 ? 'text-emerald-400 font-bold' : (descLen > 160 ? 'text-rose-400 font-bold' : 'text-slate-400')}`;

        // SEO Health Badge
        const badge = document.getElementById('seoScoreBadge');
        if (titleLen >= 30 && descLen >= 80) {
            badge.textContent = 'مؤشر الجودة: ممتاز (98/100)';
            badge.className = 'text-[10px] px-2 py-0.5 rounded-md bg-emerald-100 text-emerald-800 font-black';
        } else if (titleLen >= 15 || descLen >= 40) {
            badge.textContent = 'مؤشر الجودة: جيد (70/100)';
            badge.className = 'text-[10px] px-2 py-0.5 rounded-md bg-amber-100 text-amber-800 font-black';
        } else {
            badge.textContent = 'مؤشر الجودة: بحاجة لتحسين';
            badge.className = 'text-[10px] px-2 py-0.5 rounded-md bg-rose-100 text-rose-800 font-black';
        }
    }

    function autoGenerateSeo() {
        const prodName = document.querySelector('input[name="Name"]')?.value || '';
        const brand = document.querySelector('input[name="Brand"]')?.value || '';
        const price = document.querySelector('input[name="RetailPrice"]')?.value || '';
        const unit = document.querySelector('input[name="UnitOfMeasure"]')?.value || '';
        
        if (!prodName) {
            alert('يرجى كتابة اسم المنتج أولاً لتوليد بيانات الـ SEO بناءً عليه.');
            return;
        }

        const brandSuffix = brand ? ` ماركة ${brand}` : '';
        const priceSuffix = price && unit ? ` بسعر ${price} د.أ/${unit}` : '';
        
        const genTitle = `${prodName}${brandSuffix} - توريد مباشر ومواصفات معتمدة | BLOCKO`;
        const genDesc = `احصل على ${prodName}${brandSuffix}${priceSuffix} بأعلى مواصفات الجودة المعتمدة في الأردن مع خيارات تمويل المرابحة والتوصيل السريع للموقع الإنشائي.`;
        const genKeywords = `${prodName}, ${brand ? brand + ', ' : ''}توريد مواد بناء, أسعار مواد البناء الأردن, بلوكو, مواد إنشائية, شحن مباشر للموقع`;

        document.getElementById('metaTitleInput').value = genTitle.substring(0, 65);
        document.getElementById('metaDescriptionInput').value = genDesc.substring(0, 160);
        document.getElementById('metaKeywordsInput').value = genKeywords;

        updateSeoPreview();
    }

    // Run preview update on page load
    document.addEventListener('DOMContentLoaded', updateSeoPreview);
</script>
