@model IEnumerable<Bolcko.Domain.Entities.Product.Product>
@{
    ViewData["Title"] = "إدارة منتجات ومواد البناء";
    Layout = "~/Areas/Vendor/Views/Shared/_Layout.cshtml";
    var categories = ViewBag.Categories as IEnumerable<Bolcko.Domain.Entities.Catalog.Category> ?? Enumerable.Empty<Bolcko.Domain.Entities.Catalog.Category>();
}

<div class="space-y-6" dir="rtl">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white dark:bg-slate-900 p-6 rounded-3xl border border-slate-100 dark:border-slate-800 shadow-sm">
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-2xl bg-amber-500/10 text-amber-500 flex items-center justify-center font-black text-2xl ring-8 ring-amber-500/5">
                📦
            </div>
            <div>
                <h1 class="text-xl font-black text-slate-900 dark:text-white">كتالوج ومخزون مواد البناء</h1>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                    إدارة أسعار المواد الإنشائية، ضبط الكميات المتوفرة، وتعديل المواصفات الفنية
                </p>
            </div>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <a asp-action="ClaimQannas"
               class="px-4 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 font-bold text-xs transition-colors flex items-center gap-1.5 border border-slate-200 dark:border-slate-700">
                <span>🎯</span>
                <span>تخصيص بضائع القناص</span>
            </a>
            <a asp-action="Create"
               class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-slate-900 font-black text-xs shadow-lg shadow-amber-500/20 transition-all flex items-center gap-1.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"></path></svg>
                <span>إضافة منتج جديد</span>
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 font-bold text-sm flex items-center gap-2">
            <span>✅</span> <span>@TempData["Success"]</span>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="p-4 rounded-2xl bg-rose-500/10 border border-rose-500/20 text-rose-600 dark:text-rose-400 font-bold text-sm flex items-center gap-2">
            <span>⚠️</span> <span>@TempData["Error"]</span>
        </div>
    }

    <!-- Search & Filter Filter Bar -->
    <div class="bg-white dark:bg-slate-900 p-4 rounded-2xl border border-slate-100 dark:border-slate-800 shadow-sm">
        <form method="get" class="flex flex-col sm:flex-row gap-3">
            <div class="flex-1 relative">
                <input type="text" name="search" value="@Context.Request.Query["search"]" placeholder="ابحث باسم المادة، الباركود SKU، أو الماركة..."
                       class="w-full pl-10 pr-4 py-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold text-slate-800 dark:text-white" />
            </div>
            <div class="w-full sm:w-56">
                <select name="categoryId" class="w-full px-3 py-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold text-slate-800 dark:text-white">
                    <option value="">جميع الأقسام</option>
                    @foreach (var c in categories)
                    {
                        <option value="@c.Id" selected="@(Context.Request.Query["categoryId"] == c.Id.ToString())">@c.Name</option>
                    }
                </select>
            </div>
            <button type="submit" class="px-6 py-2.5 bg-slate-900 dark:bg-white dark:text-slate-900 text-white font-bold text-xs rounded-xl transition-colors">
                بحث وتصفية
            </button>
        </form>
    </div>

    <!-- Products Grid -->
    @if (!Model.Any())
    {
        <div class="text-center py-16 bg-white dark:bg-slate-900 rounded-3xl border border-slate-100 dark:border-slate-800 p-8">
            <div class="w-16 h-16 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center mx-auto mb-4 text-2xl text-slate-400">
                📦
            </div>
            <h3 class="text-base font-bold text-slate-800 dark:text-white mb-1">لا توجد مواد بناء مسجلة حالياً في متجرك</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 mb-6 max-w-sm mx-auto">
                ابدأ بإضافة منتجاتك وتحديد مواصفات التوريد أو استورد بضائع القناص المعتمدة بنقرة واحدة
            </p>
            <div class="flex items-center justify-center gap-3">
                <a asp-action="ClaimQannas" class="px-4 py-2 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 font-bold text-xs rounded-xl">تخصيص من القناص</a>
                <a asp-action="Create" class="px-4 py-2 bg-amber-500 hover:bg-amber-600 text-slate-900 font-bold text-xs rounded-xl shadow-md">إضافة مادة جديدة</a>
            </div>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            @foreach (var item in Model)
            {
                <div class="bg-white dark:bg-slate-900 rounded-3xl p-5 border border-slate-100 dark:border-slate-800 shadow-sm flex flex-col justify-between hover:border-amber-500/40 transition-all">
                    <div>
                        <div class="flex items-center gap-4 mb-4">
                            <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/placeholder-product.png" : item.ImageUrl)"
                                 alt="@item.Name" class="w-16 h-16 rounded-2xl object-cover bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-800 shrink-0" />
                            <div class="flex-1 min-w-0">
                                <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 mb-1">
                                    @(item.Category?.Name ?? "مواد بناء")
                                </span>
                                <h3 class="text-sm font-black text-slate-900 dark:text-white truncate">@item.Name</h3>
                                <p class="text-[11px] text-slate-400 font-mono">SKU: @item.Sku</p>
                            </div>
                        </div>

                        <div class="space-y-2 py-3 border-y border-slate-100 dark:border-slate-800 text-xs">
                            <div class="flex justify-between">
                                <span class="text-slate-400">سعر البيع:</span>
                                <strong class="text-amber-600 dark:text-amber-400 font-mono text-sm">@item.RetailPrice.ToString("N2") د.أ / @item.UnitOfMeasure</strong>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-slate-400">المخزون المتوفر:</span>
                                <strong class="text-slate-800 dark:text-slate-200 font-mono">@item.StockQuantity @item.UnitOfMeasure</strong>
                            </div>
                            @if (!string.IsNullOrEmpty(item.Brand))
                            {
                                <div class="flex justify-between">
                                    <span class="text-slate-400">الماركة / المصنع:</span>
                                    <strong class="text-slate-800 dark:text-slate-200">@item.Brand</strong>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="mt-4 pt-3 flex items-center justify-between">
                        <span class="px-2.5 py-1 rounded-xl text-[10px] font-bold @(item.Status == Bolcko.Domain.Enums.ProductStatus.InStock ? "bg-emerald-500/10 text-emerald-500" : "bg-slate-200 text-slate-500")">
                            @(item.Status == Bolcko.Domain.Enums.ProductStatus.InStock ? "متاح للطلب" : "غير متاح")
                        </span>
                        <a asp-action="Edit" asp-route-id="@item.Id"
                           class="px-4 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 font-bold text-xs transition-colors">
                            تعديل المنتج
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>
