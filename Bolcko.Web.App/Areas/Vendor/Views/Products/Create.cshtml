@model Bolcko.Domain.Entities.Product.Product
@{
    ViewData["Title"] = "إضافة مادة بناء جديدة";
    Layout = "~/Areas/Vendor/Views/Shared/_Layout.cshtml";
}

<div class="max-w-4xl mx-auto space-y-6" dir="rtl">
    <!-- Header -->
    <div class="flex items-center justify-between bg-white dark:bg-slate-900 p-6 rounded-3xl border border-slate-100 dark:border-slate-800 shadow-sm">
        <div class="flex items-center gap-3.5">
            <div class="w-12 h-12 rounded-2xl bg-amber-500/10 text-amber-500 flex items-center justify-center font-black text-xl">
                ➕
            </div>
            <div>
                <h1 class="text-xl font-black text-slate-900 dark:text-white">إضافة مادة بناء / توريد جديد</h1>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">حدد نوع المادة ومواصفاتها الإنشائية لإضافتها فوراً لسوق التوريد وعطاءات التمويل</p>
            </div>
        </div>
        <a asp-action="Index" class="px-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 font-bold text-xs transition-colors">
            عودة للكتالوج
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="p-4 rounded-2xl bg-rose-500/10 border border-rose-500/20 text-rose-600 dark:text-rose-400 font-bold text-sm flex items-center gap-2">
            <span>⚠️</span> <span>@TempData["Error"]</span>
        </div>
    }

    <!-- Form -->
    <form asp-action="Create" method="post" class="space-y-6">
        @Html.AntiForgeryToken()

        <!-- 1. Engineering Material Specs & Presets -->
        <partial name="Partials/_ProductDynamicSpecs" />

        <!-- 2. Basic Info & Pricing Details -->
        <partial name="Partials/_ProductBasicInfo" model="Model" />

        <!-- 3. B2B Wholesale Pricing Matrix -->
        <partial name="Partials/_ProductWholesaleTiers" model="Model" />

        <!-- 4. Comprehensive B2B SEO Suite -->
        <partial name="Partials/_ProductSeoMeta" model="Model" />

        <!-- Action Buttons -->
        <div class="flex items-center justify-end gap-3 pt-2">
            <a asp-action="Index" class="px-6 py-3 text-xs font-bold text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-2xl transition-colors">إلغاء</a>
            <button type="submit" class="px-8 py-3.5 rounded-2xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-slate-900 font-black text-xs shadow-xl shadow-amber-500/20 transition-all flex items-center gap-2">
                <span class="material-symbols-outlined text-base">publish</span>
                <span>نشر المادة في المتجر مع ضبط الـ SEO</span>
            </button>
        </div>
    </form>
</div>
