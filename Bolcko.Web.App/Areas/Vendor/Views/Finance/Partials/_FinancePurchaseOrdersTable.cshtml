@model IEnumerable<Bolcko.Domain.Entities.Order.OrderItem>
@{
    decimal commissionRate = ViewBag.CommissionRate ?? 2.5m;
}

<div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-100 dark:border-slate-800 shadow-sm overflow-hidden">
    <div class="p-5 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
        <h3 class="text-sm font-black text-slate-900 dark:text-white">سجل أوامر الشراء والتوريد (Purchase Orders)</h3>
        <span class="text-xs font-bold text-slate-400 font-mono">@Model.Count() عملية توريد</span>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-12 text-slate-400 text-xs font-bold">
            لا توجد طلبات توريد مسجلة حتى الآن.
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-right text-xs">
                <thead class="bg-slate-50 dark:bg-slate-800/50 text-slate-400 font-bold border-b border-slate-100 dark:border-slate-800">
                    <tr>
                        <th class="p-4">رقم الطلب (PO)</th>
                        <th class="p-4">المادة المطلوبة</th>
                        <th class="p-4">الكمية</th>
                        <th class="p-4">سعر الوحدة</th>
                        <th class="p-4">الإجمالي</th>
                        <th class="p-4">صافي المورد (@(100 - commissionRate)%)</th>
                        <th class="p-4">حالة الطلب</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                    @foreach (var oi in Model)
                    {
                        var itemTotal = oi.UnitPrice * oi.Quantity;
                        var itemNet = itemTotal * (1 - (commissionRate / 100m));
                        <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/20 transition-colors">
                            <td class="p-4 font-mono font-bold text-slate-900 dark:text-white">#@oi.OrderId</td>
                            <td class="p-4 font-bold text-slate-800 dark:text-slate-200">@(oi.Product?.Name ?? "مادة بناء")</td>
                            <td class="p-4 font-mono">@oi.Quantity</td>
                            <td class="p-4 font-mono">@oi.UnitPrice.ToString("N2") د.أ</td>
                            <td class="p-4 font-mono font-bold text-slate-900 dark:text-white">@itemTotal.ToString("N2") د.أ</td>
                            <td class="p-4 font-mono font-bold text-emerald-500">@itemNet.ToString("N2") د.أ</td>
                            <td class="p-4">
                                <span class="px-2.5 py-1 rounded-xl text-[10px] font-bold @(oi.Order?.Status == Bolcko.Domain.Enums.OrderStatus.Delivered ? "bg-emerald-500/10 text-emerald-500" : "bg-amber-500/10 text-amber-500")">
                                    @(oi.Order?.Status.ToString() ?? "قيد المعالجة")
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
