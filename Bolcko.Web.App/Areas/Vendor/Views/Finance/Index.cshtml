@model IEnumerable<Bolcko.Domain.Entities.Order.OrderItem>
@{
    ViewData["Title"] = "البيانات المالية والأرباح";
    Layout = "~/Areas/Vendor/Views/Shared/_Layout.cshtml";
    decimal commissionRate = ViewBag.CommissionRate ?? 2.5m;
}

<div class="space-y-6" dir="rtl">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white dark:bg-slate-900 p-6 sm:p-8 rounded-3xl border border-slate-100 dark:border-slate-800 shadow-sm">
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-2xl bg-emerald-500/10 text-emerald-500 flex items-center justify-center font-black text-2xl ring-8 ring-emerald-500/5">
                💰
            </div>
            <div>
                <h1 class="text-xl font-black text-slate-900 dark:text-white">المحفظة المالية والأرباح</h1>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                    متابعة إجمالي مبيعات التوريد، عمولة المنصة المقتطعة (@commissionRate%)، وصافي المستحقات الجاهزة للتحويل
                </p>
            </div>
        </div>
        <button type="button" onclick="openPayoutModal()"
                class="px-6 py-3 rounded-2xl bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-600 hover:to-emerald-700 text-white font-black text-xs shadow-lg shadow-emerald-500/20 transition-all flex items-center justify-center gap-2">
            <span>💳</span>
            <span>طلب تحويل بنكي / CliQ</span>
        </button>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 font-bold text-sm flex items-center gap-2">
            <span>✅</span> <span>@TempData["Success"]</span>
        </div>
    }

    <!-- 1. Financial KPI Cards Grid -->
    <partial name="Partials/_FinanceKpiCards" />

    <!-- 2. Purchase Orders & Supply Ledger -->
    <partial name="Partials/_FinancePurchaseOrdersTable" model="Model" />

</div>

<!-- 3. Payout Request Modal -->
<partial name="Partials/_PayoutRequestModal" />
