@model IEnumerable<Bolcko.Domain.Entities.Order.OrderItem>
@{
    ViewData["Title"] = "البيانات المالية والأرباح";
    Layout = "~/Areas/Vendor/Views/Shared/_Layout.cshtml";
    var vendor = ViewBag.Vendor as Bolcko.Domain.Entities.Catalog.VendorProfile;
    decimal grossSales = ViewBag.GrossSales ?? 0m;
    decimal platformFees = ViewBag.PlatformFees ?? 0m;
    decimal netEarnings = ViewBag.NetEarnings ?? 0m;
    decimal availableBalance = ViewBag.AvailableBalance ?? 0m;
    decimal pendingSettlement = ViewBag.PendingSettlement ?? 0m;
    decimal commissionRate = ViewBag.CommissionRate ?? 2.5m;
}

<div class="space-y-6" dir="rtl">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white dark:bg-slate-900 p-6 rounded-3xl border border-slate-100 dark:border-slate-800 shadow-sm">
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-2xl bg-emerald-500/10 text-emerald-500 flex items-center justify-center font-black text-2xl ring-8 ring-emerald-500/5">
                💰
            </div>
            <div>
                <h1 class="text-xl font-black text-slate-900 dark:text-white">المحفظة المالية والأرباح</h1>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                    متابعة إجمالي مبيعات التوريد، عمولة المنصة المقتطعة (@commissionRate%)، وصافي المستحقات الجاهزة للتحويل
                </p>
            </div>
        </div>
        <button type="button" onclick="openPayoutModal()"
                class="px-6 py-3 rounded-2xl bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-600 hover:to-emerald-700 text-white font-black text-xs shadow-lg shadow-emerald-500/20 transition-all flex items-center justify-center gap-2">
            <span>💳</span>
            <span>طلب تحويل بنكي / CliQ</span>
        </button>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 font-bold text-sm flex items-center gap-2">
            <span>✅</span> <span>@TempData["Success"]</span>
        </div>
    }

    <!-- Financial KPI Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white dark:bg-slate-900 p-5 rounded-3xl border border-slate-100 dark:border-slate-800 shadow-sm">
            <span class="text-xs font-bold text-slate-400 block mb-1">إجمالي المبيعات (Gross)</span>
            <div class="flex items-baseline gap-1.5">
                <span class="text-2xl font-black text-slate-900 dark:text-white font-mono">@grossSales.ToString("N2")</span>
                <span class="text-xs text-slate-400 font-bold">د.أ</span>
            </div>
            <span class="text-[10px] text-slate-500 block mt-2">إجمالي قيمة التوريدات المنفذة</span>
        </div>

        <div class="bg-white dark:bg-slate-900 p-5 rounded-3xl border border-slate-100 dark:border-slate-800 shadow-sm">
            <span class="text-xs font-bold text-slate-400 block mb-1">عمولة المنصة (@commissionRate%)</span>
            <div class="flex items-baseline gap-1.5">
                <span class="text-2xl font-black text-rose-500 font-mono">@platformFees.ToString("N2")</span>
                <span class="text-xs text-slate-400 font-bold">د.أ</span>
            </div>
            <span class="text-[10px] text-slate-500 block mt-2">رسوم الخدمة والتسويق والضمان</span>
        </div>

        <div class="bg-white dark:bg-slate-900 p-5 rounded-3xl border border-slate-100 dark:border-slate-800 shadow-sm">
            <span class="text-xs font-bold text-slate-400 block mb-1">صافي الأرباح الكلي</span>
            <div class="flex items-baseline gap-1.5">
                <span class="text-2xl font-black text-emerald-500 font-mono">@netEarnings.ToString("N2")</span>
                <span class="text-xs text-slate-400 font-bold">د.أ</span>
            </div>
            <span class="text-[10px] text-slate-500 block mt-2">بعد اقتطاع رسوم المنصة</span>
        </div>

        <div class="bg-gradient-to-br from-slate-900 to-slate-800 text-white p-5 rounded-3xl border border-slate-700 shadow-lg">
            <span class="text-xs font-bold text-amber-400 block mb-1">الرصيد المتاح للسحب</span>
            <div class="flex items-baseline gap-1.5">
                <span class="text-3xl font-black text-amber-300 font-mono">@availableBalance.ToString("N2")</span>
                <span class="text-xs text-amber-400 font-bold">د.أ</span>
            </div>
            <span class="text-[10px] text-slate-400 block mt-2">جاهز للتحويل الفوري لحسابك</span>
        </div>
    </div>

    <!-- Order Items / Supply Ledger -->
    <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-100 dark:border-slate-800 shadow-sm overflow-hidden">
        <div class="p-5 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
            <h3 class="text-sm font-black text-slate-900 dark:text-white">سجل أوامر الشراء والتوريد (Purchase Orders)</h3>
            <span class="text-xs font-bold text-slate-400">@Model.Count() عملية توريد</span>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-12 text-slate-400 text-xs font-bold">
                لا توجد طلبات توريد مسجلة حتى الآن.
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-right text-xs">
                    <thead class="bg-slate-50 dark:bg-slate-800/50 text-slate-400 font-bold border-b border-slate-100 dark:border-slate-800">
                        <tr>
                            <th class="p-4">رقم الطلب (PO)</th>
                            <th class="p-4">المادة المطلوبة</th>
                            <th class="p-4">الكمية</th>
                            <th class="p-4">سعر الوحدة</th>
                            <th class="p-4">الإجمالي</th>
                            <th class="p-4">صافي المورد (@(100 - commissionRate)%)</th>
                            <th class="p-4">حالة الطلب</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                        @foreach (var oi in Model)
                        {
                            var itemTotal = oi.UnitPrice * oi.Quantity;
                            var itemNet = itemTotal * (1 - (commissionRate / 100m));
                            <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/20 transition-colors">
                                <td class="p-4 font-mono font-bold text-slate-900 dark:text-white">#@oi.OrderId</td>
                                <td class="p-4 font-bold text-slate-800 dark:text-slate-200">@(oi.Product?.Name ?? "مادة بناء")</td>
                                <td class="p-4 font-mono">@oi.Quantity</td>
                                <td class="p-4 font-mono">@oi.UnitPrice.ToString("N2") د.أ</td>
                                <td class="p-4 font-mono font-bold text-slate-900 dark:text-white">@itemTotal.ToString("N2") د.أ</td>
                                <td class="p-4 font-mono font-bold text-emerald-500">@itemNet.ToString("N2") د.أ</td>
                                <td class="p-4">
                                    <span class="px-2.5 py-1 rounded-xl text-[10px] font-bold @(oi.Order.Status == Bolcko.Domain.Enums.OrderStatus.Delivered ? "bg-emerald-500/10 text-emerald-500" : "bg-amber-500/10 text-amber-500")">
                                        @oi.Order.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Payout Modal -->
<div id="payoutModal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-slate-900/70 backdrop-blur-sm">
    <div class="w-full max-w-md bg-white dark:bg-slate-900 rounded-3xl p-6 border border-slate-100 dark:border-slate-800 shadow-2xl space-y-4" dir="rtl">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800">
            <h3 class="text-base font-black text-slate-900 dark:text-white">طلب سحب أرباح التوريد</h3>
            <button type="button" onclick="closePayoutModal()" class="text-slate-400 hover:text-slate-600 dark:hover:text-white text-xl font-bold">&times;</button>
        </div>

        <form asp-action="RequestPayout" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <div>
                <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">المبلغ المطلوب سحبه (د.أ) *</label>
                <input type="number" step="0.01" name="amount" required max="@availableBalance" value="@availableBalance"
                       class="w-full px-3.5 py-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold text-slate-800 dark:text-white font-mono" />
                <span class="text-[10px] text-slate-400 mt-1 block">الحد الأقصى المتاح حالياً: @availableBalance.ToString("N2") د.أ</span>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">طريقة التحويل *</label>
                <select name="payoutMethod" required class="w-full px-3.5 py-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold text-slate-800 dark:text-white">
                    <option value="CliQ">تحويل فوري CliQ (الأردن)</option>
                    <option value="BankTransfer">تحويل بنكي رسمي (IBAN)</option>
                    <option value="Cheque">شيك مصرفي معتمد</option>
                </select>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">بيانات الحساب / معرف CliQ / الآيبان *</label>
                <textarea name="accountDetails" required rows="3" placeholder="اسم البنك، رقم الآيبان IBAN، أو الاسم المستعار في كليك CliQ Alias..."
                          class="w-full px-3.5 py-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold text-slate-800 dark:text-white"></textarea>
            </div>

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100 dark:border-slate-800">
                <button type="button" onclick="closePayoutModal()" class="px-5 py-2.5 text-xs font-bold text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-xl">إلغاء</button>
                <button type="submit" class="px-6 py-2.5 rounded-xl bg-gradient-to-r from-emerald-500 to-emerald-600 text-white font-black text-xs shadow-md">تأكيد طلب التحويل</button>
            </div>
        </form>
    </div>
</div>

<script>
    function openPayoutModal() {
        document.getElementById('payoutModal').classList.remove('hidden');
        document.getElementById('payoutModal').classList.add('flex');
    }
    function closePayoutModal() {
        document.getElementById('payoutModal').classList.add('hidden');
        document.getElementById('payoutModal').classList.remove('flex');
    }
</script>
