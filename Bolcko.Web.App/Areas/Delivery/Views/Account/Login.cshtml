@{
    Layout = null;
    var isArabic = System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("ar");
    ViewData["Title"] = isArabic 
        ? "بوابة تسجيل دخول أساطيل النقل الثقيل | BLOCKO Heavy Logistics" 
        : "Heavy Fleet Login Portal | BLOCKO Heavy Logistics";
}
<!DOCTYPE html>
<html lang="@(isArabic ? "ar" : "en")" dir="@(isArabic ? "rtl" : "ltr")" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    
    <!-- Premium Favicons -->
    <link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png?v=5" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32x32.png?v=5" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicons/favicon-16x16.png?v=5" />
    <link rel="shortcut icon" href="/favicons/favicon.ico?v=5" />

    <!-- Self-hosted Material Symbols font -->
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/material-symbols-outlined.woff2">
    <link rel="stylesheet" href="~/css/material-symbols.css" asp-append-version="true">

    <!-- Fonts: Noto Kufi Arabic + JetBrains Mono + Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Kufi+Arabic:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700;800&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Compiled Tailwind CSS Output -->
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true" />
    
    <style>
        body { font-family: @(isArabic ? "'Noto Kufi Arabic', sans-serif" : "'Inter', system-ui, sans-serif"); }
        .font-mono { font-family: 'JetBrains Mono', monospace; }
    </style>
</head>
<body class="min-h-screen bg-[#080B11] text-slate-100 flex flex-col justify-between selection:bg-amber-500 selection:text-slate-950 relative overflow-x-hidden">

    <!-- Background Industrial Glow Mesh -->
    <div class="fixed inset-0 bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-amber-500/10 via-[#0B0F17] to-[#080B11] pointer-events-none"></div>
    <div class="fixed -top-40 -right-40 w-[30rem] h-[30rem] bg-amber-500/10 rounded-full blur-[100px] pointer-events-none"></div>
    <div class="fixed bottom-0 -left-40 w-[30rem] h-[30rem] bg-blue-600/10 rounded-full blur-[100px] pointer-events-none"></div>

    <!-- Top Minimal Brand Bar -->
    <header class="relative z-10 px-6 sm:px-12 py-5 flex items-center justify-between border-b border-slate-800/60 bg-slate-950/40 backdrop-blur-md">
        <a href="/" class="flex items-center gap-2.5 group">
            <partial name="~/Views/Shared/Partials/_BrandLogo.cshtml" model='(false, false, "dark", "h-8 sm:h-9")' />
            <span class="px-2 py-0.5 rounded-full bg-amber-500/15 text-amber-400 border border-amber-500/30 text-[10px] font-mono font-black tracking-wider">
                HEAVY FLEET
            </span>
        </a>

        <div class="flex items-center gap-3 text-xs">
            <!-- Language Switcher -->
            <form asp-area="" asp-controller="Language" asp-action="SetLanguage" asp-route-returnUrl="@Context.Request.Path" method="post" class="inline">
                @Html.AntiForgeryToken()
                <button type="submit" name="culture" value="@(isArabic ? "en" : "ar")" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white font-mono text-[11px] transition-colors cursor-pointer border border-slate-700">
                    <span class="material-symbols-outlined text-[13px]">language</span>
                    <span>@(isArabic ? "English" : "العربية")</span>
                </button>
            </form>

            <a href="/" class="text-slate-400 hover:text-white transition-colors hidden sm:flex items-center gap-1">
                <span class="material-symbols-outlined text-sm">storefront</span>
                <span>@(isArabic ? "متجر مواد البناء" : "Materials Store")</span>
            </a>
            <span class="text-slate-700 hidden sm:inline">|</span>
            <a href="@Url.Action("Register", "Account", new { area = "Delivery" })" class="px-3 py-1.5 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 border border-amber-500/30 font-bold transition-all">
                @(isArabic ? "تسجيل أسطول جديد (KYC)" : "New Carrier Register (KYC)")
            </a>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="relative z-10 flex-1 flex items-center justify-center p-4 sm:p-8">
        <div class="w-full max-w-5xl grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            
            <!-- Left Info Panel (Reflecting Massive Scale of Blocko) -->
            <div class="lg:col-span-6 space-y-6 text-start">
                
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 text-amber-400 text-xs font-mono font-bold border border-amber-500/20">
                    <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
                    <span>NATIONAL LOGISTICS GRID • JORDAN</span>
                </div>

                <div class="space-y-3">
                    <h1 class="text-2xl sm:text-4xl font-black text-white leading-tight">
                        @(isArabic ? "قمرة تشغيل الأساطيل الثقيلة وتوريدات المشاريع الكبرى" : "Heavy Logistics Cockpit & Enterprise Jobsite Dispatch")
                    </h1>
                    <p class="text-slate-400 text-xs sm:text-sm leading-relaxed max-w-xl">
                        @(isArabic 
                            ? "منظومة ربط ذكية تجمع مصانع الإسمنت، الكسارات، ومستودعات الحديد والخرسانة مع كباتن التريلات وأساطيل 3PL المعتمدة. نظام تتبع رقمي، قبان إلكتروني، وتسويات مالية فورية عبر حساب الضمان." 
                            : "A digital dispatch ecosystem interconnecting cement mills, quarries, steel stockyards, and ready-mix batch plants with verified haulers and 3PL carriers. Featuring weighbridge integration, live tracking, and instant escrow settlements.")
                    </p>
                </div>

                <!-- Enterprise Scale Stats Ribbon -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2">
                    <div class="p-3 rounded-2xl bg-slate-900/80 border border-slate-800">
                        <span class="text-xl sm:text-2xl font-black text-amber-400 font-mono block">+500</span>
                        <span class="text-[10px] text-slate-400 font-bold">@(isArabic ? "شاحنة وتريلا معتمدة" : "Verified Trucks")</span>
                    </div>
                    <div class="p-3 rounded-2xl bg-slate-900/80 border border-slate-800">
                        <span class="text-xl sm:text-2xl font-black text-white font-mono block">+150K</span>
                        <span class="text-[10px] text-slate-400 font-bold">@(isArabic ? "طن مواد تم توريدها" : "Tons Supplied")</span>
                    </div>
                    <div class="p-3 rounded-2xl bg-slate-900/80 border border-slate-800">
                        <span class="text-xl sm:text-2xl font-black text-emerald-400 font-mono block">12</span>
                        <span class="text-[10px] text-slate-400 font-bold">@(isArabic ? "محافظة مغطاة" : "Governorates")</span>
                    </div>
                    <div class="p-3 rounded-2xl bg-slate-900/80 border border-slate-800">
                        <span class="text-xl sm:text-2xl font-black text-blue-400 font-mono block">0.00</span>
                        <span class="text-[10px] text-slate-400 font-bold">@(isArabic ? "عمولة للأسطول الخاص" : "Private Fleet Fee")</span>
                    </div>
                </div>

                <div class="space-y-2 pt-2">
                    <div class="flex items-center gap-2 text-xs text-slate-300">
                        <span class="material-symbols-outlined text-emerald-400 text-sm">verified</span>
                        <span>@(isArabic ? "تكامل القبان الإلكتروني التلقائي" : "Automated Digital Weighbridge Sync")</span>
                    </div>
                    <div class="flex items-center gap-2 text-xs text-slate-300">
                        <span class="material-symbols-outlined text-emerald-400 text-sm">payments</span>
                        <span>@(isArabic ? "صرف فوري لأجور النقل عبر كليك (CliQ Instant Payouts)" : "Instant Freight Payouts via Jordan CliQ Network")</span>
                    </div>
                </div>

            </div>

            <!-- Right: Enterprise Login Terminal Card -->
            <div class="lg:col-span-6 w-full max-w-md mx-auto">
                <div class="bg-slate-900/95 backdrop-blur-2xl rounded-3xl border border-slate-800 p-6 sm:p-8 shadow-2xl shadow-slate-950 space-y-6 text-start">
                    
                    <div class="space-y-1 border-b border-slate-800 pb-4">
                        <div class="flex items-center justify-between">
                            <h2 class="text-base sm:text-lg font-black text-white flex items-center gap-2">
                                <span class="material-symbols-outlined text-amber-500">lock</span>
                                <span>@(isArabic ? "دخول قمرة العمليات" : "Operations Cockpit Login")</span>
                            </h2>
                            <span class="px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 text-[10px] font-mono font-bold border border-emerald-500/20">
                                256-bit Encrypted
                            </span>
                        </div>
                        <p class="text-[11px] text-slate-400">
                            @(isArabic ? "أدخل بيانات الكابتن أو ضابط تشغيل أسطول 3PL للبدء" : "Enter Captain or 3PL Fleet credentials to begin")
                        </p>
                    </div>

                    @if (ViewBag.Error != null)
                    {
                        <div class="p-3.5 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-rose-300 text-xs font-bold flex items-center gap-2">
                            <span class="material-symbols-outlined text-rose-400 text-lg">error</span>
                            <span>@ViewBag.Error</span>
                        </div>
                    }

                    <!-- 1-Click Fast Credentials for Test Cycle -->
                    <div class="p-3 rounded-2xl bg-slate-950 border border-slate-800 space-y-2">
                        <div class="flex items-center justify-between text-[11px] text-slate-400">
                            <span class="font-bold flex items-center gap-1">
                                <span class="material-symbols-outlined text-xs text-amber-400">bolt</span>
                                <span>@(isArabic ? "حسابات دورة الاختبار (1-Click Fill):" : "QA Test Accounts (1-Click):")</span>
                            </span>
                            <span class="text-[10px] text-amber-400 font-mono font-bold">QA PASS</span>
                        </div>
                        <div class="grid grid-cols-2 gap-2">
                            <button type="button" onclick="fillCredentials('driver@blocko.com', 'Driver@2026!')"
                                    class="p-2 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-700/80 text-start transition-all cursor-pointer hover:border-amber-500/40 active:scale-95 group">
                                <div class="text-[11px] font-black text-amber-400 group-hover:text-amber-300 flex items-center gap-1">
                                    <span class="material-symbols-outlined text-xs">local_shipping</span>
                                    <span>@(isArabic ? "كابتن الشاحنة" : "Truck Driver")</span>
                                </div>
                                <div class="text-[9px] text-slate-400 font-mono mt-0.5">driver@blocko.com</div>
                            </button>
                            <button type="button" onclick="fillCredentials('carrier@blocko.com', 'Carrier@2026!')"
                                    class="p-2 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-700/80 text-start transition-all cursor-pointer hover:border-blue-500/40 active:scale-95 group">
                                <div class="text-[11px] font-black text-blue-400 group-hover:text-blue-300 flex items-center gap-1">
                                    <span class="material-symbols-outlined text-xs">domain</span>
                                    <span>@(isArabic ? "أسطول 3PL" : "3PL Carrier")</span>
                                </div>
                                <div class="text-[9px] text-slate-400 font-mono mt-0.5">carrier@blocko.com</div>
                            </button>
                        </div>
                    </div>

                    <!-- Login Form -->
                    <form asp-action="Login" method="post" class="space-y-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                        <div class="space-y-1.5">
                            <label class="block text-xs font-bold text-slate-300">
                                @(isArabic ? "البريد الإلكتروني للناقل أو الكابتن" : "Carrier or Captain Email")
                            </label>
                            <div class="relative">
                                <input id="loginEmail" name="email" type="email" required placeholder="driver@blocko.com"
                                       class="w-full bg-slate-950 border border-slate-700 rounded-xl py-3 px-3.5 pe-10 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent text-xs font-mono" />
                                <span class="material-symbols-outlined absolute end-3 top-3 text-slate-500 text-lg">mail</span>
                            </div>
                        </div>

                        <div class="space-y-1.5">
                            <label class="block text-xs font-bold text-slate-300">
                                @(isArabic ? "كلمة المرور المشفرة" : "Encrypted Password")
                            </label>
                            <div class="relative">
                                <input id="loginPassword" name="password" type="password" required placeholder="••••••••"
                                       class="w-full bg-slate-950 border border-slate-700 rounded-xl py-3 px-3.5 pe-10 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent text-xs font-mono" />
                                <span class="material-symbols-outlined absolute end-3 top-3 text-slate-500 text-lg">lock</span>
                            </div>
                        </div>

                        <button type="submit"
                                class="w-full py-3.5 px-4 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-black text-xs sm:text-sm shadow-xl shadow-amber-950/60 transition-all cursor-pointer flex items-center justify-center gap-2 active:scale-95">
                            <span class="material-symbols-outlined text-lg font-bold">login</span>
                            <span>@(isArabic ? "دخول إلى قمرة القيادة والتشغيل" : "Sign In to Operations Cockpit")</span>
                        </button>
                    </form>

                    <div class="text-center pt-4 border-t border-slate-800 text-xs text-slate-400 space-y-2">
                        <div>
                            <span>@(isArabic ? "ناقل أو كابتن جديد؟" : "New carrier or driver?")</span>
                            <a href="@Url.Action("Register", "Account", new { area = "Delivery" })" class="text-amber-400 font-bold hover:underline ms-1">
                                @(isArabic ? "تقديم طلب اعتماد أسطول (KYC Portal)" : "Apply for Fleet KYC Verification")
                            </a>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </main>

    <!-- Bottom Enterprise Footer -->
    <footer class="relative z-10 px-6 sm:px-12 py-4 border-t border-slate-800/60 bg-slate-950/40 text-[11px] text-slate-500 text-center flex flex-col sm:flex-row items-center justify-between gap-2">
        <p>@(isArabic ? "© 2026 BLOCKO Heavy Logistics Infrastructure. كافة الحقوق محفوظة لمنظومة توريدات البناء." : "© 2026 BLOCKO Heavy Logistics Infrastructure. All rights reserved.")</p>
        <div class="flex items-center gap-4 text-[10px] text-slate-400">
            <span>@(isArabic ? "مركز التنسيق والعمليات: 06-500-0000" : "Dispatch Operations: 06-500-0000")</span>
            <span>•</span>
            <span>@(isArabic ? "المملكة الأردنية الهاشمية" : "Hashemite Kingdom of Jordan")</span>
        </div>
    </footer>

    <script>
        function fillCredentials(email, password) {
            document.getElementById('loginEmail').value = email;
            document.getElementById('loginPassword').value = password;
        }
    </script>
</body>
</html>
