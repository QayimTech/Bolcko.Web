@{
    Layout = null;
    ViewData["Title"] = "تسجيل الدخول - لوحة أسطول النقل والكباتن | بولكو";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    
    <!-- Self-hosted / Fast Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Kufi+Arabic:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
    
    <!-- Compiled Tailwind CSS Output -->
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true" />
    
    <style>
        body { font-family: 'Noto Kufi Arabic', sans-serif; }
        .font-mono { font-family: 'JetBrains Mono', monospace; }
    </style>
</head>
<body class="min-h-screen bg-slate-950 text-slate-100 flex items-center justify-center p-4 sm:p-6 relative overflow-x-hidden selection:bg-blue-500 selection:text-white">

    <!-- Background Atmospheric Lighting -->
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-blue-900/30 via-slate-950 to-slate-950 pointer-events-none"></div>
    <div class="absolute -top-32 -left-32 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="w-full max-w-md relative z-10 space-y-6">
        
        <!-- Main Card -->
        <div class="bg-slate-900/90 backdrop-blur-xl rounded-3xl border border-slate-800 p-6 sm:p-8 shadow-2xl space-y-6 text-right" dir="rtl">
            
            <!-- Branding Header -->
            <div class="text-center space-y-3">
                <div class="w-16 h-16 bg-gradient-to-tr from-blue-600 to-indigo-500 text-white rounded-2xl flex items-center justify-center mx-auto shadow-xl shadow-blue-500/20 ring-4 ring-blue-500/10">
                    <span class="material-symbols-outlined text-3xl">local_shipping</span>
                </div>
                <div>
                    <h1 class="text-xl sm:text-2xl font-black text-white">لوحة أسطول النقل والكباتن</h1>
                    <p class="text-xs text-slate-400 mt-1">بوابة الدخول الموحدة للناقلين الأحرار وشركات 3PL</p>
                </div>
            </div>

            <!-- Error Banner -->
            @if (ViewBag.Error != null)
            {
                <div class="p-4 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-rose-300 text-xs font-bold flex items-center gap-2.5">
                    <span class="material-symbols-outlined text-rose-400 text-lg">error</span>
                    <span>@ViewBag.Error</span>
                </div>
            }

            <!-- Quick Demo Credentials Pills (One-Click Testing) -->
            <div class="p-3 rounded-2xl bg-slate-950/80 border border-slate-800 space-y-2">
                <div class="flex items-center justify-between text-[11px] text-slate-400">
                    <span class="font-bold flex items-center gap-1">
                        <span class="material-symbols-outlined text-xs text-amber-400">key</span>
                        <span>بيانات الحسابات التجريبية (1-Click Fill):</span>
                    </span>
                    <span class="text-[10px] text-blue-400 font-mono">Test Mode</span>
                </div>
                <div class="grid grid-cols-2 gap-2">
                    <button type="button" onclick="fillCredentials('driver@blocko.com', 'Driver@2026!')"
                            class="py-2 px-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 text-[11px] font-bold transition-all text-center flex flex-col items-center justify-center gap-0.5 cursor-pointer hover:border-blue-500/40 active:scale-95">
                        <span class="text-blue-400 font-black">🚚 كابتن شاحنة</span>
                        <span class="text-[9px] text-slate-400 font-mono">driver@blocko.com</span>
                    </button>
                    <button type="button" onclick="fillCredentials('carrier@blocko.com', 'Carrier@2026!')"
                            class="py-2 px-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 text-[11px] font-bold transition-all text-center flex flex-col items-center justify-center gap-0.5 cursor-pointer hover:border-amber-500/40 active:scale-95">
                        <span class="text-amber-400 font-black">🏢 شركة أسطول 3PL</span>
                        <span class="text-[9px] text-slate-400 font-mono">carrier@blocko.com</span>
                    </button>
                </div>
            </div>

            <!-- Login Form -->
            <form asp-action="Login" method="post" class="space-y-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                <!-- Email Input -->
                <div class="space-y-1.5">
                    <label class="block text-xs font-bold text-slate-300">البريد الإلكتروني للناقل أو الكابتن</label>
                    <div class="relative">
                        <input id="loginEmail" name="email" type="email" required placeholder="driver@blocko.com"
                               class="w-full bg-slate-800/80 border border-slate-700 rounded-xl py-3 px-3.5 pe-10 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent text-xs font-mono" />
                        <span class="material-symbols-outlined absolute end-3 top-3 text-slate-500 text-lg">mail</span>
                    </div>
                </div>

                <!-- Password Input -->
                <div class="space-y-1.5">
                    <label class="block text-xs font-bold text-slate-300">كلمة المرور</label>
                    <div class="relative">
                        <input id="loginPassword" name="password" type="password" required placeholder="••••••••"
                               class="w-full bg-slate-800/80 border border-slate-700 rounded-xl py-3 px-3.5 pe-10 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent text-xs font-mono" />
                        <span class="material-symbols-outlined absolute end-3 top-3 text-slate-500 text-lg">lock</span>
                    </div>
                </div>

                <!-- Submit Button -->
                <button type="submit"
                        class="w-full py-3.5 px-4 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-black text-xs sm:text-sm shadow-xl shadow-blue-950/60 transition-all cursor-pointer flex items-center justify-center gap-2 active:scale-95">
                    <span class="material-symbols-outlined text-lg">login</span>
                    <span>دخول إلى قمرة القيادة والتشغيل</span>
                </button>
            </form>

            <!-- Registration Footer -->
            <div class="text-center pt-5 border-t border-slate-800 text-xs text-slate-400 space-y-2">
                <div>
                    <span>ليس لديك حساب ناقل معتمد؟</span>
                    <a href="@Url.Action("Register", "Account", new { area = "Delivery" })" class="text-blue-400 font-bold hover:underline ms-1">
                        تسجيل كابتن أو أسطول جديد (KYC)
                    </a>
                </div>
                <div>
                    <a href="/" class="text-[11px] text-slate-500 hover:text-slate-300 transition-colors flex items-center justify-center gap-1">
                        <span class="material-symbols-outlined text-xs">arrow_forward</span>
                        <span>العودة للمتجر الرئيسي ومواد البناء</span>
                    </a>
                </div>
            </div>

        </div>

    </div>

    <script>
        function fillCredentials(email, password) {
            document.getElementById('loginEmail').value = email;
            document.getElementById('loginPassword').value = password;
        }
    </script>
</body>
</html>
