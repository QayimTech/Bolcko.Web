    <script>
        function switchRole(role) {
            const isCompany = role === 'company';
            document.getElementById('registrationType').value = role;

            const tabCaptain = document.getElementById('tabCaptain');
            const tabCompany = document.getElementById('tabCompany');
            const sectionCaptain = document.getElementById('sectionCaptainDetails');
            const sectionCompany = document.getElementById('sectionCompanyDetails');
            const companyNameContainer = document.getElementById('companyNameContainer');
            const nationalIdContainer = document.getElementById('nationalIdContainer');
            const txtCompanyName = document.getElementById('txtCompanyName');
            const btnSubmitText = document.getElementById('btnSubmitText');
            const lblFullName = document.getElementById('lblFullName');

            if (isCompany) {
                tabCompany.className = "py-3.5 px-4 rounded-xl font-black text-xs sm:text-sm flex items-center justify-center gap-2 transition-all bg-gradient-to-r from-blue-600 to-indigo-600 text-white shadow-lg shadow-blue-950/60 cursor-pointer";
                tabCaptain.className = "py-3.5 px-4 rounded-xl font-black text-xs sm:text-sm flex items-center justify-center gap-2 transition-all text-slate-400 hover:text-white cursor-pointer";

                sectionCompany.style.display = "block";
                sectionCaptain.style.display = "none";
                companyNameContainer.style.display = "block";
                nationalIdContainer.style.display = "none";
                txtCompanyName.required = true;

                lblFullName.innerHTML = 'اسم مدير الحركة / المفوّض بالتوقيع: <span class="text-blue-400">*</span>';
                btnSubmitText.textContent = "تقديم طلب اعتماد شركة الشحن والأسطول (3PL KYC)";
            } else {
                tabCaptain.className = "py-3.5 px-4 rounded-xl font-black text-xs sm:text-sm flex items-center justify-center gap-2 transition-all bg-gradient-to-r from-amber-500 to-amber-600 text-slate-950 shadow-lg shadow-amber-950/60 cursor-pointer";
                tabCompany.className = "py-3.5 px-4 rounded-xl font-black text-xs sm:text-sm flex items-center justify-center gap-2 transition-all text-slate-400 hover:text-white cursor-pointer";

                sectionCaptain.style.display = "block";
                sectionCompany.style.display = "none";
                companyNameContainer.style.display = "none";
                nationalIdContainer.style.display = "block";
                txtCompanyName.required = false;

                lblFullName.innerHTML = 'الاسم الكامل للكابتن / السائق المستقل: <span class="text-amber-400">*</span>';
                btnSubmitText.textContent = "تقديم طلب تسجيل كابتن النقل الثقيل (KYC)";
            }
        }

