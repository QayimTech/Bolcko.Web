@{
    Layout = null;
    ViewData["Title"] = "بوابة اعتماد وتوثيق أساطيل النقل الثقيل (KYC) | بلوكو";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;700;800&family=Noto+Kufi+Arabic:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
    <style>
        body { font-family: 'Noto Kufi Arabic', sans-serif; }
        .font-mono { font-family: 'JetBrains Mono', monospace; }
    </style>
</head>
<body class="min-h-screen bg-[#0B0F17] text-slate-100 flex flex-col justify-between p-4 sm:p-6 lg:p-10 selection:bg-amber-500 selection:text-slate-950">

    <!-- Top Telemetry Ribbon -->
    <header class="w-full max-w-4xl mx-auto flex flex-wrap items-center justify-between gap-3 text-xs border-b border-slate-800/80 pb-4 mb-6">
        <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping"></span>
            <span class="text-slate-300 font-mono text-[11px]">LTRC COMPLIANT • اعتماد هيئة تنظيم النقل البري</span>
        </div>
        <div class="flex items-center gap-4 text-[11px] text-slate-400">
            <span class="flex items-center gap-1">
                <span class="material-symbols-outlined text-amber-400 text-sm">scale</span>
                <span>تكامل القبان الرقمي</span>
            </span>
            <span class="flex items-center gap-1">
                <span class="material-symbols-outlined text-emerald-400 text-sm">payments</span>
                <span>محفظة CliQ الفورية</span>
            </span>
        </div>
    </header>

    <!-- Main Registration Container -->
    <main class="w-full max-w-4xl mx-auto bg-[#0D111A] border border-slate-800 rounded-3xl p-6 sm:p-10 lg:p-12 shadow-2xl shadow-black/80 space-y-8">
        
        <!-- Header & Identity Badge -->
        <div class="text-center space-y-3 border-b border-slate-800 pb-6">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-amber-500/15 border-2 border-amber-500/40 text-amber-400 shadow-xl shadow-amber-950/50 mb-1">
                <span class="text-3xl font-black font-mono">B</span>
            </div>
            
            <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-500/10 text-amber-400 text-xs font-mono font-bold border border-amber-500/20">
                <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
                <span>HEAVY LOGISTICS & 3PL CARRIER ONBOARDING</span>
            </div>

            <h1 class="text-2xl sm:text-3xl font-black text-white">انضمام أسطول النقل الثقيل وناقلي المواد الإنشائية</h1>
            <p class="text-slate-400 text-xs sm:text-sm max-w-2xl mx-auto leading-relaxed">
                بوابة التوثيق المعتمدة لقطاع الإنشاءات (KYC). سجل شاحنتك أو أسطولك التجاري لنقل وتفريغ الإسمنت، الحديد، الرمل، والخرسانة في كافة محافظات المملكة.
            </p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="bg-rose-500/10 border border-rose-500/30 text-rose-300 p-4 rounded-2xl text-xs flex items-center gap-3 shadow-lg">
                <span class="material-symbols-outlined text-rose-400 text-xl">error</span>
                <span>@ViewBag.Error</span>
            </div>
        }

        <!-- Quick 1-Click Test Auto-Fill Ribbon -->
        <div class="p-3 bg-[#070A0F] border border-slate-800 rounded-2xl flex flex-wrap items-center justify-between gap-3 text-xs">
            <div class="flex items-center gap-2 text-slate-400">
                <span class="material-symbols-outlined text-amber-400 text-sm">bolt</span>
                <span class="text-[11px] font-bold">تعبئة تجريبية سريعة للفحص (1-Click Test):</span>
            </div>
            <div class="flex items-center gap-2">
                <button type="button" onclick="fillTestCaptain()" class="px-3 py-1.5 rounded-xl bg-amber-500/15 border border-amber-500/30 hover:bg-amber-500/25 text-amber-300 font-bold text-[11px] transition-colors cursor-pointer">
                    🚛 تجربة كابتن مستقل
                </button>
                <button type="button" onclick="fillTestCompany()" class="px-3 py-1.5 rounded-xl bg-blue-500/15 border border-blue-500/30 hover:bg-blue-500/25 text-blue-300 font-bold text-[11px] transition-colors cursor-pointer">
                    🏢 تجربة شركة أسطول 3PL
                </button>
            </div>
        </div>

        <!-- Mode Selector: Captain vs 3PL Company -->
        <div class="grid grid-cols-2 gap-3 p-1.5 bg-[#070A0F] rounded-2xl border border-slate-800">
            <button type="button" id="tabCaptain" onclick="switchRole('captain')" 
                    class="py-3.5 px-4 rounded-xl font-black text-xs sm:text-sm flex items-center justify-center gap-2 transition-all bg-gradient-to-r from-amber-500 to-amber-600 text-slate-950 shadow-lg shadow-amber-950/60 cursor-pointer">
                <span class="material-symbols-outlined text-lg font-bold">person_pin</span>
                <span>كابتن مستقل (سائق شاحنة فردي)</span>
            </button>
            <button type="button" id="tabCompany" onclick="switchRole('company')" 
                    class="py-3.5 px-4 rounded-xl font-black text-xs sm:text-sm flex items-center justify-center gap-2 transition-all text-slate-400 hover:text-white cursor-pointer">
                <span class="material-symbols-outlined text-lg">domain</span>
                <span>شركة شحن وأسطول 3PL</span>
            </button>
        </div>

        <!-- Registration Form -->
        <form asp-action="Register" method="post" enctype="multipart/form-data" class="space-y-6 text-xs text-start" id="regForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            <input type="hidden" id="registrationType" name="registrationType" value="captain" />

            <!-- Section 1: Account & Owner Info -->
            <div class="space-y-4">
                <div class="flex items-center gap-2 text-amber-400 font-black text-xs uppercase tracking-wider">
                    <span class="material-symbols-outlined text-base">badge</span>
                    <span>1. البيانات الأساسية وبيانات تسجيل الدخول</span>
                </div>
                
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="space-y-1.5">
                        <label class="font-bold text-slate-300 block text-xs" id="lblFullName">الاسم الكامل للكابتن / المالك: <span class="text-amber-400">*</span></label>
                        <input name="fullName" id="txtFullName" type="text" required placeholder="مثال: يوسف محمود العبادي" class="w-full p-3.5 rounded-xl border border-slate-800 bg-[#070A0F] text-white focus:outline-none focus:border-amber-500 transition-colors" />
                    </div>

                    <div class="space-y-1.5" id="companyNameContainer" style="display: none;">
                        <label class="font-bold text-slate-300 block text-xs">اسم الشركة / المنشأة المسجلة: <span class="text-amber-400">*</span></label>
                        <input name="companyName" id="txtCompanyName" type="text" placeholder="مثال: شركة البرج للخدمات اللوجستية والنقل الثقيل" class="w-full p-3.5 rounded-xl border border-slate-800 bg-[#070A0F] text-white focus:outline-none focus:border-amber-500 transition-colors" />
                    </div>

                    <div class="space-y-1.5" id="nationalIdContainer">
                        <label class="font-bold text-slate-300 block text-xs">الرقم الوطني الأردني: <span class="text-amber-400">*</span></label>
                        <input name="nationalId" id="txtNationalId" type="text" maxlength="10" placeholder="مثال: 9851029384" class="w-full p-3.5 rounded-xl border border-slate-800 bg-[#070A0F] text-white font-mono focus:outline-none focus:border-amber-500 transition-colors" />
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="space-y-1.5">
                        <label class="font-bold text-slate-300 block text-xs">رقم الهاتف الخلوي (مربوط بالواتساب): <span class="text-amber-400">*</span></label>
                        <input name="phone" id="txtPhone" type="tel" required placeholder="079XXXXXXXX" class="w-full p-3.5 rounded-xl border border-slate-800 bg-[#070A0F] text-white font-mono focus:outline-none focus:border-amber-500 transition-colors" />
                    </div>

                    <div class="space-y-1.5">
                        <label class="font-bold text-slate-300 block text-xs">البريد الإلكتروني المهني: <span class="text-amber-400">*</span></label>
                        <input name="email" id="txtEmail" type="email" required placeholder="hauler@blocko.com" class="w-full p-3.5 rounded-xl border border-slate-800 bg-[#070A0F] text-white font-mono focus:outline-none focus:border-amber-500 transition-colors" />
                    </div>
                </div>

                <div class="space-y-1.5">
                    <label class="font-bold text-slate-300 block text-xs">كلمة المرور المشفرة: <span class="text-amber-400">*</span></label>
                    <input name="password" id="txtPassword" type="password" required placeholder="••••••••••••" class="w-full p-3.5 rounded-xl border border-slate-800 bg-[#070A0F] text-white font-mono focus:outline-none focus:border-amber-500 transition-colors" />
                </div>
            </div>

            <!-- Section 2: Fleet / Heavy Machinery Specifications (Captain) -->
            <div id="sectionCaptainDetails" class="space-y-4 pt-6 border-t border-slate-800">
                <div class="flex items-center gap-2 text-amber-400 font-black text-xs uppercase tracking-wider">
                    <span class="material-symbols-outlined text-base">rv_hookup</span>
                    <span>2. مواصفات شاحنة النقل الثقيل ورخصة القيادة</span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="space-y-1.5">
                        <label class="font-bold text-slate-300 block text-xs">نوع المركبة / الشاحنة الإنشائية: <span class="text-amber-400">*</span></label>
                        <select name="vehicleType" class="w-full p-3.5 rounded-xl border border-slate-800 bg-[#070A0F] text-white focus:outline-none focus:border-amber-500 transition-colors">
                            <option value="تريلا مقطورات 30-40 طن">تريلا مقطورات 30-40 طن (تريلا مسطحة مقطورات ثقيلة)</option>
                            <option value="قلاب رمل وحصمة">قلاب رمل وحصمة (قلاب باطون ورمل وحصمة 16-32 م³)</option>
                            <option value="شاحنة ونش هيدروليكي">شاحنة ونش هيدروليكي (لتنزيل الطوب، الإسمنت، والحديد)</option>
                            <option value="خلاطة خرسانة جاهزة">خلاطة خرسانة جاهزة (Transit Mixer)</option>
                            <option value="لوري 4-7 طن">لوري 4-7 طن (شاحنة متوسطة لمواد التشطيب والدهان)</option>
                        </select>
                    </div>

                    <div class="space-y-1.5">
                        <label class="font-bold text-slate-300 block text-xs">فئة رخصة القيادة المهنية: <span class="text-amber-400">*</span></label>
                        <select name="heavyLicenseCategory" class="w-full p-3.5 rounded-xl border border-slate-800 bg-[#070A0F] text-white focus:outline-none focus:border-amber-500 transition-colors">
                            <option value="الفئة السادسة - قاطرة ومقطورة">الفئة السادسة - قاطرة ومقطورة / مركبات ثقيلة</option>
                            <option value="الفئة الخامسة - مركبات شحن عمومي">الفئة الخامسة - مركبات شحن عمومي وتفريغ</option>
                            <option value="تصريح تشغيل ونش ومعدات هيدروليكية">تصريح تشغيل ونش ومعدات هيدروليكية خاصة</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div class="space-y-1.5">
                        <label class="font-bold text-slate-300 block text-xs">رقم لوحة الشاحنة: <span class="text-amber-400">*</span></label>
                        <input name="plateNumber" id="txtPlateNumber" type="text" placeholder="مثال: 12-45890" class="w-full p-3.5 rounded-xl border border-slate-800 bg-[#070A0F] text-white font-mono focus:outline-none focus:border-amber-500 transition-colors" />
                    </div>

                    <div class="space-y-1.5">
                        <label class="font-bold text-slate-300 block text-xs">سعة الحمولة الصافية (طن): <span class="text-amber-400">*</span></label>
                        <input name="capacityTons" id="txtCapacityTons" type="number" value="25" min="2" max="60" class="w-full p-3.5 rounded-xl border border-slate-800 bg-[#070A0F] text-white font-mono focus:outline-none focus:border-amber-500 transition-colors" />
                    </div>

                    <div class="space-y-1.5">
                        <label class="font-bold text-slate-300 block text-xs">نطاق التغطية والمحافظات: <span class="text-amber-400">*</span></label>
                        <select name="coveredGovernorate" class="w-full p-3.5 rounded-xl border border-slate-800 bg-[#070A0F] text-white focus:outline-none focus:border-amber-500 transition-colors">
                            <option value="كافة محافظات المملكة">كافة محافظات المملكة</option>
                            <option value="محافظة العاصمة عمّان ومحيطها">محافظة العاصمة عمّان ومحيطها</option>
                            <option value="الزرقاء والرصيفة والحلابات">الزرقاء والرصيفة والحلابات</option>
                            <option value="إربد وعجلون والشمال">إربد وعجلون والشمال</option>
                            <option value="المفرق والرويشد">المفرق والرويشد</option>
                            <option value="الكرك والطفيلة ومعان والعقبة">الكرك والطفيلة ومعان والعقبة</option>
                        </select>
                    </div>
                </div>

                <!-- Mandatory KYC Docs for Freelance Driver -->
                <div class="p-5 bg-[#070A0F] rounded-2xl border border-slate-800 space-y-3">
                    <div class="text-xs font-bold text-slate-300 flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-amber-400 text-sm">verified_user</span>
                        <span>الوثائق الثبوتية ورخصة الشاحنة (KYC Verification):</span>
                    </div>
                    
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                        <div class="p-3.5 bg-slate-900 border border-slate-800 rounded-xl space-y-1.5">
                            <label class="text-[11px] font-bold text-slate-300 block">1. صورة رخصة القيادة الثقيلة <span class="text-amber-400">*</span></label>
                            <input name="licenseDoc" type="file" accept=".jpg,.jpeg,.png,.pdf" class="w-full text-[10px] text-slate-400 file:me-2 file:py-1 file:px-2.5 file:rounded-lg file:border-0 file:text-[10px] file:font-bold file:bg-amber-500/20 file:text-amber-300 hover:file:bg-amber-500/30 cursor-pointer" />
                        </div>

                        <div class="p-3.5 bg-slate-900 border border-slate-800 rounded-xl space-y-1.5">
                            <label class="text-[11px] font-bold text-slate-300 block">2. رخصة اقتناء المركبة / الفحص <span class="text-amber-400">*</span></label>
                            <input name="registrationDoc" type="file" accept=".jpg,.jpeg,.png,.pdf" class="w-full text-[10px] text-slate-400 file:me-2 file:py-1 file:px-2.5 file:rounded-lg file:border-0 file:text-[10px] file:font-bold file:bg-amber-500/20 file:text-amber-300 hover:file:bg-amber-500/30 cursor-pointer" />
                        </div>

                        <div class="p-3.5 bg-slate-900 border border-slate-800 rounded-xl space-y-1.5">
                            <label class="text-[11px] font-bold text-slate-300 block">3. صورة واضحة للشاحنة / الونش</label>
                            <input name="vehiclePhoto" type="file" accept=".jpg,.jpeg,.png" class="w-full text-[10px] text-slate-400 file:me-2 file:py-1 file:px-2.5 file:rounded-lg file:border-0 file:text-[10px] file:font-bold file:bg-amber-500/20 file:text-amber-300 hover:file:bg-amber-500/30 cursor-pointer" />
                        </div>
                    </div>
                </div>

                <!-- CliQ / Payout for Captain -->
                <div class="p-5 bg-emerald-950/20 border border-emerald-500/25 rounded-2xl space-y-2">
                    <div class="flex items-center gap-2 text-emerald-400 font-bold">
                        <span class="material-symbols-outlined text-base">payments</span>
                        <span>معرّف كليك (CliQ Alias) أو الآيبان لصرف أجور النقل الفورية: <span class="text-amber-400">*</span></span>
                    </div>
                    <input name="driverCliqAlias" id="txtDriverCliq" type="text" placeholder="مثال: CAPTAIN99 أو JO98ARAB0000000000000000000000" class="w-full p-3.5 rounded-xl border border-slate-800 bg-[#070A0F] text-white font-mono focus:outline-none focus:border-emerald-500 transition-colors" />
                    <p class="text-[11px] text-emerald-400/80">يتم تحويل أجور النقل والتفريغ فور تأكيد استلام العميل في موقع العمل عبر رمز e-POD بنظام كليك الأردني الفوري.</p>
                </div>
            </div>

            <!-- Section 3: 3PL Fleet Company Carrier Specifications -->
            <div id="sectionCompanyDetails" style="display: none;" class="space-y-4 pt-6 border-t border-slate-800">
                <div class="flex items-center gap-2 text-blue-400 font-black text-xs uppercase tracking-wider">
                    <span class="material-symbols-outlined text-base">corporate_fare</span>
                    <span>2. بيانات السجل التجاري والترخيص الحكومي (3PL Carrier)</span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div class="space-y-1.5">
                        <label class="font-bold text-slate-300 block text-xs">رقم السجل التجاري: <span class="text-blue-400">*</span></label>
                        <input name="commercialRegister" id="txtCommercialRegister" type="text" placeholder="مثال: 200194821" class="w-full p-3.5 rounded-xl border border-slate-800 bg-[#070A0F] text-white font-mono focus:outline-none focus:border-blue-500 transition-colors" />
                    </div>

                    <div class="space-y-1.5">
                        <label class="font-bold text-slate-300 block text-xs">الرقم الضريبي للمنشأة:</label>
                        <input name="taxId" id="txtTaxId" type="text" placeholder="مثال: 100482910" class="w-full p-3.5 rounded-xl border border-slate-800 bg-[#070A0F] text-white font-mono focus:outline-none focus:border-blue-500 transition-colors" />
                    </div>

                    <div class="space-y-1.5">
                        <label class="font-bold text-slate-300 block text-xs">ترخيص هيئة تنظيم النقل (LTRC):</label>
                        <input name="transportCommissionLicense" id="txtTransportLicense" type="text" placeholder="مثال: LTRC-2024-8849" class="w-full p-3.5 rounded-xl border border-slate-800 bg-[#070A0F] text-white font-mono focus:outline-none focus:border-blue-500 transition-colors" />
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="space-y-1.5">
                        <label class="font-bold text-slate-300 block text-xs">إجمالي عدد الشاحنات في الأسطول: <span class="text-blue-400">*</span></label>
                        <input name="totalTrucksCount" id="txtTotalTrucks" type="number" value="5" min="1" max="500" class="w-full p-3.5 rounded-xl border border-slate-800 bg-[#070A0F] text-white font-mono focus:outline-none focus:border-blue-500 transition-colors" />
                    </div>

                    <div class="space-y-1.5">
                        <label class="font-bold text-slate-300 block text-xs">معرّف كليك للشركات / الآيبان البنكي (CliQ / IBAN): <span class="text-blue-400">*</span></label>
                        <input name="companyCliqAlias" id="txtCompanyCliq" type="text" placeholder="مثال: 3PLCORP@ETIHAD أو الآيبان البنكي" class="w-full p-3.5 rounded-xl border border-slate-800 bg-[#070A0F] text-white font-mono focus:outline-none focus:border-blue-500 transition-colors" />
                    </div>
                </div>

                <!-- Mandatory KYC Docs for 3PL Company -->
                <div class="p-5 bg-[#070A0F] rounded-2xl border border-slate-800 space-y-3">
                    <div class="text-xs font-bold text-slate-300 flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-blue-400 text-sm">folder_open</span>
                        <span>مرفقات الاعتماد المؤسسي (KYC B2B Carrier Documents):</span>
                    </div>
                    
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div class="p-3.5 bg-slate-900 border border-slate-800 rounded-xl space-y-1.5">
                            <label class="text-[11px] font-bold text-slate-300 block">1. صورة شهادة السجل التجاري <span class="text-blue-400">*</span></label>
                            <input name="commercialRegisterDoc" type="file" accept=".jpg,.jpeg,.png,.pdf" class="w-full text-[10px] text-slate-400 file:me-2 file:py-1 file:px-2.5 file:rounded-lg file:border-0 file:text-[10px] file:font-bold file:bg-blue-600/30 file:text-blue-300 hover:file:bg-blue-600/50 cursor-pointer" />
                        </div>

                        <div class="p-3.5 bg-slate-900 border border-slate-800 rounded-xl space-y-1.5">
                            <label class="text-[11px] font-bold text-slate-300 block">2. رخصة هيئة تنظيم النقل البري <span class="text-blue-400">*</span></label>
                            <input name="transportLicenseDoc" type="file" accept=".jpg,.jpeg,.png,.pdf" class="w-full text-[10px] text-slate-400 file:me-2 file:py-1 file:px-2.5 file:rounded-lg file:border-0 file:text-[10px] file:font-bold file:bg-blue-600/30 file:text-blue-300 hover:file:bg-blue-600/50 cursor-pointer" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Submit CTA -->
            <div class="pt-4">
