@{
    ViewData["Title"] = "تسجيل وانضمام أسطول الشحن والونشات | بولكو";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
    <style>
        body { font-family: 'Tajawal', sans-serif; }
        .font-mono { font-family: 'JetBrains Mono', monospace; }
    </style>
</head>
<body class="min-h-screen bg-gradient-to-br from-slate-950 via-slate-900 to-blue-950 text-slate-100 flex items-center justify-center p-4 sm:p-6 lg:p-8">

    <div class="w-full max-w-2xl bg-slate-900/90 backdrop-blur-xl border border-white/10 rounded-3xl p-6 sm:p-10 shadow-2xl space-y-6">
        
        <!-- Header -->
        <div class="text-center space-y-2 border-b border-white/10 pb-6">
            <div class="w-16 h-16 bg-blue-600/20 border border-blue-500/30 text-blue-400 rounded-2xl flex items-center justify-center mx-auto mb-3 shadow-lg">
                <span class="material-symbols-outlined text-3xl">local_shipping</span>
            </div>
            <div class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full bg-blue-500/10 text-blue-400 text-xs font-mono font-bold border border-blue-500/20">
                <span>CARRIER & FLEET ONBOARDING</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-black text-white">انضمام شركات الشحن وأصحاب الونشات</h1>
            <p class="text-slate-400 text-xs sm:text-sm">سجل شاحنتك أو أسطول النقل الخاص بك لاستلام مهام توصيل وتفريغ المواد الإنشائية في كافة المحافظات.</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="bg-red-500/10 border border-red-500/30 text-red-300 p-4 rounded-xl text-xs flex items-center gap-2">
                <span class="material-symbols-outlined text-sm">error</span>
                <span>@ViewBag.Error</span>
            </div>
        }

        <form asp-action="Register" method="post" class="space-y-5 text-xs text-start">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

            <!-- Account Details -->
            <div class="space-y-4">
                <h2 class="text-xs font-bold text-blue-400 uppercase tracking-wider">بيانات السائق / المنشأة</h2>
                
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="space-y-1">
                        <label class="font-bold text-slate-300 block">الاسم الكامل للسائق / المالك: <span class="text-red-400">*</span></label>
                        <input name="fullName" type="text" required placeholder="مثال: يوسف محمود" class="w-full p-3 rounded-xl border border-white/10 bg-slate-950 text-white focus:outline-none focus:border-blue-500" />
                    </div>

                    <div class="space-y-1">
                        <label class="font-bold text-slate-300 block">اسم شركة الشحن / المؤسسة (اختياري):</label>
                        <input name="companyName" type="text" placeholder="مثال: مؤسسة النقل السريع" class="w-full p-3 rounded-xl border border-white/10 bg-slate-950 text-white focus:outline-none focus:border-blue-500" />
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="space-y-1">
                        <label class="font-bold text-slate-300 block">رقم الهاتف الأردني (مربوط بالواتساب): <span class="text-red-400">*</span></label>
                        <input name="phone" type="tel" required placeholder="079XXXXXXX" class="w-full p-3 rounded-xl border border-white/10 bg-slate-950 text-white font-mono focus:outline-none focus:border-blue-500" />
                    </div>

                    <div class="space-y-1">
                        <label class="font-bold text-slate-300 block">البريد الإلكتروني لتسجيل الدخول: <span class="text-red-400">*</span></label>
                        <input name="email" type="email" required placeholder="driver@example.com" class="w-full p-3 rounded-xl border border-white/10 bg-slate-950 text-white font-mono focus:outline-none focus:border-blue-500" />
                    </div>
                </div>

                <div class="space-y-1">
                    <label class="font-bold text-slate-300 block">كلمة المرور: <span class="text-red-400">*</span></label>
                    <input name="password" type="password" required placeholder="••••••••" class="w-full p-3 rounded-xl border border-white/10 bg-slate-950 text-white font-mono focus:outline-none focus:border-blue-500" />
                </div>
            </div>

            <!-- Fleet & Vehicle Specifications -->
            <div class="space-y-4 pt-4 border-t border-white/10">
                <h2 class="text-xs font-bold text-blue-400 uppercase tracking-wider">مواصفات المركبة وأسطول النقل</h2>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="space-y-1">
                        <label class="font-bold text-slate-300 block">نوع المركبة / الشاحنة: <span class="text-red-400">*</span></label>
                        <select name="vehicleType" class="w-full p-3 rounded-xl border border-white/10 bg-slate-950 text-white focus:outline-none focus:border-blue-500">
                            <option value="ونش تفريغ هيدروليكي (Crane)">ونش تفريغ هيدروليكي (Crane Truck)</option>
                            <option value="تريلا مقطورات ثقيلة (Flatbed Trailer)">تريلا مقطورات ثقيلة (Flatbed Trailer)</option>
                            <option value="قلاب باطون وحصمة (Dump Truck)">قلاب باطون وحصمة ورمل (Dump Truck)</option>
                            <option value="بيك أب نقل وتوريد خفيف (Pickup)">بيك أب نقل وتوريد خفيف (Pickup)</option>
                        </select>
                    </div>

                    <div class="space-y-1">
                        <label class="font-bold text-slate-300 block">رقم لوحة الشاحنة: <span class="text-red-400">*</span></label>
                        <input name="plateNumber" type="text" required placeholder="مثال: 12-45890" class="w-full p-3 rounded-xl border border-white/10 bg-slate-950 text-white font-mono focus:outline-none focus:border-blue-500" />
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="space-y-1">
                        <label class="font-bold text-slate-300 block">سعة الحمولة الصافية (طن): <span class="text-red-400">*</span></label>
                        <input name="capacityTons" type="number" value="15" min="1" max="60" required class="w-full p-3 rounded-xl border border-white/10 bg-slate-950 text-white font-mono focus:outline-none focus:border-blue-500" />
                    </div>

                    <div class="space-y-1">
                        <label class="font-bold text-slate-300 block">نطاق التغطية والمحافظة الأساسية: <span class="text-red-400">*</span></label>
                        <select name="coveredCity" class="w-full p-3 rounded-xl border border-white/10 bg-slate-950 text-white focus:outline-none focus:border-blue-500">
                            <option value="كافة محافظات المملكة">كافة محافظات المملكة</option>
                            <option value="عمّان وضواحيها">عمّان وضواحيها</option>
                            <option value="الزرقاء والرصيفة">الزرقاء والرصيفة</option>
                            <option value="إربد والشمال">إربد والشمال</option>
                            <option value="العقبة والجنوب">العقبة والجنوب</option>
                            <option value="المفرق والبادية">المفرق والبادية</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Submit CTA -->
            <div class="pt-4">
                <button type="submit" class="w-full py-4 rounded-2xl bg-blue-600 hover:bg-blue-500 text-white font-black text-sm shadow-xl shadow-blue-950/50 transition-all flex items-center justify-center gap-2 cursor-pointer active:scale-95">
                    <span class="material-symbols-outlined text-base">how_to_reg</span>
                    <span>تسجيل واعتماد أسطول النقل فوراً</span>
                </button>
            </div>
        </form>

        <!-- Login Switcher -->
        <div class="text-center pt-4 border-t border-white/10 text-xs text-slate-400">
            <span>لديك حساب ناقل مسبقاً؟</span>
            <a href="@Url.Action("Login", "Account", new { area = "Delivery" })" class="text-blue-400 font-bold hover:underline me-1">تسجيل الدخول هنا</a>
        </div>

    </div>
</body>
</html>
