<!DOCTYPE html>
@{
    var isArabic = System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("ar");
    var isRtl = isArabic;
    var langCode = isArabic ? "ar" : "en";
    var isAuth = User.Identity?.IsAuthenticated == true;
    var userName = User.Identity?.Name ?? (isArabic ? "كابتن أسطول بلوكو" : "BLOCKO Fleet Captain");
    var isCompany = User.IsInRole("DeliveryCompanyUser");
}
<html lang="@langCode" dir="@(isRtl ? "rtl" : "ltr")" class="h-full overflow-x-hidden">
<head>
    <!-- Google Analytics 4 (GA4) -->
    <partial name="~/Views/Shared/Partials/_GoogleAnalytics.cshtml" />

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>@(ViewData["Title"] ?? (isArabic ? "قمرة قيادة النقل الثقيل واللوجستيات" : "Heavy Logistics Cockpit")) | BLOCKO Heavy Logistics</title>
    
    <!-- Premium Favicons -->
    <link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png?v=5" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32x32.png?v=5" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicons/favicon-16x16.png?v=5" />
    <link rel="shortcut icon" href="/favicons/favicon.ico?v=5" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0B0F17" />

    <!-- Self-hosted Material Symbols font -->
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/material-symbols-outlined.woff2">
    <link rel="stylesheet" href="~/css/material-symbols.css" asp-append-version="true">

    <!-- Typography: Noto Kufi Arabic + JetBrains Mono + Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Kufi+Arabic:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700;800&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Compiled Tailwind CSS Output -->
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true" />

    <style>
        body { font-family: @(isArabic ? "'Noto Kufi Arabic', sans-serif" : "'Inter', system-ui, sans-serif"); }
        .font-mono { font-family: 'JetBrains Mono', monospace; }
        .radar-sweep {
            background: conic-gradient(from 0deg, rgba(232, 160, 32, 0.25) 0deg, transparent 60deg, transparent 360deg);
        }
    </style>
</head>
<body class="bg-[#0B0F17] text-slate-100 min-h-screen w-full flex flex-col antialiased selection:bg-amber-500 selection:text-slate-950 overflow-x-hidden relative">

    <!-- Background Industrial Glow Mesh -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none -z-10">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-amber-500/5 via-[#0B0F17] to-[#080B11]"></div>
        <div class="absolute -top-40 -right-40 w-96 h-96 bg-amber-500/5 rounded-full blur-3xl"></div>
        <div class="absolute top-1/2 -left-40 w-96 h-96 bg-blue-500/5 rounded-full blur-3xl"></div>
    </div>

    <!-- 1. Enterprise Fleet Telemetry Bar -->
    <div class="bg-slate-950 border-b border-slate-800/80 px-4 sm:px-8 py-2 text-[11px] text-slate-400 flex flex-wrap items-center justify-between gap-3 shrink-0" dir="@(isRtl ? "rtl" : "ltr")">
        <div class="flex items-center gap-4 flex-wrap">
            <div class="flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                <span class="text-slate-300 font-bold">@(isArabic ? "شبكة أساطيل بلوكو:" : "BLOCKO Fleet Grid:")</span>
                <span class="text-emerald-400 font-mono font-bold">@(isArabic ? "متصلة لحظياً (LIVE)" : "LIVE DISPATCH")</span>
            </div>
            <span class="text-slate-700 hidden sm:inline">•</span>
            <div class="hidden sm:flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[13px] text-amber-500">scale</span>
                <span>@(isArabic ? "تكامل القبان الرقمي:" : "Weighbridge Sync:")</span>
                <span class="text-slate-300 font-bold">@(isArabic ? "معتمد بنكياً وإلكترونياً" : "Certified & Online")</span>
            </div>
            <span class="text-slate-700 hidden md:inline">•</span>
            <div class="hidden md:flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[13px] text-emerald-400">payments</span>
                <span>@(isArabic ? "التسويات الفورية:" : "Instant Payouts:")</span>
                <span class="text-emerald-300 font-bold">CliQ Instant Escrow Payouts</span>
            </div>
        </div>

        <div class="flex items-center gap-3 text-slate-400">
            <!-- Language Switcher -->
            <form asp-area="" asp-controller="Language" asp-action="SetLanguage" asp-route-returnUrl="@Context.Request.Path" method="post" class="inline">
                @Html.AntiForgeryToken()
                <button type="submit" name="culture" value="@(isArabic ? "en" : "ar")" class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white font-mono text-[11px] transition-colors cursor-pointer border border-slate-700">
                    <span class="material-symbols-outlined text-[13px]">language</span>
                    <span>@(isArabic ? "English" : "العربية")</span>
                </button>
            </form>

            <span class="text-[10px] font-mono text-slate-500">FLEET ID: JO-BLK-@(isCompany ? "3PL" : "DRV")</span>
            <a href="/" target="_blank" class="hover:text-amber-400 transition-colors hidden sm:flex items-center gap-1 text-[11px]">
                <span class="material-symbols-outlined text-xs">storefront</span>
                <span>@(isArabic ? "بوابة المتجر ومواد البناء" : "Materials Store")</span>
            </a>
        </div>
    </div>

    <!-- 2. Master Navigation Header -->
    <header class="bg-slate-900/90 backdrop-blur-xl border-b border-slate-800 sticky top-0 z-40 px-4 sm:px-8 shadow-xl">
        <div class="max-w-7xl mx-auto h-18 flex items-center justify-between gap-4" dir="@(isRtl ? "rtl" : "ltr")">
            
            <!-- Brand Monogram & Title -->
            <div class="flex items-center gap-3">
                <a asp-area="Delivery" asp-controller="Home" asp-action="Index" class="flex items-center gap-2.5 group">
                    <partial name="~/Views/Shared/Partials/_BrandLogo.cshtml" model='(false, false, "dark", "h-8 sm:h-9")' />
                    <span class="px-2 py-0.5 rounded-full bg-amber-500/15 text-amber-400 border border-amber-500/30 text-[10px] font-mono font-black tracking-wider">
                        HEAVY FLEET
                    </span>
                </a>
            </div>

            <!-- Central Navigation Tabs (Cockpit Switcher) -->
            <nav class="hidden lg:flex items-center gap-1.5 p-1 bg-slate-950/70 rounded-2xl border border-slate-800/80 text-xs font-bold">
                <a asp-area="Delivery" asp-controller="Home" asp-action="Index"
                   class="px-4 py-2 rounded-xl transition-all flex items-center gap-1.5 @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "bg-amber-500 text-slate-950 font-black shadow-md shadow-amber-500/20" : "text-slate-300 hover:text-white hover:bg-slate-800/60")">
                    <span class="material-symbols-outlined text-base">radar</span>
                    <span>@(isArabic ? "قمرة الكابتن ورادار الحمولات" : "Driver Radar & Cockpit")</span>
                </a>
                
                <a asp-area="Delivery" asp-controller="Home" asp-action="CompanyIndex"
                   class="px-4 py-2 rounded-xl transition-all flex items-center gap-1.5 @(ViewContext.RouteData.Values["action"]?.ToString() == "CompanyIndex" ? "bg-amber-500 text-slate-950 font-black shadow-md shadow-amber-500/20" : "text-slate-300 hover:text-white hover:bg-slate-800/60")">
                    <span class="material-symbols-outlined text-base">domain</span>
                    <span>@(isArabic ? "لوحة أساطيل 3PL" : "3PL Carrier Fleet")</span>
                </a>

                <a asp-area="Vendor" asp-controller="Logistics" asp-action="Dispatch"
                   class="px-4 py-2 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800/60 transition-all flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-base">receipt_long</span>
                    <span>@(isArabic ? "مركز تذاكر القبان (المورد)" : "Weighbridge Dispatch Desk")</span>
                </a>
            </nav>

            <!-- Right Profile / Auth Badge -->
            <div class="flex items-center gap-3">
                @if (isAuth)
                {
                    <div class="flex items-center gap-3 p-1.5 pe-3 bg-slate-950/60 border border-slate-800 rounded-2xl">
                        <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-amber-500 to-amber-300 text-slate-950 font-black flex items-center justify-center text-xs shadow-sm">
                            <span class="material-symbols-outlined text-base">person</span>
                        </div>
                        <div class="hidden sm:block text-start">
                            <div class="text-xs font-black text-white leading-tight">@userName</div>
                            <div class="text-[10px] text-amber-400 font-bold flex items-center gap-1">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                                <span>@(isCompany ? (isArabic ? "شريك أسطول معتمد" : "Verified 3PL Carrier") : (isArabic ? "كابتن نقل ثقيل مرخص" : "Licensed Heavy Hauler"))</span>
                            </div>
                        </div>
                    </div>

                    <form asp-area="Delivery" asp-controller="Account" asp-action="Logout" method="post" class="inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" 
                                class="p-2.5 rounded-xl bg-slate-800/80 hover:bg-rose-950/50 hover:text-rose-400 text-slate-400 border border-slate-700/60 transition-all cursor-pointer flex items-center justify-center" 
                                title="@(isArabic ? "تسجيل الخروج" : "Sign Out")">
                            <span class="material-symbols-outlined text-lg">logout</span>
                        </button>
                    </form>
                }
                else
                {
                    <a asp-area="Delivery" asp-controller="Account" asp-action="Login"
                       class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-bold text-xs border border-slate-700 transition-colors">
                        @(isArabic ? "تسجيل الدخول" : "Sign In")
                    </a>
                    <a asp-area="Delivery" asp-controller="Account" asp-action="Register"
                       class="px-4 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-xs shadow-md shadow-amber-500/20 transition-all">
                        @(isArabic ? "تسجيل أسطول جديد" : "New Fleet KYC")
                    </a>
                }
            </div>

        </div>
    </header>

    <!-- 3. Sub-Navigation for Mobile Screens -->
    <div class="lg:hidden bg-slate-950 border-b border-slate-800/80 px-4 py-2.5 flex items-center justify-around text-xs font-bold" dir="@(isRtl ? "rtl" : "ltr")">
        <a asp-area="Delivery" asp-controller="Home" asp-action="Index"
           class="flex items-center gap-1.5 @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "text-amber-400" : "text-slate-400")">
            <span class="material-symbols-outlined text-sm">radar</span>
            <span>@(isArabic ? "قمرة الكابتن" : "Driver Cockpit")</span>
        </a>
        <span class="text-slate-800">|</span>
        <a asp-area="Delivery" asp-controller="Home" asp-action="CompanyIndex"
           class="flex items-center gap-1.5 @(ViewContext.RouteData.Values["action"]?.ToString() == "CompanyIndex" ? "text-amber-400" : "text-slate-400")">
            <span class="material-symbols-outlined text-sm">domain</span>
            <span>@(isArabic ? "أساطيل 3PL" : "3PL Fleet")</span>
        </a>
        <span class="text-slate-800">|</span>
        <a asp-area="Vendor" asp-controller="Logistics" asp-action="Dispatch"
           class="flex items-center gap-1.5 text-slate-400 hover:text-white">
            <span class="material-symbols-outlined text-sm">receipt_long</span>
            <span>@(isArabic ? "بوالص الشحن" : "Waybills")</span>
        </a>
    </div>

    <!-- 4. Main Body Canvas -->
    <main class="flex-1 w-full max-w-7xl mx-auto py-6 sm:py-8 px-4 sm:px-6 lg:px-8 pb-24 sm:pb-8 text-start" dir="@(isRtl ? "rtl" : "ltr")">
        @RenderBody()
    </main>

    <!-- 5. Enterprise Heavy Logistics Footer -->
    <footer class="bg-slate-950 border-t border-slate-800/80 text-slate-500 py-6 px-4 sm:px-8 text-xs shrink-0 pb-20 sm:pb-6" dir="@(isRtl ? "rtl" : "ltr")">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-3 text-start">
                <div class="w-8 h-8 rounded-xl bg-amber-500/10 text-amber-400 border border-amber-500/20 flex items-center justify-center font-black">
                    B
                </div>
                <div>
                    <p class="font-bold text-slate-300">@(isArabic ? "منظومة بلوكو للخدمات اللوجستية والنقل الثقيل (BLOCKO Heavy Freight)" : "BLOCKO Heavy Freight & Construction Logistics")</p>
                    <p class="text-[10px] text-slate-500 font-mono mt-0.5">Jordan National Construction Logistics Infrastructure • v2.6 Enterprise</p>
                </div>
            </div>

            <div class="flex items-center gap-6 text-[11px] text-slate-400">
                <span class="flex items-center gap-1">
                    <span class="material-symbols-outlined text-xs text-amber-500">verified</span>
                    <span>@(isArabic ? "معتمد من هيئة تنظيم النقل البري LTRC" : "Licensed by Jordan LTRC")</span>
                </span>
                <span class="hidden sm:inline text-slate-800">•</span>
                <a href="/Shop/Legal/Terms" class="hover:text-amber-400 transition-colors">@(isArabic ? "شروط النقل والسلامة" : "Terms & Safety")</a>
                <span class="hidden sm:inline text-slate-800">•</span>
                <a href="/Shop/Legal/Privacy" class="hover:text-amber-400 transition-colors">@(isArabic ? "سياسة الخصوصية" : "Privacy Policy")</a>
            </div>
        </div>
    </footer>

    <!-- 6. Mobile Driver PWA Bottom Navigation Bar (QT1-196) -->
    <nav class="lg:hidden fixed bottom-0 inset-x-0 bg-[#0B0F17]/95 backdrop-blur-xl border-t border-slate-800/90 z-50 px-3 py-2 flex items-center justify-around text-[10px] font-bold text-slate-400 shadow-2xl" dir="@(isRtl ? "rtl" : "ltr")">
        <a asp-area="Delivery" asp-controller="Home" asp-action="Index" class="flex flex-col items-center gap-1 py-1 px-2 rounded-xl transition-all @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "text-amber-400 bg-amber-500/10 font-black" : "hover:text-white")">
            <span class="material-symbols-outlined text-xl">radar</span>
            <span>@(isArabic ? "رادار الحمولات" : "Radar")</span>
        </a>
        <a href="#active-trip-card" class="flex flex-col items-center gap-1 py-1 px-2 rounded-xl transition-all hover:text-white">
            <span class="material-symbols-outlined text-xl text-sky-400">navigation</span>
            <span>@(isArabic ? "الرحلة الحالية" : "Active Trip")</span>
        </a>
        <a href="#weighbridge-scanner" onclick="if(window.openScannerModal) window.openScannerModal();" class="flex flex-col items-center gap-1 py-1 px-2 rounded-xl transition-all hover:text-white">
            <span class="material-symbols-outlined text-xl text-amber-500">qr_code_scanner</span>
            <span>@(isArabic ? "فحص القبان" : "Weighbridge")</span>
        </a>
        <a href="#driver-wallet" class="flex flex-col items-center gap-1 py-1 px-2 rounded-xl transition-all hover:text-white">
            <span class="material-symbols-outlined text-xl text-emerald-400">account_balance_wallet</span>
            <span>@(isArabic ? "المحفظة والأرباح" : "Wallet")</span>
        </a>
    </nav>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
