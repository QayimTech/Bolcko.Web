@model Bolcko.Domain.Entities.Delivery.DeliveryJob
@{
    ViewData["Title"] = $"توثيق التسليم الميداني e-POD | شحنة #{Model.OrderId}";
    Layout = "~/Areas/Delivery/Views/Shared/_Layout.cshtml";
    var txn = ViewBag.PayoutTransaction as Bolcko.Domain.Entities.Financing.CarrierPayoutTransaction;
    bool isDelivered = Model.Status == Bolcko.Domain.Enums.DeliveryJobStatus.Delivered || Model.IsPodVerified;
    string cliqRecipient = Model.Driver?.CliqAlias ?? Model.Company?.CliqAlias ?? Model.Driver?.User?.PhoneNumber ?? "CLIQ-VERIFIED";
}

<div class="max-w-2xl mx-auto px-4 py-6 sm:py-10 space-y-6" dir="rtl">
    
    <!-- Top Card: Jobsite Overview -->
    <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 sm:p-8 border border-slate-200 dark:border-slate-800 shadow-xl space-y-6">
        
        <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-5 border-b border-slate-100 dark:border-slate-800 gap-3">
            <div class="flex items-center gap-3.5">
                <div class="w-14 h-14 rounded-2xl bg-amber-500/10 text-amber-500 border border-amber-500/20 flex items-center justify-center font-black text-2xl shadow-inner">
                    📦
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <h1 class="text-lg font-black text-slate-900 dark:text-white">توثيق تسليم موقع الورشة (e-POD)</h1>
                        <span class="px-2 py-0.5 rounded-full bg-amber-500 text-slate-950 font-black text-[10px] uppercase font-mono">
                            LOG-06
                        </span>
                    </div>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                        التحقق برمز الـ OTP وتحرير مستحقات الشحن فوراً عبر شبكة CliQ
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2 self-start sm:self-center font-mono">
                <span class="text-xs font-bold text-slate-500 dark:text-slate-400">بوليصة:</span>
                <span class="px-2.5 py-1 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 font-black text-xs">
                    @(Model.WaybillNumber ?? $"WB-{Model.OrderId}")
                </span>
            </div>
        </div>

        <!-- Escrow Protection Badge -->
        <div class="p-4 rounded-2xl bg-gradient-to-r from-amber-500/10 via-amber-500/5 to-transparent border border-amber-500/25 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <span class="w-10 h-10 rounded-xl bg-amber-500 text-slate-950 flex items-center justify-center font-black text-lg">
                    🔒
                </span>
                <div>
                    <h4 class="text-xs font-black text-slate-900 dark:text-white">حجز الضمان المالي المباشر (Cargo Escrow)</h4>
                    <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">
                        أجور النقل محجوزة بالكامل في حساب الضمان، وسيتم تحويلها لحظياً لحساب الناقل فور مطابقة رمز الـ OTP.
                    </p>
                </div>
            </div>
            <div class="text-left font-mono">
                <div class="text-[10px] text-slate-400">أجرة الشحن:</div>
                <div class="text-sm font-black text-emerald-600 dark:text-emerald-400">@(Model.DeliveryFee > 0 ? Model.DeliveryFee.ToString("N2") : "35.00") د.أ</div>
            </div>
        </div>

        <!-- Delivery & Cargo Details Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
            <div class="p-4 bg-slate-50 dark:bg-slate-800/40 rounded-2xl border border-slate-100 dark:border-slate-800 space-y-1.5">
                <span class="text-slate-400 block font-bold text-[10px] uppercase">بيانات الحمولة والمواد:</span>
                <div class="font-black text-slate-800 dark:text-slate-200 text-sm">@(Model.MaterialType ?? "حديد تسليح / مواد إنشائية ثقيلة")</div>
                <div class="text-slate-500 font-mono font-bold">الوزن: @(Model.WeightTons?.ToString("N2") ?? "20.00") طن صافي</div>
            </div>

            <div class="p-4 bg-slate-50 dark:bg-slate-800/40 rounded-2xl border border-slate-100 dark:border-slate-800 space-y-1.5">
                <span class="text-slate-400 block font-bold text-[10px] uppercase">الناقل والآلية:</span>
                <div class="font-bold text-slate-800 dark:text-slate-200">
                    @(Model.Driver?.User != null ? $"{Model.Driver.User.FirstName} {Model.Driver.User.LastName}" : (Model.Company?.Name ?? "سائق معتمد"))
                </div>
                <div class="text-slate-500 font-mono">لوحة: @(Model.Driver?.VehiclePlateNumber ?? "12-38491") • حساب CliQ: @cliqRecipient</div>
            </div>

            <div class="p-4 bg-slate-50 dark:bg-slate-800/40 rounded-2xl border border-slate-100 dark:border-slate-800 space-y-1.5 sm:col-span-2">
                <span class="text-slate-400 block font-bold text-[10px] uppercase">مسار الشحنة وموقع التفريغ:</span>
                <div class="flex items-center gap-2 text-slate-700 dark:text-slate-300">
                    <span class="material-symbols-outlined text-sm text-amber-500">pin_drop</span>
                    <span>من: @Model.PickupLocation</span>
                </div>
                <div class="flex items-center gap-2 font-bold text-slate-900 dark:text-white">
                    <span class="material-symbols-outlined text-sm text-emerald-500">location_on</span>
                    <span>إلى: @Model.DropoffLocation</span>
                </div>
            </div>
        </div>

        @if (isDelivered)
        {
            <!-- Already Delivered Success Card -->
            <div class="p-6 rounded-2xl bg-emerald-500/10 border-2 border-emerald-500/30 text-center space-y-3">
                <div class="w-12 h-12 rounded-full bg-emerald-500 text-white flex items-center justify-center mx-auto text-2xl font-black shadow-lg">
                    ✓
                </div>
                <h3 class="text-base font-black text-emerald-700 dark:text-emerald-400">
                    تم إثبات التسليم بنجاح وتحرير الضمان المالي!
                </h3>
                <p class="text-xs text-slate-600 dark:text-slate-300">
                    تم توثيق إيصال التسليم الإلكتروني (e-POD) وتم إيداع المبلغ في محفظة الناقل عبر CliQ.
                </p>
                <div class="pt-2 flex flex-wrap items-center justify-center gap-3">
                    <a href="/Vendor/Logistics/Manifest/@Model.OrderId" target="_blank"
                       class="px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs flex items-center gap-1.5 shadow-sm">
                        <span class="material-symbols-outlined text-sm">description</span>
                        <span>عرض بيان الحمولة والـ POD</span>
                    </a>
                </div>
            </div>
        }
        else
        {
            <!-- OTP Entry Section (The Hook) -->
            <div id="otpSection" class="p-6 rounded-2xl bg-amber-50/50 dark:bg-slate-800/60 border-2 border-amber-300 dark:border-amber-500/30 space-y-5">
                <div class="text-center space-y-1">
                    <span class="px-3 py-1 rounded-full bg-amber-500/10 text-amber-700 dark:text-amber-300 font-black text-xs">
                        الخطوة النهائية: مطابقة رمز الورشة
                    </span>
                    <h3 class="text-base font-black text-slate-900 dark:text-white pt-1">
                        أدخل رمز التسليم السري (Contractor 6-Digit OTP)
                    </h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400">
                        اطلب الرمز المكون من 6 أرقام من مهندس أو مشرف الموقع بعد اكتمال تفريغ المواد
                    </p>
                </div>

                <div class="max-w-xs mx-auto">
                    <input type="text" id="jobsiteOtpInput" maxlength="6" placeholder="______"
                           class="w-full py-3.5 px-4 bg-white dark:bg-slate-900 border-2 border-amber-400 dark:border-amber-500 rounded-2xl text-center text-2xl font-mono font-black tracking-[0.4em] text-slate-900 dark:text-white focus:ring-4 focus:ring-amber-500/20 outline-none shadow-inner" />
                </div>

                <div class="space-y-2">
                    <label class="block text-xs font-bold text-slate-700 dark:text-slate-300">ملاحظات المستلم عند التفريغ (اختياري)</label>
                    <textarea id="receiverNotesInput" rows="2" placeholder="حالة المواد عند التفريغ، مطابقة أوزان القبان..."
                              class="w-full p-3 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-medium outline-none focus:border-amber-500"></textarea>
                </div>

                <div id="otpFeedbackAlert" class="hidden p-3 rounded-xl text-xs font-bold"></div>

                <button type="button" id="btnSubmitOtp" onclick="submitJobsiteOtp()"
                        class="w-full py-4 px-6 rounded-2xl bg-gradient-to-r from-emerald-600 to-emerald-500 hover:from-emerald-500 hover:to-emerald-600 text-white font-black text-sm shadow-xl shadow-emerald-500/20 transition-all flex items-center justify-center gap-2 cursor-pointer active:scale-98">
                    <span class="material-symbols-outlined text-lg">verified</span>
                    <span>تأكيد التسليم الميداني وإيداع أجور النقل فوراً عبر CliQ</span>
                </button>
            </div>

            <!-- Instant Payout Success Box (Shown dynamically upon success) -->
            <div id="payoutSuccessBox" class="hidden p-6 rounded-3xl bg-emerald-500/10 border-2 border-emerald-500/40 text-center space-y-4">
                <div class="w-14 h-14 rounded-full bg-emerald-500 text-white flex items-center justify-center mx-auto text-3xl font-black shadow-lg">
                    ✓
                </div>
                <div class="space-y-1">
                    <h3 class="text-lg font-black text-emerald-700 dark:text-emerald-400">
                        🎉 تم تحرير الضمان المالي وإيداع المستحقات فوراً!
                    </h3>
                    <p class="text-xs text-slate-600 dark:text-slate-300">
                        تم تأكيد مطابقة الرمز وإغلاق الشحنة بحالة <span class="font-bold text-emerald-600">تم التسليم (Delivered)</span>.
                    </p>
                </div>

                <div class="grid grid-cols-2 gap-3 p-4 bg-white dark:bg-slate-800 rounded-2xl border border-emerald-200 dark:border-emerald-900/60 text-xs">
                    <div>
                        <span class="text-slate-400 block mb-0.5">المبلغ المودع في CliQ:</span>
                        <span class="text-lg font-black font-mono text-emerald-600 dark:text-emerald-400" id="resPayoutAmount">0.00 د.أ</span>
                    </div>
                    <div>
                        <span class="text-slate-400 block mb-0.5">حساب المستفيد (CliQ Alias):</span>
                        <span class="font-bold font-mono text-slate-800 dark:text-slate-200" id="resCliqAlias">@cliqRecipient</span>
                    </div>
                    <div class="col-span-2 pt-2 border-t border-slate-100 dark:border-slate-700 text-slate-400 text-[11px] font-mono">
                        رقم الحوالة المرجعي: <span class="font-bold text-slate-700 dark:text-slate-300" id="resTxnRef">CLIQ-TXN-0000</span>
                    </div>
                </div>

                <div class="flex items-center justify-center gap-3 pt-2">
                    <a href="/Vendor/Logistics/Manifest/@Model.OrderId" target="_blank"
                       class="px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs flex items-center gap-1.5 shadow-sm">
                        <span class="material-symbols-outlined text-sm">print</span>
                        <span>طباعة وثيقة التسليم الرسمية e-POD</span>
                    </a>
                </div>
            </div>

            <!-- Dispute Option (Anti-Disintermediation & Material Protection) -->
            <div class="pt-2 border-t border-slate-100 dark:border-slate-800 text-center">
                <button type="button" onclick="toggleDisputeSection()"
                        class="text-rose-600 hover:text-rose-700 dark:text-rose-400 font-bold text-xs flex items-center justify-center gap-1 mx-auto cursor-pointer">
                    <span class="material-symbols-outlined text-sm">report_problem</span>
                    <span>هل يوجد تلف في المواد، نقص في الحمولة، أو نزاع في الورشة؟</span>
                </button>

                <div id="disputeSection" class="hidden mt-4 p-4 rounded-2xl bg-rose-500/10 border border-rose-500/20 text-right space-y-3">
                    <h4 class="text-xs font-black text-rose-800 dark:text-rose-300">
                        فتح نزاع وتجميد صرف الضمان المالي للشحنة
                    </h4>
                    <p class="text-[11px] text-slate-600 dark:text-slate-300 leading-relaxed">
                        عند تقديم الاعتراض، يتم فوراً تجميد تحرير أموال الشحن وإحالة التقرير إلى فريق الرقابة والمطابقة الهندسية الميدانية للتحقق من الصور وتذاكر القبان.
                    </p>
                    <textarea id="disputeReasonInput" rows="2" placeholder="اذكر تفاصيل النقص، الضرر، أو سبب الاعتراض..."
                              class="w-full p-2.5 bg-white dark:bg-slate-900 border border-rose-200 dark:border-rose-900 rounded-xl text-xs font-medium outline-none focus:ring-1 focus:ring-rose-500"></textarea>
                    
                    <button type="button" onclick="submitDispute()"
                            class="px-5 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs shadow-md transition flex items-center justify-center gap-1 cursor-pointer">
                        <span class="material-symbols-outlined text-sm">lock_clock</span>
                        <span>تأكيد تجميد الصرف وفتح النزاع</span>
                    </button>
                </div>
            </div>
        }

    </div>
</div>

<script>
    function submitJobsiteOtp() {
        const otpInput = document.getElementById('jobsiteOtpInput');
        const notesInput = document.getElementById('receiverNotesInput');
        const feedback = document.getElementById('otpFeedbackAlert');
        const btn = document.getElementById('btnSubmitOtp');
        
        const otp = otpInput.value.trim();
        if (otp.length < 6) {
            feedback.className = "p-3 rounded-xl text-xs font-bold bg-rose-500/10 text-rose-600 border border-rose-500/20 block";
            feedback.innerText = "يرجى إدخال رمز التحقق الميداني المكون من 6 أرقام كاملاً.";
            return;
        }

        btn.disabled = true;
        btn.innerHTML = `<span class="material-symbols-outlined text-lg animate-spin">refresh</span> <span>جاري التحقق وتحرير المستحقات...</span>`;

        fetch('/Delivery/Jobsite/ReleaseOtpPayout', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify({
                jobId: @Model.Id,
                otpCode: otp,
                receiverNotes: notesInput ? notesInput.value : ""
            })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                document.getElementById('otpSection').classList.add('hidden');
                const successBox = document.getElementById('payoutSuccessBox');
                successBox.classList.remove('hidden');
                document.getElementById('resPayoutAmount').innerText = data.payoutAmount.toFixed(2) + ' د.أ';
                if (data.cliqAlias) document.getElementById('resCliqAlias').innerText = data.cliqAlias;
                if (data.transactionReference) document.getElementById('resTxnRef').innerText = data.transactionReference;
            } else {
                feedback.className = "p-3 rounded-xl text-xs font-bold bg-rose-500/10 text-rose-600 border border-rose-500/20 block";
                feedback.innerText = data.message || "رمز التحقق غير صحيح.";
                btn.disabled = false;
                btn.innerHTML = `<span class="material-symbols-outlined text-lg">verified</span> <span>تأكيد التسليم الميداني وإيداع أجور النقل فوراً عبر CliQ</span>`;
            }
        })
        .catch(err => {
            feedback.className = "p-3 rounded-xl text-xs font-bold bg-rose-500/10 text-rose-600 border border-rose-500/20 block";
            feedback.innerText = "حدث خطأ في الاتصال بالخادم. يرجى المحاولة ثانية.";
            btn.disabled = false;
            btn.innerHTML = `<span class="material-symbols-outlined text-lg">verified</span> <span>تأكيد التسليم الميداني وإيداع أجور النقل فوراً عبر CliQ</span>`;
        });
    }

    function toggleDisputeSection() {
        const sec = document.getElementById('disputeSection');
        sec.classList.toggle('hidden');
    }

    function submitDispute() {
        const reason = document.getElementById('disputeReasonInput').value.trim();
        if (!reason) {
            alert('يرجى كتابة سبب الاعتراض أولاً.');
            return;
        }

        if (!confirm('هل أنت متأكد من تجميد صرف مستحقات الشحنة وإحالتها للرقابة الهندسية؟')) return;

        fetch('/Delivery/Jobsite/RaiseDispute?jobId=@Model.Id&reason=' + encodeURIComponent(reason), {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(res => res.json())
        .then(data => {
            alert(data.message);
            window.location.reload();
        })
        .catch(err => {
            alert('حدث خطأ أثناء تسجيل النزاع.');
        });
    }
</script>
