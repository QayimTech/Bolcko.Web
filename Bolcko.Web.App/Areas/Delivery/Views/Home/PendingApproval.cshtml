@{
    ViewData["Title"] = "الطلب قيد التدقيق والمطابقة القانونية | بولكو للخدمات اللوجستية";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
    <style>
        body { font-family: 'Tajawal', sans-serif; }
        .font-mono { font-family: 'JetBrains Mono', monospace; }
    </style>
</head>
<body class="min-h-screen bg-gradient-to-br from-slate-950 via-slate-900 to-blue-950 text-slate-100 flex items-center justify-center p-4 sm:p-6 lg:p-8">

    <div class="w-full max-w-xl bg-slate-900/90 backdrop-blur-2xl border border-white/10 rounded-3xl p-6 sm:p-10 shadow-2xl space-y-6 text-center">
        
        <div class="relative w-20 h-20 mx-auto">
            <div class="absolute inset-0 rounded-full bg-amber-500/20 animate-ping"></div>
            <div class="relative w-20 h-20 bg-amber-500/10 border border-amber-500/30 text-amber-400 rounded-full flex items-center justify-center shadow-xl">
                <span class="material-symbols-outlined text-4xl">hourglass_top</span>
            </div>
        </div>

        <div class="space-y-2">
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-500/10 text-amber-400 text-xs font-mono font-bold border border-amber-500/20">
                <span>KYC VERIFICATION PENDING</span>
            </div>
            <h1 class="text-2xl font-black text-white">طلب الاعتماد قيد التدقيق والمراجعة</h1>
            <p class="text-slate-400 text-xs sm:text-sm max-w-md mx-auto leading-relaxed">
                شكراً لانضمامك إلى شبكة ناقلي بولكو للمواد الإنشائية. يقوم فريق العمليات اللوجستية الآن بمراجعة رخصة القيادة المهنية، الفحص الفني، وترخيص هيئة النقل.
            </p>
        </div>

        @if (TempData["Warning"] != null)
        {
            <div class="bg-amber-500/10 border border-amber-500/30 text-amber-300 p-3 rounded-2xl text-xs flex items-center justify-center gap-2">
                <span class="material-symbols-outlined text-base">info</span>
                <span>@TempData["Warning"]</span>
            </div>
        }

        @if (TempData["Success"] != null)
        {
            <div class="bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 p-3 rounded-2xl text-xs flex items-center justify-center gap-2">
                <span class="material-symbols-outlined text-base">check_circle</span>
                <span>@TempData["Success"]</span>
            </div>
        }

        <!-- Live Verification Tracker -->
        <div class="bg-slate-950/70 border border-white/5 rounded-2xl p-4 text-start space-y-3">
            <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">مراحل التدقيق والمصادقة:</div>
            
            <div class="flex items-center gap-3">
                <div class="w-6 h-6 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 flex items-center justify-center text-xs">
                    ✓
                </div>
                <div class="flex-1 text-xs">
                    <span class="font-bold text-slate-200">استلام الوثائق وبيانات الشاحنة</span>
                    <p class="text-[11px] text-slate-400">تم تسجيل الحساب وإيداع المرفقات بنجاح</p>
                </div>
            </div>

            <div class="flex items-center gap-3">
                <div class="w-6 h-6 rounded-full bg-amber-500/20 text-amber-400 border border-amber-500/40 flex items-center justify-center text-xs animate-pulse">
                    ●
                </div>
                <div class="flex-1 text-xs">
                    <span class="font-bold text-amber-300">مطابقة الفئة ورخصة هيئة النقل البري</span>
                    <p class="text-[11px] text-slate-400">جاري التدقيق من قبل موظفي التدقيق الفني</p>
                </div>
            </div>

            <div class="flex items-center gap-3 opacity-60">
                <div class="w-6 h-6 rounded-full bg-slate-800 text-slate-500 border border-white/10 flex items-center justify-center text-xs">
                    3
                </div>
                <div class="flex-1 text-xs">
                    <span class="font-bold text-slate-400">تفعيل لوحة رادار الحمولات وصرف أجور CliQ</span>
                    <p class="text-[11px] text-slate-500">سيتم فتح المهام وتوجيه الشاحنات فور الاعتماد</p>
                </div>
            </div>
        </div>

        <!-- Support Info & Actions -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
            <form asp-area="Delivery" asp-controller="Account" asp-action="Logout" method="post" class="w-full sm:w-auto">
                @Html.AntiForgeryToken()
                <button type="submit" class="w-full py-2.5 px-6 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-bold transition-colors cursor-pointer border border-white/10 flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-sm">logout</span>
                    <span>تسجيل الخروج</span>
                </button>
            </form>

            <a href="https://wa.me/962790000000" target="_blank" class="w-full sm:w-auto py-2.5 px-6 rounded-xl bg-emerald-600/20 hover:bg-emerald-600/30 text-emerald-300 border border-emerald-500/30 text-xs font-bold transition-colors flex items-center justify-center gap-2">
                <span class="material-symbols-outlined text-sm">support_agent</span>
                <span>تواصل مع عمليات النقل (واتساب)</span>
            </a>
        </div>

    </div>

</body>
</html>
