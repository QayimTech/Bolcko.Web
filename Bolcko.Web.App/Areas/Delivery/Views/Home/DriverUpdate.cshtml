@using Bolcko.Domain.Entities.Delivery
@using Bolcko.Domain.Enums
@model DeliveryJob
@{
    Layout = null;
    var totalCodAmount = Model.Order?.TotalAmount ?? 0m;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>تحديث الشحنة #@Model.Id | أساطيل بلوكو للنقل الثقيل</title>
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;700;800&family=Noto+Kufi+Arabic:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
    <style>
        body { font-family: 'Noto Kufi Arabic', sans-serif; }
        .font-mono { font-family: 'JetBrains Mono', monospace; }
    </style>
</head>
<body class="bg-[#0B0F17] text-slate-100 flex items-center justify-center min-h-screen p-4 selection:bg-amber-500 selection:text-slate-950">
    <div class="w-full max-w-md bg-[#0D111A] rounded-3xl border border-slate-800 shadow-2xl overflow-hidden">
        
        <!-- Brand Header -->
        <div class="bg-[#070A0F] text-white p-6 text-center border-b border-slate-800 relative">
            <div class="w-12 h-12 bg-amber-500/15 border border-amber-500/30 rounded-2xl flex items-center justify-center mx-auto mb-2 text-amber-400">
                <span class="material-symbols-outlined text-2xl">rv_hookup</span>
            </div>
            <h1 class="font-black text-lg tracking-wider text-amber-400">BLOCKO HEAVY FLEET</h1>
            <p class="text-xs text-slate-400 mt-0.5">تحديث تسليم شحنة #@Model.Id (طلب @(Model.Order?.OrderNumber ?? ""))</p>
        </div>

        <!-- Feedback Messages -->
        @if (ViewBag.SuccessMessage != null)
        {
            <div class="p-8 text-center space-y-4">
                <div class="w-20 h-20 bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 rounded-full flex items-center justify-center mx-auto shadow-inner">
                    <span class="material-symbols-outlined text-5xl">check_circle</span>
                </div>
                <h2 class="font-black text-white text-xl">@ViewBag.SuccessMessage</h2>
                <p class="text-xs text-slate-400 leading-relaxed">تمت مزامنة حالة الطلب مع حساب الزبون ولوحة العمليات اللوجستية بنجاح.</p>
                <div class="pt-4 border-t border-slate-800 text-[11px] text-slate-500 font-bold">شكراً لجهودكم في قطاع النقل الإنشائي 🚛</div>
            </div>
        }
        else
        {
            @if (ViewBag.ErrorMessage != null)
            {
                <div class="m-6 p-4 bg-rose-500/10 border border-rose-500/30 text-rose-300 rounded-2xl text-xs font-bold flex items-center gap-2">
                    <span class="material-symbols-outlined text-sm">error</span>
                    @ViewBag.ErrorMessage
                </div>
            }

            <div class="p-6 space-y-6">
                <!-- Customer info card -->
                <div class="bg-[#070A0F] rounded-2xl border border-slate-800 p-4 space-y-3">
                    <div class="flex justify-between items-center border-b border-slate-800 pb-2">
                        <h3 class="font-black text-white text-xs flex items-center gap-1.5">
                            <span class="material-symbols-outlined text-sm text-amber-400">person</span>
                            بيانات المستلم في الموقع
                        </h3>
                        <span class="text-[10px] bg-slate-800 text-amber-300 px-2 py-0.5 rounded-full font-bold font-mono">شحنة #@Model.Id</span>
                    </div>
                    <div class="text-xs space-y-1">
                        <p class="font-bold text-white text-sm">@(Model.Order?.User?.FirstName) @(Model.Order?.User?.LastName)</p>
                        <p class="text-slate-400">📍 @(Model.Order?.ShippingAddress?.AddressLine1), @(Model.Order?.ShippingAddress?.City)</p>
                    </div>
                    
                    @if (!string.IsNullOrEmpty(Model.Order?.User?.PhoneNumber))
                    {
                        <a href="tel:@(Model.Order.User.PhoneNumber)" class="w-full py-3 bg-indigo-600 hover:bg-indigo-500 text-white font-black rounded-xl text-xs flex items-center justify-center gap-2 shadow-md shadow-indigo-950/60 transition-all active:scale-95">
                            <span class="material-symbols-outlined text-base">call</span>
                            اتصال هاتفي بالمستلم (@Model.Order.User.PhoneNumber)
                        </a>
                    }
                </div>

                <!-- Financial Badges -->
                <div class="grid grid-cols-2 gap-3">
                    <div class="bg-amber-950/20 border border-amber-500/30 rounded-2xl p-3 text-center">
                        <span class="text-[10px] text-amber-300 font-bold uppercase block mb-1">المبلغ المطلوب (COD)</span>
                        <span class="text-xl font-black text-amber-400 font-mono">@totalCodAmount.ToString("N2") <span class="text-xs font-sans">د.أ</span></span>
                        <span class="text-[9px] text-amber-400/80 font-bold block mt-1">شامل التوصيل بالكامل</span>
                    </div>
                    <div class="bg-[#070A0F] border border-slate-800 rounded-2xl p-3 text-center">
                        <span class="text-[10px] text-slate-400 font-bold uppercase block mb-1">أجرة التوصيل المستحقة</span>
                        <span class="text-xl font-black text-emerald-400 font-mono">@(Model.DeliveryFee.ToString("N2")) <span class="text-xs font-sans">د.أ</span></span>
                        <span class="text-[9px] text-slate-500 block mt-1">صرف مباشر عبر كليك</span>
                    </div>
                </div>

                <!-- Action Preset Selector -->
                <div>
                    <label class="block text-xs font-black text-slate-300 mb-2">حدد حالة التوصيل بنقرة واحدة:</label>
                    <div class="grid grid-cols-3 gap-2">
                        <button type="button" onclick="selectPreset('delivered')" id="btn-delivered"
                                class="preset-btn py-2.5 px-2 bg-emerald-500/15 border-2 border-emerald-500 text-emerald-300 font-black rounded-xl text-[11px] flex flex-col items-center gap-1 transition-all cursor-pointer">
                            <span class="material-symbols-outlined text-lg">check_circle</span>
                            تسليم كامل
                        </button>
                        <button type="button" onclick="selectPreset('returned')" id="btn-returned"
                                class="preset-btn py-2.5 px-2 bg-[#070A0F] border border-slate-700 text-slate-400 font-bold rounded-xl text-[11px] flex flex-col items-center gap-1 transition-all cursor-pointer">
                            <span class="material-symbols-outlined text-lg">cancel</span>
                            مرتجع كامل
                        </button>
                        <button type="button" onclick="selectPreset('partial')" id="btn-partial"
                                class="preset-btn py-2.5 px-2 bg-[#070A0F] border border-slate-700 text-slate-400 font-bold rounded-xl text-[11px] flex flex-col items-center gap-1 transition-all cursor-pointer">
                            <span class="material-symbols-outlined text-lg">published_with_changes</span>
                            تسليم جزئي
                        </button>
                    </div>
                </div>

                <!-- Main Form -->
                <form asp-action="SubmitDriverUpdate" method="post" class="space-y-4 pt-2 border-t border-slate-800">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="token" value="@Model.DeliveryToken" />

                    <div class="space-y-1.5">
                        <label class="block text-xs font-bold text-slate-300">المبلغ المحصل فعلياً (د.أ) *</label>
                        <input name="collectedAmount" id="collectedInput" type="number" step="0.01" min="0" value="@totalCodAmount.ToString("F2")" required
                               class="w-full bg-[#070A0F] border border-slate-700 rounded-xl px-4 py-3 text-sm font-bold text-white focus:border-amber-500 outline-none transition-all font-mono" />
                    </div>

                    <div class="space-y-1.5">
                        <label class="block text-xs font-bold text-slate-300">سبب المرتجع / ملاحظات (اختياري)</label>
                        <select id="reasonPreset" onchange="applyReasonPreset(this.value)" class="w-full bg-[#070A0F] border border-slate-700 rounded-xl px-3 py-2 text-xs text-slate-200 outline-none mb-2 hidden">
                            <option value="">-- اختر سبب الارتجاع الشائع --</option>
                            <option value="الزبون لم يرد على الاتصال الهاتفي">الزبون لم يرد على الاتصال الهاتفي</option>
                            <option value="الزبون رفض الاستلام">الزبون رفض الاستلام</option>
                            <option value="العنوان مكتوب بشكل غير صحيح">العنوان غير صحيح / خارج التغطية</option>
                            <option value="الزبون طلب إرجاع الشحنة">الزبون طلب إلغاء وإرجاع الشحنة</option>
                        </select>
                        <textarea name="returnReason" id="reasonInput" rows="2" placeholder="ملاحظات التسليم أو سبب المرتجع..."
                                  class="w-full bg-[#070A0F] border border-slate-700 text-white rounded-xl px-4 py-3 text-xs focus:border-amber-500 outline-none transition-all"></textarea>
                    </div>

                    <button type="submit" class="w-full py-3.5 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 text-xs font-black rounded-xl shadow-lg shadow-amber-950/60 transition-all active:scale-95 cursor-pointer">
                        حفظ وتأكيد التحديث
                    </button>
                </form>
            </div>
        }
    </div>

    <script>
        const totalCod = @totalCodAmount.ToString(System.Globalization.CultureInfo.InvariantCulture);

        function selectPreset(type) {
            document.querySelectorAll('.preset-btn').forEach(b => {
                b.className = "preset-btn py-2.5 px-2 bg-[#070A0F] border border-slate-700 text-slate-400 font-bold rounded-xl text-[11px] flex flex-col items-center gap-1 transition-all cursor-pointer";
            });

            const btn = document.getElementById('btn-' + type);
            const input = document.getElementById('collectedInput');
            const reasonSelect = document.getElementById('reasonPreset');
            const reasonInput = document.getElementById('reasonInput');

            if (type === 'delivered') {
                btn.className = "preset-btn py-2.5 px-2 bg-emerald-500/15 border-2 border-emerald-500 text-emerald-300 font-black rounded-xl text-[11px] flex flex-col items-center gap-1 transition-all shadow-sm cursor-pointer";
                input.value = totalCod.toFixed(2);
                reasonSelect.classList.add('hidden');
                reasonInput.value = '';
            } else if (type === 'returned') {
                btn.className = "preset-btn py-2.5 px-2 bg-rose-500/15 border-2 border-rose-500 text-rose-300 font-black rounded-xl text-[11px] flex flex-col items-center gap-1 transition-all shadow-sm cursor-pointer";
                input.value = '0.00';
                reasonSelect.classList.remove('hidden');
                reasonInput.value = 'الزبون لم يرد على الاتصال الهاتفي';
            } else if (type === 'partial') {
                btn.className = "preset-btn py-2.5 px-2 bg-amber-500/15 border-2 border-amber-500 text-amber-300 font-black rounded-xl text-[11px] flex flex-col items-center gap-1 transition-all shadow-sm cursor-pointer";
                input.value = (totalCod / 2).toFixed(2);
                reasonSelect.classList.remove('hidden');
                reasonInput.value = 'تسليم جزئي للبضاعة';
            }
        }

        function applyReasonPreset(val) {
            if (val) {
                document.getElementById('reasonInput').value = val;
            }
        }
    </script>
</body>
</html>
