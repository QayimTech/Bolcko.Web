@using Bolcko.Domain.Entities.Delivery
@model DeliveryJob

<div class="bg-slate-900 border border-white/10 hover:border-amber-500/40 rounded-3xl p-5 sm:p-6 shadow-xl space-y-4 transition-all hover:shadow-2xl hover:shadow-amber-500/5 text-right" dir="rtl">
    <!-- Header of Card: Material & Order Number & Payout -->
    <div class="flex items-start justify-between gap-3 border-b border-white/10 pb-4">
        <div class="space-y-1">
            <div class="flex items-center gap-2 flex-wrap">
                <span class="px-3 py-1 rounded-xl bg-amber-500/10 text-amber-300 font-bold text-xs border border-amber-500/30 flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-sm">construction</span>
                    <span>@(string.IsNullOrEmpty(Model.MaterialType) ? "مواد إنشائية ثقيلة" : Model.MaterialType)</span>
                </span>
                <span class="font-mono text-slate-400 text-xs">طلب #@(Model.Order?.OrderNumber ?? Model.OrderId.ToString())</span>
            </div>
            <div class="text-xs text-slate-300 font-bold flex items-center gap-1.5 pt-1">
                <span class="material-symbols-outlined text-sm text-blue-400">scale</span>
                <span>الحمولة التقديرية:</span>
                <span class="font-mono text-white text-sm">@(Model.WeightTons?.ToString("N1") ?? "15.0") طن</span>
            </div>
        </div>

        <div class="text-left bg-emerald-950/40 border border-emerald-500/30 rounded-2xl px-3.5 py-2">
            <span class="text-[10px] text-emerald-400 block font-bold">صافي أجر النقل الفوري</span>
            <div class="text-xl sm:text-2xl font-black text-emerald-400 font-mono">
                @Model.DeliveryFee.ToString("N2") <span class="text-xs font-sans">د.أ</span>
            </div>
        </div>
    </div>

    <!-- Route: Pickup yard -> Destination jobsite -->
    <div class="space-y-2.5 text-xs bg-slate-950/60 p-3.5 rounded-2xl border border-white/5">
        <div class="flex items-start gap-2.5">
            <div class="w-6 h-6 rounded-lg bg-blue-500/20 text-blue-400 flex items-center justify-center shrink-0 mt-0.5">
                <span class="material-symbols-outlined text-sm">warehouse</span>
            </div>
            <div class="flex-1">
                <span class="text-[11px] text-slate-400 block">نقطة التحميل (مستودع / كسارة / مصنع):</span>
                <span class="font-bold text-white">@(string.IsNullOrEmpty(Model.PickupLocation) ? "مستودع بولكو الإنشائي الرئيسي" : Model.PickupLocation)</span>
            </div>
        </div>

        <div class="h-4 border-r-2 border-dashed border-slate-700 me-3"></div>

        <div class="flex items-start gap-2.5">
            <div class="w-6 h-6 rounded-lg bg-amber-500/20 text-amber-400 flex items-center justify-center shrink-0 mt-0.5">
                <span class="material-symbols-outlined text-sm">location_on</span>
            </div>
            <div class="flex-1">
                <span class="text-[11px] text-slate-400 block">موقع الورشة / مشروع العميل (Dropoff):</span>
                <span class="font-bold text-amber-300">@(string.IsNullOrEmpty(Model.DropoffLocation) ? "موقع العمل - الأردن" : Model.DropoffLocation)</span>
            </div>
        </div>
    </div>

    <!-- Actions: 1-Click Accept Load or Quick Bid -->
    <div class="flex flex-col sm:flex-row items-center gap-2 pt-2">
        <form asp-action="AcceptLoad" method="post" class="w-full sm:flex-1">
            @Html.AntiForgeryToken()
            <input type="hidden" name="jobId" value="@Model.Id" />
            <button type="submit" 
                    class="w-full py-3.5 px-4 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-black text-xs sm:text-sm flex items-center justify-center gap-2 shadow-lg shadow-amber-950/60 transition-all cursor-pointer active:scale-95">
                <span class="material-symbols-outlined text-lg font-bold">check_circle</span>
                <span>قبول الحمولة والانطلاق للمستودع فوراً 🚚</span>
            </button>
        </form>

        <a href="https://maps.google.com/?q=@Uri.EscapeDataString(Model.DropoffLocation ?? "Amman")" target="_blank" 
           class="w-full sm:w-auto py-3.5 px-4 rounded-xl border border-white/10 bg-slate-800 hover:bg-slate-700 text-white font-bold text-xs flex items-center justify-center gap-1.5 transition-colors">
            <span class="material-symbols-outlined text-base">near_me</span>
            <span>الخريطة</span>
        </a>
    </div>
</div>
