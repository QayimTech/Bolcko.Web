@using Bolcko.Domain.Entities.Delivery
@using Bolcko.Domain.Enums
@model IEnumerable<DeliveryJob>
@{
    ViewData["Title"] = "لوحة أساطيل 3PL وإدارة العمليات اللوجستية | بلوكو";
    Layout = "_Layout";
    var company = ViewBag.Company as DeliveryCompany;
    
    // تقسيم الشحنات حسب الحالة
    var pendingPickup = Model.Where(j => j.Status == DeliveryJobStatus.Assigned || j.Status == DeliveryJobStatus.Available);
    var outForDelivery = Model.Where(j => j.Status == DeliveryJobStatus.PickedUp || jobIsActive(j));
    var archivedJobs = Model.Where(j => j.Status == DeliveryJobStatus.Delivered || j.Status == DeliveryJobStatus.Returned || j.Status == DeliveryJobStatus.Cancelled);

    bool jobIsActive(DeliveryJob j) {
        return j.Status == DeliveryJobStatus.InTransit;
    }
}

<div class="p-3 sm:p-6 lg:p-8 max-w-7xl mx-auto space-y-8 text-right font-sans" dir="rtl">
    
    <!-- Header Banner -->
    <div class="bg-[#0D111A] rounded-3xl border border-slate-800 p-6 md:p-8 shadow-2xl flex flex-col md:flex-row justify-between items-start md:items-center gap-5">
        <div class="space-y-1">
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-2xl bg-amber-500/15 border border-amber-500/30 text-amber-400 flex items-center justify-center font-bold">
                    <span class="material-symbols-outlined text-3xl">corporate_fare</span>
                </div>
                <div>
                    <h1 class="text-xl sm:text-2xl font-black text-white flex items-center gap-2">
                        <span>@(company?.Name ?? "شركة أسطول النقل اللوجستي 3PL")</span>
                        <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/15 text-emerald-400 font-mono text-xs font-bold border border-emerald-500/30">
                            ناقل معتمد
                        </span>
                    </h1>
                    <p class="text-xs text-slate-400 mt-0.5">لوحة التحكم المركزية للأساطيل: تعيين السائقين، تتبع الشحنات الإنشائية، وتسوية الحسابات المالية.</p>
                </div>
            </div>
        </div>

        <div class="flex flex-wrap items-center gap-3 text-xs w-full md:w-auto">
            <a href="@Url.Action("ExportDispatchSheet", "Home", new { area = "Delivery" })" 
               class="px-4 py-2.5 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-black rounded-xl shadow-lg shadow-amber-950/60 transition-all flex items-center gap-2">
                <span class="material-symbols-outlined text-base">download</span>
                <span>تصدير كشف الحساب اليومي (Excel)</span>
            </a>
            <span class="px-3.5 py-2.5 bg-[#070A0F] text-slate-300 font-mono font-bold rounded-xl border border-slate-800">
                السعر الأساسي: <strong class="text-amber-400">@(company?.BaseDeliveryRate.ToString("N2") ?? "0.00") د.أ</strong>
            </span>
        </div>
    </div>

    <!-- Alert notifications -->
    @if (TempData["Success"] != null)
    {
        <div class="p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-xs sm:text-sm font-bold flex items-center gap-3 shadow-lg shadow-emerald-950/40">
            <span class="material-symbols-outlined text-emerald-400 text-2xl">check_circle</span>
            <span>@TempData["Success"]</span>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="p-4 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-rose-300 text-xs sm:text-sm font-bold flex items-center gap-3 shadow-lg shadow-rose-950/40">
            <span class="material-symbols-outlined text-rose-400 text-2xl">error</span>
            <span>@TempData["Error"]</span>
        </div>
    }

    <!-- Date Range Filter (DRY Partial) -->
    <partial name="~/Views/Shared/Partials/Logistics/_DateRangeFilter.cshtml" view-data='new ViewDataDictionary(ViewData) { { "AreaName", "Delivery" }, { "ControllerName", "Home" }, { "ActionName", "CompanyIndex" } }' />

    <!-- Financial Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        <div class="bg-[#0D111A] p-5 sm:p-6 rounded-3xl border border-slate-800 shadow-xl space-y-2">
            <div class="flex items-center justify-between">
                <span class="text-[11px] text-slate-400 font-bold uppercase tracking-wider">إجمالي الشحنات</span>
                <span class="material-symbols-outlined text-blue-400">local_shipping</span>
            </div>
            <div class="text-3xl font-black text-white font-mono">@ViewBag.TotalJobs</div>
            <span class="text-[11px] text-amber-400 font-mono block">نشطة حالياً: @ViewBag.ActiveJobs</span>
        </div>

        <div class="bg-[#0D111A] p-5 sm:p-6 rounded-3xl border border-slate-800 shadow-xl space-y-2">
            <div class="flex items-center justify-between">
                <span class="text-[11px] text-slate-400 font-bold uppercase tracking-wider">أجور النقل المستحقة</span>
                <span class="material-symbols-outlined text-emerald-400">payments</span>
            </div>
            <div class="text-3xl font-black text-emerald-400 font-mono">@ViewBag.TotalFees.ToString("N2") <span class="text-xs font-sans">د.أ</span></div>
            <span class="text-[11px] text-slate-400 block">عن الشحنات المستلمة والمرتجعة</span>
        </div>

        <div class="bg-[#0D111A] p-5 sm:p-6 rounded-3xl border border-slate-800 shadow-xl space-y-2">
            <div class="flex items-center justify-between">
                <span class="text-[11px] text-slate-400 font-bold uppercase tracking-wider">إجمالي المبالغ المحصلة</span>
                <span class="material-symbols-outlined text-amber-400">monetization_on</span>
            </div>
            <div class="text-3xl font-black text-amber-400 font-mono">@ViewBag.TotalCollected.ToString("N2") <span class="text-xs font-sans">د.أ</span></div>
            <span class="text-[11px] text-slate-400 block">مبالغ الدفع عند الاستلام (COD)</span>
        </div>

        <div class="bg-[#0D111A] p-5 sm:p-6 rounded-3xl border border-amber-500/40 shadow-xl space-y-2 ring-1 ring-amber-500/20">
            <div class="flex items-center justify-between">
                <span class="text-[11px] text-amber-400 font-black uppercase tracking-wider">المستحقات المعلقة للتصفية</span>
                <span class="material-symbols-outlined text-amber-400">account_balance_wallet</span>
            </div>
            <div class="text-3xl font-black text-white font-mono">@ViewBag.UnreconciledAmount.ToString("N2") <span class="text-xs font-sans text-amber-400">د.أ</span></div>
            <span class="text-[11px] text-slate-400 block">بانتظار التحويل والحساب الختامي</span>
        </div>
    </div>

    <!-- Charts & Analytics Section (DRY Partial) -->
    <partial name="~/Views/Shared/Partials/Logistics/_LogisticsCharts.cshtml" view-data='new ViewDataDictionary(ViewData) { { "ChartSuffix", "CompanyDashboard" } }' />

    <!-- TABS Navigation -->
    <div class="flex border-b border-slate-800 bg-[#070A0F] p-2 rounded-2xl gap-2 flex-wrap">
        <button onclick="switchTab('pickup')" id="tab-pickup" class="tab-btn flex-1 py-3 px-4 text-xs font-black rounded-xl transition-all flex items-center justify-center gap-2 bg-[#0D111A] text-amber-400 border border-slate-800 shadow-sm cursor-pointer">
            <span class="material-symbols-outlined text-sm">download</span>
            <span>بانتظار الاستلام والتعيين (@pendingPickup.Count())</span>
        </button>
        <button onclick="switchTab('delivery')" id="tab-delivery" class="tab-btn flex-1 py-3 px-4 text-xs font-black rounded-xl transition-all flex items-center justify-center gap-2 text-slate-400 hover:text-white cursor-pointer">
            <span class="material-symbols-outlined text-sm">local_shipping</span>
            <span>قيد التوصيل في الشارع (@outForDelivery.Count())</span>
        </button>
        <button onclick="switchTab('archive')" id="tab-archive" class="tab-btn flex-1 py-3 px-4 text-xs font-black rounded-xl transition-all flex items-center justify-center gap-2 text-slate-400 hover:text-white cursor-pointer">
            <span class="material-symbols-outlined text-sm">archive</span>
            <span>الشحنات المنجزة (@archivedJobs.Count())</span>
        </button>
        <button onclick="switchTab('fleet')" id="tab-fleet" class="tab-btn flex-1 py-3 px-4 text-xs font-black rounded-xl transition-all flex items-center justify-center gap-2 text-slate-400 hover:text-white cursor-pointer">
            <span class="material-symbols-outlined text-sm">rv_hookup</span>
            <span>سجل أسطول الشاحنات والسائقين</span>
        </button>
    </div>

    <!-- TABS Content -->
    
    <!-- Tab A: Pending Pickup -->
    <div id="content-pickup" class="tab-content bg-[#0D111A] rounded-3xl border border-slate-800 shadow-xl overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-right">
                <thead class="bg-[#070A0F] text-slate-400 font-bold text-[11px] uppercase border-b border-slate-800">
                    <tr>
                        <th class="px-6 py-4">رقم الشحنة والمادة</th>
                        <th class="px-6 py-4">الزبون وموقع الورشة</th>
                        <th class="px-6 py-4">السائق والشاحنة المسندة</th>
                        <th class="px-6 py-4">أجر التوصيل</th>
                        <th class="px-6 py-4 text-center">الإجراء والإسناد</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-800/80 text-xs">
                    @foreach (var job in pendingPickup)
                    {
                        <tr class="hover:bg-slate-800/30 transition-colors">
                            <td class="px-6 py-4">
                                <span class="font-bold text-white block">طلب #@(job.Order?.OrderNumber ?? job.OrderId.ToString())</span>
                                <span class="text-amber-400 font-bold text-[11px] block mt-0.5">@(string.IsNullOrEmpty(job.MaterialType) ? "مواد إنشائية ثقيلة" : job.MaterialType)</span>
                            </td>
                            <td class="px-6 py-4">
                                <span class="block font-bold text-slate-200">@(job.Order?.User?.FirstName) @(job.Order?.User?.LastName)</span>
                                <span class="block text-slate-400 text-[10px] mt-0.5">@(job.DropoffLocation)</span>
                            </td>
                            <td class="px-6 py-4">
                                @if (job.Driver != null)
                                {
                                    <span class="px-2.5 py-1 rounded-lg bg-emerald-500/10 text-emerald-400 font-bold text-xs border border-emerald-500/20 block w-fit">
                                        🚛 @(job.Driver.User?.FirstName) @(job.Driver.User?.LastName)
                                    </span>
                                    <span class="text-[10px] text-slate-400 block mt-0.5 font-mono">لوحة: @(job.Driver.VehiclePlateNumber ?? "-")</span>
                                }
                                else
                                {
                                    <span class="px-2.5 py-1 rounded-lg bg-amber-500/10 text-amber-400 font-bold text-xs border border-amber-500/30 block w-fit">
                                        ⚠️ لم يُعين سائق بعد
                                    </span>
                                }
                            </td>
                            <td class="px-6 py-4 font-bold text-emerald-400 font-mono text-sm">@job.DeliveryFee.ToString("N2") د.أ</td>
                            <td class="px-6 py-4 text-center">
                                <div class="flex items-center justify-center gap-2 flex-wrap">
                                    <button type="button" 
                                            onclick="openDispatchAssignModal('@job.Id', '@(job.Order?.OrderNumber ?? job.OrderId.ToString())', '@(job.MaterialType ?? "مواد إنشائية")', '@(job.DropoffLocation)')"
                                            class="px-3.5 py-2 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-xl text-xs transition-all flex items-center gap-1 shadow-md cursor-pointer">
                                        <span class="material-symbols-outlined text-sm">person_add</span>
                                        <span>تعيين السائق للشحنة</span>
                                    </button>

                                    <form asp-action="AcceptPickup" method="post" class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="jobId" value="@job.Id" />
                                        <button type="submit" class="px-3.5 py-2 bg-[#070A0F] hover:bg-slate-800 border border-slate-700 text-white font-bold rounded-xl text-xs transition-all cursor-pointer">
                                            استلام من المخزن
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!pendingPickup.Any())
                    {
                        <tr><td colspan="5" class="px-6 py-12 text-center text-slate-400 italic">لا توجد شحنات بانتظار الاستلام حالياً.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Tab B: Out for Delivery -->
    <div id="content-delivery" class="tab-content bg-[#0D111A] rounded-3xl border border-slate-800 shadow-xl overflow-hidden hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-right">
                <thead class="bg-[#070A0F] text-slate-400 font-bold text-[11px] uppercase border-b border-slate-800">
                    <tr>
                        <th class="px-6 py-4">رقم الشحنة</th>
                        <th class="px-6 py-4">الزبون والعنوان</th>
                        <th class="px-6 py-4">المبلغ المطلوب (COD)</th>
                        <th class="px-6 py-4">مشاركة التتبع</th>
                        <th class="px-6 py-4 text-center">خيارات التحديث</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-800/80 text-xs">
                    @foreach (var job in outForDelivery)
                    {
                        var quickLink = $"{Context.Request.Scheme}://{Context.Request.Host}/Delivery/Home/DriverUpdate?token={job.DeliveryToken}";
                        <tr class="hover:bg-slate-800/30 transition-colors">
                            <td class="px-6 py-4 font-bold text-white font-mono">شحنة #@job.Id</td>
                            <td class="px-6 py-4">
                                <span class="block font-bold text-slate-200">@(job.Order?.User?.FirstName) @(job.Order?.User?.LastName)</span>
                                <span class="block text-slate-400 text-[10px] mt-0.5">@(job.Order?.User?.PhoneNumber ?? "—") | @(job.Order?.ShippingAddress?.AddressLine1), @(job.Order?.ShippingAddress?.City)</span>
                            </td>
                            <td class="px-6 py-4 font-bold text-amber-400 font-mono">@(job.Order?.TotalAmount.ToString("N2")) د.أ</td>
                            <td class="px-6 py-4">
                                <button onclick="copyDriverLink('@quickLink')" class="px-3 py-1.5 bg-[#070A0F] hover:bg-slate-800 border border-slate-700 text-slate-300 font-bold rounded-xl text-[10px] transition-all flex items-center gap-1 cursor-pointer">
                                    <span class="material-symbols-outlined text-xs text-amber-400">link</span>
                                    رابط السائق السريع
                                </button>
                            </td>
                            <td class="px-6 py-4 text-center">
                                <button onclick="openReconcileModal(@job.Id, @(job.Order?.TotalAmount ?? 0))" class="px-3 py-1.5 bg-amber-500 hover:bg-amber-400 text-slate-950 font-black rounded-xl text-[10px] transition-all cursor-pointer">
                                    تحديث الحالة والتحصيل
                                </button>
                            </td>
                        </tr>
                    }
                    @if (!outForDelivery.Any())
                    {
                        <tr><td colspan="5" class="px-6 py-12 text-center text-slate-400 italic">لا توجد شحنات قيد التوصيل حالياً.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Tab C: Archive (Completed) -->
    <div id="content-archive" class="tab-content bg-[#0D111A] rounded-3xl border border-slate-800 shadow-xl overflow-hidden hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-right">
                <thead class="bg-[#070A0F] text-slate-400 font-bold text-[11px] uppercase border-b border-slate-800">
                    <tr>
                        <th class="px-6 py-4">رقم الشحنة</th>
                        <th class="px-6 py-4">الزبون والعنوان</th>
                        <th class="px-6 py-4">المبلغ المطلوب (COD)</th>
                        <th class="px-6 py-4">المحصل فعلياً</th>
                        <th class="px-6 py-4">الحالة والمالية</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-800/80 text-xs">
                    @foreach (var job in archivedJobs)
                    {
                        <tr class="hover:bg-slate-800/30 transition-colors">
                            <td class="px-6 py-4 font-bold text-white font-mono">شحنة #@job.Id</td>
                            <td class="px-6 py-4">
                                <span class="block font-bold text-slate-200">@(job.Order?.User?.FirstName) @(job.Order?.User?.LastName)</span>
                                <span class="block text-slate-400 text-[10px]">@(job.Order?.ShippingAddress?.AddressLine1), @(job.Order?.ShippingAddress?.City)</span>
                            </td>
                            <td class="px-6 py-4 font-bold text-slate-300 font-mono">@(job.Order?.TotalAmount.ToString("N2")) د.أ</td>
                            <td class="px-6 py-4 font-bold font-mono @(job.CollectedAmount == 0 ? "text-rose-400" : "text-emerald-400")">
                                @(job.CollectedAmount.HasValue ? $"{job.CollectedAmount.Value.ToString("N2")} د.أ" : "—")
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex flex-col gap-1">
                                    @if (job.Status == DeliveryJobStatus.Delivered)
                                    {
                                        <span class="bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 px-2 py-0.5 rounded-full text-[10px] font-bold inline-block w-fit">✔ تم التوصيل</span>
                                    }
                                    else if (job.Status == DeliveryJobStatus.Returned)
                                    {
                                        <span class="bg-rose-500/10 text-rose-400 border border-rose-500/20 px-2 py-0.5 rounded-full text-[10px] font-bold inline-block w-fit">✖ مرتجع كامل</span>
                                    }
                                    
                                    @if (job.IsReconciled)
                                    {
                                        <span class="bg-indigo-500/15 text-indigo-300 border border-indigo-500/30 px-2 py-0.5 rounded-full text-[10px] font-black inline-block w-fit">💰 تمت التسوية المالية</span>
                                    }
                                    else
                                    {
                                        <span class="bg-slate-800 text-slate-400 border border-slate-700 px-2 py-0.5 rounded-full text-[10px] font-bold inline-block w-fit">⏳ بانتظار التسوية</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!archivedJobs.Any())
                    {
                        <tr><td colspan="5" class="px-6 py-12 text-center text-slate-400 italic">لا توجد شحنات منجزة بالأرشيف.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Tab D: Fleet Roster & Trucks (LOG-04) -->
    <div id="content-fleet" class="tab-content hidden">
        <partial name="Partials/_FleetTrucksManager" />
    </div>

    <!-- Dispatch Assignment Modal (LOG-04) -->
    <partial name="Partials/_DispatchAssignmentModal" />
</div>

<!-- Reconcile Modal -->
<div id="reconcileModal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center hidden opacity-0 transition-opacity duration-300 p-4">
    <div class="bg-[#0D111A] border border-slate-800 w-full max-w-md rounded-3xl shadow-2xl overflow-hidden transform scale-95 transition-transform duration-300">
        <div class="px-6 py-4 border-b border-slate-800 flex justify-between items-center bg-[#070A0F]">
            <h3 class="font-black text-white text-xs uppercase tracking-wider">تحديث حالة التوصيل والتحصيل المالي</h3>
            <button onclick="closeReconcileModal()" class="text-slate-400 hover:text-white transition-colors cursor-pointer">
                <span class="material-symbols-outlined text-lg">close</span>
            </button>
        </div>
        <form asp-action="UpdateCompanyCollection" method="post" class="p-6 space-y-4 text-right" dir="rtl">
            @Html.AntiForgeryToken()
            <input type="hidden" name="jobId" id="modalJobId" />

            <div class="space-y-1.5">
                <p class="text-xs text-slate-400">قيمة الطلب الإجمالية المطلوبة: <span id="modalOrderAmount" class="font-bold text-amber-400 font-mono">0</span> د.أ</p>
                <label class="block text-xs font-bold text-slate-300">المبلغ المحصل فعلياً (د.أ):</label>
                <input name="collectedAmount" id="modalCollectedInput" type="number" step="0.01" min="0" required
                       class="w-full bg-[#070A0F] border border-slate-700 text-white rounded-xl px-4 py-3 text-xs focus:border-amber-500 focus:outline-none transition-all font-mono" />
                <p class="text-[10px] text-slate-500">أدخل (0) في حال كان الطلب مرتجعاً بالكامل.</p>
            </div>

            <div class="space-y-1.5">
                <label class="block text-xs font-bold text-slate-300">السبب / ملاحظات المرتجع (اختياري):</label>
                <textarea name="returnReason" id="modalReasonInput" rows="2" placeholder="اكتب سبب الارتجاع في حال المرتجع الكامل أو الجزئي..."
                          class="w-full bg-[#070A0F] border border-slate-700 text-white rounded-xl px-4 py-3 text-xs focus:border-amber-500 focus:outline-none transition-all"></textarea>
            </div>

            <div class="flex justify-end gap-3 pt-3 border-t border-slate-800">
                <button type="button" onclick="closeReconcileModal()" class="px-5 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-bold rounded-xl transition-all cursor-pointer">إلغاء</button>
                <button type="submit" class="px-6 py-2.5 bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-black rounded-xl shadow-lg shadow-amber-950/60 transition-all cursor-pointer active:scale-95">حفظ وتحديث</button>
            </div>
        </form>
    </div>
</div>

<script>
    function switchTab(tabId) {
        // إخفاء كل المحتويات وإلغاء تنشيط كل الأزرار
        document.querySelectorAll('.tab-content').forEach(c => c.classList.add('hidden'));
        document.querySelectorAll('.tab-btn').forEach(b => {
            b.classList.remove('bg-[#0D111A]', 'text-amber-400', 'border', 'border-slate-800', 'shadow-sm');
            b.classList.add('text-slate-400');
        });

        // تنشيط التبويب المحدد
        document.getElementById('content-' + tabId).classList.remove('hidden');
        const activeBtn = document.getElementById('tab-' + tabId);
        activeBtn.classList.remove('text-slate-400');
        activeBtn.classList.add('bg-[#0D111A]', 'text-amber-400', 'border', 'border-slate-800', 'shadow-sm');
    }

    function copyDriverLink(link) {
        navigator.clipboard.writeText(link).then(() => {
            window.BlockoModal.show({ 
                title: 'تم النسخ بنجاح', 
                message: 'تم نسخ رابط تحديث المندوب بنجاح! يمكنك إرساله للسائق عبر الواتساب.', 
                icon: 'success' 
            });
        }).catch(err => {
            console.error('Failed to copy text: ', err);
        });
    }

    function openReconcileModal(jobId, orderAmount) {
        const modal = document.getElementById('reconcileModal');
        document.getElementById('modalJobId').value = jobId;
        document.getElementById('modalOrderAmount').textContent = orderAmount.toFixed(2);
        document.getElementById('modalCollectedInput').value = orderAmount.toFixed(2);
        document.getElementById('modalReasonInput').value = '';
        
        modal.classList.remove('hidden');
        setTimeout(() => {
            modal.classList.remove('opacity-0');
            modal.querySelector('div').classList.remove('scale-95');
        }, 50);
    }

    function closeReconcileModal() {
        const modal = document.getElementById('reconcileModal');
        modal.classList.add('opacity-0');
        modal.querySelector('div').classList.add('scale-95');
        setTimeout(() => {
            modal.classList.add('hidden');
        }, 300);
    }
</script>
