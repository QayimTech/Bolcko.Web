@using Bolcko.Domain.Entities.Delivery
@using Bolcko.Domain.Enums
@model IEnumerable<DeliveryJob>
@{
    ViewData["Title"] = "قمرة قيادة كابتن النقل الثقيل (Heavy Hauler Cockpit)";
    Layout = "_Layout";
    var driver = ViewBag.Driver as DeliveryDriver;
    var availableJobs = ViewBag.AvailableJobs as IEnumerable<DeliveryJob> ?? new List<DeliveryJob>();
    var myBids = ViewBag.MyBids as IEnumerable<DeliveryBid> ?? new List<DeliveryBid>();

    var myActiveJobs = Model.Where(j => j.Status == DeliveryJobStatus.Assigned || j.Status == DeliveryJobStatus.PickedUp || j.Status == DeliveryJobStatus.InTransit).ToList();
    var completedJobs = Model.Where(j => j.Status == DeliveryJobStatus.Delivered).ToList();
}

<div class="p-3 sm:p-6 lg:p-8 max-w-5xl mx-auto space-y-6 text-right font-sans" dir="rtl">

    @if (TempData["Success"] != null)
    {
        <div class="p-4 rounded-2xl bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 text-xs sm:text-sm font-bold flex items-center gap-3 shadow-lg">
            <span class="material-symbols-outlined text-emerald-400 text-2xl">check_circle</span>
            <span>@TempData["Success"]</span>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="p-4 rounded-2xl bg-rose-500/15 border border-rose-500/30 text-rose-300 text-xs sm:text-sm font-bold flex items-center gap-3 shadow-lg">
            <span class="material-symbols-outlined text-rose-400 text-2xl">error</span>
            <span>@TempData["Error"]</span>
        </div>
    }

    <!-- 1. Captain Wallet & Profile Card -->
    @if (driver != null)
    {
        <partial name="Partials/_CaptainWalletCard" model="driver" />
    }

    <!-- 2. Active Trips Zone (High Priority) -->
    @if (myActiveJobs.Any())
    {
        <div class="space-y-4">
            <div class="flex items-center justify-between">
                <h3 class="text-base sm:text-lg font-black text-slate-800 flex items-center gap-2">
                    <span class="material-symbols-outlined text-amber-500 text-2xl">local_shipping</span>
                    <span>الرحلات الجارية تحت التنفيذ (@myActiveJobs.Count)</span>
                </h3>
                <span class="px-3 py-1 rounded-full bg-amber-100 text-amber-800 font-mono font-bold text-xs">
                    ACTIVE HAULING
                </span>
            </div>

            @foreach (var job in myActiveJobs)
            {
                <div class="bg-white border-2 @(job.Status == DeliveryJobStatus.InTransit ? "border-indigo-500" : "border-amber-400") rounded-3xl p-5 sm:p-7 shadow-xl space-y-5">
                    
                    <!-- Trip Header -->
                    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 border-b border-slate-100 pb-4">
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="px-2.5 py-0.5 rounded-lg bg-blue-50 text-blue-700 font-mono text-xs font-bold">
                                    طلب #@(job.Order?.OrderNumber ?? job.OrderId.ToString())
                                </span>
                                <h4 class="font-black text-slate-900 text-base">@(string.IsNullOrEmpty(job.MaterialType) ? "توريد مواد إنشائية" : job.MaterialType)</h4>
                            </div>
                            <p class="text-xs text-slate-500 mt-1">الحمولة: <strong class="text-slate-800">@(job.WeightTons?.ToString("N1") ?? "25.0") طن</strong> • المستلم: <strong class="text-slate-800">@(job.Order?.User != null ? $"{job.Order.User.FirstName} {job.Order.User.LastName}" : "مشرف الورشة")</strong></p>
                        </div>

                        <div class="text-start sm:text-left">
                            <span class="text-[11px] text-slate-400 block font-bold">الأتعاب المستحقة</span>
                            <span class="text-2xl font-black text-emerald-600 font-mono">@job.DeliveryFee.ToString("N2") د.أ</span>
                        </div>
                    </div>

                    <!-- Anti-Leak Masked Communication (LOG-07) -->
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-3.5 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-xs">
                        <div class="flex items-center gap-2.5">
                            <div class="w-8 h-8 rounded-xl bg-amber-500/20 text-amber-700 flex items-center justify-center shrink-0">
                                <span class="material-symbols-outlined text-lg">shield</span>
                            </div>
                            <div>
                                <div class="flex items-center gap-2">
                                    <span class="text-slate-500 text-[11px]">هاتف المستلم المحمي:</span>
                                    <span class="font-mono font-black text-slate-900 bg-white px-2 py-0.5 rounded-md border border-slate-200">
                                        @(Bolcko.Domain.Entities.Delivery.DTOs.VendorDispatchOrderDto.MaskPhoneNumber(job.Order?.User?.PhoneNumber ?? "0795544123"))
                                    </span>
                                </div>
                                <span class="text-[10px] text-amber-700 font-bold block mt-0.5">درع الحماية ضد التسريب (Anti-Disintermediation Shield)</span>
                            </div>
                        </div>

                        <div class="flex items-center gap-2">
                            <button type="button" 
                                    onclick="openMaskedChatDrawer(@job.Id, 'Driver', 'كابتن الشاحنة', '@(job.Order?.User != null ? $"{job.Order.User.FirstName} {job.Order.User.LastName}" : "مشرف الورشة")', '@(Bolcko.Domain.Entities.Delivery.DTOs.VendorDispatchOrderDto.MaskPhoneNumber(job.Order?.User?.PhoneNumber ?? "0795544123"))')"
                                    class="py-2 px-4 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs shadow-sm transition-all flex items-center gap-1.5 cursor-pointer active:scale-95">
                                <span class="material-symbols-outlined text-sm">chat</span>
                                <span>محادثة فورية (In-App Chat) 💬</span>
                            </button>
                            <button type="button" 
                                    onclick="openMaskedChatDrawer(@job.Id, 'Driver', 'كابتن الشاحنة'); setTimeout(() => triggerOfficialWhatsAppDispatch('Dispatched'), 400);"
                                    class="py-2 px-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow-sm transition-all flex items-center gap-1 cursor-pointer">
                                <span class="material-symbols-outlined text-sm">chat_bubble</span>
                                <span>واتساب رسمي</span>
                            </button>
                        </div>
                    </div>

                    <!-- Route Tracker -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs bg-slate-50 p-4 rounded-2xl border border-slate-200/60">
                        <div>
                            <span class="text-slate-400 block text-[11px]">مستودع التحميل:</span>
                            <span class="font-bold text-slate-800">@(string.IsNullOrEmpty(job.PickupLocation) ? "مستودع بلوكو المركزي" : job.PickupLocation)</span>
                        </div>
                        <div>
                            <span class="text-slate-400 block text-[11px]">موقع الورشة المقصود:</span>
                            <span class="font-bold text-amber-700">@(string.IsNullOrEmpty(job.DropoffLocation) ? "موقع العمل" : job.DropoffLocation)</span>
                        </div>
                    </div>

                    <!-- Step-by-Step Dispatch Action Flow -->
                    <div class="p-4 sm:p-5 rounded-2xl @(job.Status == DeliveryJobStatus.Assigned ? "bg-amber-50 border border-amber-200" : (job.Status == DeliveryJobStatus.InTransit ? "bg-indigo-50 border border-indigo-200" : "bg-slate-50 border border-slate-200")) space-y-4">
                        
                        @if (job.Status == DeliveryJobStatus.Assigned)
                        {
                            <!-- Stage 1: Depart for Loading Yard -->
                            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
                                <div>
                                    <h5 class="font-black text-amber-900 text-sm flex items-center gap-1.5">
                                        <span class="material-symbols-outlined text-base">directions_car</span>
                                        <span>المرحلة 1: الانطلاق لمستودع التحميل</span>
                                    </h5>
                                    <p class="text-xs text-amber-700 mt-0.5">توجه إلى موقع الكسارة أو المستودع لبدء تحميل الشاحنة.</p>
                                </div>
                                <form asp-action="UpdateStatus" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="jobId" value="@job.Id" />
                                    <input type="hidden" name="status" value="@((int)DeliveryJobStatus.PickedUp)" />
                                    <button type="submit" class="py-3 px-6 rounded-xl bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs shadow-md transition-all cursor-pointer">
                                        وصلت للمستودع وبدأت التحميل 📦
                                    </button>
                                </form>
                            </div>
                        }
                        else if (job.Status == DeliveryJobStatus.PickedUp)
                        {
                            <!-- Stage 2: Weighbridge Verification (تذكرة القبان) Mandatory before EnRoute -->
                            <div class="space-y-3">
                                <div>
                                    <h5 class="font-black text-indigo-900 text-sm flex items-center gap-1.5">
                                        <span class="material-symbols-outlined text-base text-indigo-600">scale</span>
                                        <span>المرحلة 2: توثيق تذكرة القبان عند بوابة الخروج (Weighbridge)</span>
                                    </h5>
                                    <p class="text-xs text-indigo-700 mt-0.5">إلزام نظامي: قم بوزن الشاحنة وتصوير تذكرة القبان الرسمية لفتح مسار الرحلة والانتقال إلى قيد التوصيل (InTransit).</p>
                                </div>

                                <form asp-action="UploadWeighbridge" method="post" enctype="multipart/form-data" class="space-y-3">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="jobId" value="@job.Id" />
                                    
                                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                                        <div>
                                            <label class="block text-[11px] font-bold text-slate-700 mb-1">صورة تذكرة القبان: <span class="text-red-500">*</span></label>
                                            <input name="weighbridgePhoto" type="file" required accept="image/*" capture="camera" 
                                                   class="w-full text-xs text-slate-600 file:me-2 file:py-2 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-indigo-600 file:text-white hover:file:bg-indigo-700 cursor-pointer" />
                                        </div>
                                        <div>
                                            <label class="block text-[11px] font-bold text-slate-700 mb-1">الوزن القائم الإجمالي (Gross Ton):</label>
                                            <input name="grossWeight" type="number" step="0.1" value="42.5" class="w-full p-2.5 rounded-xl border border-slate-300 text-xs font-mono font-bold" />
                                        </div>
                                        <div>
                                            <label class="block text-[11px] font-bold text-slate-700 mb-1">وزن الشاحنة فارغة (Tare Ton):</label>
                                            <input name="tareWeight" type="number" step="0.1" value="14.0" class="w-full p-2.5 rounded-xl border border-slate-300 text-xs font-mono font-bold" />
                                        </div>
                                    </div>

                                    <button type="submit" class="w-full py-3.5 px-6 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-black text-xs shadow-md transition-all flex items-center justify-center gap-2 cursor-pointer">
                                        <span class="material-symbols-outlined text-base">upload_file</span>
                                        <span>اعتماد تذكرة القبان والانطلاق للورشة (EnRoute) 🚛</span>
                                    </button>
                                </form>
                            </div>
                        }
                        else if (job.Status == DeliveryJobStatus.InTransit)
                        {
                            <!-- Stage 3: Jobsite Arrival & e-POD 6-digit OTP Handover -->
                            <div class="space-y-3">
                                <div class="flex items-center justify-between">
                                    <div>
                                        <h5 class="font-black text-emerald-900 text-sm flex items-center gap-1.5">
                                            <span class="material-symbols-outlined text-base text-emerald-600">verified_user</span>
                                            <span>المرحلة 3: الوصول لموقع العميل وإثبات التسليم الرقمي (e-POD)</span>
                                        </h5>
                                        <p class="text-xs text-emerald-700 mt-0.5">اطلب من المقاول أو مهندس الموقع رمز التحقق (OTP) المكون من 6 أرقام لإتمام التسليم وصرف الأتعاب الفورية.</p>
                                    </div>
                                    @if (!string.IsNullOrEmpty(job.WeighbridgeTicketUrl))
                                    {
                                        <a href="@job.WeighbridgeTicketUrl" target="_blank" class="text-[11px] text-blue-600 font-bold hover:underline flex items-center gap-1">
                                            <span class="material-symbols-outlined text-sm">receipt_long</span>
                                            <span>معاينة تذكرة القبان المرفقة</span>
                                        </a>
                                    }
                                </div>

                                <form asp-action="VerifyDeliveryOtp" method="post" class="flex flex-col sm:flex-row items-center gap-3">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="jobId" value="@job.Id" />
                                    
                                    <div class="relative w-full sm:flex-1">
                                        <input name="otpCode" type="text" maxlength="6" required placeholder="أدخل رمز e-POD (مثال: 729401)" 
                                               class="w-full py-3.5 px-4 rounded-xl border border-emerald-400 bg-white text-slate-900 font-mono font-black text-base text-center tracking-widest focus:outline-none focus:ring-2 focus:ring-emerald-500" />
                                    </div>

                                    <button type="submit" class="w-full sm:w-auto py-3.5 px-8 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-black text-sm shadow-lg shadow-emerald-950/20 transition-all flex items-center justify-center gap-2 cursor-pointer active:scale-95">
                                        <span class="material-symbols-outlined text-lg">payments</span>
                                        <span>تأكيد التسليم وصرف الأرباح الفورية عبر CliQ</span>
                                    </button>
                                </form>
                            </div>
                        }
                    </div>

                </div>
            }
        </div>
    }

    <!-- 3. Load Radar (رادار الحمولات والفرص المتاحة) -->
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-amber-500/10 text-amber-600 flex items-center justify-center font-bold">
                    <span class="material-symbols-outlined text-2xl animate-spin">radar</span>
                </div>
                <div>
                    <h3 class="text-base sm:text-lg font-black text-slate-900">رادار الحمولات الإنشائية اللحظي (Load Radar)</h3>
                    <p class="text-xs text-slate-500">حمولات حقيقية مطابقة لحمولة شاحنتك ونطاق محافظتك</p>
                </div>
            </div>

            <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-ping"></span>
                <span class="text-xs font-bold text-slate-600">مباشر • Live Radar</span>
            </div>
        </div>

        @if (driver != null && !driver.IsAvailable)
        {
            <div class="bg-amber-50 border border-amber-300 rounded-3xl p-8 text-center space-y-3">
                <span class="material-symbols-outlined text-4xl text-amber-600">pause_circle</span>
                <h4 class="text-base font-black text-amber-900">أنت في وضع الاستراحة المؤقتة</h4>
                <p class="text-xs text-amber-700 max-w-md mx-auto">قم بتفعيل زر "جاهز لاستلام الحمولات" في بطاقة الكابتن أعلاه لاستقبال إشعارات الحمولات الجديدة وعرضها على الرادار.</p>
            </div>
        }
        else if (availableJobs.Any())
        {
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                @foreach (var load in availableJobs)
                {
                    <partial name="Partials/_LoadRadarCard" model="load" />
                }
            </div>
        }
        else
        {
            <div class="bg-white border border-slate-200 rounded-3xl p-10 text-center space-y-3 shadow-xs">
                <div class="w-16 h-16 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mx-auto">
                    <span class="material-symbols-outlined text-3xl">radar</span>
                </div>
                <h4 class="text-base font-black text-slate-800">جاري مسح الحمولات في منطقتك...</h4>
                <p class="text-xs text-slate-500 max-w-sm mx-auto">لا توجد حمولات غير مسندة في نطاق تغطيتك حالياً. سيقوم النظام بإرسال إشعار صوتي فوري فور قيام أي تاجر أو مقاول بطلب نقل مواد إنشائية.</p>
            </div>
        }
    </div>

</div>

<!-- LOG-07: In-Trip Masked Load Communication & Official WhatsApp Notifications Drawer -->
<partial name="_MaskedTripChatDrawer" />
