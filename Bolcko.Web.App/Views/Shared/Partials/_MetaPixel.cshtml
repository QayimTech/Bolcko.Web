@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var pixelId = Configuration["MetaPixel:PixelId"] ?? "1812802213474619";
}

@if (!string.IsNullOrWhiteSpace(pixelId))
{
    <!-- Meta Pixel Code (BLOCKO - ID: @pixelId) -->
    <script>
        !function(f,b,e,v,n,t,s)
        {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};
        if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
        n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t,s)}(window, document,'script',
        'https://connect.facebook.net/en_US/fbevents.js');

        fbq('init', '@pixelId');
        fbq('track', 'PageView');

        // Block-O Standardized Meta Pixel Event Tracker
        window.trackBlockoPixel = function(eventName, eventParams) {
            try {
                if (typeof window.fbq === 'function') {
                    if (eventParams) {
                        window.fbq('track', eventName, eventParams);
                    } else {
                        window.fbq('track', eventName);
                    }
                }
            } catch (e) {
                console.debug('Meta Pixel tracking error:', e);
            }
        };
    </script>
    <noscript>
        <img height="1" width="1" style="display:none"
             src="https://www.facebook.com/tr?id=@pixelId&ev=PageView&noscript=1" 
             alt="Meta Pixel" />
    </noscript>
    <!-- End Meta Pixel Code -->
}
