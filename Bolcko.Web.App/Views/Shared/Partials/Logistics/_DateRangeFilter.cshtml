@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Bolcko.Web.App.SharedResource> L
@{
    var actionName = ViewData["ActionName"]?.ToString() ?? "Index";
    var controllerName = ViewData["ControllerName"]?.ToString() ?? "DeliveryDispatch";
    var areaName = ViewData["AreaName"]?.ToString() ?? "Admin";
    var startDate = ViewBag.StartDate as string;
    var endDate = ViewBag.EndDate as string;
    var currentStatus = ViewBag.CurrentStatus?.ToString();
    var selectedCompanyId = ViewBag.SelectedCompanyId as int?;
    var deliveryCompanies = ViewBag.DeliveryCompanies as IEnumerable<Bolcko.Domain.Entities.Delivery.DeliveryCompany>;
}

<div class="bg-white dark:bg-[#0D111A] rounded-2xl border border-slate-200 dark:border-slate-800 p-4 mb-6 shadow-sm flex flex-col md:flex-row justify-between items-center gap-4">
    <form asp-area="@areaName" asp-controller="@controllerName" asp-action="@actionName" method="get" class="flex flex-wrap items-center gap-3 w-full md:w-auto">
        @if (!string.IsNullOrEmpty(currentStatus))
        {
            <input type="hidden" name="status" value="@currentStatus" />
        }
        
        @if (deliveryCompanies != null && deliveryCompanies.Any())
        {
            <div class="flex items-center gap-2">
                <label class="text-xs font-bold text-slate-600 dark:text-slate-300">@L["DeliveryCompanyLabel"]</label>
                <select name="companyId" class="bg-slate-50 dark:bg-[#070A0F] border border-slate-200 dark:border-slate-700 rounded-xl px-3 py-1.5 text-xs text-slate-700 dark:text-slate-200 outline-none focus:border-[#E8A020]">
                    <option value="">@L["AllDeliveryCompanies"]</option>
                    @foreach (var comp in deliveryCompanies)
                    {
                        if (selectedCompanyId.HasValue && selectedCompanyId.Value == comp.Id)
                        {
                            <option value="@comp.Id" selected>@comp.Name</option>
                        }
                        else
                        {
                            <option value="@comp.Id">@comp.Name</option>
                        }
                    }
                </select>
            </div>
        }

        <div class="flex items-center gap-2">
            <label class="text-xs font-bold text-slate-600 dark:text-slate-300">@L["DateRangeFrom"]:</label>
            <input type="@(string.IsNullOrEmpty(startDate) ? "text" : "date")" 
                   onfocus="(this.type='date')" 
                   onblur="if(!this.value)this.type='text'" 
                   placeholder="@L["DatePickerPlaceholder"]" 
                   name="startDate" 
                   value="@startDate" 
                   class="bg-slate-50 dark:bg-[#070A0F] border border-slate-200 dark:border-slate-700 rounded-xl px-3 py-1.5 text-xs text-slate-700 dark:text-slate-200 outline-none focus:border-[#E8A020] text-center font-mono" />
        </div>
        <div class="flex items-center gap-2">
            <label class="text-xs font-bold text-slate-600 dark:text-slate-300">@L["DateRangeTo"]:</label>
            <input type="@(string.IsNullOrEmpty(endDate) ? "text" : "date")" 
                   onfocus="(this.type='date')" 
                   onblur="if(!this.value)this.type='text'" 
                   placeholder="@L["DatePickerPlaceholder"]" 
                   name="endDate" 
                   value="@endDate" 
                   class="bg-slate-50 dark:bg-[#070A0F] border border-slate-200 dark:border-slate-700 rounded-xl px-3 py-1.5 text-xs text-slate-700 dark:text-slate-200 outline-none focus:border-[#E8A020] text-center font-mono" />
        </div>
        <button type="submit" class="px-4 py-1.5 bg-[#E8A020] hover:bg-amber-600 text-slate-950 text-xs font-black rounded-xl transition-all shadow-sm">
            @L["ApplyFilter"]
        </button>
        <a asp-area="@areaName" asp-controller="@controllerName" asp-action="@actionName" class="text-xs font-bold text-slate-400 hover:text-slate-300 underline">@L["ResetFilter"]</a>
    </form>
</div>
